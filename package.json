{
  "name": "platanitorico-web",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx src/scripts/medir-webs.ts --si-caduca",
    "build": "astro build",
    "medir": "tsx src/scripts/medir-webs.ts",
    "build:full": "npm run validate:content && astro build && npm run check:links",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . --ext .ts,.astro,.js",
    "lint:fix": "eslint . --ext .ts,.astro,.js --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:seo": "tsx src/scripts/auditoria-seo.ts",
    "audit:programadores": "tsx src/scripts/auditar-programadores.ts",
    "audit:modelos": "tsx src/scripts/auditar-modelos.ts",
    "optimizar:imagenes": "tsx src/scripts/optimizar-imagenes.ts",
    "limpiar:chatlog": "tsx src/scripts/limpiar-chatlog.ts",
    "validate:content": "tsx src/scripts/validate.ts",
    "check:links": "tsx src/scripts/auditar-salida.ts",
    "lighthouse": "tsx src/scripts/lighthouse.ts",
    "test:all": "npm run check && npm run test && npm run validate:content && npm run build && npm run check:links && npm run lighthouse",
    "taia:validate": "tsx src/scripts/validate.ts",
    "taia:links": "tsx src/scripts/auditar-salida.ts",
    "taia:lighthouse": "tsx src/scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.4",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.1.6",
    "gray-matter": "^4.0.3",
    "resend": "^6.12.4",
    "zod": "^4.3.6"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "astro-eslint-parser": "^1.4.0",
    "axe-core": "^4.11.1",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "lighthouse": "^13.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
