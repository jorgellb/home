    "@typescript-eslint/parser": "^8.60.0",
    "astro-eslint-parser": "^1.4.0",
    "axe-core": "^4.11.1",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "lighthouse": "^13.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
