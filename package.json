{
  "name": "platanitorico-web",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:full": "npm run validate:content && npm run check:links && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . --ext .ts,.astro,.js",
    "lint:fix": "eslint . --ext .ts,.astro,.js --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx src/scripts/validate.ts",
    "check:links": "tsx src/scripts/link-checker.ts",
    "lighthouse": "tsx src/scripts/lighthouse.ts",
    "test:all": "npm run check && npm run validate:content && npm run check:links && npm run build && npm run lighthouse",
    "taia:validate": "tsx src/scripts/validate.ts",
    "taia:links": "tsx src/scripts/link-checker.ts",
    "taia:lighthouse": "tsx src/scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.4",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.6",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
