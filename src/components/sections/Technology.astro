---
const technologies = {
  Frontend: ['Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'Astro', 'Vite', 'SvelteKit'],
  Diseño: ['Figma', 'Framer', 'Rive', 'Spline', 'Penpot'],
  Audiovisual: ['Runway', 'DaVinci Resolve', 'Unreal Engine 5', 'Adobe Firefly', 'CapCut'],
  Marketing: ['Claude / GPT-4o', 'HubSpot', 'Make', 'Segment', 'Google Analytics 4'],
  Backend: ['Node.js (Bun/Deno)', 'Go', 'Rust', 'PostgreSQL', 'Supabase', 'GraphQL'],
  DevOps: ['Docker', 'Kubernetes', 'Terraform', 'GitHub Actions', 'Vercel', 'Prometheus']
};

const categoryIcons: Record<string, string> = {
  Frontend: '⚡',
  Diseño: '🎨',
  Audiovisual: '🎬',
  Marketing: '📈',
  Backend: '⚙️',
  DevOps: '🚀'
};
---

<section class="section-brutal relative py-28 overflow-hidden" id="tecnologia">
  <div class="absolute inset-0 bg-brutal-bg"></div>
  <div class="absolute inset-0 bg-[image:repeating-linear-gradient(90deg,transparent,transparent_60px,rgba(255,90,0,0.06)_60px,rgba(255,90,0,0.06)_61px),repeating-linear-gradient(0deg,transparent,transparent_60px,rgba(255,90,0,0.06)_60px,rgba(255,90,0,0.06)_61px)]"></div>
  <div class="absolute inset-0 bg-[image:url('data:image/svg+xml;base64,')] opacity-60"></div>

  <div class="container-brutal relative max-w-6xl mx-auto px-6">
    <div class="flex flex-col items-center text-center mb-16">
      <div class="badge-brutal mb-8">
        <span class="text-brutal-accent">&gt;</span>
        Stack moderno
      </div>
      <div class="flex items-center gap-4 justify-center">
        <span class="editorial-number">06</span>
        <h2 class="heading-display text-5xl md:text-7xl lg:text-8xl text-brutal-text leading-none">
          Tecnologías que
          <span class="text-brutal-accent">dominamos</span>
        </h2>
      </div>
      <div class="editorial-rule editorial-rule--centered"></div>
      <p class="text-brutal-text-secondary text-lg md:text-xl max-w-3xl mt-8">
        Herramientas de producción que usamos para construir productos reales
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {Object.entries(technologies).map(([category, tools]) => (
        <div class="card-brutal relative border-2 border-brutal-border bg-brutal-card p-6 transition-all duration-300 hover:border-brutal-accent hover:-translate-y-1 hover:shadow-[6px_6px_0px_#FF5A00]">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-12 h-12 flex items-center justify-center border-2 border-brutal-border bg-brutal-bg-alt font-['DM_Sans'] text-xl">
              {categoryIcons[category]}
            </div>
            <div>
              <h3 class="font-display font-bold text-brutal-text text-xl">{category}</h3>
              <p class="font-['JetBrains_Mono'] text-brutal-text-muted text-xs tracking-tight">{'>'} {tools.length} modulos</p>
            </div>
          </div>

          <div class="divider-brutal h-px bg-brutal-border mb-4"></div>

          <div class="grid grid-cols-2 gap-2">
            {tools.map((tool) => (
              <div class="flex items-center gap-2 px-3 py-2 bg-brutal-bg-alt border border-brutal-border transition-all duration-200 hover:border-brutal-accent hover:bg-brutal-card">
                <span class="w-1.5 h-1.5 bg-brutal-accent flex-shrink-0"></span>
                <span class="font-['JetBrains_Mono'] text-brutal-text-secondary text-xs tracking-tight truncate">{tool}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="divider-brutal h-px bg-brutal-border/50 my-14 max-w-4xl mx-auto"></div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
      {[
        { value: '35+', label: 'Tecnologías' },
        { value: '99/100', label: 'Lighthouse Score' },
        { value: '100%', label: 'Código Limpio' },
        { value: '24/7', label: 'Soporte' }
      ].map((stat) => (
        <div class="card-brutal relative border-2 border-brutal-border bg-brutal-card p-6 text-center transition-all duration-300 hover:border-brutal-accent hover:-translate-y-0.5">
          <p class="text-mono text-3xl md:text-4xl text-brutal-accent leading-none mb-2 font-bold">{stat.value}</p>
          <p class="text-mono text-brutal-text-muted text-xs uppercase tracking-widest">{stat.label}</p>
        </div>
      ))}
    </div>

    <div class="divider-brutal h-px bg-brutal-border/50 my-14 max-w-4xl mx-auto"></div>

    <div class="text-center">
      <p class="text-brutal-text-secondary text-base mb-8 max-w-xl mx-auto font-['DM_Sans']">
        ¿Tu proyecto necesita un stack específico?
      </p>
        <a
          href="#contacto"
          class="btn-brutal"
        >
          Hablemos
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
    </div>
  </div>
</section>
