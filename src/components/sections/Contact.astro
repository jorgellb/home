---
const channels = [
  { label: 'Llamada directa', value: '+34 657 085 019', meta: 'L–V · 09:00 – 19:00', href: 'tel:+34657085019' },
  { label: 'Email',            value: 'hola@platanitorico.com', meta: 'Respuesta < 24h',     href: 'mailto:hola@platanitorico.com' },
  { label: 'WhatsApp',         value: '+34 657 085 019',         meta: 'Respuesta inmediata', href: 'https://wa.me/34657085019' },
  { label: 'Estudio',          value: 'Vera · Almería · ES',     meta: 'Visita con cita',     href: 'https://maps.google.com/?q=Vera,Almería' },
];
---

<section class="section-brutal" id="contacto">
  <div class="container-brutal">
    <header class="brutal-section-head">
      <div class="brutal-section-head__col">
        <span class="text-meta">Cap. 07 / Contacto</span>
        <h2 class="heading-display brutal-section-head__title">
          Pide presupuesto
          <em class="heading-editorial">sin compromiso.</em>
        </h2>
      </div>
      <p class="brutal-section-head__lead">
        Te enviamos un presupuesto detallado y un mini-roadmap en menos de
        24 horas. Sin compromiso, sin llamadas comerciales, sin tonterías.
      </p>
    </header>

    <div class="contact-grid">
      {/* Columna izquierda — canales */}
      <aside class="contact-channels">
        <span class="text-meta">Canales directos / 01</span>
        <ul class="contact-channels__list">
          {channels.map((c) => (
            <li>
              <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="contact-channel">
                <span class="contact-channel__label text-meta">{c.label}</span>
                <span class="contact-channel__value">{c.value}</span>
                <span class="contact-channel__meta text-mono">{c.meta}</span>
                <span class="contact-channel__arrow">→</span>
              </a>
            </li>
          ))}
        </ul>

        {/* Microcopy */}
        <div class="contact-status">
          <span class="live-dot"></span>
          <div>
            <p class="contact-status__title heading-display">Aceptando proyectos · 2026</p>
            <p class="contact-status__sub text-mono">Próxima ventana de inicio: 2 semanas</p>
          </div>
        </div>

        {/* Data sheet */}
        <dl class="spec-list contact-specs">
          <div><dt class="spec-k">Estudio</dt><dd class="spec-v">Platanito Rico · Est. 2018</dd></div>
          <div><dt class="spec-k">Equipo</dt><dd class="spec-v">3 personas + freelancers</dd></div>
          <div><dt class="spec-k">Idiomas</dt><dd class="spec-v">ES · EN · DE</dd></div>
          <div><dt class="spec-k">Facturación</dt><dd class="spec-v">Autónomo · IRPF/IVA aplicable</dd></div>
        </dl>
      </aside>

      {/* Columna derecha — formulario data-sheet */}
      <div class="contact-form-wrap">
        <header class="contact-form-head">
          <span class="text-meta">Formulario / 02</span>
          <span class="text-meta">★ Campos obligatorios</span>
        </header>

        <form
          name="contact"
          method="POST"
          action="/api/contact/"
          class="contact-form"
        >
          {/* Honeypot anti-spam (invisible para humanos) */}
          <p style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
            <label>No rellenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="contact-form__row contact-form__row--2">
            <label class="contact-form__field">
              <span class="label-brutal">Nombre <span style="color:var(--brutal-accent-ink)">★</span></span>
              <input type="text" name="name" required class="input-brutal" placeholder="Cómo te llamas" />
            </label>
            <label class="contact-form__field">
              <span class="label-brutal">Email <span style="color:var(--brutal-accent-ink)">★</span></span>
              <input type="email" name="email" required class="input-brutal" placeholder="tu@email.com" />
            </label>
          </div>

          <div class="contact-form__row contact-form__row--2">
            <label class="contact-form__field">
              <span class="label-brutal">Teléfono</span>
              <input type="tel" name="phone" class="input-brutal" placeholder="+34 600 000 000" />
            </label>
            <label class="contact-form__field">
              <span class="label-brutal">Servicio</span>
              <select name="service" class="input-brutal">
                <option value="">Selecciona…</option>
                <option value="web">Diseño Web</option>
                <option value="tienda">Tienda online</option>
                <option value="sistemas-it">Sistemas IT (informática, redes, equipos)</option>
                <option value="plan-360">Plan 360 (web + IT · 400 €/mes)</option>
                <option value="video">Audiovisual</option>
                <option value="marketing">Marketing &amp; SEO</option>
                <option value="branding">Diseño gráfico</option>
                <option value="otro">Otro</option>
              </select>
            </label>
          </div>

          <label class="contact-form__field">
            <span class="label-brutal">Presupuesto orientativo</span>
            <div class="contact-form__chips">
              <input type="radio" id="b1" name="budget" value="0-1000" />
              <label for="b1">&lt;1.000€</label>
              <input type="radio" id="b2" name="budget" value="1000-3000" />
              <label for="b2">1k–3k</label>
              <input type="radio" id="b3" name="budget" value="3000-7000" />
              <label for="b3">3k–7k</label>
              <input type="radio" id="b4" name="budget" value="7000+" />
              <label for="b4">7k+</label>
              <input type="radio" id="b5" name="budget" value="no-idea" checked />
              <label for="b5">No lo sé</label>
            </div>
          </label>

          <label class="contact-form__field">
            <span class="label-brutal">Cuéntanos qué necesitas <span style="color:var(--brutal-accent-ink)">★</span></span>
            <textarea name="message" rows="5" required class="input-brutal" placeholder="Qué quieres conseguir, plazos, referencias que te gusten..."></textarea>
          </label>

          <div class="contact-form__foot">
            <button type="submit" class="btn-brutal btn-brutal--lg contact-form__submit">
              Enviar briefing →
            </button>
            <p class="contact-form__legal text-mono">
              Al enviar aceptas la <a href="/privacidad/" class="link-brutal">política de privacidad</a>.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Precarga el servicio desde los CTAs (?servicio=plan-360) para que el
  // cliente no tenga que volver a elegir lo que ya eligió en la cartelera.
  const servicio = new URLSearchParams(window.location.search).get('servicio');
  const select = document.querySelector<HTMLSelectElement>('#contacto select[name="service"]');
  if (servicio && select && Array.from(select.options).some((o) => o.value === servicio)) {
    select.value = servicio;
  }
</script>

<style>
  .brutal-section-head { display: grid; gap: 2rem; grid-template-columns: 1fr; margin-bottom: 3rem; }
  @media (min-width: 1024px) { .brutal-section-head { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 4rem; } }
  .brutal-section-head__col { display: flex; flex-direction: column; gap: 1rem; }
  .brutal-section-head__title { font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: .92; letter-spacing: -.04em; margin: 0; max-width: 14ch; }
  .brutal-section-head__title em { color: var(--brutal-accent-ink); font-style: italic; }
  .brutal-section-head__lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 44ch; }

  .contact-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) { .contact-grid { grid-template-columns: 1fr 1.4fr; gap: 3rem; } }

  /* Canales */
  .contact-channels { display: flex; flex-direction: column; gap: 1.5rem; }
  .contact-channels__list { list-style: none; padding: 0; margin: .5rem 0 0; display: flex; flex-direction: column; gap: 0; border-top: 2px solid var(--brutal-ink); }
  .contact-channel {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    column-gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--brutal-border-soft);
    text-decoration: none;
    color: var(--brutal-ink);
    transition: padding .2s, background .2s;
    grid-template-areas:
      'label arrow'
      'value arrow'
      'meta  arrow';
  }
  .contact-channel:hover { padding-inline: .75rem; background: var(--brutal-bg-alt); }
  .contact-channel:hover .contact-channel__arrow { transform: translateX(4px); color: var(--brutal-accent-ink); }
  .contact-channel__label { grid-area: label; }
  .contact-channel__value {
    grid-area: value;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -.02em;
    margin: .15rem 0 .25rem;
  }
  .contact-channel__meta { grid-area: meta; font-size: .68rem; color: var(--brutal-text-muted); text-transform: uppercase; letter-spacing: .14em; }
  .contact-channel__arrow {
    grid-area: arrow;
    align-self: center;
    font-family: var(--font-mono);
    color: var(--brutal-text-muted);
    transition: transform .2s, color .2s;
  }

  .contact-status {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--brutal-lime);
    border: 2px solid var(--brutal-ink);
    box-shadow: 4px 4px 0 0 var(--brutal-ink);
  }
  .contact-status .live-dot { background: var(--brutal-ink); flex-shrink: 0; }
  .contact-status__title { font-size: 1rem; line-height: 1.1; }
  .contact-status__sub { font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-ink); opacity: .75; margin-top: .25rem; }

  /* Form */
  .contact-form-wrap {
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    box-shadow: 8px 8px 0 0 var(--brutal-ink);
    padding: 2rem;
  }
  @media (min-width: 768px) { .contact-form-wrap { padding: 2.5rem; } }
  .contact-form-head {
    display: flex; justify-content: space-between;
    padding-bottom: 1rem; margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--brutal-ink);
  }
  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .contact-form__row { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .contact-form__row--2 { grid-template-columns: 1fr 1fr; } }
  .contact-form__field { display: flex; flex-direction: column; }

  /* Chips presupuesto */
  .contact-form__chips {
    display: flex; flex-wrap: wrap; gap: .4rem;
  }
  .contact-form__chips input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; }
  .contact-form__chips label {
    cursor: pointer;
    padding: .5rem .75rem;
    border: 1.5px solid var(--brutal-ink);
    font-family: var(--font-mono);
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    background: var(--brutal-card);
    transition: background .15s, color .15s;
  }
  .contact-form__chips label:hover { background: var(--brutal-bg-alt); }
  .contact-form__chips input[type="radio"]:checked + label {
    background: var(--brutal-ink);
    color: var(--brutal-lime);
  }

  .contact-form__foot {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    flex-wrap: wrap;
    border-top: 2px solid var(--brutal-ink);
    padding-top: 1.5rem;
    margin-top: .5rem;
  }
  .contact-form__submit { flex-shrink: 0; }
  .contact-form__legal { font-size: .65rem; color: var(--brutal-text-muted); text-transform: uppercase; letter-spacing: .12em; max-width: 24ch; }
</style>
