---
interface Testimonial {
  name: string;
  role: string;
  company: string;
  companyUrl?: string;
  text: string;
  rating: number;
  initial?: string;
  gradient?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  testimonials?: Testimonial[];
  title?: string;
  subtitle?: string;
}

const {
  testimonials: propTestimonials,
} = Astro.props;

const defaultTestimonials: Testimonial[] = [
  { name: 'Ana Padilla',  role: 'Directora',     company: 'Clínica Dental Koral',         text: 'Desde el diseño de nuestra web hasta su mantenimiento, han demostrado un profesionalismo y dedicación excepcionales. El tráfico local se ha disparado.', rating: 5, initial: 'A' },
  { name: 'Juan Poveda',  role: 'Gerente',       company: 'Murcia Production Services',   text: 'La creación de nuestro sitio web corporativo fue un proceso impecable. Capturaron a la perfección nuestros valores y visión.', rating: 5, initial: 'J' },
  { name: 'Javier Ruiz',  role: 'Propietario',   company: 'Inmobiliaria Vera Playa',      text: 'Necesitábamos captar clientes de Madrid y Reino Unido. Nos hicieron un portal con SEO internacional impecable. Ahora recibimos leads diarios.', rating: 5, initial: 'J' },
  { name: 'Elena Soto',   role: 'Propietaria',   company: 'Restaurante Puerto Rey',       text: 'Desde que activamos la web con reservas online, gestionamos todo mucho mejor. La ocupación ha subido notablemente en temporada media y baja.', rating: 5, initial: 'E' },
];

const items: Testimonial[] = propTestimonials && propTestimonials.length > 0
  ? propTestimonials
  : defaultTestimonials;

// Reorganización: el primero es featured (pull quote grande)
const [featured, ...rest] = items;
---

<section class="section-brutal" id="testimonios">
  <div class="container-brutal">
    <header class="brutal-section-head">
      <div class="brutal-section-head__col">
        <span class="text-meta">Cap. 05 / Testimonios</span>
        <h2 class="heading-display brutal-section-head__title">
          Lo que dicen quienes
          <em class="heading-editorial">ya trabajan</em>
          con nosotros.
        </h2>
      </div>
      <p class="brutal-section-head__lead">
        Citas reales, sin filtros, sin estrellas falsas. Si quieres preguntar
        directamente a un cliente, te ponemos en contacto.
      </p>
    </header>

    {/* Pull quote destacada */}
    {featured && (
      <figure class="testimonial-feature">
        <div class="testimonial-feature__marks" aria-hidden="true">“</div>
        <blockquote class="testimonial-feature__quote heading-editorial">
          {featured.text}
        </blockquote>
        <figcaption class="testimonial-feature__caption">
          <span class="testimonial-feature__avatar">{featured.initial || featured.name[0]}</span>
          <div class="testimonial-feature__person">
            <span class="testimonial-feature__name">{featured.name}</span>
            <span class="testimonial-feature__role text-mono">{featured.role} · {featured.company}</span>
          </div>
          <div class="testimonial-feature__stars" aria-label={`${featured.rating} de 5`}>
            {[...Array(featured.rating)].map(() => <span>★</span>)}
          </div>
        </figcaption>
      </figure>
    )}

    {/* Resto en grid */}
    <ul class="testimonial-grid">
      {rest.map((t, i) => (
        <li class={`testimonial-card testimonial-card--${i % 3 === 0 ? 'a' : i % 3 === 1 ? 'b' : 'c'}`}>
          <div class="testimonial-card__head">
            <span class="testimonial-card__avatar">{t.initial || t.name[0]}</span>
            <div>
              <span class="testimonial-card__name heading-display">{t.name}</span>
              <span class="testimonial-card__role text-mono">{t.role} · {t.company}</span>
            </div>
          </div>
          <p class="testimonial-card__text">{t.text}</p>
          <div class="testimonial-card__foot">
            <span class="testimonial-card__stars" aria-label={`${t.rating} de 5`}>
              {[...Array(t.rating)].map(() => <span>★</span>)}
            </span>
            <span class="text-meta">Verificado</span>
          </div>
        </li>
      ))}
    </ul>

    {/* Stats */}
    <div class="testimonial-stats">
      <div class="testimonial-stats__item">
        <span class="testimonial-stats__num text-mono">50<sup>+</sup></span>
        <span class="testimonial-stats__lbl">Proyectos enviados</span>
      </div>
      <div class="testimonial-stats__item testimonial-stats__item--ink">
        <span class="testimonial-stats__num text-mono">100%</span>
        <span class="testimonial-stats__lbl">Clientes satisfechos</span>
      </div>
      <div class="testimonial-stats__item">
        <span class="testimonial-stats__num text-mono">5<sup>+</sup></span>
        <span class="testimonial-stats__lbl">Años de estudio</span>
      </div>
      <div class="testimonial-stats__item testimonial-stats__item--lime">
        <span class="testimonial-stats__num text-mono">24/7</span>
        <span class="testimonial-stats__lbl">Soporte activo</span>
      </div>
    </div>
  </div>
</section>

<style>
  .brutal-section-head { display: grid; gap: 2rem; grid-template-columns: 1fr; margin-bottom: 3rem; }
  @media (min-width: 1024px) { .brutal-section-head { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 4rem; } }
  .brutal-section-head__col { display: flex; flex-direction: column; gap: 1rem; }
  .brutal-section-head__title { font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: .92; letter-spacing: -.04em; margin: 0; max-width: 16ch; }
  .brutal-section-head__title em { color: var(--brutal-accent); font-style: italic; }
  .brutal-section-head__lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 44ch; }

  /* Featured pull quote */
  .testimonial-feature {
    position: relative;
    background: var(--brutal-ink);
    color: var(--brutal-bg);
    border: 2px solid var(--brutal-ink);
    padding: clamp(2.5rem, 5vw, 4.5rem);
    margin: 2rem 0 3rem;
    box-shadow: 10px 10px 0 0 var(--brutal-accent);
  }
  .testimonial-feature__marks {
    position: absolute;
    top: -1.5rem;
    left: 1.5rem;
    font-family: var(--font-editorial);
    font-size: clamp(7rem, 12vw, 11rem);
    line-height: 1;
    color: var(--brutal-accent);
    font-style: italic;
    user-select: none;
  }
  .testimonial-feature__quote {
    font-size: clamp(1.5rem, 3.4vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -.02em;
    margin: 0;
    color: var(--brutal-bg);
    max-width: 36ch;
  }
  .testimonial-feature__caption {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--brutal-bg-alt);
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .testimonial-feature__avatar {
    width: 54px;
    height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--brutal-lime);
    color: var(--brutal-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    border: 2px solid var(--brutal-bg);
  }
  .testimonial-feature__person { display: flex; flex-direction: column; line-height: 1.2; }
  .testimonial-feature__name { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--brutal-bg); }
  .testimonial-feature__role { font-size: .72rem; text-transform: uppercase; letter-spacing: .15em; color: var(--brutal-bg-alt); margin-top: .25rem; }
  .testimonial-feature__stars {
    margin-left: auto;
    display: inline-flex;
    gap: .15rem;
    color: var(--brutal-accent);
    font-size: 1.1rem;
  }

  /* Grid */
  .testimonial-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) { .testimonial-grid { grid-template-columns: repeat(3, 1fr); } }

  .testimonial-card {
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform .25s, box-shadow .25s, background .25s;
    box-shadow: 4px 4px 0 0 var(--brutal-ink);
  }
  .testimonial-card:hover { transform: translate(-3px,-3px); box-shadow: 7px 7px 0 0 var(--brutal-accent); }
  .testimonial-card--b { background: var(--brutal-bg-alt); }
  .testimonial-card--c { background: var(--brutal-lime-soft); }

  .testimonial-card__head {
    display: flex;
    gap: .85rem;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--brutal-border-soft);
  }
  .testimonial-card__avatar {
    width: 44px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brutal-ink); color: var(--brutal-lime);
    font-family: var(--font-display); font-weight: 800; font-size: 1.1rem;
    border: 2px solid var(--brutal-ink);
    flex-shrink: 0;
  }
  .testimonial-card__name { display: block; font-size: 1rem; line-height: 1.1; color: var(--brutal-ink); }
  .testimonial-card__role { display: block; font-size: .65rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); margin-top: .25rem; }
  .testimonial-card__text { font-size: .95rem; line-height: 1.5; color: var(--brutal-text); margin: 0; flex: 1; }
  .testimonial-card__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--brutal-border-soft);
  }
  .testimonial-card__stars { display: inline-flex; gap: .1rem; color: var(--brutal-accent); }

  /* Stats */
  .testimonial-stats {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border: 2px solid var(--brutal-ink);
    background: var(--brutal-ink);
  }
  @media (min-width: 768px) { .testimonial-stats { grid-template-columns: repeat(4, 1fr); gap: 2px; } }
  .testimonial-stats__item { background: var(--brutal-card); padding: 1.75rem 1.5rem; display: flex; flex-direction: column; gap: .5rem; }
  .testimonial-stats__item--ink { background: var(--brutal-ink); color: var(--brutal-bg); }
  .testimonial-stats__item--ink .testimonial-stats__num { color: var(--brutal-lime); }
  .testimonial-stats__item--lime { background: var(--brutal-lime); color: var(--brutal-ink); }
  .testimonial-stats__num { font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 700; line-height: 1; color: var(--brutal-ink); }
  .testimonial-stats__num sup { font-size: .5em; vertical-align: super; color: var(--brutal-accent); }
  .testimonial-stats__lbl { font-family: var(--font-mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }
</style>
