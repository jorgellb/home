---
interface Project {
  id: string;
  name: string;
  description: string;
  category: string;
  url: string;
  image: string;
  tags: string[];
  year: string;
  result?: string;
}

const projects: Project[] = [
  { id: 'clinica-koral', name: 'Clínica Dental Koral', description: 'Clínica dental en Vera con web premium, SEO multiidioma y sistema de citas online.', category: 'Web · SEO', url: 'https://clinicadentalkoral.es/', image: '/imagenes/clientes/clinica-dental-koral.jpg', tags: ['WordPress', 'SEO', 'Multiidioma'], year: '2024', result: '+220% leads orgánicos' },
  { id: 'murcia-production', name: 'Murcia Production Service', description: 'Productora audiovisual de rodajes cinematográficos. Web corporativa con portfolio.', category: 'Web · Corporativa', url: 'https://murciaproductionservice.com/', image: '/imagenes/clientes/murcia-production-services.jpg', tags: ['Producción', 'Cine', 'AV'], year: '2024', result: '#1 keyword sector' },
  { id: 'actualidad-almanzora', name: 'Actualidad Almanzora', description: 'Periódico digital líder del Levante de Almería. Noticias, radio online y podcasts.', category: 'Portal Noticias', url: 'https://www.actualidadalmanzora.es/', image: '/imagenes/clientes/actualidad-almanzora.jpg', tags: ['Noticias', 'Radio', 'Podcast'], year: '2023', result: '+45k visitas/mes' },
  { id: 'oveja-bohemia', name: 'Oveja Bohemia', description: 'Tienda online de ropa bohemia. Shopify con pasarela y gestión automatizada.', category: 'E-commerce', url: 'https://ovejabohemia.com/', image: '/imagenes/clientes/oveja-bohemia.jpg', tags: ['Shopify', 'E-com', 'Branding'], year: '2024', result: '+180% ventas' },
  { id: 'ysy', name: 'YSY Arquitectura', description: 'Plataforma de arquitectura e ingeniería. Diseño minimalista enfocado a conversión.', category: 'Web · Diseño', url: 'https://ysy.es/', image: '/imagenes/clientes/ysy.es.jpg', tags: ['Next.js', 'SEO', 'UI/UX'], year: '2024', result: 'Lighthouse 100' },
  { id: 'metales-sureste', name: 'Metales del Sureste', description: 'Gestión de residuos metálicos. Web B2B con catálogo y blog sectorial.', category: 'Web · B2B', url: 'https://metalesdelsureste.com/', image: '/imagenes/clientes/metalesdelsureste.com.jpg', tags: ['WordPress', 'SEO Local', 'B2B'], year: '2023', result: '+12 leads/mes' },
];
---

<section class="section-brutal" id="portfolio">
  <div class="container-brutal">
    <header class="brutal-section-head">
      <div class="brutal-section-head__col">
        <span class="text-meta">Cap. 04 / Portfolio</span>
        <h2 class="heading-display brutal-section-head__title">
          Trabajos publicados,
          <em class="heading-editorial">resultados reales.</em>
        </h2>
      </div>
      <p class="brutal-section-head__lead">
        Una selección de proyectos enviados a producción los últimos años.
        Sin renders falsos, sin maquetas vacías — todos en línea ahora mismo.
      </p>
    </header>

    {/* Portfolio grid editorial */}
    <ol class="portfolio-grid">
      {projects.map((p, i) => (
        <li class="portfolio-item" style={`--i:${i}`}>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="portfolio-link"
            aria-label={`Abrir ${p.name} en nueva pestaña`}
          >
            <div class="portfolio-img-wrap">
              <span class="portfolio-num text-mono">N.º {String(i + 1).padStart(2, '0')}</span>
              <span class="portfolio-year text-mono">{p.year}</span>
              <img
                src={p.image}
                alt={`${p.name} — ${p.category}`}
                width="600"
                height="375"
                loading="lazy"
                decoding="async"
                class="portfolio-img"
              />
              <div class="portfolio-overlay">
                <span class="portfolio-overlay__cta">
                  Visitar sitio
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 6h6m0 0v6m0-6L9 17"/>
                  </svg>
                </span>
              </div>
            </div>

            <div class="portfolio-content">
              <div class="portfolio-content__meta">
                <span class="portfolio-content__cat">{p.category}</span>
                {p.result && <span class="portfolio-content__result">★ {p.result}</span>}
              </div>
              <h3 class="portfolio-content__title heading-display">{p.name}</h3>
              <p class="portfolio-content__desc">{p.description}</p>
              <div class="portfolio-content__tags">
                {p.tags.map(t => <span class="tag-brutal">{t}</span>)}
              </div>
              <span class="portfolio-content__url text-mono">
                {p.url.replace('https://', '').replace('www.', '').replace(/\/$/, '')}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>

    {/* Stats strip estilo magazine */}
    <div class="portfolio-strip">
      <div class="portfolio-strip__item">
        <span class="portfolio-strip__num text-mono">50<sup>+</sup></span>
        <span class="portfolio-strip__lbl">webs entregadas</span>
      </div>
      <div class="portfolio-strip__item portfolio-strip__item--accent">
        <span class="portfolio-strip__num text-mono">99/100</span>
        <span class="portfolio-strip__lbl">lighthouse medio</span>
      </div>
      <div class="portfolio-strip__item">
        <span class="portfolio-strip__num text-mono">&lt;1s</span>
        <span class="portfolio-strip__lbl">tiempo de carga</span>
      </div>
      <div class="portfolio-strip__item portfolio-strip__item--lime">
        <span class="portfolio-strip__num text-mono">100%</span>
        <span class="portfolio-strip__lbl">clientes que repiten</span>
      </div>
    </div>
  </div>
</section>

<style>
  .brutal-section-head { display: grid; gap: 2rem; grid-template-columns: 1fr; margin-bottom: 3rem; }
  @media (min-width: 1024px) { .brutal-section-head { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 4rem; } }
  .brutal-section-head__col { display: flex; flex-direction: column; gap: 1rem; }
  .brutal-section-head__title { font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: .92; letter-spacing: -.04em; margin: 0; max-width: 14ch; }
  .brutal-section-head__title em { color: var(--brutal-accent); font-style: italic; }
  .brutal-section-head__lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 44ch; }

  /* Grid editorial */
  .portfolio-grid {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--brutal-ink);
    background: var(--brutal-ink);
  }
  @media (min-width: 768px) { .portfolio-grid { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  @media (min-width: 1280px) { .portfolio-grid { grid-template-columns: repeat(3, 1fr); } }
  .portfolio-grid > li:nth-child(3n+1) .portfolio-item { background: var(--brutal-card); }

  .portfolio-item { background: var(--brutal-bg); height: 100%; }
  .portfolio-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--brutal-ink);
    background: var(--brutal-card);
    transition: background .25s;
  }
  .portfolio-link:hover { background: var(--brutal-bg-alt); }

  .portfolio-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--brutal-surface);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .portfolio-num, .portfolio-year {
    position: absolute;
    top: 1rem;
    z-index: 2;
    background: var(--brutal-ink);
    color: var(--brutal-lime);
    padding: .25rem .55rem;
    font-size: .62rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    font-weight: 700;
  }
  .portfolio-num { left: 1rem; }
  .portfolio-year { right: 1rem; background: var(--brutal-accent); color: var(--brutal-ink); }
  .portfolio-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .6s cubic-bezier(.16,1,.3,1), filter .4s;
    filter: grayscale(.15) contrast(1.02);
  }
  .portfolio-link:hover .portfolio-img { transform: scale(1.04); filter: none; }
  .portfolio-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(14,13,11,.75));
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity .35s;
  }
  .portfolio-link:hover .portfolio-overlay { opacity: 1; }
  .portfolio-overlay__cta {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: var(--brutal-lime);
    color: var(--brutal-ink);
    padding: .75rem 1.25rem;
    border: 2px solid var(--brutal-ink);
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .15em;
    box-shadow: 4px 4px 0 0 var(--brutal-accent);
  }

  .portfolio-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    flex: 1;
  }
  .portfolio-content__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .portfolio-content__cat {
    font-family: var(--font-mono);
    font-size: .65rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--brutal-text-muted);
  }
  .portfolio-content__result {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--brutal-accent);
    font-weight: 700;
  }
  .portfolio-content__title {
    font-size: 1.5rem;
    line-height: .95;
    letter-spacing: -.025em;
    margin: 0;
    color: var(--brutal-ink);
    transition: color .2s;
  }
  .portfolio-link:hover .portfolio-content__title { color: var(--brutal-accent); }
  .portfolio-content__desc {
    font-size: .9rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
    margin: 0;
  }
  .portfolio-content__tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .25rem; }
  .portfolio-content__url {
    font-size: .68rem;
    color: var(--brutal-text-muted);
    text-transform: uppercase;
    letter-spacing: .12em;
    padding-top: .75rem;
    border-top: 1px solid var(--brutal-border-soft);
    margin-top: auto;
  }

  /* Stats strip */
  .portfolio-strip {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 2px solid var(--brutal-ink);
    background: var(--brutal-ink);
  }
  @media (min-width: 768px) { .portfolio-strip { grid-template-columns: repeat(4, 1fr); gap: 2px; } }
  .portfolio-strip__item {
    background: var(--brutal-card);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .5rem;
  }
  .portfolio-strip__item--accent { background: var(--brutal-accent); color: var(--brutal-ink); }
  .portfolio-strip__item--lime { background: var(--brutal-lime); color: var(--brutal-ink); }
  .portfolio-strip__num {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.02em;
  }
  .portfolio-strip__num sup { font-size: .5em; vertical-align: super; color: var(--brutal-accent); }
  .portfolio-strip__item--accent .portfolio-strip__num sup,
  .portfolio-strip__item--lime .portfolio-strip__num sup { color: var(--brutal-ink); }
  .portfolio-strip__lbl {
    font-family: var(--font-mono);
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    opacity: .85;
  }
</style>
