---
const steps = [
  {
    num: '01',
    title: 'Diagnóstico',
    eta: '24h',
    body: 'Llamada de 20 min. Te escuchamos, miramos competencia y te decimos qué necesitas — y qué no.',
    deliverable: 'Briefing escrito + presupuesto detallado',
  },
  {
    num: '02',
    title: 'Contenido',
    eta: '2–5 días',
    body: 'Recopilamos textos, fotos, vídeos. Si no los tienes, los producimos nosotros con nuestro equipo.',
    deliverable: 'Carpeta organizada + arquitectura de la web',
  },
  {
    num: '03',
    title: 'Diseño',
    eta: '3–5 días',
    body: 'Maqueta clicable en Figma. Tipografía, color, jerarquía. Revisas y comentas en directo.',
    deliverable: 'Prototipo Figma + sistema visual',
  },
  {
    num: '04',
    title: 'Desarrollo',
    eta: '5–7 días',
    body: 'Construimos en Astro/Next con código limpio. Lighthouse 99, accesibilidad AA, SEO técnico de serie.',
    deliverable: 'Web en entorno staging + auditoría',
  },
  {
    num: '05',
    title: 'Lanzamiento',
    eta: '1 día',
    body: 'DNS, SSL, redirecciones, Search Console. Entregamos credenciales y formación de uso.',
    deliverable: 'Sitio en producción + manual interno',
  },
];
---

<section class="section-brutal" id="proceso" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
  <div class="container-brutal">
    <header class="brutal-section-head">
      <div class="brutal-section-head__col">
        <span class="text-meta">Cap. 03 / Método</span>
        <h2 class="heading-display brutal-section-head__title">
          De cero a producción
          <em class="heading-editorial">en 2 semanas.</em>
        </h2>
      </div>
      <p class="brutal-section-head__lead">
        Cinco pasos, sin sorpresas. Cada fase tiene un entregable claro,
        una fecha y un responsable. Sin "pásamelo cuando puedas".
      </p>
    </header>

    <ol class="process-list">
      {steps.map((s, i) => (
        <li class={`process-step process-step--${i % 2 === 0 ? 'a' : 'b'}`} style={`--delay:${i * 0.1}s`}>
          <div class="process-step__rail" aria-hidden="true">
            <span class="process-step__dot"></span>
            {i < steps.length - 1 && <span class="process-step__line"></span>}
          </div>

          <div class="process-step__num">
            <span class="text-mono">{s.num}</span>
            <span class="process-step__eta">{s.eta}</span>
          </div>

          <div class="process-step__content">
            <h3 class="heading-display process-step__title">{s.title}</h3>
            <p class="process-step__body">{s.body}</p>
          </div>

          <aside class="process-step__deliverable">
            <span class="text-meta">Entregable</span>
            <p>{s.deliverable}</p>
          </aside>
        </li>
      ))}
    </ol>

    {/* Resumen final */}
    <div class="process-summary">
      <div class="process-summary__stat">
        <span class="process-summary__val text-mono">14d</span>
        <span class="process-summary__lbl">Tiempo total medio</span>
      </div>
      <div class="process-summary__stat">
        <span class="process-summary__val text-mono">2</span>
        <span class="process-summary__lbl">Rondas de revisión incluidas</span>
      </div>
      <div class="process-summary__stat">
        <span class="process-summary__val text-mono">0€</span>
        <span class="process-summary__lbl">Sin permanencia · cancelas cuando quieras</span>
      </div>
      <div class="process-summary__cta">
        <a href="/contacto" class="btn-brutal btn-brutal--lg">
          Empezar mi proyecto →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .brutal-section-head {
    display: grid; gap: 2rem; grid-template-columns: 1fr; margin-bottom: 3rem;
  }
  @media (min-width: 1024px) {
    .brutal-section-head { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 4rem; }
  }
  .brutal-section-head__col { display: flex; flex-direction: column; gap: 1rem; }
  .brutal-section-head__title { font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: .92; letter-spacing: -.04em; margin: 0; max-width: 14ch; }
  .brutal-section-head__title em { color: var(--brutal-accent); font-style: italic; }
  .brutal-section-head__lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 44ch; }

  /* ── Lista de pasos ── */
  .process-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    border-top: 2px solid var(--brutal-ink);
  }
  .process-step {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 1.25rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--brutal-border-soft);
    align-items: start;
    position: relative;
  }
  @media (min-width: 768px) {
    .process-step {
      grid-template-columns: 36px 120px 1fr 320px;
      gap: 2rem;
      align-items: start;
    }
  }
  .process-step:hover { background: var(--brutal-card); }

  .process-step__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding-top: 6px;
  }
  .process-step__dot {
    width: 14px;
    height: 14px;
    background: var(--brutal-accent);
    border: 2px solid var(--brutal-ink);
    display: block;
    flex-shrink: 0;
  }
  .process-step--b .process-step__dot { background: var(--brutal-lime); }
  .process-step__line {
    flex: 1;
    width: 2px;
    background: var(--brutal-ink);
    margin-top: 4px;
    min-height: 60px;
  }

  .process-step__num {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    font-family: var(--font-mono);
  }
  .process-step__num .text-mono {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--brutal-ink);
  }
  .process-step__eta {
    font-size: .65rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--brutal-accent);
    font-weight: 600;
  }

  .process-step__content {
    grid-column: 2 / -1;
  }
  @media (min-width: 768px) {
    .process-step__content { grid-column: auto; }
  }
  .process-step__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: .95;
    letter-spacing: -.03em;
    margin: 0 0 .65rem;
  }
  .process-step__body {
    font-size: 1rem;
    color: var(--brutal-text-secondary);
    line-height: 1.55;
    max-width: 56ch;
  }

  .process-step__deliverable {
    grid-column: 2 / -1;
    padding: 1rem;
    background: var(--brutal-card);
    border: 1.5px solid var(--brutal-ink);
    margin-top: 1rem;
  }
  @media (min-width: 768px) {
    .process-step__deliverable { grid-column: auto; margin-top: 0; }
  }
  .process-step__deliverable .text-meta {
    display: block;
    margin-bottom: .35rem;
    color: var(--brutal-accent);
  }
  .process-step__deliverable p {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--brutal-ink);
    font-size: .95rem;
    line-height: 1.4;
    margin: 0;
  }

  /* ── Resumen ── */
  .process-summary {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--brutal-ink);
    background: var(--brutal-ink);
    margin-top: 4rem;
  }
  @media (min-width: 768px) {
    .process-summary { grid-template-columns: repeat(3, 1fr) auto; gap: 2px; }
  }
  .process-summary__stat {
    background: var(--brutal-card);
    padding: 1.75rem;
  }
  .process-summary__val {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--brutal-ink);
    line-height: 1;
  }
  .process-summary__lbl {
    display: block;
    font-family: var(--font-mono);
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--brutal-text-muted);
    margin-top: .65rem;
  }
  .process-summary__cta {
    background: var(--brutal-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .process-summary__cta .btn-brutal { background: var(--brutal-ink); color: var(--brutal-lime); --shadow-color: var(--brutal-bg); }
</style>
