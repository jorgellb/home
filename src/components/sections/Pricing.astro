---
interface Plan {
  id: string;
  name: string;
  description: string;
  price: { amount: number; currency: string; period: string; display: string; };
  features: { text: string; included: boolean }[];
  popular?: boolean;
  cta: { text: string; link: string };
}

interface Props { plans?: Plan[] }

const { plans = [] } = Astro.props;
---

<section class="section-brutal" id="precios" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
  <div class="container-brutal">
    <header class="brutal-section-head">
      <div class="brutal-section-head__col">
        <span class="text-meta">Cap. 06 / Planes</span>
        <h2 class="heading-display brutal-section-head__title">
          Precios
          <em class="heading-editorial">claros,</em>
          sin asteriscos.
        </h2>
      </div>
      <p class="brutal-section-head__lead">
        Tarifas reales para proyectos reales. Si necesitas algo a medida,
        nos sentamos a calcularlo en una llamada de 20 minutos.
      </p>
    </header>

    <ol class="pricing-grid">
      {plans.map((plan, idx) => (
        <li class={`pricing-card ${plan.popular ? 'pricing-card--popular' : ''}`} style={`--i:${idx}`}>
          <header class="pricing-card__head">
            <span class="text-meta">Plan {String(idx + 1).padStart(2, '0')}</span>
            {plan.popular && (
              <span class="badge-brutal badge-brutal--lime pricing-card__pop">★ Recomendado</span>
            )}
          </header>

          <h3 class="pricing-card__name heading-display">{plan.name}</h3>
          <p class="pricing-card__desc">{plan.description}</p>

          <div class="pricing-card__price">
            <span class="pricing-card__price-num text-mono">{plan.price.display}</span>
            <span class="pricing-card__price-sub">+ IVA · {plan.price.period === 'once' ? 'pago único' : `por ${plan.price.period}`}</span>
          </div>

          <ul class="pricing-card__features">
            {plan.features.map((f) => (
              <li class={`pricing-card__feat ${f.included ? '' : 'pricing-card__feat--off'}`}>
                <span class="pricing-card__feat-mark">{f.included ? '✓' : '×'}</span>
                <span>{f.text}</span>
              </li>
            ))}
          </ul>

          <a href={plan.cta.link} class={`btn-brutal ${plan.popular ? '' : 'btn-brutal--ghost'} pricing-card__cta`}>
            {plan.cta.text}
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    {/* Microcopy honest */}
    <div class="pricing-foot">
      <p class="pricing-foot__text">
        Sin permanencia · Cancelas cuando quieras · Hosting premium incluido el primer año
      </p>
      <a href="/contacto" class="link-brutal" style="font-family:var(--font-mono);font-size:.78rem;text-transform:uppercase;letter-spacing:.15em;">
        ¿Algo distinto? Hablemos →
      </a>
    </div>
  </div>
</section>

<style>
  .brutal-section-head { display: grid; gap: 2rem; grid-template-columns: 1fr; margin-bottom: 3rem; }
  @media (min-width: 1024px) { .brutal-section-head { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 4rem; } }
  .brutal-section-head__col { display: flex; flex-direction: column; gap: 1rem; }
  .brutal-section-head__title { font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: .92; letter-spacing: -.04em; margin: 0; max-width: 14ch; }
  .brutal-section-head__title em { color: var(--brutal-accent); font-style: italic; }
  .brutal-section-head__lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 44ch; }

  .pricing-grid {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) { .pricing-grid { grid-template-columns: repeat(3, 1fr); } }

  .pricing-card {
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform .3s, box-shadow .3s;
    box-shadow: 6px 6px 0 0 var(--brutal-ink);
  }
  .pricing-card:hover { transform: translate(-4px,-4px); box-shadow: 10px 10px 0 0 var(--brutal-ink); }
  .pricing-card--popular { background: var(--brutal-ink); color: var(--brutal-bg); box-shadow: 8px 8px 0 0 var(--brutal-accent); transform: scale(1.02); }
  .pricing-card--popular:hover { box-shadow: 12px 12px 0 0 var(--brutal-accent); }
  .pricing-card--popular .text-meta { color: var(--brutal-bg-alt); }

  .pricing-card__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .85rem; border-bottom: 1px solid currentColor; opacity: 1;
  }
  .pricing-card--popular .pricing-card__head { border-bottom-color: var(--brutal-bg-alt); }

  .pricing-card__name {
    font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: .95;
    letter-spacing: -.025em; margin: 0;
  }
  .pricing-card__desc {
    font-size: .9rem; color: var(--brutal-text-secondary); line-height: 1.5; margin: 0;
  }
  .pricing-card--popular .pricing-card__desc { color: var(--brutal-bg-alt); }

  .pricing-card__price {
    padding: 1.25rem 0;
    border-block: 2px solid currentColor;
    display: flex;
    flex-direction: column;
    gap: .25rem;
  }
  .pricing-card__price-num {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--brutal-ink);
  }
  .pricing-card--popular .pricing-card__price-num { color: var(--brutal-lime); }
  .pricing-card__price-sub {
    font-family: var(--font-mono);
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--brutal-text-muted);
  }
  .pricing-card--popular .pricing-card__price-sub { color: var(--brutal-bg-alt); }

  .pricing-card__features {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .65rem;
    flex: 1;
  }
  .pricing-card__feat {
    display: flex; gap: .65rem; align-items: baseline;
    font-size: .9rem; line-height: 1.4;
  }
  .pricing-card__feat-mark {
    color: var(--brutal-accent); font-weight: 700; flex-shrink: 0;
    font-family: var(--font-mono);
  }
  .pricing-card--popular .pricing-card__feat-mark { color: var(--brutal-lime); }
  .pricing-card__feat--off { color: var(--brutal-text-muted); text-decoration: line-through; }
  .pricing-card__feat--off .pricing-card__feat-mark { color: currentColor; text-decoration: none; }

  .pricing-card__cta {
    width: 100%;
    justify-content: center;
    margin-top: .5rem;
  }
  .pricing-card--popular .btn-brutal--ghost { background: var(--brutal-lime); color: var(--brutal-ink); --shadow-color: var(--brutal-bg); }

  /* Foot */
  .pricing-foot {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .pricing-foot__text {
    font-family: var(--font-mono);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--brutal-text-secondary);
    margin: 0;
  }
</style>
