---
/**
 * Enlazado interno contextual pueblo → páginas de servicio.
 * Anchors ricos en keyword para flujo de relevancia temática y PageRank
 * desde cada landing local hacia las páginas de servicio (las "money pages").
 */
import { pueblosIT } from '../../data/servicios-it';

interface Props {
  pueblo: string;
}
const { pueblo } = Astro.props;

/* Si el municipio tiene página de Sistemas IT, el enlace va a la suya; si no,
   al índice del servicio. Así cada landing alimenta también la línea de
   informática, que hasta ahora solo recibía enlaces del menú. */
const it = pueblosIT.find((p) => p.nombre === pueblo);

const servicios = [
  { n: '01', href: '/desarrollo-web/',          label: `Diseño y desarrollo web en ${pueblo}`, desc: `Páginas web a medida para negocios de ${pueblo}, rápidas y optimizadas.` },
  { n: '02', href: '/soluciones/ecommerce/',    label: 'Tiendas online y e-commerce',    desc: 'WooCommerce con Stripe y Bizum, sin comisiones por venta.' },
  { n: '03', href: '/marketing/',               label: `SEO y marketing digital en ${pueblo}`, desc: `Posicionamiento en Google y captación de clientes en ${pueblo}.` },
  { n: '04', href: '/audiovisual/',             label: 'Producción audiovisual y dron 4K', desc: 'Vídeo corporativo, reels y fotografía aérea.' },
  { n: '05', href: '/diseno-grafico/',          label: 'Diseño gráfico y branding',      desc: 'Identidad visual, papelería, packaging y editorial.' },
  { n: '06', href: '/soporte/',                 label: 'Mantenimiento y soporte web',    desc: 'Backups, seguridad y soporte 24/7, sin permanencia.' },
  it
    ? { n: '07', href: `/informatica-empresas/${it.slug}/`, label: `Mantenimiento informático en ${pueblo}`, desc: 'Técnico en tu oficina el mismo día: equipos, redes, copias y ciberseguridad.' }
    : { n: '07', href: '/informatica-empresas/',   label: 'Mantenimiento informático para empresas', desc: 'Equipos, redes, copias y ciberseguridad con visita en el Levante y el Almanzora.' },
  { n: '08', href: '/plan-360/',                label: 'Plan 360: web e informática',    desc: `Web, soporte y sistemas de ${pueblo} en una sola cuota mensual, sin permanencia.` },
];
---

<section class="svp" aria-labelledby="svp-heading">
  <div class="container-brutal">
    <header class="svp__head">
      <span class="svp__meta">★ Servicios para {pueblo}</span>
      <h2 id="svp-heading" class="svp__title">
        Todo lo digital para tu negocio en <em>{pueblo}</em>.
      </h2>
    </header>

    <ul class="svp__grid">
      {servicios.map((s) => (
        <li class="svp__item">
          <span class="svp__n">{s.n}</span>
          <a href={s.href} class="svp__link">{s.label}</a>
          <span class="svp__desc">{s.desc}</span>
          <span class="svp__arrow" aria-hidden="true">→</span>
        </li>
      ))}
    </ul>

    <p class="svp__foot">
      ¿Tu empresa también está en otra localidad? Mira nuestro
      <a href="/diseno-web/">diseño web en toda Almería</a>, descubre los
      <a href="/soluciones/empresa/">packs para empresas</a> y
      <a href="/soluciones/emprendedor/">emprendedores</a>, o
      <a href="/contacto/">pide presupuesto para {pueblo}</a>.
    </p>
  </div>
</section>

<style>
  /* Fase 2: paleta de consola. Lo usan las 23 landings de pueblo, así que
     este bloque las cierra a todas de una vez. */
  .svp {
    background: var(--color-cdm-suelo);
    color: var(--color-cdm-texto);
    padding: 4.5rem 1.5rem;
    border-bottom: 1px solid var(--color-cdm-regla);
  }
  .svp__head { max-width: 760px; margin-bottom: 2rem; }
  .svp__meta {
    font-family: var(--font-mono, monospace);
    font-size: .7rem; letter-spacing: .25em; font-weight: 800;
    color: var(--color-cdm-senal); text-transform: uppercase;
  }
  .svp__title {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    line-height: .98; letter-spacing: -.035em;
    margin: .85rem 0 0;
  }
  .svp__title em { font-style: italic; color: var(--color-cdm-senal); }

  .svp__grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 1px solid var(--color-cdm-regla-2);
    background: var(--color-cdm-regla);
  }
  @media (min-width: 640px)  { .svp__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .svp__grid { grid-template-columns: 1fr 1fr 1fr; } }

  .svp__item {
    position: relative;
    background: var(--color-cdm-panel);
    padding: 1.5rem 1.4rem 1.4rem;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'n link' 'desc desc';
    gap: .15rem .75rem;
    border-right: 1px solid var(--color-cdm-regla);
    border-bottom: 1px solid var(--color-cdm-regla);
    transition: background .2s;
  }
  /* El hover era lima; la lima significa ahora «ok/verificado» (§3.3.2). */
  .svp__item:hover { background: var(--color-cdm-panel-2); }
  @media (min-width: 1024px) {
    .svp__item:nth-child(3n) { border-right: none; }
    .svp__item:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .svp__item:nth-child(2n) { border-right: none; }
    .svp__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .svp__item { border-right: none; } .svp__item:last-child { border-bottom: none; } }

  .svp__n {
    grid-area: n;
    font-family: var(--font-mono, monospace);
    font-size: .8rem; font-weight: 800; color: var(--color-cdm-senal);
  }
  .svp__link {
    grid-area: link;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 1.08rem; line-height: 1.1; letter-spacing: -.02em;
    color: var(--color-cdm-texto); text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 2px; background-position: 0 100%; background-repeat: no-repeat;
    transition: background-size .25s;
  }
  .svp__item:hover .svp__link { background-size: 100% 2px; }
  .svp__link::after { content: ''; position: absolute; inset: 0; } /* toda la tarjeta clicable */
  .svp__desc {
    grid-area: desc;
    font-size: .85rem; line-height: 1.45; color: var(--color-cdm-tenue); margin-top: .35rem;
  }
  .svp__arrow {
    position: absolute; top: 1.3rem; right: 1.2rem;
    font-family: var(--font-mono, monospace); font-size: 1.1rem; color: var(--color-cdm-senal);
    transform: translateX(-4px); opacity: 0; transition: transform .25s, opacity .25s;
  }
  .svp__item:hover .svp__arrow { transform: translateX(0); opacity: 1; }

  .svp__foot {
    margin: 1.5rem 0 0;
    font-size: .95rem; line-height: 1.6; color: var(--color-cdm-tenue);
    max-width: 70ch;
  }
  .svp__foot a {
    color: var(--color-cdm-texto); font-weight: 700;
    text-decoration: underline; text-decoration-color: var(--color-cdm-senal);
    text-underline-offset: 3px; text-decoration-thickness: 2px;
  }
  .svp__foot a:hover { color: var(--color-cdm-senal); }
</style>
