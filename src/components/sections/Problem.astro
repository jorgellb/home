---
const cases = [
  {
    n: '01',
    href: '/soluciones/emprendedor/',
    quote: 'Quiero hacer una web pero no tengo tiempo',
    audience: 'Emprendedor',
    tone: 'Abrumado',
    answer: 'Nos encargamos de todo y te lo entregamos listo para vender. Sin Wordpress, sin plantillas, sin perderte en plugins.',
    accent: 'accent',
  },
  {
    n: '02',
    href: '/soluciones/empresa/',
    quote: 'Mi web está anticuada y no se ve bien',
    audience: 'Empresa',
    tone: 'Desactualizada',
    answer: 'Rediseño completo con identidad sólida, performance 99/100 y un CMS que tu equipo puede usar sin curso de seis meses.',
    accent: 'ink',
  },
  {
    n: '03',
    href: '/soluciones/ecommerce/',
    quote: 'Necesito vender online y no sé por dónde empezar',
    audience: 'E-commerce',
    tone: 'Sin ventas',
    answer: 'Tienda optimizada para conversión, pasarela de pago, gestión de pedidos y SEO técnico. Listo para escalar desde el día uno.',
    accent: 'lime',
  },
];
---

<section class="section-brutal" id="problem">
  <div class="container-brutal">
    {/* Cabecera editorial */}
    <header class="brutal-section-head">
      <div class="brutal-section-head__col">
        <span class="text-meta">Cap. 01 / Diagnóstico</span>
        <h2 class="heading-display brutal-section-head__title">
          ¿Dónde está
          <em class="heading-editorial">tu negocio</em>
          hoy mismo?
        </h2>
      </div>
      <p class="brutal-section-head__lead">
        El 90% de tus clientes te busca primero en Google. Si lo que encuentran
        es una web genérica, lenta o que no existe — no llegas a la lista corta.
        Aquí van los tres escenarios más habituales.
      </p>
    </header>

    <div class="ascii-rule">┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄</div>

    {/* Casos */}
    <div class="problem-grid">
      {cases.map((c) => (
        <a href={c.href} class={`problem-card problem-card--${c.accent}`}>
          <header class="problem-card__head">
            <span class="problem-card__num">{c.n}</span>
            <span class="problem-card__tone">// {c.tone}</span>
          </header>

          <blockquote class="problem-card__quote">
            <span aria-hidden="true" class="problem-card__qmark">“</span>
            {c.quote}
          </blockquote>

          <div class="problem-card__body">
            <p class="problem-card__audience">
              <span class="text-meta">Para:</span>
              <strong>{c.audience}</strong>
            </p>
            <p class="problem-card__answer">{c.answer}</p>
          </div>

          <footer class="problem-card__foot">
            <span class="problem-card__cta">Ver solución →</span>
          </footer>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Cabecera de sección reutilizable ── */
  .brutal-section-head {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin-bottom: 3rem;
  }
  @media (min-width: 1024px) {
    .brutal-section-head { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 4rem; }
  }
  .brutal-section-head__col { display: flex; flex-direction: column; gap: 1rem; }
  .brutal-section-head__title {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: 0;
    max-width: 14ch;
  }
  .brutal-section-head__title em { font-style: italic; color: var(--brutal-accent); }
  .brutal-section-head__lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 44ch;
  }

  /* ── Grid de casos ── */
  .problem-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) { .problem-grid { grid-template-columns: repeat(3, 1fr); } }

  .problem-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--brutal-card);
    color: var(--brutal-ink);
    border: 2px solid var(--brutal-ink);
    padding: 2rem;
    min-height: 420px;
    transition: transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s, background .25s;
    box-shadow: 6px 6px 0 0 var(--brutal-ink);
  }
  .problem-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 0 var(--brutal-ink);
  }
  .problem-card--accent:hover { background: var(--brutal-accent-soft); }
  .problem-card--lime:hover   { background: var(--brutal-lime-soft); box-shadow: 9px 9px 0 0 var(--brutal-lime); }
  .problem-card--ink:hover    { background: var(--brutal-ink); color: var(--brutal-bg); box-shadow: 9px 9px 0 0 var(--brutal-accent); }
  .problem-card--ink:hover .problem-card__num { color: var(--brutal-accent); }
  .problem-card--ink:hover .text-meta { color: var(--brutal-bg-alt); }

  .problem-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid currentColor;
    opacity: 1;
  }
  .problem-card__num {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--brutal-accent);
    letter-spacing: -.02em;
  }
  .problem-card__tone {
    font-family: var(--font-mono);
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--brutal-text-muted);
  }

  .problem-card__quote {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.2vw, 1.85rem);
    line-height: 1.2;
    margin: 1.5rem 0 0;
    color: var(--brutal-ink);
    position: relative;
  }
  .problem-card--ink:hover .problem-card__quote { color: var(--brutal-lime); }
  .problem-card__qmark {
    color: var(--brutal-accent);
    font-size: 2.2em;
    line-height: 0;
    vertical-align: -.05em;
    margin-right: .1em;
    font-family: var(--font-editorial);
  }

  .problem-card__body {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }
  .problem-card__audience {
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--brutal-text-secondary);
    display: flex;
    gap: .5rem;
    align-items: baseline;
  }
  .problem-card__audience strong { color: var(--brutal-ink); font-family: var(--font-display); font-weight: 700; font-size: 1rem; }
  .problem-card--ink:hover .problem-card__audience { color: var(--brutal-bg-alt); }
  .problem-card--ink:hover .problem-card__audience strong { color: var(--brutal-bg); }
  .problem-card__answer { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); }
  .problem-card--ink:hover .problem-card__answer { color: var(--brutal-bg-alt); }

  .problem-card__foot { margin-top: auto; padding-top: 2rem; }
  .problem-card__cta {
    font-family: var(--font-mono);
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--brutal-ink);
    font-weight: 700;
    position: relative;
    display: inline-block;
  }
  .problem-card__cta::after {
    content: '';
    display: block;
    height: 2px;
    background: var(--brutal-accent);
    width: 0;
    transition: width .25s ease;
    margin-top: .3rem;
  }
  .problem-card:hover .problem-card__cta::after { width: 100%; }
  .problem-card--ink:hover .problem-card__cta { color: var(--brutal-lime); }
</style>
