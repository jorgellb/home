---
// Hero Section - Premium Design with Team Image Background
---

<section class="relative min-h-screen flex items-center overflow-hidden" id="hero">
  {/* LCP Optimized Background Image */}
  <img
    src="/imagenes/equipo-diseno-mantenimiento-web.jpg"
    alt="Equipo de diseño web y marketing digital Platanito Rico en Almería"
    class="absolute inset-0 z-0 w-full h-full object-cover"
    fetchpriority="high"
    decoding="sync"
  />

  {/* Dark Overlay */}
  <div class="absolute inset-0 z-[1]" style="background: linear-gradient(135deg, rgba(15,23,42,0.80) 0%, rgba(15,23,42,0.65) 40%, rgba(124,45,18,0.50) 100%);"></div>

  {/* Floating Orbs */}
  <div class="absolute top-20 -left-32 w-[500px] h-[500px] bg-orange-500/25 rounded-full blur-[120px] animate-orb-float z-[2]"></div>
  <div class="absolute bottom-20 -right-32 w-[400px] h-[400px] bg-amber-500/25 rounded-full blur-[100px] animate-orb-float-reverse z-[2]"></div>

  {/* Animated Light Rays */}
  <div class="absolute inset-0 overflow-hidden z-[2]">
    <div class="absolute top-0 left-1/4 w-1 h-full bg-gradient-to-b from-orange-400/15 via-transparent to-transparent transform -rotate-12 animate-light-ray"></div>
    <div class="absolute top-0 left-1/2 w-0.5 h-full bg-gradient-to-b from-amber-400/10 via-transparent to-transparent transform rotate-6 animate-light-ray" style="animation-delay: 1s;"></div>
    <div class="absolute top-0 right-1/3 w-1 h-full bg-gradient-to-b from-orange-300/15 via-transparent to-transparent transform -rotate-6 animate-light-ray" style="animation-delay: 2s;"></div>
  </div>

  <div class="container-premium relative z-10 py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">

        {/* Badge */}
        <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 shadow-lg mb-8 animate-fade-in-up">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          <span class="text-sm font-medium text-white/90">Agencia digital en Almería — Disponible para proyectos</span>
        </div>

        {/* Main Heading — SEO optimizado */}
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.08] mb-6 animate-fade-in-up" style="animation-delay: 0.1s;">
          <span class="text-white">Diseño web en</span>
          <br />
          <span class="bg-gradient-to-r from-orange-400 via-amber-300 to-orange-400 bg-clip-text text-transparent">Almería</span>
          <span class="text-white"> que</span>
          <br />
          <span class="text-white">convierte</span>
        </h1>

        {/* Subtitle */}
        <p class="text-lg sm:text-xl md:text-2xl text-white/80 max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in-up" style="animation-delay: 0.2s;">
          Creamos <strong class="text-white">páginas web profesionales</strong>, tiendas online y estrategias SEO para negocios de Almería.
          <span class="text-orange-300 font-semibold">Hosting gratuito. Entrega en 1-2 semanas.</span>
        </p>

        {/* CTAs */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12 animate-fade-in-up" style="animation-delay: 0.3s;">
          <a
            href="#contacto"
            class="group relative inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-orange-500 to-amber-500 text-white font-semibold rounded-full overflow-hidden shadow-xl shadow-orange-500/30 hover:shadow-2xl transition-all duration-300 hover:-translate-y-0.5"
          >
            <span>Pedir presupuesto gratis</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></span>
          </a>
          <a
            href="#portfolio"
            class="group inline-flex items-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-sm text-white font-semibold rounded-full border border-white/30 hover:bg-white/20 transition-all duration-300"
          >
            <svg class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Ver portfolio</span>
          </a>
        </div>

        {/* Trust Indicators */}
        <div class="flex flex-wrap items-center justify-center gap-3 mb-16 animate-fade-in-up" style="animation-delay: 0.4s;">
          <div class="flex items-center gap-2 text-sm text-white/80 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/20">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Hosting gratuito</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-white/80 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/20">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Entrega 1-2 semanas</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-white/80 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/20">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>100/100 PageSpeed</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-white/80 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/20">
            <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Sin permanencia</span>
          </div>
        </div>

        {/* Stats Row */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto animate-fade-in-up" style="animation-delay: 0.5s;">
          <div class="text-center p-6 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 hover:bg-white/15 transition-colors group">
            <div class="text-3xl font-bold text-white mb-1 group-hover:text-orange-300 transition-colors">50+</div>
            <div class="text-sm text-white/70">Webs entregadas</div>
          </div>
          <div class="text-center p-6 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 hover:bg-white/15 transition-colors group">
            <div class="text-3xl font-bold text-white mb-1 group-hover:text-orange-300 transition-colors">100%</div>
            <div class="text-sm text-white/70">Clientes satisfechos</div>
          </div>
          <div class="text-center p-6 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 hover:bg-white/15 transition-colors group">
            <div class="text-3xl font-bold text-white mb-1 group-hover:text-orange-300 transition-colors">0€</div>
            <div class="text-sm text-white/70">Hosting anual</div>
          </div>
          <div class="text-center p-6 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 hover:bg-white/15 transition-colors group">
            <div class="text-3xl font-bold text-white mb-1 group-hover:text-orange-300 transition-colors">&lt;1s</div>
            <div class="text-sm text-white/70">Tiempo de carga</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  {/* Scroll indicator */}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <svg class="w-6 h-6 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  @keyframes orb-float {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.25; }
    33% { transform: translate(30px, -30px) scale(1.05); opacity: 0.35; }
    66% { transform: translate(-20px, 20px) scale(0.95); opacity: 0.25; }
  }

  @keyframes orb-float-reverse {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.25; }
    33% { transform: translate(-30px, 30px) scale(1.05); opacity: 0.35; }
    66% { transform: translate(20px, -20px) scale(0.95); opacity: 0.25; }
  }

  @keyframes light-ray {
    0%, 100% { opacity: 0; transform: translateY(-100%) rotate(var(--tw-rotate)); }
    50% { opacity: 1; }
  }

  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-orb-float {
    animation: orb-float 20s ease-in-out infinite;
  }

  .animate-orb-float-reverse {
    animation: orb-float-reverse 25s ease-in-out infinite;
  }

  .animate-light-ray {
    animation: light-ray 8s ease-in-out infinite;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0;
  }
</style>
