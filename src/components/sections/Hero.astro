---
// Hero — Risograph Editorial Brutalist
const today = new Date().toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
---

<section id="hero" class="brutal-hero">
  {/* Líneas guía verticales (12 columnas) */}
  <div class="brutal-hero__guides" aria-hidden="true"></div>

  {/* Marginalia derecha (vertical) */}
  <div class="brutal-hero__marginalia" aria-hidden="true">
    <span class="marginalia">vol. iv — almería · est. 2018</span>
  </div>

  <div class="container-brutal brutal-hero__inner">
    {/* Cabecera de revista */}
    <header class="brutal-hero__masthead">
      <div class="brutal-hero__folio">
        <span class="editorial-folio">N.º 026 — {today}</span>
      </div>
      <div class="brutal-hero__edition text-meta">
        Edición de portfolio · 2026
      </div>
      <div class="brutal-hero__weather text-meta">
        <span class="live-dot"></span> En directo desde Almería · 21°C
      </div>
    </header>

    <div class="divider-brutal"></div>

    {/* Bloque tipográfico principal */}
    <div class="brutal-hero__type reveal-up">
      <span class="brutal-hero__pretitle text-meta">
        <span style="color:var(--brutal-accent)">★</span> Estudio digital de Almería
      </span>

      <h1 class="brutal-hero__h1">
        <span class="brutal-hero__line">Diseñamos</span>
        <span class="brutal-hero__line brutal-hero__line--accent">páginas web,</span>
        <span class="brutal-hero__line">
          <em class="heading-editorial">marcas</em> que <em class="heading-editorial">venden</em>
        </span>
        <span class="brutal-hero__line">y vídeos que <span class="brutal-hero__highlight">se ven</span>.</span>
      </h1>
    </div>

    {/* Metadata derecha */}
    <aside class="brutal-hero__meta reveal-up stagger-2">
      <p class="brutal-hero__lead">
        Estudio independiente desde 2018. Diseño web, audiovisual, identidad y SEO
        para negocios que quieren <strong>destacar</strong> en lugar de
        <span style="text-decoration:line-through;color:var(--brutal-text-muted)">parecerse a todos</span>.
      </p>

      <div class="brutal-hero__cta-row">
        <a href="/contacto/" class="btn-brutal btn-brutal--lg">
          Presupuesto gratis
          <span aria-hidden="true">→</span>
        </a>
        <a href="#portfolio" class="link-brutal" style="font-family:var(--font-mono);font-size:.78rem;text-transform:uppercase;letter-spacing:.15em;">
          Ver portfolio ↓
        </a>
      </div>
    </aside>

    {/* Spec sheet — bento brutal */}
    <div class="brutal-hero__specs reveal-up stagger-3">
      <article class="brutal-hero__spec brutal-hero__spec--accent">
        <span class="brutal-hero__spec-num">01</span>
        <div>
          <p class="brutal-hero__spec-figure text-mono">50+</p>
          <p class="brutal-hero__spec-label">Proyectos enviados desde 2018</p>
        </div>
      </article>
      <article class="brutal-hero__spec">
        <span class="brutal-hero__spec-num">02</span>
        <div>
          <p class="brutal-hero__spec-figure text-mono">&lt;1.0s</p>
          <p class="brutal-hero__spec-label">Velocidad de carga objetivo</p>
        </div>
      </article>
      <article class="brutal-hero__spec brutal-hero__spec--lime">
        <span class="brutal-hero__spec-num">03</span>
        <div>
          <p class="brutal-hero__spec-figure text-mono">99/100</p>
          <p class="brutal-hero__spec-label">Lighthouse Performance medio</p>
        </div>
      </article>
      <article class="brutal-hero__spec brutal-hero__spec--ink">
        <span class="brutal-hero__spec-num">04</span>
        <div>
          <p class="brutal-hero__spec-figure text-mono">450€</p>
          <p class="brutal-hero__spec-label">Punto de entrada — sin permanencia</p>
        </div>
      </article>
    </div>
  </div>

  {/* Marquee inferior — manifiesto */}
  <div class="brutal-hero__manifesto" aria-hidden="true">
    <div class="brutal-hero__manifesto-track">
      <span>NO PLANTILLAS</span><span>★</span>
      <span>SIN PERMANENCIA</span><span>★</span>
      <span>CÓDIGO LIMPIO</span><span>★</span>
      <span>DISEÑO CON CRITERIO</span><span>★</span>
      <span>HECHO EN ALMERÍA</span><span>★</span>
      <span>NO PLANTILLAS</span><span>★</span>
      <span>SIN PERMANENCIA</span><span>★</span>
      <span>CÓDIGO LIMPIO</span><span>★</span>
      <span>DISEÑO CON CRITERIO</span><span>★</span>
      <span>HECHO EN ALMERÍA</span><span>★</span>
    </div>
  </div>
</section>

<style>
  .brutal-hero {
    position: relative;
    min-height: 100vh;
    background: var(--brutal-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-bottom: 3px solid var(--brutal-ink);
  }

  /* Líneas guía editoriales */
  .brutal-hero__guides {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right,
        color-mix(in srgb, var(--brutal-ink) 6%, transparent) 1px,
        transparent 1px);
    background-size: calc(100% / 12) 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Marginalia vertical */
  .brutal-hero__marginalia {
    position: absolute;
    top: 50%;
    right: 1.5rem;
    transform: translateY(-50%);
    z-index: 2;
    display: none;
  }
  @media (min-width: 1280px) {
    .brutal-hero__marginalia { display: block; }
  }

  .brutal-hero__inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 0;
    flex: 1;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    grid-template-areas:
      'masthead'
      'divider'
      'type'
      'meta'
      'specs';
  }
  .brutal-hero__inner > .divider-brutal { grid-area: divider; }

  @media (min-width: 1024px) {
    .brutal-hero__inner {
      grid-template-columns: 7fr 5fr;
      grid-template-areas:
        'masthead masthead'
        'divider  divider'
        'type     meta'
        'specs    specs';
      gap: 3.5rem 2.5rem;
    }
  }

  /* Masthead */
  .brutal-hero__masthead {
    grid-area: masthead;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .brutal-hero__weather { display: inline-flex; align-items: center; gap: .5rem; }

  /* Tipografía principal */
  .brutal-hero__type { grid-area: type; }
  .brutal-hero__pretitle {
    display: inline-flex;
    gap: .4rem;
    margin-bottom: 2rem;
  }
  .brutal-hero__h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 10vw, 7.5rem);
    line-height: .84;
    letter-spacing: -0.045em;
    color: var(--brutal-ink);
    margin: 0;
  }
  .brutal-hero__line { display: block; }
  .brutal-hero__line--accent { color: var(--brutal-accent); }
  .brutal-hero__line em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--brutal-ink);
    font-size: 1.05em;
    letter-spacing: -.02em;
  }
  .brutal-hero__highlight {
    position: relative;
    display: inline-block;
    background: var(--brutal-lime);
    padding: 0 .15em;
    transform: rotate(-1deg);
  }

  /* Metadata derecha */
  .brutal-hero__meta {
    grid-area: meta;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2rem;
  }
  .brutal-hero__lead {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 38ch;
  }
  .brutal-hero__lead strong { color: var(--brutal-ink); font-weight: 700; }
  .brutal-hero__cta-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* Spec bento */
  .brutal-hero__specs {
    grid-area: specs;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0;
    border-top: 2px solid var(--brutal-ink);
    border-bottom: 2px solid var(--brutal-ink);
    margin-top: 2rem;
  }
  .brutal-hero__spec {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem 1.25rem;
    border-right: 1px solid var(--brutal-ink);
    background: var(--brutal-card);
    transition: background .25s, color .25s;
    position: relative;
  }
  .brutal-hero__spec:last-child { border-right: none; }
  .brutal-hero__spec:hover { background: var(--brutal-bg-alt); }
  .brutal-hero__spec--accent { background: var(--brutal-accent); color: #FFFCF6; }
  .brutal-hero__spec--accent:hover { background: var(--brutal-accent-hover); }
  .brutal-hero__spec--lime { background: var(--brutal-lime); }
  .brutal-hero__spec--lime:hover { background: var(--brutal-lime-soft); }
  .brutal-hero__spec--ink { background: var(--brutal-ink); color: var(--brutal-bg); }
  .brutal-hero__spec--ink:hover { background: var(--brutal-ink-soft); }
  .brutal-hero__spec-num {
    font-family: var(--font-mono);
    font-size: .65rem;
    letter-spacing: .2em;
    opacity: .55;
    line-height: 1.5;
  }
  .brutal-hero__spec-figure {
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1;
    margin: 0;
  }
  .brutal-hero__spec-label {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    line-height: 1.4;
    margin-top: .5rem;
    opacity: .85;
  }

  /* Manifesto marquee */
  .brutal-hero__manifesto {
    background: var(--brutal-ink);
    color: var(--brutal-bg);
    overflow: hidden;
    border-top: 2px solid var(--brutal-ink);
    padding: 1.25rem 0;
  }
  .brutal-hero__manifesto-track {
    display: flex;
    width: max-content;
    gap: 2.5rem;
    align-items: center;
    animation: marquee 32s linear infinite;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -.02em;
    text-transform: uppercase;
    color: var(--brutal-bg);
    padding-left: 2rem;
  }
  .brutal-hero__manifesto-track span:nth-child(even) {
    color: var(--brutal-accent);
    font-family: var(--font-mono);
    font-size: 1rem;
  }
</style>
