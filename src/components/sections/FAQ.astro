---
const faqs = [
  { q: '¿Cuánto cuesta una web profesional en Almería?', a: 'Una web corporativa parte desde 500€. Tiendas online desde 700€. Landing de una página desde 350€. Incluimos hosting gratuito para webs estáticas (ahorro de 150–300€/año frente a WordPress) y presupuesto personalizado sin compromiso.' },
  { q: '¿Incluye hosting gratuito?', a: 'Sí. Nuestras webs estáticas (Astro) se alojan en servidores premium sin coste anual. Tu web carga en menos de 1 segundo, puntúa 100/100 en PageSpeed y nunca cae por problemas de servidor.' },
  { q: '¿En cuánto tiempo tendré mi web lista?', a: 'Entre 1 y 2 semanas para webs corporativas. Tiendas online y proyectos complejos: 3–4 semanas. Te mantenemos informado en cada fase y entregamos con dos rondas de revisiones incluidas.' },
  { q: '¿Puedo gestionar la web yo mismo?', a: 'Sí. Entregamos credenciales y documentación detallada. También ofrecemos formación personalizada y planes de mantenimiento desde 50€/mes con soporte prioritario.' },
  { q: '¿Hacéis SEO local para negocios en Almería?', a: 'Sí, es nuestra especialidad. Optimizamos tu Google Business Profile, estructuramos contenido con keywords locales y construimos arquitectura SEO para "diseño web Almería", "dentista Vera" o "hotel Mojácar".' },
  { q: '¿Qué formas de pago aceptan?', a: 'Transferencia bancaria, PayPal y tarjeta. 50% al inicio del proyecto y 50% a la entrega final. Incluimos dos rondas de revisiones y garantía de satisfacción.' },
];
---

<section class="section-brutal faq-seccion" id="faq">
  <div class="container-brutal">
    <header class="brutal-section-head">
      <div class="brutal-section-head__col">
        <span class="text-meta">Cap. 08 / Preguntas frecuentes</span>
        <h2 class="heading-display brutal-section-head__title">
          Lo que más
          <em class="heading-editorial">nos preguntan.</em>
        </h2>
      </div>
      <p class="brutal-section-head__lead">
        Si no encuentras lo que buscas, escríbenos. Respondemos en menos de
        24 horas — sin filtros comerciales, sin esquivar la pregunta.
      </p>
    </header>

    <div class="faq-grid">
      <ol class="faq-list">
        {faqs.map((f, i) => (
          <li class="faq-item">
            <details class="faq-details" open={i === 0}>
              <summary class="faq-summary">
                <span class="faq-num text-mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-q heading-display">{f.q}</span>
                <span class="faq-toggle" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>

      <aside class="faq-aside">
        <div class="faq-aside__card">
          <span class="text-meta">¿No está aquí?</span>
          <h3 class="heading-display faq-aside__title">
            Pregunta lo que
            <em class="heading-editorial">quieras.</em>
          </h3>
          <p class="faq-aside__text">
            Respondemos en menos de 24 horas. Si no podemos hacer algo,
            te lo decimos a la cara y te recomendamos a quien sí pueda.
          </p>
          <a href="/contacto/" class="faq-aside__cta">Hablemos</a>
        </div>
        <div class="faq-aside__chips">
          <span class="tag-brutal">★ Sin permanencia</span>
          <span class="tag-brutal">Hosting incluido</span>
          <span class="tag-brutal">Soporte real</span>
          <span class="tag-brutal">Lighthouse 99+</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Tono consola (fase 4). Solo lo usa /contacto/. Se reasigna la paleta
     brutal dentro de la sección, como en Contact, para que los utilitarios
     globales (text-meta, tag-brutal, cabecera de sección) salgan en oscuro. */
  .faq-seccion {
    --brutal-bg: var(--color-cdm-suelo);
    --brutal-bg-alt: var(--color-cdm-panel-2);
    --brutal-card: var(--color-cdm-panel);
    --brutal-ink: var(--color-cdm-texto);
    --brutal-text-secondary: #b9c5cf;
    --brutal-text-muted: var(--color-cdm-tenue);
    --brutal-accent-ink: var(--color-cdm-senal);
    --brutal-border-soft: var(--color-cdm-regla);
    color-scheme: dark;
    background: var(--color-cdm-suelo);
    color: var(--color-cdm-texto);
    border-top: 1px solid var(--color-cdm-regla);
  }
  .brutal-section-head { display: grid; gap: 2rem; grid-template-columns: 1fr; margin-bottom: 3rem; }
  @media (min-width: 1024px) { .brutal-section-head { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 4rem; } }
  .brutal-section-head__col { display: flex; flex-direction: column; gap: 1rem; }
  .brutal-section-head__title { font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: .92; letter-spacing: -.04em; margin: 0; max-width: 14ch; }
  .brutal-section-head__title em { color: var(--brutal-accent-ink); font-style: italic; }
  .brutal-section-head__lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 44ch; }

  .faq-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) { .faq-grid { grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: start; } }

  /* Lista */
  .faq-list {
    list-style: none; padding: 0; margin: 0;
    border-top: 1px solid var(--color-cdm-regla-2);
  }
  .faq-item { border-bottom: 1px solid var(--color-cdm-regla); background: var(--brutal-card); }
  .faq-item:has(details[open]) { background: var(--brutal-bg-alt); }

  .faq-details { padding: 1.25rem 1.5rem; }
  .faq-summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-num {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--brutal-accent-ink);
    line-height: 1;
  }
  .faq-q {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.2;
    letter-spacing: -.025em;
    color: var(--brutal-ink);
    margin: 0;
  }
  .faq-toggle {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--brutal-card);
    border: 1px solid var(--color-cdm-regla-2);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
    transition: transform .25s, background .15s, color .15s;
  }
  details[open] .faq-toggle {
    background: var(--color-cdm-senal);
    color: #120600;
    transform: rotate(45deg);
  }
  .faq-answer {
    padding: 1.25rem 0 .5rem 3.25rem;
    border-top: 1px dashed var(--brutal-border-soft);
    margin-top: 1rem;
  }
  .faq-answer p {
    font-size: .95rem;
    line-height: 1.6;
    color: var(--brutal-text-secondary);
    margin: 0;
    max-width: 60ch;
  }

  /* Aside */
  .faq-aside { display: flex; flex-direction: column; gap: 1rem; }
  /* Tarjeta en lima: todo su texto va en oscuro. */
  .faq-aside__card {
    background: var(--color-cdm-ok);
    color: var(--color-cdm-suelo);
    border: 1px solid var(--color-cdm-ok);
    padding: 2rem;
    box-shadow: 6px 6px 0 0 var(--color-cdm-regla-2);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .faq-aside__title { font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: .92; letter-spacing: -.03em; margin: 0; }
  .faq-aside__card .text-meta { color: var(--color-cdm-suelo); }
  .faq-aside__title { color: var(--color-cdm-suelo); }
  .faq-aside__title em { color: var(--color-cdm-suelo); }
  .faq-aside__text { font-size: .95rem; color: var(--color-cdm-suelo); line-height: 1.5; }
  .faq-aside__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.7rem 1.15rem;
    background: var(--color-cdm-suelo);
    color: var(--color-cdm-texto);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--color-cdm-suelo);
  }
  .faq-aside__cta:hover { background: var(--color-cdm-panel-2); }
  .faq-aside__cta:focus-visible { outline: 2px solid var(--color-cdm-suelo); outline-offset: 3px; }
  .faq-aside__chips { display: flex; flex-wrap: wrap; gap: .4rem; }
</style>
