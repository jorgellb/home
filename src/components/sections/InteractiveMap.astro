---
interface Props {
  center: [number, number];
  zoom?: number;
  pitch?: number;
  bearing?: number;
  height?: string;
  label?: string;
}

const { center, zoom = 13, pitch = 25, bearing = -15, height = "420px", label } = Astro.props;
const mapId = `map-${Math.random().toString(36).substring(7)}`;
---

<section class="map-premium-section">
  <div 
    id={mapId} 
    class="maplibre-map rounded-3xl overflow-hidden"
    style={`height: ${height};`}
    data-center={JSON.stringify(center)}
    data-zoom={zoom}
    data-pitch={pitch}
    data-bearing={bearing}
    data-label={label || ''}
  ></div>
  
  <div class="map-overlay-decor">
    <svg class="corner-decoration top-left" viewBox="0 0 60 60" fill="none">
      <path d="M0 30 Q0 0 30 0" stroke="currentColor" stroke-width="2" fill="none" opacity="0.5"/>
      <circle cx="30" cy="0" r="3" fill="currentColor" opacity="0.8"/>
    </svg>
    <svg class="corner-decoration top-right" viewBox="0 0 60 60" fill="none">
      <path d="M30 0 Q60 0 60 30" stroke="currentColor" stroke-width="2" fill="none" opacity="0.5"/>
      <circle cx="60" cy="30" r="3" fill="currentColor" opacity="0.8"/>
    </svg>
    <svg class="corner-decoration bottom-left" viewBox="0 0 60 60" fill="none">
      <path d="M0 30 Q0 60 30 60" stroke="currentColor" stroke-width="2" fill="none" opacity="0.5"/>
      <circle cx="30" cy="60" r="3" fill="currentColor" opacity="0.8"/>
    </svg>
    <svg class="corner-decoration bottom-right" viewBox="0 0 60 60" fill="none">
      <path d="M30 60 Q60 60 60 30" stroke="currentColor" stroke-width="2" fill="none" opacity="0.5"/>
      <circle cx="60" cy="30" r="3" fill="currentColor" opacity="0.8"/>
    </svg>
  </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

<style>
  .map-premium-section {
    position: relative;
    --map-primary: #c8a45a;
    --map-primary-light: #e4c97a;
    --map-glow: rgba(200, 164, 90, 0.4);
    --map-bg: #f8f9fa;
    --map-border: rgba(200, 164, 90, 0.2);
  }

  .maplibre-map {
    width: 100%;
    background: var(--map-bg);
    border: 1px solid var(--map-border);
  }

  .map-overlay-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
  }

  .corner-decoration {
    position: absolute;
    width: 60px;
    height: 60px;
    color: var(--map-primary);
    opacity: 0.6;
  }

  .corner-decoration.top-left { top: 8px; left: 8px; }
  .corner-decoration.top-right { top: 8px; right: 8px; transform: rotate(90deg); }
  .corner-decoration.bottom-left { bottom: 8px; left: 8px; transform: rotate(-90deg); }
  .corner-decoration.bottom-right { bottom: 8px; right: 8px; transform: rotate(180deg); }

  :global(.maplibregl-ctrl-group) {
    background: #ffffff !important;
    border: 1px solid rgba(200, 164, 90, 0.2) !important;
    border-radius: 8px !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
  }

  :global(.maplibregl-ctrl-group button) {
    background: #ffffff !important;
    border-bottom: 1px solid rgba(200, 164, 90, 0.1) !important;
  }

  :global(.maplibregl-ctrl-group button:hover) {
    background: rgba(200, 164, 90, 0.1) !important;
  }

  :global(.maplibregl-ctrl-icon) {
    filter: none !important;
  }

  :global(.premium-marker) {
    position: relative;
    width: 60px;
    height: 60px;
    cursor: pointer;
  }

  :global(.premium-marker .marker-pin) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -100%);
    animation: marker-bounce 2s ease-in-out infinite;
  }

  :global(.premium-marker .marker-pulse) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: pulse-expand 2s ease-out infinite;
  }

  :global(.premium-marker .marker-ring) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: ring-rotate 8s linear infinite;
  }

  @keyframes marker-bounce {
    0%, 100% { transform: translate(-50%, -100%); }
    50% { transform: translate(-50%, -110%); }
  }

  @keyframes pulse-expand {
    0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0.8; }
    100% { transform: translate(-50%, -50%) scale(2.5); opacity: 0; }
  }

  @keyframes ring-rotate {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  :global(.premium-label) {
    position: absolute;
    top: -48px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #1a1f2e 0%, #2d3548 100%);
    border: 1px solid rgba(200, 164, 90, 0.4);
    border-radius: 12px;
    padding: 10px 18px;
    color: #ffffff;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3px;
    box-shadow: 
      0 4px 20px rgba(0,0,0,0.3),
      0 0 30px rgba(200, 164, 90, 0.15),
      inset 0 1px 0 rgba(255,255,255,0.1);
    white-space: nowrap;
    z-index: 100;
    animation: label-fade-in 0.4s ease-out;
  }

  :global(.premium-label::after) {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid rgba(200, 164, 90, 0.4);
  }

  :global(.premium-label::before) {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid #1a1f2e;
  }

  @keyframes label-fade-in {
    from { opacity: 0; transform: translateX(-50%) translateY(10px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  :global(.area-effect) {
    animation: area-pulse 2.5s ease-in-out infinite;
  }

  @keyframes area-pulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.1); }
  }
</style>

<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>

<script is:inline>
  function initMapLibreMaps() {
    if (typeof maplibregl === 'undefined') {
      setTimeout(initMapLibreMaps, 200);
      return;
    }

    const maps = document.querySelectorAll('.maplibre-map');
    
    maps.forEach((mapContainer) => {
      const element = mapContainer;
      if (element.querySelector('.maplibregl-canvas')) return;

      const center = JSON.parse(element.dataset.center || '[0, 0]');
      const zoom = parseFloat(element.dataset.zoom || '13');
      const pitch = parseFloat(element.dataset.pitch || '25');
      const bearing = parseFloat(element.dataset.bearing || '-15');
      const label = element.dataset.label || '';

      const map = new maplibregl.Map({
        container: element,
        style: {
          version: 8,
          name: 'Carto Light Premium',
          sources: {
            'carto-light': {
              type: 'raster',
              tiles: [
                'https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png',
                'https://b.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png',
                'https://c.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png',
                'https://d.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png'
              ],
              tileSize: 256
            }
          },
          layers: [{
            id: 'carto-light-layer',
            type: 'raster',
            source: 'carto-light',
            minzoom: 0,
            maxzoom: 19,
            paint: {
              'raster-saturation': -0.1,
              'raster-brightness-min': 0.4,
              'raster-brightness-max': 1
            }
          }]
        },
        center: center,
        zoom: zoom,
        pitch: pitch,
        bearing: bearing,
        interactive: true,
        attributionControl: false
      });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');

      map.on('load', () => {
        map.addSource('area-point', {
          type: 'geojson',
          data: {
            type: 'FeatureCollection',
            features: [{
              type: 'Feature',
              geometry: { type: 'Point', coordinates: center },
              properties: { label: label }
            }]
          }
        });

        map.addLayer({
          id: 'area-outer-glow',
          type: 'circle',
          source: 'area-point',
          paint: {
            'circle-radius': [15, 30, 50, 80],
            'circle-color': 'rgba(200, 164, 90, 0.08)',
            'circle-opacity': [0.4, 0.2, 0.1, 0],
            'circle-blur': 0.5
          }
        });

        map.addLayer({
          id: 'area-middle-ring',
          type: 'circle',
          source: 'area-point',
          paint: {
            'circle-radius': 25,
            'circle-color': 'rgba(200, 164, 90, 0.15)',
            'circle-blur': 0.3
          }
        });

        map.addLayer({
          id: 'area-inner-glow',
          type: 'circle',
          source: 'area-point',
          paint: {
            'circle-radius': 18,
            'circle-color': 'rgba(200, 164, 90, 0.25)'
          }
        });

        const markerEl = document.createElement('div');
        markerEl.className = 'premium-marker';
        markerEl.innerHTML = `
          <svg class="marker-pulse" width="60" height="60" viewBox="0 0 60 60">
            <circle cx="30" cy="30" r="25" fill="rgba(200, 164, 90, 0.2)"/>
            <circle cx="30" cy="30" r="18" fill="rgba(200, 164, 90, 0.3)"/>
          </svg>
          <svg class="marker-ring" width="60" height="60" viewBox="0 0 60 60">
            <circle cx="30" cy="30" r="28" fill="none" stroke="rgba(200, 164, 90, 0.3)" stroke-width="1" stroke-dasharray="4 4"/>
            <circle cx="30" cy="30" r="22" fill="none" stroke="rgba(200, 164, 90, 0.2)" stroke-width="0.5" stroke-dasharray="2 6"/>
          </svg>
          <svg class="marker-pin" width="40" height="52" viewBox="0 0 40 52">
            <defs>
              <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
                <feMerge>
                  <feMergeNode in="coloredBlur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
              <linearGradient id="pin-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#e4c97a"/>
                <stop offset="50%" stop-color="#c8a45a"/>
                <stop offset="100%" stop-color="#a07d2e"/>
              </linearGradient>
            </defs>
            <path d="M20 0 C8.954 0 0 8.954 0 20 C0 35.25 20 52 20 52 C20 52 40 35.25 40 20 C40 8.954 31.046 0 20 0Z" fill="url(#pin-gradient)" filter="url(#glow)"/>
            <circle cx="20" cy="18" r="10" fill="#ffffff"/>
            <circle cx="20" cy="18" r="6" fill="#c8a45a"/>
            <circle cx="17" cy="15" r="2" fill="rgba(255,255,255,0.6)"/>
          </svg>
          ${label ? `<div class="premium-label">${label}</div>` : ''}
        `;

        new maplibregl.Marker({ element: markerEl, anchor: 'bottom' })
          .setLngLat(center)
          .addTo(map);

        const compassEl = document.querySelector('.maplibregl-ctrl-compass');
        if (compassEl) compassEl.style.display = 'none';
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => setTimeout(initMapLibreMaps, 150));
  } else {
    setTimeout(initMapLibreMaps, 150);
  }
</script>