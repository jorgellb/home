---
interface Props {
  center: [number, number];
  zoom?: number;
  pitch?: number;
  bearing?: number;
  height?: string;
  label?: string;
  themeColor?: string;
  themeColorDark?: string;
  townInitial?: string;
  puntosInteres?: Array<{
    nombre: string;
    coords: [number, number];
    tipo?: string;
  }>;
}

const {
  center,
  zoom = 13,
  pitch = 25,
  bearing = -15,
  height = "520px",
  label,
  themeColor = '#0E0D0B',
  themeColorDark = '#0E0D0B',
  townInitial,
  puntosInteres = [],
} = Astro.props;

const mapId = `map-${Math.random().toString(36).substring(7)}`;
const initial = (townInitial || label || 'A').charAt(0).toUpperCase();

// Format coordinates for display
const lat = center[1].toFixed(4);
const lng = center[0].toFixed(4);
const latStr = `${Math.abs(parseFloat(lat))}° ${center[1] >= 0 ? 'N' : 'S'}`;
const lngStr = `${Math.abs(parseFloat(lng))}° ${center[0] >= 0 ? 'E' : 'W'}`;
---

<div
  class="iMap"
  style={`--iMap-theme: ${themeColor}; --iMap-theme-d: ${themeColorDark};`}
>
  {/* ── Cabecera con coordenadas tipo carta cartográfica ── */}
  <header class="iMap__head">
    <span class="iMap__head-stamp">★ CARTA · {label ? label.toUpperCase() : 'MAPA'} ★</span>
    <span class="iMap__head-coords">
      <span class="iMap__coord-pill">LAT {latStr}</span>
      <span class="iMap__coord-pill">LNG {lngStr}</span>
    </span>
  </header>

  {/* ── Contenedor con el mapa + overlays ── */}
  <div class="iMap__body">

    {/* Mapa */}
    <div
      id={mapId}
      class="iMap__canvas"
      style={`height: ${height};`}
      data-center={JSON.stringify(center)}
      data-zoom={zoom}
      data-pitch={pitch}
      data-bearing={bearing}
      data-label={label || ''}
      data-initial={initial}
      data-theme={themeColor}
      data-theme-d={themeColorDark}
      data-puntos={JSON.stringify(puntosInteres)}
    ></div>

    {/* Esquinas con marcas de registro (estilo plano técnico) */}
    <div class="iMap__corner iMap__corner--tl" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="100%" height="100%">
        <path d="M 4 12 L 4 4 L 12 4" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="4" cy="4" r="2" fill="currentColor"/>
      </svg>
    </div>
    <div class="iMap__corner iMap__corner--tr" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="100%" height="100%">
        <path d="M 28 4 L 36 4 L 36 12" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="36" cy="4" r="2" fill="currentColor"/>
      </svg>
    </div>
    <div class="iMap__corner iMap__corner--bl" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="100%" height="100%">
        <path d="M 4 28 L 4 36 L 12 36" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="4" cy="36" r="2" fill="currentColor"/>
      </svg>
    </div>
    <div class="iMap__corner iMap__corner--br" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="100%" height="100%">
        <path d="M 28 36 L 36 36 L 36 28" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="36" cy="36" r="2" fill="currentColor"/>
      </svg>
    </div>

    {/* Compass rose flotante top-right */}
    <div class="iMap__compass" aria-hidden="true">
      <svg viewBox="0 0 100 100" width="100%" height="100%">
        {/* Ring exterior */}
        <circle cx="50" cy="50" r="46" fill="rgba(255,252,246,0.92)" stroke="#0E0D0B" stroke-width="2.5"/>
        <circle cx="50" cy="50" r="42" fill="none" stroke="#0E0D0B" stroke-width="1" stroke-dasharray="2 2" opacity="0.5"/>

        {/* Marcas cardinales largas + secundarias */}
        <g class="iMap-compass-ticks" stroke="#0E0D0B">
          {Array.from({length: 36}).map((_, i) => (
            <line
              x1="50"
              y1={i % 9 === 0 ? "8" : (i % 3 === 0 ? "12" : "14")}
              x2="50"
              y2={i % 9 === 0 ? "16" : (i % 3 === 0 ? "16" : "16")}
              stroke-width={i % 9 === 0 ? "2.5" : (i % 3 === 0 ? "1.5" : "0.8")}
              transform={`rotate(${i*10} 50 50)`}
            />
          ))}
        </g>

        {/* Letras cardinales */}
        <text x="50" y="26" text-anchor="middle" font-family="monospace" font-size="11" font-weight="800" fill="currentColor">N</text>
        <text x="74" y="54" text-anchor="middle" font-family="monospace" font-size="8" font-weight="700" fill="#0E0D0B" opacity="0.65">E</text>
        <text x="50" y="82" text-anchor="middle" font-family="monospace" font-size="8" font-weight="700" fill="#0E0D0B" opacity="0.65">S</text>
        <text x="26" y="54" text-anchor="middle" font-family="monospace" font-size="8" font-weight="700" fill="#0E0D0B" opacity="0.65">O</text>

        {/* Aguja brújula */}
        <g class="iMap-compass-needle">
          {/* Punta N (theme color) */}
          <path d="M 50 50 L 46 50 L 50 18 L 54 50 Z" fill="currentColor" stroke="#0E0D0B" stroke-width="1"/>
          {/* Punta S (ink) */}
          <path d="M 50 50 L 46 50 L 50 82 L 54 50 Z" fill="#0E0D0B"/>
          {/* Punto central */}
          <circle cx="50" cy="50" r="3.5" fill="#0E0D0B"/>
          <circle cx="50" cy="50" r="1.5" fill="#FFFCF6"/>
        </g>
      </svg>
    </div>

    {/* Scale bar bottom-left */}
    <div class="iMap__scale" aria-hidden="true">
      <span class="iMap__scale-bar">
        <span class="iMap__scale-fill"></span>
        <span class="iMap__scale-tick iMap__scale-tick--0">0</span>
        <span class="iMap__scale-tick iMap__scale-tick--mid">·</span>
        <span class="iMap__scale-tick iMap__scale-tick--end">1km</span>
      </span>
      <span class="iMap__scale-meta">ESCALA · APROX</span>
    </div>

    {/* Grid sutil overlay */}
    <div class="iMap__grid" aria-hidden="true"></div>

    {/* Vignette */}
    <div class="iMap__vignette" aria-hidden="true"></div>
  </div>

  {/* ── Pie con metadata cartográfica ── */}
  <footer class="iMap__foot">
    <span class="iMap__foot-meta">★ PROYECCIÓN WEB MERCATOR · OSM · CARTO</span>
    <span class="iMap__foot-meta">PLATANITO RICO · CARTOGRAFÍA · 2026</span>
  </footer>
</div>

<link rel="stylesheet" href="/vendor/maplibre-gl/maplibre-gl.css" />

<style>
  /* ══════════════════════════════════════════════════════════
     INTERACTIVE MAP — Brutalist cartographic system
     ══════════════════════════════════════════════════════════ */
  .iMap {
    --iMap-paper: #FFFCF6;
    --iMap-ink: #0E0D0B;
    color: var(--iMap-theme);
    background: var(--iMap-ink);
    border: 3px solid var(--iMap-ink);
    box-shadow: 10px 10px 0 var(--iMap-theme);
    margin: 0;
    overflow: hidden;
    font-family: var(--font-mono, monospace);
    transition: transform .3s, box-shadow .3s;
  }
  .iMap:hover {
    transform: translate(-2px, -2px);
    box-shadow: 14px 14px 0 var(--iMap-theme);
  }

  /* ── CABECERA ── */
  .iMap__head {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap;
    gap: .75rem;
    padding: .8rem 1.25rem;
    background: var(--iMap-ink);
    color: var(--iMap-paper);
    border-bottom: 2px solid var(--iMap-theme);
  }
  .iMap__head-stamp {
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .25em;
    color: var(--iMap-theme);
  }
  .iMap__head-coords {
    display: inline-flex; gap: .5rem;
  }
  .iMap__coord-pill {
    background: var(--iMap-theme);
    color: var(--iMap-paper);
    padding: .25rem .55rem;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .15em;
    border: 1.5px solid var(--iMap-paper);
  }

  /* ── BODY (mapa + overlays) ── */
  .iMap__body {
    position: relative;
    background: #f0ece4;
    overflow: hidden;
  }
  .iMap__canvas {
    width: 100%;
    display: block;
    filter: contrast(1.05) saturate(1.05);
  }

  /* Esquinas cartográficas */
  .iMap__corner {
    position: absolute;
    width: 40px; height: 40px;
    color: var(--iMap-theme);
    z-index: 8;
    pointer-events: none;
    filter: drop-shadow(0 2px 6px rgba(14,13,11,0.45));
  }
  .iMap__corner--tl { top: 10px; left: 10px; }
  .iMap__corner--tr { top: 10px; right: 10px; }
  .iMap__corner--bl { bottom: 10px; left: 10px; }
  .iMap__corner--br { bottom: 10px; right: 10px; }

  /* Compass rose */
  .iMap__compass {
    position: absolute;
    top: 14px; right: 14px;
    width: 80px; height: 80px;
    z-index: 9;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.25));
  }
  .iMap__compass svg { display: block; width: 100%; height: 100%; color: var(--iMap-theme); }
  .iMap-compass-needle {
    transform-origin: 50px 50px;
    animation: iMap-needle-wobble 6s ease-in-out infinite;
  }
  @keyframes iMap-needle-wobble {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-3deg); }
    50% { transform: rotate(2deg); }
    75% { transform: rotate(-1deg); }
  }
  .iMap-compass-ticks {
    transform-origin: 50px 50px;
    animation: iMap-ticks-pulse 5s ease-in-out infinite;
  }
  @keyframes iMap-ticks-pulse {
    0%, 100% { opacity: 0.8; }
    50%       { opacity: 1; }
  }
  @media (max-width: 640px) {
    .iMap__compass { width: 60px; height: 60px; top: 10px; right: 10px; }
  }

  /* Scale bar */
  .iMap__scale {
    position: absolute;
    bottom: 14px; left: 14px;
    z-index: 9;
    pointer-events: none;
    background: rgba(255,252,246,0.92);
    border: 2px solid var(--iMap-ink);
    padding: .4rem .55rem .35rem;
    box-shadow: 3px 3px 0 var(--iMap-theme);
    display: flex; flex-direction: column; gap: 2px;
  }
  .iMap__scale-bar {
    position: relative;
    width: 90px; height: 12px;
    background: var(--iMap-ink);
    border: 1.5px solid var(--iMap-ink);
    display: block;
  }
  .iMap__scale-fill {
    position: absolute; top: 0; left: 0; bottom: 0;
    width: 50%;
    background: var(--iMap-theme);
  }
  .iMap__scale-tick {
    position: absolute;
    top: 100%;
    margin-top: 2px;
    font-size: .55rem;
    font-weight: 800;
    color: var(--iMap-ink);
    letter-spacing: .1em;
  }
  .iMap__scale-tick--0 { left: 0; }
  .iMap__scale-tick--mid { left: 50%; transform: translateX(-50%); }
  .iMap__scale-tick--end { right: 0; }
  .iMap__scale-meta {
    margin-top: 14px;
    font-size: .5rem;
    font-weight: 800;
    letter-spacing: .2em;
    color: var(--iMap-theme-d);
  }

  /* Grid sutil */
  .iMap__grid {
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 3;
    background-image:
      linear-gradient(rgba(14,13,11,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(14,13,11,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    mix-blend-mode: multiply;
  }

  /* Vignette */
  .iMap__vignette {
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(14,13,11,0.18) 100%);
  }

  /* ── PIE ── */
  .iMap__foot {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap;
    gap: .5rem;
    padding: .55rem 1.25rem;
    background: var(--iMap-theme);
    color: var(--iMap-paper);
    border-top: 2px solid var(--iMap-ink);
  }
  .iMap__foot-meta {
    font-size: .55rem;
    font-weight: 800;
    letter-spacing: .2em;
  }

  /* ══════════════════════════════════════════════════════════
     MAPLIBRE CONTROLS
     ══════════════════════════════════════════════════════════ */
  :global(.maplibregl-ctrl-group) {
    background: rgba(255,252,246,0.95) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    border: 2px solid var(--iMap-ink, #0E0D0B) !important;
    border-radius: 0 !important;
    box-shadow: 3px 3px 0 var(--iMap-theme, #0E0D0B) !important;
    margin: 14px !important;
    overflow: hidden;
  }
  :global(.maplibregl-ctrl-group button) {
    width: 34px !important;
    height: 34px !important;
    border-radius: 0 !important;
  }
  :global(.maplibregl-ctrl-group button + button) {
    border-top: 1.5px solid var(--iMap-ink, #0E0D0B) !important;
  }
  :global(.maplibregl-ctrl-group button:hover) {
    background: var(--iMap-theme, #0E0D0B) !important;
  }
  :global(.maplibregl-ctrl-group button:hover .maplibregl-ctrl-icon) {
    filter: invert(1);
  }

  /* ══════════════════════════════════════════════════════════
     CUSTOM MARKER — Brutalist
     ══════════════════════════════════════════════════════════ */
  :global(.iMap-marker) {
    position: relative;
    width: 64px; height: 80px;
    display: flex; align-items: flex-end; justify-content: center;
    cursor: pointer;
  }

  /* Resplandor temático en el suelo bajo el pin */
  :global(.iMap-marker__glow) {
    position: absolute;
    bottom: 1px; left: 50%;
    width: 74px; height: 22px;
    transform: translateX(-50%);
    opacity: .55;
    filter: blur(3px);
    pointer-events: none;
    z-index: 0;
    animation: iMap-marker-glow 3s ease-in-out infinite;
  }
  @keyframes iMap-marker-glow {
    0%, 100% { opacity: .35; transform: translateX(-50%) scale(.9); }
    50%       { opacity: .6;  transform: translateX(-50%) scale(1.05); }
  }

  :global(.iMap-marker__pin) {
    z-index: 2;
    position: relative;
    width: 54px; height: 70px;
    filter: drop-shadow(0 6px 14px rgba(14,13,11,0.45));
    animation: iMap-marker-float 3s ease-in-out infinite;
  }
  @keyframes iMap-marker-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  :global(.iMap-marker__rings) {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 90px; height: 90px;
    pointer-events: none;
  }

  :global(.iMap-marker__ring) {
    position: absolute;
    top: 50%; left: 50%;
    width: 60px; height: 60px;
    border: 2px solid;
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0.6);
    opacity: 0;
    animation: iMap-marker-ring 3s ease-out infinite;
  }
  :global(.iMap-marker__ring--2) { animation-delay: 1s; }
  :global(.iMap-marker__ring--3) { animation-delay: 2s; }

  @keyframes iMap-marker-ring {
    0%   { transform: translate(-50%, -50%) scale(0.4); opacity: 0.85; }
    100% { transform: translate(-50%, -50%) scale(1.4); opacity: 0; }
  }

  :global(.iMap-marker__label) {
    position: absolute;
    top: -38px;
    left: 50%;
    transform: translateX(-50%);
    background: #0E0D0B;
    color: #FFFCF6;
    padding: .5rem 1rem;
    border: 2px solid;
    box-shadow: 3px 3px 0 currentColor;
    font-family: monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .2em;
    text-transform: uppercase;
    white-space: nowrap;
    z-index: 100;
    animation: iMap-marker-label-in .6s cubic-bezier(.16,1,.3,1) both;
  }
  :global(.iMap-marker__label::after) {
    content: '';
    position: absolute;
    bottom: -8px; left: 50%;
    transform: translateX(-50%);
    width: 0; height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 8px solid currentColor;
  }
  @keyframes iMap-marker-label-in {
    from { opacity: 0; transform: translateX(-50%) translateY(8px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }
</style>

<script src="/vendor/maplibre-gl/maplibre-gl.js" is:inline></script>

<script is:inline>
(function() {
  /* ═══ Guard global: si este IIFE ya corrió, no re-registrar listeners ═══ */
  if (window.__iMapScriptLoaded) return;
  window.__iMapScriptLoaded = true;

  /* Polígono de círculo geodésico para el anillo de cobertura */
  function iMapCircle(center, radiusKm, points) {
    var coords = [];
    var latRad = center[1] * Math.PI / 180;
    var dLat = radiusKm / 110.574;
    var dLng = radiusKm / (111.320 * Math.cos(latRad));
    for (var i = 0; i <= points; i++) {
      var a = (i / points) * 2 * Math.PI;
      coords.push([center[0] + dLng * Math.cos(a), center[1] + dLat * Math.sin(a)]);
    }
    return { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [coords] } };
  }

  /* Crea el marcador SVG brutal */
  function buildMarkerElement(theme, themeD, label, initial, containerId) {
    var el = document.createElement('div');
    el.className = 'iMap-marker';
    el.innerHTML = ''
      + '<div class="iMap-marker__glow" style="background:radial-gradient(ellipse at center,' + theme + ' 0%,transparent 70%)"></div>'
      + '<div class="iMap-marker__rings">'
      +   '<div class="iMap-marker__ring iMap-marker__ring--1" style="border-color:' + theme + '"></div>'
      +   '<div class="iMap-marker__ring iMap-marker__ring--2" style="border-color:' + theme + '"></div>'
      +   '<div class="iMap-marker__ring iMap-marker__ring--3" style="border-color:' + theme + '"></div>'
      + '</div>'
      + (label ? '<div class="iMap-marker__label" style="color:' + theme + '">★ ' + label.toUpperCase() + ' ★</div>' : '')
      + '<svg class="iMap-marker__pin" viewBox="0 0 54 70" fill="none" xmlns="http://www.w3.org/2000/svg">'
      +   '<defs>'
      +     '<linearGradient id="iMap-grad-' + containerId + '" x1="0" y1="0" x2="0" y2="70" gradientUnits="userSpaceOnUse">'
      +       '<stop offset="0%" stop-color="' + theme + '"/>'
      +       '<stop offset="100%" stop-color="' + themeD + '"/>'
      +     '</linearGradient>'
      +   '</defs>'
      +   '<path d="M27 4 C13 4 4 14 4 26 C 4 44 27 64 27 64 C 27 64 50 44 50 26 C 50 14 41 4 27 4 Z" fill="#0E0D0B" transform="translate(3 3)"/>'
      +   '<path d="M27 4 C13 4 4 14 4 26 C 4 44 27 64 27 64 C 27 64 50 44 50 26 C 50 14 41 4 27 4 Z" fill="url(#iMap-grad-' + containerId + ')" stroke="#0E0D0B" stroke-width="3"/>'
      +   '<circle cx="27" cy="26" r="13" fill="#FFFCF6" stroke="#0E0D0B" stroke-width="2.5"/>'
      +   '<text x="27" y="32" text-anchor="middle" font-family="\'Bricolage Grotesque\', serif" font-size="16" font-weight="800" fill="#0E0D0B">' + initial + '</text>'
      +   '<text x="27" y="48" text-anchor="middle" font-family="monospace" font-size="6" fill="#FFFCF6" letter-spacing="1.5">★ ★ ★</text>'
      + '</svg>';
    return el;
  }

  /* Limpia TODOS los marcadores maplibre del contenedor (nuclear cleanup) */
  function purgeMarkers(container) {
    /* 1. Quitar marcador almacenado en la propiedad */
    if (container._iMapMarker) {
      try { container._iMapMarker.remove(); } catch(e) {}
      container._iMapMarker = null;
    }
    /* 2. Quitar cualquier elemento .iMap-marker huérfano del DOM del mapa */
    var orphans = container.querySelectorAll('.maplibregl-marker, .iMap-marker');
    for (var i = 0; i < orphans.length; i++) {
      try { orphans[i].remove(); } catch(e) {}
    }
  }

  /* ═══ Init principal ═══ */
  function initIMaps() {
    if (typeof maplibregl === 'undefined') {
      setTimeout(initIMaps, 200);
      return;
    }

    document.querySelectorAll('.iMap__canvas').forEach(function(container) {
      /* Guard por contenedor: un solo mapa por elemento, siempre */
      if (container._iMapInstance) return;

      var center  = JSON.parse(container.dataset.center  || '[0,0]');
      var zoom    = parseFloat(container.dataset.zoom    || '13');
      var pitch   = parseFloat(container.dataset.pitch   || '25');
      var bearing = parseFloat(container.dataset.bearing || '-15');
      var label   = container.dataset.label || '';
      var initial = container.dataset.initial || 'A';
      var theme   = container.dataset.theme || '#0E0D0B';
      var themeD  = container.dataset.themeD || theme;

      var map = new maplibregl.Map({
        container: container,
        style: {
          version: 8,
          glyphs: 'https://fonts.openmaptiles.org/{fontstack}/{range}.pbf',
          sources: {
            carto: {
              type: 'raster',
              tiles: [
                'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
                'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
                'https://c.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png'
              ],
              tileSize: 256,
              attribution: '© CartoDB © OSM'
            }
          },
          layers: [{
            id: 'base',
            type: 'raster',
            source: 'carto',
            paint: { 'raster-opacity': 1 }
          }]
        },
        /* Arranca un poco más lejos y plano para el intro cinematográfico */
        center: center,
        zoom: Math.max(zoom - 1.8, 4),
        pitch: pitch * 0.35,
        bearing: bearing * 0.4,
        attributionControl: false,
        logoPosition: 'bottom-right',
        maxZoom: 17,
        minZoom: 8
      });

      /* Guardar instancia en el contenedor → guard definitivo */
      container._iMapInstance = map;

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-left');

      /* ── map.once: se dispara UNA sola vez, imposible duplicar ── */
      map.once('load', function() {
        /* Anillo de cobertura temático */
        try {
          map.addSource('iMap-ring', { type: 'geojson', data: iMapCircle(center, 1.6, 96) });
          map.addLayer({
            id: 'iMap-ring-fill', type: 'fill', source: 'iMap-ring',
            paint: { 'fill-color': theme, 'fill-opacity': 0.07 }
          });
          map.addLayer({
            id: 'iMap-ring-line', type: 'line', source: 'iMap-ring',
            paint: { 'line-color': theme, 'line-width': 2, 'line-dasharray': [2, 2], 'line-opacity': 0.6 }
          });
        } catch (e) {}

        /* Nuclear cleanup antes de crear el pin → 0 posibilidad de duplicado */
        purgeMarkers(container);

        var el = buildMarkerElement(theme, themeD, label, initial, container.id);

        var marker = new maplibregl.Marker({ element: el, anchor: 'bottom' })
          .setLngLat(center)
          .addTo(map);
        container._iMapMarker = marker;

        /* Intro cinematográfico: vuela suave hasta el encuadre final */
        map.easeTo({
          center: center, zoom: zoom, pitch: pitch, bearing: bearing,
          duration: 2400,
          easing: function(t) { return 1 - Math.pow(1 - t, 3); }
        });

        /* Resize tras render */
        setTimeout(function() { map.resize(); }, 500);
      });
    });
  }

  /* ═══ Único punto de entrada con deduplicación ═══ */
  var _initScheduled = false;
  function scheduleInit() {
    if (_initScheduled) return;
    _initScheduled = true;
    /* Micro-delay para que el DOM esté estable */
    setTimeout(function() {
      _initScheduled = false;
      initIMaps();
    }, 0);
  }

  document.addEventListener('astro:page-load', scheduleInit);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit);
  } else {
    scheduleInit();
  }
})();
</script>
