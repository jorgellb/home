---
interface Props {
  center: [number, number];
  zoom?: number;
  pitch?: number;
  bearing?: number;
  height?: string;
}

const { center, zoom = 13, pitch = 25, bearing = -15, height = "420px" } = Astro.props;
const mapId = `map-${Math.random().toString(36).substring(7)}`;
---

<section class="map-section">
  <div 
    id={mapId} 
    class="maplibre-map rounded-3xl overflow-hidden"
    style={`height: ${height};`}
    data-center={JSON.stringify(center)}
    data-zoom={zoom}
    data-pitch={pitch}
    data-bearing={bearing}
  ></div>
</section>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

<style>
  .map-section {
    --map-bg: #0a1628;
    --map-border: rgba(200, 164, 90, 0.15);
    --map-primary: #c8a45a;
  }

  .maplibre-map {
    width: 100%;
    background: var(--map-bg);
    border: 1px solid var(--map-border);
  }

  :global(.maplibregl-ctrl-group) {
    background: #0a1628 !important;
    border: 1px solid rgba(200, 164, 90, 0.15) !important;
  }

  :global(.maplibregl-ctrl-group button) {
    background: #0a1628 !important;
  }

  :global(.maplibregl-ctrl-icon) {
    filter: invert(1) brightness(0.7);
  }
</style>

<script is:inline>
  function initMapLibreMaps() {
    if (typeof maplibregl === 'undefined') return;

    const maps = document.querySelectorAll('.maplibre-map');
    
    maps.forEach((mapContainer) => {
      const element = mapContainer;
      if (element.querySelector('.maplibregl-map')) return;

      const center = JSON.parse(element.dataset.center || '[0, 0]');
      const zoom = parseFloat(element.dataset.zoom || '13');
      const pitch = parseFloat(element.dataset.pitch || '25');
      const bearing = parseFloat(element.dataset.bearing || '-15');

      const map = new maplibregl.Map({
        container: element,
        style: {
          version: 8,
          sources: {
            'carto-dark': {
              type: 'raster',
              tiles: [
                'https://a.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png',
                'https://b.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png',
                'https://c.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png',
                'https://d.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png'
              ],
              tileSize: 256,
              attribution: '&copy; CARTO'
            }
          },
          layers: [{
            id: 'carto-dark-layer',
            type: 'raster',
            source: 'carto-dark',
            minzoom: 0,
            maxzoom: 19
          }]
        },
        center: center,
        zoom: zoom,
        pitch: pitch,
        bearing: bearing,
        interactive: true,
        attributionControl: false
      });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(initMapLibreMaps, 100);
    });
  } else {
    setTimeout(initMapLibreMaps, 100);
  }
</script>

<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>