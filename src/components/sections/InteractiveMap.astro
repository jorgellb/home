---
interface Props {
  center: [number, number];
  zoom?: number;
  pitch?: number;
  bearing?: number;
  height?: string;
  label?: string;
  puntosInteres?: Array<{
    nombre: string;
    coords: [number, number];
    tipo?: string;
  }>;
}

const { center, zoom = 13, pitch = 25, bearing = -15, height = "420px", label, puntosInteres = [] } = Astro.props;
const mapId = `map-${Math.random().toString(36).substring(7)}`;
---

<section class="map-premium-section">
  <div class="map-inner-container">
    <div 
      id={mapId} 
      class="maplibre-map"
      style={`height: ${height};`}
      data-center={JSON.stringify(center)}
      data-zoom={zoom}
      data-pitch={pitch}
      data-bearing={bearing}
      data-label={label || ''}
      data-puntos={JSON.stringify(puntosInteres)}
    ></div>
    
    <div class="map-vignette"></div>
  </div>
  
  <div class="map-frame-accent">
  <!-- Capa de Ornamentos "High-End" -->
  <div class="map-frame-accent">
    <!-- Corner TL -->
    <div class="corner-ornament tl">
      <svg viewBox="0 0 100 100" class="ornament-svg">
        <path class="ornament-base" d="M 10 90 L 10 20 Q 10 10 20 10 L 90 10" />
        <path class="ornament-accent" d="M 2 80 L 2 15 Q 2 2 15 2 L 80 2" />
        <circle class="ornament-gem" cx="6" cy="6" r="3" />
        <path class="ornament-shine" d="M 0 40 L 0 10 Q 0 0 10 0 L 40 0" />
      </svg>
    </div>
    <!-- Corner TR -->
    <div class="corner-ornament tr">
      <svg viewBox="0 0 100 100" class="ornament-svg">
        <path class="ornament-base" d="M 10 90 L 10 20 Q 10 10 20 10 L 90 10" />
        <path class="ornament-accent" d="M 2 80 L 2 15 Q 2 2 15 2 L 80 2" />
        <circle class="ornament-gem" cx="6" cy="6" r="3" />
        <path class="ornament-shine" d="M 0 40 L 0 10 Q 0 0 10 0 L 40 0" />
      </svg>
    </div>
    <!-- Corner BL -->
    <div class="corner-ornament bl">
      <svg viewBox="0 0 100 100" class="ornament-svg">
        <path class="ornament-base" d="M 10 90 L 10 20 Q 10 10 20 10 L 90 10" />
        <path class="ornament-accent" d="M 2 80 L 2 15 Q 2 2 15 2 L 80 2" />
        <circle class="ornament-gem" cx="6" cy="6" r="3" />
        <path class="ornament-shine" d="M 0 40 L 0 10 Q 0 0 10 0 L 40 0" />
      </svg>
    </div>
    <!-- Corner BR -->
    <div class="corner-ornament br">
      <svg viewBox="0 0 100 100" class="ornament-svg">
        <path class="ornament-base" d="M 10 90 L 10 20 Q 10 10 20 10 L 90 10" />
        <path class="ornament-accent" d="M 2 80 L 2 15 Q 2 2 15 2 L 80 2" />
        <circle class="ornament-gem" cx="6" cy="6" r="3" />
        <path class="ornament-shine" d="M 0 40 L 0 10 Q 0 0 10 0 L 40 0" />
      </svg>
    </div>
  </div>
  
  <div class="map-magic-particles">
    {Array.from({ length: 20 }).map((_, i) => {
      const size = 1 + Math.random() * 3;
      const x = Math.random() * 100;
      const y = Math.random() * 100;
      const duration = 5 + Math.random() * 7;
      const delay = Math.random() * 10;
      return (
        <div 
          class="magic-sparkle" 
          style={`--x: ${x}%; --y: ${y}%; --size: ${size}px; --duration: ${duration}s; --delay: -${delay}s;`}
        ></div>
      );
    })}
  </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

<style>
  .map-premium-section {
    position: relative;
    --gold-dim: rgba(184, 134, 11, 0.3);
    --gold-rich: #d4af37;
    --gold-bright: #fff3d0;
    --map-shadow: rgba(20, 20, 30, 0.15);
    padding: 24px;
    margin: 4rem 0;
  }

  .map-inner-container {
    position: relative;
    border-radius: 48px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 
      0 0 0 1px rgba(0,0,0,0.05),
      0 40px 90px -20px var(--map-shadow),
      0 0 120px rgba(184, 134, 11, 0.05);
    z-index: 10;
  }

  .maplibre-map {
    width: 100%;
    border-radius: 48px;
    filter: brightness(1.02) contrast(1.05);
  }

  .map-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 150px rgba(0, 0, 0, 0.08);
    background: radial-gradient(circle at center, transparent 30%, rgba(184, 134, 11, 0.02) 100%);
    z-index: 2;
  }

  .map-frame-accent {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 30;
  }

  .corner-ornament {
    position: absolute;
    width: 110px;
    height: 110px;
    z-index: 40;
    pointer-events: none;
    opacity: 0.9;
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ornament-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ornament-base {
    fill: none;
    stroke: var(--gold-dim);
    stroke-width: 0.5;
  }

  .ornament-accent {
    fill: none;
    stroke: var(--gold-rich);
    stroke-width: 1.25;
    stroke-linecap: round;
    filter: drop-shadow(0 0 4px rgba(184, 134, 11, 0.3));
    stroke-dasharray: 300;
    stroke-dashoffset: 0;
  }

  .ornament-gem {
    fill: var(--gold-rich);
    filter: drop-shadow(0 0 8px var(--gold-rich));
    animation: gem-sparkle 3s ease-in-out infinite;
  }

  .ornament-shine {
    fill: none;
    stroke: var(--gold-bright);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0;
    animation: shine-sweep 6s linear infinite;
  }

  @keyframes gem-sparkle {
    0%, 100% { opacity: 0.5; r: 2.5; }
    50% { opacity: 1; r: 3.5; }
  }

  @keyframes shine-sweep {
    0% { stroke-dasharray: 0 400; opacity: 0; }
    10% { opacity: 1; }
    30% { stroke-dasharray: 100 400; stroke-dashoffset: -100; opacity: 1; }
    40% { stroke-dasharray: 0 400; stroke-dashoffset: -200; opacity: 0; }
    100% { opacity: 0; }
  }

  .corner-ornament.tl { top: -10px; left: -10px; }
  .corner-ornament.tr { top: -10px; right: -10px; transform: scaleX(-1); }
  .corner-ornament.bl { bottom: -10px; left: -10px; transform: scaleY(-1); }
  .corner-ornament.br { bottom: -10px; right: -10px; transform: scale(-1); }

  .map-premium-section:hover .corner-ornament { opacity: 1; }
  .map-premium-section:hover .corner-ornament.tl { transform: translate(-5px, -5px) scale(1.05); }
  .map-premium-section:hover .corner-ornament.tr { transform: translate(5px, -5px) scaleX(-1.05) scaleY(1.05); }
  .map-premium-section:hover .corner-ornament.bl { transform: translate(-5px, 5px) scaleX(1.05) scaleY(-1.05); }
  .map-premium-section:hover .corner-ornament.br { transform: translate(5px, 5px) scale(-1.05); }

  .map-magic-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 5;
  }

  .magic-sparkle {
    position: absolute;
    width: var(--size);
    height: var(--size);
    background: white;
    border-radius: 50%;
    left: var(--x);
    top: var(--y);
    opacity: 0;
    box-shadow: 0 0 15px 4px rgba(255, 243, 208, 0.4);
    animation: floating-sparkle var(--duration) var(--delay) linear infinite;
  }

  @keyframes floating-sparkle {
    0% { transform: translateY(0) scale(0); opacity: 0; }
    20% { opacity: 0.6; }
    50% { transform: translateY(-100px) translateX(30px) scale(1.5); opacity: 0.3; }
    80% { opacity: 0.6; }
    100% { transform: translateY(-200px) translateX(60px) scale(0); opacity: 0; }
  }

  :global(.maplibregl-ctrl-group) {
    background: rgba(255, 255, 255, 0.9) !important;
    backdrop-filter: blur(8px) !important;
    border: none !important;
    border-radius: 12px !important;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1) !important;
    margin: 20px !important;
  }

  :global(.magic-marker) {
    position: relative;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.magic-label) {
    position: absolute;
    top: -75px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1.5px solid var(--gold-rich);
    border-radius: 24px;
    padding: 12px 28px;
    color: #1a1a1a;
    font-family: var(--font-space-grotesk, 'Space Grotesk'), sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 
      0 20px 40px rgba(0,0,0,0.15),
      0 0 25px rgba(212, 175, 55, 0.15);
    white-space: nowrap;
    z-index: 100;
    animation: lux-label-appear 0.8s cubic-bezier(0.2, 1, 0.3, 1);
  }

  @keyframes lux-label-appear {
    from { opacity: 0; transform: translateX(-50%) translateY(30px) scale(0.85); }
    to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
  }
</style>

<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>

<script is:inline>
  function initMapLibre() {
    if (typeof maplibregl === 'undefined') {
      setTimeout(initMapLibre, 200);
      return;
    }

    const containers = document.querySelectorAll('.maplibre-map:not(.initialized)');
    
    containers.forEach((container) => {
      container.classList.add('initialized');
      const center = JSON.parse(container.dataset.center || '[0, 0]');
      const zoom = parseFloat(container.dataset.zoom || '13');
      const pitch = parseFloat(container.dataset.pitch || '0');
      const bearing = parseFloat(container.dataset.bearing || '0');
      const label = container.dataset.label;

      const map = new maplibregl.Map({
        container: container,
        style: {
          version: 8,
          sources: {
            'voyager': {
              type: 'raster',
              tiles: [
                'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
                'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
                'https://c.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png'
              ],
              tileSize: 256
            }
          },
          layers: [{
            id: 'voyager-layer',
            type: 'raster',
            source: 'voyager',
            paint: { 'raster-opacity': 0.95 }
          }]
        },
        center: center,
        zoom: zoom,
        pitch: pitch,
        bearing: bearing,
        attributionControl: false
      });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');

      map.on('load', () => {
        // Marcador Premium
        const el = document.createElement('div');
        el.className = 'magic-marker';
        el.innerHTML = `
          <div class="magic-label">${label || 'ALMERÍA'}</div>
          <svg width="60" height="75" viewBox="0 0 60 75">
            <defs>
              <linearGradient id="pinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#fff3d0"/>
                <stop offset="100%" stop-color="#d4af37"/>
              </linearGradient>
            </defs>
            <path d="M30 0 C13.43 0 0 13.43 0 30 C0 52.5 30 75 30 75 C30 75 60 52.5 60 30 C60 13.43 46.57 0 30 0Z" fill="url(#pinGrad)"/>
            <circle cx="30" cy="30" r="12" fill="white"/>
            <circle cx="30" cy="30" r="7" fill="#d4af37"/>
          </svg>
        `;

        new maplibregl.Marker({ element: el, anchor: 'bottom' })
          .setLngLat(center)
          .addTo(map);

        setTimeout(() => map.resize(), 500);
      });
    });
  }

  document.addEventListener('astro:page-load', initMapLibre);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMapLibre);
  } else {
    initMapLibre();
  }
</script>