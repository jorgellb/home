---
interface Props {
  center: [number, number];
  zoom?: number;
  pitch?: number;
  bearing?: number;
  height?: string;
  label?: string;
  puntosInteres?: Array<{
    nombre: string;
    coords: [number, number];
    tipo?: string;
  }>;
}

const { center, zoom = 13, pitch = 25, bearing = -15, height = "460px", label, puntosInteres = [] } = Astro.props;
const mapId = `map-${Math.random().toString(36).substring(7)}`;
---

<div class="map-premium-wrapper">
  <!-- Halo exterior decorativo -->
  <div class="map-halo"></div>

  <!-- Marco con ornamentos dorados -->
  <div class="map-frame">
    <!-- Esquinas decorativas SVG -->
    <div class="corner tl" aria-hidden="true">
      <svg viewBox="0 0 80 80" fill="none">
        <path d="M4 76 L4 18 Q4 4 18 4 L76 4" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M0 60 L0 12 Q0 0 12 0 L60 0" stroke="rgba(212,175,55,0.25)" stroke-width="0.8"/>
        <circle cx="4" cy="4" r="3.5" fill="#d4af37" class="gem"/>
        <circle cx="4" cy="4" r="6" fill="rgba(212,175,55,0.15)" class="gem-halo"/>
      </svg>
    </div>
    <div class="corner tr" aria-hidden="true">
      <svg viewBox="0 0 80 80" fill="none">
        <path d="M4 76 L4 18 Q4 4 18 4 L76 4" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M0 60 L0 12 Q0 0 12 0 L60 0" stroke="rgba(212,175,55,0.25)" stroke-width="0.8"/>
        <circle cx="4" cy="4" r="3.5" fill="#d4af37" class="gem"/>
        <circle cx="4" cy="4" r="6" fill="rgba(212,175,55,0.15)" class="gem-halo"/>
      </svg>
    </div>
    <div class="corner bl" aria-hidden="true">
      <svg viewBox="0 0 80 80" fill="none">
        <path d="M4 76 L4 18 Q4 4 18 4 L76 4" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M0 60 L0 12 Q0 0 12 0 L60 0" stroke="rgba(212,175,55,0.25)" stroke-width="0.8"/>
        <circle cx="4" cy="4" r="3.5" fill="#d4af37" class="gem"/>
        <circle cx="4" cy="4" r="6" fill="rgba(212,175,55,0.15)" class="gem-halo"/>
      </svg>
    </div>
    <div class="corner br" aria-hidden="true">
      <svg viewBox="0 0 80 80" fill="none">
        <path d="M4 76 L4 18 Q4 4 18 4 L76 4" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M0 60 L0 12 Q0 0 12 0 L60 0" stroke="rgba(212,175,55,0.25)" stroke-width="0.8"/>
        <circle cx="4" cy="4" r="3.5" fill="#d4af37" class="gem"/>
        <circle cx="4" cy="4" r="6" fill="rgba(212,175,55,0.15)" class="gem-halo"/>
      </svg>
    </div>

    <!-- Mapa -->
    <div class="map-container">
      <div
        id={mapId}
        class="maplibre-map"
        style={`height: ${height};`}
        data-center={JSON.stringify(center)}
        data-zoom={zoom}
        data-pitch={pitch}
        data-bearing={bearing}
        data-label={label || ''}
        data-puntos={JSON.stringify(puntosInteres)}
      ></div>

      <!-- Viñeta interior sutil -->
      <div class="map-vignette" aria-hidden="true"></div>

      <!-- Líneas de escaneo decorativas (overlay) -->
      <div class="scan-lines" aria-hidden="true"></div>
    </div>
  </div>

  <!-- Partículas flotantes -->
  <div class="particles" aria-hidden="true">
    {Array.from({ length: 18 }).map((_, i) => (
      <div
        class="particle"
        style={`--px:${Math.round(Math.random()*100)}%;--py:${Math.round(Math.random()*100)}%;--ps:${(1.5 + Math.random()*2.5).toFixed(1)}px;--pd:${(6 + Math.random()*8).toFixed(1)}s;--pdelay:-${(Math.random()*12).toFixed(1)}s`}
      ></div>
    ))}
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

<style>
  /* ── Variables ─────────────────────────────────────────── */
  .map-premium-wrapper {
    --gold: #d4af37;
    --gold-dim: rgba(212,175,55,0.35);
    --gold-glow: rgba(212,175,55,0.12);
    --radius: 36px;

    position: relative;
    padding: 32px;
    margin: 3rem 0;
  }

  /* ── Halo exterior ─────────────────────────────────────── */
  .map-halo {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--radius) + 20px);
    background: radial-gradient(ellipse at 50% 50%, var(--gold-glow) 0%, transparent 70%);
    pointer-events: none;
    animation: halo-pulse 6s ease-in-out infinite;
  }

  @keyframes halo-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.015); }
  }

  /* ── Marco principal ───────────────────────────────────── */
  .map-frame {
    position: relative;
    border-radius: var(--radius);
    padding: 3px;
    background: linear-gradient(135deg,
      rgba(212,175,55,0.6) 0%,
      rgba(255,243,190,0.9) 25%,
      rgba(212,175,55,0.3) 50%,
      rgba(255,243,190,0.9) 75%,
      rgba(212,175,55,0.6) 100%
    );
    box-shadow:
      0 0 0 1px rgba(212,175,55,0.1),
      0 30px 80px -10px rgba(0,0,0,0.18),
      0 0 60px var(--gold-glow),
      inset 0 1px 0 rgba(255,255,255,0.5);
    animation: border-shimmer 8s linear infinite;
    background-size: 200% 200%;
  }

  @keyframes border-shimmer {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* ── Mapa inner ────────────────────────────────────────── */
  .map-container {
    position: relative;
    border-radius: calc(var(--radius) - 3px);
    overflow: hidden;
    background: #f0ece4;
  }

  .maplibre-map {
    width: 100%;
    display: block;
    filter: contrast(1.04) saturate(1.08) brightness(1.02);
  }

  .map-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      radial-gradient(ellipse at center, transparent 45%, rgba(10,10,20,0.07) 100%);
    box-shadow: inset 0 0 100px rgba(0,0,0,0.06);
  }

  /* Líneas de escaneo sutiles — efecto tech premium */
  .scan-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(0,0,0,0.008) 3px,
      rgba(0,0,0,0.008) 4px
    );
    border-radius: inherit;
  }

  /* ── Esquinas ──────────────────────────────────────────── */
  .corner {
    position: absolute;
    width: 72px;
    height: 72px;
    z-index: 20;
    pointer-events: none;
  }

  .corner svg { width: 100%; height: 100%; overflow: visible; }

  .corner.tl { top: -4px;    left: -4px; }
  .corner.tr { top: -4px;    right: -4px;  transform: scaleX(-1); }
  .corner.bl { bottom: -4px; left: -4px;   transform: scaleY(-1); }
  .corner.br { bottom: -4px; right: -4px;  transform: scale(-1); }

  .gem {
    filter: drop-shadow(0 0 5px var(--gold));
    animation: gem-pulse 3s ease-in-out infinite;
  }

  .gem-halo {
    animation: gem-pulse 3s ease-in-out infinite reverse;
  }

  @keyframes gem-pulse {
    0%, 100% { opacity: 0.5; }
    50%       { opacity: 1;   }
  }

  /* ── Partículas ────────────────────────────────────────── */
  .particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 5;
  }

  .particle {
    position: absolute;
    left: var(--px);
    top: var(--py);
    width: var(--ps);
    height: var(--ps);
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 8px 2px rgba(255,243,190,0.6);
    opacity: 0;
    animation: float-particle var(--pd) var(--pdelay) linear infinite;
  }

  @keyframes float-particle {
    0%   { opacity: 0;   transform: translateY(0)    scale(0.2); }
    15%  { opacity: 0.7; }
    60%  { opacity: 0.3; transform: translateY(-90px) translateX(20px) scale(1.2); }
    100% { opacity: 0;   transform: translateY(-180px) translateX(40px) scale(0); }
  }

  /* ── MapLibre controles ────────────────────────────────── */
  :global(.maplibregl-ctrl-group) {
    background: rgba(255,255,255,0.88) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(212,175,55,0.3) !important;
    border-radius: 14px !important;
    box-shadow: 0 8px 30px rgba(0,0,0,0.1), 0 0 0 1px rgba(255,255,255,0.6) inset !important;
    margin: 16px !important;
    overflow: hidden;
  }

  :global(.maplibregl-ctrl-group button) {
    width: 36px !important;
    height: 36px !important;
  }

  :global(.maplibregl-ctrl-group button:hover) {
    background: rgba(212,175,55,0.08) !important;
  }

  /* ── Marcador personalizado ────────────────────────────── */
  :global(.map-marker-wrap) {
    position: relative;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  :global(.map-marker-pin) {
    width: 48px;
    height: 60px;
    filter: drop-shadow(0 6px 18px rgba(212,175,55,0.55)) drop-shadow(0 2px 6px rgba(0,0,0,0.2));
    animation: marker-float 3.5s ease-in-out infinite;
  }

  @keyframes marker-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-6px); }
  }

  :global(.map-marker-pulse) {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 28px;
    height: 10px;
    background: radial-gradient(ellipse, rgba(212,175,55,0.5) 0%, transparent 70%);
    animation: pulse-shadow 3.5s ease-in-out infinite;
  }

  @keyframes pulse-shadow {
    0%, 100% { transform: translateX(-50%) scale(1);    opacity: 0.5; }
    50%       { transform: translateX(-50%) scale(0.65); opacity: 0.2; }
  }

  :global(.map-label-badge) {
    position: absolute;
    top: -62px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid var(--gold, #d4af37);
    border-radius: 20px;
    padding: 8px 20px;
    white-space: nowrap;
    color: #111;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow:
      0 12px 40px rgba(0,0,0,0.12),
      0 0 20px rgba(212,175,55,0.18);
    animation: badge-enter 0.8s cubic-bezier(0.2,1,0.3,1) both;
    z-index: 200;
  }

  :global(.map-label-badge::after) {
    content: '';
    position: absolute;
    bottom: -7px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 7px;
    background: rgba(255,255,255,0.92);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    border-left: 1.5px solid var(--gold, #d4af37);
    border-right: 1.5px solid var(--gold, #d4af37);
  }

  @keyframes badge-enter {
    from { opacity: 0; transform: translateX(-50%) translateY(20px) scale(0.88); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0)    scale(1); }
  }
</style>

<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>

<script is:inline>
  function initMaps() {
    if (typeof maplibregl === 'undefined') {
      setTimeout(initMaps, 150);
      return;
    }

    document.querySelectorAll('.maplibre-map:not(.initialized)').forEach(function(container) {
      container.classList.add('initialized');

      var center  = JSON.parse(container.dataset.center  || '[0,0]');
      var zoom    = parseFloat(container.dataset.zoom    || '13');
      var pitch   = parseFloat(container.dataset.pitch   || '25');
      var bearing = parseFloat(container.dataset.bearing || '-15');
      var label   = container.dataset.label || '';

      var map = new maplibregl.Map({
        container: container,
        style: {
          version: 8,
          glyphs: 'https://fonts.openmaptiles.org/{fontstack}/{range}.pbf',
          sources: {
            carto: {
              type: 'raster',
              tiles: [
                'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
                'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
                'https://c.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png'
              ],
              tileSize: 256,
              attribution: '© CartoDB © OSM'
            }
          },
          layers: [{
            id: 'base',
            type: 'raster',
            source: 'carto',
            paint: { 'raster-opacity': 1 }
          }]
        },
        center: center,
        zoom: zoom,
        pitch: pitch,
        bearing: bearing,
        attributionControl: false,
        logoPosition: 'bottom-left'
      });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');

      map.on('load', function() {
        /* ── Marcador premium ── */
        var el = document.createElement('div');
        el.className = 'map-marker-wrap';
        el.innerHTML = [
          label ? '<div class="map-label-badge">' + label.toUpperCase() + '</div>' : '',
          '<svg class="map-marker-pin" viewBox="0 0 48 60" fill="none" xmlns="http://www.w3.org/2000/svg">',
            '<defs>',
              '<linearGradient id="pg-' + container.id + '" x1="0" y1="0" x2="0" y2="60" gradientUnits="userSpaceOnUse">',
                '<stop offset="0%" stop-color="#fff3b0"/>',
                '<stop offset="55%" stop-color="#d4af37"/>',
                '<stop offset="100%" stop-color="#a07d15"/>',
              '</linearGradient>',
              '<radialGradient id="rg-' + container.id + '" cx="40%" cy="35%">',
                '<stop offset="0%" stop-color="rgba(255,255,255,0.6)"/>',
                '<stop offset="100%" stop-color="rgba(255,255,255,0)"/>',
              '</radialGradient>',
              '<filter id="glow-' + container.id + '">',
                '<feGaussianBlur stdDeviation="2" result="blur"/>',
                '<feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>',
              '</filter>',
            '</defs>',
            '<path d="M24 0C10.75 0 0 10.75 0 24c0 16 24 36 24 36s24-20 24-36C48 10.75 37.25 0 24 0z" fill="url(#pg-' + container.id + ')" filter="url(#glow-' + container.id + ')"/>',
            '<path d="M24 0C10.75 0 0 10.75 0 24c0 16 24 36 24 36s24-20 24-36C48 10.75 37.25 0 24 0z" fill="url(#rg-' + container.id + ')"/>',
            '<circle cx="24" cy="24" r="10" fill="white" opacity="0.95"/>',
            '<circle cx="24" cy="24" r="6"  fill="#d4af37"/>',
            '<circle cx="21" cy="21" r="2"  fill="white" opacity="0.7"/>',
          '</svg>',
          '<div class="map-marker-pulse"></div>'
        ].join('');

        new maplibregl.Marker({ element: el, anchor: 'bottom' })
          .setLngLat(center)
          .addTo(map);

        /* Redimensionar tras render */
        setTimeout(function() { map.resize(); }, 400);
      });
    });
  }

  document.addEventListener('astro:page-load', initMaps);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMaps);
  } else {
    initMaps();
  }
</script>
