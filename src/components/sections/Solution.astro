---
const services = [
  {
    id: 'web',
    n: '01',
    title: 'Desarrollo Web',
    kicker: 'Astro · Headless · Performance',
    description: 'Webs profesionales hechas a medida. Performance 99/100, SEO técnico desde la raíz y cero ataduras a plantillas.',
    features: ['Landing pages de alto impacto', 'E-commerce con pasarela', 'Web apps a medida', 'SEO técnico medible', 'Entrega en 1–2 semanas'],
    link: '/desarrollo-web/',
    figure: '99/100',
    figureLabel: 'Lighthouse',
    accent: 'accent',
  },
  {
    id: 'video',
    n: '02',
    title: 'Audiovisual',
    kicker: 'Dron 4K · Edición · Motion',
    description: 'Vídeo corporativo, reels y tomas aéreas con Mavic 3 Pro. Operadores certificados, post-producción y entrega lista para publicar.',
    features: ['Vídeo corporativo 4K', 'Reels virales', 'Motion graphics', 'Fotografía profesional', 'Pilotos certificados'],
    link: '/audiovisual/',
    figure: '4K',
    figureLabel: 'Resolución dron',
    accent: 'lime',
  },
  {
    id: 'marketing',
    n: '03',
    title: 'Marketing & SEO',
    kicker: 'Google Ads · SEO · Meta',
    description: 'Estrategias que llevan tu marca al top 3 de Google y generan leads cualificados sin quemar presupuesto.',
    features: ['Posicionamiento orgánico', 'Google Ads y Meta Ads', 'Gestión de redes', 'Email marketing', 'Reportes mensuales'],
    link: '/marketing/',
    figure: '3–6m',
    figureLabel: 'ROI estimado',
    accent: 'ink',
  },
  {
    id: 'design',
    n: '04',
    title: 'Diseño Gráfico',
    kicker: 'Branding · Editorial · Packaging',
    description: 'Identidad visual con criterio. Sistemas de marca que aguantan el paso del tiempo y se reconocen al instante.',
    features: ['Branding e identidad', 'Sistemas de marca', 'Cartelería y packaging', 'Presentaciones', 'Manual de marca'],
    link: '/diseno-grafico/',
    figure: '100%',
    figureLabel: 'Hecho a medida',
    accent: 'paper',
  },
  {
    id: 'support',
    n: '05',
    title: 'Mantenimiento',
    kicker: 'Hosting · Soporte · Updates',
    description: 'Tu web siempre rápida, segura y actualizada. Hosting premium, copias diarias y soporte real cuando lo necesitas.',
    features: ['Mantenimiento mensual', 'Hosting premium incluido', 'Copias diarias', 'Soporte rápido', 'Actualizaciones'],
    link: '/soporte/',
    figure: '99.9%',
    figureLabel: 'Uptime',
    accent: 'paper',
  },
];
---

<section class="section-brutal" id="servicios">
  <div class="container-brutal">
    <header class="brutal-section-head">
      <div class="brutal-section-head__col">
        <span class="text-meta">Cap. 02 / Servicios</span>
        <h2 class="heading-display brutal-section-head__title">
          Cinco disciplinas,
          <em class="heading-editorial">un solo estudio.</em>
        </h2>
      </div>
      <p class="brutal-section-head__lead">
        Trabajamos como un equipo integrado: diseño, código, vídeo y crecimiento.
        Sin pasarte de proveedor en proveedor, sin perder coherencia.
      </p>
    </header>

    <div class="ascii-rule">═══════════════════════════════════════════════════════════════════════════════</div>

    {/* Bento de servicios */}
    <div class="services-bento">
      {services.map((s, i) => (
        <a
          href={s.link}
          class={`service-card service-card--${s.accent} service-card--idx-${i}`}
          data-num={s.n}
        >
          <header class="service-card__head">
            <span class="service-card__num">{s.n}</span>
            <span class="service-card__kicker">{s.kicker}</span>
          </header>

          <div class="service-card__body">
            <h3 class="service-card__title heading-display">{s.title}</h3>
            <p class="service-card__desc">{s.description}</p>
          </div>

          <ul class="service-card__features">
            {s.features.map((f) => (
              <li class="service-card__feat">
                <span class="service-card__feat-mark">+</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <footer class="service-card__foot">
            <div class="service-card__figure">
              <span class="service-card__figure-val text-mono">{s.figure}</span>
              <span class="service-card__figure-lbl">{s.figureLabel}</span>
            </div>
            <span class="service-card__cta">
              Ver servicio
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </span>
          </footer>
        </a>
      ))}

      {/* Tile final — CTA */}
      <a href="/contacto/" class="service-card service-card--cta">
        <span class="service-card__num">★</span>
        <h3 class="heading-display service-card__cta-title">
          ¿No sabes
          <em class="heading-editorial">por dónde</em>
          empezar?
        </h3>
        <p class="service-card__cta-desc">
          Reserva una llamada gratis de 20 min. Te decimos qué necesitas
          (y qué no) sin presión comercial.
        </p>
        <span class="service-card__cta-btn btn-brutal btn-brutal--lime">
          Hablemos
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .brutal-section-head {
    display: grid; gap: 2rem; grid-template-columns: 1fr; margin-bottom: 3rem;
  }
  @media (min-width: 1024px) {
    .brutal-section-head { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 4rem; }
  }
  .brutal-section-head__col { display: flex; flex-direction: column; gap: 1rem; }
  .brutal-section-head__title {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: .92; letter-spacing: -.04em; margin: 0; max-width: 16ch;
  }
  .brutal-section-head__title em { font-style: italic; color: var(--brutal-accent); }
  .brutal-section-head__lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 44ch; }

  /* ── Bento ── */
  .services-bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--brutal-ink);
    background: var(--brutal-ink);
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .services-bento { grid-template-columns: repeat(6, 1fr); grid-auto-rows: minmax(360px, auto); gap: 2px; }
    .service-card--idx-0 { grid-column: span 4; }
    .service-card--idx-1 { grid-column: span 2; }
    .service-card--idx-2 { grid-column: span 3; }
    .service-card--idx-3 { grid-column: span 3; }
    .service-card--idx-4 { grid-column: span 3; }
    .service-card--cta   { grid-column: span 3; }
  }

  .service-card {
    background: var(--brutal-card);
    color: var(--brutal-ink);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: background .35s ease;
  }
  .service-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brutal-ink);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform .45s cubic-bezier(.16,1,.3,1);
    z-index: 0;
  }
  .service-card > * { position: relative; z-index: 1; }
  .service-card:hover::after { transform: scaleY(1); }
  .service-card:hover { color: var(--brutal-bg); }
  .service-card:hover .service-card__num { color: var(--brutal-lime); }
  .service-card:hover .service-card__kicker,
  .service-card:hover .service-card__desc,
  .service-card:hover .service-card__figure-lbl { color: var(--brutal-bg-alt); }
  .service-card:hover .service-card__feat { color: var(--brutal-bg-alt); }
  .service-card:hover .service-card__feat-mark { color: var(--brutal-accent); }
  .service-card:hover .service-card__title { color: var(--brutal-bg); }
  .service-card:hover .service-card__figure-val { color: var(--brutal-lime); }
  .service-card:hover .service-card__cta { color: var(--brutal-lime); }

  .service-card--accent { background: var(--brutal-accent); color: var(--brutal-ink); }
  .service-card--accent .service-card__num { color: var(--brutal-ink); }
  .service-card--accent .service-card__feat-mark { color: var(--brutal-ink); }
  .service-card--accent:hover { color: var(--brutal-bg); }
  .service-card--accent:hover .service-card__num { color: var(--brutal-lime); }
  .service-card--accent::after { background: var(--brutal-ink); }

  .service-card--lime { background: var(--brutal-lime); color: var(--brutal-ink); }
  .service-card--lime .service-card__num { color: var(--brutal-ink); }

  .service-card--ink { background: var(--brutal-ink); color: var(--brutal-bg); }
  .service-card--ink .service-card__num { color: var(--brutal-accent); }
  .service-card--ink .service-card__kicker,
  .service-card--ink .service-card__desc { color: var(--brutal-bg-alt); }
  .service-card--ink .service-card__feat { color: var(--brutal-bg-alt); }
  .service-card--ink .service-card__feat-mark { color: var(--brutal-lime); }
  .service-card--ink .service-card__figure-val { color: var(--brutal-lime); }
  .service-card--ink .service-card__figure-lbl { color: var(--brutal-bg-alt); }
  .service-card--ink::after { background: var(--brutal-accent); }
  .service-card--ink:hover { color: var(--brutal-ink); }
  .service-card--ink:hover .service-card__num,
  .service-card--ink:hover .service-card__title,
  .service-card--ink:hover .service-card__figure-val,
  .service-card--ink:hover .service-card__cta { color: var(--brutal-ink); }
  .service-card--ink:hover .service-card__kicker,
  .service-card--ink:hover .service-card__desc,
  .service-card--ink:hover .service-card__feat,
  .service-card--ink:hover .service-card__figure-lbl { color: var(--brutal-ink-soft); }
  .service-card--ink:hover .service-card__feat-mark { color: var(--brutal-ink); }

  .service-card__head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 1rem; border-bottom: 1px solid currentColor;
  }
  .service-card__num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brutal-accent);
  }
  .service-card__kicker {
    font-family: var(--font-mono);
    font-size: .65rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--brutal-text-muted);
  }
  .service-card__body { margin: 1.5rem 0; flex: 1; }
  .service-card__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: .92;
    letter-spacing: -.03em;
    margin: 0 0 .85rem;
  }
  .service-card__desc { font-size: .95rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 38ch; }

  .service-card__features { list-style: none; padding: 0; margin: 1.25rem 0; display: flex; flex-direction: column; gap: .5rem; }
  .service-card__feat { display: flex; gap: .65rem; align-items: baseline; font-family: var(--font-mono); font-size: .78rem; color: var(--brutal-text); }
  .service-card__feat-mark { color: var(--brutal-accent); font-weight: 700; }

  .service-card__foot {
    display: flex; justify-content: space-between; align-items: end;
    padding-top: 1rem; border-top: 1px solid currentColor;
    margin-top: auto;
  }
  .service-card__figure { display: flex; flex-direction: column; line-height: 1; }
  .service-card__figure-val { font-size: 1.7rem; font-weight: 700; }
  .service-card__figure-lbl {
    font-family: var(--font-mono);
    font-size: .6rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    margin-top: .35rem;
    color: var(--brutal-text-muted);
  }
  .service-card__cta {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--brutal-ink);
    transition: transform .2s;
  }
  .service-card:hover .service-card__cta { transform: translateX(4px); }

  /* CTA tile */
  .service-card--cta {
    background:
      repeating-linear-gradient(45deg, var(--brutal-ink) 0 1px, transparent 1px 12px),
      var(--brutal-card);
    border: none;
    justify-content: space-between;
  }
  .service-card--cta::after { display: none; }
  .service-card--cta .service-card__num { font-size: 2.5rem; color: var(--brutal-accent); }
  .service-card__cta-title { font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: .95; letter-spacing: -.03em; margin: 1rem 0; }
  .service-card__cta-title em { color: var(--brutal-accent); }
  .service-card__cta-desc { font-size: .9rem; line-height: 1.5; color: var(--brutal-text-secondary); margin-bottom: 1.5rem; }
  .service-card__cta-btn { width: 100%; justify-content: center; }
</style>
