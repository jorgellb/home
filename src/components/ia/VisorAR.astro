---
/* Esquema del probador: marco de móvil, caja de seguimiento facial y producto
   colocado. Es un diagrama, no una captura falsa: enseña cómo funciona sin
   simular un resultado que no se ha medido. */
---

<svg viewBox="0 0 520 300" preserveAspectRatio="xMidYMid meet">
  <!-- Móvil -->
  <rect x="140" y="14" width="140" height="272" rx="10" fill="var(--ia-panel-2)" stroke="var(--ia-regla-2)" stroke-width="1.5" />
  <rect x="152" y="30" width="116" height="240" fill="var(--ia-suelo)" stroke="var(--ia-regla)" />
  <!-- Caja de seguimiento -->
  <rect x="172" y="70" width="76" height="92" fill="none" stroke="var(--ia-maquina)" stroke-width="1.5" stroke-dasharray="6 4" />
  <text x="210" y="64" text-anchor="middle" font-family="var(--font-mono)" font-size="8" letter-spacing="1.2" fill="var(--ia-maquina)">SEGUIMIENTO FACIAL</text>
  <!-- Cara esquemática -->
  <path d="M 192 96 q 18 -14 36 0 q 4 34 -18 48 q -22 -14 -18 -48 z" fill="none" stroke="var(--ia-tenue)" stroke-width="1" />
  <!-- Producto colocado -->
  <path d="M 186 108 h 20 M 214 108 h 20" stroke="var(--ia-verificado)" stroke-width="2" />
  <circle cx="200" cy="110" r="8" fill="none" stroke="var(--ia-verificado)" stroke-width="2" />
  <circle cx="220" cy="110" r="8" fill="none" stroke="var(--ia-verificado)" stroke-width="2" />
  <!-- Anotaciones -->
  <path d="M 100 110 L 168 110" stroke="var(--ia-regla-2)" stroke-width="1" />
  <text x="20" y="106" font-family="var(--font-mono)" font-size="9" letter-spacing="1.2" fill="#b9c5cf">POSE 6 EJES</text>
  <text x="20" y="120" font-family="var(--font-mono)" font-size="8" letter-spacing="1" fill="var(--ia-tenue)">cámara del móvil</text>
  <path d="M 320 140 L 252 140" stroke="var(--ia-regla-2)" stroke-width="1" />
  <text x="320" y="136" font-family="var(--font-mono)" font-size="9" letter-spacing="1.2" fill="#b9c5cf">OCLUSIÓN</text>
  <text x="320" y="150" font-family="var(--font-mono)" font-size="8" letter-spacing="1" fill="var(--ia-tenue)">la patilla va detrás</text>
  <path d="M 320 210 L 252 210" stroke="var(--ia-regla-2)" stroke-width="1" />
  <text x="320" y="206" font-family="var(--font-mono)" font-size="9" letter-spacing="1.2" fill="#b9c5cf">CATÁLOGO</text>
  <text x="320" y="220" font-family="var(--font-mono)" font-size="8" letter-spacing="1" fill="var(--ia-tenue)">tus productos en 3D</text>
  <!-- Selector de producto -->
  <rect x="160" y="238" width="30" height="20" fill="none" stroke="var(--ia-verificado)" stroke-width="1.5" />
  <rect x="196" y="238" width="30" height="20" fill="none" stroke="var(--ia-regla-2)" />
  <rect x="232" y="238" width="30" height="20" fill="none" stroke="var(--ia-regla-2)" />
  <text x="210" y="276" text-anchor="middle" font-family="var(--font-mono)" font-size="8" letter-spacing="1.2" fill="var(--ia-tenue)">SIN INSTALAR NADA · EN EL NAVEGADOR</text>
</svg>
