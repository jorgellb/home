---
/* Tus sistemas → capa de IA → lo que sale. La capa no sustituye nada: se
   intercala. Trazas cian porque las recorre la máquina. */
const entrada = ['CRM', 'ERP', 'CORREO', 'ARCHIVOS'];
const salida = ['DOCUMENTO', 'REGISTRO', 'RESPUESTA'];
---

<svg viewBox="0 0 640 240" preserveAspectRatio="xMidYMid meet">
  <text x="20" y="18" font-family="var(--font-mono)" font-size="10" letter-spacing="1.6" fill="var(--ia-tenue)">TUS SISTEMAS</text>
  <text x="258" y="18" font-family="var(--font-mono)" font-size="10" letter-spacing="1.6" fill="var(--ia-maquina)">CAPA DE IA</text>
  <text x="500" y="18" font-family="var(--font-mono)" font-size="10" letter-spacing="1.6" fill="var(--ia-tenue)">LO QUE SALE</text>

  {entrada.map((s, i) => (
    <>
      <rect x="20" y={34 + i * 46} width="112" height="32" fill="none" stroke="var(--ia-regla-2)" />
      <text x="76" y={54 + i * 46} text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.2" fill="#b9c5cf">{s}</text>
      <path d={`M 132 ${50 + i * 46} L 180 ${50 + i * 46} L 180 120 L 250 120`} stroke="var(--ia-maquina)" stroke-width="1.5" fill="none" />
    </>
  ))}

  <rect x="250" y="76" width="136" height="88" fill="var(--ia-panel-2)" stroke="var(--ia-maquina)" stroke-width="1.5" />
  <text x="318" y="108" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.4" fill="var(--ia-maquina)">AGENTES</text>
  <text x="318" y="126" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.4" fill="var(--ia-maquina)">+ REGLAS</text>
  <text x="318" y="146" text-anchor="middle" font-family="var(--font-mono)" font-size="9" letter-spacing="1.2" fill="var(--ia-tenue)">PERMISOS · REGISTRO</text>

  {salida.map((s, i) => (
    <>
      <path d={`M 386 120 L 440 120 L 440 ${58 + i * 52} L 490 ${58 + i * 52}`} stroke="var(--ia-maquina)" stroke-width="1.5" fill="none" />
      <path d={`M 484 ${54 + i * 52} l 6 4 l -6 4`} stroke="var(--ia-maquina)" stroke-width="1.5" fill="none" />
      <rect x="490" y={42 + i * 52} width="126" height="32" fill="none" stroke="var(--ia-regla-2)" />
      <text x="553" y={62 + i * 52} text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.2" fill="#b9c5cf">{s}</text>
    </>
  ))}

  <rect x="250" y="186" width="136" height="26" fill="none" stroke="var(--ia-persona)" stroke-dasharray="4 3" />
  <text x="318" y="203" text-anchor="middle" font-family="var(--font-mono)" font-size="9" letter-spacing="1.2" fill="var(--ia-persona)">APROBACIÓN HUMANA</text>
  <path d="M 318 164 L 318 186" stroke="var(--ia-persona)" stroke-width="1.5" fill="none" />
</svg>
