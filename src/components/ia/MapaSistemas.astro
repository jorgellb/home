---
/* Las herramientas de la empresa, sin nada que las una: el trabajo manual es
   la traza discontinua roja. Dibujo ortogonal, sin curvas. */
const sistemas = ['CORREO', 'ERP', 'CRM', 'WHATSAPP', 'PDF', 'DRIVE'];
---

<svg viewBox="0 0 640 220" preserveAspectRatio="xMidYMid meet">
  {sistemas.map((s, i) => {
    const x = 20 + i * 102;
    return (
      <>
        <rect x={x} y="24" width="88" height="44" fill="none" stroke="var(--ia-regla-2)" stroke-width="1" />
        <text x={x + 44} y="51" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.4" fill="#b9c5cf">{s}</text>
        <path d={`M ${x + 44} 68 L ${x + 44} 120`} stroke="var(--ia-atencion)" stroke-width="1" stroke-dasharray="4 3" fill="none" />
      </>
    );
  })}
  <path d="M 64 120 L 574 120" stroke="var(--ia-atencion)" stroke-width="1.5" stroke-dasharray="4 3" fill="none" />
  <rect x="180" y="134" width="280" height="30" fill="var(--ia-suelo)" stroke="var(--ia-atencion)" stroke-width="1" stroke-dasharray="4 3" />
  <text x="320" y="154" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.6" fill="var(--ia-atencion)">COPIAR · PEGAR · REENVIAR · RECORDAR</text>
  <path d="M 320 164 L 320 190" stroke="var(--ia-atencion)" stroke-width="1" stroke-dasharray="4 3" fill="none" />
  <text x="320" y="204" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.4" fill="var(--ia-tenue)">UNA PERSONA DE TU EQUIPO</text>
</svg>
