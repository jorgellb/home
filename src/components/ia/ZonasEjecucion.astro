---
/* Tres zonas apiladas: qué se queda en casa del cliente, qué en nuestro
   servidor y qué llega al proveedor del modelo. Es la lámina que desbloquea
   al responsable de sistemas. */
const zonas = [
  { titulo: 'TU RED', que: 'ERP · CRM · archivos · copias', color: 'var(--ia-verificado)' },
  { titulo: 'NUESTRO SERVIDOR', que: 'lógica · permisos · registro de actividad', color: 'var(--ia-maquina)' },
  { titulo: 'PROVEEDOR DEL MODELO', que: 'solo el texto necesario para resolver el paso', color: 'var(--ia-tenue)' },
];
---

<svg viewBox="0 0 640 210" preserveAspectRatio="xMidYMid meet">
  {zonas.map((z, i) => (
    <>
      <rect x="20" y={16 + i * 64} width="600" height="48" fill="none" stroke={z.color} stroke-width="1" stroke-dasharray={i === 2 ? '5 3' : undefined} />
      <text x="36" y={38 + i * 64} font-family="var(--font-mono)" font-size="11" letter-spacing="1.6" fill={z.color}>{z.titulo}</text>
      <text x="36" y={54 + i * 64} font-family="var(--font-mono)" font-size="10" letter-spacing="1" fill="#b9c5cf">{z.que}</text>
      {i < 2 && (
        <>
          <path d={`M 560 ${64 + i * 64} L 560 ${80 + i * 64}`} stroke="var(--ia-maquina)" stroke-width="1.5" fill="none" />
          <text x="572" y={77 + i * 64} font-family="var(--font-mono)" font-size="9" letter-spacing="1" fill="var(--ia-tenue)">{i === 0 ? 'LECTURA' : 'CONSULTA'}</text>
        </>
      )}
    </>
  ))}
</svg>
