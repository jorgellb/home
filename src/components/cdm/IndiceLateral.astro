---
/* Raíl de secciones con progreso de lectura, al estilo de un panel de control.
   A partir de 1024 px va pegado al lateral; por debajo se convierte en una
   barra fina de progreso bajo la cabecera. */
import type { SeccionIndice } from './tipos';

interface Props {
  secciones: SeccionIndice[];
  coordenadas?: string;
  class?: string;
}

const { secciones, coordenadas, class: clase } = Astro.props;
---

<nav class:list={['cdm-indice', clase]} aria-label="Secciones de la página" data-indice>
  <p class="cdm-indice__titulo">En esta página</p>
  <ol class="cdm-indice__lista">
    {secciones.map((s) => (
      <li>
        <a href={`#${s.id}`} data-indice-enlace={s.id}>{s.etiqueta}</a>
      </li>
    ))}
  </ol>
  <div class="cdm-indice__progreso" aria-hidden="true"><i data-indice-barra></i></div>
  {coordenadas && <p class="cdm-indice__coord">{coordenadas}</p>}
</nav>

<script>
  const indice = document.querySelector<HTMLElement>('[data-indice]');
  if (indice) {
    const enlaces = [...indice.querySelectorAll<HTMLAnchorElement>('[data-indice-enlace]')];
    const barra = indice.querySelector<HTMLElement>('[data-indice-barra]');
    const secciones = enlaces
      .map((a) => document.getElementById(a.dataset.indiceEnlace ?? ''))
      .filter((e): e is HTMLElement => !!e);

    if (secciones.length) {
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            for (const a of enlaces) {
              const activo = a.dataset.indiceEnlace === entrada.target.id;
              a.classList.toggle('is-activo', activo);
              if (activo) a.setAttribute('aria-current', 'true');
              else a.removeAttribute('aria-current');
            }
          }
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      for (const s of secciones) observador.observe(s);
    }

    if (barra) {
      const avance = () => {
        const alto = document.documentElement.scrollHeight - window.innerHeight;
        const leido = alto > 0 ? Math.min(1, window.scrollY / alto) : 0;
        barra.style.transform = `scaleX(${leido})`;
      };
      avance();
      window.addEventListener('scroll', avance, { passive: true });
      window.addEventListener('resize', avance);
    }
  }
</script>

<style>
  .cdm-indice {
    position: sticky;
    top: 84px;
    align-self: start;
    display: none;
    font-size: 0.85rem;
  }
  .cdm-indice__titulo { margin: 0 0 0.6rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-cdm-tenue); }
  .cdm-indice__lista { display: grid; gap: 0.15rem; margin: 0 0 0.9rem; padding: 0; list-style: none; }
  .cdm-indice__lista a {
    display: block;
    padding: 0.35rem 0 0.35rem 0.75rem;
    border-left: 2px solid var(--color-cdm-regla);
    color: var(--color-cdm-tenue);
    text-decoration: none;
    line-height: 1.3;
  }
  .cdm-indice__lista a:hover { color: var(--color-cdm-texto); }
  .cdm-indice__lista a.is-activo { border-left-color: var(--color-cdm-senal); color: var(--color-cdm-texto); }
  .cdm-indice__lista a:focus-visible { outline: 2px solid var(--color-cdm-ok); outline-offset: 2px; }
  .cdm-indice__progreso { height: 2px; background: var(--color-cdm-regla); }
  .cdm-indice__progreso i { display: block; height: 100%; background: var(--color-cdm-senal); transform-origin: left; transform: scaleX(0); }
  .cdm-indice__coord { margin: 0.7rem 0 0; font-family: var(--font-mono); font-size: 0.7rem; line-height: 1.6; color: var(--color-cdm-tenue); }

  @media (min-width: 1024px) {
    .cdm-indice { display: block; }
  }

  /* Por debajo de 1024 px: solo la barra de progreso, fija bajo la cabecera. */
  @media (max-width: 1023px) {
    .cdm-indice {
      display: block;
      position: sticky;
      top: 64px;
      z-index: 40;
      background: var(--color-cdm-suelo);
      border-bottom: 1px solid var(--color-cdm-regla);
    }
    .cdm-indice__titulo,
    .cdm-indice__lista,
    .cdm-indice__coord { display: none; }
    .cdm-indice__progreso { height: 3px; background: transparent; }
  }
</style>
