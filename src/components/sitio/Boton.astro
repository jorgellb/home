---
import Icono, { type NombreIcono } from './Icono.astro';

interface Props {
  href: string;
  variante?: 'primario' | 'secundario' | 'texto' | 'claro';
  icono?: NombreIcono | null;
  class?: string;
  externo?: boolean;
}

const { href, variante = 'primario', icono = 'flecha', class: clase, externo = false } = Astro.props;
---

<a
  href={href}
  class:list={['boton', `boton--${variante}`, clase]}
  {...(externo ? { target: '_blank', rel: 'noopener' } : {})}
>
  <span><slot /></span>
  {icono && <Icono nombre={icono} tamano={18} />}
</a>

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-weight: 680;
    font-size: var(--t-s);
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .boton :global(.icono) {
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .boton:hover :global(.icono) {
    transform: translateX(3px);
  }
  .boton--primario,
  .boton--secundario,
  .boton--claro {
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.15s, box-shadow 0.15s;
  }
  .boton--primario {
    background: linear-gradient(180deg, #13704a 0%, var(--verde) 100%);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 3px 0 var(--verde-2), 0 10px 20px -10px rgba(14, 91, 58, 0.55);
  }
  .boton--primario:hover {
    transform: translateY(-1px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 4px 0 var(--verde-2), 0 14px 24px -12px rgba(14, 91, 58, 0.6);
  }
  .boton--secundario {
    background: var(--superficie);
    color: var(--tinta);
    border: 1.5px solid var(--linea-2);
    box-shadow: 0 3px 0 var(--linea);
  }
  .boton--secundario:hover {
    border-color: var(--tinta);
    transform: translateY(-1px);
  }
  .boton--claro {
    background: #fff;
    color: var(--tinta);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.18);
  }
  .boton--claro:hover {
    background: var(--platano);
    transform: translateY(-1px);
  }
  .boton--primario:active,
  .boton--secundario:active,
  .boton--claro:active {
    transform: translateY(2px);
    box-shadow: none;
  }
  .boton--texto {
    min-height: auto;
    padding: 0.25rem 0;
    border-radius: 0;
    color: var(--verde);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
  }
</style>
