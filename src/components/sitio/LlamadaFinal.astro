---
/* Cierre a sangre: titular enorme, escena de contacto y los tres canales. Sin precios. */
import Boton from './Boton.astro';
import IconoIso from './IconoIso.astro';
import Ilustracion from './Ilustracion.astro';
import { CONTACTO } from '../../data/navegacion';

interface Props {
  titulo?: string;
  texto?: string;
  /** Parámetro ?servicio= para el formulario de contacto. */
  servicio?: string;
}
const {
  titulo = 'Cuéntanos qué necesitas y te decimos cómo lo haríamos',
  texto = 'Una llamada de media hora, sin compromiso. Si no somos lo que buscas, te lo diremos y te orientaremos igual.',
  servicio,
} = Astro.props;
const href = servicio ? `/contacto/?servicio=${encodeURIComponent(servicio)}` : '/contacto/';
const canales = [
  { icono: 'whatsapp' as const, t: 'WhatsApp', d: 'La vía más rápida', href: CONTACTO.whatsapp, externo: true },
  { icono: 'telefono' as const, t: CONTACTO.telefono, d: 'De lunes a viernes', href: CONTACTO.telefonoHref },
  { icono: 'email' as const, t: CONTACTO.email, d: 'Para explicaciones largas', href: `mailto:${CONTACTO.email}` },
];
---

<section class="llamada fondo-iso fondo-iso--claro" aria-labelledby="llamada-titulo">
  <div class="llamada__luz" aria-hidden="true"></div>
  <div class="contenedor llamada__rejilla">
    <div class="llamada__texto">
      <p class="antetitulo antetitulo--claro">Hablemos</p>
      <h2 id="llamada-titulo">{titulo}</h2>
      <p class="llamada__entradilla">{texto}</p>
      <div class="llamada__acciones">
        <Boton href={href} variante="claro">Pedir una llamada</Boton>
        <span class="llamada__garantia">Respondemos en menos de 4 horas laborables</span>
      </div>
    </div>
    <Ilustracion nombre="contacto" class="llamada__ilustracion" />
    <ul class="llamada__canales">
      {canales.map((c) => (
        <li>
          <a href={c.href} class="canal tarjeta-hover" {...(c.externo ? { target: '_blank', rel: 'noopener' } : {})}>
            <IconoIso nombre={c.icono} tono="platano" tamano={52} />
            <span>
              <b>{c.t}</b>
              <small>{c.d}</small>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .llamada {
    position: relative;
    overflow: hidden;
    padding-block: var(--seccion);
    color: #fff;
    background:
      radial-gradient(80% 120% at 100% 0%, #1b8456 0%, transparent 60%),
      linear-gradient(170deg, var(--verde) 0%, var(--verde-2) 100%);
  }
  .llamada__luz {
    position: absolute;
    inset: auto -10% -40% auto;
    width: 70vmax;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(255, 207, 63, 0.2), transparent);
    pointer-events: none;
  }
  .llamada__rejilla {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .llamada h2 {
    font-size: clamp(2.4rem, 1.5rem + 3.6vw, 4.75rem);
    max-width: 17ch;
    color: #fff;
  }
  .llamada__entradilla {
    margin-top: 1.25rem;
    font-size: var(--t-l);
    color: #d5ecdf;
    max-width: 48ch;
  }
  .llamada__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  .llamada__garantia {
    font-size: var(--t-s);
    color: #d5ecdf;
  }
  .llamada :global(.llamada__ilustracion) {
    max-width: 440px;
    justify-self: center;
  }
  .llamada__canales {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .canal {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radio-l);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
    text-decoration: none;
  }
  .canal:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .canal span {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .canal b {
    overflow-wrap: anywhere;
  }
  .canal small {
    color: #b9dcc8;
    font-size: var(--t-xs);
  }
  @media (min-width: 900px) {
    .llamada__rejilla {
      grid-template-columns: 1.3fr 1fr;
    }
    .llamada__canales {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
