---
/* Bloque oscuro de valor: una guía o lista de comprobación útil por sí misma.
   Lista editorial con números gigantes y una línea que se llena con el scroll. */
import Boton from './Boton.astro';
import IconoIso from './IconoIso.astro';

interface Props {
  antetitulo?: string;
  titulo: string;
  entradilla?: string;
  bloques: { t: string; d: string }[];
  accion?: { href: string; texto: string };
  id?: string;
}
const { antetitulo = 'Guía rápida', titulo, entradilla, bloques, accion, id = 'guia-titulo' } = Astro.props;
---

<section class="seccion seccion--tinta guia-seccion fondo-iso fondo-iso--claro" aria-labelledby={id}>
  <div class="guia__luz" aria-hidden="true"></div>
  <div class="contenedor guia">
    <div class="guia__cabeza">
      <IconoIso nombre="check" tono="tinta" tamano={84} />
      <p class="antetitulo antetitulo--claro">{antetitulo}</p>
      <h2 id={id}>{titulo}</h2>
      {entradilla && <p class="entradilla">{entradilla}</p>}
      {accion && <Boton href={accion.href} variante="claro">{accion.texto}</Boton>}
    </div>
    <div class="lista-caja">
    <span class="lista__pista" aria-hidden="true"><span class="lista__relleno"></span></span>
    <ol class="lista">
      {bloques.map((c, i) => (
        <li class="lista__item" data-aparece style={`transition-delay:${i * 60}ms`}>
          <span class="lista__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{c.t}</h3>
            <p set:html={c.d} />
          </div>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>

<style>
  .guia-seccion {
    overflow: hidden;
  }
  .guia__luz {
    position: absolute;
    inset: -20% auto auto -10%;
    width: 60vmax;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(58, 154, 107, 0.28), transparent);
    pointer-events: none;
    z-index: -1;
  }
  .guia {
    display: grid;
    gap: 3rem;
  }
  .guia__cabeza {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
  }
  .guia__cabeza h2 {
    font-size: var(--t-3xl);
  }
  .guia .entradilla {
    color: #c9ccc2;
  }
  .lista-caja {
    position: relative;
  }
  .lista {
    position: relative;
    list-style: none;
    display: grid;
    gap: 0;
    padding-left: 0;
  }
  .lista__pista {
    position: absolute;
    left: 2.2rem;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 2px;
    background: #2c3128;
    overflow: hidden;
  }
  .lista__relleno {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--platano), #3a9a6b);
    transform-origin: top;
    transform: scaleY(1);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lista__relleno {
        animation: llenar linear both;
        animation-timeline: view();
        animation-range: entry 30% exit 40%;
      }
    }
  }
  @keyframes llenar {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .lista__item {
    position: relative;
    display: grid;
    grid-template-columns: 4.4rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #2c3128;
  }
  .lista__item:last-child {
    border-bottom: 0;
  }
  .lista__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: var(--tinta);
    border: 2px solid #3d4339;
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.04em;
    color: var(--platano);
    font-variant-numeric: tabular-nums;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .lista__item:hover .lista__num {
    background: var(--platano);
    border-color: var(--platano);
    color: var(--tinta);
  }
  .lista h3 {
    font-size: var(--t-l);
    line-height: 1.3;
    margin-top: 0.6rem;
  }
  .lista p {
    margin-top: 0.4rem;
    color: #b4b8ad;
    font-size: var(--t-s);
    max-width: 58ch;
  }
  .lista p :global(a) {
    color: var(--platano);
  }
  @media (min-width: 960px) {
    .guia {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 5rem;
    }
    .guia__cabeza {
      position: sticky;
      top: 6rem;
    }
  }
</style>
