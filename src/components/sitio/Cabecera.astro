---
/* Cabecera. En escritorio: navegación + megamenú de servicios. En móvil:
   hoja a pantalla completa con accesos rápidos, servicios en mosaico por
   grupos y barra fija de contacto (llamar, WhatsApp, pedir presupuesto). */
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import IconoServicio from './IconoServicio.astro';
import { SERVICIOS, GRUPOS, ENLACES_PRINCIPALES, CONTACTO } from '../../data/navegacion';

const ruta = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
const enServicios = SERVICIOS.some((s) => activo(s.href));
const rapidos = ENLACES_PRINCIPALES;
let orden = 0;
---

<header class="cabecera" data-cabecera>
  <div class="contenedor cabecera__barra">
    <a href="/" class="cabecera__logo" aria-label="platanitorico, ir al inicio">
      <Logo />
    </a>

    <nav class="cabecera__nav" aria-label="Principal">
      <button
        type="button"
        class:list={['cabecera__enlace', 'cabecera__desplegar', { activo: enServicios }]}
        aria-expanded="false"
        aria-controls="menu-servicios"
        data-desplegar
      >
        Servicios <Icono nombre="chevron-abajo" tamano={16} />
      </button>
      {ENLACES_PRINCIPALES.map((e) => (
        <a href={e.href} class:list={['cabecera__enlace', { activo: activo(e.href) }]} aria-current={activo(e.href) ? 'page' : undefined}>
          {e.nombre}
        </a>
      ))}
    </nav>

    <div class="cabecera__acciones">
      <a href="/contacto/" class="cabecera__cta">Hablemos</a>
      <button type="button" class="cabecera__menu" aria-expanded="false" aria-controls="menu-servicios" aria-label="Abrir menú" data-desplegar>
        <span class="hamburguesa" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="panel" id="menu-servicios" hidden>
    <div class="panel__cuerpo">
      <div class="contenedor">
        <ul class="panel__rapidos">
          {rapidos.map((e) => (
            <li style={`--i:${orden++}`}>
              <a href={e.href} class:list={['rapido', { 'rapido--activo': activo(e.href) }]} aria-current={activo(e.href) ? 'page' : undefined}>
                {e.nombre}
              </a>
            </li>
          ))}
        </ul>

        <div class="panel__rejilla">
          {GRUPOS.map((g, gi) => (
            <div class="panel__grupo">
              <p class="panel__titulo"><span aria-hidden="true">0{gi + 1}</span> {g.nombre}</p>
              <ul>
                {SERVICIOS.filter((s) => s.grupo === g.id).map((s) => (
                  <li style={`--i:${orden++}`}>
                    <a href={s.href} class="panel__servicio" aria-current={activo(s.href) ? 'page' : undefined}>
                      <IconoServicio servicio={s.slug} tamano={44} />
                      <span class="panel__nombre">{s.nombre}</span>
                      <span class="panel__resumen">{s.resumen}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="panel__pie">
      <div class="contenedor panel__acciones">
        <a href={CONTACTO.telefonoHref} class="accion" aria-label={`Llamar al ${CONTACTO.telefono}`}><Icono nombre="telefono" tamano={20} /><span>Llamar</span></a>
        <a href={CONTACTO.whatsapp} class="accion" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><Icono nombre="whatsapp" tamano={20} /><span>WhatsApp</span></a>
        <a href="/contacto/" class="accion accion--principal">Cuéntanos tu proyecto <Icono nombre="flecha" tamano={18} /></a>
      </div>
    </div>
  </div>
</header>

<script>
  const cabecera = document.querySelector<HTMLElement>('[data-cabecera]');
  const panel = document.getElementById('menu-servicios');
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-desplegar]');
  const hamburguesa = document.querySelector<HTMLButtonElement>('.cabecera__menu');
  const movil = window.matchMedia('(max-width: 959px)');

  const cambiar = (abrir: boolean) => {
    if (!panel || !cabecera) return;
    panel.hidden = !abrir;
    cabecera.classList.toggle('abierta', abrir);
    // En móvil el menú ocupa la pantalla: se bloquea el scroll de la página.
    document.documentElement.classList.toggle('menu-abierto', abrir && movil.matches);
    botones.forEach((b) => b.setAttribute('aria-expanded', String(abrir)));
    hamburguesa?.setAttribute('aria-label', abrir ? 'Cerrar menú' : 'Abrir menú');
  };

  botones.forEach((b) => b.addEventListener('click', () => cambiar(panel?.hidden !== false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hidden) {
      cambiar(false);
      (movil.matches ? hamburguesa : botones[0])?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (panel && !panel.hidden && cabecera && !cabecera.contains(e.target as Node)) cambiar(false);
  });
  // Al pasar a escritorio con el menú abierto, se libera el scroll.
  movil.addEventListener('change', () => {
    if (panel && !panel.hidden) cambiar(true);
  });

  // Borde inferior solo cuando hay scroll (sin escuchar scroll: un centinela).
  const centinela = document.createElement('div');
  centinela.style.cssText = 'position:absolute;top:0;height:1px;width:1px';
  document.body.prepend(centinela);
  new IntersectionObserver(([e]) => cabecera?.classList.toggle('con-scroll', !e.isIntersecting)).observe(centinela);
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(250, 250, 247, 0.97);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  @supports (backdrop-filter: blur(1px)) {
    .cabecera {
      background: rgba(250, 250, 247, 0.82);
      backdrop-filter: saturate(1.6) blur(14px);
    }
  }
  .cabecera.con-scroll,
  .cabecera.abierta {
    border-bottom-color: var(--linea);
  }
  /* Sin desenfoque con el menú abierto: backdrop-filter haría de la cabecera
     el bloque contenedor del panel fijo y lo recortaría. */
  .cabecera.abierta {
    background: var(--fondo);
    backdrop-filter: none;
  }
  .cabecera__barra {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.25rem;
  }
  .cabecera__logo {
    text-decoration: none;
    margin-right: auto;
  }
  .cabecera__nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  .cabecera__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.85rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--tinta-2);
    text-decoration: none;
    cursor: pointer;
  }
  .cabecera__enlace:hover,
  .cabecera__enlace.activo,
  .cabecera__desplegar[aria-expanded='true'] {
    color: var(--tinta);
    background: var(--fondo-2);
  }
  .cabecera__desplegar :global(.icono) {
    transition: transform 0.2s;
  }
  .cabecera__desplegar[aria-expanded='true'] :global(.icono) {
    transform: rotate(180deg);
  }
  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cabecera__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--verde);
    color: #fff;
    font-weight: 680;
    font-size: var(--t-s);
    text-decoration: none;
  }
  .cabecera__cta:hover {
    background: var(--verde-2);
  }

  /* Hamburguesa que se convierte en aspa */
  .cabecera__menu {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--linea-2);
    border-radius: 999px;
    background: var(--superficie);
    color: var(--tinta);
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .cabecera__menu[aria-expanded='true'] {
    background: var(--tinta);
    border-color: var(--tinta);
    color: #fff;
  }
  .hamburguesa {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }
  .hamburguesa span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.2s;
  }
  .hamburguesa span:nth-child(1) {
    top: 0;
  }
  .hamburguesa span:nth-child(2) {
    top: 5px;
    width: 70%;
  }
  .hamburguesa span:nth-child(3) {
    top: 10px;
  }
  [aria-expanded='true'] .hamburguesa span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .hamburguesa span:nth-child(2) {
    opacity: 0;
    transform: translateX(6px);
  }
  [aria-expanded='true'] .hamburguesa span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* Panel: base común */
  .panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--fondo);
    border-bottom: 1px solid var(--linea);
    box-shadow: var(--sombra-l);
  }
  .panel ul {
    list-style: none;
  }
  .panel__titulo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    font-size: var(--t-xs);
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tenue);
  }
  .panel__titulo span {
    color: var(--verde);
  }
  .panel__servicio {
    display: grid;
    text-decoration: none;
  }
  .panel__nombre {
    font-weight: 700;
    line-height: 1.25;
  }
  .panel__resumen {
    font-size: var(--t-s);
    color: var(--tenue);
    line-height: 1.4;
  }

  /* Móvil: hoja a pantalla completa */
  @media (max-width: 959px) {
    .cabecera__cta {
      min-height: 2.5rem;
      padding-inline: 1rem;
    }
    .panel:not([hidden]) {
      position: fixed;
      top: 4.25rem;
      bottom: 0;
      display: flex;
      flex-direction: column;
      border: 0;
      box-shadow: none;
      background:
        radial-gradient(90% 40% at 100% 0%, rgba(255, 207, 63, 0.16), transparent 70%),
        var(--fondo);
    }
    .panel__cuerpo {
      flex: 1;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block: 1rem 1.5rem;
    }
    .panel__rapidos {
      display: flex;
      gap: 0.5rem;
      margin-inline: -1rem;
      padding: 0 1rem 0.25rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .panel__rapidos::-webkit-scrollbar {
      display: none;
    }
    .rapido {
      display: inline-flex;
      align-items: center;
      min-height: 2.5rem;
      padding: 0.4rem 1rem;
      border-radius: 999px;
      border: 1px solid var(--linea-2);
      background: var(--superficie);
      font-size: var(--t-s);
      font-weight: 650;
      white-space: nowrap;
      text-decoration: none;
    }
    .rapido--activo {
      border-color: var(--verde);
      background: var(--verde-suave);
      color: var(--verde);
    }
    .panel__rejilla {
      display: grid;
      gap: 1.4rem;
      margin-top: 1.4rem;
    }
    .panel__grupo ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .panel__servicio {
      grid-template-columns: 36px 1fr;
      align-items: center;
      gap: 0.6rem;
      height: 100%;
      min-height: 4rem;
      padding: 0.6rem 0.7rem;
      border-radius: var(--radio-l);
      border: 1px solid var(--linea);
      background: var(--superficie);
      box-shadow: 0 1px 0 var(--linea);
      transition:
        transform 0.15s,
        border-color 0.2s;
    }
    .panel__servicio:active {
      transform: scale(0.97);
    }
    .panel__servicio[aria-current='page'] {
      border-color: var(--verde);
      background: linear-gradient(160deg, #fff, var(--verde-suave));
    }
    .panel__servicio :global(.icono-servicio) {
      width: 36px;
      height: 36px;
    }
    /* El último de un grupo impar ocupa toda la fila. */
    .panel__grupo li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .panel__nombre {
      font-size: var(--t-s);
      line-height: 1.2;
    }
    .panel__resumen {
      display: none;
    }
    .panel__pie {
      flex: none;
      padding-block: 0.75rem calc(0.75rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--linea);
      background: var(--superficie);
    }
    .panel__acciones {
      display: grid;
      grid-template-columns: 3rem 3rem 1fr;
      gap: 0.5rem;
    }
    .accion span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
    .accion {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-height: 3rem;
      padding: 0.5rem;
      border-radius: 999px;
      white-space: nowrap;
      border: 1px solid var(--linea-2);
      font-weight: 700;
      font-size: var(--t-s);
      text-decoration: none;
    }
    .accion :global(.icono) {
      color: var(--verde);
    }
    .accion--principal {
      border-color: var(--verde);
      background: var(--verde);
      color: #fff;
    }
    .accion--principal :global(.icono) {
      color: var(--platano);
    }
    :global(html.menu-abierto) {
      overflow: hidden;
    }

    @media (prefers-reduced-motion: no-preference) {
      .panel:not([hidden]) {
        animation: entra-panel 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .panel:not([hidden]) li {
        animation: entra-item 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        animation-delay: calc(var(--i, 0) * 28ms + 60ms);
      }
      .panel:not([hidden]) .panel__pie {
        animation: entra-pie 0.4s 0.12s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }
    }
  }
  @keyframes entra-panel {
    from {
      opacity: 0;
    }
  }
  @keyframes entra-item {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes entra-pie {
    from {
      transform: translateY(100%);
    }
  }

  /* Escritorio: megamenú */
  @media (min-width: 960px) {
    .cabecera__nav {
      display: flex;
    }
    .cabecera__logo {
      margin-right: 0;
    }
    .cabecera__acciones {
      margin-left: auto;
    }
    .cabecera__menu,
    .panel__rapidos,
    .panel__pie {
      display: none;
    }
    .panel {
      max-height: calc(100dvh - 4.25rem);
      overflow-y: auto;
    }
    .panel__rejilla {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
      padding-block: 2rem 2.5rem;
    }
    .panel__grupo ul {
      display: grid;
      gap: 0.15rem;
    }
    .panel__servicio {
      grid-template-columns: 44px 1fr;
      column-gap: 0.85rem;
      row-gap: 0.1rem;
      align-items: center;
      padding: 0.65rem 0.75rem;
      margin-inline: -0.75rem;
      border-radius: var(--radio);
    }
    .panel__servicio :global(.icono-servicio) {
      grid-row: 1 / span 2;
    }
    .panel__servicio:hover,
    .panel__servicio[aria-current='page'] {
      background: var(--superficie);
    }
  }
</style>
