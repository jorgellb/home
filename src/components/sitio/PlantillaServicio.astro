---
/* Página de servicio completa a partir de un ContenidoServicio. */
import Sitio from '../../layouts/Sitio.astro';
import Boton from './Boton.astro';
import Icono from './Icono.astro';
import Ilustracion from './Ilustracion.astro';
import IconoServicio from './IconoServicio.astro';
import IconoIso from './IconoIso.astro';
import Encabezado from './Encabezado.astro';
import Migas from './Migas.astro';
import Puntos from './Puntos.astro';
import Guia from './Guia.astro';
import Pasos from './Pasos.astro';
import Casos from './Casos.astro';
import Preguntas from './Preguntas.astro';
import LlamadaFinal from './LlamadaFinal.astro';
import type { ContenidoServicio } from '../../data/servicios/tipos';
import { SERVICIOS } from '../../data/navegacion';
import { PROVEEDOR, SITE } from '../../data/negocio';

interface Props {
  datos: ContenidoServicio;
}
const { datos: d } = Astro.props;
const url = `${SITE}${d.ruta}`;
const relacionados = (d.relacionados ?? []).map((s) => SERVICIOS.find((x) => x.slug === s)).filter((s) => s !== undefined);
const contacto = `/contacto/?servicio=${encodeURIComponent(d.servicioContacto)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.nombre,
  serviceType: d.tipo,
  description: d.seo.description,
  url,
  provider: PROVEEDOR,
  areaServed: { '@type': 'AdministrativeArea', name: 'Provincia de Almería' },
};
---

<Sitio title={d.seo.title} description={d.seo.description} canonical={url} type="service" jsonLd={jsonLd}>
  <section class="portada luces-portada">
    <div class="contenedor portada__rejilla">
      <div class="portada__texto">
        <Migas items={d.migas ?? [{ nombre: d.nombre }]} />
        <p class="antetitulo">{d.portada.antetitulo}</p>
        <h1 set:html={d.portada.h1} />
        <p class="entradilla" set:html={d.portada.entradilla} />
        <ul class="portada__puntos">
          {d.portada.puntos.map((p) => (
            <li><Icono nombre="check" tamano={18} /> <span set:html={p} /></li>
          ))}
        </ul>
        <div class="portada__acciones">
          <Boton href={contacto}>Cuéntanos tu caso</Boton>
          <Boton href="#incluye" variante="secundario" icono="flecha-abajo">Qué incluye</Boton>
        </div>
      </div>
      <div class="portada__escena fondo-iso"><Ilustracion nombre={d.escena} class="portada__ilustracion" prioridad /></div>
    </div>
  </section>

  {d.paraQuien && (
    <section class="seccion seccion--blanca" aria-labelledby="para-quien">
      <div class="contenedor">
        <Encabezado id="para-quien" antetitulo="Para quién" titulo={d.paraQuien.titulo} entradilla={d.paraQuien.entradilla} />
        <Puntos items={d.paraQuien.perfiles} sobre="blanco" columnas={d.paraQuien.perfiles.length === 4 ? 4 : 3} />
      </div>
    </section>
  )}

  <section class="seccion" id="incluye" aria-labelledby="incluye-titulo">
    <div class="contenedor">
      <Encabezado id="incluye-titulo" antetitulo="Qué incluye" titulo={d.incluye.titulo} entradilla={d.incluye.entradilla} />
      <Puntos items={d.incluye.items} columnas={d.incluye.items.length % 4 === 0 ? 4 : 3} />
    </div>
  </section>

  {d.guia && <Guia antetitulo={d.guia.antetitulo} titulo={d.guia.titulo} entradilla={d.guia.entradilla} bloques={d.guia.bloques} />}

  {d.comparativa && (
    <section class="seccion" aria-labelledby="comparativa-titulo">
      <div class="contenedor">
        <Encabezado id="comparativa-titulo" antetitulo="Comparativa" titulo={d.comparativa.titulo} entradilla={d.comparativa.entradilla} />
        <div class="duelo">
          <div class="duelo__cabeza" aria-hidden="true">
            <span></span>
            <span class="duelo__nos"><IconoIso nombre="check" tono="verde" tamano={44} /> {d.comparativa.columnas[0]}</span>
            <span class="duelo__otros">{d.comparativa.columnas[1]}</span>
          </div>
          <dl class="duelo__filas">
            {d.comparativa.filas.map((f, i) => (
              <div class="duelo__fila" data-aparece style={`transition-delay:${i * 60}ms`}>
                <dt>{f.aspecto}</dt>
                <dd class="duelo__nos"><span class="solo-lector">{d.comparativa!.columnas[0]}: </span><Icono nombre="check" tamano={18} /> {f.nosotros}</dd>
                <dd class="duelo__otros"><span class="solo-lector">{d.comparativa!.columnas[1]}: </span><Icono nombre="cerrar" tamano={16} /> {f.otros}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  )}

  {d.pasos && (
    <section class="seccion seccion--blanca" aria-labelledby="pasos-titulo">
      <div class="contenedor">
        <Encabezado id="pasos-titulo" antetitulo="Cómo trabajamos" titulo={d.pasos.titulo ?? 'Así lo hacemos, paso a paso'} />
        <Pasos pasos={d.pasos.items} />
      </div>
    </section>
  )}

  {d.casos && d.casos.length > 0 && (
    <section class="seccion" aria-labelledby="casos-titulo">
      <div class="contenedor">
        <Encabezado id="casos-titulo" antetitulo="Trabajos publicados" titulo="Proyectos que puedes visitar" />
        <Casos ids={d.casos} />
      </div>
    </section>
  )}

  <section class="seccion seccion--blanca" aria-labelledby="preguntas-titulo">
    <div class="contenedor dos-columnas">
      <Encabezado id="preguntas-titulo" antetitulo="Preguntas frecuentes" titulo="Lo que suelen preguntarnos" />
      <Preguntas preguntas={d.preguntas} />
    </div>
  </section>

  {d.enlaces && (
    <section class="seccion seccion--compacta" aria-labelledby="enlaces-titulo">
      <div class="contenedor">
        <h2 id="enlaces-titulo" class="enlaces__titulo">{d.enlaces.titulo}</h2>
        <ul class="enlaces">
          {d.enlaces.items.map((e) => (
            <li>
              <a href={e.href}>
                <span>{e.nombre}</span>
                {e.d && <small>{e.d}</small>}
                <Icono nombre="flecha" tamano={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {relacionados.length > 0 && (
    <section class="seccion seccion--compacta" aria-labelledby="relacionados-titulo">
      <div class="contenedor">
        <h2 id="relacionados-titulo" class="enlaces__titulo">Suele ir de la mano con</h2>
        <ul class="relacionados">
          {relacionados.map((s) => (
            <li>
              <a href={s.href} class="relacionado">
                <IconoServicio servicio={s.slug} tamano={64} />
                <span>
                  <b>{s.nombre}</b>
                  <small>{s.resumen}</small>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <LlamadaFinal titulo={d.llamada?.titulo} texto={d.llamada?.texto} servicio={d.servicioContacto} />
</Sitio>

<style>
  .portada {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3rem, 2rem + 4vw, 6rem);
    overflow: hidden;
  }
  .portada__rejilla {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .portada__texto {
    display: grid;
    gap: 1.25rem;
  }
  .portada h1 {
    font-size: var(--t-3xl);
    max-width: 18ch;
  }
  .portada__puntos {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    color: var(--tinta-2);
  }
  .portada__puntos li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .portada__puntos :global(.icono) {
    margin-top: 0.25rem;
    color: var(--verde);
  }
  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .portada__escena {
    justify-self: center;
    width: 100%;
    max-width: 520px;
    padding: 1rem 0;
  }
  @media (min-width: 960px) {
    .portada__rejilla {
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
    }
  }

  .duelo {
    display: grid;
    gap: 0.75rem;
  }
  .duelo__cabeza {
    display: none;
  }
  .duelo__filas {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .duelo__fila {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: var(--radio-l);
    background: var(--superficie);
    border: 1px solid var(--linea);
  }
  .duelo__fila dt {
    font-weight: 750;
  }
  .duelo__fila dd {
    margin: 0;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    padding: 0.75rem 0.9rem;
    border-radius: 12px;
    font-size: var(--t-s);
  }
  .duelo__fila dd :global(.icono) {
    margin-top: 0.15rem;
  }
  dd.duelo__nos {
    background: linear-gradient(160deg, #e9f6ee, var(--verde-suave));
    color: var(--tinta);
    font-weight: 650;
  }
  dd.duelo__nos :global(.icono) {
    color: var(--verde);
  }
  dd.duelo__otros {
    background: var(--fondo-2);
    color: var(--tenue);
  }
  dd.duelo__otros :global(.icono) {
    color: #b93a16;
  }
  @media (min-width: 860px) {
    .duelo__cabeza {
      display: grid;
      grid-template-columns: 0.7fr 1fr 1fr;
      gap: 0.75rem;
      align-items: end;
      padding-inline: 1rem;
      font-weight: 800;
      font-size: var(--t-l);
      letter-spacing: -0.02em;
    }
    .duelo__cabeza .duelo__nos {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--verde);
    }
    .duelo__cabeza .duelo__otros {
      color: var(--tenue);
      padding-bottom: 0.6rem;
    }
    .duelo__fila {
      grid-template-columns: 0.7fr 1fr 1fr;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0.6rem 0.6rem 1rem;
    }
  }

  .dos-columnas {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 960px) {
    .dos-columnas {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
    }
  }

  .enlaces__titulo {
    font-size: var(--t-xl);
    margin-bottom: 1.25rem;
  }
  .enlaces {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .enlaces a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--superficie);
    text-decoration: none;
    font-weight: 650;
  }
  .enlaces a:hover {
    border-color: var(--verde);
  }
  .enlaces small {
    grid-column: 1;
    font-weight: 400;
    color: var(--tenue);
    font-size: var(--t-s);
  }
  .enlaces :global(.icono) {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: var(--verde);
  }
  @media (min-width: 760px) {
    .enlaces {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .enlaces {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .relacionados {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .relacionado {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio-l);
    background: var(--superficie);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .relacionado:hover {
    border-color: var(--linea-2);
    transform: translateY(-2px);
  }
  .relacionado span {
    display: grid;
    gap: 0.2rem;
  }
  .relacionado small {
    color: var(--tenue);
    font-size: var(--t-s);
    line-height: 1.4;
  }
  @media (min-width: 860px) {
    .relacionados {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
