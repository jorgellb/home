---
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { SERVICIOS, CONTACTO } from '../../data/navegacion';
import { comarcas, getPueblosByComarca } from '../../data/pueblos-almeria';
import { esPuebloIndexable } from '../../data/pueblos-indexables';
import { aniosEnAlmeria } from '../../data/negocio';

const anio = new Date().getFullYear();
/* Enlaces a los municipios que se indexan: refuerzan el enlazado interno. */
const zonas = comarcas
  .map((c) => ({ comarca: c, pueblos: getPueblosByComarca(c).filter((p) => esPuebloIndexable(p.slug)) }))
  .filter((z) => z.pueblos.length > 0);
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie__cabeza">
      <div class="pie__marca">
        <a href="/" aria-label="platanitorico, ir al inicio"><Logo claro /></a>
        <p>Estudio digital en Vera (Almería). Desde hace {aniosEnAlmeria()} años hacemos webs, marketing e informática para negocios de toda la provincia.</p>
      </div>
      <ul class="pie__contacto">
        <li><a href={CONTACTO.telefonoHref}><Icono nombre="telefono" /> {CONTACTO.telefono}</a></li>
        <li><a href={CONTACTO.whatsapp} rel="noopener" target="_blank"><Icono nombre="whatsapp" /> WhatsApp</a></li>
        <li><a href={`mailto:${CONTACTO.email}`}><Icono nombre="email" /> {CONTACTO.email}</a></li>
        <li><span><Icono nombre="ubicacion" /> {CONTACTO.direccion}</span></li>
      </ul>
    </div>

    <div class="pie__columnas">
      <nav aria-label="Servicios">
        <details class="pie__grupo" open>
          <summary class="pie__titulo">Servicios <Icono nombre="chevron-abajo" tamano={18} /></summary>
          <ul>
            {SERVICIOS.map((s) => <li><a href={s.href}>{s.nombre}</a></li>)}
            <li><a href="/plan-360/">Plan 360</a></li>
          </ul>
        </details>
      </nav>
      {zonas.slice(0, 3).map((z) => (
        <nav aria-label={`Municipios de ${z.comarca}`}>
          <details class="pie__grupo" open>
            <summary class="pie__titulo">{z.comarca} <Icono nombre="chevron-abajo" tamano={18} /></summary>
            <ul>
              {z.pueblos.slice(0, 8).map((p) => <li><a href={`/diseno-web/${p.slug}/`}>Diseño web en {p.nombre}</a></li>)}
            </ul>
          </details>
        </nav>
      ))}
      <nav aria-label="Estudio">
        <details class="pie__grupo" open>
          <summary class="pie__titulo">Estudio <Icono nombre="chevron-abajo" tamano={18} /></summary>
          <ul>
            <li><a href="/diseno-web/">Todas las zonas</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/marketing/auditoria/">Auditoría gratuita</a></li>
            <li><a href="/contacto/">Contacto</a></li>
          </ul>
        </details>
      </nav>
    </div>

    <div class="pie__base">
      <p>© {anio} Platanito Rico</p>
      <ul>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/privacidad/">Privacidad</a></li>
        <li><a href="/cookies/">Cookies</a></li>
        <li><a href="/terminos-condiciones/">Términos</a></li>
      </ul>
    </div>
  </div>
  <svg class="pie__gigante" viewBox="0 0 1000 118" preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false">
    <text x="500" y="150" text-anchor="middle" font-weight="800" font-size="214" letter-spacing="-14" fill="#23281f">platanito<tspan fill="none" stroke="#3a4235" stroke-width="2">rico</tspan></text>
  </svg>
</footer>

<script>
  /* En móvil las columnas del pie se pliegan (acordeón); en escritorio van
     siempre abiertas. Sin JS quedan abiertas: los enlaces están siempre en el HTML. */
  const grupos = document.querySelectorAll<HTMLDetailsElement>('.pie__grupo');
  const ancho = window.matchMedia('(min-width: 800px)');
  const sincronizar = () => grupos.forEach((d) => (d.open = ancho.matches));
  sincronizar();
  ancho.addEventListener('change', sincronizar);
  grupos.forEach((d) =>
    d.querySelector('summary')?.addEventListener('click', (e) => {
      if (ancho.matches) e.preventDefault();
    }),
  );
</script>

<style>
  .pie__gigante {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 2.5rem;
    font-family: var(--fuente);
    user-select: none;
  }
  .pie {
    overflow: hidden;
    padding-bottom: 0 !important;
    background: var(--tinta);
    color: #c9ccc2;
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) 2rem;
    font-size: var(--t-s);
  }
  .pie a {
    color: inherit;
    text-decoration: none;
  }
  .pie a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pie ul {
    list-style: none;
  }
  .pie__cabeza {
    display: grid;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid #2c3128;
  }
  .pie__marca p {
    margin-top: 1rem;
    max-width: 44ch;
    line-height: 1.6;
  }
  .pie__contacto {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .pie__contacto li {
    min-height: 2rem;
    display: flex;
    align-items: center;
  }
  .pie__contacto a,
  .pie__contacto span {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .pie__contacto :global(.icono) {
    color: var(--platano);
  }
  .pie__columnas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    padding-block: 2.5rem;
  }
  .pie__titulo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    font-weight: 700;
    list-style: none;
  }
  .pie__titulo::-webkit-details-marker {
    display: none;
  }
  .pie__titulo :global(.icono) {
    color: var(--platano);
    transition: transform 0.25s;
  }
  .pie__grupo[open] .pie__titulo :global(.icono) {
    transform: rotate(180deg);
  }
  .pie__grupo ul {
    padding-top: 0.85rem;
  }
  .pie__columnas li + li {
    margin-top: 0.45rem;
  }
  /* Móvil: acordeón con filas táctiles */
  @media (max-width: 799px) {
    .pie__columnas {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: 1rem 2rem;
    }
    .pie__columnas nav {
      border-bottom: 1px solid #2c3128;
    }
    .pie__titulo {
      min-height: 3.25rem;
      cursor: pointer;
    }
    .pie__grupo ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.2rem 1rem;
      padding: 0 0 1.25rem;
    }
    .pie__columnas li + li {
      margin-top: 0;
    }
    .pie__grupo li a {
      display: block;
      padding-block: 0.45rem;
    }
  }
  @media (min-width: 800px) {
    .pie__titulo :global(.icono) {
      display: none;
    }
    .pie__titulo {
      cursor: default;
    }
  }
  .pie__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid #2c3128;
    color: #8f9488;
  }
  .pie__base ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  @media (min-width: 800px) {
    .pie__cabeza {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
