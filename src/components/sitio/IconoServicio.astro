---
/* Icono isométrico de un servicio (objeto sobre baldosa), como SVG independiente. */
interface Props {
  servicio: string;
  tamano?: number;
  class?: string;
}
const { servicio, tamano = 56, class: clase } = Astro.props;
---

<img
  class:list={['icono-servicio', clase]}
  src={`/iso/mini-${servicio}.svg`}
  alt=""
  width={tamano}
  height={tamano}
  loading="lazy"
  decoding="async"
/>

<style>
  .icono-servicio {
    display: block;
    flex: none;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(a:hover) > .icono-servicio,
  :global(a:hover) .icono-servicio {
    transform: translateY(-3px) rotate(-2deg);
  }
</style>
