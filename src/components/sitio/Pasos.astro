---
/* Proceso como una pista con estaciones: una línea que une números grandes y,
   bajo cada uno, el paso. En móvil, la pista es vertical. */
interface Props {
  pasos: { t: string; d: string; cuando?: string }[];
}
const { pasos } = Astro.props;
---

<ol class="pista" style={`--pasos:${pasos.length}`}>
  {pasos.map((p, i) => (
    <li class="estacion" data-aparece style={`transition-delay:${i * 110}ms`}>
      <div class="estacion__marca">
        <span class="estacion__num">{String(i + 1).padStart(2, '0')}</span>
        {p.cuando && <span class="estacion__cuando">{p.cuando}</span>}
      </div>
      <div class="estacion__texto">
        {p.cuando && <span class="estacion__cuando-movil">{p.cuando}</span>}
        <h3>{p.t}</h3>
        <p>{p.d}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .pista {
    position: relative;
    list-style: none;
    display: grid;
    gap: 2rem;
    padding-left: 0;
  }
  .pista::before {
    content: '';
    position: absolute;
    left: 1.9rem;
    top: 1rem;
    bottom: 1rem;
    width: 2px;
    background: repeating-linear-gradient(var(--linea-2) 0 6px, transparent 6px 12px);
  }
  .estacion {
    position: relative;
    display: grid;
    grid-template-columns: 3.8rem 1fr;
    gap: 1.25rem;
  }
  .estacion__marca {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
  }
  .estacion__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3.8rem;
    height: 3.8rem;
    border-radius: 18px;
    background: linear-gradient(165deg, #16724a, var(--verde));
    color: #fff;
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.04em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 4px 0 var(--verde-2), 0 14px 24px -12px rgba(14, 91, 58, 0.55);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1.3);
  }
  .estacion:nth-child(even) .estacion__num {
    background: linear-gradient(165deg, #ffe07a, var(--platano));
    color: var(--tinta);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 4px 0 #d39c12, 0 14px 24px -12px rgba(211, 156, 18, 0.6);
  }
  .estacion:hover .estacion__num {
    transform: translateY(-4px) rotate(-6deg);
  }
  .estacion__cuando {
    display: none;
  }
  .estacion__texto {
    padding: 0.2rem 0 0;
  }
  .estacion__cuando-movil {
    display: block;
    margin-bottom: 0.2rem;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--verde);
  }
  .estacion h3 {
    font-size: var(--t-l);
  }
  .estacion p {
    margin-top: 0.35rem;
    color: var(--tinta-2);
    font-size: var(--t-s);
    max-width: 42ch;
  }

  @media (min-width: 900px) {
    .pista {
      grid-template-columns: repeat(var(--pasos), 1fr);
      gap: 1.5rem;
    }
    .pista::before {
      left: 1.9rem;
      right: 1.9rem;
      top: 1.9rem;
      bottom: auto;
      width: auto;
      height: 2px;
      background: repeating-linear-gradient(90deg, var(--linea-2) 0 6px, transparent 6px 12px);
    }
    .estacion {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .estacion__marca {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .estacion__cuando-movil {
      display: none;
    }
    .estacion__cuando {
      display: inline-block;
      position: relative;
      z-index: 1;
      padding: 0.25rem 0.7rem;
      border-radius: 999px;
      background: var(--superficie);
      border: 1px solid var(--linea);
      font-size: var(--t-xs);
      font-weight: 700;
      color: var(--tinta-2);
    }
  }
</style>
