---
/* Formulario de contacto. Funciona sin JS (POST clásico a /api/contact/ y
   redirección a /success/); con JS envía sin recargar y muestra el resultado
   en la propia página. Preselecciona el servicio con ?servicio=. */
import Icono from './Icono.astro';
import { SERVICIOS } from '../../data/navegacion';

interface Props {
  /** Campos extra (p. ej. la auditoría pide la web y el sector). */
  extra?: { name: string; label: string; tipo?: 'text' | 'url'; placeholder?: string; requerido?: boolean }[];
  boton?: string;
  /** Servicio preseleccionado si no llega por la URL. */
  servicio?: string;
  mensajePlaceholder?: string;
}
const {
  extra = [],
  boton = 'Enviar mensaje',
  servicio = '',
  mensajePlaceholder = 'Qué hace tu negocio, qué te gustaría conseguir y para cuándo. Con tres líneas basta.',
} = Astro.props;

const opciones = [
  ...SERVICIOS.map((s) => ({ valor: s.slug, nombre: s.nombre })),
  { valor: 'plan-360', nombre: 'Plan 360 (web + informática)' },
  { valor: 'auditoria', nombre: 'Auditoría gratuita' },
  { valor: 'otro', nombre: 'Otra cosa / no lo tengo claro' },
];
const plazos = [
  { valor: 'urgente', nombre: 'Lo antes posible' },
  { valor: '1-mes', nombre: 'Este mes' },
  { valor: '1-3-meses', nombre: 'En 1-3 meses' },
  { valor: 'flexible', nombre: 'Sin prisa' },
];
---

<form class="formulario" method="POST" action="/api/contact/" data-formulario novalidate>
  <div class="campo campo--oculto" aria-hidden="true">
    <label>No rellenes este campo <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="rejilla">
    <div class="campo">
      <label for="f-nombre">Nombre <span aria-hidden="true">*</span></label>
      <input id="f-nombre" name="name" type="text" autocomplete="name" required maxlength="120" />
    </div>
    <div class="campo">
      <label for="f-email">Email <span aria-hidden="true">*</span></label>
      <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="160" />
    </div>
    <div class="campo">
      <label for="f-telefono">Teléfono <small>(opcional)</small></label>
      <input id="f-telefono" name="phone" type="tel" autocomplete="tel" maxlength="40" />
    </div>
    <div class="campo">
      <label for="f-empresa">Negocio <small>(opcional)</small></label>
      <input id="f-empresa" name="company" type="text" autocomplete="organization" maxlength="160" />
    </div>
    {extra.map((c) => (
      <div class="campo">
        <label for={`f-${c.name}`}>{c.label} {c.requerido ? <span aria-hidden="true">*</span> : <small>(opcional)</small>}</label>
        <input id={`f-${c.name}`} name={c.name} type={c.tipo ?? 'text'} placeholder={c.placeholder} required={c.requerido} maxlength="300" />
      </div>
    ))}
    <div class="campo">
      <label for="f-servicio">¿En qué te ayudamos?</label>
      <select id="f-servicio" name="service" data-servicio-inicial={servicio}>
        <option value="">Elige una opción</option>
        {opciones.map((o) => <option value={o.valor} selected={o.valor === servicio}>{o.nombre}</option>)}
      </select>
    </div>
    <div class="campo">
      <label for="f-plazo">¿Para cuándo?</label>
      <select id="f-plazo" name="timing">
        {plazos.map((p) => <option value={p.valor} selected={p.valor === 'flexible'}>{p.nombre}</option>)}
      </select>
    </div>
    <div class="campo campo--ancho">
      <label for="f-mensaje">Cuéntanos <span aria-hidden="true">*</span></label>
      <textarea id="f-mensaje" name="message" rows="6" required maxlength="5000" placeholder={mensajePlaceholder}></textarea>
    </div>
  </div>

  <label class="consentimiento">
    <input type="checkbox" name="privacidad" value="si" required />
    <span>He leído y acepto la <a href="/privacidad/" target="_blank">política de privacidad</a>. Usaremos tus datos solo para responderte.</span>
  </label>

  <div class="formulario__pie">
    <button type="submit" class="enviar">
      <span data-texto>{boton}</span>
      <Icono nombre="flecha" tamano={18} />
    </button>
    <p class="formulario__nota"><Icono nombre="reloj" tamano={16} /> Respondemos en menos de 4 horas laborables.</p>
  </div>

  <div class="estado" role="status" aria-live="polite" data-estado hidden></div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-formulario]').forEach((form) => {
    const estado = form.querySelector<HTMLElement>('[data-estado]')!;
    const boton = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const texto = boton.querySelector<HTMLElement>('[data-texto]')!;
    const original = texto.textContent;

    // ?servicio= preselecciona el servicio (enlaces desde cada página).
    const pedido = new URLSearchParams(location.search).get('servicio');
    const select = form.querySelector<HTMLSelectElement>('select[name=service]');
    if (pedido && select && [...select.options].some((o) => o.value === pedido)) select.value = pedido;

    const mostrar = (ok: boolean, mensaje: string) => {
      estado.hidden = false;
      estado.className = `estado ${ok ? 'estado--ok' : 'estado--error'}`;
      estado.textContent = mensaje;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalido = [...form.elements].find(
        (el): el is HTMLInputElement => el instanceof HTMLElement && 'checkValidity' in el && !(el as HTMLInputElement).checkValidity(),
      );
      if (invalido) {
        mostrar(false, invalido.name === 'privacidad'
          ? 'Marca la casilla de privacidad para poder enviarlo.'
          : `Revisa el campo «${form.querySelector(`label[for="${invalido.id}"]`)?.textContent?.replace('*', '').trim() ?? invalido.name}».`);
        invalido.focus();
        return;
      }
      boton.disabled = true;
      texto.textContent = 'Enviando…';
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const j = await r.json().catch(() => ({ ok: false, mensaje: 'No hemos podido enviarlo. Prueba por WhatsApp.' }));
        if (j.ok) {
          form.reset();
          mostrar(true, '¡Recibido! Te respondemos en menos de 4 horas laborables. Si es urgente, llámanos al 657 08 50 19.');
        } else {
          mostrar(false, j.mensaje);
        }
      } catch {
        mostrar(false, 'Sin conexión. Inténtalo de nuevo o escríbenos por WhatsApp.');
      } finally {
        boton.disabled = false;
        texto.textContent = original;
      }
    });
  });
</script>

<style>
  .formulario {
    display: grid;
    gap: 1.5rem;
  }
  .rejilla {
    display: grid;
    gap: 1.1rem 1.25rem;
  }
  @media (min-width: 640px) {
    .rejilla {
      grid-template-columns: 1fr 1fr;
    }
    .campo--ancho {
      grid-column: 1 / -1;
    }
  }
  .campo {
    display: grid;
    gap: 0.4rem;
  }
  .campo--oculto {
    position: absolute;
    left: -9999px;
  }
  label {
    font-weight: 650;
    font-size: var(--t-s);
  }
  label small {
    font-weight: 400;
    color: var(--tenue);
  }
  label span[aria-hidden] {
    color: var(--coral);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--linea-2);
    border-radius: 12px;
    background: var(--superficie);
    color: var(--tinta);
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
    line-height: 1.5;
  }
  input::placeholder,
  textarea::placeholder {
    color: #8a8e83;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--verde);
    box-shadow: 0 0 0 4px var(--verde-suave);
  }
  .consentimiento {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-weight: 400;
    color: var(--tinta-2);
  }
  .consentimiento input {
    width: 1.25rem;
    min-height: 0;
    height: 1.25rem;
    margin-top: 0.15rem;
    padding: 0;
    accent-color: var(--verde);
    flex: none;
  }
  .consentimiento a {
    color: var(--verde);
  }
  .formulario__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .enviar {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0.8rem 1.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--verde);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .enviar:hover {
    background: var(--verde-2);
  }
  .enviar:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .formulario__nota {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-s);
    color: var(--tenue);
  }
  .estado {
    padding: 1rem 1.25rem;
    border-radius: 12px;
    font-weight: 600;
  }
  .estado--ok {
    background: var(--verde-suave);
    color: var(--verde-2);
  }
  .estado--error {
    background: #fde8e2;
    color: #9a2f12;
  }
</style>
