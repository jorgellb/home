---
/* Marca: plátano de vóxeles en isométrico (src/lib/marca.ts) + nombre.
   El plátano se sirve como /favicon.svg: un solo fichero en caché para
   favicon, cabecera y pie. Al pasar el ratón da un salto «a píxeles». */
interface Props {
  tamano?: number;
  claro?: boolean;
}
const { tamano = 34, claro = false } = Astro.props;
---

<span class:list={['logo', { 'logo--claro': claro }]}>
  <img class="logo__marca" src="/favicon.svg" width={tamano} height={tamano} alt="" decoding="async" />
  <span class="logo__nombre">platanito<b>rico</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--tinta);
  }
  .logo__marca {
    display: block;
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .logo .logo__marca,
    .logo:hover .logo__marca {
      animation: salto-pixel 0.5s steps(4) both;
    }
  }
  @keyframes salto-pixel {
    40% {
      transform: translateY(-4px) rotate(-8deg);
    }
    70% {
      transform: translateY(-1px) rotate(3deg);
    }
  }
  .logo__nombre {
    font-weight: 780;
    font-size: 1.2rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .logo__nombre b {
    font-weight: 780;
    color: var(--verde);
  }
  .logo--claro,
  .logo--claro .logo__nombre b {
    color: #fff;
  }
  .logo--claro .logo__nombre b {
    color: var(--platano);
  }
</style>
