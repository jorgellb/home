---
/* Marca: cubo isométrico (cara superior plátano, laterales verdes) + nombre. */
interface Props {
  tamano?: number;
  claro?: boolean;
}
const { tamano = 30, claro = false } = Astro.props;
---

<span class:list={['logo', { 'logo--claro': claro }]}>
  <svg width={tamano} height={tamano} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M16 2 29 9.5 16 17 3 9.5Z" fill="#FFCF3F" />
    <path d="M3 9.5 16 17v13.5L3 23Z" fill="#0E5B3A" />
    <path d="M29 9.5 16 17v13.5L29 23Z" fill="#0A472D" />
    <path d="M16 6.2 21.8 9.5 16 12.8 10.2 9.5Z" fill="#FFF4CC" />
  </svg>
  <span class="logo__nombre">platanito<b>rico</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--tinta);
  }
  .logo__nombre {
    font-weight: 780;
    font-size: 1.2rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .logo__nombre b {
    font-weight: 780;
    color: var(--verde);
  }
  .logo--claro,
  .logo--claro .logo__nombre b {
    color: #fff;
  }
  .logo--claro .logo__nombre b {
    color: var(--platano);
  }
</style>
