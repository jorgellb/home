---

<!-- ════════════════════════════════════════════════════════ -->
<!-- BANNER PRINCIPAL DE COOKIES -->
<!-- ════════════════════════════════════════════════════════ -->
<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[9999] opacity-0 translate-y-full pointer-events-none transition-[opacity,transform] duration-500 ease-out">
  <!-- Backdrop blur overlay -->
  <div class="absolute inset-0 -top-20 bg-gradient-to-t from-black/30 to-transparent pointer-events-none"></div>

  <div class="relative max-w-3xl mx-auto px-4 pb-4 sm:pb-6">
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-white border border-slate-200 shadow-[0_-10px_60px_rgba(0,0,0,0.15)]">
      <!-- Barra superior decorativa -->
      <div class="h-1 bg-gradient-to-r from-orange-500 via-amber-400 to-orange-500"></div>

      <div class="p-5 sm:p-8">
        <!-- Header -->
        <div class="flex items-start gap-4 mb-5">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-orange-500 to-amber-500 flex items-center justify-center flex-shrink-0 shadow-lg shadow-orange-500/20">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">Respetamos tu privacidad</h3>
            <p class="text-xs text-slate-500 mt-0.5">Configuración de cookies — RGPD / LOPDGDD / LSSI-CE</p>
          </div>
        </div>

        <!-- Descripción -->
        <p class="text-sm text-slate-600 leading-relaxed mb-6">
          Utilizamos cookies propias técnicas (necesarias para el funcionamiento) y podemos utilizar cookies analíticas para mejorar tu experiencia.
          Puedes aceptar todas, rechazar las no esenciales, o configurarlas a tu medida.
          Más información en nuestra <a href="/cookies/" class="text-orange-600 hover:text-orange-700 underline underline-offset-2 font-medium transition-colors">Política de Cookies</a>.
        </p>

        <!-- Botones principales -->
        <div class="flex flex-col sm:flex-row gap-3 mb-3">
          <button id="cookie-accept-all" class="flex-1 px-5 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold shadow-lg shadow-orange-500/20 hover:shadow-xl hover:shadow-orange-500/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
            Aceptar todas
          </button>
          <button id="cookie-reject-all" class="flex-1 px-5 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-700 text-sm font-semibold hover:bg-slate-200 hover:text-slate-900 active:translate-y-0 transition-all duration-200">
            Rechazar no esenciales
          </button>
        </div>

        <!-- Botones secundarios -->
        <div class="flex flex-col sm:flex-row gap-3">
          <button id="cookie-essential-only" class="flex-1 px-5 py-2.5 rounded-xl text-slate-500 text-sm font-medium hover:text-slate-700 hover:bg-slate-50 transition-all duration-200 border border-transparent hover:border-slate-200">
            Solo cookies necesarias
          </button>
          <button id="cookie-configure" class="flex-1 px-5 py-2.5 rounded-xl text-slate-500 text-sm font-medium hover:text-orange-600 hover:bg-orange-50 transition-all duration-200 border border-transparent hover:border-orange-200 flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Configurar cookies
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════ -->
<!-- PANEL DE CONFIGURACIÓN GRANULAR -->
<!-- ════════════════════════════════════════════════════════ -->
<div id="cookie-settings" class="fixed inset-0 z-[10000] hidden">
  <!-- Overlay -->
  <div id="cookie-settings-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

  <!-- Modal -->
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="relative w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl sm:rounded-3xl bg-white border border-slate-200 shadow-2xl">
      <!-- Header -->
      <div class="sticky top-0 bg-white border-b border-slate-100 px-6 py-5 rounded-t-2xl sm:rounded-t-3xl z-10">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange-500 to-amber-500 flex items-center justify-center shadow-lg shadow-orange-500/20">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-900">Configuración de cookies</h3>
              <p class="text-xs text-slate-500">Elige qué cookies aceptas</p>
            </div>
          </div>
          <button id="cookie-settings-close" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors" aria-label="Cerrar configuración de cookies">
            <svg class="w-5 h-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Contenido -->
      <div class="px-6 py-5 space-y-5">
        <p class="text-sm text-slate-600 leading-relaxed">
          Aquí puedes gestionar tus preferencias de cookies. Las cookies necesarias no se pueden desactivar porque son imprescindibles para el funcionamiento del sitio.
          Más información en nuestra <a href="/cookies/" class="text-orange-600 hover:text-orange-700 underline underline-offset-2 font-medium">Política de Cookies</a>.
        </p>

        <!-- Cookie necesaria (siempre activa) -->
        <div class="p-5 rounded-2xl border border-slate-200 bg-slate-50/50">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
              </div>
              <h4 class="text-sm font-bold text-slate-900">Cookies necesarias</h4>
            </div>
            <span class="px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">Siempre activas</span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Imprescindibles para que el sitio funcione correctamente. Incluyen la cookie de preferencias de cookies y las de sesión del servidor. No recopilan datos personales. Base legal: interés legítimo (Art. 22.2 LSSI-CE).
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="px-2 py-1 rounded-md bg-white border border-slate-200 text-xs text-slate-600">cookies_consent</span>
            <span class="px-2 py-1 rounded-md bg-white border border-slate-200 text-xs text-slate-600">session_id</span>
          </div>
        </div>

        <!-- Cookie analítica (toggle) -->
        <div class="p-5 rounded-2xl border border-slate-200 hover:border-orange-200 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
              </div>
              <h4 class="text-sm font-bold text-slate-900">Cookies analíticas</h4>
            </div>
            <!-- Toggle switch -->
            <button id="toggle-analytics" role="switch" aria-checked="false" class="relative w-12 h-7 rounded-full bg-slate-200 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2" aria-label="Activar o desactivar cookies analíticas">
              <span class="absolute top-0.5 left-0.5 w-6 h-6 rounded-full bg-white shadow-md transition-transform duration-200"></span>
            </button>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Nos ayudan a entender cómo navegas por la web para mejorar la experiencia. No identifican personalmente al usuario. Actualmente no utilizamos cookies analíticas de terceros, pero nos reservamos el derecho de implementarlas en el futuro (p.ej. Google Analytics con IP anonimizada). Base legal: consentimiento (Art. 6.1.a RGPD).
          </p>
        </div>

        <!-- Cookie de marketing (toggle) -->
        <div class="p-5 rounded-2xl border border-slate-200 hover:border-orange-200 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-purple-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46" />
                </svg>
              </div>
              <h4 class="text-sm font-bold text-slate-900">Cookies de marketing</h4>
            </div>
            <!-- Toggle switch -->
            <button id="toggle-marketing" role="switch" aria-checked="false" class="relative w-12 h-7 rounded-full bg-slate-200 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2" aria-label="Activar o desactivar cookies de marketing">
              <span class="absolute top-0.5 left-0.5 w-6 h-6 rounded-full bg-white shadow-md transition-transform duration-200"></span>
            </button>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Permiten mostrar publicidad personalizada basada en tu navegación. Actualmente no utilizamos cookies de marketing ni píxeles de seguimiento (Facebook Pixel, Google Ads, etc.). Si las implementamos en el futuro, necesitaremos tu consentimiento previo. Base legal: consentimiento (Art. 6.1.a RGPD).
          </p>
        </div>
      </div>

      <!-- Footer del modal -->
      <div class="sticky bottom-0 bg-white border-t border-slate-100 px-6 py-5 rounded-b-2xl sm:rounded-b-3xl">
        <div class="flex flex-col sm:flex-row gap-3">
          <button id="cookie-save-settings" class="flex-1 px-5 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 text-white text-sm font-semibold shadow-lg shadow-orange-500/20 hover:shadow-xl transition-all duration-200">
            Guardar preferencias
          </button>
          <button id="cookie-accept-all-settings" class="flex-1 px-5 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-700 text-sm font-semibold hover:bg-slate-200 transition-all duration-200">
            Aceptar todas
          </button>
        </div>
        <p class="text-[10px] text-slate-400 text-center mt-3 leading-relaxed">
          Puedes modificar tus preferencias en cualquier momento desde el enlace "Cookies" en el pie de página.
          Responsable: Jorge Luis López Barrio — <a href="/privacidad/" class="underline hover:text-slate-600">Política de Privacidad</a>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════ -->
<!-- BOTÓN FLOTANTE para reabrir configuración -->
<!-- ════════════════════════════════════════════════════════ -->
<button id="cookie-reopen" class="fixed bottom-5 left-5 z-[9998] w-10 h-10 rounded-full bg-white border border-slate-200 shadow-lg hover:shadow-xl hover:border-orange-300 transition-all duration-300 hidden items-center justify-center group" aria-label="Configurar cookies">
  <svg class="w-5 h-5 text-slate-400 group-hover:text-orange-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
  </svg>
</button>

<script>
  // ── Elements ──
  const banner = document.getElementById('cookie-banner');
  const settings = document.getElementById('cookie-settings');
  const settingsOverlay = document.getElementById('cookie-settings-overlay');
  const reopenBtn = document.getElementById('cookie-reopen');

  // Banner buttons
  const btnAcceptAll = document.getElementById('cookie-accept-all');
  const btnRejectAll = document.getElementById('cookie-reject-all');
  const btnEssentialOnly = document.getElementById('cookie-essential-only');
  const btnConfigure = document.getElementById('cookie-configure');

  // Settings buttons
  const btnCloseSettings = document.getElementById('cookie-settings-close');
  const btnSaveSettings = document.getElementById('cookie-save-settings');
  const btnAcceptAllSettings = document.getElementById('cookie-accept-all-settings');

  // Toggles
  const toggleAnalytics = document.getElementById('toggle-analytics') as HTMLButtonElement;
  const toggleMarketing = document.getElementById('toggle-marketing') as HTMLButtonElement;

  const CONSENT_KEY = 'platanito_cookie_consent';

  // ── Types ──
  interface CookieConsent {
    necessary: boolean;
    analytics: boolean;
    marketing: boolean;
    timestamp: string;
  }

  // ── Toggle UI ──
  function updateToggle(btn: HTMLButtonElement, active: boolean) {
    const knob = btn.querySelector('span');
    if (active) {
      btn.classList.remove('bg-slate-200');
      btn.classList.add('bg-orange-500');
      btn.setAttribute('aria-checked', 'true');
      knob?.classList.add('translate-x-5');
      knob?.classList.remove('translate-x-0');
    } else {
      btn.classList.add('bg-slate-200');
      btn.classList.remove('bg-orange-500');
      btn.setAttribute('aria-checked', 'false');
      knob?.classList.remove('translate-x-5');
      knob?.classList.add('translate-x-0');
    }
  }

  // ── Banner show/hide ──
  function showBanner() {
    banner?.classList.remove('opacity-0', 'translate-y-full', 'pointer-events-none');
    banner?.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
    reopenBtn?.classList.add('hidden');
    reopenBtn?.classList.remove('flex');
  }

  function hideBanner() {
    banner?.classList.add('opacity-0', 'translate-y-full', 'pointer-events-none');
    banner?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
    reopenBtn?.classList.remove('hidden');
    reopenBtn?.classList.add('flex');
  }

  // ── Settings panel show/hide ──
  function showSettings() {
    settings?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function hideSettings() {
    settings?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // ── Save consent ──
  function saveConsent(consent: CookieConsent) {
    localStorage.setItem(CONSENT_KEY, JSON.stringify(consent));
    hideBanner();
    hideSettings();

    // Apply consent (future: load analytics/marketing scripts here)
    if (consent.analytics) {
      // Placeholder: load analytics when implemented
    }
    if (consent.marketing) {
      // Placeholder: load marketing scripts when implemented
    }
  }

  // ── Get current toggle states ──
  function getToggles(): CookieConsent {
    return {
      necessary: true, // Always true
      analytics: toggleAnalytics?.getAttribute('aria-checked') === 'true',
      marketing: toggleMarketing?.getAttribute('aria-checked') === 'true',
      timestamp: new Date().toISOString()
    };
  }

  // ── Init: check existing consent ──
  const existing = localStorage.getItem(CONSENT_KEY);
  if (!existing) {
    setTimeout(showBanner, 1500);
  } else {
    // Show reopen button for users who already consented
    reopenBtn?.classList.remove('hidden');
    reopenBtn?.classList.add('flex');
  }

  // ── Banner button handlers ──
  btnAcceptAll?.addEventListener('click', () => {
    saveConsent({ necessary: true, analytics: true, marketing: true, timestamp: new Date().toISOString() });
  });

  btnRejectAll?.addEventListener('click', () => {
    saveConsent({ necessary: true, analytics: false, marketing: false, timestamp: new Date().toISOString() });
  });

  btnEssentialOnly?.addEventListener('click', () => {
    saveConsent({ necessary: true, analytics: false, marketing: false, timestamp: new Date().toISOString() });
  });

  btnConfigure?.addEventListener('click', () => {
    hideBanner();
    // Restore toggle states from existing consent
    const stored = localStorage.getItem(CONSENT_KEY);
    if (stored) {
      try {
        const parsed: CookieConsent = JSON.parse(stored);
        updateToggle(toggleAnalytics, parsed.analytics);
        updateToggle(toggleMarketing, parsed.marketing);
      } catch {}
    } else {
      updateToggle(toggleAnalytics, false);
      updateToggle(toggleMarketing, false);
    }
    showSettings();
  });

  // ── Settings button handlers ──
  btnCloseSettings?.addEventListener('click', () => {
    hideSettings();
    // If no consent saved yet, show banner again
    if (!localStorage.getItem(CONSENT_KEY)) {
      showBanner();
    }
  });

  settingsOverlay?.addEventListener('click', () => {
    hideSettings();
    if (!localStorage.getItem(CONSENT_KEY)) {
      showBanner();
    }
  });

  btnSaveSettings?.addEventListener('click', () => {
    saveConsent(getToggles());
  });

  btnAcceptAllSettings?.addEventListener('click', () => {
    saveConsent({ necessary: true, analytics: true, marketing: true, timestamp: new Date().toISOString() });
  });

  // ── Toggle handlers ──
  toggleAnalytics?.addEventListener('click', () => {
    const current = toggleAnalytics.getAttribute('aria-checked') === 'true';
    updateToggle(toggleAnalytics, !current);
  });

  toggleMarketing?.addEventListener('click', () => {
    const current = toggleMarketing.getAttribute('aria-checked') === 'true';
    updateToggle(toggleMarketing, !current);
  });

  // ── Reopen button ──
  reopenBtn?.addEventListener('click', () => {
    const stored = localStorage.getItem(CONSENT_KEY);
    if (stored) {
      try {
        const parsed: CookieConsent = JSON.parse(stored);
        updateToggle(toggleAnalytics, parsed.analytics);
        updateToggle(toggleMarketing, parsed.marketing);
      } catch {}
    }
    showSettings();
  });
</script>
