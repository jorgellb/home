---
const services = [
  { href: '/desarrollo-web',  num: '01', label: 'Web',          desc: 'Webs que venden' },
  { href: '/diseno-grafico',  num: '02', label: 'Diseño',       desc: 'Identidad visual' },
  { href: '/marketing',       num: '03', label: 'Marketing',    desc: 'Crecimiento' },
  { href: '/audiovisual',     num: '04', label: 'Audiovisual',  desc: 'Vídeo & foto' },
  { href: '/soporte',         num: '05', label: 'Soporte',      desc: 'Siempre seguro' },
];
---

<div class="quick-services" id="quick-services">
  <button
    id="quick-services-toggle"
    class="quick-services__fab"
    aria-label="Servicios rápidos"
    aria-expanded="false"
  >
    <span class="quick-services__fab-icon" aria-hidden="true">★</span>
    <span class="quick-services__fab-label">Servicios</span>
  </button>

  <div id="quick-services-menu" class="quick-services__menu" role="menu">
    <header class="quick-services__head">
      <span class="text-meta">Menú rápido</span>
      <span class="text-meta">5 disciplinas</span>
    </header>
    {services.map((s) => (
      <a href={s.href} class="quick-services__item" role="menuitem">
        <span class="quick-services__num text-mono">{s.num}</span>
        <span class="quick-services__text">
          <span class="quick-services__label">{s.label}</span>
          <span class="quick-services__desc">{s.desc}</span>
        </span>
        <span class="quick-services__arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</div>

<style>
  .quick-services {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 45;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: .75rem;
    pointer-events: none;
  }
  @media (max-width: 1023px) { .quick-services { display: none; } }

  .quick-services__fab {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--brutal-ink);
    color: var(--brutal-lime);
    border: 2px solid var(--brutal-ink);
    box-shadow: 4px 4px 0 0 var(--brutal-accent);
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .15em;
    cursor: pointer;
    transition: transform .15s, box-shadow .15s;
  }
  .quick-services__fab:hover { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 0 var(--brutal-accent); }
  .quick-services__fab-icon {
    display: inline-flex;
    width: 22px; height: 22px;
    align-items: center; justify-content: center;
    background: var(--brutal-accent);
    color: var(--brutal-ink);
    font-size: 1rem;
    transition: transform .35s;
  }
  .quick-services.is-open .quick-services__fab-icon { transform: rotate(180deg); background: var(--brutal-lime); color: var(--brutal-ink); }

  .quick-services__menu {
    pointer-events: none;
    display: flex;
    flex-direction: column;
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    box-shadow: 6px 6px 0 0 var(--brutal-ink);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .25s, transform .25s;
    min-width: 240px;
  }
  .quick-services.is-open .quick-services__menu {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }
  .quick-services__head {
    display: flex; justify-content: space-between;
    padding: .65rem .9rem;
    background: var(--brutal-ink);
    color: var(--brutal-bg);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .quick-services__head .text-meta { color: var(--brutal-bg-alt); }

  .quick-services__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: .75rem;
    align-items: center;
    padding: .65rem .9rem;
    text-decoration: none;
    color: var(--brutal-ink);
    border-bottom: 1px solid var(--brutal-border-soft);
    transition: background .15s, padding .15s;
  }
  .quick-services__item:last-child { border-bottom: 0; }
  .quick-services__item:hover { background: var(--brutal-lime-soft); padding-left: 1.1rem; }
  .quick-services__item:hover .quick-services__arrow { transform: translateX(3px); color: var(--brutal-accent); }
  .quick-services__num { color: var(--brutal-accent); font-size: .75rem; font-weight: 700; }
  .quick-services__text { display: flex; flex-direction: column; line-height: 1.15; }
  .quick-services__label { font-family: var(--font-display); font-weight: 700; font-size: .95rem; }
  .quick-services__desc { font-family: var(--font-mono); font-size: .6rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); margin-top: .15rem; }
  .quick-services__arrow { font-family: var(--font-mono); transition: transform .2s, color .2s; }
</style>

<script>
  const toggle = document.getElementById('quick-services-toggle');
  const root = document.getElementById('quick-services');
  toggle?.addEventListener('click', () => {
    const open = root?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  document.addEventListener('click', (e) => {
    if (!root?.contains(e.target as Node)) {
      root?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      root?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
