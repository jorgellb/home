---
/* Compatibilidad: el clúster /programador-web/ sigue pasando items con
   { label, href } e «Inicio» como primer elemento. Se pintan con Migas. */
import Migas from '../sitio/Migas.astro';

interface Props {
  items: { label: string; href?: string }[];
  tono?: string;
  jsonLd?: boolean;
}
const { items } = Astro.props;
const sinInicio = items.filter((it, i) => !(i === 0 && it.href === '/'));
---

<div class="contenedor migas-pw"><Migas items={sinInicio.map((it) => ({ nombre: it.label, href: it.href }))} /></div>

<style>
  .migas-pw {
    padding-top: 1.5rem;
  }
</style>
