---
const navLinks = [
  { num: '01', href: '/desarrollo-web', label: 'Web' },
  { num: '02', href: '/audiovisual',     label: 'Audiovisual' },
  { num: '03', href: '/marketing',       label: 'Marketing' },
  { num: '04', href: '/diseno-grafico',  label: 'Diseño' },
  { num: '05', href: '/soporte',         label: 'Soporte' },
  { num: '06', href: '/blog',            label: 'Blog' },
];
const currentPath = Astro.url.pathname;
---

<header class="brutal-header" data-header>
  <div class="brutal-header__inner container-brutal">
    <a href="/" class="brutal-logo" aria-label="Platanito Rico — Inicio">
      <span class="brutal-logo__mark" aria-hidden="true">P★</span>
      <span class="brutal-logo__word">
        <span class="brutal-logo__line1">PLATANITO</span>
        <span class="brutal-logo__line2">/ rico — estudio</span>
      </span>
    </a>

    <nav class="brutal-nav" aria-label="Principal">
      {navLinks.map(link => {
        const active = currentPath === link.href || currentPath.startsWith(link.href + '/');
        return (
          <a href={link.href} class={`brutal-nav__link${active ? ' is-active' : ''}`}>
            <span class="brutal-nav__num">{link.num}</span>
            <span class="brutal-nav__label">{link.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="brutal-header__cta">
      <a href="/contacto" class="btn-brutal btn-brutal--sm">
        <span class="live-dot" aria-hidden="true"></span>
        Hablemos
      </a>

      <button
        id="menuBtn"
        class="brutal-burger"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<aside
  id="mobileMenu"
  class="brutal-drawer"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
>
  <div class="brutal-drawer__backdrop" data-menu-backdrop></div>
  <div class="brutal-drawer__panel">
    <div class="brutal-drawer__head">
      <span class="text-meta">Índice / Menú</span>
      <span class="text-meta">2026 · ALM</span>
    </div>
    <nav class="brutal-drawer__nav">
      {navLinks.map(link => (
        <a href={link.href} class="brutal-drawer__link mobile-nav-link">
          <span class="brutal-drawer__num">{link.num}</span>
          <span class="brutal-drawer__label">{link.label}</span>
          <span class="brutal-drawer__arrow">→</span>
        </a>
      ))}
    </nav>
    <div class="brutal-drawer__foot">
      <a href="/contacto" class="btn-brutal btn-brutal--lg w-full" data-menu-link>
        Empezar proyecto
      </a>
      <p class="text-meta mt-6">Llamar · <a href="tel:+34657085019" class="link-brutal" data-menu-link>+34 657 085 019</a></p>
    </div>
  </div>
</aside>

<style>
  .brutal-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(245, 241, 234, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .brutal-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    height: 78px;
    gap: 2rem;
  }
  .brutal-logo {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    text-decoration: none;
    color: var(--brutal-ink);
  }
  .brutal-logo__mark {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--brutal-ink);
    color: var(--brutal-lime);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: .9rem;
    border: 2px solid var(--brutal-ink);
    transition: transform .2s;
  }
  .brutal-logo:hover .brutal-logo__mark { transform: rotate(-6deg); background: var(--brutal-accent); color: var(--brutal-ink); }
  .brutal-logo__word { display: flex; flex-direction: column; line-height: 1; }
  .brutal-logo__line1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .brutal-logo__line2 {
    font-family: var(--font-mono);
    font-size: .58rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--brutal-text-muted);
    margin-top: .15rem;
  }

  .brutal-nav {
    display: none;
    justify-content: center;
    gap: .25rem;
  }
  @media (min-width: 1024px) {
    .brutal-nav { display: flex; }
  }
  .brutal-nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: .35rem;
    padding: .5rem .75rem;
    text-decoration: none;
    color: var(--brutal-ink);
    font-family: var(--font-body);
    font-size: .9rem;
    font-weight: 500;
    border: 1.5px solid transparent;
    transition: border-color .15s, background .15s, color .15s;
  }
  .brutal-nav__link:hover { border-color: var(--brutal-ink); background: var(--brutal-card); }
  .brutal-nav__link.is-active { background: var(--brutal-ink); color: var(--brutal-lime); border-color: var(--brutal-ink); }
  .brutal-nav__num {
    font-family: var(--font-mono);
    font-size: .58rem;
    letter-spacing: .15em;
    color: var(--brutal-text-muted);
    text-transform: uppercase;
  }
  .brutal-nav__link.is-active .brutal-nav__num { color: var(--brutal-lime); opacity: .7; }
  .brutal-nav__label { letter-spacing: -.01em; }

  .brutal-header__cta {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
  }
  .brutal-header__cta .btn-brutal { display: none; }
  @media (min-width: 768px) {
    .brutal-header__cta .btn-brutal { display: inline-flex; }
  }

  .brutal-burger {
    width: 44px;
    height: 44px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    cursor: pointer;
    padding: 0;
    box-shadow: 3px 3px 0 0 var(--brutal-ink);
    transition: transform .15s, box-shadow .15s;
  }
  .brutal-burger:hover { transform: translate(-1px,-1px); box-shadow: 4px 4px 0 0 var(--brutal-ink); }
  .brutal-burger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--brutal-ink);
    transition: transform .25s, opacity .25s;
  }
  .brutal-burger.is-open span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .brutal-burger.is-open span:nth-child(2) { opacity: 0; }
  .brutal-burger.is-open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
  @media (min-width: 1024px) {
    .brutal-burger { display: none; }
  }

  /* ─── Drawer ─── */
  .brutal-drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    visibility: hidden;
  }
  .brutal-drawer.is-open {
    pointer-events: auto;
    visibility: visible;
  }
  .brutal-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(14, 13, 11, 0.72);
    opacity: 0;
    transition: opacity .35s;
  }
  .brutal-drawer.is-open .brutal-drawer__backdrop { opacity: 1; }
  .brutal-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(92vw, 480px);
    background: var(--brutal-card);
    border-left: 3px solid var(--brutal-ink);
    transform: translateX(100%);
    transition: transform .45s cubic-bezier(.16,1,.3,1);
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem 2rem;
    overflow-y: auto;
  }
  .brutal-drawer.is-open .brutal-drawer__panel { transform: translateX(0); }
  .brutal-drawer__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--brutal-ink);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }
  .brutal-drawer__nav { display: flex; flex-direction: column; }
  .brutal-drawer__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 0;
    text-decoration: none;
    color: var(--brutal-ink);
    border-bottom: 1px solid var(--brutal-border-soft);
    transition: padding .2s, background .2s;
  }
  .brutal-drawer__link:hover { padding-inline: .75rem; background: var(--brutal-bg-alt); }
  .brutal-drawer__link:hover .brutal-drawer__arrow { transform: translateX(4px); color: var(--brutal-accent); }
  .brutal-drawer__num {
    font-family: var(--font-mono);
    font-size: .65rem;
    color: var(--brutal-text-muted);
    letter-spacing: .2em;
  }
  .brutal-drawer__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .brutal-drawer__arrow {
    font-family: var(--font-mono);
    color: var(--brutal-ink);
    transition: transform .25s, color .2s;
  }
  .brutal-drawer__foot {
    margin-top: auto;
    padding-top: 2rem;
  }
</style>

<script>
  const menuBtn = document.getElementById('menuBtn');
  const drawer = document.getElementById('mobileMenu');
  const backdrop = drawer?.querySelector('[data-menu-backdrop]');
  const links = drawer?.querySelectorAll('[data-menu-link], .mobile-nav-link');

  function setOpen(open: boolean) {
    if (!drawer || !menuBtn) return;
    drawer.classList.toggle('is-open', open);
    drawer.setAttribute('aria-hidden', String(!open));
    menuBtn.classList.toggle('is-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  menuBtn?.addEventListener('click', () => {
    setOpen(!drawer?.classList.contains('is-open'));
  });
  backdrop?.addEventListener('click', () => setOpen(false));
  links?.forEach(l => l.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('is-open')) setOpen(false);
  });
</script>
