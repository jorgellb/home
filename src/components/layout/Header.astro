---
const navLinks = [
  { num: '01', href: '/desarrollo-web', label: 'Web',          meta: 'Diseño + desarrollo' },
  { num: '02', href: '/audiovisual',    label: 'Audiovisual',  meta: 'Dron + vídeo · 4K' },
  { num: '03', href: '/marketing',      label: 'Marketing',    meta: 'SEO + SEM + ads' },
  { num: '04', href: '/diseno-grafico', label: 'Diseño',       meta: 'Branding + print' },
  { num: '05', href: '/soporte',        label: 'Soporte',      meta: 'Mantenimiento 24/7' },
  { num: '06', href: '/blog',           label: 'Blog',         meta: 'Diario · tecnología' },
];

const solutionLinks = [
  { href: '/soluciones/emprendedor', label: 'Emprendedores', meta: 'Lanza tu negocio' },
  { href: '/soluciones/empresa',     label: 'Empresas',      meta: 'Escala tu marca' },
  { href: '/soluciones/ecommerce',   label: 'E-commerce',    meta: 'Tienda online' },
  { href: '/soluciones/agencia',     label: 'Agencias',      meta: 'White-label' },
];

const legalLinks = [
  { href: '/privacidad',           label: 'Privacidad' },
  { href: '/terminos-condiciones', label: 'Términos' },
  { href: '/cookies',              label: 'Cookies' },
  { href: '/aviso-legal',          label: 'Aviso legal' },
];

const currentPath = Astro.url.pathname;
const today = new Date();
const dateStr = today.toLocaleDateString('es-ES', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
---

<header class="brutal-header" data-header>
  <div class="brutal-header__inner container-brutal">
    <a href="/" class="brutal-logo" aria-label="Platanito Rico — Inicio">
      <span class="brutal-logo__mark" aria-hidden="true">P★</span>
      <span class="brutal-logo__word">
        <span class="brutal-logo__line1">PLATANITO</span>
        <span class="brutal-logo__line2">/ rico — estudio</span>
      </span>
    </a>

    <nav class="brutal-nav" aria-label="Principal">
      {navLinks.map(link => {
        const active = currentPath === link.href || currentPath.startsWith(link.href + '/');
        return (
          <a href={link.href} class={`brutal-nav__link${active ? ' is-active' : ''}`}>
            <span class="brutal-nav__num">{link.num}</span>
            <span class="brutal-nav__label">{link.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="brutal-header__cta">
      <a href="/contacto" class="btn-brutal btn-brutal--sm">
        <span class="live-dot" aria-hidden="true"></span>
        Hablemos
      </a>

      <button
        id="menuBtn"
        class="brutal-burger"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span class="brutal-burger__bars" aria-hidden="true">
          <span class="brutal-burger__bar"></span>
          <span class="brutal-burger__bar"></span>
          <span class="brutal-burger__bar"></span>
        </span>
        <span class="brutal-burger__txt">MENÚ</span>
      </button>
    </div>
  </div>
</header>

<aside
  id="mobileMenu"
  class="md"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
>
  <div class="md__backdrop" data-menu-backdrop></div>

  <div class="md__panel">

    {/* Decoración fondo */}
    <div class="md__bg" aria-hidden="true">
      <svg viewBox="0 0 400 600" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
        <defs>
          <pattern id="md-dots" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.2" fill="rgba(14,13,11,0.08)"/>
          </pattern>
        </defs>
        <rect width="400" height="600" fill="url(#md-dots)"/>
      </svg>
    </div>

    {/* HEAD: índice + fecha + close */}
    <header class="md__head">
      <div class="md__head-l">
        <span class="md__head-num text-mono">N.º 027</span>
        <span class="md__head-date text-mono">{dateStr}</span>
      </div>
      <button id="menuClose" class="md__close" aria-label="Cerrar menú">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    {/* TITULAR ÍNDICE */}
    <div class="md__title-row">
      <h2 class="md__title">
        <span>★</span>
        <span class="md__title-em">Índice</span>
      </h2>
      <span class="md__title-meta text-mono"><span class="md-pulse"></span> EN VIVO</span>
    </div>

    {/* Decorative rotating star */}
    <div class="md__deco" aria-hidden="true">
      <svg viewBox="0 0 80 80" width="100%" height="100%">
        <defs>
          <path id="md-arc" d="M40,40 m-32,0 a32,32 0 1,1 64,0 a32,32 0 1,1 -64,0"/>
        </defs>
        <g class="md-spin">
          <text font-family="monospace" font-size="8" font-weight="bold" fill="currentColor" letter-spacing="3">
            <textPath href="#md-arc" startOffset="0%">★ PLATANITO RICO · 2026 · ALMERÍA ★</textPath>
          </text>
        </g>
        <text x="40" y="48" text-anchor="middle" font-family="serif" font-size="22" font-weight="bold" fill="currentColor">P★</text>
      </svg>
    </div>

    {/* NAV principal */}
    <nav class="md__nav md__nav--main" aria-label="Servicios">
      {navLinks.map((link, i) => {
        const active = currentPath === link.href || currentPath.startsWith(link.href + '/');
        return (
          <a
            href={link.href}
            class={`md-link mobile-nav-link${active ? ' is-active' : ''}`}
            style={`--md-i:${i}`}
          >
            <span class="md-link__num text-mono">{link.num}</span>
            <span class="md-link__body">
              <span class="md-link__label">{link.label}</span>
              <span class="md-link__meta text-mono">{link.meta}</span>
            </span>
            <span class="md-link__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        );
      })}
    </nav>

    {/* SECCIÓN: Soluciones */}
    <div class="md__divider">
      <span></span>
      <span class="md__divider-txt text-mono">★ SOLUCIONES ★</span>
      <span></span>
    </div>

    <nav class="md__nav md__nav--sub" aria-label="Soluciones">
      {solutionLinks.map((link, i) => (
        <a
          href={link.href}
          class="md-sub mobile-nav-link"
          style={`--md-i:${i+6}`}
        >
          <span class="md-sub__label">{link.label}</span>
          <span class="md-sub__meta text-mono">{link.meta}</span>
          <span class="md-sub__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>

    {/* CTA CARD */}
    <div class="md__cta">
      <div class="md__cta-head">
        <span class="text-mono md__cta-lbl"><span class="md-pulse"></span> ACEPTANDO PROYECTOS</span>
        <span class="text-mono md__cta-num">2026</span>
      </div>
      <p class="md__cta-title">
        ¿Empezamos
        <em>esta semana?</em>
      </p>
      <a href="/contacto" class="md__cta-btn" data-menu-link>
        Empezar proyecto
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      {/* Contact direct buttons */}
      <div class="md__contact">
        <a href="https://wa.me/34657085019" target="_blank" rel="noopener noreferrer" class="md__contact-btn md__contact-btn--wa" data-menu-link>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.5C8.4 21.5 10.2 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm5.2 14.2c-.3.6-1.4 1.2-1.9 1.3-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-5-4.3-5.1-4.5-.2-.2-1.3-1.7-1.3-3.2 0-1.5.8-2.3 1.1-2.6.3-.3.6-.4.8-.4h.6c.2 0 .5 0 .7.5l1 2.4c.1.2.1.4 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.4.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.3.1 1.9.9 2.2 1 .3.1.5.2.6.3.1.2.1.6-.1 1.2z" fill="currentColor"/></svg>
          <span>WhatsApp</span>
        </a>
        <a href="tel:+34657085019" class="md__contact-btn" data-menu-link>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>657 085 019</span>
        </a>
      </div>
    </div>

    {/* LEGAL mini-links */}
    <div class="md__divider">
      <span></span>
      <span class="md__divider-txt text-mono">LEGAL</span>
      <span></span>
    </div>
    <nav class="md__legal" aria-label="Legal">
      {legalLinks.map((link, i) => (
        <a
          href={link.href}
          class="md-legal-link mobile-nav-link"
          style={`--md-i:${i+10}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    {/* FOOT — colofón mini */}
    <footer class="md__foot">
      <span class="text-mono">★ Platanito Rico · Vera · Almería · ES</span>
      <span class="text-mono">EST. MMXVIII · TODOS LOS DERECHOS RESERVADOS</span>
    </footer>
  </div>
</aside>

<style>
  .brutal-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(245, 241, 234, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .brutal-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    height: 78px;
    gap: 1rem;
  }
  @media (min-width: 768px) { .brutal-header__inner { gap: 2rem; } }
  .brutal-logo {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    text-decoration: none;
    color: var(--brutal-ink);
    min-width: 0;
  }
  .brutal-logo__mark {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--brutal-ink);
    color: var(--brutal-lime);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: .9rem;
    border: 2px solid var(--brutal-ink);
    transition: transform .2s;
    flex-shrink: 0;
  }
  .brutal-logo:hover .brutal-logo__mark { transform: rotate(-6deg); background: var(--brutal-accent); color: var(--brutal-ink); }
  .brutal-logo__word { display: flex; flex-direction: column; line-height: 1; min-width: 0; }
  .brutal-logo__line1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brutal-logo__line2 {
    font-family: var(--font-mono);
    font-size: .58rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--brutal-text-muted);
    margin-top: .15rem;
    white-space: nowrap;
  }
  @media (max-width: 420px) {
    .brutal-logo__line2 { display: none; }
  }

  .brutal-nav {
    display: none;
    justify-content: center;
    gap: .25rem;
  }
  @media (min-width: 1024px) {
    .brutal-nav { display: flex; }
  }
  .brutal-nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: .35rem;
    padding: .5rem .75rem;
    text-decoration: none;
    color: var(--brutal-ink);
    font-family: var(--font-body);
    font-size: .9rem;
    font-weight: 500;
    border: 1.5px solid transparent;
    transition: border-color .15s, background .15s, color .15s;
  }
  .brutal-nav__link:hover { border-color: var(--brutal-ink); background: var(--brutal-card); }
  .brutal-nav__link.is-active { background: var(--brutal-ink); color: var(--brutal-lime); border-color: var(--brutal-ink); }
  .brutal-nav__num {
    font-family: var(--font-mono);
    font-size: .58rem;
    letter-spacing: .15em;
    color: var(--brutal-text-muted);
    text-transform: uppercase;
  }
  .brutal-nav__link.is-active .brutal-nav__num { color: var(--brutal-lime); opacity: .7; }
  .brutal-nav__label { letter-spacing: -.01em; }

  .brutal-header__cta {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
  }
  @media (min-width: 768px) { .brutal-header__cta { gap: .75rem; } }
  .brutal-header__cta .btn-brutal { display: none; }
  @media (min-width: 768px) {
    .brutal-header__cta .btn-brutal { display: inline-flex; }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* BURGER — más brutal, con label "MENÚ"                   */
  /* ═══════════════════════════════════════════════════════ */
  .brutal-burger {
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    background: var(--brutal-ink);
    color: var(--brutal-lime);
    border: 2px solid var(--brutal-ink);
    cursor: pointer;
    padding: 0 .75rem;
    box-shadow: 3px 3px 0 0 var(--brutal-accent);
    transition: transform .15s, box-shadow .15s;
  }
  .brutal-burger:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 0 var(--brutal-accent);
  }
  .brutal-burger__bars {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 18px;
  }
  .brutal-burger__bar {
    display: block;
    width: 18px;
    height: 2.5px;
    background: var(--brutal-lime);
    transition: transform .3s, opacity .25s;
    transform-origin: center;
  }
  .brutal-burger__txt {
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .15em;
    color: var(--brutal-lime);
  }
  .brutal-burger.is-open .brutal-burger__bar:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .brutal-burger.is-open .brutal-burger__bar:nth-child(2) { opacity: 0; }
  .brutal-burger.is-open .brutal-burger__bar:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
  @media (max-width: 380px) {
    .brutal-burger__txt { display: none; }
    .brutal-burger { padding: 0 .65rem; }
  }
  @media (min-width: 1024px) {
    .brutal-burger { display: none; }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* MOBILE DRAWER (.md)                                     */
  /* ═══════════════════════════════════════════════════════ */
  .md {
    --md-paper:  #FFFCF6;
    --md-paper-2:#F5EFE0;
    --md-ink:    #0E0D0B;
    --md-accent: #FF6B35;
    --md-lime:   #D6FF44;
    --md-blue:   #003B7A;
    --md-red:    #DC1B2C;
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    visibility: hidden;
  }
  .md.is-open { pointer-events: auto; visibility: visible; }

  .md__backdrop {
    position: absolute; inset: 0;
    background: rgba(14, 13, 11, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity .4s;
  }
  .md.is-open .md__backdrop { opacity: 1; }

  .md__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(96vw, 460px);
    background: var(--md-paper);
    border-left: 3px solid var(--md-ink);
    transform: translateX(102%);
    transition: transform .55s cubic-bezier(.16, 1, .3, 1);
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .md.is-open .md__panel { transform: translateX(0); }

  .md__bg {
    position: absolute; inset: 0;
    pointer-events: none;
    opacity: 0.85;
    z-index: 0;
  }
  .md__panel > * { position: relative; z-index: 1; }

  /* HEAD */
  .md__head {
    display: flex; justify-content: space-between; align-items: center;
    gap: 1rem;
    padding: .5rem 0 1rem;
    border-bottom: 2px solid var(--md-ink);
    margin-bottom: 1rem;
  }
  .md__head-l { display: flex; gap: .75rem; align-items: baseline; }
  .md__head-num {
    background: var(--md-ink); color: var(--md-lime);
    padding: .25rem .55rem;
    font-size: .65rem; font-weight: 800; letter-spacing: .2em;
  }
  .md__head-date {
    font-size: .6rem; letter-spacing: .2em; color: var(--md-ink); opacity: .6;
  }
  .md__close {
    width: 40px; height: 40px;
    border: 2px solid var(--md-ink);
    background: var(--md-paper);
    color: var(--md-ink);
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: 3px 3px 0 var(--md-ink);
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
  }
  .md__close:hover {
    background: var(--md-red); color: var(--md-paper);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--md-ink);
  }

  /* TITULAR */
  .md__title-row {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .md__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 12vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1;
    color: var(--md-ink);
    display: inline-flex; align-items: baseline; gap: .35rem;
  }
  .md__title > span:first-child {
    color: var(--md-accent);
    font-family: var(--font-mono);
    font-size: .7em;
  }
  .md__title-em {
    font-style: italic;
    color: var(--md-ink);
  }
  .md__title-meta {
    font-size: .65rem;
    letter-spacing: .2em;
    color: var(--md-ink);
    display: inline-flex; align-items: center; gap: .35rem;
    background: var(--md-lime);
    padding: .35rem .55rem;
    border: 1.5px solid var(--md-ink);
  }

  /* Deco rotating star */
  .md__deco {
    position: absolute;
    top: 100px; right: -20px;
    width: 80px; height: 80px;
    color: var(--md-blue);
    opacity: 0.18;
    pointer-events: none;
  }
  .md-spin { transform-origin: 50% 50%; animation: md-spin 22s linear infinite; }
  @keyframes md-spin { to { transform: rotate(360deg); } }

  /* Pulse dot */
  .md-pulse {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #00B85C;
    box-shadow: 0 0 0 0 rgba(0,184,92,0.55);
    animation: md-pulse-anim 1.8s ease-out infinite;
  }
  @keyframes md-pulse-anim {
    0%   { box-shadow: 0 0 0 0 rgba(0,184,92,0.6); }
    70%  { box-shadow: 0 0 0 8px rgba(0,184,92,0); }
    100% { box-shadow: 0 0 0 0 rgba(0,184,92,0); }
  }

  /* NAV principal */
  .md__nav { display: flex; flex-direction: column; }
  .md__nav--main {
    border-top: 2px solid var(--md-ink);
    border-bottom: 2px solid var(--md-ink);
    margin-bottom: 1.5rem;
  }

  .md-link {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: .85rem;
    align-items: center;
    padding: .85rem 0;
    text-decoration: none;
    color: var(--md-ink);
    border-bottom: 1px solid rgba(14,13,11,0.12);
    transition: padding .25s, background .25s, color .25s;
    opacity: 0;
    transform: translateX(20px);
    animation: md-link-in 0.45s cubic-bezier(.16,1,.3,1) forwards;
    animation-delay: calc(0.06s * var(--md-i) + 0.2s);
  }
  .md-link:last-child { border-bottom: none; }
  .md-link:hover {
    padding-inline: .75rem;
    background: var(--md-lime);
  }
  .md-link:hover .md-link__arrow svg { transform: translateX(4px); color: var(--md-accent); }
  .md-link.is-active {
    background: var(--md-ink);
    color: var(--md-lime);
    padding-inline: .75rem;
  }
