---
import { pueblos, comarcas, getPueblosByComarca, getPueblosDestacados } from '../../data/pueblos-almeria';
import { esPuebloIndexable } from '../../data/pueblos-indexables';

interface Props {
  hideHero?: boolean;
}
const { hideHero = false } = Astro.props;

const currentYear = new Date().getFullYear();
// El buscador del footer enlaza solo a los pueblos indexables (Tier 1): evita
// volcar ~90 enlaces (muchos noindex) en cada página y concentra el link equity.
const pueblosDestacados = getPueblosDestacados().filter((p) => esPuebloIndexable(p.slug));
---

<footer class="brutal-footer">
  {!hideHero && (
    <>
      {/* Banda final / declaración de marca */}
      <section class="brutal-footer__hero">
        <div class="container-brutal">
          <div class="brutal-footer__hero-grid">
            <div class="brutal-footer__hero-meta">
              <span class="text-meta">★ Colofón / Vol. {currentYear}</span>
              <span class="text-meta">Almería · 37.236° N — 1.866° W</span>
            </div>
            <h2 class="brutal-footer__claim heading-display">
              ¿Listo para
              <span class="text-stroke-ink">construir</span>
              algo
              <em class="heading-editorial">memorable?</em>
            </h2>
            <div class="brutal-footer__hero-cta">
              <a href="/contacto/" class="btn-brutal btn-brutal--lg">
                Empezar proyecto
                <span aria-hidden="true">→</span>
              </a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">
                Llamar ahora
              </a>
            </div>
          </div>
        </div>
      </section>

      <div class="section-divider-thick"></div>
    </>
  )}

  {/* Grid principal del footer */}
  <section class="brutal-footer__body">
    <div class="container-brutal">
      <div class="brutal-footer__cols">
        {/* Col 1 — Brand */}
        <div class="brutal-footer__col brutal-footer__col--brand">
          <a href="/" class="brutal-footer__logo">
            <span class="brutal-footer__logo-mark">P★</span>
            <span class="brutal-footer__logo-text">
              <span>Platanito Rico</span>
              <small>Estudio digital · Est. 2018</small>
            </span>
          </a>
          <p class="brutal-footer__pitch">
            Diseñamos y construimos productos digitales con presencia. Web, vídeo,
            identidad y crecimiento — sin plantillas, sin atajos.
          </p>
          <span class="badge-brutal badge-brutal--lime">
            <span class="live-dot" style="background:var(--brutal-ink)"></span>
            Aceptando proyectos · 2026
          </span>
        </div>

        {/* Col 2 — Servicios */}
        <nav class="brutal-footer__col" aria-label="Servicios">
          <h3 class="brutal-footer__heading"><span class="text-meta">01 /</span> Servicios</h3>
          <ul class="brutal-footer__list">
            <li><a class="brutal-footer__link" href="/desarrollo-web/">Diseño Web</a></li>
            <li><a class="brutal-footer__link" href="/audiovisual/">Audiovisual</a></li>
            <li><a class="brutal-footer__link" href="/marketing/">Marketing &amp; SEO</a></li>
            <li><a class="brutal-footer__link" href="/diseno-grafico/">Diseño Gráfico</a></li>
            <li><a class="brutal-footer__link" href="/soporte/">Mantenimiento</a></li>
          </ul>
        </nav>

        {/* Col 3 — Contacto */}
        <div class="brutal-footer__col">
          <h3 class="brutal-footer__heading"><span class="text-meta">02 /</span> Contacto</h3>
          <ul class="brutal-footer__list">
            <li><a class="brutal-footer__link" href="tel:+34657085019">+34 657 085 019</a></li>
            <li><a class="brutal-footer__link" href="mailto:hola@platanitorico.com">hola@platanitorico.com</a></li>
            <li><span class="text-mono text-sm" style="color:var(--brutal-text-muted)">Vera · Almería · ES</span></li>
            <li><span class="text-mono text-sm" style="color:var(--brutal-text-muted)">L–V · 09:00 – 19:00</span></li>
          </ul>
        </div>

        {/* Col 4 — Capacidades */}
        <div class="brutal-footer__col">
          <h3 class="brutal-footer__heading"><span class="text-meta">03 /</span> Capacidades</h3>
          <div class="brutal-footer__tags">
            {['UI/UX','Branding','SEO','E-commerce','Performance','Social Ads','Analytics','Consultoría','Headless','Astro','Webflow','Shopify'].map(t => (
              <span class="tag-brutal">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  {/* Localidades — buscador de pueblos */}
  <section class="brutal-footer__pueblos">
    <div class="container-brutal">
      <div class="brutal-footer__pueblos-head">
        <div>
          <span class="text-meta">04 / Cobertura local</span>
          <h3 class="heading-display brutal-footer__pueblos-title">
            Diseño Web en
            <em class="heading-editorial">toda Almería</em>
          </h3>
          <p class="brutal-footer__pueblos-sub text-mono">{pueblos.length} localidades · {comarcas.length} comarcas</p>
          <a href="/diseno-web/" class="brutal-footer__atlas-link" style="display:inline-block;margin-top:.5rem;font-weight:700;text-decoration:underline;text-underline-offset:3px">
            Ver todos los municipios con diseño web en Almería →
          </a>
        </div>

        <div class="brutal-footer__pueblos-selector" id="pueblo-selector">
          <button
            type="button"
            id="pueblo-dropdown-btn"
            class="brutal-footer__selector-btn"
            aria-expanded="false"
            aria-haspopup="listbox"
          >
            <span class="brutal-footer__selector-icon">⌖</span>
            <span id="selected-pueblo-text">Busca tu pueblo…</span>
            <span class="brutal-footer__selector-arrow" id="dropdown-arrow">▾</span>
          </button>

          <div
            id="pueblo-dropdown-panel"
            class="brutal-footer__panel"
            role="listbox"
          >
            <div class="brutal-footer__panel-search">
              <input
                type="text"
                id="pueblo-search"
                placeholder="Escribe un pueblo o comarca…"
                class="input-brutal"
              />
            </div>

            <div class="brutal-footer__panel-list" id="pueblos-list">
              <div class="brutal-footer__panel-group">
                <span class="text-meta">★ Destacadas</span>
                {pueblosDestacados.map((pueblo) => (
                  <a
                    href={`/diseno-web/${pueblo.slug}/`}
                    class="pueblo-item brutal-footer__panel-item"
                    data-nombre={pueblo.nombre.toLowerCase()}
                    data-comarca={pueblo.comarca.toLowerCase()}
                  >
                    <span class="brutal-footer__panel-item-name">{pueblo.nombre}</span>
                    <span class="brutal-footer__panel-item-meta">{pueblo.comarca} →</span>
                  </a>
                ))}
              </div>

              {comarcas.map((comarca) => {
                const items = getPueblosByComarca(comarca).filter(p => !p.destacado && esPuebloIndexable(p.slug));
                if (!items.length) return null;
                return (
                  <div class="brutal-footer__panel-group comarca-section" data-comarca={comarca.toLowerCase()}>
                    <span class="text-meta">{comarca}</span>
                    {items.map((pueblo) => (
                      <a
                        href={`/diseno-web/${pueblo.slug}/`}
                        class="pueblo-item brutal-footer__panel-item"
                        data-nombre={pueblo.nombre.toLowerCase()}
                        data-comarca={pueblo.comarca.toLowerCase()}
                      >
                        <span class="brutal-footer__panel-item-name">{pueblo.nombre}</span>
                        <span class="brutal-footer__panel-item-meta">→</span>
                      </a>
                    ))}
                  </div>
                );
              })}

              <div id="no-results" class="brutal-footer__panel-empty">
                <p class="text-mono">∅ Sin resultados</p>
                <small>Prueba con otro nombre</small>
              </div>
            </div>

            <div class="brutal-footer__panel-foot text-meta">
              <span class="text-stroke-ink">{pueblos.length}</span>&nbsp;pueblos · provincia de Almería
            </div>
          </div>
        </div>
      </div>

      <div class="brutal-footer__pueblos-chips">
        {pueblosDestacados.slice(0, 10).map((pueblo) => (
          <a href={`/diseno-web/${pueblo.slug}/`} class="tag-brutal hover:bg-brutal-ink hover:text-brutal-lime transition-colors">
            ★ {pueblo.nombre}
          </a>
        ))}
        <button type="button" id="ver-todos-btn" class="tag-brutal" style="background:var(--brutal-ink);color:var(--brutal-lime);cursor:pointer;">
          Ver todos →
        </button>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  {/* Bottom bar */}
  <section class="brutal-footer__bottom">
    <div class="container-brutal brutal-footer__bottom-inner">
      <p class="text-meta">© {currentYear} Platanito Rico · Todos los derechos reservados</p>
      <ul class="brutal-footer__legal">
        <li><a class="text-meta" href="/privacidad/">Privacidad</a></li>
        <li><a class="text-meta" href="/aviso-legal/">Aviso legal</a></li>
        <li><a class="text-meta" href="/cookies/">Cookies</a></li>
        <li><a class="text-meta" href="/terminos-condiciones/">Términos</a></li>
      </ul>
      <p class="text-meta">Hecho con tinta y código en <span style="color:var(--brutal-accent-ink)">★</span> Almería</p>
    </div>
  </section>

  {/* Wordmark mural — pieza tipográfica final */}
  <div class="brutal-footer__wordmark" aria-hidden="true">
    <div class="brutal-footer__wordmark-track">
      <span>PLATANITO</span><span>★</span><span>RICO</span><span>★</span><span>PLATANITO</span><span>★</span><span>RICO</span><span>★</span>
    </div>
  </div>
</footer>

<style>
  .brutal-footer {
    margin-top: 6rem;
    background: var(--brutal-bg);
    border-top: 3px solid var(--brutal-ink);
    position: relative;
  }
  /* Hero CTA */
  .brutal-footer__hero {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: var(--brutal-bg-alt);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .brutal-footer__hero-grid {
    display: grid;
    gap: 2rem;
  }
  .brutal-footer__hero-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brutal-footer__claim {
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: .9;
    letter-spacing: -.045em;
    max-width: 18ch;
  }
  .brutal-footer__claim em {
    font-style: italic;
    color: var(--brutal-accent-ink);
  }
  .brutal-footer__hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  /* Body */
  .brutal-footer__body { padding: 4rem 0; }
  .brutal-footer__cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 2.5rem;
  }
  @media (min-width: 640px) { .brutal-footer__cols { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .brutal-footer__cols { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; } }
  .brutal-footer__heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -.02em;
    color: var(--brutal-ink);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: baseline;
    gap: .5rem;
  }
  .brutal-footer__heading .text-meta {
    color: var(--brutal-accent-ink);
  }
  .brutal-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    text-decoration: none;
    color: var(--brutal-ink);
    margin-bottom: 1.5rem;
  }
  .brutal-footer__logo-mark {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--brutal-ink);
    color: var(--brutal-lime);
    font-family: var(--font-mono);
    font-weight: 700;
    border: 2px solid var(--brutal-ink);
    box-shadow: 3px 3px 0 0 var(--brutal-accent);
  }
  .brutal-footer__logo-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brutal-footer__logo-text span { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: -.02em; }
  .brutal-footer__logo-text small { font-family: var(--font-mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .15em; color: var(--brutal-text-muted); margin-top: .2rem; }
  .brutal-footer__pitch {
    font-size: .92rem;
    color: var(--brutal-text-secondary);
    line-height: 1.55;
    margin-bottom: 1.5rem;
    max-width: 32ch;
  }

  .brutal-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: .65rem;
  }
  .brutal-footer__link {
    color: var(--brutal-ink);
    font-size: .95rem;
    text-decoration: none;
    position: relative;
    display: inline-block;
    padding-left: 1rem;
    transition: color .15s, padding .15s;
  }
  .brutal-footer__link::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--brutal-accent-ink);
    opacity: .5;
    transition: opacity .15s, transform .15s;
    font-family: var(--font-mono);
  }
  .brutal-footer__link:hover { color: var(--brutal-accent-ink); padding-left: 1.25rem; }
  .brutal-footer__link:hover::before { opacity: 1; transform: translateX(2px); }

  .brutal-footer__tags {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
  }

  /* Pueblos */
  .brutal-footer__pueblos { padding: 4rem 0; background: var(--brutal-bg-alt); }
  .brutal-footer__pueblos-head {
    display: grid;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 1024px) {
    .brutal-footer__pueblos-head { grid-template-columns: 1fr auto; align-items: end; }
  }
  .brutal-footer__pueblos-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-top: .5rem;
    line-height: .95;
  }
  .brutal-footer__pueblos-title em { color: var(--brutal-accent-ink); }
  .brutal-footer__pueblos-sub {
    color: var(--brutal-text-muted);
    font-size: .8rem;
    margin-top: .75rem;
    text-transform: uppercase;
    letter-spacing: .15em;
  }

  .brutal-footer__pueblos-selector { position: relative; width: 100%; max-width: 380px; }
  .brutal-footer__selector-btn {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: .75rem;
    padding: 1rem 1.25rem;
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    box-shadow: 4px 4px 0 0 var(--brutal-accent);
    font-family: var(--font-mono);
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--brutal-ink);
    cursor: pointer;
    transition: transform .15s, box-shadow .15s;
    text-align: left;
  }
  .brutal-footer__selector-btn:hover { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 0 var(--brutal-accent); }
  .brutal-footer__selector-icon { font-size: 1.1rem; color: var(--brutal-accent-ink); }
  .brutal-footer__selector-arrow { font-family: var(--font-mono); transition: transform .25s; }

  .brutal-footer__panel {
    position: absolute;
    bottom: calc(100% + .5rem);
    left: 0;
    right: 0;
    max-height: 440px;
    overflow: hidden;
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    box-shadow: 8px 8px 0 0 var(--brutal-ink);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity .2s, transform .2s, visibility .2s;
    z-index: 30;
  }
  .brutal-footer__panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .brutal-footer__panel-search { padding: 1rem; border-bottom: 2px solid var(--brutal-ink); }
  .brutal-footer__panel-list { max-height: 320px; overflow-y: auto; padding: 1rem; }
  .brutal-footer__panel-group { margin-bottom: 1.25rem; }
  .brutal-footer__panel-group .text-meta { display: block; margin-bottom: .5rem; padding-bottom: .25rem; border-bottom: 1px solid var(--brutal-border-soft); }
  .brutal-footer__panel-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .55rem .5rem;
    text-decoration: none;
    color: var(--brutal-ink);
    transition: background .15s, padding .15s;
  }
  .brutal-footer__panel-item:hover { background: var(--brutal-lime-soft); padding-inline: .75rem; }
  .brutal-footer__panel-item-name { font-family: var(--font-display); font-weight: 600; font-size: .92rem; }
  .brutal-footer__panel-item-meta { font-family: var(--font-mono); font-size: .65rem; color: var(--brutal-text-muted); text-transform: uppercase; letter-spacing: .15em; }
  .brutal-footer__panel-empty { display: none; text-align: center; padding: 2rem; }
  .brutal-footer__panel-empty.is-shown { display: block; }
  .brutal-footer__panel-foot {
    padding: .75rem 1rem;
    border-top: 2px solid var(--brutal-ink);
    text-align: center;
    background: var(--brutal-bg-alt);
  }

  .brutal-footer__pueblos-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1.5rem; }

  /* Bottom bar */
  .brutal-footer__bottom { padding: 1.25rem 0; background: var(--brutal-ink); color: var(--brutal-bg); }
  .brutal-footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
  }
  .brutal-footer__bottom .text-meta { color: var(--brutal-bg-alt); }
  .brutal-footer__bottom a.text-meta { color: var(--brutal-bg); text-decoration: none; transition: color .15s; }
  .brutal-footer__bottom a.text-meta:hover { color: var(--brutal-lime); }
  .brutal-footer__legal { display: flex; gap: 1.25rem; list-style: none; padding: 0; margin: 0; flex-wrap: wrap; }

  /* Wordmark */
  .brutal-footer__wordmark {
    overflow: hidden;
    background: var(--brutal-ink);
    border-top: 2px solid var(--brutal-accent);
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .brutal-footer__wordmark-track {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: max-content;
    animation: marquee 35s linear infinite;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 10vw, 8rem);
    color: transparent;
    -webkit-text-stroke: 2px var(--brutal-bg);
    line-height: 1;
    letter-spacing: -.04em;
    user-select: none;
  }
  .brutal-footer__wordmark-track span:nth-child(even) {
    color: var(--brutal-accent-ink);
    -webkit-text-stroke: 0;
  }
</style>

<script>
  const dropdownBtn = document.getElementById('pueblo-dropdown-btn');
  const dropdownPanel = document.getElementById('pueblo-dropdown-panel');
  const dropdownArrow = document.getElementById('dropdown-arrow');
  const searchInput = document.getElementById('pueblo-search') as HTMLInputElement | null;
  const puebloItems = document.querySelectorAll('.pueblo-item');
  const comarcaSections = document.querySelectorAll('.comarca-section');
  const noResults = document.getElementById('no-results');

  let isOpen = false;

  function setOpen(open: boolean) {
    isOpen = open;
    dropdownPanel?.classList.toggle('is-open', open);
    dropdownBtn?.setAttribute('aria-expanded', String(open));
    if (dropdownArrow) dropdownArrow.style.transform = open ? 'rotate(180deg)' : '';
    if (open) setTimeout(() => searchInput?.focus(), 100);
  }

  dropdownBtn?.addEventListener('click', () => setOpen(!isOpen));

  document.getElementById('ver-todos-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(true);
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#pueblo-selector')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  searchInput?.addEventListener('input', (e) => {
    const searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
    let hasResults = false;

    puebloItems.forEach((item) => {
      const nombre = item.getAttribute('data-nombre') || '';
      const comarca = item.getAttribute('data-comarca') || '';
      const matches = nombre.includes(searchTerm) || comarca.includes(searchTerm);
      (item as HTMLElement).style.display = matches ? '' : 'none';
      if (matches) hasResults = true;
    });

    comarcaSections.forEach((section) => {
      const visibleItems = section.querySelectorAll('.pueblo-item:not([style*="display: none"])');
      (section as HTMLElement).style.display = visibleItems.length > 0 ? '' : 'none';
    });

    noResults?.classList.toggle('is-shown', !hasResults);
  });
</script>
