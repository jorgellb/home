---
import { pueblosIT, HUB_IT } from '../../data/servicios-it';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<ul class="it-cob">
  {pueblosIT.map((p) => (
    <li>
      {p.slug === current ? (
        <span class="it-cob__item is-current" aria-current="page">{p.nombre}</span>
      ) : (
        <a class="it-cob__item" href={`${HUB_IT}${p.slug}/`}>Informático en {p.nombre}</a>
      )}
    </li>
  ))}
</ul>

<style>
  .it-cob { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .75rem; }
  .it-cob__item {
    display: inline-flex; align-items: center; gap: .55rem;
    min-height: 2.9rem;
    padding: .55rem 1rem;
    border: 2px solid var(--it-line);
    background: var(--it-card);
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    transition: transform .15s, box-shadow .15s;
  }
  a.it-cob__item::before { content: ''; width: .5rem; height: .5rem; background: var(--it-accent); }
  a.it-cob__item:hover { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--it-shadow); }
  a.it-cob__item:focus-visible { outline: 3px solid var(--color-plano-ciano); outline-offset: 2px; }
  .it-cob__item.is-current { background: var(--color-plano-lima); color: var(--color-plano-tinta); border-color: var(--color-plano-tinta); font-weight: 800; }
</style>
