---
import type { Faq } from '../../data/servicios-it';

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<ul class="it-faq">
  {items.map((f, i) => (
    <li>
      <details class="it-faq__item" open={i === 0}>
        <summary class="it-faq__q">
          <span>{f.q}</span>
          <span class="it-faq__icon" aria-hidden="true"></span>
        </summary>
        <p class="it-faq__a">{f.a}</p>
      </details>
    </li>
  ))}
</ul>

<style>
  .it-faq { list-style: none; margin: 0; padding: 0; max-width: 62rem; border-top: 3px solid var(--it-line); }
  .it-faq > li { border-bottom: 3px solid var(--it-line); }
  .it-faq__q {
    list-style: none;
    cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 1.25rem 0;
    font-family: var(--font-display);
    font-weight: 700; font-size: 1.15rem; line-height: 1.35; letter-spacing: -.01em;
  }
  .it-faq__q::-webkit-details-marker { display: none; }
  .it-faq__q:focus-visible { outline: 3px solid var(--color-plano-ciano); outline-offset: 2px; }
  .it-faq__icon { position: relative; flex: none; width: 1.6rem; height: 1.6rem; border: 2px solid currentColor; }
  .it-faq__icon::before, .it-faq__icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: .7rem; height: 2px; background: currentColor; transform: translate(-50%, -50%); transition: transform .2s; }
  .it-faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .it-faq__item[open] .it-faq__icon { background: var(--it-accent); border-color: var(--it-accent); }
  .it-faq__item[open] .it-faq__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .it-faq__a { margin: 0 0 1.4rem; max-width: 70ch; line-height: 1.6; color: var(--it-muted); }
</style>
