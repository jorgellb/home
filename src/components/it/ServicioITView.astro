---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import Breadcrumb from '../common/Breadcrumb.astro';
import Contact from '../sections/Contact.astro';
import BlueprintHero from '../brutal/BlueprintHero.astro';
import Ticker from '../brutal/Ticker.astro';
import ItSection from './ItSection.astro';
import SectionHead from './SectionHead.astro';
import BloquesGrid from './BloquesGrid.astro';
import ServiciosGrid from './ServiciosGrid.astro';
import FaqList from './FaqList.astro';
import CoberturaList from './CoberturaList.astro';
import Plan360Teaser from './Plan360Teaser.astro';
import { getServicioIT, pueblosIT, plan360, HUB_IT } from '../../data/servicios-it';
import { SITE, PROVEEDOR } from '../../data/negocio';

interface Props {
  slug: string;
}

const servicio = getServicioIT(Astro.props.slug);
if (!servicio) throw new Error(`Servicio IT desconocido: ${Astro.props.slug}`);

const canonical = `${SITE}${HUB_IT}${servicio.slug}/`;
const contactoHref = '/contacto/?servicio=sistemas-it#contacto';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': servicio.h1,
    'serviceType': servicio.nav,
    'description': servicio.description,
    'url': canonical,
    'provider': PROVEEDOR,
    'areaServed': [
      ...pueblosIT.map((p) => ({ '@type': 'City', 'name': p.nombre })),
      { '@type': 'AdministrativeArea', 'name': 'Provincia de Almería' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': servicio.faq.map((f) => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
  },
];
---

<BaseLayout title={servicio.title} description={servicio.description} canonical={canonical} jsonLd={jsonLd}>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Sistemas IT', href: HUB_IT }, { label: servicio.nav }]} />

  <main id="main-content">
    <BlueprintHero
      size="compact"
      h1Lines={[servicio.h1]}
      h2={servicio.h2}
      primary={{ href: contactoHref, label: 'Pedir presupuesto' }}
      secondary={{ href: plan360.href, label: 'Incluido en el Plan 360' }}
      proyecto={servicio.nav}
      lamina="IT"
      coords="Sistemas IT · base en Vera"
      specs={[{ k: 'Visita in situ', v: 'El mismo día' }, { k: 'Helpdesk', v: 'Remoto ilimitado' }, { k: 'Cobertura', v: 'Levante y Almanzora' }, { k: 'Permanencia', v: 'Ninguna' }]}
    />
    <Ticker label="Compromisos del servicio" items={['Visita in situ el mismo día en el Levante y el Almanzora', 'Helpdesk remoto ilimitado', 'Copias de seguridad verificadas cada mes', 'Antivirus gestionado', 'Plan 360: web e informática por 400 € + IVA al mes', 'Sin permanencia']} />

    <ItSection tone="bone" labelledby="it-problema">
      <div class="sv-intro">
        <div>
          <SectionHead id="it-problema" kicker="Cap. 01 / El problema" title="Lo que vemos cada semana en las empresas" />
          <p class="sv-intro__p">{servicio.intro}</p>
        </div>
        <ul class="sv-dolores">
          {servicio.dolores.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </ItSection>

    <ItSection tone="paper" labelledby="it-incluye">
      <SectionHead id="it-incluye" kicker="Cap. 02 / Qué incluye" title={`${servicio.nav} para empresas: qué incluye`} />
      <BloquesGrid items={servicio.incluye} />
    </ItSection>

    <ItSection tone="night" labelledby="it-quien">
      <SectionHead id="it-quien" kicker="Cap. 03 / Para quién" title="Empresas con las que trabajamos" />
      <ul class="sv-quien">
        {servicio.paraQuien.map((q) => <li>{q}</li>)}
      </ul>
      <Plan360Teaser />
    </ItSection>

    <ItSection tone="bone" labelledby="it-otros">
      <SectionHead id="it-otros" kicker="Cap. 04 / Más servicios" title="Otros servicios informáticos para tu empresa" />
      <ServiciosGrid exclude={servicio.slug} />
    </ItSection>

    <ItSection tone="paper" labelledby="it-cobertura">
      <SectionHead
        id="it-cobertura"
        kicker="Cap. 05 / Cobertura"
        title="Técnico in situ el mismo día"
        lead="Vamos a tu empresa en el Levante y el Almanzora. En el resto de la provincia de Almería damos soporte remoto y visitas programadas."
      />
      <CoberturaList />
    </ItSection>

    <ItSection tone="bone" labelledby="it-faq">
      <SectionHead id="it-faq" kicker="Cap. 06 / Preguntas" title={`Preguntas frecuentes: ${servicio.nav.toLowerCase()}`} />
      <FaqList items={servicio.faq} />
    </ItSection>

    <Contact />
  </main>

  <Footer />
</BaseLayout>

<style>
  .sv-intro { display: grid; gap: 2rem; }
  @media (min-width: 1024px) { .sv-intro { grid-template-columns: 1.2fr 1fr; gap: 4rem; align-items: start; } }
  .sv-intro__p { margin: 0; max-width: 60ch; font-size: 1.15rem; line-height: 1.65; }
  .sv-dolores { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .sv-dolores li {
    position: relative;
    padding: 1rem 1.1rem 1rem 3rem;
    background: var(--it-card);
    border: 2px solid var(--it-line);
    line-height: 1.45;
    font-weight: 600;
  }
  .sv-dolores li::before {
    content: '✕';
    position: absolute; left: 1.1rem; top: 1rem;
    font-family: var(--font-mono);
    color: var(--it-accent);
  }
  .sv-quien { list-style: none; margin: 0 0 2.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .sv-quien li { padding: .6rem 1rem; border: 2px solid var(--it-line); }
</style>
