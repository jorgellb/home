---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import Breadcrumb from '../common/Breadcrumb.astro';
import Contact from '../sections/Contact.astro';
import BlueprintHero from '../brutal/BlueprintHero.astro';
import Ticker from '../brutal/Ticker.astro';
import ItSection from './ItSection.astro';
import SectionHead from './SectionHead.astro';
import ServiciosGrid from './ServiciosGrid.astro';
import FaqList from './FaqList.astro';
import CoberturaList from './CoberturaList.astro';
import Plan360Teaser from './Plan360Teaser.astro';
import { getPuebloIT, plan360, HUB_IT, type Faq } from '../../data/servicios-it';
import { esPuebloIndexable } from '../../data/pueblos-indexables';
import { SITE, PROVEEDOR } from '../../data/negocio';

interface Props {
  slug: string;
}

const pueblo = getPuebloIT(Astro.props.slug);
if (!pueblo) throw new Error(`Pueblo IT desconocido: ${Astro.props.slug}`);

const n = pueblo.nombre;
const canonical = `${SITE}${HUB_IT}${pueblo.slug}/`;
const contactoHref = '/contacto/?servicio=sistemas-it#contacto';

// El título debe caber en 43 caracteres (BaseLayout añade « | Platanito
// Rico», 17 más, hasta 60): se usa la primera variante que entra.
const title = [
  `Mantenimiento Informático en ${n}`,
  `Informático para Empresas en ${n}`,
  `Informático en ${n}`,
].find((t) => t.length <= 43) ?? `Informático en ${n}`;

// ≤160 caracteres incluso con el nombre más largo (Cuevas del Almanzora).
const description = `Mantenimiento informático en ${n}: técnico in situ el mismo día, redes wifi, servidores, copias y ciberseguridad. Plan 360 por 400 €/mes.`;

const faq: Faq[] = [
  { q: `¿Tenéis técnico informático en ${n}?`, a: `Sí. ${n} está dentro de nuestra zona de cobertura presencial: si una incidencia no se resuelve en remoto, vamos a tu empresa el mismo día.` },
  { q: `¿Cuánto cuesta el mantenimiento informático para una empresa de ${n}?`, a: 'Para pymes de hasta 10 puestos, el Plan 360 incluye mantenimiento informático, red, copias, ciberseguridad y la web por 400 € + IVA al mes, sin permanencia. Si solo necesitas un servicio concreto, te damos presupuesto cerrado.' },
  { q: '¿Instaláis redes wifi y cableado en locales y naves?', a: `Sí. Hacemos estudio de cobertura, cableado estructurado, wifi profesional y firewall para oficinas, hoteles, restaurantes y naves de ${n} y alrededores.` },
];

const webLocal = esPuebloIndexable(pueblo.slug) ? `/diseno-web/${pueblo.slug}/` : null;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': `Mantenimiento informático para empresas en ${n}`,
    'serviceType': 'Mantenimiento informático',
    'description': description,
    'url': canonical,
    'provider': PROVEEDOR,
    'areaServed': { '@type': 'City', 'name': n },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faq.map((f) => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Sistemas IT', href: HUB_IT }, { label: n }]} />

  <main id="main-content">
    <BlueprintHero
      size="compact"
      h1Lines={[`Mantenimiento informático en ${n}`]}
      h2={`Técnico en tu empresa de ${n} el mismo día`}
      primary={{ href: contactoHref, label: 'Pedir presupuesto' }}
      secondary={{ href: plan360.href, label: 'Ver el Plan 360' }}
      proyecto={`Informática en ${n}`}
      lamina="IT"
      place={`${n}, ${pueblo.comarca}`}
      coords="Zona de visita el mismo día"
      specs={[{ k: 'Visita in situ', v: 'El mismo día' }, { k: 'Sectores', v: `${pueblo.sectores.length} en ${n}` }, { k: 'Helpdesk', v: 'Remoto ilimitado' }, { k: 'Permanencia', v: 'Ninguna' }]}
    />
    <Ticker label={`Informática para empresas de ${n}`} items={[...pueblo.sectores, 'Visita el mismo día', 'Plan 360 por 400 € + IVA al mes', 'Sin permanencia']} />

    <ItSection tone="bone" labelledby="it-local">
      <div class="pu-intro">
        <div>
          <SectionHead id="it-local" kicker={`Cap. 01 / ${n}`} title={`Informática para empresas de ${n}`} />
          <p class="pu-intro__p">{pueblo.intro}</p>
          {webLocal && (
            <p class="pu-intro__web">¿También necesitas web? <a href={webLocal}>Diseño web en {n} →</a></p>
          )}
        </div>
        <div class="pu-sectores">
          <p class="pu-sectores__t">Sectores que atendemos en {n}</p>
          <ul>
            {pueblo.sectores.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </ItSection>

    <ItSection tone="paper" labelledby="it-servicios">
      <SectionHead id="it-servicios" kicker="Cap. 02 / Servicios" title={`Servicios informáticos en ${n}`} />
      <ServiciosGrid />
    </ItSection>

    <ItSection tone="night" labelledby="it-360">
      <SectionHead
        id="it-360"
        kicker="Cap. 03 / Pase especial"
        title="Web e informática en una sola cuota"
        lead="Si tu empresa tiene hasta 10 puestos, el Plan 360 lo cubre todo: la web, los ordenadores, el servidor, la red y las copias."
      />
      <Plan360Teaser />
    </ItSection>

    <ItSection tone="bone" labelledby="it-cobertura">
      <SectionHead id="it-cobertura" kicker="Cap. 04 / Cobertura" title="También vamos in situ a" />
      <CoberturaList current={pueblo.slug} />
    </ItSection>

    <ItSection tone="paper" labelledby="it-faq">
      <SectionHead id="it-faq" kicker="Cap. 05 / Preguntas" title={`Preguntas frecuentes sobre informática en ${n}`} />
      <FaqList items={faq} />
    </ItSection>

    <Contact />
  </main>

  <Footer />
</BaseLayout>

<style>
  .pu-intro { display: grid; gap: 2rem; }
  @media (min-width: 1024px) { .pu-intro { grid-template-columns: 1.3fr 1fr; gap: 4rem; align-items: start; } }
  .pu-intro__p { margin: 0; max-width: 60ch; font-size: 1.15rem; line-height: 1.65; }
  .pu-intro__web { margin: 1.5rem 0 0; font-weight: 600; }
  .pu-intro__web a { color: var(--it-accent); font-weight: 800; text-underline-offset: 4px; }
  .pu-sectores { padding: 1.5rem; background: var(--it-card); border: 2px solid var(--it-line); }
  .pu-sectores__t { margin: 0 0 1rem; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: var(--it-accent); }
  .pu-sectores ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .pu-sectores li { padding-left: 1.4rem; position: relative; font-weight: 600; line-height: 1.4; }
  .pu-sectores li::before { content: '★'; position: absolute; left: 0; font-size: .75rem; top: .2rem; color: var(--it-accent); }
</style>
