---
import { serviciosIT, HUB_IT, type IconoIT } from '../../data/servicios-it';

interface Props {
  exclude?: string;
}

const { exclude } = Astro.props;
const items = serviciosIT.filter((s) => s.slug !== exclude);

const ATTRS = 'viewBox="0 0 32 32" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" stroke-linejoin="miter"';
const ICONS: Record<IconoIT, string> = {
  helpdesk: `<svg ${ATTRS}><path d="M6 18v-3a10 10 0 0 1 20 0v3"/><rect x="4" y="18" width="5" height="8"/><rect x="23" y="18" width="5" height="8"/><path d="M26 26c0 2-2 3-5 3h-3"/></svg>`,
  red: `<svg ${ATTRS}><rect x="14" y="23" width="4" height="4"/><path d="M10.5 19.5a8 8 0 0 1 11 0"/><path d="M6 15a14 14 0 0 1 20 0"/><path d="M2 10.5a20 20 0 0 1 28 0"/></svg>`,
  servidor: `<svg ${ATTRS}><rect x="5" y="4" width="22" height="10"/><rect x="5" y="18" width="22" height="10"/><path d="M10 9h1M10 23h1M15 9h7M15 23h7"/></svg>`,
  equipo: `<svg ${ATTRS}><rect x="3" y="5" width="26" height="17"/><path d="M12 27h8M16 22v5"/></svg>`,
  escudo: `<svg ${ATTRS}><path d="M16 3 5 7v8c0 7 5 12 11 14 6-2 11-7 11-14V7z"/><path d="m11 16 4 4 7-8"/></svg>`,
};
---

<ul class="it-svc">
  {items.map((s) => (
    <li>
      <a class="it-svc__card" href={`${HUB_IT}${s.slug}/`}>
        <span class="it-svc__icon" aria-hidden="true"><Fragment set:html={ICONS[s.icon]} /></span>
        <h3 class="it-svc__t">{s.nav}</h3>
        <p class="it-svc__d">{s.resumen}</p>
        <span class="it-svc__more">Ver servicio</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .it-svc { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .it-svc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .it-svc { grid-template-columns: repeat(3, 1fr); } }
  .it-svc > li { display: flex; }
  .it-svc__card {
    flex: 1;
    display: flex; flex-direction: column; gap: .65rem;
    padding: 1.6rem;
    background: var(--it-card);
    color: inherit;
    text-decoration: none;
    border: 3px solid var(--it-line);
    box-shadow: 7px 7px 0 var(--it-shadow);
    transition: transform .15s, box-shadow .15s;
  }
  .it-svc__card:hover { transform: translate(-3px, -3px); box-shadow: 10px 10px 0 var(--it-shadow); }
  .it-svc__card:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--it-shadow); }
  .it-svc__card:focus-visible { outline: 3px solid var(--color-plano-ciano); outline-offset: 4px; }
  .it-svc__icon { color: var(--it-accent); }
  .it-svc__t { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 1.45rem; line-height: 1.05; letter-spacing: -.03em; }
  .it-svc__d { margin: 0; line-height: 1.5; color: var(--it-muted); }
  .it-svc__more {
    margin-top: auto; padding-top: .6rem;
    font-family: var(--font-mono); font-weight: 800; font-size: .85rem;
    color: var(--it-accent);
    text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px;
  }
</style>
