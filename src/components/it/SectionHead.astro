---
interface Props {
  title: string;
  id?: string;
  kicker?: string;
  lead?: string;
  center?: boolean;
}

const { title, id, kicker, lead, center = false } = Astro.props;
---

<header class={`it-head${center ? ' it-head--center' : ''}`}>
  {kicker && <p class="it-head__kicker">{kicker}</p>}
  <h2 id={id} class="it-head__title">{title}</h2>
  {lead && <p class="it-head__lead">{lead}</p>}
</header>

<style>
  .it-head { max-width: 56rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .it-head--center { margin-inline: auto; text-align: center; }
  .it-head__kicker {
    margin: 0 0 .9rem;
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--it-accent);
  }
  .it-head__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 4rem);
    line-height: .96;
    letter-spacing: -.045em;
    text-wrap: balance;
  }
  .it-head__lead { margin: 1rem 0 0; max-width: 62ch; font-size: 1.1rem; line-height: 1.55; color: var(--it-muted); }
  .it-head--center .it-head__lead { margin-inline: auto; }
</style>
