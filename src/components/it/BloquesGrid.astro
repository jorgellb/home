---
import type { Bloque } from '../../data/servicios-it';

interface Props {
  items: Bloque[];
  columns?: 2 | 3;
}

const { items, columns = 3 } = Astro.props;
---

<ul class={`it-grid it-grid--${columns}`}>
  {items.map((b) => (
    <li class="it-grid__item">
      <h3 class="it-grid__t">{b.t}</h3>
      <p class="it-grid__d">{b.d}</p>
    </li>
  ))}
</ul>

<style>
  .it-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 3px;
    grid-template-columns: 1fr;
    background: var(--it-line);
    border: 3px solid var(--it-line);
    box-shadow: 8px 8px 0 var(--it-shadow);
  }
  @media (min-width: 700px) { .it-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .it-grid--3 { grid-template-columns: repeat(3, 1fr); } }
  .it-grid__item { background: var(--it-card); padding: 1.6rem 1.5rem; display: flex; flex-direction: column; gap: .55rem; }
  .it-grid__t {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.2;
    letter-spacing: -.02em;
  }
  .it-grid__t::before { content: ''; display: block; width: 1.6rem; height: 4px; margin-bottom: .8rem; background: var(--it-accent); }
  .it-grid__d { margin: 0; font-size: .98rem; line-height: 1.55; color: var(--it-muted); }
</style>
