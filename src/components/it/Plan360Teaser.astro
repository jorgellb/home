---
import { plan360 } from '../../data/servicios-it';
---

<aside class="p360" aria-label="Plan 360">
  <div class="p360__copy">
    <p class="p360__title">Plan 360 <span class="p360__price">400 € + IVA al mes</span></p>
    <p class="p360__d">
      Tu web, hasta {plan360.puestos} puestos, servidor, red, copias y ciberseguridad, con técnico en tu
      empresa el mismo día. Sin permanencia ni alta.
    </p>
  </div>
  <a class="p360__btn" href={plan360.href}>Ver el Plan 360</a>
</aside>

<style>
  .p360 {
    display: grid; gap: 1.5rem; align-items: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-plano-lima);
    color: var(--color-plano-tinta);
    border: 3px solid var(--color-plano-tinta);
    box-shadow: 10px 10px 0 var(--color-plano-naranja);
  }
  @media (min-width: 900px) { .p360 { grid-template-columns: 1fr auto; } }
  .p360__title {
    margin: 0;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem 1rem;
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(2rem, 4.6vw, 3.2rem); line-height: 1; letter-spacing: -.045em;
  }
  .p360__price { font-family: var(--font-mono); font-weight: 800; font-size: clamp(.95rem, 1.8vw, 1.2rem); letter-spacing: 0; }
  .p360__d { margin: .75rem 0 0; max-width: 58ch; line-height: 1.5; font-weight: 500; }
  .p360__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3.1rem; padding: .85rem 1.5rem;
    background: var(--color-plano-tinta); color: var(--color-plano-lima);
    font-family: var(--font-mono); font-weight: 800; text-decoration: none;
    white-space: nowrap;
    transition: transform .15s, box-shadow .15s;
  }
  .p360__btn:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--color-plano-tinta); }
  .p360__btn:focus-visible { outline: 3px solid var(--color-plano-ciano); outline-offset: 3px; }
</style>
