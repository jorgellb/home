---
// SEO Head Component - Complete meta tags for optimal SEO
interface Props {
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article' | 'product' | 'profile';
  noindex?: boolean;
  nofollow?: boolean;
  canonical?: string;
  lang?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  twitterCreator?: string;
  themeColor?: string;
}

const { 
  title, 
  description, 
  image, 
  imageWidth,
  imageHeight,
  type = 'website',
  noindex = false,
  nofollow = false,
  canonical,
  lang = 'es',
  alternates,
  jsonLd,
  publishedTime,
  modifiedTime,
  author,
  section,
  twitterCreator,
  themeColor = '#3b82f6'
} = Astro.props;

const siteName = 'Platanito Rico';
const fullTitle = `${title} | ${siteName}`;
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const canonicalUrl = canonical || siteUrl;
const ogImage = image || '/og-image.jpg';
const currentLang = lang === 'es' ? 'es_ES' : 'en_US';
const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow'
].join(', ');
---

<!-- Theme Color -->
<meta name="theme-color" content={themeColor} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={noindex ? 'noindex' : 'index'} />

<!-- Language -->
<html lang={lang} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={description} />
{imageWidth && <meta property="og:image:width" content={imageWidth.toString()} />}
{imageHeight && <meta property="og:image:height" content={imageHeight.toString()} />}
<meta property="og:locale" content={currentLang} />
<meta property="og:site_name" content={siteName} />

<!-- Article-specific OG tags -->
{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime} />
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {section && <meta property="article:section" content={section} />}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={description} />
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
{twitterCreator && <meta name="twitter:site" content={twitterCreator} />}

<!-- Hreflang (Multi-language) -->
{alternates?.map(alt => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}

<!-- X-default for international -->
{alternates && !alternates.some(a => a.hreflang === 'x-default') && (
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
)}

<!-- JSON-LD Structured Data -->
{jsonLd && (
  <script type="application/ld+json" set:html={Array.isArray(jsonLd) ? JSON.stringify(jsonLd) : JSON.stringify([jsonLd])} />
)}

<!-- Preconnect to common third-party origins -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://www.googletagmanager.com" />
