---
/**
 * SmartLink - Intelligent link component with SEO and accessibility optimizations
 * Auto-detects internal/external, handles rel attributes, prefetch control
 * 
 * @see https://web.dev/articles/link-rel-prerender
 * @see https://www.w3.org/WAI/WCAG21/quickref/#link-purpose-in-context
 */
interface Props {
  href: string
  rel?: string
  target?: string
  prefetch?: boolean | 'hover' | 'viewport' | 'load' | 'intent'
  class?: string
  'aria-label'?: string
  'aria-current'?: 'page' | 'step' | 'location' | 'date' | 'time' | 'true' | 'false' | boolean | undefined | null
  /** Show external link icon */
  showExternalIcon?: boolean
  /** Disable automatic external detection */
  forceInternal?: boolean
  /** Add nofollow automatically for non-trusted links */
  nofollow?: boolean
  /** Title attribute for additional context */
  title?: string
}

const {
  href,
  rel: customRel,
  target: customTarget,
  prefetch = 'hover',
  class: className,
  'aria-label': ariaLabel,
  'aria-current': ariaCurrent,
  showExternalIcon = false,
  forceInternal = false,
  nofollow = false,
  title
} = Astro.props

// Determine if link is external
const isExternal = !forceInternal && (href.startsWith('http') || href.startsWith('//'))
const isMailto = href.startsWith('mailto:')
const isTel = href.startsWith('tel:')
const isAnchor = href.startsWith('#')
const isDownload = href.includes('/downloads/') || href.endsWith('.pdf') || href.endsWith('.zip')
const isFile = /\.(pdf|doc|docx|xls|xlsx|ppt|pptx|zip|rar|7z)$/i.test(href)

// Compute target
const target = customTarget ?? (isExternal ? '_blank' : undefined)

// Compute rel with enhanced security
const computeRel = (): string | undefined => {
  if (customRel) return customRel

  const rels: string[] = []

  if (isExternal) {
    rels.push('noopener', 'noreferrer')
    // Add nofollow for external links by default (SEO best practice)
    if (nofollow) {
      rels.push('nofollow')
    }
  }

  if (isDownload || isFile) {
    rels.push('nofollow')
  }

  // Sponsored or UGC for specific cases
  if (href.includes('/sponsored/') || href.includes('?utm_sponsored')) {
    rels.push('sponsored')
  }

  if (href.includes('/ugc/') || href.includes('?utm_ugc')) {
    rels.push('ugc')
  }

  return rels.length > 0 ? rels.join(' ') : undefined
}

const rel = computeRel()

// Compute prefetch strategy with intent option
const computePrefetch = (): string | undefined => {
  if (!prefetch || isExternal || isMailto || isTel || isAnchor || isDownload) {
    return undefined
  }

  if (prefetch === true) {
    return 'hover'
  }
  
  if (prefetch === 'intent') {
    return 'viewport'
  }

  return prefetch
}

const prefetchValue = computePrefetch()

// Check if current page
const currentPath = Astro.url.pathname
const isCurrentPage = !isExternal && href === currentPath

// Generate accessible label for external links
const computedAriaLabel = ariaLabel || (isExternal && showExternalIcon ? `${title || ''} (opens in new tab)` : title)
---

<a
  href={href}
  rel={rel}
  target={target}
  class={className}
  title={title}
  aria-label={computedAriaLabel}
  aria-current={ariaCurrent ?? (isCurrentPage ? 'page' : undefined)}
  data-astro-prefetch={prefetchValue}
  {...(isFile && { download: true })}
>
  <slot />
  {isExternal && showExternalIcon && (
    <span class="external-icon" aria-hidden="true">↗</span>
  )}
  {isExternal && !showExternalIcon && (
    <span class="sr-only">(opens in new tab)</span>
  )}
  {isFile && (
    <span class="file-indicator" aria-hidden="true">📎</span>
  )}
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  
  .external-icon {
    font-size: 0.75em;
    line-height: 1;
    opacity: 0.7;
  }
  
  .file-indicator {
    font-size: 0.8em;
    opacity: 0.6;
  }
  
  /* Visual feedback for different link types */
  a[href^="mailto:"],
  a[href^="tel:"] {
    text-decoration: underline;
    text-decoration-style: dotted;
  }
  
  a[href$=".pdf"]::after {
    content: " 📄";
    font-size: 0.8em;
  }
</style>
