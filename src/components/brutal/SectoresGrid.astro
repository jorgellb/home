---
interface Sector {
  nombre: string;
  stat: string;
  desc: string;
  tags: string[];
}

interface Props {
  items: Sector[];
}

const { items } = Astro.props;
---

<ul class="sg">
  {items.map((s) => (
    <li class="sg__item">
      {s.stat && <p class="sg__stat">{s.stat}</p>}
      <h3 class="sg__name">{s.nombre}</h3>
      <p class="sg__desc">{s.desc}</p>
      {s.tags.length > 0 && (
        <ul class="sg__tags">
          {s.tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </li>
  ))}
</ul>

<style>
  .sg { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .sg { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .sg { grid-template-columns: repeat(3, 1fr); } }
  .sg__item {
    display: flex; flex-direction: column; gap: .55rem;
    padding: 1.5rem;
    background: var(--it-card);
    border: 3px solid var(--it-line);
    box-shadow: 7px 7px 0 var(--it-shadow);
  }
  .sg__stat { margin: 0; font-family: var(--font-mono); font-weight: 800; font-size: 1.05rem; color: var(--it-accent); }
  .sg__name { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; line-height: 1.1; letter-spacing: -.025em; }
  .sg__desc { margin: 0; line-height: 1.55; color: var(--it-muted); }
  .sg__tags { list-style: none; margin: auto 0 0; padding: .6rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .sg__tags li { padding: .2rem .5rem; font-family: var(--font-mono); font-size: .72rem; border: 2px solid var(--it-line); }
</style>
