---
/* Lista de filas con dato lateral (año, hora, distancia…): se usa para los
   bloques singulares de cada pueblo (películas, lonja, minería, mercados…). */
interface Item {
  t: string;
  d: string;
  meta?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="il">
  {items.map((i) => (
    <li class="il__row">
      <span class="il__meta">{i.meta}</span>
      <div class="il__body">
        <h3 class="il__t">{i.t}</h3>
        {i.d && <p class="il__d">{i.d}</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .il { list-style: none; margin: 0; padding: 0; border-top: 3px solid var(--it-line); max-width: 68rem; }
  .il__row {
    display: grid; grid-template-columns: 1fr; gap: .35rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--it-line);
  }
  @media (min-width: 700px) { .il__row { grid-template-columns: 11rem 1fr; gap: 2rem; } }
  .il__meta { font-family: var(--font-mono); font-size: .85rem; font-weight: 700; color: var(--color-plano-ciano); }
  .il__t { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; line-height: 1.2; letter-spacing: -.02em; }
  .il__d { margin: .3rem 0 0; line-height: 1.55; color: var(--it-muted); max-width: 64ch; }
</style>
