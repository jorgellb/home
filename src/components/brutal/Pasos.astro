---
/* Proceso en pasos. Aquí el número sí es información: es una secuencia. */
interface Props {
  items: { t: string; d: string }[];
}

const { items } = Astro.props;
---

<ol class="ps">
  {items.map((p) => (
    <li class="ps__step">
      <h3 class="ps__t">{p.t}</h3>
      <p class="ps__d">{p.d}</p>
    </li>
  ))}
</ol>

<style>
  .ps {
    list-style: none; margin: 0; padding: 0;
    counter-reset: paso;
    display: grid; gap: 0; grid-template-columns: 1fr;
    border: 3px solid var(--it-line);
    box-shadow: 8px 8px 0 var(--it-shadow);
  }
  @media (min-width: 900px) { .ps { grid-template-columns: repeat(4, 1fr); } }
  .ps__step {
    counter-increment: paso;
    position: relative;
    padding: 1.5rem 1.4rem 1.6rem;
    background: var(--it-card);
    border-bottom: 3px solid var(--it-line);
  }
  @media (min-width: 900px) { .ps__step { border-bottom: 0; border-right: 3px solid var(--it-line); } .ps__step:last-child { border-right: 0; } }
  .ps__step::before {
    content: 'Paso ' counter(paso);
    display: inline-block;
    margin-bottom: .9rem;
    padding: .2rem .5rem;
    font-family: var(--font-mono); font-size: .76rem; font-weight: 800;
    background: var(--color-plano-tinta); color: var(--color-plano-lima);
  }
  .ps__t { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; line-height: 1.15; letter-spacing: -.02em; }
  .ps__d { margin: .5rem 0 0; line-height: 1.5; color: var(--it-muted); }
</style>
