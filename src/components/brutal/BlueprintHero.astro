---
/* Hero «plano técnico» (brutal tech).
   Una sola secuencia de carga: la retícula se traza, un láser corta el H1 y
   los módulos aterrizan con su sombra dura. El resto del movimiento responde
   al usuario: la cruceta sigue al puntero con coordenadas reales y el vídeo
   recupera el color al pasar por encima.
   Un único <h1> + <h2> gancho. YouTube no se carga hasta que se pide. */

interface Cta {
  href: string;
  label: string;
}

interface Metric {
  label: string;
  value: number;
  decimals?: number;
  unit?: string;
  pct: number;
}

interface Spec {
  k: string;
  v: string;
}

interface Video {
  webm: string;
  mp4: string;
  webmMobile: string;
  mp4Mobile: string;
  posterAvif: string;
  posterJpg: string;
  caption: string;
}

interface Props {
  h1Lines: string[];
  h2: string;
  lead?: string;
  primary: Cta;
  secondary?: Cta;
  place?: string;
  coords?: string;
  proyecto?: string;
  lamina?: string;
  metric?: Metric;
  status?: string;
  video?: Video;
  youtubeId?: string;
  specs?: Spec[];
  size?: 'full' | 'compact';
}

const {
  h1Lines,
  h2,
  lead,
  primary,
  secondary,
  place = 'Vera, Almería',
  coords = '37,2471 N · 1,8673 O',
  proyecto = 'Tu negocio en internet',
  lamina = '01',
  metric,
  status,
  video,
  youtubeId,
  specs = [],
  size = 'full',
} = Astro.props;

const headingId = `bp-h1-${Math.random().toString(36).slice(2, 8)}`;
const revision = new Date().toLocaleDateString('es-ES', { month: 'short', year: 'numeric' });
const fmt = (n: number, d = 0) => n.toFixed(d).replace('.', ',');

// Retícula: 12 columnas, 3 horizontales, una diagonal de construcción y un
// arco de compás. pathLength=1 normaliza el trazado para animarlo igual.
const cols = Array.from({ length: 11 }, (_, i) => (i + 1) * 100);
const rows = [150, 420, 690];
---

<section class={`bp-hero bp-hero--${size}`} data-bp-hero aria-labelledby={headingId}>
  <svg class="bp-grid" viewBox="0 0 1200 800" preserveAspectRatio="none" aria-hidden="true">
    {rows.map((y, i) => <line x1="0" y1={y} x2="1200" y2={y} pathLength="1" style={`--d:${i * 0.08}s`} />)}
    {cols.map((x, i) => <line x1={x} y1="0" x2={x} y2="800" pathLength="1" style={`--d:${0.2 + i * 0.04}s`} />)}
    <line class="bp-grid__diag" x1="0" y1="800" x2="1200" y2="0" pathLength="1" style="--d:.5s" />
    <circle class="bp-grid__arc" cx="930" cy="400" r="300" pathLength="1" style="--d:.7s" />
  </svg>

  <div class="bp-cross" data-bp-cross aria-hidden="true">
    <span class="bp-cross__x"></span>
    <span class="bp-cross__y"></span>
    <span class="bp-cross__read" data-bp-read></span>
  </div>

  <div class="bp-inner container-brutal">
    <p class="bp-coords">
      <span class="bp-coords__c">{coords}</span>
      <span>{place}</span>
    </p>

    <div class="bp-layout">
      <div class="bp-copy">
        <h1 id={headingId} class="bp-h1">
          {h1Lines.map((line, i) => (
            <Fragment>
              <span class="bp-line" style={`--i:${i}`}>
                <span class="bp-line__txt">{line}</span>
                <span class="bp-laser" aria-hidden="true"></span>
              </span>
              {i < h1Lines.length - 1 ? ' ' : ''}
            </Fragment>
          ))}
        </h1>
        <h2 class="bp-h2">{h2}</h2>
        {lead && <p class="bp-lead">{lead}</p>}
        <div class="bp-ctas">
          <a href={primary.href} class="bp-btn bp-btn--ink">{primary.label}</a>
          {secondary && <a href={secondary.href} class="bp-btn bp-btn--line">{secondary.label}</a>}
        </div>
      </div>

      <div class="bp-side">
        {size === 'full' && (
          <div class="bp-bento">
            {metric && (
              <div class="bp-mod bp-mod--metric" style="--k:0">
                <p class="bp-mod__k">{metric.label}</p>
                <p class="bp-mod__v">
                  <span data-bp-count={metric.value} data-decimals={metric.decimals ?? 0}>{fmt(metric.value, metric.decimals)}</span>
                  {metric.unit && <span class="bp-mod__unit">{metric.unit}</span>}
                </p>
                <div class="bp-bar"><i style={`--pct:${metric.pct}%`}></i></div>
              </div>
            )}
            {status && (
              <div class="bp-mod bp-mod--status" style="--k:1">
                <p class="bp-mod__k">Estado</p>
                <p class="bp-mod__v bp-mod__v--sm">{status}</p>
                <span class="bp-pulse" aria-hidden="true"></span>
              </div>
            )}
            {video && (
              <figure class="bp-mod bp-mod--video" style="--k:2">
                <div class="bp-video" aria-hidden="true">
                  <picture>
                    <source srcset={video.posterAvif} type="image/avif" />
                    <img src={video.posterJpg} alt="" width="960" height="540" fetchpriority="high" decoding="async" />
                  </picture>
                  <video data-bp-video muted playsinline loop preload="none" disablepictureinpicture>
                    <source data-src={video.webmMobile} type='video/webm; codecs="av01.0.05M.08"' media="(max-width: 767px)" />
                    <source data-src={video.mp4Mobile} type='video/mp4; codecs="avc1.42E01E"' media="(max-width: 767px)" />
                    <source data-src={video.webm} type='video/webm; codecs="av01.0.08M.08"' />
                    <source data-src={video.mp4} type='video/mp4; codecs="avc1.42E028"' />
                  </video>
                  <span class="bp-scan"></span>
                </div>
                <figcaption class="bp-video__cap">
                  <span class="bp-rec" aria-hidden="true"></span>{video.caption}
                </figcaption>
                <div class="bp-video__actions">
                  <button type="button" class="bp-chip" data-bp-pause aria-pressed="false" hidden>Pausar vídeo</button>
                  {youtubeId && (
                    <button type="button" class="bp-chip bp-chip--lima" data-bp-yt-open data-yt-id={youtubeId}>Ver vídeo completo</button>
                  )}
                </div>
              </figure>
            )}
          </div>
        )}

        {size === 'compact' && specs.length > 0 && (
          <dl class="bp-specs bp-mod" style="--k:0">
            {specs.map((s) => (
              <div class="bp-specs__row">
                <dt>{s.k}</dt>
                <dd>{s.v}</dd>
              </div>
            ))}
          </dl>
        )}

        <dl class="bp-cajetin">
          <div><dt>Proyecto</dt><dd>{proyecto}</dd></div>
          <div><dt>Lámina</dt><dd>{lamina}</dd></div>
          <div><dt>Escala</dt><dd>1:1</dd></div>
          <div><dt>Revisión</dt><dd>{revision}</dd></div>
        </dl>
      </div>
    </div>

    <p class="bp-dim" aria-hidden="true">
      <span class="bp-dim__line"></span>
      <span class="bp-dim__val"><span data-bp-width>1440</span> px</span>
    </p>
  </div>

  {youtubeId && (
    <dialog class="bp-yt" data-bp-yt aria-label="Vídeo completo">
      <div class="bp-yt__box">
        <button type="button" class="bp-chip bp-chip--papel" data-bp-yt-close>Cerrar vídeo</button>
        <div class="bp-yt__frame" data-bp-yt-frame></div>
      </div>
    </dialog>
  )}
</section>

<script>
  const fmt = (n: number, d: number) => n.toFixed(d).replace('.', ',');

  document.querySelectorAll<HTMLElement>('[data-bp-hero]').forEach((hero) => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Cifra que cuenta hasta su valor cuando aterriza su módulo
    hero.querySelectorAll<HTMLElement>('[data-bp-count]').forEach((el) => {
      if (reduce) return;
      const target = Number(el.dataset.bpCount);
      const decimals = Number(el.dataset.decimals ?? 0);
      const start = performance.now() + 1100;
      const duration = 1400;
      el.textContent = fmt(0, decimals);
      const tick = (now: number) => {
        const p = Math.min(Math.max((now - start) / duration, 0), 1);
        el.textContent = fmt(target * (1 - Math.pow(1 - p, 3)), decimals);
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });

    // Cota con el ancho real de la sección
    const width = hero.querySelector<HTMLElement>('[data-bp-width]');
    if (width) {
      const update = () => { width.textContent = Math.round(hero.clientWidth).toLocaleString('es-ES'); };
      update();
      new ResizeObserver(update).observe(hero);
    }

    // Cruceta con coordenadas: solo con ratón y sin reduced-motion
    const cross = hero.querySelector<HTMLElement>('[data-bp-cross]');
    const read = cross?.querySelector<HTMLElement>('[data-bp-read]');
    if (cross && !reduce && window.matchMedia('(pointer: fine)').matches) {
      let frame = 0;
      hero.addEventListener('pointermove', (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const rect = hero.getBoundingClientRect();
          const x = Math.round(event.clientX - rect.left);
          const y = Math.round(event.clientY - rect.top);
          cross.style.setProperty('--mx', `${x}px`);
          cross.style.setProperty('--my', `${y}px`);
          if (read) read.textContent = `x ${x} · y ${y}`;
          cross.classList.add('is-on');
        });
      });
      hero.addEventListener('pointerleave', () => cross.classList.remove('is-on'));
    }

    // Vídeo del dron: entra después de load, nunca con reduced-motion ni ahorro de datos
    const video = hero.querySelector<HTMLVideoElement>('[data-bp-video]');
    const pause = hero.querySelector<HTMLButtonElement>('[data-bp-pause]');
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (video && !reduce && !connection?.saveData) {
      const start = () => {
        video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
          source.src = source.dataset.src ?? '';
        });
        video.load();
        video.play()
          .then(() => {
            video.classList.add('is-playing');
            if (pause) pause.hidden = false;
          })
          .catch(() => { /* autoplay bloqueado: se queda el póster */ });
      };
      if (document.readyState === 'complete') setTimeout(start, 400);
      else window.addEventListener('load', () => setTimeout(start, 400), { once: true });

      pause?.addEventListener('click', () => {
        const paused = video.paused;
        if (paused) void video.play();
        else video.pause();
        pause.setAttribute('aria-pressed', String(!paused));
        pause.textContent = paused ? 'Pausar vídeo' : 'Reanudar vídeo';
      });
    }

    // Vídeo completo de YouTube bajo demanda
    const openBtn = hero.querySelector<HTMLButtonElement>('[data-bp-yt-open]');
    const dialog = hero.querySelector<HTMLDialogElement>('[data-bp-yt]');
    const frameWrap = dialog?.querySelector<HTMLElement>('[data-bp-yt-frame]');
    if (openBtn && dialog && frameWrap) {
      openBtn.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(openBtn.dataset.ytId ?? '')}?autoplay=1&rel=0`;
        iframe.title = 'Vídeo completo grabado con dron';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        frameWrap.replaceChildren(iframe);
        video?.pause();
        dialog.showModal();
      });
      dialog.addEventListener('close', () => {
        frameWrap.replaceChildren();
        if (video?.classList.contains('is-playing') && pause?.getAttribute('aria-pressed') !== 'true') void video.play();
      });
      dialog.querySelector('[data-bp-yt-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  });
</script>

<style>
  .bp-hero {
    --ink: var(--color-plano-tinta);
    --line: var(--color-plano-reticula);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-plano-papel);
    color: var(--ink);
    border-bottom: 3px solid var(--ink);
    font-family: var(--font-display);
  }

  /* — Retícula que se traza — */
  .bp-grid { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .bp-grid line,
  .bp-grid circle {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .bp-grid__diag { stroke-dasharray: .006 .006 !important; }
  .bp-grid__arc { stroke: rgb(36 71 224 / .22) !important; }

  /* — Cruceta — */
  .bp-cross { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity .25s; }
  .bp-cross.is-on { opacity: 1; }
  .bp-cross__x, .bp-cross__y { position: absolute; background: var(--color-plano-ciano); opacity: .45; }
  .bp-cross__x { left: 0; right: 0; height: 1px; top: var(--my, 50%); }
  .bp-cross__y { top: 0; bottom: 0; width: 1px; left: var(--mx, 50%); }
  .bp-cross__read {
    position: absolute;
    left: calc(var(--mx, 50%) + 12px);
    top: calc(var(--my, 50%) + 12px);
    font-family: var(--font-mono);
    font-size: .68rem;
    color: var(--color-plano-ciano);
    background: var(--color-plano-papel);
    padding: .1rem .35rem;
    border: 1px solid var(--color-plano-ciano);
    white-space: nowrap;
  }

  .bp-inner { position: relative; z-index: 1; padding-block: clamp(1.25rem, 3vw, 2rem) 1.25rem; }

  .bp-coords {
    margin: 0 0 clamp(1.5rem, 4vw, 3rem);
    display: flex; flex-wrap: wrap; gap: .25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: .74rem;
    color: var(--color-plano-grafito);
  }
  .bp-coords__c { color: var(--color-plano-ciano); }

  .bp-layout { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 1024px) {
    .bp-layout { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3.5rem; }
  }

  /* — H1 cortado con láser — */
  .bp-h1 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(3rem, 8.2vw, 7.4rem);
    line-height: .92;
    letter-spacing: -.045em;
    font-variation-settings: 'opsz' 96;
  }
  .bp-hero--compact .bp-h1 { font-size: clamp(2.2rem, 4.6vw, 4.2rem); line-height: .98; }
  .bp-line { position: relative; display: block; width: fit-content; max-width: 100%; }
  .bp-line__txt { display: block; }
  .bp-laser { display: none; }

  .bp-h2 {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    max-width: 34ch;
    font-weight: 500;
    font-size: clamp(1.15rem, 1.9vw, 1.55rem);
    line-height: 1.3;
    letter-spacing: -.01em;
    color: #2a2622;
  }

  .bp-lead { margin: 1rem 0 0; max-width: 60ch; font-size: 1.05rem; line-height: 1.6; color: #3a352f; }
  .bp-ctas { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: clamp(1.5rem, 3vw, 2.25rem); }
  .bp-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3.1rem;
    padding: .85rem 1.5rem;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: .92rem;
    text-decoration: none;
    border: 3px solid var(--ink);
    transition: transform .15s, box-shadow .15s, background .15s, color .15s;
  }
  .bp-btn--ink { background: var(--ink); color: var(--color-plano-lima); box-shadow: 6px 6px 0 var(--color-plano-naranja); }
  .bp-btn--line { background: transparent; color: var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .bp-btn:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--ink); }
  .bp-btn--ink:hover { background: var(--color-plano-naranja); color: var(--ink); }
  .bp-btn:active { transform: translate(3px, 3px); box-shadow: 0 0 0 var(--ink); }
  .bp-btn:focus-visible, .bp-chip:focus-visible { outline: 3px solid var(--color-plano-ciano); outline-offset: 4px; }

  /* — Lado derecho: bento, ficha y cajetín — */
  .bp-side { display: grid; gap: 1.5rem; }
  .bp-bento { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .bp-mod {
    position: relative;
    margin: 0;
    padding: 1rem 1.1rem;
    background: var(--color-plano-blanco);
    border: 3px solid var(--ink);
    box-shadow: 7px 7px 0 var(--ink);
  }
  .bp-mod__k { margin: 0; font-family: var(--font-mono); font-size: .72rem; color: var(--color-plano-grafito); }
  .bp-mod__v { margin: .2rem 0 0; font-weight: 800; font-size: clamp(2rem, 3.4vw, 2.9rem); line-height: 1; letter-spacing: -.04em; }
  .bp-mod__v--sm { font-size: clamp(1.25rem, 2vw, 1.6rem); letter-spacing: -.02em; }
  .bp-mod__unit { font-size: .45em; margin-left: .15em; letter-spacing: 0; }
  .bp-bar { height: 8px; margin-top: .8rem; background: var(--line); }
  .bp-bar i { display: block; height: 100%; width: var(--pct); background: var(--color-plano-naranja); }
  .bp-mod--status { background: var(--color-plano-lima); }
  .bp-pulse { position: absolute; top: .9rem; right: .9rem; width: 12px; height: 12px; border-radius: 50%; background: var(--ink); }

  .bp-mod--video { grid-column: 1 / -1; padding: 0; background: var(--ink); overflow: hidden; }
  .bp-video { position: relative; aspect-ratio: 16 / 9; }
  .bp-video img, .bp-video video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.15) brightness(1.05);
    transition: filter .5s;
  }
  .bp-video video { opacity: 0; transition: opacity .8s, filter .5s; }
  .bp-video video.is-playing { opacity: 1; }
  .bp-video::after {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: var(--color-plano-naranja); mix-blend-mode: multiply; opacity: .55;
    transition: opacity .5s;
  }
  .bp-mod--video:hover .bp-video img, .bp-mod--video:hover .bp-video video,
  .bp-mod--video:focus-within .bp-video img, .bp-mod--video:focus-within .bp-video video { filter: none; }
  .bp-mod--video:hover .bp-video::after, .bp-mod--video:focus-within .bp-video::after { opacity: 0; }
  .bp-scan { display: none; }
  .bp-video__cap {
    position: absolute; left: .8rem; top: .7rem; z-index: 2;
    display: flex; align-items: center; gap: .45rem;
    font-family: var(--font-mono); font-size: .72rem; color: var(--color-plano-lima);
  }
  .bp-rec { width: 9px; height: 9px; border-radius: 50%; background: #ff3b30; }
  .bp-video__actions { position: absolute; right: .7rem; bottom: .7rem; z-index: 2; display: flex; flex-wrap: wrap; gap: .45rem; justify-content: flex-end; }
  .bp-chip {
    min-height: 2.25rem;
    padding: .4rem .7rem;
    font-family: var(--font-mono); font-size: .72rem; font-weight: 700;
    color: var(--color-plano-papel); background: rgb(14 13 11 / .7);
    border: 2px solid var(--color-plano-papel);
    cursor: pointer;
  }
  .bp-chip--lima { background: var(--color-plano-lima); color: var(--ink); border-color: var(--ink); }
  .bp-chip--papel { background: var(--color-plano-papel); color: var(--ink); border-color: var(--ink); }

  .bp-specs { display: grid; gap: 0; padding: 0; }
  .bp-specs__row { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 1.1rem; border-bottom: 1px solid var(--line); }
  .bp-specs__row:last-child { border-bottom: 0; }
  .bp-specs dt { font-family: var(--font-mono); font-size: .76rem; color: var(--color-plano-grafito); }
  .bp-specs dd { margin: 0; font-weight: 700; text-align: right; }

  .bp-cajetin {
    margin: 0;
    display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    border: 3px solid var(--ink);
    background: var(--color-plano-papel);
    font-family: var(--font-mono);
  }
  .bp-cajetin > div { padding: .45rem .6rem; border-right: 1px solid var(--ink); min-width: 0; }
  .bp-cajetin > div:last-child { border-right: 0; }
  .bp-cajetin dt { font-size: .6rem; color: var(--color-plano-grafito); }
  .bp-cajetin dd { margin: .1rem 0 0; font-size: .74rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 480px) {
    .bp-cajetin { grid-template-columns: 1fr 1fr; }
    .bp-cajetin > div:nth-child(2) { border-right: 0; }
    .bp-cajetin > div:nth-child(-n+2) { border-bottom: 1px solid var(--ink); }
  }

  .bp-dim {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    display: flex; align-items: center; gap: .75rem;
    font-family: var(--font-mono); font-size: .7rem; color: var(--color-plano-ciano);
  }
  .bp-dim__line { flex: 1; height: 1px; background: var(--color-plano-ciano); position: relative; opacity: .6; }
  .bp-dim__line::before, .bp-dim__line::after { content: ''; position: absolute; top: -4px; width: 1px; height: 9px; background: var(--color-plano-ciano); }
  .bp-dim__line::before { left: 0; }
  .bp-dim__line::after { right: 0; }

  .bp-yt { width: min(92vw, 1100px); padding: 0; border: 0; background: transparent; }
  .bp-yt::backdrop { background: rgb(14 13 11 / .88); }
  .bp-yt__box { display: flex; flex-direction: column; align-items: flex-end; gap: .5rem; }
  .bp-yt__frame { width: 100%; aspect-ratio: 16 / 9; background: #000; border: 3px solid var(--color-plano-lima); }
  .bp-yt__frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }

  /* ═════ Secuencia de carga (solo si el usuario acepta movimiento) ═════ */
  @media (prefers-reduced-motion: no-preference) {
    .bp-grid line, .bp-grid circle {
      stroke-dashoffset: 1;
