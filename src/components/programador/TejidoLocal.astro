---
/* El tejido productivo del municipio, cruzado con lo que resuelve cada
 * tecnología.
 *
 * Es un grafo bipartito: a la izquierda los sectores REALES documentados de
 * ese pueblo, a la derecha las tecnologías que tienen algo concreto que hacer
 * por ellos, y entre medias las conexiones que existen de verdad. Dos
 * municipios nunca dan el mismo dibujo porque nunca tienen los mismos
 * sectores: el de Macael sale denso por el lado industrial y el de Mojácar
 * por el turístico, y eso se ve de un vistazo antes de leer una palabra.
 *
 * Ninguna línea es decorativa: cada una existe porque esa familia de sector
 * tiene escrita una necesidad para esa tecnología en `sectores.ts`. Si alguien
 * añade líneas para que quede más lleno, el dibujo deja de ser cierto y pierde
 * lo único que lo justifica.
 */
import { TECNOLOGIAS, ORDEN_TECNOLOGIAS } from '../../data/tecnologias';
import { sectoresDe } from '../../data/programador-gate';
import { familiaDe } from '../../data/sectores';

interface Props { municipio: string; nombre: string }
const { municipio, nombre } = Astro.props;

const MAX_SECTORES = 6;

/* Sector -> tecnologías que lo resuelven, tal cual está escrito en los datos. */
const sectores = sectoresDe(municipio)
  .slice(0, MAX_SECTORES)
  .map((sector) => {
    const familia = familiaDe(sector);
    const tecs = familia
      ? ORDEN_TECNOLOGIAS.filter((t) => familia.necesidades[t])
      : [];
    return { sector, familia, tecs };
  })
  .filter((s) => s.tecs.length > 0);

/* Solo las tecnologías que aparecen, en el orden del clúster. */
const tecnologias = ORDEN_TECNOLOGIAS.filter((t) => sectores.some((s) => s.tecs.includes(t)));

const ALTO_FILA = 34;
const alto = Math.max(sectores.length, tecnologias.length) * ALTO_FILA + 76;
/* La columna de sectores empieza lo bastante a la derecha para que quepan sus
   nombres completos: con menos margen, «Marmolistas y Exportación» se salía
   del encuadre por la izquierda y se leía «molistas y Exportación». */
const X_SEC = 152;
const X_TEC = 244;
/* A 9 px en monoespaciada cada carácter ocupa ~5,4 px; 25 caracteres son unos
   135 px y la etiqueta acaba en X_SEC − 12. */
const MAX_CARACTERES = 25;

const ySector = (i: number) => 58 + i * ALTO_FILA + (Math.max(0, tecnologias.length - sectores.length) * ALTO_FILA) / 2;
const yTec = (i: number) => 58 + i * ALTO_FILA + (Math.max(0, sectores.length - tecnologias.length) * ALTO_FILA) / 2;

/* Curva suave entre sector y tecnología: una recta con tantas líneas se
   convierte en una maraña ilegible. */
function curva(y1: number, y2: number): string {
  const c = (X_SEC + X_TEC) / 2;
  return `M${X_SEC} ${y1} C${c} ${y1}, ${c} ${y2}, ${X_TEC} ${y2}`;
}

const conexiones = sectores.flatMap((s, i) =>
  s.tecs.map((t) => ({
    d: curva(ySector(i), yTec(tecnologias.indexOf(t))),
    /* La primera conexión de cada sector se marca: es la que encabeza la
       página y conviene poder seguirla con la vista. */
    principal: t === s.tecs[0],
  })),
);

const corta = (t: string, n: number) => (t.length > n ? `${t.slice(0, n - 1)}…` : t);
const idDesc = `tejido-${municipio}`;
const descripcion = sectores.length
  ? `Qué se mueve en ${nombre} y con qué se resuelve: `
    + sectores.map((s) => `${s.sector} con ${s.tecs.map((t) => TECNOLOGIAS[t].etiqueta).join(' o ')}`).join('; ')
    + '.'
  : `Todavía no hay sectores documentados de ${nombre}.`;
---

{sectores.length > 0 && (
  <figure class="tej">
    <div class="tej__marco pw-tram">
      <span class="tej__esq tej__esq--ai" aria-hidden="true"></span>
      <span class="tej__esq tej__esq--ad" aria-hidden="true"></span>
      <span class="tej__esq tej__esq--bi" aria-hidden="true"></span>
      <span class="tej__esq tej__esq--bd" aria-hidden="true"></span>

      <svg class="tej__svg" viewBox={`0 0 392 ${alto}`} fill="none" role="img" aria-labelledby={idDesc}>
        <title id={idDesc}>{descripcion}</title>

        <text x="14" y="32" class="t-tag">lo que se mueve en {nombre.toLowerCase()}</text>
        <text x="378" y="32" class="t-tag" text-anchor="end">con qué se resuelve</text>
        <line x1="14" y1="42" x2="378" y2="42" class="t-regla" />

        {/* Conexiones detrás de los nodos, para que no los tapen */}
        {conexiones.map((c) => (
          <path d={c.d} class={c.principal ? 't-linea t-linea--on' : 't-linea'} />
        ))}

        {/* Sectores reales del municipio */}
        {sectores.map((s, i) => (
          <g>
            <text x={X_SEC - 12} y={ySector(i) + 3.5} class="t-sec" text-anchor="end">{corta(s.sector, MAX_CARACTERES)}</text>
            <circle cx={X_SEC} cy={ySector(i)} r="3.4" class="t-punto t-punto--sec" />
          </g>
        ))}

        {/* Tecnologías que tienen algo que hacer aquí */}
        {tecnologias.map((t, i) => (
          <g>
            <circle cx={X_TEC} cy={yTec(i)} r="3.4" class="t-punto t-punto--tec" />
            <text x={X_TEC + 11} y={yTec(i) + 3.5} class="t-tec">{TECNOLOGIAS[t].etiqueta}</text>
          </g>
        ))}

        <line x1="14" y1={alto - 30} x2="378" y2={alto - 30} class="t-regla" />
        <text x="14" y={alto - 14} class="t-pie">
          {sectores.length} sectores · {conexiones.length} encajes documentados
        </text>
      </svg>
    </div>
  </figure>
)}

<style>
  .tej { margin: 0; }
  .tej__marco {
    position: relative;
    border: 1px solid var(--pw-regla-2);
    background: var(--pw-panel);
    padding: clamp(.8rem, 2.5vw, 1.3rem);
  }
  .tej__esq { position: absolute; width: 9px; height: 9px; border: 1px solid var(--pw-marca); opacity: .5; }
  .tej__esq--ai { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .tej__esq--ad { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .tej__esq--bi { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .tej__esq--bd { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
  .tej__svg { display: block; width: 100%; height: auto; }

  .tej__svg :global(.t-regla) { stroke: var(--pw-regla); stroke-width: 1; }
  .tej__svg :global(.t-linea) { stroke: var(--pw-regla-2); stroke-width: 1; fill: none; }
  .tej__svg :global(.t-linea--on) { stroke: var(--pw-luego); stroke-width: 1.3; opacity: .85; }
  .tej__svg :global(.t-punto--sec) { fill: var(--pw-marca); }
  .tej__svg :global(.t-punto--tec) { fill: var(--pw-luego); }

  .tej__svg :global(.t-tag) {
    font-family: var(--font-mono, monospace); font-size: 8.5px;
    letter-spacing: .1em; fill: var(--pw-tenue);
  }
  .tej__svg :global(.t-sec) { font-family: var(--font-mono, monospace); font-size: 9px; fill: var(--pw-texto); }
  .tej__svg :global(.t-tec) { font-family: var(--font-mono, monospace); font-size: 9.5px; fill: var(--pw-luego); }
  .tej__svg :global(.t-pie) { font-family: var(--font-mono, monospace); font-size: 8px; fill: var(--pw-tenue); }
</style>
