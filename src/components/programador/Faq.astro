---
interface Props { faq: { q: string; a: string }[] }
const { faq } = Astro.props;
---
<div class="pw-faq">
  {faq.map((f) => (
    <details class="pw-faq__item">
      <summary class="pw-faq__q">{f.q}</summary>
      <p class="pw-faq__a">{f.a}</p>
    </details>
  ))}
</div>

<style>
  .pw-faq { display: grid; gap: .6rem; max-width: 76ch; }
  .pw-faq__item { border: 1px solid var(--color-cdm-regla); background: var(--color-cdm-panel-2); }
  .pw-faq__q { cursor: pointer; padding: 1rem 1.2rem; color: var(--color-cdm-texto); font-weight: 600; line-height: 1.4; }
  .pw-faq__q:focus-visible { outline: 2px solid var(--color-cdm-senal); outline-offset: -2px; }
  .pw-faq__a { margin: 0; padding: 0 1.2rem 1.1rem; color: #b9c5cf; line-height: 1.65; }
</style>
