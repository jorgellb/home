---
/* Los servicios NO van numerados: no son una secuencia, son un repertorio, y
   numerar lo que no tiene orden es el adorno que delata una plantilla. Se
   resuelven con reglas y una marca de encuadre, que es lo que los agrupa sin
   convertirlos en seis tarjetas iguales. */
import type { Servicio } from '../../data/tecnologias';
interface Props { servicios: Servicio[] }
const { servicios } = Astro.props;
---
<ul class="srv">
  {servicios.map((s) => (
    <li class="srv__i">
      <h3 class="srv__t">{s.titulo}</h3>
      <p class="srv__d">{s.descripcion}</p>
    </li>
  ))}
</ul>

<style>
  .srv {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    border-top: 1px solid var(--pw-regla-2);
  }
  .srv__i {
    padding: 1.1rem 0 1.2rem;
    border-bottom: 1px solid var(--pw-regla);
    position: relative;
    padding-left: 1.1rem;
  }
  /* Un guion de trazo, no un icono: marca el elemento sin decorarlo. */
  .srv__i::before {
    content: ''; position: absolute; left: 0; top: 1.5rem;
    width: .55rem; height: 1px; background: var(--pw-marca);
  }
  .srv__t { margin: 0 0 .3rem; font-size: 1.02rem; font-weight: 700; letter-spacing: -.01em; }
  .srv__d { margin: 0; font-size: .95rem; line-height: 1.6; }

  @media (min-width: 720px) {
    .srv { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; }
  }
  @media (min-width: 1100px) {
    .srv { grid-template-columns: repeat(3, 1fr); }
  }
</style>
