---
/* Cómo llega el encargo y qué se hace. Va en primera posición porque es lo que
   distingue este clúster de /diseno-web/: aquí el cliente ya tiene algo. */
import type { Situacion } from '../../data/tecnologias';
interface Props { situaciones: Situacion[] }
const { situaciones } = Astro.props;
---
<ul class="pw-sit">
  {situaciones.map((s) => (
    <li class="pw-sit__item">
      <p class="pw-sit__encargo">«{s.encargo}»</p>
      <p class="pw-sit__resp">{s.respuesta}</p>
    </li>
  ))}
</ul>

<style>
  .pw-sit { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--color-cdm-regla); border: 1px solid var(--color-cdm-regla); }
  .pw-sit__item { background: var(--color-cdm-panel-2); padding: 1.5rem; }
  .pw-sit__encargo {
    margin: 0 0 .7rem; color: var(--color-cdm-senal);
    font-size: 1.05rem; line-height: 1.45; font-style: italic;
  }
  .pw-sit__resp { margin: 0; color: #b9c5cf; line-height: 1.65; }
  @media (min-width: 900px) { .pw-sit { grid-template-columns: 1fr 1fr; } }
</style>
