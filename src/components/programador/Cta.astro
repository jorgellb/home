---
/* El texto lo pone quien llama: un «cuéntame qué necesitas» idéntico en las
   siete tecnologías sería otra plantilla. */
interface Props { titulo: string; texto: string; servicio: string }
const { titulo, texto, servicio } = Astro.props;
const href = `/contacto/?servicio=${encodeURIComponent(servicio)}#contacto`;
---
<section class="cta pw-tram">
  <div class="container-brutal cta__in">
    <div class="cta__txt">
      <h2 class="cta__t">{titulo}</h2>
      <p class="cta__p">{texto}</p>
    </div>
    <a class="cta__b" href={href}>Contar el proyecto</a>
  </div>
</section>

<style>
  .cta {
    background: var(--pw-panel);
    border-block: 1px solid var(--pw-regla-2);
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
  }
  .cta__in { display: grid; gap: 1.75rem; align-items: end; }
  .cta__txt { max-width: 56ch; }
  .cta__t { margin: 0 0 .6rem; font-size: clamp(1.4rem, 3.2vw, 2rem); font-weight: 800; line-height: 1.12; }
  .cta__p { margin: 0; line-height: 1.65; }
  .cta__b {
    justify-self: start;
    display: inline-block; padding: .95rem 1.7rem;
    background: var(--pw-marca); color: #0a0a0a;
    font-weight: 700; text-decoration: none;
    border: 1px solid var(--pw-marca);
    transition: background .18s var(--pw-curva), color .18s var(--pw-curva);
  }
  .cta__b:hover, .cta__b:focus-visible { background: transparent; color: var(--pw-marca); }
  @media (min-width: 900px) { .cta__in { grid-template-columns: 1fr auto; } }
</style>
