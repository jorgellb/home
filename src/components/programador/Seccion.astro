---
/* Envoltorio de sección. La referencia monoespaciada de la izquierda no es un
   "eyebrow" decorativo: numera la sección dentro de la página, igual que la
   canaleta de un editor numera las líneas, y sirve para citarla. */
interface Props {
  id?: string;
  ref?: string;
  titulo: string;
  lead?: string;
  tono?: 'suelo' | 'panel';
  nivel?: 2 | 3;
}
const { id, ref, titulo, lead, tono = 'suelo', nivel = 2 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
---
<section id={id} class:list={['sec', `sec--${tono}`]}>
  <div class="container-brutal">
    <header class="sec__head">
      {ref && <p class="pw-ref sec__ref">{ref}</p>}
      <Titulo class="sec__t">{titulo}</Titulo>
      {lead && <p class="sec__lead">{lead}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .sec { padding: clamp(2.5rem, 6vw, 4rem) 0; border-block-start: 1px solid var(--pw-regla); }
  .sec--suelo { background: var(--pw-suelo); }
  .sec--panel { background: var(--pw-panel-2); }
  .sec__head { max-width: 64ch; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .sec__ref { margin: 0 0 .5rem; }
  .sec__t { font-size: clamp(1.55rem, 3.6vw, 2.3rem); font-weight: 800; line-height: 1.08; margin: 0; }
  .sec__lead { margin: .8rem 0 0; font-size: 1.02rem; line-height: 1.65; }
</style>
