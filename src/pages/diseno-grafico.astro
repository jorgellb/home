  }
  .dg-hero__halftone--c {
    mask-image: radial-gradient(circle at 80% 70%, black 0%, transparent 55%);
    -webkit-mask-image: radial-gradient(circle at 80% 70%, black 0%, transparent 55%);
  }

  /* Formas geométricas */
  .dg-shape {
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }
  .dg-shape--circle {
    width: 140px; height: 140px;
    border-radius: 50%;
    background: var(--c-magenta);
    border: 4px solid var(--c-ink);
    top: 8%; right: 6%;
    animation: dg-float 8s ease-in-out infinite;
    box-shadow: 8px 8px 0 var(--c-ink);
  }
  .dg-shape--square {
    width: 110px; height: 110px;
    background: var(--c-cyan);
    border: 4px solid var(--c-ink);
    top: 65%; left: 4%;
    transform: rotate(15deg);
    animation: dg-float 11s ease-in-out infinite;
    animation-delay: -3s;
    box-shadow: 8px 8px 0 var(--c-ink);
