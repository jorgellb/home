  .dg-shape--triangle { width: 90px; height: 90px; top: 15%; left: 45%; transform: rotate(-12deg); animation: dg-float 9s ease-in-out infinite; animation-delay: -5s; }
  .dg-shape--triangle svg { filter: drop-shadow(6px 6px 0 var(--c-ink)); }
