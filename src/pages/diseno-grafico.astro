---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Diseño Gráfico y Branding en Almería';
const description = 'Diseño gráfico en Almería. Identidad corporativa, logotipos, branding y señalética. Impulsa tu imagen de marca. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/diseno-grafico/';

const services = [
  { n: '01', title: 'Identidad corporativa',  kicker: 'Logo · Manual · Naming',          desc: 'La base de tu marca. Identidades con alma y coherencia visual que conectan con tu audiencia y aguantan el paso del tiempo.', features: ['Diseño de logotipo','Manual de identidad','Naming corporativo','Rediseño de marca'], color: 'magenta' },
  { n: '02', title: 'Señalética y exterior',   kicker: 'Vehículos · Fachadas · Vallas',   desc: 'Impacto visual en el mundo real. Diseño especializado para gran formato que capta la atención desde lejos.', features: ['Rotulación de vehículos','Señalética permanente','Fachadas y rótulos','Publicidad exterior'], color: 'cyan' },
  { n: '03', title: 'Editorial y maquetación', kicker: 'Revistas · Catálogos · Brochures', desc: 'Diseño editorial digital e impreso con criterio: jerarquía visual, legibilidad y estética profesional.', features: ['Revistas y editorial','Catálogos comerciales','Brochures corporativos','Dípticos y trípticos'], color: 'yellow' },
  { n: '04', title: 'Papelería comercial',      kicker: 'Tarjetas · Membrete · Flyers',   desc: 'Todo lo que tu empresa necesita para el día a día. Profesionalidad tangible en cada detalle.', features: ['Tarjetas de visita','Papelería corporativa','Flyers y volantes','Kit de bienvenida'], color: 'lime' },
  { n: '05', title: 'Diseño digital',            kicker: 'Ads · Banners · Social · Email', desc: 'Tu marca en el ecosistema digital. Creatividades que convierten visitantes en clientes.', features: ['Creatividades para Ads','Banners web responsive','Newsletters HTML','Social media kits'], color: 'cobalt' },
  { n: '06', title: 'Packaging',                 kicker: 'Etiquetas · Cajas · Envases',    desc: 'Diseño de packaging que vende desde el estante. Etiquetas, cajas y envases que elevan tu producto.', features: ['Etiquetas de producto','Cajas y embalaje','Envases con troquel','Materiales sostenibles'], color: 'coral' },
];

const palette = [
  { name: 'PLÁTANO',  hex: '#FF5A00', cmyk: '0 · 75 · 100 · 0',  rgb: '255 · 90 · 0',  use: 'Brand primary · acentos' },
  { name: 'MAGENTA',   hex: '#FF2D9A', cmyk: '0 · 85 · 32 · 0',  rgb: '255 · 45 · 154', use: 'Energía · disrupción' },
  { name: 'CIAN',      hex: '#00E5FF', cmyk: '60 · 0 · 5 · 0',   rgb: '0 · 229 · 255',  use: 'Tech · digital' },
  { name: 'AMARILLO',  hex: '#FFEB00', cmyk: '5 · 0 · 95 · 0',   rgb: '255 · 235 · 0',  use: 'Atención · alerta' },
  { name: 'LIMA',      hex: '#D6FF44', cmyk: '20 · 0 · 90 · 0',  rgb: '214 · 255 · 68', use: 'Movimiento · CTA' },
  { name: 'COBALTO',   hex: '#0040FF', cmyk: '95 · 80 · 0 · 0',  rgb: '0 · 64 · 255',   use: 'Autoridad · profundidad' },
  { name: 'CORAL',     hex: '#FF6B6B', cmyk: '0 · 70 · 50 · 0',  rgb: '255 · 107 · 107', use: 'Calidez · cercanía' },
  { name: 'TINTA',     hex: '#0E0D0B', cmyk: '70 · 70 · 70 · 100', rgb: '14 · 13 · 11',  use: 'Texto · estructura' },
];

const differentiators = [
  { k: 'Adobe Suite Pro',   v: 'Photoshop · Illustrator · InDesign · After Effects · Premiere · Figma' },
  { k: 'Diseño estratégico', v: 'Cada pieza tiene un objetivo claro de conversión, no solo "bonito"' },
  { k: 'Entrega exprés',    v: '24–48h disponible para proyectos urgentes sin sacrificar calidad' },
  { k: 'Atención directa',  v: 'Trabajas directamente con diseñadores senior · sin intermediarios' },
  { k: 'Archivos abiertos', v: 'Editables · vectoriales · web · print · todo lo que necesites' },
  { k: 'Print partner',     v: 'Coordinación con imprenta local y nacional · prueba color · acabados' },
];

const process = [
  { num: '01', title: 'Briefing',     eta: '1–2 días', body: 'Reunión inicial para entender tu marca, objetivos, competencia y público objetivo. Rellenamos un briefing completo.', deliverable: 'Briefing + dirección creativa', color: 'magenta' },
  { num: '02', title: 'Propuestas',   eta: '5–7 días', body: 'Presentamos 2–3 propuestas creativas con mockups. Explicamos el concepto detrás de cada diseño y sus ventajas.', deliverable: '2–3 rutas creativas con mockups', color: 'cyan' },
  { num: '03', title: 'Refinamiento', eta: '3–5 días', body: 'Iteramos sobre la propuesta elegida: ajustes de color, tipografía, composición. Hasta que estés 100% satisfecho.', deliverable: 'Diseño final aprobado', color: 'yellow' },
  { num: '04', title: 'Entrega',      eta: '1 día',    body: 'Archivos finales en todos los formatos: editables, vectoriales, web, impresión. Listos para usar.', deliverable: 'Paquete completo + manual de uso', color: 'lime' },
];

const sectors = [
  { title: 'Hostelería y gastronomía', desc: 'Identidad de marca, carta menú, packaging y señalética para restaurantes, cafeterías y obradores.' },
  { title: 'Cosmética y wellness',     desc: 'Branding y packaging para marcas que necesitan transmitir confianza y calidad en el estante.' },
  { title: 'Industria y B2B',          desc: 'Identidades sólidas, brochures comerciales y catálogos para empresas que venden a empresas.' },
  { title: 'Startups y SaaS',          desc: 'Branding ágil para productos digitales. Logo, sistema y guidelines listos en 2 semanas.' },
  { title: 'Inmobiliarias',            desc: 'Marca, dossier comercial, valla y rotulación para agencias que quieren destacar.' },
  { title: 'Cultura y eventos',        desc: 'Carteles, programa, identidad de festival y materiales gráficos para eventos culturales.' },
];

const testimonials = [
  { text: 'Llevábamos años con un logo improvisado. El rediseño y el manual de identidad nos cambió la forma de presentarnos. Por primera vez parecemos los profesionales que somos.', author: 'Sara M.',   role: 'Founder · Clínica estética · Almería' },
  { text: 'La rotulación de la flota fue espectacular. Cinco vehículos como anuncio andante 24/7. Los presupuestos entrantes se duplicaron en tres meses.',                         author: 'Pedro V.',  role: 'Gerente · Empresa de reformas · Vera' },
  { text: 'Diseñaron el packaging de nuestra línea de cosmética natural. Pasamos de 12 a 47 puntos de venta en herbolarios y tiendas gourmet en seis meses.',                       author: 'Lucía A.',  role: 'Founder · Cosmética artesanal · Mojácar' },
  { text: 'Identidad nueva, brochure comercial, carteles, packaging. Todo coherente, todo profesional. Por fin parecemos una marca, no un proyecto de fin de carrera.',          author: 'Diego R.',  role: 'CEO · Pyme industrial · Almería' },
];

const faqs = [
  { q: '¿Cuánto tiempo tarda el diseño de un logotipo?', a: 'El proceso completo dura entre 1 y 3 semanas según complejidad y número de revisiones. Incluye investigación, conceptualización, presentación de 2–3 propuestas y refinamiento hasta el resultado final.' },
  { q: '¿Qué incluye un manual de identidad visual?', a: 'Versión principal y variantes del logotipo, paleta de colores con códigos CMYK/RGB/HEX, tipografías primarias y secundarias, aplicaciones correctas e incorrectas, papelería básica y guías de uso digital/print.' },
  { q: '¿Trabajáis con empresas de fuera de Almería?', a: 'Sí. Trabajamos con clientes de toda España en remoto. Videollamadas para presentaciones, plataformas colaborativas y entregas digitales. La distancia no es problema.' },
  { q: '¿Diseñáis también para impresión?', a: 'Sí. Coordinamos con imprentas locales y nacionales para que el resultado final sea perfecto: prueba de color, acabados especiales (stamping, relieves, plastificados), papeles y tirajes.' },
  { q: '¿Puedo modificar los archivos después?', a: 'Sí. Entregamos todos los archivos editables (Illustrator, Photoshop, InDesign, Figma) además de los vectoriales (SVG, PDF) y rasterizados (PNG, JPG) listos para usar en cualquier soporte.' },
  { q: '¿Hacéis rebranding sin perder la esencia?', a: 'Sí, es una de nuestras especialidades. Analizamos qué funciona de tu marca actual y qué necesita evolucionar. Ideal para empresas que necesitan modernizar sin perder reconocimiento.' },
];

const jsonLd = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Diseño Gráfico","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Diseño Gráfico e Identidad Corporativa en Almería","description":"Agencia de diseño gráfico en Almería: identidad corporativa, logotipos, branding y señalética.","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","address":{"@type":"PostalAddress","streetAddress":"Ctra de Ronda, 82","addressLocality":"Vera","addressRegion":"Almería","postalCode":"04620","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":37.245,"longitude":-1.8614},"areaServed":{"@type":"AdministrativeArea","name":"Almería"},"priceRange":"€€","serviceType":"Graphic Design","hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios de Diseño Gráfico","itemListElement":services.map(s=>({"@type":"Offer","itemOffered":{"@type":"Service","name":s.title,"description":s.desc}}))} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo trabajamos un proyecto de diseño","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/diseno-grafico.jpg"
  imageAlt="Diseño gráfico e identidad corporativa - Platanito Rico Almería"
  type="service"
  keywords="diseño gráfico almería, identidad corporativa, logotipos almería, branding almería, diseño de marca, agencia creativa almería"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Diseño Gráfico' }]} />

  <main id="main-content" class="dg">
    {/* ═══════════════ HERO RISOGRAPH ═══════════════ */}
    <section class="dg-hero">
      {/* SVG patterns capa fondo */}
      <svg class="dg-hero__halftone dg-hero__halftone--m" aria-hidden="true" preserveAspectRatio="none">
        <defs>
          <pattern id="dg-dots-m" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="11" cy="11" r="3.6" fill="#FF2D9A"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#dg-dots-m)"/>
      </svg>
      <svg class="dg-hero__halftone dg-hero__halftone--c" aria-hidden="true" preserveAspectRatio="none">
        <defs>
          <pattern id="dg-dots-c" x="2" y="2" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="11" cy="11" r="3.6" fill="#00E5FF"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#dg-dots-c)"/>
      </svg>

      {/* Formas geométricas flotantes */}
      <div class="dg-shape dg-shape--circle" aria-hidden="true"></div>
      <div class="dg-shape dg-shape--square" aria-hidden="true"></div>
      <div class="dg-shape dg-shape--triangle" aria-hidden="true">
        <svg viewBox="0 0 100 100"><polygon points="50,5 95,90 5,90" fill="#FFEB00" stroke="#0E0D0B" stroke-width="4"/></svg>
      </div>
      <div class="dg-shape dg-shape--arc" aria-hidden="true">
        <svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="80" fill="none" stroke="#0040FF" stroke-width="14"/></svg>
      </div>

      <div class="container-brutal dg-hero__inner">
        <header class="dg-hero__head">
          <span class="dg-tag dg-tag--ink">N.º 013 — Diseño Gráfico</span>
          <span class="dg-tag dg-tag--lime"><span class="live-dot" style="background:var(--brutal-ink)"></span> Estudio creativo · 2026</span>
        </header>

        <div class="dg-hero__type">
          <span class="dg-pretitle">★ Identidad · Editorial · Packaging · Print</span>

          <h1 class="dg-title">
            <span class="dg-title__l1">Diseño</span>
            <span class="dg-title__l2">gráfico</span>
            <span class="dg-title__l3">
              <em>con</em>
            </span>
            <span class="dg-title__l4">criterio.</span>
          </h1>

          <p class="dg-hero__lead">
            Identidad corporativa, packaging, editorial, señalética y digital.
            <strong>Diseño estratégico</strong> que conecta y aguanta — no
            "bonito" y caduca en seis meses.
          </p>

          <div class="dg-hero__cta">
            <a href="/contacto/" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
          </div>
        </div>

        {/* Bento de specs en rainbow */}
        <ul class="dg-hero__specs">
          <li class="dg-spec dg-spec--magenta">
            <span class="dg-spec__icon">★</span>
            <span class="dg-spec__num text-mono">2–3 sem</span>
            <span class="dg-spec__lbl">Sistema de marca</span>
          </li>
          <li class="dg-spec dg-spec--cyan">
            <span class="dg-spec__icon">⚡</span>
            <span class="dg-spec__num text-mono">48h</span>
            <span class="dg-spec__lbl">Entrega exprés</span>
          </li>
          <li class="dg-spec dg-spec--yellow">
            <span class="dg-spec__icon">⊕</span>
            <span class="dg-spec__num text-mono">2–3</span>
            <span class="dg-spec__lbl">Propuestas iniciales</span>
          </li>
          <li class="dg-spec dg-spec--lime">
            <span class="dg-spec__icon">∞</span>
            <span class="dg-spec__num text-mono">∞</span>
            <span class="dg-spec__lbl">Revisiones a refinamiento</span>
          </li>
        </ul>
      </div>

      {/* Marquee multicolor */}
      <div class="dg-hero__marquee" aria-hidden="true">
        <div class="dg-hero__marquee-track">
          {Array.from({length: 4}).map(() => (
            <>
              <span style="color:#FF2D9A">DISEÑO</span>
              <span>★</span>
              <span style="color:#00E5FF">BRANDING</span>
              <span>★</span>
              <span style="color:#FFEB00">EDITORIAL</span>
              <span>★</span>
              <span style="color:#D6FF44">PACKAGING</span>
              <span>★</span>
              <span style="color:#FF6B6B">SEÑALÉTICA</span>
              <span>★</span>
              <span style="color:#0040FF">DIGITAL</span>
              <span>★</span>
            </>
          ))}
        </div>
      </div>
    </section>

    {/* ═══════════════ DISCIPLINAS — Bento rainbow ═══════════════ */}
    <section class="dg-section" id="servicios">
      <div class="container-brutal">
        <header class="dg-section-head">
          <span class="dg-eyebrow">Cap. 01 / Disciplinas</span>
          <h2 class="dg-h2">
            Seis disciplinas,
            <em>un solo lenguaje.</em>
          </h2>
          <p class="dg-lead">
            Identidad, señalética, editorial, papelería, digital y packaging.
            Trabajamos como un sistema coherente — no como piezas sueltas que no se hablan.
          </p>
        </header>

        <ol class="dg-bento">
          {services.map((s) => (
            <li class={`dg-card dg-card--${s.color}`}>
              <svg class="dg-card__bg" aria-hidden="true" preserveAspectRatio="none">
                <defs>
                  <pattern id={`p-${s.n}`} x="0" y="0" width="16" height="16" patternUnits="userSpaceOnUse">
                    <circle cx="8" cy="8" r="1.8" fill="currentColor" opacity=".25"/>
                  </pattern>
                </defs>
                <rect width="100%" height="100%" fill={`url(#p-${s.n})`}/>
              </svg>

              <header class="dg-card__head">
                <span class="dg-card__num">{s.n}</span>
                <span class="dg-card__kicker">{s.kicker}</span>
              </header>
              <h3 class="dg-card__title">{s.title}</h3>
              <p class="dg-card__desc">{s.desc}</p>
              <ul class="dg-card__features">
                {s.features.map((f) => (
                  <li><span aria-hidden="true">+</span> {f}</li>
                ))}
              </ul>
              <footer class="dg-card__foot">
                <a href="/contacto/" class="dg-card__cta">Pedir presupuesto →</a>
              </footer>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ═══════════════ PALETTE SHOWCASE ═══════════════ */}
    <section class="dg-section dg-section--dark">
      <div class="container-brutal">
        <header class="dg-section-head dg-section-head--light">
          <span class="dg-eyebrow dg-eyebrow--light">Cap. 02 / Color theory</span>
          <h2 class="dg-h2 dg-h2--light">
            La paleta es la
            <em>primera decisión.</em>
          </h2>
          <p class="dg-lead dg-lead--light">
            Trabajamos color como sistema, no como decoración. Cada paleta es
            un código <strong>CMYK · RGB · HEX</strong> documentado para que
            funcione igual en pantalla, papel y rótulo de gran formato.
          </p>
        </header>

        <ol class="dg-palette">
          {palette.map((c) => (
            <li class="dg-swatch" style={`--c:${c.hex}`}>
              <div class="dg-swatch__chip">
                <svg class="dg-swatch__dot" aria-hidden="true" viewBox="0 0 40 40">
                  <defs>
                    <pattern id={`sw-${c.hex.replace('#','')}`} width="6" height="6" patternUnits="userSpaceOnUse">
                      <circle cx="3" cy="3" r="1.4" fill="rgba(0,0,0,.35)"/>
                    </pattern>
                  </defs>
                  <rect width="40" height="40" fill={`url(#sw-${c.hex.replace('#','')})`}/>
                </svg>
              </div>
              <dl class="dg-swatch__data">
                <dt class="dg-swatch__name">{c.name}</dt>
                <dd class="dg-swatch__hex text-mono">{c.hex}</dd>
                <dd class="dg-swatch__row"><span>CMYK</span><b>{c.cmyk}</b></dd>
                <dd class="dg-swatch__row"><span>RGB</span><b>{c.rgb}</b></dd>
                <dd class="dg-swatch__use">{c.use}</dd>
              </dl>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ═══════════════ TYPOGRAPHY PLAY ═══════════════ */}
    <section class="dg-section dg-section--paper" style="background:#FFEB00;border-block:3px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="dg-section-head">
          <span class="dg-eyebrow">Cap. 03 / Tipografía</span>
          <h2 class="dg-h2">
            La tipografía
            <em>habla antes</em>
            que el texto.
          </h2>
          <p class="dg-lead">
            Cada proyecto tiene su voz. Display rotunda, serif italic para gestos
            editoriales, mono para datos. Sin atajos a Helvetica.
          </p>
        </header>

        <div class="dg-type-grid">
          <div class="dg-type-card dg-type-card--display">
            <span class="dg-type-card__label text-mono">★ Display · Bricolage Grotesque</span>
            <p class="dg-type-card__sample">Aa Bb Mm</p>
            <p class="dg-type-card__use">Titulares · marcas · señalética grande</p>
          </div>
          <div class="dg-type-card dg-type-card--editorial">
            <span class="dg-type-card__label text-mono">★ Editorial · Instrument Serif</span>
            <p class="dg-type-card__sample"><em>Cc Dd Tt</em></p>
            <p class="dg-type-card__use">Citas · piezas editoriales · acentos</p>
          </div>
          <div class="dg-type-card dg-type-card--body">
            <span class="dg-type-card__label text-mono">★ Body · DM Sans</span>
            <p class="dg-type-card__sample">Ee Ff Pp</p>
            <p class="dg-type-card__use">Cuerpo · interfaces · long form</p>
          </div>
          <div class="dg-type-card dg-type-card--mono">
            <span class="dg-type-card__label text-mono">★ Mono · JetBrains Mono</span>
            <p class="dg-type-card__sample">{'<>{}'}</p>
            <p class="dg-type-card__use">Datos · metadata · code-driven</p>
          </div>
        </div>

        <p class="dg-type-foot">
          ★ Para cada cliente seleccionamos pareja(s) tipográfica(s) — primaria + secundaria + mono — con licencias para uso digital y print.
        </p>
      </div>
    </section>

    {/* ═══════════════ TOOLBOX / DIFERENCIALES ═══════════════ */}
    <section class="dg-section">
      <div class="container-brutal">
        <header class="dg-section-head">
          <span class="dg-eyebrow">Cap. 04 / Caja de herramientas</span>
          <h2 class="dg-h2">
            Stack
            <em>real</em>
            de diseño.
          </h2>
          <p class="dg-lead">
            Adobe Suite, Figma, diseñadores senior atendiéndote directamente y
            entregas listas para usar — sin "es que falta la fuente".
          </p>
        </header>

        <ul class="dg-tools">
          {differentiators.map((d, i) => {
            const palette = ['magenta', 'cyan', 'yellow', 'lime', 'cobalt', 'coral'];
            return (
              <li class={`dg-tool dg-tool--${palette[i]}`}>
                <span class="dg-tool__index text-mono">{String(i+1).padStart(2,'0')}</span>
                <h3 class="dg-tool__k">{d.k}</h3>
                <p class="dg-tool__v">{d.v}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    {/* ═══════════════ PROCESO ═══════════════ */}
    <section class="dg-section dg-section--alt">
      <div class="container-brutal">
        <header class="dg-section-head">
          <span class="dg-eyebrow">Cap. 05 / Método</span>
          <h2 class="dg-h2">
            De cero a marca
            <em>en 2 semanas.</em>
          </h2>
          <p class="dg-lead">
            Cuatro fases. Cada una un color, cada una un entregable. Sin
            "vamos viendo", sin propuestas infinitas.
          </p>
        </header>

        <ol class="dg-process">
          {process.map((p) => (
            <li class={`dg-step dg-step--${p.color}`}>
              <span class="dg-step__big">{p.num}</span>
              <div class="dg-step__body">
                <span class="dg-step__eta text-mono">{p.eta}</span>
                <h3 class="dg-step__title">{p.title}</h3>
                <p class="dg-step__desc">{p.body}</p>
                <div class="dg-step__deliv">
