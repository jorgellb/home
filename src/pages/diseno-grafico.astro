---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const serviceCategories = [
  {
    title: "Identidad Corporativa",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
    description: "La base de tu éxito. Creamos marcas con alma y coherencia visual que conectan con tu audiencia.",
    features: [
      { title: "Diseño de Logotipo", description: "Creamos logotipos únicos y memorables que representan la esencia de tu marca. Estudiamos tu mercado, competencia y valores para crear un símbolo que perdure en el tiempo.", icon: "🎨" },
      { title: "Manual de Identidad Visual", description: "Documento completo que establece las normas de uso de tu marca: colores corporativos, tipografías, versiones del logo, aplicaciones correctas e incorrectas, y guías de implementación.", icon: "📘" },
      { title: "Naming Corporativo", description: "Creación de nombre de marca efectivo, memorable y disponible. Analizamos fonética, significado, disponibilidad de dominio y registro de marca.", icon: "✏️" },
      { title: "Rediseño de Marca", description: "Actualización de identidades corporativas existentes para adaptarlas a los tiempos actuales sin perder la esencia. Ideal para empresas en proceso de renovación.", icon: "🔄" }
    ]
  },
  {
    title: "Señalética y Exterior",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 2h10l3 5H4l3-5zM5 7v13a2 2 0 002 2h10a2 2 0 002-2V7H5z"/></svg>`,
    description: "Impacto visual en el mundo real. Diseño especializado para gran formato que capta la atención.",
    features: [
      { title: "Rotulación de Vehículos", description: "Diseño de gráfica para coches, furgonetas, camiones y flotas empresariales. Vinilos decorativos que convierten tu vehículo en publicidad móvil 24/7.", icon: "🚗" },
      { title: "Señalética Permanente", description: "Sistemas de señalización completa para edificios, oficinas, centros comerciales y espacios públicos. Diseñamos desde pictogramas hasta señales de emergencia.", icon: "🏢" },
      { title: "Diseño de Fachadas", description: "Transformación visual de locales comerciales. Letras corpóreas, rótulos luminosos, vinilos de escaparate y elementos decorativos que atraen clientes.", icon: "🏪" },
      { title: "Publicidad Exterior", description: "Diseño de vallas publicitarias, mupis, banderolas y elementos publicitarios de gran formato optimizados para lectura rápida y alto impacto visual.", icon: "🎯" }
    ]
  },
  {
    title: "Editorial y Maquetación",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>`,
    description: "Expertos en diseño editorial digital e impreso. Jerarquía visual, legibilidad y estética profesional.",
    features: [
      { title: "Maquetación de Revistas", description: "Diseño editorial completo: portadas, índices, artículos, publicidad y cierre. Creamos publicaciones periódicas con estilo propio y coherencia visual.", icon: "📰" },
      { title: "Catálogos Comerciales", description: "Diseño de catálogos de productos y servicios con fotografía profesional, fichas técnicas, índices y maquetación optimizada para impresión o digital.", icon: "📖" },
      { title: "Brochures Corporativos", description: "Folletos corporativos de múltiples páginas que presentan tu empresa, servicios, equipo y valores de forma elegante y persuasiva.", icon: "📄" },
      { title: "Folletos y Dípticos", description: "Diseño de material promocional plegable: dípticos, trípticos y cuadrípticos. Perfectos para ferias, recepciones y distribución directa.", icon: "📋" }
    ]
  },
  {
    title: "Papelería Comercial",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>`,
    description: "Todo lo que tu empresa necesita para el día a día. Profesionalidad tangible en cada detalle.",
    features: [
      { title: "Tarjetas de Presentación", description: "Diseño de tarjetas de visita impactantes. Acabados especiales: stamping, relieves, plastificados, cantos dorados. El primer contacto físico con tu marca.", icon: "🎴" },
      { title: "Papelería Corporativa", description: "Hojas membretadas, sobres, carpetas institucionales, etiquetas y todo el material de oficina personalizado con tu imagen corporativa.", icon: "📎" },
      { title: "Flyers y Volantes", description: "Material publicitario de una o dos caras para distribución masiva. Diseño llamativo que transmite el mensaje clave en segundos.", icon: "📃" },
      { title: "Kit de Bienvenida", description: "Pack completo de bienvenida para clientes o empleados: documentación, regalos corporativos, welcome pack con diseño cohesivo.", icon: "🎁" }
    ]
  },
  {
    title: "Marketing Digital",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
    description: "Tu marca en el ecosistema digital. Creatividades que convierten visitantes en clientes.",
    features: [
      { title: "Campañas Publicitarias", description: "Diseño de creatividades para Google Ads, Meta Ads y LinkedIn. Banners estáticos y animados, carruseles, videos cortos adaptados a cada formato y plataforma.", icon: "📢" },
      { title: "Banners Web", description: "Set completo de banners en todos los tamaños estándar: leaderboard, skyscraper, rectangle, mobile. Optimizados para máximo CTR.", icon: "🖼️" },
      { title: "Newsletters", description: "Diseño de emails marketing profesionales. Templates responsive compatibles con todos los clientes de correo. Header, body, footer y CTAs optimizados.", icon: "📧" },
      { title: "Social Media", description: "Diseño de posts, stories, carruseles y reels para Instagram, Facebook y LinkedIn. Coherencia visual con tu marca y adaptado a cada plataforma.", icon: "📱" }
    ]
  }
];

const differentiators = [
  { title: "Adobe Suite Pro", description: "Dominio completo de Photoshop, Illustrator, InDesign, After Effects, Premiere y Figma para cualquier tipo de proyecto.", icon: "🎨" },
  { title: "Diseño Estratégico", description: "No solo creamos lo que es bonito, diseñamos lo que funciona. Cada pieza tiene un objetivo claro de conversión.", icon: "🎯" },
  { title: "Entrega Express", description: "Servicio 24-48h disponible para proyectos urgentes sin sacrificar calidad. Tu tiempo es oro.", icon: "⚡" },
  { title: "Atención Personalizada", description: "Trabajas directamente con diseñadores senior. Sin intermediarios, sin malentendidos, resultados garantizados.", icon: "👤" }
];

const processSteps = [
  { step: "01", title: "Briefing", description: "Nos reunimos contigo para entender tu marca, objetivos, competencia y público objetivo. Rellenamos un briefing completo." },
  { step: "02", title: "Propuesta", description: "Presentamos 2-3 propuestas creativas con mockups. Explicamos el concepto detrás de cada diseño y sus ventajas." },
  { step: "03", title: "Refinamiento", description: "Iteramos sobre la propuesta elegida: ajustes de color, tipografía, composición. Hasta que estés 100% satisfecho." },
  { step: "04", title: "Entrega", description: "Entregamos archivos finales en todos los formatos necesarios: editables, vectoriales, web, impresión. Listos para usar." }
];

const faqs = [
  { q: "¿Cuánto tiempo tarda el diseño de un logotipo?", a: "El proceso completo de diseño de logotipo suele durar entre 1 y 3 semanas, dependiendo de la complejidad del proyecto y el número de revisiones. Incluye investigación, conceptualización, presentación de propuestas y refinamiento hasta llegar al resultado final." },
  { q: "¿Qué incluye un manual de identidad visual?", a: "Un manual completo incluye: versión principal y variantes del logotipo, paleta de colores corporativos con códigos CMYK/RGB/HEX, tipografías primarias y secundarias, aplicaciones correctas e incorrectas, papelería básica, y guías de uso para digital y print." },
  { q: "¿Trabajáis con empresas de fuera de Almería?", a: "Sí. Trabajamos con clientes de toda España de forma 100% online. Usamos metodologías ágiles con entregas digitales, videollamadas para presentaciones y plataformas colaborativas para feedback en tiempo real. La distancia no es un problema." }
];
---

<BaseLayout
  title="Agencia Diseño Gráfico Almería | Identidad de Marca y Branding"
  description="Diseño gráfico en Almería. Identidad corporativa, logotipos, branding y señalética. Impulsa tu imagen de marca. Presupuesto sin compromiso."
  canonical="https://platanitorico.com/diseno-grafico/"
  image="/imagenes/diseno-grafico.jpg"
  imageAlt="Diseño gráfico e identidad corporativa - Platanito Rico Almería"
  type="website"
  keywords="diseño gráfico almería, identidad corporativa, logotipos almería, branding almería, diseño de marca, agencia creativa almería"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Platanito Rico — Diseño Gráfico e Identidad Corporativa en Almería",
      "description": "Agencia de diseño gráfico en Almería especializada en identidad corporativa, logotipos, branding y señalética.",
      "url": "https://platanitorico.com/diseno-grafico/",
      "telephone": "+34657085019",
      "email": "hola@platanitorico.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ctra de Ronda, 82",
        "addressLocality": "Vera",
        "addressRegion": "Almería",
        "postalCode": "04620",
        "addressCountry": "ES"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 37.245, "longitude": -1.8614 },
      "areaServed": { "@type": "AdministrativeArea", "name": "Almería" },
      "priceRange": "€€",
      "serviceType": "Graphic Design"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
        { "@type": "ListItem", "position": 2, "name": "Diseño Gráfico", "item": "https://platanitorico.com/diseno-grafico/" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]}
>
  <Header />

  <main class="pt-0">

    <!-- HERO -->
    <section class="section-brutal relative min-h-screen flex items-center justify-center bg-brutal-bg" id="hero">
      <div class="absolute inset-0 z-0">
        <img
          src="/imagenes/diseno-grafico.jpg"
          alt="Equipo de diseño gráfico Platanito Rico"
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
        />
      </div>
      <div class="absolute inset-0 z-[1] bg-brutal-bg/85"></div>

      <div class="container-brutal relative z-10 py-24">
        <div class="max-w-5xl mx-auto text-center">
          <div class="badge-brutal mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full bg-brutal-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 bg-brutal-accent"></span>
            </span>
            <span class="text-sm font-medium text-brutal-text">Almería Creative Studio</span>
          </div>

          <h1 class="heading-display text-5xl md:text-6xl lg:text-7xl text-brutal-text mb-8 leading-[1.1]">
            Diseño que <span class="text-brutal-accent">conecta</span>
          </h1>

          <p class="text-xl md:text-2xl text-brutal-text-secondary max-w-3xl mx-auto mb-12 leading-relaxed">
            Especialistas en <strong class="text-brutal-text">Identidad Corporativa, Editorial y Señalética</strong>.
            Creamos marcas que cuentan historias y generan resultados.
          </p>

          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="#servicios" class="btn-brutal group inline-flex items-center gap-2 px-8 py-4 bg-brutal-accent text-brutal-text font-semibold">
              <span class="relative">Ver Servicios</span>
              <svg class="relative w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="#proceso" class="btn-brutal-outline inline-flex items-center gap-2 px-8 py-4 bg-brutal-bg text-brutal-text font-semibold border border-brutal-text/30 hover:bg-brutal-text/10 transition-all">
              Cómo Trabajamos
            </a>
          </div>

          <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">500+</div>
              <div class="text-xs text-brutal-text-muted">Proyectos entregados</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">100%</div>
              <div class="text-xs text-brutal-text-muted">Adobe Suite Pro</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">15+</div>
              <div class="text-xs text-brutal-text-muted">Años de experiencia</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">5★</div>
              <div class="text-xs text-brutal-text-muted">Calidad garantizada</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DIFFERENTIATORS -->
    <section class="section-brutal py-24 bg-brutal-bg-alt" id="diferenciales">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full bg-brutal-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 bg-brutal-accent"></span>
            </span>
            Por Qué Elegirnos
          </div>

          <h2 class="heading-display text-4xl md:text-5xl lg:text-6xl text-brutal-text mb-6 leading-tight">
            Expertos en <span class="text-brutal-accent">Comunicación Visual</span>
          </h2>
          <p class="text-xl md:text-2xl text-brutal-text-secondary max-w-3xl mx-auto leading-relaxed">
            Desde logotipos hasta maquetación de catálogos. <span class="font-semibold text-brutal-text">Cubrimos todo el espectro</span> del diseño gráfico con profesionalidad.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
          {differentiators.map((item) => (
            <div class="group relative">
              <div class="card-brutal bg-brutal-card border-brutal-border p-8 h-full">
                <div class="w-14 h-14 bg-brutal-accent flex items-center justify-center mb-6">
                  <span class="text-3xl">{item.icon}</span>
                </div>
                <h3 class="text-xl font-bold text-brutal-text mb-3 group-hover:text-brutal-accent transition-colors">{item.title}</h3>
                <p class="text-brutal-text-secondary leading-relaxed text-sm">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SERVICES CATALOG -->
    <section id="servicios" class="section-brutal py-24 bg-brutal-bg">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Nuestros Servicios
          </div>
          <h2 class="heading-display text-5xl md:text-6xl text-brutal-text mb-6">
            Soluciones de <span class="text-brutal-accent">Diseño Integral</span>
          </h2>
          <p class="text-xl text-brutal-text-secondary max-w-2xl mx-auto">
            Cada proyecto es único. Estas son las áreas en las que podemos ayudarte a destacar.
          </p>
        </div>

        <div class="space-y-24">
          {serviceCategories.map((cat) => (
            <div>
              <div class="flex items-center gap-6 mb-10">
                <div class="w-14 h-14 bg-brutal-accent flex items-center justify-center flex-shrink-0">
                  <div class="w-8 h-8 text-brutal-text" set:html={cat.icon} />
                </div>
                <div>
                  <h3 class="heading-display text-2xl md:text-3xl text-brutal-text mb-2">{cat.title}</h3>
                  <p class="text-brutal-text-secondary text-lg">{cat.description}</p>
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6">
                {cat.features.map((feature) => (
                  <div class="card-brutal bg-brutal-card border-brutal-border p-8">
                    <div class="flex items-start gap-4">
                      <div class="w-12 h-12 bg-brutal-accent/20 flex items-center justify-center flex-shrink-0 text-2xl">
                        {feature.icon}
                      </div>
                      <div>
                        <h4 class="text-lg font-bold text-brutal-text mb-2">{feature.title}</h4>
                        <p class="text-brutal-text-secondary leading-relaxed text-sm">{feature.description}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="proceso" class="section-brutal py-24 bg-brutal-bg-alt">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            Metodología
          </div>
          <h2 class="heading-display text-5xl md:text-6xl text-brutal-text mb-6">
            Nuestro <span class="text-brutal-accent">Proceso</span>
          </h2>
          <p class="text-xl text-brutal-text-secondary max-w-2xl mx-auto">
            Un flujo de trabajo probado que garantiza resultados excepcionales en cada proyecto.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          {processSteps.map((step, index) => (
            <div class="group relative">
              {index < processSteps.length - 1 && (
                <div class="hidden lg:block absolute top-12 left-full w-full h-px bg-brutal-accent/50"></div>
              )}
              <div class="card-brutal bg-brutal-card border-brutal-border p-8 h-full text-center">
                <div class="text-5xl font-bold text-brutal-accent mb-4" style="font-family:'Anton',sans-serif">
                  {step.step}
                </div>
                <h3 class="text-xl font-bold text-brutal-text mb-3">{step.title}</h3>
                <p class="text-brutal-text-muted text-sm leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SOFTWARE STRIP -->
    <section class="section-brutal py-16 bg-brutal-bg border-t border-brutal-border border-b">
      <div class="container-brutal">
        <div class="flex flex-wrap justify-center items-center gap-8 opacity-60">
          {["ADOBE PS", "ILLUSTRATOR", "INDESIGN", "FIGMA", "AFTER EFFECTS"].map(software => (
            <span class="text-brutal-text-muted font-bold text-xl tracking-wider text-mono">{software}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-brutal py-24 bg-brutal-bg-alt" id="faq">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Preguntas frecuentes
          </div>
          <h2 class="heading-display text-4xl md:text-5xl text-brutal-text mb-6">
            Resolvemos tus <span class="text-brutal-accent">dudas</span>
          </h2>
        </div>

        <div class="max-w-4xl mx-auto space-y-4">
          {faqs.map((item) => (
            <details class="group bg-brutal-card border border-brutal-border transition-colors">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <h3 class="text-lg font-semibold text-brutal-text pr-4 group-hover:text-brutal-accent transition-colors">{item.q}</h3>
                <svg class="w-5 h-5 text-brutal-text-muted flex-shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-brutal-text-secondary leading-relaxed">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="section-brutal py-24 bg-brutal-accent">
      <div class="container-brutal">
        <div class="max-w-3xl mx-auto text-center">
