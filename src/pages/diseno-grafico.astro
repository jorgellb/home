---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Agencia Diseño Gráfico Almería | Identidad de Marca y Branding';
const description = 'Diseño gráfico en Almería. Identidad corporativa, logotipos, branding y señalética. Impulsa tu imagen de marca. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/diseno-grafico/';

const services = [
  { n: '01', title: 'Identidad corporativa', kicker: 'Logo · Manual · Naming · Rediseño', desc: 'La base de tu marca. Creamos identidades con alma y coherencia visual que conectan con tu audiencia y aguantan el paso del tiempo.', features: ['Diseño de logotipo','Manual de identidad visual','Naming corporativo','Rediseño de marca'], figure: 'Sistema', figureLabel: 'Marca como sistema', accent: 'accent' },
  { n: '02', title: 'Señalética y exterior',  kicker: 'Vehículos · Fachadas · Vallas',    desc: 'Impacto visual en el mundo real. Diseño especializado para gran formato que capta la atención desde lejos y funciona de cerca.', features: ['Rotulación de vehículos','Señalética permanente','Diseño de fachadas','Publicidad exterior'], figure: 'Gran formato', figureLabel: 'Sin perder detalle', accent: 'lime' },
  { n: '03', title: 'Editorial y maquetación', kicker: 'Revistas · Catálogos · Brochures', desc: 'Diseño editorial digital e impreso con criterio: jerarquía visual, legibilidad y estética profesional para publicaciones que se leen completas.', features: ['Maquetación de revistas','Catálogos comerciales','Brochures corporativos','Dípticos y trípticos'], figure: 'InDesign', figureLabel: 'Print & digital', accent: 'paper' },
  { n: '04', title: 'Papelería comercial',     kicker: 'Tarjetas · Membrete · Flyers',   desc: 'Todo lo que tu empresa necesita para el día a día. Profesionalidad tangible en cada detalle, desde tarjetas hasta kits de bienvenida.', features: ['Tarjetas de presentación','Papelería corporativa','Flyers y volantes','Kit de bienvenida'], figure: 'Print', figureLabel: 'Materiales tangibles', accent: 'paper' },
  { n: '05', title: 'Diseño digital',           kicker: 'Ads · Banners · Social · Email', desc: 'Tu marca en el ecosistema digital. Creatividades que convierten visitantes en clientes en Google, Meta y email marketing.', features: ['Creatividades para Ads','Banners web (todos los formatos)','Newsletters HTML responsive','Social media (post · stories · reels)'], figure: 'CTR ↑', figureLabel: 'Optimizado a conversión', accent: 'ink' },
  { n: '06', title: 'Packaging',                kicker: 'Etiquetas · Cajas · Envases',    desc: 'Diseño de packaging que vende desde el estante. Etiquetas, cajas y envases que conectan con tu producto y lo elevan.', features: ['Etiquetas de producto','Cajas y embalaje','Envases con troquel','Materiales sostenibles'], figure: 'Estante', figureLabel: 'Vende en lineal', accent: 'ink' },
];

const differentiators = [
  { k: 'Adobe Suite Pro',   v: 'Photoshop · Illustrator · InDesign · After Effects · Premiere · Figma' },
  { k: 'Diseño estratégico', v: 'Cada pieza tiene un objetivo claro de conversión, no solo "bonito"' },
  { k: 'Entrega exprés',    v: '24–48h disponible para proyectos urgentes sin sacrificar calidad' },
  { k: 'Atención directa',  v: 'Trabajas directamente con diseñadores senior · sin intermediarios' },
  { k: 'Archivos abiertos', v: 'Entregamos editables · vectoriales · web · print · todo lo que necesites' },
  { k: 'Print partner',     v: 'Coordinación con imprenta local y nacional · prueba color · acabados' },
];

const process = [
  { num: '01', title: 'Briefing',     eta: '1–2 días', body: 'Reunión inicial para entender tu marca, objetivos, competencia y público objetivo. Rellenamos un briefing completo.', deliverable: 'Briefing + dirección creativa' },
  { num: '02', title: 'Propuestas',   eta: '5–7 días', body: 'Presentamos 2–3 propuestas creativas con mockups. Explicamos el concepto detrás de cada diseño y sus ventajas.', deliverable: '2–3 rutas creativas con mockups' },
  { num: '03', title: 'Refinamiento', eta: '3–5 días', body: 'Iteramos sobre la propuesta elegida: ajustes de color, tipografía, composición. Hasta que estés 100% satisfecho.', deliverable: 'Diseño final aprobado' },
  { num: '04', title: 'Entrega',      eta: '1 día',    body: 'Archivos finales en todos los formatos necesarios: editables, vectoriales, web, impresión. Listos para usar.', deliverable: 'Paquete completo + manual de uso' },
];

const sectors = [
  { title: 'Hostelería y gastronomía', desc: 'Identidad de marca, carta menú, packaging y señalética para restaurantes, cafeterías y obradores.' },
  { title: 'Cosmética y wellness',     desc: 'Branding y packaging para marcas que necesitan transmitir confianza y calidad en el estante.' },
  { title: 'Industria y B2B',          desc: 'Identidades sólidas, brochures comerciales y catálogos para empresas que venden a empresas.' },
  { title: 'Startups y SaaS',          desc: 'Branding ágil para productos digitales. Logo, sistema y guidelines listos en 2 semanas.' },
  { title: 'Inmobiliarias',            desc: 'Marca, dossier comercial, valla y rotulación para agencias que quieren destacar.' },
  { title: 'Cultura y eventos',        desc: 'Carteles, programa, identidad de festival y materiales gráficos para eventos culturales.' },
];

const testimonials = [
  { text: 'Llevábamos años con un logo improvisado. El rediseño y el manual de identidad nos cambió la forma de presentarnos. Por primera vez parecemos los profesionales que somos.', author: 'Sara M.',   role: 'Founder · Clínica estética · Almería' },
  { text: 'La rotulación de la flota fue espectacular. Cinco vehículos como anuncio andante 24/7. Los presupuestos entrantes se duplicaron en tres meses.',                         author: 'Pedro V.',  role: 'Gerente · Empresa de reformas · Vera' },
  { text: 'Diseñaron el packaging de nuestra línea de cosmética natural. Pasamos de 12 a 47 puntos de venta en herbolarios y tiendas gourmet en seis meses.',                       author: 'Lucía A.',  role: 'Founder · Cosmética artesanal · Mojácar' },
  { text: 'Identidad nueva, brochure comercial, carteles, packaging. Todo coherente, todo profesional. Por fin parecemos una marca, no un proyecto de fin de carrera.',          author: 'Diego R.',  role: 'CEO · Pyme industrial · Almería' },
];

const faqs = [
  { q: '¿Cuánto tiempo tarda el diseño de un logotipo?', a: 'El proceso completo dura entre 1 y 3 semanas según complejidad y número de revisiones. Incluye investigación, conceptualización, presentación de 2–3 propuestas y refinamiento hasta el resultado final.' },
  { q: '¿Qué incluye un manual de identidad visual?', a: 'Versión principal y variantes del logotipo, paleta de colores con códigos CMYK/RGB/HEX, tipografías primarias y secundarias, aplicaciones correctas e incorrectas, papelería básica y guías de uso digital/print.' },
  { q: '¿Trabajáis con empresas de fuera de Almería?', a: 'Sí. Trabajamos con clientes de toda España en remoto. Videollamadas para presentaciones, plataformas colaborativas y entregas digitales. La distancia no es problema.' },
  { q: '¿Diseñáis también para impresión?', a: 'Sí. Coordinamos con imprentas locales y nacionales para que el resultado final sea perfecto: prueba de color, acabados especiales (stamping, relieves, plastificados), papeles y tirajes.' },
  { q: '¿Puedo modificar los archivos después?', a: 'Sí. Entregamos todos los archivos editables (Illustrator, Photoshop, InDesign, Figma) además de los vectoriales (SVG, PDF) y rasterizados (PNG, JPG) listos para usar en cualquier soporte.' },
  { q: '¿Hacéis rebranding sin perder la esencia?', a: 'Sí, es una de nuestras especialidades. Analizamos qué funciona de tu marca actual y qué necesita evolucionar. Ideal para empresas que necesitan modernizar sin perder reconocimiento.' },
];

const jsonLd = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Diseño Gráfico","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Diseño Gráfico e Identidad Corporativa en Almería","description":"Agencia de diseño gráfico en Almería: identidad corporativa, logotipos, branding y señalética.","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","address":{"@type":"PostalAddress","streetAddress":"Ctra de Ronda, 82","addressLocality":"Vera","addressRegion":"Almería","postalCode":"04620","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":37.245,"longitude":-1.8614},"areaServed":{"@type":"AdministrativeArea","name":"Almería"},"priceRange":"€€","serviceType":"Graphic Design","hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios de Diseño Gráfico","itemListElement":services.map(s=>({"@type":"Offer","itemOffered":{"@type":"Service","name":s.title,"description":s.desc}}))} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo trabajamos un proyecto de diseño","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/diseno-grafico.jpg"
  imageAlt="Diseño gráfico e identidad corporativa - Platanito Rico Almería"
  type="service"
  keywords="diseño gráfico almería, identidad corporativa, logotipos almería, branding almería, diseño de marca, agencia creativa almería"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Diseño Gráfico' }]} />

  <main id="main-content">
    {/* HERO */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 013 — Servicio · Diseño Gráfico</span>
          <span class="text-meta"><span class="live-dot"></span> Aceptando proyectos · 2026</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Cap. 01 / Identidad y branding</span>
            <h1 class="svc-hero__title">
              Identidad
              <em>con criterio.</em>
              <span class="text-stroke-ink">Marcas</span>
              que aguantan el tiempo.
            </h1>
            <p class="svc-hero__lead">
              Identidad corporativa, packaging, editorial, señalética y digital.
              Diseño estratégico que conecta y aguanta — no <strong>"bonito" y caduca en seis meses</strong>.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">2–3 sem</span>
              <span class="svc-hero__spec-lbl">Sistema de marca</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">48h</span>
              <span class="svc-hero__spec-lbl">Entrega exprés</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">2–3</span>
              <span class="svc-hero__spec-lbl">Propuestas iniciales</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">∞</span>
              <span class="svc-hero__spec-lbl">Revisiones a refinamiento</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ IDENTIDAD ★ PACKAGING ★ EDITORIAL ★ SEÑALÉTICA ★ ROTULACIÓN ★ MOTION ★ ADOBE SUITE ★</span>
          ))}
        </div>
      </div>
    </section>

    {/* SERVICIOS */}
    <section class="section-brutal" id="servicios">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Servicios</span>
            <h2 class="brutal-section-head__title">
              Seis disciplinas,
              <em>un solo lenguaje.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Identidad, señalética, editorial, papelería, digital y packaging.
            Trabajamos como un sistema, no como piezas sueltas que no se hablan.
          </p>
        </header>

        <ol class="svc-bento">
          {services.map((s) => (
            <li class={`svc-card svc-card--${s.accent}`}>
              <header class="svc-card__head">
                <span class="svc-card__num">{s.n}</span>
                <span class="svc-card__kicker">{s.kicker}</span>
              </header>
              <h3 class="svc-card__title">{s.title}</h3>
              <p class="svc-card__desc">{s.desc}</p>
              <ul class="svc-card__features">
                {s.features.map((f) => (
                  <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{f}</span></li>
                ))}
              </ul>
              <footer class="svc-card__foot">
                <div class="svc-card__figure">
                  <span class="svc-card__figure-val">{s.figure}</span>
                  <span class="svc-card__figure-lbl">{s.figureLabel}</span>
                </div>
                <a href="/contacto" class="svc-card__cta">Solicitar →</a>
              </footer>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* DIFERENCIADORES DATA SHEET */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Cómo trabajamos</span>
            <h2 class="brutal-section-head__title">
              Herramientas y
              <em>diferencias.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Adobe Suite + Figma, diseñadores senior atendiéndote directamente
            y entregas que llegan listas para usar — sin "es que falta la fuente".
          </p>
        </header>

        <dl class="spec-list" style="max-width:760px;margin:2rem auto 0;">
          {differentiators.map((d) => (
            <div><dt class="spec-k">{d.k}</dt><dd class="spec-v">{d.v}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Método</span>
            <h2 class="brutal-section-head__title">
              De cero a marca
              <em>en 2 semanas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases con entregables claros. Sin "vamos viendo", sin
            propuestas infinitas — refinamos hasta acertar.
          </p>
        </header>

        <ol class="svc-process">
          {process.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < process.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* SECTORES */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Sectores</span>
            <h2 class="brutal-section-head__title">
              Para quién
              <em>diseñamos.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Hostelería, cosmética, B2B, startups, inmobiliarias, cultura...
            Cada sector tiene códigos visuales — los conocemos y los rompemos
            con sentido.
          </p>
        </header>

        <ul class="svc-sectors">
          {sectors.map((s, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{s.title}</h3>
              <p class="svc-sector__desc">{s.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* TESTIMONIOS */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 06 / Clientes</span>
            <h2 class="brutal-section-head__title">
              Marcas
              <em>de verdad.</em>
            </h2>
          </div>
        </header>

        <figure class="svc-pull">
          <div class="svc-pull__marks" aria-hidden="true">“</div>
          <blockquote class="svc-pull__quote">{testimonials[0].text}</blockquote>
          <figcaption class="svc-pull__cap">
            <span class="svc-pull__avatar">{testimonials[0].author[0]}</span>
            <div>
              <span class="svc-pull__name">{testimonials[0].author}</span>
              <span class="svc-pull__role">{testimonials[0].role}</span>
            </div>
          </figcaption>
        </figure>

        <ul class="svc-quotes">
          {testimonials.slice(1).map((t, i) => (
            <li class={`svc-quote svc-quote--${i}`}>
              <p>"{t.text}"</p>
              <footer>
                <span class="svc-quote__avatar">{t.author[0]}</span>
                <div>
                  <span class="svc-quote__name">{t.author}</span>
                  <span class="svc-quote__role">{t.role}</span>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* FAQ */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 07 / Preguntas frecuentes</span>
            <h2 class="brutal-section-head__title">
              Lo que más
              <em>nos preguntan.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Plazos, archivos, manuales, impresión. Si no está aquí, escríbenos
            y respondemos en menos de 24h.
          </p>
        </header>

        <ol class="svc-faq">
          {faqs.map((f, i) => (
            <li class="svc-faq__item">
              <details class="svc-faq__details" open={i === 0}>
                <summary class="svc-faq__sum">
                  <span class="svc-faq__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-faq__q">{f.q}</span>
                  <span class="svc-faq__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-faq__answer"><p>{f.a}</p></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="svc-final__title">
            Construyamos tu marca
            <em>con criterio.</em>
          </h2>
          <p class="svc-final__text">
            Cuéntanos qué necesitas — un logo, un sistema completo, packaging,
            señalética — y te enviamos una propuesta detallada en menos de 24h.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
