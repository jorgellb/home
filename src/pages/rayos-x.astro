---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Relacionados from '../components/cdm/Relacionados.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import Boton from '../components/cdm/Boton.astro';
import RayosX from '../components/rayosx/RayosX.tsx';

const title = 'Rayos X: Mapa de Calor de tu Web con IA';
const description =
  'Sube una captura de tu web y la IA predice dónde miran los usuarios en los primeros segundos: mapa de calor, primera impresión y qué falla.';
const canonical = 'https://platanitorico.com/rayos-x/';

const mide = [
  { ico: '🔥', t: 'Mapa de calor', d: 'Dónde se concentra la atención en los primeros segundos.' },
  { ico: '👁️', t: 'Recorrido visual', d: 'El orden en que la mirada recorre la página.' },
  { ico: '⭐', t: 'Primera impresión', d: 'Una nota y qué se entiende del negocio en 3 segundos.' },
  { ico: '🛠️', t: 'Qué arreglar', d: 'Problemas de jerarquía y mejoras concretas para convertir más.' },
];

const pasos = [
  { n: '01', t: 'Subes una captura', d: 'La tuya o la de tu competencia. No se publica en ningún sitio.' },
  { n: '02', t: 'La IA la escanea', d: 'Analiza contraste, tamaño, posición, rostros y patrón de lectura.' },
  { n: '03', t: 'Predice la atención', d: 'Genera el mapa de calor y el recorrido probable de la mirada.' },
  { n: '04', t: 'Te dice qué mejorar', d: 'Primera impresión, aciertos, problemas y recomendaciones accionables.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: 'Rayos X de Atención', applicationCategory: 'DesignApplication', operatingSystem: 'Web',
    url: canonical, description, offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://platanitorico.com/' },
      { '@type': 'ListItem', position: 2, name: 'Laboratorio de IA', item: 'https://platanitorico.com/laboratorio-ia/' },
      { '@type': 'ListItem', position: 3, name: 'Rayos X de Atención', item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-desarrollo-web-calidad.jpg"
  imageAlt="Rayos X de Atención - mapa de calor de web con IA"
  type="website"
  lang="es"
  keywords="mapa de calor web, heatmap IA, atención web, neuromarketing Almería, primera impresión web, eye tracking IA, análisis UX inteligencia artificial, mejorar conversión web"
  jsonLd={jsonLd}
>
  <Header />

  <Breadcrumb tono="consola" items={[
    { label: 'Inicio', href: '/' },
    { label: 'Laboratorio de IA', href: '/laboratorio-ia/' },
    { label: 'Rayos X de Atención' },
  ]} />

  <main id="main-content" class="rx">
    {/* HERO */}
    <section class="rx-hero">
      <div class="container-brutal rx-hero__inner">
        <span class="rx-eyebrow">✦ Demo en vivo · Visión IA</span>
        <h1 class="rx-hero__title">Rayos X de <em>Atención</em></h1>
        <p class="rx-hero__lead">
          Mira tu web <strong>con los ojos de una IA</strong>. Sube una captura y predecimos el
          <strong> mapa de calor de la atención</strong>: dónde se va la mirada en los primeros segundos,
          qué se ve, qué pasa desapercibido y cómo mejorar la primera impresión.
        </p>
        <div class="rx-hero__chips">
          <span>🔥 Mapa de calor</span>
          <span>👁️ Recorrido de la mirada</span>
          <span>⭐ Primera impresión</span>
        </div>
      </div>
    </section>

    {/* QUÉ MIDE */}
    <section class="rx-mide">
      <div class="container-brutal">
        <ul class="rx-mide__grid">
          {mide.map((s) => (
            <li class="rx-mide__item">
              <span class="rx-mide__ico" aria-hidden="true">{s.ico}</span>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* DEMO */}
    <section class="rx-demo" id="demo">
      <div class="container-brutal">
        <header class="rx-sec-head">
          <span class="rx-eyebrow rx-eyebrow--dark">✦ Pruébalo ahora</span>
          <h2 class="rx-h2">¿Dónde miran tus visitantes?</h2>
        </header>
        <RayosX client:load />
        <noscript><p class="rx-noscript">Activa JavaScript para usar el Rayos X de Atención.</p></noscript>
      </div>
    </section>

    {/* CÓMO FUNCIONA */}
    <section class="rx-steps">
      <div class="container-brutal">
        <header class="rx-sec-head">
          <span class="rx-eyebrow">✦ Cómo funciona</span>
          <h2 class="rx-h2 rx-h2--light">Neuromarketing, sin esperar semanas.</h2>
        </header>
        <ol class="rx-steps__list">
          {pasos.map((s) => (
            <li class="rx-step">
              <span class="rx-step__n">{s.n}</span>
              <div>
                <h3 class="rx-step__t">{s.t}</h3>
                <p class="rx-step__d">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="rx-note">
          Es una <strong>predicción de la IA</strong> basada en principios de jerarquía visual, contraste y
          saliencia — no es eye-tracking real con personas, pero acierta en lo importante: qué destaca y qué se
          pierde. En un proyecto real lo combinamos con datos de tu web (mapas de calor reales y analítica).
        </p>
      </div>
    </section>

    {/* CTA */}
    <section class="rx-cta">
      <div class="container-brutal rx-cta__inner">
        <span class="rx-eyebrow">✦ ¿Tu web no convierte?</span>
        <h2 class="rx-cta__title">Hacemos que miren lo que importa.</h2>
        <p class="rx-cta__text">
          Rediseñamos tu web para guiar la atención hacia lo que vende: tu mensaje, tus productos y tu botón de
          acción. Más claridad, más conversión.
        </p>
        <div class="rx-cta__btns">
          <Boton href="/contacto/">Quiero mejorar mi web</Boton>
          <Boton href="/laboratorio-ia/" variante="linea">Ver más demos de IA</Boton>
        </div>
      </div>
    </section>
  
    <Relacionados titulo="Sigue por aquí" columnas={3} items={[
      { href: '/marketing/auditoria/', label: 'Auditoría de marketing', sub: 'El análisis completo, con personas' },
      { href: '/desarrollo-web/', label: 'Diseño y desarrollo web', sub: 'Rehacer lo que no capta la atención' },
      { href: '/laboratorio-ia/', label: 'Laboratorio de IA', sub: 'Las otras once demos' },
    ]} />
</main>

  <Footer />
</BaseLayout>

<style>
  .rx { background: var(--color-cdm-suelo); color: var(--color-cdm-texto); }
  .rx-eyebrow { display: inline-block; font-family: var(--font-mono, monospace); font-size: .66rem; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: #ff5c5c; }
  .rx-eyebrow--dark { color: #B3261E; }

  .rx-hero {
    padding: 4rem 0 2.5rem;
    background: radial-gradient(90% 60% at 50% -10%, rgba(255,92,92,0.20) 0%, transparent 60%), linear-gradient(180deg, var(--color-cdm-panel), var(--color-cdm-suelo));
    border-bottom: 1px solid var(--color-cdm-regla); position: relative; overflow: hidden;
  }
  .rx-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(#ff5c5c12 1px, transparent 1px), linear-gradient(90deg, #ff5c5c12 1px, transparent 1px);
    background-size: 30px 30px; mask-image: radial-gradient(70% 60% at 50% 0%, #000 0%, transparent 75%);
  }
  .rx-hero__inner { position: relative; }
  .rx-hero__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.5rem, 8vw, 5rem); font-weight: 800; line-height: .95; letter-spacing: -.04em; margin: 1rem 0; color: var(--color-cdm-texto); }
  .rx-hero__title em { font-style: normal; color: #ff5c5c; }
  .rx-hero__lead { font-size: clamp(1.05rem, 2.4vw, 1.3rem); line-height: 1.5; color: #b9c5cf; max-width: 62ch; margin: 0 0 1.5rem; }
  .rx-hero__lead strong { color: var(--color-cdm-texto); }
  .rx-hero__chips { display: flex; flex-wrap: wrap; gap: .6rem; }
  .rx-hero__chips span { font-family: var(--font-mono, monospace); font-size: .72rem; padding: .45rem .8rem; border: 1px solid var(--color-cdm-regla); border-radius: 0; color: #b9c5cf; background: var(--color-cdm-panel-2); }

  .rx-mide { padding: 2.5rem 0; background: var(--color-cdm-panel); border-bottom: 1px solid var(--color-cdm-regla); }
  .rx-mide__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: .8rem; }
  @media (min-width: 560px) { .rx-mide__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .rx-mide__grid { grid-template-columns: repeat(4, 1fr); } }
  .rx-mide__item { background: var(--color-cdm-panel-2); border: 1.5px solid var(--color-cdm-regla); border-radius: 0; padding: 1.1rem 1rem; }
  .rx-mide__ico { font-size: 1.5rem; }
  .rx-mide__item b { display: block; margin: .5rem 0 .3rem; color: var(--color-cdm-texto); font-size: .98rem; }
  .rx-mide__item span { font-size: .8rem; line-height: 1.4; color: #b9c5cf; }

  /* Placa clara: la isla está diseñada sobre papel y su lógica no se toca. */
  .rx-demo { padding: 3.5rem 0; background: #F5F1EA; color: #0E0D0B; border-block: 1px solid var(--color-cdm-regla-2); }
  .rx-noscript { text-align: center; color: #6a6258; margin-top: 1.5rem; }
  .rx-sec-head { text-align: center; max-width: 60ch; margin: 0 auto 2rem; }
  .rx-h2 { font-family: var(--font-display, sans-serif); font-size: clamp(1.9rem, 5vw, 3rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin: .6rem 0 0; }
  .rx-h2--light { color: var(--color-cdm-texto); }

  .rx-steps { padding: 4rem 0; background: var(--color-cdm-panel); }
  .rx-steps__list { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 768px) { .rx-steps__list { grid-template-columns: 1fr 1fr; } }
  .rx-step { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.4rem 1.3rem; background: var(--color-cdm-panel-2); border: 1.5px solid var(--color-cdm-regla); border-radius: 0; }
  .rx-step__n { font-family: var(--font-mono, monospace); font-weight: 800; color: #ff5c5c; }
  .rx-step__t { margin: 0 0 .4rem; font-family: var(--font-display, sans-serif); font-size: 1.1rem; font-weight: 800; color: var(--color-cdm-texto); }
  .rx-step__d { margin: 0; font-size: .9rem; line-height: 1.5; color: #b9c5cf; }
  .rx-note { margin: 2rem 0 0; padding: 1.3rem 1.4rem; border: 1px dashed var(--color-cdm-regla-2); border-radius: 0; background: var(--color-cdm-panel); font-size: .9rem; line-height: 1.6; color: #b9c5cf; }
  .rx-note strong { color: var(--color-cdm-texto); }

  .rx-cta { padding: 4.5rem 0; background: radial-gradient(80% 100% at 50% 0%, rgba(255,92,92,0.16) 0%, transparent 60%), var(--color-cdm-suelo); border-top: 1px solid var(--color-cdm-regla); }
  .rx-cta__inner { max-width: 720px; }
  .rx-cta__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.2rem, 6vw, 4rem); font-weight: 800; letter-spacing: -.04em; line-height: .95; margin: .6rem 0 1rem; color: var(--color-cdm-texto); }
  .rx-cta__text { font-size: 1.05rem; line-height: 1.55; color: #b9c5cf; margin: 0 0 2rem; }
  .rx-cta__btns { display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
