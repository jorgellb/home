---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: '2-digit' });
}
function formatDateShort(date: Date): string {
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase();
}
function calculateReadingTime(content: string): number {
  return Math.max(1, Math.ceil((content || '').split(/\s+/).length / 200));
}
const readingTime = post.data.readingTime || calculateReadingTime(post.body || '');

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "author": { "@type": "Organization", "name": post.data.author || "Platanito Rico" },
  "publisher": { "@type": "Organization", "name": "Platanito Rico", "logo": { "@type": "ImageObject", "url": "https://platanitorico.com/imagenes/logo.png" } },
  "datePublished": post.data.publishedAt.toISOString(),
  "dateModified": (post.data.updatedAt || post.data.publishedAt).toISOString(),
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://platanitorico.com/blog/${post.data.slug}/` },
  ...(post.data.featuredImage && { "image": { "@type": "ImageObject", "url": post.data.featuredImage } })
};
---

<BaseLayout
  title={post.data.seo?.title || `${post.data.title} | Blog Platanito Rico`}
  description={post.data.seo?.description || post.data.excerpt || post.data.title}
  type="article"
  keywords={post.data.seo?.keywords?.join(', ') || post.data.tags?.join(', ')}
  image={post.data.seo?.image || post.data.featuredImage}
  jsonLd={[
    articleSchema,
    {
      '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': 'https://platanitorico.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Blog', 'item': 'https://platanitorico.com/blog/' },
        { '@type': 'ListItem', 'position': 3, 'name': post.data.title, 'item': `https://platanitorico.com/blog/${post.data.slug}/` }
      ]
    }
  ]}
>
  <Header />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Blog', href: '/blog/' },
    { label: post.data.title }
  ]} />

  <main>
    {/* MASTHEAD del artículo */}
    <article class="article-page">
      <header class="article-masthead">
        <div class="container-brutal">
          <div class="article-masthead__meta">
            <span class="text-meta">★ Diario / N.º {String(post.data.publishedAt.getFullYear()).slice(-2)}-{String(post.data.publishedAt.getMonth() + 1).padStart(2, '0')}</span>
            <span class="text-meta">{formatDateShort(post.data.publishedAt)} · {readingTime} min</span>
          </div>
          <div class="divider-brutal-thick"></div>

          {post.data.categories && post.data.categories.length > 0 && (
            <div class="article-masthead__cats">
              {post.data.categories.map((c) => <span class="badge-brutal badge-brutal--lime">{c}</span>)}
            </div>
          )}

          <h1 class="article-masthead__title heading-display">{post.data.title}</h1>
          {post.data.excerpt && <p class="article-masthead__lede">{post.data.excerpt}</p>}

          <div class="article-masthead__byline">
            <div class="article-masthead__author">
              <span class="article-masthead__avatar">{(post.data.author?.charAt(0) || 'P').toUpperCase()}</span>
              <div>
                <span class="article-masthead__name">{post.data.author || 'Platanito Rico'}</span>
                <span class="article-masthead__role text-mono">Equipo editorial · Estudio</span>
              </div>
            </div>
            <span class="article-masthead__date text-mono">Publicado el {formatDate(post.data.publishedAt)}</span>
          </div>
        </div>
      </header>

      {/* Imagen destacada — full bleed brutal */}
      {post.data.featuredImage && (
        <figure class="article-image">
          <img src={post.data.featuredImage} alt={post.data.featuredImageAlt || post.data.title} />
          {post.data.featuredImageAlt && <figcaption class="text-meta">★ {post.data.featuredImageAlt}</figcaption>}
        </figure>
      )}

      {/* Cuerpo */}
      <div class="container-brutal">
        <div class="article-grid">
          <aside class="article-side">
            <span class="text-meta">★ Esta lectura</span>
            <dl class="spec-list">
              <div><dt class="spec-k">Fecha</dt><dd class="spec-v">{formatDateShort(post.data.publishedAt)}</dd></div>
              <div><dt class="spec-k">Duración</dt><dd class="spec-v">{readingTime} min</dd></div>
              {post.data.categories?.[0] && <div><dt class="spec-k">Tema</dt><dd class="spec-v">{post.data.categories[0]}</dd></div>}
              <div><dt class="spec-k">Autor</dt><dd class="spec-v">{post.data.author || 'Platanito Rico'}</dd></div>
            </dl>
            <a href="/blog/" class="link-brutal article-side__back">← Volver al blog</a>
          </aside>

          <div class="article-body prose">
            <Content />
          </div>
        </div>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="article-tags">
            <span class="text-meta">Etiquetas</span>
            <div class="article-tags__list">
              {post.data.tags.map((t) => <span class="tag-brutal">#{t}</span>)}
            </div>
          </div>
        )}

        <div class="article-share">
          <span class="text-meta">Compartir</span>
          <div class="article-share__btns">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`https://platanitorico.com/blog/${post.data.slug}/`)}`} target="_blank" rel="noopener noreferrer" class="article-share__btn" aria-label="Compartir en X">
              <span class="text-mono">X</span>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://platanitorico.com/blog/${post.data.slug}/`)}`} target="_blank" rel="noopener noreferrer" class="article-share__btn" aria-label="Compartir en LinkedIn">
              <span class="text-mono">in</span>
            </a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://platanitorico.com/blog/${post.data.slug}/`)}`} target="_blank" rel="noopener noreferrer" class="article-share__btn" aria-label="Compartir en Facebook">
              <span class="text-mono">f</span>
            </a>
            <a href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' — ' + 'https://platanitorico.com/blog/' + post.data.slug)}`} target="_blank" rel="noopener noreferrer" class="article-share__btn" aria-label="Compartir en WhatsApp">
              <span class="text-mono">w</span>
            </a>
          </div>
        </div>
      </div>

      {/* CTA final */}
      <section class="article-cta">
        <div class="container-brutal">
          <div class="article-cta__inner">
            <span class="text-meta">★ Próximo paso</span>
            <h2 class="heading-display article-cta__title">
              ¿Te ha resonado?
              <em class="heading-editorial">Hablemos.</em>
            </h2>
            <p class="article-cta__text">
              Diseñamos y construimos productos digitales que funcionan. Si lo que has
              leído conecta con tu situación, escríbenos sin compromiso.
            </p>
            <div class="article-cta__btns">
              <a href="/contacto/" class="btn-brutal btn-brutal--lg">Empezar proyecto →</a>
              <a href="/blog/" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Más artículos</a>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-page { background: var(--brutal-bg); }

  /* Masthead */
  .article-masthead { padding: 3rem 0 2rem; border-bottom: 2px solid var(--brutal-ink); }
  .article-masthead__meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .article-masthead__cats { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 0; }
  .article-masthead__title {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: .9;
    letter-spacing: -.04em;
    margin: 1.25rem 0 1rem;
    max-width: 22ch;
  }
  .article-masthead__lede {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.25rem, 2.5vw, 1.85rem);
    line-height: 1.35;
    color: var(--brutal-text);
    max-width: 50ch;
    margin: 0 0 2rem;
  }
  .article-masthead__byline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--brutal-border-soft);
  }
  .article-masthead__author { display: inline-flex; align-items: center; gap: .85rem; }
  .article-masthead__avatar {
    width: 44px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brutal-accent); color: var(--brutal-ink);
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2px solid var(--brutal-ink);
  }
  .article-masthead__name { display: block; font-family: var(--font-display); font-weight: 700; font-size: 1rem; }
  .article-masthead__role { display: block; font-size: .65rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); margin-top: .15rem; }
  .article-masthead__date { font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); }

  /* Imagen */
  .article-image { margin: 0; border-bottom: 2px solid var(--brutal-ink); background: var(--brutal-ink); position: relative; }
  .article-image img { width: 100%; height: auto; aspect-ratio: 21 / 9; object-fit: cover; display: block; }
  .article-image figcaption {
    position: absolute; bottom: 1rem; left: 1rem;
    background: var(--brutal-ink); color: var(--brutal-lime);
    padding: .35rem .75rem; font-size: .65rem;
  }

  /* Body con sidebar */
  .article-grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    padding-top: 4rem;
  }
  @media (min-width: 1024px) {
    .article-grid { grid-template-columns: 240px 1fr; gap: 4rem; }
  }
  .article-side {
    display: flex; flex-direction: column; gap: 1.25rem;
  }
  @media (min-width: 1024px) {
    .article-side { position: sticky; top: 100px; align-self: start; }
  }
  .article-side__back { font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; letter-spacing: .15em; margin-top: 1rem; }

  .article-body { max-width: 68ch; }

  /* Tags + share */
  .article-tags, .article-share {
    margin-top: 3rem; padding-top: 2rem;
    border-top: 1px solid var(--brutal-border-soft);
    display: flex; flex-direction: column; gap: 1rem;
  }
  .article-tags__list { display: flex; flex-wrap: wrap; gap: .35rem; }
  .article-share__btns { display: flex; gap: .5rem; }
  .article-share__btn {
    width: 42px; height: 42px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    box-shadow: 3px 3px 0 0 var(--brutal-ink);
    color: var(--brutal-ink);
    text-decoration: none;
    transition: transform .15s, background .15s, color .15s, box-shadow .15s;
  }
  .article-share__btn:hover { transform: translate(-2px,-2px); box-shadow: 5px 5px 0 0 var(--brutal-accent); background: var(--brutal-ink); color: var(--brutal-lime); }
  .article-share__btn .text-mono { font-weight: 700; font-size: .85rem; }

  /* CTA */
  .article-cta { margin-top: 4rem; padding: 4rem 0; background: var(--brutal-ink); color: var(--brutal-bg); border-top: 2px solid var(--brutal-ink); }
  .article-cta__inner { max-width: 720px; }
  .article-cta__inner .text-meta { color: var(--brutal-accent-ink); }
  .article-cta__title { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: .9; letter-spacing: -.04em; margin: .5rem 0 1rem; color: var(--brutal-bg); }
  .article-cta__title em { color: var(--brutal-lime); font-style: italic; }
  .article-cta__text { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-bg-alt); margin: 0 0 2rem; max-width: 52ch; }
  .article-cta__btns { display: flex; flex-wrap: wrap; gap: 1rem; }
  .article-cta .btn-brutal--ghost { background: transparent; color: var(--brutal-bg); border-color: var(--brutal-bg); --shadow-color: var(--brutal-accent); }
</style>
