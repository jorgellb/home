---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import LecturaLayout from '../../layouts/LecturaLayout.astro';
import Boton from '../../components/cdm/Boton.astro';
import ListaEnlaces from '../../components/cdm/ListaEnlaces.astro';
import { enlacesPorPost } from '../../data/enlaces-post';
import type { SeccionIndice } from '../../components/cdm/tipos';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: '2-digit' });
}
function calculateReadingTime(content: string): number {
  return Math.max(1, Math.ceil((content || '').split(/\s+/).length / 200));
}
const readingTime = post.data.readingTime || calculateReadingTime(post.body || '');

/* El índice lateral lista los H2 del artículo. Si no tiene ninguno, apunta
   al cuerpo entero. */
const secciones: SeccionIndice[] = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, etiqueta: h.text }));
if (secciones.length === 0) secciones.push({ id: 'articulo', etiqueta: 'Artículo' });
const url = `https://platanitorico.com/blog/${post.data.slug}/`;

/* Enlaces a los servicios que resuelven lo que cuenta el artículo. */
const relacionados = enlacesPorPost[post.data.slug] ?? [];

/* La imagen destacada es el LCP del artículo: si existen sus versiones
   ligeras (npm run optimizar:imagenes, 800 px) se sirven en un <picture>. */
const destacada = post.data.featuredImage;
const baseDestacada = destacada?.startsWith('/') ? destacada.replace(/\.(jpe?g|png)$/i, '-800') : null;
const ligeras = baseDestacada
  ? (['avif', 'webp'] as const).filter((f) => existsSync(join(process.cwd(), 'public', `${baseDestacada}.${f}`)))
  : [];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "author": { "@type": "Organization", "name": post.data.author || "Platanito Rico" },
  "publisher": { "@type": "Organization", "name": "Platanito Rico", "logo": { "@type": "ImageObject", "url": "https://platanitorico.com/imagenes/logo.png" } },
  "datePublished": post.data.publishedAt.toISOString(),
  "dateModified": (post.data.updatedAt || post.data.publishedAt).toISOString(),
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://platanitorico.com/blog/${post.data.slug}/` },
  ...(post.data.featuredImage && { "image": { "@type": "ImageObject", "url": post.data.featuredImage } })
};
---

<LecturaLayout
  title={post.data.seo?.title || `${post.data.title} | Blog Platanito Rico`}
  description={post.data.seo?.description || post.data.excerpt || post.data.title}
  type="article"
  keywords={post.data.seo?.keywords?.join(', ') || post.data.tags?.join(', ')}
  image={post.data.seo?.image || post.data.featuredImage}
  imageAlt={post.data.featuredImageAlt}
  jsonLd={[
    articleSchema,
    {
      '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': 'https://platanitorico.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Blog', 'item': 'https://platanitorico.com/blog/' },
        { '@type': 'ListItem', 'position': 3, 'name': post.data.title, 'item': url }
      ]
    }
  ]}
  migas={[{ label: 'Inicio', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.data.title }]}
  ruta={`Blog · ${formatDate(post.data.publishedAt)} · ${readingTime} min de lectura · ${post.data.author || 'Platanito Rico'}`}
  h1={post.data.title}
  entradilla={post.data.excerpt}
  secciones={secciones}
  coordenadas={post.data.categories?.[0]}
>
  {post.data.featuredImage && (
    <figure slot="lateral" class="post-imagen">
      <picture>
        {ligeras.map((f) => <source type={`image/${f}`} srcset={`${baseDestacada}.${f}`} />)}
        <img src={post.data.featuredImage} alt={post.data.featuredImageAlt || post.data.title} loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      {post.data.featuredImageAlt && <figcaption>{post.data.featuredImageAlt}</figcaption>}
    </figure>
  )}

  <article class="post-cuerpo prose" id="articulo">
    <Content />
  </article>

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="post-pie">
      <p class="post-pie__titulo">Etiquetas</p>
      <ul class="post-etiquetas">
        {post.data.tags.map((t) => <li>#{t}</li>)}
      </ul>
    </div>
  )}

  <div class="post-pie">
    <p class="post-pie__titulo">Compartir</p>
    <ul class="post-compartir">
      <li><a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer">X</a></li>
      <li><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer">Facebook</a></li>
      <li><a href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' — ' + url)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
    </ul>
  </div>

  <Fragment slot="cierre">
  <section class="post-cta">
    <div class="post-cta__dentro">
      <h2 class="post-cta__titulo">¿Te ha resonado? Hablemos.</h2>
      <p class="post-cta__texto">
        Diseñamos y construimos productos digitales que funcionan. Si lo que has
        leído conecta con tu situación, escríbenos sin compromiso.
      </p>
      <div class="post-cta__botones">
        <Boton href="/contacto/">Empezar proyecto</Boton>
        <Boton href="/blog/" variante="linea">Más artículos</Boton>
      </div>
    </div>
  </section>

  {/* Enlaces a lo que resuelve el artículo. Van tras el CTA para no adelantar
      al primer H2 de la página, que es el del cierre. */}
  {relacionados.length > 0 && (
    <section class="post-relacionados" aria-labelledby="post-relacionados-tit">
      <div class="post-relacionados__dentro">
        <h2 id="post-relacionados-tit" class="post-relacionados__titulo">Si esto te toca de cerca</h2>
        <ListaEnlaces items={relacionados} columnas={3} />
      </div>
    </section>
  )}
  </Fragment>
</LecturaLayout>

<style>
  .post-relacionados { background: var(--color-cdm-suelo); border-top: 1px solid var(--color-cdm-regla); padding: 3rem 1.25rem; }
  .post-relacionados__dentro { max-width: var(--container-max); margin: 0 auto; }
  .post-relacionados__titulo { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: -0.02em; margin: 0 0 0.9rem; color: var(--color-cdm-texto); }

  .post-imagen { margin: 0; border: 1px solid var(--color-cdm-regla-2); background: var(--color-cdm-panel); }
  .post-imagen img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .post-imagen figcaption { padding: 0.55rem 0.8rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-cdm-tenue); border-top: 1px solid var(--color-cdm-regla); }

  /* El cuerpo del artículo va en una lámina clara dentro de la consola: los
     posts traen HTML propio (tarjetas, tablas, pasos con Tailwind) pensado
     para fondo claro, y pasarlo a oscuro obligaba a reescribir cada post. Es
     el mismo criterio que la postal de las ilustraciones (spec §3.3.6). Aquí
     la paleta brutal vuelve a sus valores de papel. */
  .post-cuerpo {
    --brutal-bg: #f5f1ea;
    --brutal-bg-alt: #efe9df;
    --brutal-card: #fffcf6;
    --brutal-ink: #0e0d0b;
    --brutal-text: #0e0d0b;
    --brutal-text-secondary: #4a453f;
    --brutal-text-muted: #6b655e;
    --brutal-accent-ink: #ae3f13;
    --brutal-border-soft: #d3cbbc;
    scroll-margin-top: 96px;
    max-width: 78ch;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: #f5f1ea;
    color: #0e0d0b;
    color-scheme: light;
    font-size: 1.06rem;
    line-height: 1.7;
    border: 1px solid var(--color-cdm-regla-2);
  }
  .post-cuerpo > :global(:first-child) { margin-top: 0; }
  .post-cuerpo :global(h2),
  .post-cuerpo :global(h3) { scroll-margin-top: 96px; }
  .post-cuerpo :global(pre) { overflow-x: auto; }

  /* Contraste del HTML que traen los posts (fallos anteriores al rediseño).
     Las utilidades de Tailwind en tonos 400-600 como texto, o como fondo de
     una etiqueta con texto blanco, no llegan a 4,5:1: dentro de la lámina se
     llevan a su tono 700 (red, green y amber a 800: sobre red-200 y sobre la
     propia lámina el 700 se quedaba a una décima). */
  /* Las de texto no tocan lo que va dentro de las tarjetas oscuras del post,
     donde esos tonos claros sí leen. */
  .post-cuerpo :global(:is(.text-slate-300, .text-slate-400, .text-slate-500):not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #45556c; }
  .post-cuerpo :global(:is(.text-amber-500, .text-amber-600):not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #973c00; }
  .post-cuerpo :global(:is(.text-orange-500, .text-orange-600):not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #ca3500; }
  .post-cuerpo :global(:is(.text-rose-500, .text-rose-600):not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #c70036; }
  .post-cuerpo :global(:is(.text-emerald-500, .text-emerald-600):not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #007a55; }
  .post-cuerpo :global(:is(.text-green-400, .text-green-600):not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #016630; }
  .post-cuerpo :global(.text-yellow-600:not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #a65f00; }
  .post-cuerpo :global(.text-teal-600:not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #00786f; }
  .post-cuerpo :global(.text-cyan-600:not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #007595; }
  .post-cuerpo :global(.text-violet-500:not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #7008e7; }
  .post-cuerpo :global(.text-sky-500:not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #0069a8; }
  .post-cuerpo :global(:is(.text-red-600, .text-red-700):not(:where([class~="bg-slate-900"], [class~="from-slate-900"], [class~="bg-indigo-900"], [class~="bg-indigo-700"], [class~="bg-violet-700"], [class~="bg-purple-700"], [class~="bg-cyan-700"]) *)) { color: #9f0712; }
  .post-cuerpo :global(:is(.bg-amber-500, .bg-amber-600).text-white) { background-color: #bb4d00; }
  .post-cuerpo :global(:is(.bg-orange-400, .bg-orange-500).text-white) { background-color: #ca3500; }
  .post-cuerpo :global(.bg-green-500.text-white) { background-color: #008236; }
  .post-cuerpo :global(.bg-teal-600.text-white) { background-color: #00786f; }
  .post-cuerpo :global(.bg-sky-400.text-white) { background-color: #0069a8; }
  .post-cuerpo :global(.bg-rose-400.text-white) { background-color: #c70036; }
  .post-cuerpo :global(.bg-violet-400.text-white) { background-color: #7008e7; }
  .post-cuerpo :global(.bg-emerald-400.text-white) { background-color: #007a55; }
  .post-cuerpo :global(.bg-purple-500.text-white) { background-color: #8200db; }
  .post-cuerpo :global(.bg-blue-500.text-white) { background-color: #1447e6; }
  /* dark-600 y dark-900 no existen en el tema: esos elementos no tenían
     color. Se les da el pizarra que pedían. */
  .post-cuerpo :global(.bg-dark-600) { background-color: #1d293d; }
  .post-cuerpo :global(.border-dark-600) { border-color: #1d293d; }
  .post-cuerpo :global(.text-dark-600) { color: #45556c; }
  .post-cuerpo :global(.text-dark-900) { color: #0f172b; }
  /* El plugin de tipografía pinta los th con el color de los títulos aunque
     la cabecera de la tabla pida texto blanco. */
  .post-cuerpo :global(thead.text-white th) { color: inherit; }
  /* Lo mismo con los enlaces: .prose a los pintaba en tinta aunque pidieran blanco. */
  .post-cuerpo :global(a.text-white) { color: #fff; }
  .post-cuerpo :global(.bg-blue-600 .text-blue-200) { color: #fff; }
  /* Tarjeta en degradado rojo→naranja con texto blanco: el naranja del final
     dejaba el blanco en 2,6:1. Se bajan las dos paradas a su tono 700. */
  .post-cuerpo :global([class~="from-red-600"][class~="to-orange-500"]) { --tw-gradient-from: #c10007; --tw-gradient-to: #ca3500; }
  .post-cuerpo :global([class~="from-red-600"] :is(.text-white\/80, .text-white\/90)) { color: #fff; }
  .post-cuerpo :global([class~="from-red-600"] strong) { color: inherit; }
  /* La columna de lectura del layout limita p y li a 68 ch; dentro de la
     lámina manda su propio ancho. */
  .post-cuerpo :global(p),
  .post-cuerpo :global(li) { max-width: none; }

  .post-pie { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-cdm-regla); }
  .post-pie__titulo { margin: 0 0 0.8rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-cdm-tenue); }
  .post-etiquetas,
  .post-compartir { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .post-etiquetas li { padding: 0.25rem 0.6rem; font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-cdm-texto); border: 1px solid var(--color-cdm-regla-2); background: var(--color-cdm-panel-2); }
  .post-compartir a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.45rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-cdm-texto);
    text-decoration: none;
    border: 1px solid var(--color-cdm-regla-2);
    transition: border-color 0.15s, color 0.15s;
  }
  .post-compartir a:hover { border-color: var(--color-cdm-senal); color: var(--color-cdm-senal); }
  .post-compartir a:focus-visible { outline: 2px solid var(--color-cdm-senal); outline-offset: 2px; }

  .post-cta { padding: clamp(3rem, 7vw, 5rem) 0; background: var(--color-cdm-panel); border-top: 1px solid var(--color-cdm-regla); }
  .post-cta__dentro { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-gutter); }
  .post-cta__titulo {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-stretch: 82%;
    font-weight: 740;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-cdm-texto);
  }
  .post-cta__texto { max-width: 52ch; margin: 1rem 0 0; font-size: 1.05rem; line-height: 1.6; color: #b9c5cf; }
  .post-cta__botones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
</style>
