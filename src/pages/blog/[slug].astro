---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import '../../styles/articulo.css';
import Sitio from '../../layouts/Sitio.astro';
import Migas from '../../components/sitio/Migas.astro';
import Icono from '../../components/sitio/Icono.astro';
import LlamadaFinal from '../../components/sitio/LlamadaFinal.astro';
import { enlacesPorPost } from '../../data/enlaces-post';
import { SITE } from '../../data/negocio';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;

const fecha = (date: Date) => date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
const minutos = d.readingTime || Math.max(1, Math.ceil((post.body || '').split(/\s+/).length / 200));
const indice = headings.filter((h) => h.depth === 2);
const url = `${SITE}/blog/${d.slug}/`;
const relacionados = enlacesPorPost[d.slug] ?? [];

/* La imagen destacada es el LCP: si existen sus versiones ligeras se sirven en <picture>. */
const destacada = d.featuredImage;
const baseDestacada = destacada?.startsWith('/') ? destacada.replace(/\.(jpe?g|png)$/i, '-800') : null;
const ligeras = baseDestacada
  ? (['avif', 'webp'] as const).filter((f) => existsSync(join(process.cwd(), 'public', `${baseDestacada}.${f}`)))
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.excerpt,
  author: { '@type': 'Organization', name: d.author || 'Platanito Rico', url: SITE },
  publisher: { '@type': 'Organization', name: 'Platanito Rico', logo: { '@type': 'ImageObject', url: `${SITE}/imagenes/icon.png` } },
  datePublished: d.publishedAt.toISOString(),
  dateModified: (d.updatedAt || d.publishedAt).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'es-ES',
  ...(destacada && { image: destacada.startsWith('http') ? destacada : `${SITE}${destacada}` }),
};

const compartir = [
  { nombre: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
  { nombre: 'WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${d.title} ${url}`)}` },
  { nombre: 'X', href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(d.title)}&url=${encodeURIComponent(url)}` },
  { nombre: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}` },
];
---

<Sitio
  title={d.seo?.title || `${d.title} | Blog Platanito Rico`}
  description={d.seo?.description || d.excerpt || d.title}
  type="article"
  image={d.seo?.image || destacada}
  imageAlt={d.featuredImageAlt}
  canonical={url}
  jsonLd={jsonLd}
>
  <article class="articulo">
    <header class="contenedor articulo__cabeza">
      <Migas items={[{ nombre: 'Blog', href: '/blog/' }, { nombre: d.title }]} />
      <p class="articulo__meta">
        {d.categories?.[0] && <span class="articulo__categoria">{d.categories[0]}</span>}
        <time datetime={d.publishedAt.toISOString()}>{fecha(d.publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutos} min de lectura</span>
      </p>
      <h1>{d.title}</h1>
      {d.excerpt && <p class="entradilla">{d.excerpt}</p>}
    </header>

    {destacada && (
      <figure class="contenedor articulo__imagen">
        <picture>
          {ligeras.map((f) => <source type={`image/${f}`} srcset={`${baseDestacada}.${f}`} />)}
          <img src={destacada} alt={d.featuredImageAlt || d.title} width="800" height="600" loading="eager" fetchpriority="high" decoding="async" />
        </picture>
      </figure>
    )}

    <div class="contenedor articulo__rejilla">
      {indice.length > 2 && (
        <aside class="articulo__indice" aria-label="Índice del artículo">
          <p>En este artículo</p>
          <ol>
            {indice.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </aside>
      )}
      <div class="articulo-cuerpo">
        <Content />

        <footer class="articulo__pie">
          {d.tags && d.tags.length > 0 && (
            <ul class="articulo__etiquetas" aria-label="Etiquetas">
              {d.tags.map((t) => <li>{t}</li>)}
            </ul>
          )}
          <div class="articulo__compartir">
            <span>Compartir</span>
            {compartir.map((c) => <a href={c.href} target="_blank" rel="noopener noreferrer">{c.nombre}</a>)}
          </div>
        </footer>
      </div>
    </div>
  </article>

  {relacionados.length > 0 && (
    <section class="seccion seccion--compacta" aria-labelledby="relacionados-titulo">
      <div class="contenedor">
        <h2 id="relacionados-titulo" class="relacionados__titulo">Si esto te toca de cerca</h2>
        <ul class="relacionados">
          {relacionados.map((r) => (
            <li>
              <a href={r.href}>
                <b>{r.label}</b>
                <small>{r.sub}</small>
                <Icono nombre="flecha" tamano={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <LlamadaFinal titulo="¿Te ha servido? Hablemos de tu caso" />
</Sitio>

<style>
  .articulo__cabeza {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) 2rem;
    max-width: calc(52rem + var(--gutter) * 2);
  }
  .articulo__cabeza h1 {
    font-size: var(--t-3xl);
  }
  .articulo__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: var(--t-s);
    color: var(--tenue);
  }
  .articulo__categoria {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--verde-suave);
    color: var(--verde);
    font-weight: 700;
    font-size: var(--t-xs);
  }
  .articulo__imagen {
    margin-block: 0 3rem;
    max-width: calc(64rem + var(--gutter) * 2);
  }
  .articulo__imagen img {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: var(--radio-l);
    background: var(--fondo-2);
  }
  .articulo__rejilla {
    display: grid;
    gap: 2rem;
    padding-bottom: var(--seccion);
  }
  .articulo-cuerpo {
    min-width: 0;
    max-width: 72ch;
  }
  .articulo__indice {
    font-size: var(--t-s);
  }
  .articulo__indice p {
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .articulo__indice ol {
    list-style: none;
    display: grid;
    gap: 0.45rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--linea);
  }
  .articulo__indice a {
    color: var(--tinta-2);
    text-decoration: none;
  }
  .articulo__indice a:hover {
    color: var(--verde);
  }
  @media (min-width: 1080px) {
    .articulo__rejilla {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 4rem;
    }
    .articulo__indice {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
    .articulo__rejilla > .articulo-cuerpo:only-child {
      grid-column: 2;
    }
  }
  .articulo__pie {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--linea);
  }
  .articulo__etiquetas {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
  }
  .articulo__etiquetas li {
    margin: 0;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--fondo-2);
    font-size: var(--t-xs);
    font-weight: 600;
  }
  .articulo__compartir {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: var(--t-s);
  }
  .articulo__compartir span {
    font-weight: 700;
    color: var(--tinta);
  }
  .articulo__compartir a {
    color: var(--verde);
    font-weight: 600;
  }
  .relacionados__titulo {
    font-size: var(--t-xl);
    margin-bottom: 1.25rem;
  }
  .relacionados {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .relacionados a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--superficie);
    text-decoration: none;
  }
  .relacionados a:hover {
    border-color: var(--verde);
  }
  .relacionados small {
    color: var(--tenue);
    font-size: var(--t-s);
  }
  .relacionados :global(.icono) {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: var(--verde);
  }
  @media (min-width: 860px) {
    .relacionados {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
