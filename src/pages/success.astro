---
import Sitio from '../layouts/Sitio.astro';
import Boton from '../components/sitio/Boton.astro';
import Ilustracion from '../components/sitio/Ilustracion.astro';
import { CONTACTO } from '../data/navegacion';
---

<Sitio title="Mensaje recibido" description="Hemos recibido tu mensaje. Te respondemos en menos de 4 horas laborables." noindex>
  <section class="contenedor gracias">
    <Ilustracion nombre="contacto" class="gracias__ilustracion" />
    <p class="antetitulo">Mensaje recibido</p>
    <h1>Gracias. Lo tenemos.</h1>
    <p class="entradilla">
      Te respondemos en menos de 4 horas laborables. Si es urgente, llámanos al
      <a href={CONTACTO.telefonoHref}>{CONTACTO.telefono}</a> o escríbenos por WhatsApp.
    </p>
    <div class="gracias__acciones">
      <Boton href="/">Volver al inicio</Boton>
      <Boton href="/blog/" variante="secundario">Leer el blog mientras</Boton>
    </div>
  </section>
</Sitio>

<style>
  .gracias {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding-block: var(--seccion);
    text-align: center;
  }
  .gracias :global(.gracias__ilustracion) {
    max-width: 300px;
  }
  .gracias .entradilla a {
    color: var(--verde);
    font-weight: 650;
  }
  .gracias__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
