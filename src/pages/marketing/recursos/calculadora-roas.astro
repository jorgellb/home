---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import Boton from '../../../components/cdm/Boton.astro';
import CalculadoraCaptacion from '../../../components/marketing/CalculadoraCaptacion.tsx';

const title = 'Calculadora de ROAS y Coste por Cliente';
const description = 'Calcula gratis cuántos leads e inversión en publicidad necesitas para conseguir tus clientes: ROAS, CAC y coste por lead según tu ticket y tu margen.';
const canonical = 'https://platanitorico.com/marketing/recursos/calculadora-roas/';

const conceptos = [
  { k: 'CPL',  n: 'Coste por lead',        d: 'Lo que te cuesta cada contacto interesado. Se calcula dividiendo la inversión publicitaria entre el número de oportunidades conseguidas.' },
  { k: 'CAC',  n: 'Coste de adquisición',  d: 'Lo que te cuesta cada cliente que finalmente compra. Es el CPL dividido entre tu tasa de cierre: si cierras 1 de cada 5, tu CAC es cinco veces tu CPL.' },
  { k: 'ROAS', n: 'Retorno de la inversión publicitaria', d: 'Cuántos euros de facturación genera cada euro invertido. Un ROAS de 4x significa que por cada 100 € invertidos entran 400 € de facturación.' },
  { k: 'ROAS de equilibrio', n: 'El mínimo para no perder', d: 'Depende de tu margen bruto: si te queda un 40 % de cada venta, necesitas un ROAS de 2,5x solo para cubrir la inversión. Por debajo, cada venta te cuesta dinero.' },
];

const preguntas = [
  { q: '¿De dónde salen los cálculos?', a: 'De aritmética simple sobre los datos que introduces: leads = clientes ÷ tasa de cierre; visitas = leads ÷ conversión de la web; CAC = inversión ÷ clientes; ROAS = facturación ÷ inversión. No hay ningún modelo predictivo ni datos de terceros detrás.' },
  { q: '¿Los porcentajes que trae por defecto son reales de mi sector?', a: 'No son promedios medidos de mercado, sino valores de partida razonables para que no empieces con la pantalla en blanco. Debes sustituirlos por tus datos reales en cuanto los tengas: la tasa de cierre de tu negocio es tuya y no se parece a una media.' },
  { q: '¿Esto garantiza que voy a conseguir esos clientes?', a: 'No, y desconfía de quien te lo prometa. La calculadora te dice qué tendría que pasar para que los números cuadren, no que vaya a pasar. No contempla estacionalidad, competencia, calidad de tu oferta ni tu capacidad de atender los leads.' },
  { q: '¿Guardáis los datos que introduzco?', a: 'No. Todo el cálculo ocurre en tu navegador y nada de lo que escribes se envía a ningún servidor. Puedes comprobarlo en las herramientas de desarrollo del navegador.' },
  { q: '¿Por qué me pide el margen bruto?', a: 'Porque es lo que marca el límite real. Sin margen no hay CAC máximo posible: dos negocios con la misma facturación pueden permitirse presupuestos de captación completamente distintos según lo que les quede de cada venta.' },
  { q: '¿Qué hago si los números no salen?', a: 'Casi nunca la respuesta es invertir más. Suele ser subir el ticket medio, mejorar la tasa de cierre comercial, aumentar la conversión de la web o cualificar mejor el lead para no pagar por contactos que nunca iban a comprar.' },
];

const jsonLdSchemas = [
  { "@context":"https://schema.org","@type":"WebApplication","name":"Calculadora de ROAS y captación","url":canonical,"applicationCategory":"BusinessApplication","operatingSystem":"Web","description":description,"inLanguage":"es","offers":{"@type":"Offer","price":"0","priceCurrency":"EUR"} },
  { "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Marketing Digital","item":"https://platanitorico.com/marketing/"},{"@type":"ListItem","position":3,"name":"Recursos","item":"https://platanitorico.com/marketing/recursos/"},{"@type":"ListItem","position":4,"name":"Calculadora de ROAS","item":canonical}] },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":preguntas.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-marketing-web.jpg"
  imageAlt="Calculadora de ROAS y captación de clientes"
  type="website"
  keywords="calculadora roas, calcular cac, coste por lead, cuanto invertir en google ads, calculadora captacion clientes, marketing digital almería"
  jsonLd={jsonLdSchemas}
>
  <Header />
  <Breadcrumb tono="consola" items={[
    { label: 'Inicio', href: '/' },
    { label: 'Marketing Digital', href: '/marketing/' },
    { label: 'Recursos', href: '/marketing/recursos/' },
    { label: 'Calculadora de ROAS' },
  ]} />

  <main id="main-content" class="rc">

    <section class="rc-hero">
      <div class="container-brutal">
        <span class="text-meta rc-kicker">Herramienta gratuita · sin registro</span>
        <h1 class="rc-h1 heading-display">
          Antes de invertir un euro,
          <em class="heading-editorial">haz la cuenta.</em>
        </h1>
        <p class="rc-lead">
          La pregunta no es «¿cuánto cuesta Google Ads?», sino «¿cuánto puedo pagar por un
          cliente sin perder dinero?». Esta calculadora te da esa cifra a partir de tu
          ticket medio, tu tasa de cierre y tu margen.
        </p>
      </div>
    </section>

    <section class="rc-tool">
      <div class="container-brutal">
        <CalculadoraCaptacion client:load />
      </div>
    </section>

    <section class="rc-section">
      <div class="container-brutal">
        <h2 class="rc-h2 heading-display">Qué significa cada número</h2>
        <ul class="rc-concepts">
          {conceptos.map((c) => (
            <li class="rc-concept">
              <span class="rc-concept__k text-mono">{c.k}</span>
              <h3 class="rc-concept__n">{c.n}</h3>
              <p class="rc-concept__d">{c.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="rc-section rc-section--alt">
      <div class="container-brutal">
        <h2 class="rc-h2 heading-display">Preguntas sobre la calculadora</h2>
        <div class="rc-faq">
          {preguntas.map((f) => (
            <details class="rc-faq__item">
              <summary class="rc-faq__q"><span>{f.q}</span><span class="rc-faq__i" aria-hidden="true"></span></summary>
              <p class="rc-faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="rc-cta">
      <div class="container-brutal">
        <div class="rc-cta__box">
          <h2 class="rc-cta__t heading-display">¿Los números te cuadran?</h2>
          <p class="rc-cta__l">
            Si te salen, hablamos de cómo conseguirlos. Si no te salen, hablamos de qué
            habría que cambiar antes de gastar en publicidad — que suele ser lo más rentable.
          </p>
          <div class="rc-cta__btns">
            <Boton href="/marketing/auditoria/">Pedir auditoría gratuita</Boton>
            <Boton href="/marketing/recursos/test-marketing/" variante="linea">Test de madurez digital</Boton>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .rc { --rc-bg: var(--color-cdm-suelo); --rc-panel: var(--color-cdm-panel); --rc-line: var(--color-cdm-regla); --rc-text: var(--color-cdm-texto); --rc-muted: #b9c5cf; --rc-cyan: #18e0ff; --rc-lime: var(--color-cdm-ok); background: var(--rc-bg); color: var(--rc-text); }
  .rc-hero { padding: 3.5rem 0 2rem; }
  .rc-kicker { color: var(--rc-cyan); display: block; margin-bottom: .8rem; }
  .rc-h1 { font-size: clamp(2.1rem, 5.5vw, 3.8rem); line-height: 1; margin: 0 0 1.2rem; }
  .rc-h1 em { display: block; color: var(--rc-cyan); }
  .rc-lead { font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.65; color: var(--rc-muted); max-width: 60ch; margin: 0; }
  .rc-tool { padding: 1rem 0 3rem; }
  .rc-section { padding: 3.5rem 0; border-top: 1px solid var(--rc-line); }
  .rc-section--alt { background: var(--rc-panel); }
  .rc-h2 { font-size: clamp(1.5rem, 3.2vw, 2.3rem); line-height: 1.1; margin: 0 0 2rem; }

  .rc-concepts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .rc-concepts { grid-template-columns: repeat(2, 1fr); } }
  .rc-concept { background: var(--rc-panel); border: 1px solid var(--rc-line); border-radius:0; padding: 1.3rem; }
  .rc-concept__k { font-size: .68rem; letter-spacing: .12em; color: var(--rc-lime); font-weight: 800; }
  .rc-concept__n { font-size: 1.05rem; margin: .35rem 0 .5rem; }
  .rc-concept__d { font-size: .88rem; line-height: 1.65; color: var(--rc-muted); margin: 0; }

  .rc-faq { display: grid; gap: .7rem; }
  .rc-faq__item { background: var(--rc-bg); border: 1px solid var(--rc-line); border-radius:0; }
  .rc-faq__q { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1.2rem; cursor: pointer; font-weight: 700; font-size: .92rem; list-style: none; }
  .rc-faq__q::-webkit-details-marker { display: none; }
  .rc-faq__i { flex: none; width: 16px; height: 16px; position: relative; }
  .rc-faq__i::before, .rc-faq__i::after { content: ''; position: absolute; background: var(--rc-cyan); transition: transform .25s; }
  .rc-faq__i::before { top: 7px; left: 0; width: 16px; height: 2px; }
  .rc-faq__i::after { left: 7px; top: 0; width: 2px; height: 16px; }
  .rc-faq__item[open] .rc-faq__i::after { transform: scaleY(0); }
  .rc-faq__a { padding: 0 1.2rem 1.1rem; font-size: .88rem; line-height: 1.7; color: var(--rc-muted); margin: 0; }

  .rc-cta { padding: 3.5rem 0 4.5rem; border-top: 1px solid var(--rc-line); }
  .rc-cta__box { background: var(--rc-panel); border: 1px solid var(--rc-line); border-radius:0; padding: clamp(1.6rem, 4vw, 2.8rem); text-align: center; }
  .rc-cta__t { font-size: clamp(1.6rem, 3.6vw, 2.6rem); margin: 0 0 .9rem; line-height: 1.1; }
  .rc-cta__l { font-size: .98rem; line-height: 1.7; color: var(--rc-muted); max-width: 56ch; margin: 0 auto 1.8rem; }
  .rc-cta__btns { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; }

  @media (prefers-reduced-motion: reduce) { .rc-faq__i::before, .rc-faq__i::after { transition: none; } }
</style>
