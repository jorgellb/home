---
import Sitio from '../../layouts/Sitio.astro';
import Boton from '../../components/sitio/Boton.astro';
import Icono from '../../components/sitio/Icono.astro';
import Ilustracion from '../../components/sitio/Ilustracion.astro';
import Encabezado from '../../components/sitio/Encabezado.astro';
import Migas from '../../components/sitio/Migas.astro';
import Puntos from '../../components/sitio/Puntos.astro';
import Pasos from '../../components/sitio/Pasos.astro';
import Guia from '../../components/sitio/Guia.astro';
import Formulario from '../../components/sitio/Formulario.astro';
import Preguntas from '../../components/sitio/Preguntas.astro';
import type { Punto } from '../../data/servicios/tipos';
import { PROVEEDOR, SITE } from '../../data/negocio';

const areas: Punto[] = [
  { icono: 'pantalla', t: 'Tu web', d: 'Velocidad real en móvil, Core Web Vitals, formularios que funcionan y dónde se pierde el visitante antes de contactar.' },
  { icono: 'rayo', t: 'Tus campañas', d: 'Estructura, términos por los que pagas, negativas que faltan, audiencias demasiado amplias y presupuesto disperso.' },
  { icono: 'buscar', t: 'SEO', d: 'Qué búsquedas te traen tráfico hoy, cuáles deberías captar y si Google puede leer bien tu web.' },
  { icono: 'ubicacion', t: 'Ficha de Google', d: 'Categorías, servicios, fotos, reseñas, duplicados y tu posición en el mapa para búsquedas de tu zona.' },
  { icono: 'grafica', t: 'Medición', d: 'Si Analytics registra formularios, llamadas y WhatsApp, y si sabes qué campaña trae clientes de verdad.' },
  { icono: 'equipo', t: 'Tu competencia', d: 'Dos o tres competidores cercanos: por qué búsquedas salen, qué anuncios tienen y dónde te ganan terreno.' },
];

const fuera = [
  { t: 'Contabilidad, márgenes o precios', d: 'Usamos tu margen para calcular cuánto puedes invertir, pero no revisamos tu política de precios.' },
  { t: 'Línea creativa en redes', d: 'Miramos si las redes traen negocio, no el estilo de tus publicaciones.' },
  { t: 'Revisión legal de la web', d: 'RGPD, cookies y avisos legales necesitan a un profesional del derecho.' },
  { t: 'Un plan de contenidos completo', d: 'Te decimos por dónde empezar; el estudio exhaustivo ya es un proyecto.' },
];

const pasos = [
  { t: 'Nos escribes', d: 'Rellena el formulario. Cuanto más concreto el problema, mejor el diagnóstico.', cuando: 'Ahora' },
  { t: 'Te pedimos accesos', d: 'Solo de lectura, y te explicamos cómo darlos. Sin acceso trabajamos con lo público.', cuando: '24 h' },
  { t: 'Analizamos', d: 'Una persona revisa web, campañas, SEO, ficha de Google y medición.', cuando: '48 h' },
  { t: 'Te lo contamos', d: 'Diagnóstico escrito, ordenado por impacto, y una llamada si la quieres.', cuando: 'Al entregar' },
];

const preguntas = [
  { q: '¿Es realmente gratis?', a: '<p>Sí, y sin compromiso. Es la mejor forma de que veas cómo trabajamos y de saber si podemos ayudarte. Si no encajamos, te lo decimos y ahí termina.</p>' },
  { q: '¿Qué recibo?', a: '<p>Un diagnóstico escrito por una persona, ordenado por impacto: qué falla, qué te puede estar costando y qué haríamos primero. No un PDF genérico de cuarenta páginas con capturas.</p>' },
  { q: '¿Tengo que daros acceso a mis cuentas?', a: '<p>No es obligatorio, pero cambia mucho el resultado. Sin acceso vemos solo lo público. Con acceso de lectura vemos dónde se va el presupuesto. Nunca pedimos permisos de administración ni tocamos nada.</p>' },
  { q: '¿Y si no tengo nada montado?', a: '<p>También sirve, y a menudo es el mejor momento: te decimos qué busca la gente de tu zona, qué hace tu competencia y por dónde empezar.</p>' },
  { q: '¿Qué pasa después?', a: '<p>Nada automático. Te entregamos el diagnóstico y decides tú: aplicarlo por tu cuenta, con tu equipo o con nosotros. Las conclusiones son tuyas.</p>' },
  { q: 'Ya probé Google Ads y no funcionó', a: '<p>Casi siempre es una de tres cosas: campañas sin palabras negativas, tráfico enviado a la portada en lugar de a una página del servicio o conversiones mal medidas. La auditoría te dice cuál fue tu caso.</p>' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Auditoría de marketing digital gratuita',
  serviceType: 'Auditoría de marketing digital',
  url: `${SITE}/marketing/auditoria/`,
  provider: PROVEEDOR,
  areaServed: { '@type': 'AdministrativeArea', name: 'Provincia de Almería' },
  isAccessibleForFree: true,
};
---

<Sitio
  title="Auditoría de marketing digital gratis en 48 h"
  description="Revisamos gratis tu web, tus campañas de Google y Meta, tu SEO, tu ficha de Google y tu medición. Diagnóstico escrito en 48 horas, sin compromiso."
  canonical={`${SITE}/marketing/auditoria/`}
  type="service"
  jsonLd={jsonLd}
>
  <section class="cabeza">
    <div class="contenedor cabeza__rejilla">
      <div class="cabeza__texto">
        <Migas items={[{ nombre: 'Marketing y SEO', href: '/marketing/' }, { nombre: 'Auditoría gratuita' }]} />
        <p class="antetitulo">Gratis · 48 horas · sin compromiso</p>
        <h1>Te decimos dónde se te está <span class="subrayado">escapando el dinero</span></h1>
        <p class="entradilla">
          Revisamos tu web, tus anuncios, tu SEO, tu ficha de Google y tu medición. Recibes un diagnóstico escrito,
          ordenado por impacto, que puedes aplicar con quien quieras.
        </p>
        <div class="cabeza__acciones">
          <Boton href="#solicitar">Pedir mi auditoría</Boton>
          <Boton href="#que-miramos" variante="secundario" icono="flecha-abajo">Qué revisamos</Boton>
        </div>
        <ul class="cabeza__datos">
          <li><Icono nombre="reloj" tamano={18} /> Entrega en 48 h</li>
          <li><Icono nombre="candado" tamano={18} /> Solo acceso de lectura</li>
          <li><Icono nombre="llave" tamano={18} /> Las conclusiones son tuyas</li>
        </ul>
      </div>
      <Ilustracion nombre="marketing" class="cabeza__ilustracion" prioridad />
    </div>
  </section>

  <section class="seccion seccion--blanca" id="que-miramos" aria-labelledby="areas-titulo">
    <div class="contenedor">
      <Encabezado id="areas-titulo" antetitulo="Qué miramos" titulo="Seis áreas, revisadas por una persona" />
      <Puntos items={areas} sobre="blanco" />
    </div>
  </section>

  <Guia antetitulo="Y qué no" titulo="Lo que queda fuera, para que no haya sorpresas" bloques={fuera} id="fuera-titulo" />

  <section class="seccion" aria-labelledby="pasos-titulo">
    <div class="contenedor">
      <Encabezado id="pasos-titulo" antetitulo="Cómo va" titulo="Cuatro pasos, sin reuniones eternas" />
      <Pasos pasos={pasos} />
    </div>
  </section>

  <section class="seccion seccion--blanca" id="solicitar" aria-labelledby="solicitar-titulo">
    <div class="contenedor solicitar">
      <div>
        <p class="antetitulo">Pide tu auditoría</p>
        <h2 id="solicitar-titulo">Cuéntanos tu negocio y qué te preocupa</h2>
        <p class="entradilla">Con la dirección de tu web y a qué te dedicas podemos empezar. En 24 horas te decimos qué accesos nos vendrían bien.</p>
      </div>
      <div class="solicitar__caja">
        <Formulario
          servicio="auditoria"
          boton="Pedir la auditoría"
          extra={[
            { name: 'web', label: 'Tu web', tipo: 'url', placeholder: 'https://' },
            { name: 'sector', label: 'Sector', placeholder: 'Clínica, restaurante, reformas…' },
          ]}
          mensajePlaceholder="Qué te preocupa: pocas llamadas, anuncios caros, no sales en Google… Y si tienes campañas activas, cuáles."
        />
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="preguntas-titulo">
    <div class="contenedor dos-columnas">
      <Encabezado id="preguntas-titulo" antetitulo="Preguntas frecuentes" titulo="Lo que sueles pensar antes de pedirla" />
      <Preguntas preguntas={preguntas} />
    </div>
  </section>
</Sitio>

<style>
  .cabeza {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  .cabeza__rejilla {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .cabeza__texto {
    display: grid;
    gap: 1.25rem;
  }
  .cabeza h1 {
    font-size: var(--t-3xl);
    max-width: 18ch;
  }
  .cabeza__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cabeza__datos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    font-size: var(--t-s);
    color: var(--tinta-2);
  }
  .cabeza__datos li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .cabeza__datos :global(.icono) {
    color: var(--verde);
  }
  .cabeza :global(.cabeza__ilustracion) {
    max-width: 480px;
    justify-self: center;
  }
  @media (min-width: 960px) {
    .cabeza__rejilla {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .solicitar {
    display: grid;
    gap: 2rem;
  }
  .solicitar h2 {
    font-size: var(--t-2xl);
    margin-block: 1rem;
  }
  .solicitar__caja {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: calc(var(--radio-l) * 1.25);
    border: 1px solid var(--linea);
    background: var(--fondo);
  }
  .dos-columnas {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 960px) {
    .solicitar,
    .dos-columnas {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
    }
  }
</style>
