    .ec-kpi:nth-child(2n)      { border-right: 2px solid var(--ec-ink); }
    .ec-kpi:nth-child(4n)      { border-right: none; }
    .ec-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--ec-ink); }
