---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import FichaEcommerce from '../../components/ecommerce/FichaEcommerce.tsx';

const title = 'Tienda Online WooCommerce en Almería';
const description = 'Tienda online WooCommerce desde 700 € sin comisiones por venta: dominio, hosting y pasarelas Stripe, Bizum, Redsys y PayPal configuradas. Lista para vender.';
const canonical = "https://platanitorico.com/soluciones/ecommerce/";

// ─── DATOS ─────────────────────────────────────

// Razones WooCommerce
const reasons = [
  { num: '01', icon: 'crown',    title: 'Eres dueña de tu tienda',  desc: 'Código abierto, hosting tuyo, datos tuyos. Si un día quieres migrar — exportas y te vas. No estás secuestrada por nadie.' },
  { num: '02', icon: 'percent',  title: '0 % comisión por venta',    desc: 'Vendes 100.000 € al año — pagas 0 € a la plataforma. En Shopify pagarías 500-2.000 €/año solo en comisiones.' },
  { num: '03', icon: 'palette',  title: 'Personalización total',     desc: 'Cualquier diseño, cualquier flujo, cualquier integración. Si lo puedes imaginar, se puede hacer.' },
  { num: '04', icon: 'globe',    title: '43 % de la web mundial',    desc: 'Más del 43 % de tiendas online del mundo usan WooCommerce. Comunidad enorme, plugins infinitos, soporte garantizado.' },
  { num: '05', icon: 'rocket',   title: 'SEO de primer nivel',       desc: 'Construido sobre WordPress — el rey del SEO. URLs limpias, schema producto, blog integrado, multilingüe nativo.' },
  { num: '06', icon: 'shield',   title: 'Escalable hasta el infinito', desc: 'Empieza con 10 productos. Crece a 50.000. Misma plataforma. Sin cambiar nada. Sin sustos en la factura.' },
];

// Comparativa WC vs Shopify
const compare = [
  { k: 'Coste mensual base',        wc: '0 € (solo hosting)',    sh: 'desde 39 €/mes',         winner: 'wc' },
  { k: 'Comisión por venta',        wc: '0 %',                   sh: '0,5–2 % por venta',      winner: 'wc' },
  { k: 'Pasarelas de pago externas', wc: 'Stripe, Redsys, Bizum, PayPal, etc',       sh: 'Solo Shopify Payments para evitar comisión extra', winner: 'wc' },
  { k: 'Propiedad de la tienda',    wc: 'Tuya · 100 %',          sh: 'En servidores de Shopify', winner: 'wc' },
  { k: 'Plugins / Apps',            wc: '50.000+ (muchos gratis)', sh: '8.000+ (mayoría de pago)', winner: 'wc' },
  { k: 'SEO técnico',               wc: 'Excelente (WP base)',   sh: 'Bueno (limitado en URLs)', winner: 'wc' },
  { k: 'Personalización diseño',    wc: 'Total · cualquier cosa', sh: 'Limitada al theme + Liquid', winner: 'wc' },
  { k: 'Multilingüe',               wc: 'WPML / Polylang nativos', sh: 'Apps de pago',           winner: 'wc' },
  { k: 'VERIFACTU / cumplimiento ES', wc: 'Plugins nativos',     sh: 'Apps externas (de pago)', winner: 'wc' },
  { k: 'Curva de aprendizaje',      wc: 'Media',                 sh: 'Baja',                    winner: 'sh' },
  { k: 'Migrar a otro proveedor',   wc: 'Fácil (eres dueña)',    sh: 'Casi imposible',         winner: 'wc' },
];

// Pasarelas de pago
const gateways = [
  { id: 'stripe', name: 'Stripe',  fee: '1,4 % + 0,25 €',  meta: 'Visa · Mastercard · Apple Pay · Google Pay', logo: 'stripe', popular: true,  color: 'blue' },
  { id: 'bizum',  name: 'Bizum',   fee: '0,7 % + IVA',     meta: 'Móvil · sin tarjeta · 24 millones usuarios', logo: 'bizum',  popular: true,  color: 'mint' },
  { id: 'redsys', name: 'Redsys',  fee: 'Negociar con banco', meta: 'TPV bancario español · todos los bancos', logo: 'redsys', popular: false, color: 'red' },
  { id: 'paypal', name: 'PayPal',  fee: '2,9 % + 0,35 €',  meta: 'Comprador internacional · protección', logo: 'paypal', popular: false, color: 'yellow' },
  { id: 'cod',    name: 'Contra reembolso', fee: '0 % (con cargo a cliente)', meta: 'Pago al recibir el pedido', logo: 'cash', popular: false, color: 'gold' },
  { id: 'transfer', name: 'Transferencia', fee: '0 %',     meta: 'Para B2B y pedidos grandes',          logo: 'bank',   popular: false, color: 'ink' },
];

// Logística / envíos
const shipping = [
  { id: 'correos',     name: 'Correos',           desc: 'Estándar y exprés. Cobertura ES + UE.',     color: 'yellow' },
  { id: 'seur',        name: 'SEUR',              desc: '24 h en península. Recogida en oficinas.',   color: 'red' },
  { id: 'gls',         name: 'GLS',               desc: 'Reparto B2B y B2C nacional + Europa.',       color: 'blue' },
  { id: 'mrw',         name: 'MRW',               desc: 'Express 8 h - 14 h - mismo día (Madrid).',   color: 'orange' },
  { id: 'pickup',      name: 'Recogida en tienda', desc: 'Sin coste · ideal comercio local.',          color: 'mint' },
  { id: 'free',        name: 'Envío gratis',       desc: 'Configurable por umbral (ej. >50 €).',       color: 'lime' },
];

// Features de conversión
const convFeatures = [
  { num: '01', icon: 'cart',     title: 'Recuperación de carritos abandonados', desc: 'El 70 % de carritos se abandonan. Recuperamos hasta el 30 % con emails automáticos a las 1h, 24h y 72h.' },
  { num: '02', icon: 'upsell',   title: 'Upsells + cross-sells',                 desc: '"Quien compró esto, también compró..." Sube el ticket medio hasta un 35 % con recomendaciones inteligentes.' },
  { num: '03', icon: 'stars',    title: 'Reviews y valoraciones',                desc: 'Pides reseñas tras la entrega · las muestras en el producto · subes la conversión un 18 % de media.' },
  { num: '04', icon: 'coupon',   title: 'Cupones y promos automáticos',         desc: 'Códigos de descuento por importe, primera compra, fidelidad o evento. Sin tocar nada manualmente.' },
  { num: '05', icon: 'bell',     title: 'Notificaciones "última unidad"',       desc: 'Urgencia y escasez bien aplicada: "solo quedan 2", "5 personas están viendo esto", "20 % off por 2h".' },
  { num: '06', icon: 'gift',     title: 'Programa de fidelización',              desc: 'Puntos por compra · referidos · cumpleaños · recompensas. Cliente que vuelve = oro puro.' },
  { num: '07', icon: 'search',   title: 'Búsqueda inteligente',                  desc: 'Predictiva, con auto-corrector, sugerencias visuales y filtros avanzados (color/talla/precio).' },
  { num: '08', icon: 'mobile',   title: 'Checkout en 1 paso',                    desc: 'Sin formularios infinitos. Auto-completado de dirección. Apple Pay y Google Pay en 1 toque.' },
];

// Mock catálogo (productos demo)
const demoProducts = [
  { name: 'Camiseta Bordada',  price: '29,90', old: '39,90', tag: 'OFERTA', color: 'mint',    rating: 4.8 },
  { name: 'Cuaderno Editorial', price: '14,50', old: null,  tag: 'NUEVO',  color: 'yellow',  rating: 5.0 },
  { name: 'Vela Aromática',     price: '22,00', old: null,  tag: 'TOP',    color: 'orange',  rating: 4.6 },
  { name: 'Bolsa Tote',         price: '18,90', old: '24,90', tag: 'OFERTA', color: 'lime',  rating: 4.9 },
];

// Pricing
const plans = [
  {
    code: 'ESENCIAL',
    name: 'Tienda Esencial',
    sub: 'Pequeño catálogo · empieza a facturar',
    price: '700',
    period: '€ · pago único',
    days: '3–4 sem.',
    products: 'Hasta 25 productos',
    features: [
      'WooCommerce + WordPress',
      'Diseño tienda responsive',
      'Hosting + correo 1 año gratis',
      '2 pasarelas (Stripe + Bizum)',
      'Configuración de envíos',
      'SEO técnico + ficha producto',
      '1 mes mantenimiento gratis',
      'Formación 60 min',
    ],
    addons: [],
    cta: 'Empezar a vender',
    popular: false,
    color: 'mint',
  },
  {
    code: 'PRO',
    name: 'Tienda Pro',
    sub: 'Lo más contratado · catálogo medio',
    price: '1.000',
    period: '€ · pago único',
    days: '5–6 sem.',
    products: 'Hasta 200 productos',
    features: [
      'Todo del plan Esencial',
      'Hasta 200 productos cargados',
      '4 pasarelas (Stripe · Bizum · Redsys · PayPal)',
      '3 transportistas integrados',
      'Upsells + cross-sells configurados',
      'Recuperación carritos abandonados',
      'Cupones + ofertas automáticas',
      'Programa de reviews',
      '3 meses mantenimiento gratis',
      'Formación 2h + manual PDF',
    ],
    addons: [],
    cta: 'Crear mi tienda Pro',
    popular: true,
    color: 'woo',
  },
  {
    code: 'PREMIUM',
    name: 'Tienda Premium',
    sub: 'Marca + multilingüe + B2B',
    price: '1.500',
    period: '€ · pago único',
    days: '7–10 sem.',
    products: 'Productos ilimitados',
    features: [
      'Todo del plan Pro',
      'Identidad visual completa',
      'Tienda multilingüe (ES + EN + DE)',
      'Configuración B2B / mayorista',
      'Programa de fidelización (puntos)',
      'Integración con CRM (Holded, Mailchimp...)',
      'VERIFACTU + facturación automática',
      'Sesión de fotos de producto (1 día)',
      '6 meses mantenimiento gratis',
      'Auditoría conversión trimestral',
    ],
    addons: [],
    cta: 'Quiero el Premium',
    popular: false,
    color: 'gold',
  },
];

// Tech stack
const stack = [
  { k: 'WooCommerce',       v: 'Motor del 43 % de tiendas online del mundo',         logo: 'woo' },
  { k: 'WordPress',         v: 'CMS base — SEO + flexibilidad sin techo',             logo: 'wp' },
  { k: 'Stripe',            v: 'Pasarela líder global · Apple/Google Pay',           logo: 'stripe' },
  { k: 'Bizum',             v: 'Pago móvil español · sin tarjeta',                   logo: 'bizum' },
  { k: 'Redsys',            v: 'TPV bancario · todos los bancos ES',                 logo: 'redsys' },
  { k: 'Cloudflare',        v: 'CDN global + protección DDoS',                       logo: 'cf' },
  { k: 'Mailchimp / Brevo', v: 'Email marketing + automation',                        logo: 'mail' },
  { k: 'Google Merchant',   v: 'Aparecer en Google Shopping',                         logo: 'merchant' },
];

// Process
const process = [
  { num: '01', title: 'Briefing + auditoría',      eta: 'Sem 1',  body: 'Análisis de productos, márgenes, público y competencia. Definimos estrategia de precio y conversión.',  color: 'woo' },
  { num: '02', title: 'Diseño + arquitectura',     eta: 'Sem 2',  body: 'Wireframes de tienda, ficha producto, checkout. Identidad visual aplicada.',                          color: 'magenta' },
  { num: '03', title: 'Desarrollo + WooCommerce',  eta: 'Sem 3-4', body: 'Maquetado, configuración WC, productos demo, pasarelas, envíos, impuestos.',                       color: 'blue' },
  { num: '04', title: 'Carga de catálogo',          eta: 'Sem 4-5', body: 'Subimos tu catálogo real (fotos, textos, precios, stock). Te enseñamos a hacerlo solo.',           color: 'mint' },
  { num: '05', title: 'SEO + analytics + tests',    eta: 'Sem 5',  body: 'Schema producto, sitemap, GA4, Search Console, Merchant Center. Tests de compra reales.',           color: 'gold' },
  { num: '06', title: '🚀 Apertura + formación',     eta: 'Sem 6',  body: 'Lanzamiento controlado, formación completa, plan de marketing inicial.',                            color: 'red' },
];

// VERIFACTU items
const verifactu = [
  { t: 'Facturación electrónica obligatoria',  s: 'Desde 1 julio 2025 para autónomos y pymes.' },
  { t: 'Software homologado',                  s: 'Plugin WooCommerce compatible 100 % con AEAT.' },
  { t: 'Envío automático a Hacienda',          s: 'Cada factura se envía en tiempo real. Cero gestión manual.' },
  { t: 'QR + huella en factura',               s: 'Cumple normativa visual obligatoria.' },
  { t: 'Tickets simplificados / completos',    s: 'Genera ambos según ticket o factura.' },
  { t: 'Archivo legal 5 años',                 s: 'Almacenamiento seguro + descarga export.' },
];

// Testimonials
const testimonials = [
  { text: 'Migramos de Shopify a WooCommerce y nos ahorramos 1.800€/año en comisiones. La tienda va el doble de rápida y el control sobre todo es total.',                author: 'Carmen S.', role: 'Pastelería online · Vera',    sales: '+38% facturación · año 1' },
  { text: 'Nuestra primera tienda online vendió 12.000€ el primer mes. El sistema de carritos abandonados solo ya ha recuperado 4.500€ en 6 meses.',                  author: 'David & María', role: 'Tienda artesanía · Mojácar', sales: '+12.000€ primer mes' },
  { text: 'Tener Bizum integrado fue clave: el 40% de nuestros pedidos lo usan. Los clientes locales pagan al instante sin sacar la tarjeta.',                          author: 'Roberto P.', role: 'Cervecería artesanal · Almería', sales: '40% pedidos vía Bizum' },
];

// FAQ
const faq = [
  { q: '¿Por qué WooCommerce y no Shopify o PrestaShop?', a: 'WooCommerce gana en TODO salvo la curva de aprendizaje inicial (que la cubrimos con formación). Es gratis, código abierto (la tienda es 100% tuya), sin comisión por venta, y tiene 50.000+ plugins. Shopify cuesta mínimo 39€/mes para siempre + 0,5-2% de cada venta. PrestaShop es más complicado de mantener y tiene menos comunidad. WooCommerce es el rey por algo.' },
  { q: '¿Cuánto tarda en estar lista mi tienda?', a: 'Esencial: 3-4 semanas. Pro: 5-6 semanas. Premium: 7-10 semanas. El tiempo depende sobre todo de cuán rápido nos envíes el catálogo de productos. Si tienes 200 productos con fotos y textos listos, el plan Pro está en 4 semanas.' },
  { q: '¿Necesito saber WordPress para gestionar la tienda?', a: 'No. La interfaz de WooCommerce es muy parecida a cualquier panel moderno. En 60 min de formación aprendes a: añadir/editar productos, ver pedidos, generar facturas, configurar ofertas, ver estadísticas. Te entregamos un PDF con todo el procedimiento.' },
  { q: '¿Cuánto cuestan las pasarelas de pago?',  a: 'Stripe: 1,4% + 0,25€ por venta UE. Bizum: 0,7% + IVA (lo negocia tu banco). Redsys: depende del banco (típico 0,5-1,5%). PayPal: 2,9% + 0,35€. Estos costes son DE LA PASARELA, no nuestros. La integración la incluimos en el pack.' },
  { q: '¿VERIFACTU está incluido?',                a: 'En Premium sí — plugin instalado y configurado. En Esencial/Pro se añade como extra (200€ setup + 19€/mes el plugin homologado). Todas nuestras tiendas son VERIFACTU-ready.' },
  { q: '¿Y si tengo más de 200 productos?',         a: 'En Pro cargamos hasta 200; sobre eso, te enseñamos a cargarlos tú mismo en bloque vía CSV (es muy fácil). En Premium subimos los que necesites sin límite. También podemos importar desde Shopify, PrestaShop, Amazon o un Excel.' },
  { q: '¿Puedo vender desde móvil / tablet?',        a: 'La tienda funciona perfecta en cualquier dispositivo. Además te damos acceso a la app oficial WooCommerce — gestionas pedidos, ves ventas y respondes desde el móvil en segundos.' },
  { q: '¿Qué pasa después del primer año (hosting)?', a: 'Año 2 en adelante: hosting + correo + dominio = aprox 120€/año si sigues con nosotros (incluye mantenimiento básico). O exportas y te vas — siempre. La tienda es tuya.' },
  { q: '¿Trabajáis con catálogos grandes (1000+ productos)?', a: 'Sí, lo hacemos a diario. Hemos migrado tiendas de hasta 8.000 productos. Para catálogos grandes recomendamos importación CSV + estructura optimizada de categorías + búsqueda Algolia/ElasticPress.' },
  { q: '¿Hay coste mensual obligatorio?',           a: 'Solo el hosting (a partir del año 2). El resto: 0€/mes de comisiones, 0€/mes de plataforma. Comparado con Shopify (mínimo 39€/mes para siempre), el ahorro a 3 años es de 1.400€+ aunque vendas poco.' },
];

const jsonLd = [
  { '@context':'https://schema.org','@type':'ProfessionalService','name':'Platanito Rico — Tienda Online WooCommerce en Almería','description':description,'url':canonical,'telephone':'+34657085019','email':'hola@platanitorico.com','address':{'@type':'PostalAddress','streetAddress':'Ctra de Ronda, 82','addressLocality':'Vera','addressRegion':'Almería','postalCode':'04620','addressCountry':'ES'},'geo':{'@type':'GeoCoordinates','latitude':37.245,'longitude':-1.8614},'priceRange':'€€€','areaServed':{'@type':'AdministrativeArea','name':'Almería'},'serviceType':'eCommerce Development','hasOfferCatalog':{'@type':'OfferCatalog','name':'Packs Tienda Online','itemListElement':plans.map(p=>({'@type':'Offer','name':p.name,'description':p.sub,'price':p.price.replace(/[^0-9]/g,''),'priceCurrency':'EUR'}))} },
  { '@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[
    { '@type':'ListItem','position':1,'name':'Inicio','item':'https://platanitorico.com/' },
    { '@type':'ListItem','position':2,'name':'Soluciones','item':'https://platanitorico.com/soluciones/empresa/' },
    { '@type':'ListItem','position':3,'name':'eCommerce','item':canonical }
  ]},
  { '@context':'https://schema.org','@type':'FAQPage','mainEntity':faq.map(f=>({'@type':'Question','name':f.q,'acceptedAnswer':{'@type':'Answer','text':f.a}})) },
  { '@context':'https://schema.org','@type':'HowTo','name':'Cómo creamos tu tienda online con WooCommerce','step':process.map((p,i)=>({'@type':'HowToStep','position':i+1,'name':p.title,'text':p.body})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Tienda online WooCommerce en Almería - Platanito Rico"
  keywords="tienda online almería, woocommerce almería, ecommerce almería, crear tienda online, vender online almería, woocommerce vs shopify, bizum tienda online"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={[
    { label: 'Inicio',     href: '/' },
    { label: 'Soluciones', href: '/soluciones/empresa/' },
    { label: 'eCommerce' }
  ]} />

  <main id="main-content" class="ec">

    {/* ════════════════════════════════════════════════ */}
    {/* HERO — BOUTIQUE DIGITAL                          */}
    {/* ════════════════════════════════════════════════ */}
    <section class="ec-hero">
      <div class="container-brutal">

        <header class="ec-hero__top">
          <span class="text-meta">N.º 028 — Solución · E-commerce</span>
          <span class="text-meta ec-hero__status">
            <span class="ec-pulse"></span>
            POWERED BY · WOOCOMMERCE · 43% DE TIENDAS DEL MUNDO
          </span>
        </header>

        <div class="divider-brutal"></div>

        <div class="ec-hero__grid">

          {/* Izquierda: copy + KPIs */}
          <div class="ec-hero__intro">
            <span class="text-meta ec-hero__chapter">Cap. 01 / Tu tienda online</span>
            <h1 class="ec-hero__title heading-display">
              Una tienda online
              <em class="heading-editorial">que vende.</em>
              <span class="ec-hero__title-stamp">En serio.</span>
            </h1>

            <p class="ec-hero__lead">
              Con <strong>WooCommerce</strong> — la plataforma con la que
              <strong>vendes más, pagas menos y eres dueña de todo</strong>.
              Pasarelas configuradas, conversión optimizada, VERIFACTU compatible.
              Lista para facturar desde el día 1.
            </p>

            <div class="ec-hero__cta">
              <a href="#planes" class="ec-btn ec-btn--primary">
                <span>Ver planes de tienda</span>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="#porque-woo" class="ec-btn ec-btn--ghost">
                ¿Por qué WooCommerce? ↓
              </a>
            </div>

            <div class="ec-hero__kpis">
              <div class="ec-kpi ec-kpi--woo">
                <span class="ec-kpi__v text-mono">0<small>%</small></span>
                <span class="ec-kpi__l">Comisión por venta</span>
              </div>
              <div class="ec-kpi ec-kpi--lime">
                <span class="ec-kpi__v text-mono">24<small>/7</small></span>
                <span class="ec-kpi__l">Tienda abierta</span>
              </div>
              <div class="ec-kpi ec-kpi--magenta">
                <span class="ec-kpi__v text-mono">∞</span>
                <span class="ec-kpi__l">Productos</span>
              </div>
              <div class="ec-kpi ec-kpi--ink">
                <span class="ec-kpi__v text-mono">4</span>
                <span class="ec-kpi__l">Pasarelas</span>
              </div>
            </div>
          </div>

          {/* Derecha: ESCAPARATE — boutique mockup */}
          <aside class="ec-hero__shop" aria-hidden="true">
            <div class="ec-shop-window">
              {/* Browser bar */}
              <div class="ec-shop-window__bar">
                <span class="ec-shop-window__dot ec-shop-window__dot--r"></span>
                <span class="ec-shop-window__dot ec-shop-window__dot--y"></span>
                <span class="ec-shop-window__dot ec-shop-window__dot--g"></span>
                <span class="ec-shop-window__url text-mono">https://tutienda.com</span>
                <span class="ec-shop-window__ssl">🔒</span>
              </div>

              {/* Mock catálogo */}
              <div class="ec-shop-window__body">
                {/* Top bar de tienda */}
                <div class="ec-shop-top">
                  <span class="ec-shop-top__logo">P★</span>
                  <span class="ec-shop-top__title">TIENDA</span>
                  <div class="ec-shop-top__icons">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2" fill="none"/><path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2"/></svg>
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                    <span class="ec-shop-top__cart">
                      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="9" cy="21" r="1" fill="currentColor"/><circle cx="20" cy="21" r="1" fill="currentColor"/><path d="M1 1h4l2.7 13.4a2 2 0 002 1.6h9.8a2 2 0 002-1.6L23 6H6" stroke="currentColor" stroke-width="2" fill="none"/></svg>
                      <span class="ec-shop-top__cart-num">3</span>
                    </span>
                  </div>
                </div>

                {/* Grid de productos */}
                <div class="ec-shop-grid">
                  {demoProducts.map((p, i) => (
                    <div class={`ec-prod ec-prod--${p.color}`} style={`--ec-prod-i:${i}`}>
                      <div class="ec-prod__media">
                        {/* Imagen producto SVG decorativa */}
                        <svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true">
                          {i === 0 && (<>
                            <rect width="100" height="100" fill="currentColor" opacity="0.3"/>
                            <path d="M 20 30 L 50 20 L 80 30 L 80 80 L 20 80 Z" fill="currentColor"/>
                            <path d="M 35 40 Q 50 50 65 40" stroke="#0E0D0B" stroke-width="2" fill="none"/>
