  .ec-btn--primary {
    background: var(--ec-woo);
    color: var(--ec-paper);
    box-shadow: 6px 6px 0 var(--ec-ink);
  }
  .ec-btn--primary:hover {
    background: var(--ec-magenta);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ec-ink);
  }
  .ec-btn--ghost {
    background: transparent;
    color: var(--ec-ink);
    box-shadow: 6px 6px 0 var(--ec-woo);
  }
  .ec-btn--ghost:hover {
    background: var(--ec-ink);
    color: var(--ec-lime);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ec-woo);
  }

  /* KPIs */
  .ec-hero__kpis {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--ec-ink);
    background: var(--ec-ink);
