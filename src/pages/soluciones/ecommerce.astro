    color: var(--ec-lime);
    text-align: center;
    padding: .55rem;
    font-size: .65rem;
    letter-spacing: .2em;
  }

  /* Woo badge */
  .ec-woo-badge {
    position: absolute;
    top: -25px; right: -15px;
    width: 110px; aspect-ratio: 1;
    transform: rotate(-12deg);
    filter: drop-shadow(0 6px 14px rgba(127,84,179,0.35));
    animation: ec-bob 4.5s ease-in-out infinite;
    z-index: 3;
  }
  @keyframes ec-bob {
    0%, 100% { transform: rotate(-12deg) translateY(0); }
    50%      { transform: rotate(-12deg) translateY(-6px); }
  }

  /* Marquee */
  .ec-marquee {
    background: var(--ec-woo);
    color: var(--ec-paper);
    overflow: hidden;
    padding: .85rem 0;
    border-top: 3px solid var(--ec-ink);
  }
  .ec-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: ec-marquee 32s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  @keyframes ec-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* RAZONES                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .ec-reasons-section {
    background: var(--ec-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ec-ink);
  }
  .ec-reasons {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .ec-reasons { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ec-reasons { grid-template-columns: repeat(3, 1fr); } }
  .ec-reason {
    background: var(--ec-paper);
    border: 2.5px solid var(--ec-ink);
    box-shadow: var(--ec-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .ec-reason:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--ec-woo);
  }
  .ec-reason__head {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding-bottom: .65rem;
    border-bottom: 2px dashed var(--ec-ink);
  }
  .ec-reason__num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ec-woo);
    line-height: 1;
  }
  .ec-reason__icon { width: 48px; height: 48px; color: var(--ec-woo); }
  .ec-reason__title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    color: var(--ec-ink);
    margin: 0;
  }
  .ec-reason__desc {
    font-size: .92rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* COMPARE WC vs Shopify                                   */
  /* ═══════════════════════════════════════════════════════ */
  .ec-compare-section {
    background: var(--ec-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ec-ink);
  }
  .ec-compare {
    border: 3px solid var(--ec-ink);
    box-shadow: var(--ec-shadow);
    background: var(--ec-paper);
    margin-top: 2rem;
    overflow: hidden;
  }
  .ec-compare-head {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 0;
    padding: 1rem 1.5rem;
    background: var(--ec-ink);
    color: var(--ec-paper);
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .2em;
    font-weight: 800;
  }
  .ec-compare-head__wc, .ec-compare-head__sh {
    text-align: center;
    display: inline-flex; align-items: center; justify-content: center; gap: .35rem;
  }
  .ec-compare-head__wc { color: var(--ec-lime); }
  .ec-compare-head__sh { color: var(--ec-paper); opacity: .8; }

  .ec-compare-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 0;
    padding: 1rem 1.5rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
    align-items: center;
  }
  .ec-compare-row:last-of-type { border-bottom: 2px solid var(--ec-ink); }
  .ec-compare-row__k {
    font-size: .9rem;
    color: var(--ec-ink);
    font-weight: 700;
  }
  .ec-compare-row__wc, .ec-compare-row__sh {
    display: flex; align-items: center; gap: .35rem;
    padding: 0 .75rem;
    text-align: center;
    justify-content: center;
    font-size: .82rem;
    line-height: 1.35;
  }
  .ec-compare-row__wc { color: var(--brutal-text-secondary); }
  .ec-compare-row__sh { color: var(--brutal-text-secondary); }
  .ec-compare-row__wc.is-winner { color: var(--ec-woo); font-weight: 700; }
  .ec-compare-row__sh.is-winner { color: var(--ec-blue); font-weight: 700; }
  .ec-compare-row__check {
    width: 18px;
    color: var(--ec-woo);
    font-weight: 800;
    flex-shrink: 0;
  }
  .ec-compare-row__sh.is-winner .ec-compare-row__check { color: var(--ec-blue); }

  .ec-compare-totals {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 0;
    padding: 1.5rem;
    background: var(--ec-cream);
    align-items: center;
  }
  .ec-compare-totals__l { font-size: .75rem; letter-spacing: .25em; font-weight: 800; }
  .ec-compare-totals__wc, .ec-compare-totals__sh { text-align: center; display: flex; flex-direction: column; gap: 4px; }
  .ec-compare-totals__big {
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.02em;
  }
  .ec-compare-totals__wc .ec-compare-totals__big { color: var(--ec-woo); }
  .ec-compare-totals__sh .ec-compare-totals__big { color: var(--ec-blue); }
  .ec-compare-totals__sub { font-size: .65rem; letter-spacing: .15em; opacity: .75; }

  .ec-compare-note {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--ec-lime);
    border: 2px solid var(--ec-ink);
    font-size: .92rem;
    line-height: 1.5;
    color: var(--ec-ink);
  }
  .ec-compare-note strong { color: var(--ec-woo); }
  .ec-compare-note em { font-style: italic; color: var(--ec-blue); }

  /* ═══════════════════════════════════════════════════════ */
  /* PASARELAS DE PAGO                                       */
  /* ═══════════════════════════════════════════════════════ */
  .ec-pay-section {
    background: var(--ec-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ec-ink);
  }
  .ec-pay-grid {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px)  { .ec-pay-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ec-pay-grid { grid-template-columns: repeat(3, 1fr); } }
  .ec-pay {
    position: relative;
    background: var(--ec-paper);
    border: 2.5px solid var(--ec-ink);
    box-shadow: 5px 5px 0 var(--ec-ink);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .2s, box-shadow .2s;
  }
  .ec-pay:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--ec-woo);
  }
  .ec-pay--blue   { background: var(--ec-paper); }
  .ec-pay--mint   { background: var(--ec-mint); }
  .ec-pay--red    { background: var(--ec-paper); }
  .ec-pay--yellow { background: var(--ec-paper); }
  .ec-pay--gold   { background: var(--ec-cream); }
  .ec-pay--ink    { background: var(--ec-paper-2); }

  .ec-pay__pop {
    position: absolute;
    top: -10px; right: 16px;
    background: var(--ec-magenta);
    color: var(--ec-paper);
    padding: .15rem .55rem;
    font-size: .58rem;
    letter-spacing: .2em;
    font-weight: 800;
    border: 1.5px solid var(--ec-ink);
    box-shadow: 2px 2px 0 var(--ec-ink);
  }
  .ec-pay__logo { width: 100%; }
  .ec-pay__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -.015em;
    color: var(--ec-ink);
    margin: 0;
  }
  .ec-pay__meta {
    font-size: .82rem;
    line-height: 1.4;
    color: var(--brutal-text-secondary);
    flex: 1;
  }
  .ec-pay__foot {
    display: flex; flex-direction: column; gap: 2px;
    padding-top: .65rem;
    border-top: 2px dashed var(--ec-ink);
  }
  .ec-pay__fee-lbl {
    font-size: .58rem;
    letter-spacing: .2em;
    color: var(--ec-woo);
    font-weight: 800;
  }
  .ec-pay__fee {
    font-family: var(--font-mono);
    font-size: .9rem;
    font-weight: 800;
    color: var(--ec-ink);
  }
  .ec-pay-note {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--ec-paper-2);
    border: 2px solid var(--ec-ink);
    font-size: .9rem;
    line-height: 1.5;
    color: var(--ec-ink);
  }
  .ec-pay-note strong { color: var(--ec-woo); }
  .ec-pay-note em { color: var(--ec-magenta); font-style: italic; }

  /* ═══════════════════════════════════════════════════════ */
  /* CONVERSIÓN                                              */
  /* ═══════════════════════════════════════════════════════ */
  .ec-conv-section {
    background: var(--ec-ink);
    color: var(--ec-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ec-ink);
    position: relative;
    overflow: hidden;
  }
  .ec-conv-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(127,84,179,0.08) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .ec-conv-section > * { position: relative; }
  .ec-conv {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px)  { .ec-conv { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ec-conv { grid-template-columns: repeat(4, 1fr); } }
  .ec-conv__item {
    background: rgba(255,252,246,0.05);
    border: 2px solid var(--ec-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .ec-conv__item:hover {
    background: var(--ec-woo);
    transform: translateY(-3px);
  }
  .ec-conv__num {
    font-size: .9rem;
    font-weight: 800;
    color: var(--ec-lime);
    letter-spacing: .1em;
  }
  .ec-conv__icon {
    width: 44px; height: 44px;
    color: var(--ec-lime);
  }
  .ec-conv__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -.015em;
    line-height: 1.15;
    color: var(--ec-paper);
    margin: 0;
  }
  .ec-conv__desc {
    font-size: .82rem;
    line-height: 1.45;
    color: rgba(255,252,246,0.75);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* LOGÍSTICA                                               */
  /* ═══════════════════════════════════════════════════════ */
  .ec-ship-section {
    background: var(--ec-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ec-ink);
  }
  .ec-ship-grid {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px)  { .ec-ship-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ec-ship-grid { grid-template-columns: repeat(3, 1fr); } }
  .ec-ship {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 1rem;
    align-items: center;
    background: var(--ec-paper);
    border: 2px solid var(--ec-ink);
    box-shadow: 4px 4px 0 var(--ec-ink);
    padding: 1.1rem;
    transition: transform .2s, box-shadow .2s;
  }
  .ec-ship:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ec-woo); }
  .ec-ship--yellow .ec-ship__icon { color: var(--ec-yellow); }
  .ec-ship--red    .ec-ship__icon { color: var(--ec-red); }
  .ec-ship--blue   .ec-ship__icon { color: var(--ec-blue); }
  .ec-ship--orange .ec-ship__icon { color: var(--ec-orange); }
  .ec-ship--mint   .ec-ship__icon { color: var(--ec-mint); }
  .ec-ship--lime   .ec-ship__icon { color: var(--ec-lime); }
  .ec-ship__icon { width: 60px; height: 60px; }
  .ec-ship__body { display: flex; flex-direction: column; gap: 2px; }
  .ec-ship__k {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ec-ink);
    margin: 0;
  }
  .ec-ship__v {
    font-size: .82rem;
    line-height: 1.4;
    color: var(--brutal-text-secondary);
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* VERIFACTU                                               */
  /* ═══════════════════════════════════════════════════════ */
  .ec-veri-section {
    background: var(--ec-woo);
    color: var(--ec-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ec-ink);
    position: relative;
    overflow: hidden;
  }
  .ec-veri-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(45deg, transparent 0 30px, rgba(255,252,246,0.04) 30px 31px);
    pointer-events: none;
  }
  .ec-veri-section > * { position: relative; }
  .ec-veri-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .ec-veri-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }

  .ec-veri-l__chapter { color: var(--ec-lime); }
  .ec-veri-title {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: .92;
    letter-spacing: -.04em;
    color: var(--ec-paper);
    margin: 1rem 0;
  }
  .ec-veri-title em { color: var(--ec-lime); }
  .ec-veri-lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255,252,246,0.85);
    max-width: 52ch;
    margin-bottom: 1.5rem;
  }
  .ec-veri-lead strong { color: var(--ec-lime); font-weight: 800; }
  .ec-veri-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .85rem;
  }
  .ec-veri-list li {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: .75rem;
    align-items: flex-start;
  }
  .ec-veri-list svg { color: var(--ec-lime); margin-top: 4px; }
  .ec-veri-list li > div { display: flex; flex-direction: column; gap: 2px; }
  .ec-veri-list strong { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--ec-paper); }
  .ec-veri-list span { font-size: .85rem; color: rgba(255,252,246,0.75); line-height: 1.4; }

  .ec-veri-r {
    max-width: 320px;
    margin: 0 auto;
    filter: drop-shadow(0 10px 30px rgba(0,0,0,0.25));
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PRICING                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .ec-pricing-section {
    background: var(--ec-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ec-ink);
  }
  .ec-plans {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) { .ec-plans { grid-template-columns: repeat(3, 1fr); align-items: stretch; gap: 2rem; } }

  .ec-plan {
    position: relative;
    background: var(--ec-paper);
    border: 3px solid var(--ec-ink);
    box-shadow: var(--ec-shadow);
    padding: 2.5rem 1.75rem 2rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .ec-plan:hover { transform: translateY(-4px); }
  .ec-plan--mint .ec-plan__badge { color: var(--ec-mint); }
  .ec-plan--woo  .ec-plan__badge { color: var(--ec-woo); }
  .ec-plan--gold .ec-plan__badge { color: var(--ec-gold); }
  .ec-plan--popular {
    background: var(--ec-ink);
    color: var(--ec-paper);
    border-color: var(--ec-woo);
    box-shadow: 12px 12px 0 var(--ec-woo);
    transform: scale(1.02);
  }
  @media (min-width: 1024px) { .ec-plan--popular { transform: scale(1.05); } }
  .ec-plan--popular:hover { transform: scale(1.02) translateY(-4px); }
  @media (min-width: 1024px) { .ec-plan--popular:hover { transform: scale(1.05) translateY(-4px); } }

  .ec-plan__ribbon {
    position: absolute;
    top: -16px; left: 50%;
    transform: translateX(-50%);
    background: var(--ec-woo);
    color: var(--ec-paper);
    padding: .35rem 1.25rem;
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 2px solid var(--ec-ink);
    box-shadow: 3px 3px 0 var(--ec-ink);
    white-space: nowrap;
  }
  .ec-plan__badge { width: 100px; margin: 0 auto; }
  .ec-plan__head { display: flex; justify-content: space-between; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; opacity: .85; }
  .ec-plan__days { font-size: .68rem; letter-spacing: .15em; opacity: .8; }
  .ec-plan__name {
    font-size: clamp(1.5rem, 2.5vw, 1.85rem);
    line-height: 1;
    letter-spacing: -.03em;
    margin: 0;
  }
  .ec-plan__sub { font-size: .9rem; opacity: .85; line-height: 1.4; }
  .ec-plan__products {
    display: inline-flex; align-items: center; gap: .5rem;
    font-family: var(--font-mono);
    font-size: .75rem;
    letter-spacing: .12em;
    color: var(--ec-magenta);
    font-weight: 700;
    text-transform: uppercase;
  }
  .ec-plan--popular .ec-plan__products { color: var(--ec-lime); }
  .ec-plan__price {
    display: flex; align-items: baseline; gap: .65rem;
    border-block: 2px solid currentColor;
    padding: 1rem 0;
    margin: .5rem 0;
  }
  .ec-plan__price-v { font-size: clamp(2.5rem, 4vw, 3.25rem); font-weight: 800; line-height: 1; letter-spacing: -.03em; }
  .ec-plan__price-p { font-family: var(--font-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .15em; opacity: .7; }
  .ec-plan__feat {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .55rem;
    flex: 1;
  }
  .ec-plan__feat li {
    display: flex; align-items: flex-start; gap: .65rem;
    font-size: .9rem;
    line-height: 1.4;
  }
  .ec-plan__feat svg { color: var(--ec-woo); flex-shrink: 0; margin-top: 3px; }
  .ec-plan--popular .ec-plan__feat svg { color: var(--ec-lime); }
  .ec-plan__cta {
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent;
    color: currentColor;
    border: 2.5px solid currentColor;
    padding: 1rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    margin-top: .5rem;
    transition: background .2s, color .2s, transform .2s;
  }
  .ec-plan__cta:hover { background: currentColor; color: var(--ec-paper); transform: translateY(-2px); }
  .ec-plan__cta--primary { background: var(--ec-woo); color: var(--ec-paper); border-color: var(--ec-woo); }
  .ec-plan__cta--primary:hover { background: var(--ec-lime); color: var(--ec-ink); border-color: var(--ec-lime); }

  /* Garantía */
  .ec-guarantee {
    margin-top: 3rem;
    background: var(--ec-cream);
    border: 3px solid var(--ec-ink);
    box-shadow: var(--ec-shadow);
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 768px) { .ec-guarantee { grid-template-columns: 130px 1fr; gap: 2rem; } }
  .ec-guarantee__seal { width: 130px; aspect-ratio: 1; transform: rotate(-8deg); filter: drop-shadow(0 6px 14px rgba(127,84,179,0.3)); }
  .ec-guarantee__title { font-size: clamp(1.35rem, 2.5vw, 1.85rem); line-height: 1.1; letter-spacing: -.02em; margin: 0 0 .5rem; }
  .ec-guarantee__copy p { font-size: .95rem; color: var(--brutal-text-secondary); line-height: 1.5; }
  .ec-guarantee__copy strong { color: var(--ec-woo); }

  /* ═══════════════════════════════════════════════════════ */
  /* STACK                                                   */
  /* ═══════════════════════════════════════════════════════ */
