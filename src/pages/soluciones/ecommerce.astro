  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · ECOMMERCE WOOCOMMERCE                          */
  /* ═══════════════════════════════════════════════════════ */
  .ec {
    --ec-paper:    #FFFCF6;
    --ec-paper-2:  #F5EFE0;
    --ec-cream:    #F0E7CD;
    --ec-ink:      #0E0D0B;
    --ec-woo:      #7F54B3;
    --ec-woo-d:    #5e3f87;
    --ec-magenta:  #FF2D9A;
    --ec-lime:     #D6FF44;
    --ec-gold:     #C9A24F;
    --ec-mint:     #C8F2D6;
    --ec-blue:     #003B7A;
    --ec-orange:   #FF6B35;
    --ec-yellow:   #FFD600;
    --ec-red:      #DC1B2C;
    --ec-shadow:   8px 8px 0 var(--ec-ink);
  }

  .ec-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--ec-woo);
    box-shadow: 0 0 0 0 rgba(127,84,179,0.55);
    animation: ec-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes ec-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(127,84,179,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(127,84,179,0); }
    100% { box-shadow: 0 0 0 0 rgba(127,84,179,0); }
  }
  .ec-spin { transform-origin: 50% 50%; animation: ec-spin 25s linear infinite; }
  @keyframes ec-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
