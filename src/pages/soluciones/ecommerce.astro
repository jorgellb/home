---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const title = "Tiendas Online y eCommerce en Almería";
const description = "Tienda online profesional en Almería desde 900€. Pasarela de pagos, catálogo y envíos configurados. Hosting gratis. Empieza a vender desde el primer día.";
const canonical = "https://platanitorico.com/soluciones/ecommerce/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Tiendas online y ecommerce en Almería - Platanito Rico"
  keywords="tienda online almería, ecommerce almería, crear tienda online, diseño ecommerce, vender online almería"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      'name': 'Platanito Rico — Tiendas Online y eCommerce en Almería',
      'description': description,
      'url': canonical,
      'telephone': '+34657085019',
      'email': 'hola@platanitorico.com',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Ctra de Ronda, 82',
        'addressLocality': 'Vera',
        'addressRegion': 'Almería',
        'postalCode': '04620',
        'addressCountry': 'ES'
      },
      'geo': { '@type': 'GeoCoordinates', 'latitude': 37.245, 'longitude': -1.8614 },
      'priceRange': '€€',
      'areaServed': { '@type': 'AdministrativeArea', 'name': 'Almería' },
      'serviceType': 'eCommerce Development'
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': 'https://platanitorico.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Soluciones', 'item': 'https://platanitorico.com/soluciones/ecommerce/' },
        { '@type': 'ListItem', 'position': 3, 'name': 'eCommerce', 'item': canonical }
      ]
    }
  ]}
>
  <Header />

  <section class="section-brutal relative min-h-screen flex items-center justify-center overflow-hidden bg-brutal-bg">
    <div class="container-brutal relative z-10 py-24">
      <div class="badge-brutal mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-8 2a2 2 0 1 1 0 4 2 2 0 0 0 0-4z"/>
        </svg>
        eCommerce
      </div>

      <h1 class="heading-display text-4xl md:text-5xl lg:text-7xl text-brutal-text mb-8 leading-[1.1]">
        Tu tienda online lista <br/>
        <span class="block mt-2 text-brutal-accent">para vender desde el día 1</span>
      </h1>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="space-y-8">
          <p class="text-lg md:text-xl text-brutal-text-secondary leading-relaxed">
            ¿Sientes que estás <strong class="text-brutal-text">"perdiendo ventas"</strong> porque no vendes online? O peor aún, ¿tienes una tienda que <strong class="text-brutal-text">"no convierte"</strong>? Transformamos tu negocio en una máquina de vender 24/7.
          </p>

          <div class="space-y-6">
            <h2 class="text-2xl md:text-3xl font-bold text-brutal-text" style="font-family:'Anton',sans-serif">Tienda Online Completa</h2>
            <div class="grid gap-4">
              {[
                {
                  title: "Diseño Orientado a Ventas",
                  desc: "Creamos una experiencia de compra fluida que guía al cliente desde el producto hasta el pago sin fricciones."
                },
                {
                  title: "Pasarela de Pagos Integrada",
                  desc: "Configuramos Stripe, PayPal, Redsys y Bizum para que tus clientes paguen de la forma que prefieran."
                },
                {
                  title: "Gestión de Envíos",
                  desc: "Integración con correos y transportistas. Etiquetas automáticas y seguimiento de pedidos incluido."
                },
                {
                  title: "SEO para Productos",
                  desc: "Optimizamos cada ficha de producto para aparecer en Google cuando busquen lo que vendes."
                }
              ].map(item => (
                <div class="card-brutal bg-brutal-card border-brutal-border p-6">
                  <h3 class="text-lg font-bold text-brutal-text mb-2">{item.title}</h3>
                  <p class="text-brutal-text-secondary">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="sticky top-32">
          <div class="card-brutal bg-brutal-card border-brutal-accent/30 p-8 lg:p-10">
            <div class="w-16 h-16 bg-brutal-accent flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-8 2a2 2 0 1 1 0 4 2 2 0 0 0 0-4z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-brutal-text mb-4" style="font-family:'Anton',sans-serif">Empieza a vender online</h3>
            <p class="text-brutal-text-secondary mb-6">
              Desde catálogos pequeños hasta miles de productos. Te entregamos todo configurado y listo para facturar.
            </p>
            <a href="/contacto" class="btn-brutal group inline-flex items-center justify-center gap-2 w-full px-6 py-4 bg-brutal-accent text-brutal-text font-semibold">
              <span class="relative">Crear mi tienda</span>
              <svg class="relative w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <p class="mt-4 text-center text-sm text-brutal-text-muted">
              Incluye formación para gestionar tu tienda.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
