    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(127,84,179,0.12), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(255,45,154,0.06), transparent 50%),
      var(--ec-paper);
    border-bottom: 3px solid var(--ec-ink);
    position: relative;
    overflow: hidden;
  }
  .ec-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(14,13,11,0.05) 1.2px, transparent 1.2px);
    background-size: 20px 20px;
    pointer-events: none;
