  .ec-kpi--woo     { background: var(--ec-woo); color: var(--ec-paper); }
  .ec-kpi--lime    { background: var(--ec-lime); color: var(--ec-ink); }
  .ec-kpi--magenta { background: var(--ec-magenta); color: var(--ec-paper); }
  .ec-kpi--ink     { background: var(--ec-ink); color: var(--ec-paper); }
  .ec-kpi--ink     .ec-kpi__v { color: var(--ec-lime); }
  .ec-kpi__v { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; line-height: 1; }
  .ec-kpi__v small { font-size: .5em; opacity: .8; }
