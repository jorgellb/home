---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const title = "Web para Emprendedores en Almería | Lanza tu Negocio Digital";
const description = "Lanza tu web en Almería desde 450€ sin complicaciones. Hosting gratis de por vida, SEO incluido y entrega en 2 semanas. Sin permanencia. Presupuesto gratis.";
const canonical = "https://platanitorico.com/soluciones/emprendedor/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Web para emprendedores en Almería - Platanito Rico"
  keywords="web emprendedores almería, lanzar web almería, primera web negocio, diseño web barato almería, startup web almería"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      'name': 'Platanito Rico — Web para Emprendedores en Almería',
      'description': description,
      'url': canonical,
      'telephone': '+34657085019',
      'email': 'hola@platanitorico.com',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Ctra de Ronda, 82',
        'addressLocality': 'Vera',
        'addressRegion': 'Almería',
        'postalCode': '04620',
        'addressCountry': 'ES'
      },
      'geo': { '@type': 'GeoCoordinates', 'latitude': 37.245, 'longitude': -1.8614 },
      'priceRange': '€€',
      'areaServed': { '@type': 'AdministrativeArea', 'name': 'Almería' },
      'serviceType': 'Web Design for Startups'
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': 'https://platanitorico.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Soluciones', 'item': 'https://platanitorico.com/soluciones/ecommerce/' },
        { '@type': 'ListItem', 'position': 3, 'name': 'Emprendedores', 'item': canonical }
      ]
    }
  ]}
>
  <Header />

  <section class="section-brutal relative min-h-screen flex items-center justify-center overflow-hidden bg-brutal-bg">
    <div class="container-brutal relative z-10 py-24">
      <div class="badge-brutal mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
        </svg>
        Emprendedores
      </div>

      <h1 class="heading-display text-4xl md:text-5xl lg:text-7xl text-brutal-text mb-8 leading-[1.1]">
        De la idea a la <br/>
        <span class="block mt-2 text-brutal-accent">realidad digital</span>
      </h1>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="space-y-8">
          <p class="text-lg md:text-xl text-brutal-text-secondary leading-relaxed">
            Sabemos que como emprendedor, tu tiempo es el activo más valioso. <strong class="text-brutal-text">"No tengo tiempo"</strong> o <strong class="text-brutal-text">"No sé por dónde empezar"</strong> son frases que escuchamos a diario.
          </p>

          <div class="space-y-6">
            <h2 class="text-2xl md:text-3xl font-bold text-brutal-text" style="font-family:'Anton',sans-serif">Nuestra solución "Todo Incluido"</h2>
            <div class="grid gap-4">
              {[
                {
                  title: "Diseño y Estrategia",
                  desc: "No solo hacemos una web bonita, creamos una herramienta de venta que comunica tu propuesta de valor."
                },
                {
                  title: "Copywriting Persuasivo",
                  desc: "Redactamos los textos de tu web para que conecten con tu cliente ideal y lo guíen a la acción."
                },
                {
                  title: "Lanzamiento y SEO",
                  desc: "Configuramos todo para que tu sitio sea visible en Google desde el día uno."
                },
                {
                  title: "Formación Básica",
                  desc: "Te enseñamos a gestionar lo básico para que seas dueño de tu propio negocio online."
                }
              ].map(item => (
                <div class="card-brutal bg-brutal-card border-brutal-border p-6">
                  <h3 class="text-lg font-bold text-brutal-text mb-2">{item.title}</h3>
                  <p class="text-brutal-text-secondary">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="sticky top-32">
          <div class="card-brutal bg-brutal-card border-brutal-accent/30 p-8 lg:p-10">
            <div class="w-16 h-16 bg-brutal-accent flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-brutal-text mb-4" style="font-family:'Anton',sans-serif">¿Hablamos de tu proyecto?</h3>
            <p class="text-brutal-text-secondary mb-6">
              Cuéntanos tu idea y te propondremos la ruta más rápida y eficiente para lanzarla al mercado.
            </p>
            <a href="/contacto" class="btn-brutal group inline-flex items-center justify-center gap-2 w-full px-6 py-4 bg-brutal-accent text-brutal-text font-semibold">
              <span class="relative">Empezar ahora</span>
              <svg class="relative w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <p class="mt-4 text-center text-sm text-brutal-text-muted">
              Presupuesto personalizado en menos de 48h.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
