  /* ═══════════════════════════════════════════════════════ */
  /* COMPARE DIY vs PRO                                      */
  /* ═══════════════════════════════════════════════════════ */
  .em-compare-section {
    background: var(--em-panel);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--em-regla2);
  }
  .em-compare {
    border: 3px solid var(--em-regla2);
    box-shadow: var(--em-shadow);
    background: var(--em-panel);
    margin-top: 2rem;
    overflow: hidden;
  }
  .em-compare-head {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 0;
    padding: 1rem 1.5rem;
    background: var(--em-hondo);
    color: var(--em-tinta);
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .2em;
    font-weight: 800;
  }
  .em-compare-head__l { }
  .em-compare-head__c { color: var(--em-red); text-align: center; }
  .em-compare-head__r { color: var(--em-lime); text-align: center; }

  .em-compare-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 0;
    padding: 1rem 1.5rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
    align-items: center;
  }
  .em-compare-row:last-of-type { border-bottom: 2px solid var(--em-regla2); }
  .em-compare-row__item {
    font-size: .92rem;
    color: var(--em-tinta);
    font-weight: 600;
  }
  .em-compare-row__diy, .em-compare-row__pro {
    text-align: center;
    display: flex; flex-direction: column; gap: 2px;
  }
  .em-compare-row__cost {
    font-family: var(--font-mono);
    font-size: .9rem;
    font-weight: 800;
    color: var(--em-red);
  }
  .em-compare-row__cost--ok { color: var(--em-blue-texto); }
  .em-compare-row__time {
    font-size: .65rem;
    letter-spacing: .12em;
    opacity: .65;
  }

  .em-compare-totals {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 0;
    padding: 1.5rem;
    background: var(--em-panel-2);
    align-items: center;
  }
  .em-compare-totals__l {
    font-family: var(--font-mono);
    font-size: .75rem;
    letter-spacing: .25em;
    color: var(--em-tinta);
    font-weight: 800;
  }
  .em-compare-totals__diy, .em-compare-totals__pro {
    text-align: center;
    display: flex; flex-direction: column; gap: 4px;
  }
  .em-compare-totals__big {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1;
    color: var(--em-red);
    letter-spacing: -.02em;
  }
  .em-compare-totals__big--ok { color: var(--em-blue-texto); }
  .em-compare-totals__sub {
    font-size: .68rem;
    letter-spacing: .12em;
    color: var(--em-tinta);
    opacity: .75;
  }
  .em-compare-totals__bad  { font-size: .62rem; letter-spacing: .15em; color: var(--em-red); }
  .em-compare-totals__good { font-size: .62rem; letter-spacing: .15em; color: var(--em-blue-texto); }
  @media (max-width: 768px) {
    .em-compare-head, .em-compare-row, .em-compare-totals {
      grid-template-columns: 1fr;
      gap: .5rem;
      text-align: left !important;
    }
    .em-compare-row__diy, .em-compare-row__pro, .em-compare-totals__diy, .em-compare-totals__pro {
      flex-direction: row; gap: .75rem; align-items: baseline; text-align: left;
    }
    .em-compare-head__c::before { content: 'DIY → '; }
    .em-compare-head__r::before { content: 'PRO → '; }
  }

  .em-compare-note {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--em-lime);
    border: 2px solid var(--em-regla2);
    font-size: .9rem;
    line-height: 1.5;
    color: var(--em-suelo);
  }
  .em-compare-note strong { color: inherit; }

  /* ═══════════════════════════════════════════════════════ */
  /* PRICING                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .em-pricing-section {
    background: var(--em-panel-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--em-regla2);
  }
  .em-plans {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) { .em-plans { grid-template-columns: repeat(3, 1fr); align-items: stretch; gap: 2rem; } }

  .em-plan {
    position: relative;
    background: var(--em-panel);
    border: 3px solid var(--em-regla2);
    box-shadow: var(--em-shadow);
    padding: 2.5rem 1.75rem 2rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .em-plan:hover { transform: translateY(-4px); }
  .em-plan--yellow .em-plan__badge { color: var(--em-yellow); }
  .em-plan--lime   .em-plan__badge { color: var(--em-lime); }
  .em-plan--gold   .em-plan__badge { color: var(--em-gold); }
  .em-plan--popular {
    background: var(--em-hondo);
    color: var(--em-tinta);
    border-color: var(--em-orange);
    box-shadow: 12px 12px 0 var(--em-orange);
    transform: scale(1.02);
  }
  @media (min-width: 1024px) { .em-plan--popular { transform: scale(1.05); } }
  .em-plan--popular:hover { transform: scale(1.02) translateY(-4px); }
  .em-plan--popular .text-meta { color: rgba(255,252,246,0.78); }
  @media (min-width: 1024px) { .em-plan--popular:hover { transform: scale(1.05) translateY(-4px); } }

  .em-plan__ribbon {
    position: absolute;
    top: -16px; left: 50%;
    transform: translateX(-50%);
    background: var(--em-orange);
    color: var(--em-suelo);
    padding: .35rem 1.25rem;
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 2px solid var(--em-regla2);
    box-shadow: 3px 3px 0 var(--em-regla2);
    white-space: nowrap;
  }
  .em-plan__badge { width: 80px; margin: 0 auto; }
  .em-plan__head { display: flex; justify-content: space-between; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; opacity: .85; }
  .em-plan__days { font-size: .68rem; letter-spacing: .15em; opacity: .8; }
  .em-plan__name {
    font-size: clamp(1.5rem, 2.5vw, 1.85rem);
    line-height: 1;
    letter-spacing: -.03em;
    margin: 0;
  }
  .em-plan__sub { font-size: .9rem; opacity: .85; line-height: 1.4; }
  .em-plan__price {
    display: flex; align-items: baseline; gap: .65rem;
    border-block: 2px solid currentColor;
    padding: 1rem 0;
    margin: .5rem 0;
  }
  .em-plan__price-v {
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.03em;
  }
  .em-plan__price-p {
    font-family: var(--font-mono);
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    opacity: .7;
  }
  .em-plan__feat {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .55rem;
    flex: 1;
  }
  .em-plan__feat li {
    display: flex; align-items: flex-start; gap: .65rem;
    font-size: .92rem;
    line-height: 1.4;
  }
  .em-plan__feat svg { color: var(--em-orange); flex-shrink: 0; margin-top: 3px; }
  .em-plan--popular .em-plan__feat svg { color: var(--em-lime); }


  /* Garantía */
  .em-guarantee {
    margin-top: 3rem;
    background: var(--em-panel-2);
    border: 3px solid var(--em-regla2);
    box-shadow: var(--em-shadow);
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 768px) { .em-guarantee { grid-template-columns: 130px 1fr; gap: 2rem; } }
  .em-guarantee__seal { width: 130px; aspect-ratio: 1; transform: rotate(-8deg); filter: drop-shadow(0 6px 14px rgba(220,27,44,0.3)); }
  .em-guarantee__title {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    margin: 0 0 .5rem;
  }
  .em-guarantee__copy p {
    font-size: .95rem;
    color: var(--brutal-text-secondary);
    line-height: 1.5;
  }
  .em-guarantee__copy strong { color: var(--em-tinta); }

  /* ═══════════════════════════════════════════════════════ */
  /* STACK                                                   */
  /* ═══════════════════════════════════════════════════════ */
  .em-stack-section {
    background: var(--em-hondo);
    color: var(--em-tinta);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--em-regla2);
    position: relative;
    overflow: hidden;
  }
  .em-stack-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,107,53,0.06) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .em-stack-section > * { position: relative; }
  .em-stack {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px)  { .em-stack { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .em-stack { grid-template-columns: repeat(3, 1fr); } }
  .em-stack-item {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem;
    background: rgba(255,252,246,0.05);
    border: 2px solid var(--em-regla2);
    transition: background .2s;
  }
  .em-stack-item:hover { background: rgba(255,107,53,0.15); }
  .em-stack-item__icon { width: 60px; height: 60px; }
  .em-stack-item__body { display: flex; flex-direction: column; gap: 2px; }
  .em-stack-item__k {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--em-tinta);
    margin: 0;
  }
  .em-stack-item__v {
    font-size: .82rem;
    line-height: 1.4;
    color: rgba(255,252,246,0.7);
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PROCESO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .em-proc-section {
    background: var(--em-panel);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--em-regla2);
  }
  .em-proc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px)  { .em-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .em-proc { grid-template-columns: repeat(5, 1fr); } }
  .em-proc__step {
    background: var(--em-panel);
    border: 2.5px solid var(--em-regla2);
    box-shadow: 4px 4px 0 var(--em-regla2);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    position: relative;
    transition: transform .25s, box-shadow .25s;
  }
  .em-proc__step::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 5px; background: currentColor;
  }
  .em-proc__step:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--em-regla2); }
  .em-proc__step--orange { color: var(--em-orange); }
  .em-proc__step--yellow { color: var(--em-yellow); }
  .em-proc__step--blue   { color: var(--em-blue-texto); }
  .em-proc__step--mint   { color: var(--em-tinta); }
  .em-proc__step--red    { color: var(--em-red); }
  .em-proc__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: .35rem; border-bottom: 2px dashed rgba(14,13,11,0.2); }
  .em-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--em-tinta); line-height: 1; }
  .em-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--em-tinta); opacity: .65; }
  .em-proc__title {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--em-tinta);
    margin: .25rem 0 0;
  }
  .em-proc__body { font-size: .85rem; line-height: 1.45; color: var(--brutal-text-secondary); }

  /* ═══════════════════════════════════════════════════════ */
  /* CHECKLIST                                               */
  /* ═══════════════════════════════════════════════════════ */
  .em-checklist-section {
    background: var(--em-panel-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--em-regla2);
  }
  .em-check-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
    align-items: end;
  }
  @media (min-width: 768px) { .em-check-head { grid-template-columns: 1.5fr auto; } }
  .em-check-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 .75rem;
  }
  .em-check-lead { color: var(--brutal-text-secondary); max-width: 56ch; }
  .em-check-cta {
    display: inline-flex; align-items: center; gap: .65rem;
    background: var(--em-orange);
    color: var(--em-suelo);
    padding: 1rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    border: 2.5px solid var(--em-regla2);
    box-shadow: 5px 5px 0 var(--em-regla2);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s;
    align-self: end;
    white-space: nowrap;
  }
  .em-check-cta:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--em-regla2); }

  .em-checklist {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .em-checklist { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .em-checklist { grid-template-columns: repeat(3, 1fr); } }
  .em-check-group {
    background: var(--em-panel);
    border: 2.5px solid var(--em-regla2);
    box-shadow: 5px 5px 0 var(--em-regla2);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .75rem;
  }
  .em-check-group__head {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    gap: .65rem;
    align-items: center;
    padding-bottom: .65rem;
    border-bottom: 2px dashed var(--em-regla2);
  }
  .em-check-group__num { font-size: .85rem; font-weight: 800; color: var(--em-orange); }
  .em-check-group__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -.01em;
    color: var(--em-tinta);
    margin: 0;
  }
  .em-check-group__count {
    font-size: .55rem;
    letter-spacing: .2em;
    color: var(--em-blue-texto);
    opacity: .85;
  }
  .em-check-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .5rem; }
  .em-check-item {
    display: flex; align-items: flex-start; gap: .65rem;
    font-size: .88rem;
    line-height: 1.4;
    color: var(--em-tinta);
  }
  .em-check-item__box {
    width: 20px; height: 20px;
    border: 2px solid var(--em-regla2);
    background: var(--em-panel);
    color: var(--em-orange);
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .em-check-item__t { padding-top: 1px; }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIALS                                            */
  /* ═══════════════════════════════════════════════════════ */
  .em-quote-section {
    background: var(--em-panel);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--em-regla2);
  }
  .em-quotes {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .em-quotes { grid-template-columns: repeat(3, 1fr); } }
  .em-quote {
    position: relative;
    background: var(--em-panel);
    border: 2.5px solid var(--em-regla2);
    box-shadow: var(--em-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .em-quote:hover { transform: translateY(-3px); }
  .em-quote--0 { background: var(--em-panel-2); }
  .em-quote--1 { background: var(--em-panel-2); box-shadow: inset 0 3px 0 var(--em-yellow), var(--em-shadow); }
  .em-quote--2 { background: var(--em-panel-2); box-shadow: inset 0 3px 0 var(--em-lime), var(--em-shadow); }
  .em-quote__rocket {
    position: absolute;
    top: -16px; right: 16px;
    font-size: 1.85rem;
    width: 44px; height: 44px;
    background: var(--em-hondo);
    color: var(--em-tinta);
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    border: 2px solid var(--em-regla2);
    box-shadow: 3px 3px 0 var(--em-regla2);
  }
  .em-quote__t {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--em-tinta);
    margin: 0;
    flex: 1;
  }
  .em-quote__f {
    display: flex; align-items: center; gap: .85rem;
    padding-top: 1rem;
    border-top: 2px dashed var(--em-regla2);
  }
  .em-quote__avatar {
    width: 40px; height: 40px;
    background: var(--em-hondo);
    color: var(--em-lime);
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .em-quote__f div { display: flex; flex-direction: column; }
  .em-quote__name { font-family: var(--font-display); font-weight: 700; font-size: .95rem; color: var(--em-tinta); }
  .em-quote__role { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; opacity: .7; text-transform: uppercase; }

  /* ═══════════════════════════════════════════════════════ */
  /* FAQ                                                     */
  /* ═══════════════════════════════════════════════════════ */
  .em-faq-section {
    background: var(--em-panel-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--em-regla2);
  }
  .em-faq {
    list-style: none; padding: 0; margin: 2rem 0 0;
    border-top: 2.5px solid var(--em-regla2);
  }
  .em-faq__item { border-bottom: 2px solid var(--em-regla2); }
  .em-faq__det summary { list-style: none; cursor: pointer; }
  .em-faq__det summary::-webkit-details-marker { display: none; }
  .em-faq__sum {
    display: grid;
    grid-template-columns: 60px 1fr 40px;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem 0;
    transition: padding .2s, background .2s;
  }
  .em-faq__sum:hover { padding-inline: 1rem; background: var(--em-panel); }
  .em-faq__num { font-size: 1rem; font-weight: 800; color: var(--em-orange); letter-spacing: .1em; }
  .em-faq__q {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.3;
    letter-spacing: -.015em;
    color: var(--em-tinta);
    font-weight: 700;
  }
  .em-faq__toggle {
    width: 40px; height: 40px;
    border: 2px solid var(--em-regla2);
    background: var(--em-panel);
    color: var(--em-tinta);
    display: flex; align-items: center; justify-content: center;
    transition: transform .3s, background .2s;
  }
  .em-faq__det[open] .em-faq__toggle { transform: rotate(180deg); background: var(--em-orange); color: var(--em-suelo); }
  .em-faq__ans {
    padding: 0 0 1.5rem 76px;
    color: var(--brutal-text-secondary);
    font-size: .98rem;
    line-height: 1.55;
    max-width: 70ch;
  }
  @media (max-width: 640px) {
    .em-faq__sum { grid-template-columns: 40px 1fr 32px; gap: .5rem; }
    .em-faq__ans { padding-left: 48px; }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* CTA FINAL                                               */
  /* ═══════════════════════════════════════════════════════ */
  .em-final {
    background: var(--em-space);
    color: var(--em-tinta);
    padding: 6rem 1.5rem 0;
    position: relative;
    overflow: hidden;
  }
  .em-final::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(214,255,68,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .em-final > * { position: relative; }
  .em-final__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    padding-bottom: 4rem;
  }
  @media (min-width: 1024px) { .em-final__grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }

