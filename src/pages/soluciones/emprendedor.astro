  .em-tl--gold   { --cat: var(--em-gold); }
  .em-tl--red    { --cat: var(--em-red); border-color: rgba(220,27,44,0.45); }

  /* Barra superior con resplandor */
  .em-tl__bar {
    position: absolute; top: 0; left: 0; right: 0; height: 5px;
    background: var(--cat);
    box-shadow: 0 0 14px -1px var(--cat);
  }
  /* Número fantasma gigante de fondo */
  .em-tl__ghost {
    position: absolute; right: -.5rem; bottom: -1.6rem;
    z-index: -1;
    font-family: var(--font-mono);
    font-size: 5.6rem; font-weight: 800; line-height: 1;
    color: var(--cat);
