---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Web para emprendedores en Almería - Platanito Rico"
  keywords="web emprendedores almería, lanzar web almería, primera web negocio, diseño web barato almería, startup web almería, mvp web almería"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb tono="consola" items={[
    { label: 'Inicio',      href: '/' },
    { label: 'Soluciones',  href: '/soluciones/empresa/' },
    { label: 'Emprendedores' }
  ]} />

  <main id="main-content" class="em">

    {/* ════════════════════════════════════════════════ */}
    {/* HERO — LAUNCH PAD                                 */}
    {/* ════════════════════════════════════════════════ */}
    <section class="em-hero">
      <div class="container-brutal">

        <header class="em-hero__top">
          <span class="text-meta">N.º 027 — Solución · Emprendedores</span>
          <span class="text-meta em-hero__status">
            <span class="em-pulse"></span>
            MISIÓN 027 · LISTOS PARA DESPEGAR · T-MINUS 14 DÍAS
          </span>
        </header>

        <div class="divider-brutal"></div>

        <div class="em-hero__grid">

          {/* Izquierda: copy + KPIs */}
          <div class="em-hero__intro">
            <span class="text-meta em-hero__chapter">Cap. 01 / Despega tu negocio</span>
            <h1 class="em-hero__title heading-display">
              De la
              <em class="heading-editorial">idea</em>
              al
              <span class="em-hero__title-stamp">despegue</span>
              en 14 días.
            </h1>

            <p class="em-hero__lead">
              Web profesional, dominio, correo, SEO y formación — <strong>todo incluido</strong>
              desde <strong>350€</strong>. Sin permanencia, sin sorpresas, sin gastar tu
              tiempo en algo que no es tu negocio.
            </p>

            <div class="em-hero__cta">
              <Boton href="#planes">Iniciar secuencia</Boton>
              <Boton href="#timeline" variante="linea">Ver hoja de ruta</Boton>
            </div>

            <div class="em-hero__kpis">
              <div class="em-kpi em-kpi--orange">
                <span class="em-kpi__v text-mono">14<small>d</small></span>
                <span class="em-kpi__l">Hasta el lanzamiento</span>
              </div>
              <div class="em-kpi em-kpi--lime">
                <span class="em-kpi__v text-mono">450<small>€</small></span>
                <span class="em-kpi__l">Desde · pago único</span>
              </div>
              <div class="em-kpi em-kpi--yellow">
                <span class="em-kpi__v text-mono">∞</span>
                <span class="em-kpi__l">Hosting 1 año gratis</span>
              </div>
              <div class="em-kpi em-kpi--ink">
                <span class="em-kpi__v text-mono">0</span>
                <span class="em-kpi__l">Permanencia</span>
              </div>
            </div>
          </div>

          {/* Derecha: COHETE en plataforma */}
          <aside class="em-hero__pad" aria-hidden="true">
            <svg viewBox="0 0 380 520" class="em-rocket-svg">
              <defs>
                <radialGradient id="em-glow" cx="50%" cy="40%" r="60%">
                  <stop offset="0%"  stop-color="#FF6B35" stop-opacity="0.35"/>
                  <stop offset="100%" stop-color="#FF6B35" stop-opacity="0"/>
                </radialGradient>
                <linearGradient id="em-rocket-body" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%"  stop-color="#FFFCF6"/>
                  <stop offset="50%" stop-color="#F8F2E4"/>
                  <stop offset="100%" stop-color="#E8DFC5"/>
                </linearGradient>
                <linearGradient id="em-rocket-fire" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%"  stop-color="#FFD600"/>
                  <stop offset="50%" stop-color="#FF6B35"/>
                  <stop offset="100%" stop-color="#DC1B2C"/>
                </linearGradient>
              </defs>

              {/* Glow detrás */}
              <circle cx="190" cy="260" r="200" fill="url(#em-glow)"/>

              {/* Estrellas decorativas */}
              <g fill="#FFD600" class="em-stars">
                <text x="40"  y="60"  font-family="monospace" font-size="14">★</text>
                <text x="330" y="100" font-family="monospace" font-size="10">★</text>
                <text x="50"  y="200" font-family="monospace" font-size="8">★</text>
                <text x="340" y="240" font-family="monospace" font-size="12">★</text>
                <text x="30"  y="380" font-family="monospace" font-size="9">★</text>
                <text x="350" y="400" font-family="monospace" font-size="11">★</text>
              </g>

              {/* COHETE */}
              <g class="em-rocket">
                {/* Llama animada */}
                <g class="em-flame">
                  <path d="M 170 380 C 170 380 160 410 175 440 C 180 460 195 460 205 440 C 220 410 210 380 210 380 Z" fill="url(#em-rocket-fire)" stroke="#0E0D0B" stroke-width="2"/>
                  <path d="M 178 388 C 178 388 174 408 183 425 C 188 438 197 438 202 425 C 211 408 207 388 207 388 Z" fill="#FFD600" stroke="#0E0D0B" stroke-width="1.5"/>
                  <path d="M 185 395 C 185 395 184 408 190 418 C 194 425 196 425 200 418 C 206 408 205 395 205 395 Z" fill="#FFFCF6"/>
                </g>

                {/* Aletas */}
                <path d="M 150 320 L 130 380 L 165 360 Z" fill="#DC1B2C" stroke="#0E0D0B" stroke-width="2.5"/>
                <path d="M 230 320 L 250 380 L 215 360 Z" fill="#DC1B2C" stroke="#0E0D0B" stroke-width="2.5"/>

                {/* Cuerpo principal */}
                <rect x="155" y="200" width="70" height="180" rx="4" fill="url(#em-rocket-body)" stroke="#0E0D0B" stroke-width="3"/>

