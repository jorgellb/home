  { d: 'D5',  phase: 'COPY',        title: 'Textos persuasivos',        desc: 'Copywriting orientado a venta. Te enviamos para revisión.',                                ph: 'copy',    color: 'lime'   },
  { d: 'D6',  phase: 'COPY',        title: 'Imágenes / banco',          desc: 'Selección de fotos pro y/o uso de tus assets.',                                            ph: 'copy',    color: 'lime'   },
  { d: 'D7',  phase: 'DESARROLLO',  title: 'Construcción web',          desc: 'Maquetado responsive + animaciones cuidadas.',                                              ph: 'dev',     color: 'blue'   },
  { d: 'D8',  phase: 'DESARROLLO',  title: 'Integraciones',             desc: 'Formularios, mapas, redes, WhatsApp, analytics.',                                          ph: 'dev',     color: 'blue'   },
  { d: 'D9',  phase: 'DESARROLLO',  title: 'Optimización velocidad',    desc: 'Imágenes optimizadas, Core Web Vitals verde, Lighthouse 90+.',                              ph: 'dev',     color: 'blue'   },
  { d: 'D10', phase: 'SEO',         title: 'Setup SEO técnico',         desc: 'Sitemap, robots, schema, meta tags, Open Graph, canonical.',                               ph: 'seo',     color: 'mint'   },
  { d: 'D11', phase: 'SEO',         title: 'Google + Analytics',        desc: 'Search Console + Analytics + Maps + perfil de empresa.',                                   ph: 'seo',     color: 'mint'   },
