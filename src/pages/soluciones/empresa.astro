    'Compatibilidad CRM / Analytics',
  ]},
];

// 6 pilares
const pillars = [
  { num: '01', code: 'A',  icon: 'foundation', title: 'Cimientos',     sub: 'PERFORMANCE · SEO', desc: 'Web ligera, indexada y bien estructurada desde el primer ladrillo. CWV verde, schema completo, sitemap óptimo.',  color: 'navy' },
  { num: '02', code: 'B',  icon: 'facade',     title: 'Fachada',       sub: 'DISEÑO · IDENTIDAD', desc: 'Look profesional alineado con tu marca. Tipografía editorial, paleta corporativa, fotografía pro.',           color: 'gold' },
  { num: '03', code: 'C',  icon: 'structure',  title: 'Estructura',    sub: 'ARQUITECTURA · UX', desc: 'Información jerarquizada · flujo de usuario claro · conversión optimizada. Cada clic tiene un propósito.',       color: 'blue' },
  { num: '04', code: 'D',  icon: 'wiring',     title: 'Instalaciones', sub: 'INTEGRACIONES · API', desc: 'Conexión con tu CRM, ERP, email, booking, contabilidad. Tu web habla con todo tu stack — sin parches.',          color: 'cyan' },
  { num: '05', code: 'E',  icon: 'shield',     title: 'Seguridad',     sub: 'RGPD · WAF · SSL', desc: 'Protección integral · cumplimiento legal · auditorías regulares. Tu reputación nunca está en juego.',                color: 'red' },
  { num: '06', code: 'F',  icon: 'service',    title: 'Mantenimiento', sub: 'SOPORTE · SLA',     desc: 'Updates semanales · backups diarios · soporte humano. Tu web nunca queda obsoleta o desatendida.',                  color: 'mint' },
];

// Antes vs Después (transformación visual con métricas reales)
const transformation = [
  { metric: 'Velocidad de carga',       before: '5,2 s',  after: '1,1 s',   improvement: '-79%',  better: 'after',  unit: '', color: 'red' },
  { metric: 'Lighthouse Performance',   before: '42/100', after: '98/100',  improvement: '+133%', better: 'after',  unit: '', color: 'lime' },
