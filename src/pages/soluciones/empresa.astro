---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const title = "Diseño Web para Empresas en Almería";
const description = "Web corporativa moderna para empresas en Almería. Diseño profesional, SEO incluido y hosting gratuito de por vida. Genera confianza y ventas desde el primer día.";
const canonical = "https://platanitorico.com/soluciones/empresa/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-desarrollo-web-calidad.jpg"
  imageAlt="Diseño web para empresas en Almería - Platanito Rico"
  keywords="diseño web empresas almería, web corporativa almería, presencia digital empresas, seo empresas almería"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      'name': 'Platanito Rico — Diseño Web para Empresas en Almería',
      'description': description,
      'url': canonical,
      'telephone': '+34657085019',
      'email': 'hola@platanitorico.com',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Ctra de Ronda, 82',
        'addressLocality': 'Vera',
        'addressRegion': 'Almería',
        'postalCode': '04620',
        'addressCountry': 'ES'
      },
      'geo': { '@type': 'GeoCoordinates', 'latitude': 37.245, 'longitude': -1.8614 },
      'priceRange': '€€',
      'areaServed': { '@type': 'AdministrativeArea', 'name': 'Almería' },
      'serviceType': 'Corporate Web Design'
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': 'https://platanitorico.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Soluciones', 'item': 'https://platanitorico.com/soluciones/ecommerce/' },
        { '@type': 'ListItem', 'position': 3, 'name': 'Empresas', 'item': canonical }
      ]
    }
  ]}
>
  <Header />

  <section class="section-brutal relative min-h-screen flex items-center justify-center overflow-hidden bg-brutal-bg">
    <div class="container-brutal relative z-10 py-24">
      <div class="badge-brutal mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M6 22V10l6-4 6 4v12H6z"/><path d="M6 12h12"/><path d="M10 22V16h4v6"/>
        </svg>
        Empresas
      </div>

      <h1 class="heading-display text-4xl md:text-5xl lg:text-7xl text-brutal-text mb-8 leading-[1.1]">
        Evolución digital de tu <br/>
        <span class="block mt-2 text-brutal-accent">identidad corporativa</span>
      </h1>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="space-y-8">
          <p class="text-lg md:text-xl text-brutal-text-secondary leading-relaxed">
            Una web <strong class="text-brutal-text">"que no se ve bien"</strong> o que <strong class="text-brutal-text">"parece del siglo pasado"</strong> ahuyenta a potenciales clientes. Tu empresa merece una presencia que transmita profesionalidad y vanguardia.
          </p>

          <div class="space-y-6">
            <h2 class="text-2xl md:text-3xl font-bold text-brutal-text" style="font-family:'Anton',sans-serif">Renovación Integral</h2>
            <div class="grid gap-4">
              {[
                {
                  title: "Rediseño UI/UX Moderno",
                  desc: "Actualizamos visualmente tu marca con las últimas tendencias de diseño, priorizando la facilidad de uso."
                },
                {
                  title: "Optimización de Rendimiento",
                  desc: "Mejoramos la velocidad de carga para reducir la tasa de rebote y escalar posiciones en buscadores."
                },
                {
                  title: "SEO Local e Internacional",
                  desc: "Estrategias específicas para ser encontrado por los clientes que realmente necesitan tus servicios."
                },
                {
                  title: "Integración de Sistemas",
                  desc: "Conectamos tu web con tu CRM, sistema de reservas o cualquier herramienta que ya utilices."
                }
              ].map(item => (
                <div class="card-brutal bg-brutal-card border-brutal-border p-6">
                  <h3 class="text-lg font-bold text-brutal-text mb-2">{item.title}</h3>
                  <p class="text-brutal-text-secondary">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="sticky top-32">
          <div class="card-brutal bg-brutal-card border-brutal-accent/30 p-8 lg:p-10">
            <div class="w-16 h-16 bg-brutal-accent flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path d="M6 22V10l6-4 6 4v12H6z"/><path d="M6 12h12"/><path d="M10 22V16h4v6"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-brutal-text mb-4" style="font-family:'Anton',sans-serif">Moderniza tu empresa</h3>
            <p class="text-brutal-text-secondary mb-6">
              Analizamos tu sitio actual y te proponemos una estrategia de renovación sin comprometer tu imagen establecida.
            </p>
            <a href="/contacto" class="btn-brutal group inline-flex items-center justify-center gap-2 w-full px-6 py-4 bg-brutal-accent text-brutal-text font-semibold">
              <span class="relative">Solicitar Auditoría</span>
              <svg class="relative w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <p class="mt-4 text-center text-sm text-brutal-text-muted">
              Auditoría básica gratuita incluida.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
