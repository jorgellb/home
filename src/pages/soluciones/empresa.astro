  }
  .co-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--co-gold);
    box-shadow: 0 0 0 0 rgba(201,162,79,0.55);
    animation: co-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes co-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(201,162,79,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(201,162,79,0); }
    100% { box-shadow: 0 0 0 0 rgba(201,162,79,0); }
  }
  .co-spin { transform-origin: 50% 50%; animation: co-spin 25s linear infinite; }
  @keyframes co-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO — BLUEPRINT                                        */
  /* ═══════════════════════════════════════════════════════ */
  .co-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(10,37,64,0.08), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(201,162,79,0.06), transparent 50%),
      var(--co-paper);
    border-bottom: 3px solid var(--co-ink);
    position: relative;
    overflow: hidden;
  }
  .co-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(0,102,204,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,102,204,0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .co-hero > * { position: relative; }

  .co-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .co-hero__status { color: var(--co-gold); font-weight: 700; }

  .co-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 1024px) { .co-hero__grid { grid-template-columns: 1fr 1.1fr; align-items: center; gap: 4rem; } }
  .co-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .co-hero__chapter { color: var(--co-navy); }
  .co-hero__title {
    font-size: clamp(2.5rem, 8vw, 5.75rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .co-hero__title em { color: var(--co-navy); font-style: italic; display: inline-block; margin: 0 .1em; }
  .co-hero__title-stamp {
    display: inline-block;
    color: var(--co-gold);
    border-bottom: 6px solid var(--co-gold);
    padding: 0 .1em;
    transform: rotate(-1deg);
  }
  .co-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 58ch;
  }
  .co-hero__lead strong { color: var(--co-ink); font-weight: 700; }
  .co-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .co-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--co-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .co-btn--primary {
    background: var(--co-navy);
    color: var(--co-paper);
    box-shadow: 6px 6px 0 var(--co-ink);
  }
  .co-btn--primary:hover {
    background: var(--co-gold);
    color: var(--co-ink);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--co-ink);
  }
  .co-btn--ghost {
    background: transparent;
    color: var(--co-ink);
    box-shadow: 6px 6px 0 var(--co-navy);
  }
  .co-btn--ghost:hover {
    background: var(--co-ink);
    color: var(--co-lime);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--co-navy);
  }

  /* KPIs */
  .co-hero__kpis {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--co-ink);
    background: var(--co-ink);
  }
  @media (min-width: 768px) { .co-hero__kpis { grid-template-columns: repeat(4, 1fr); } }
  .co-kpi {
    background: var(--co-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--co-ink);
    border-bottom: 2px solid var(--co-ink);
  }
  .co-kpi:nth-child(2n) { border-right: none; }
  .co-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .co-kpi:nth-child(2n)      { border-right: 2px solid var(--co-ink); }
    .co-kpi:nth-child(4n)      { border-right: none; }
    .co-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--co-ink); }
    .co-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .co-kpi--navy { background: var(--co-navy); color: var(--co-paper); }
  .co-kpi--navy .co-kpi__v { color: var(--co-lime); }
  .co-kpi--gold { background: var(--co-gold); color: var(--co-ink); }
  .co-kpi--ink  { background: var(--co-ink); color: var(--co-paper); }
  .co-kpi--ink  .co-kpi__v { color: var(--co-lime); }
  .co-kpi__v { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; line-height: 1; }
  .co-kpi__v small { font-size: .5em; opacity: .8; }
  .co-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* BLUEPRINT */
  .co-hero__plan {
    position: relative;
    max-width: 540px;
    width: 100%;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(10,37,64,0.18));
  }
  .co-blueprint {
    background: var(--co-paper);
    border: 3px solid var(--co-ink);
    box-shadow: var(--co-shadow);
    overflow: hidden;
  }
  .co-blueprint__head, .co-blueprint__foot {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--co-navy);
    color: var(--co-paper);
    font-size: .55rem;
    letter-spacing: .15em;
  }
  .co-blueprint__foot { background: var(--co-paper-2); color: var(--co-ink); border-top: 2px solid var(--co-ink); font-size: .58rem; }
  .co-blueprint__body { padding: 1rem; background: var(--co-paper); }
  .co-plan-svg { display: block; width: 100%; height: auto; }

  .co-stamp {
    position: absolute;
    top: -25px; right: -15px;
    width: 110px; aspect-ratio: 1;
    transform: rotate(-12deg);
    filter: drop-shadow(0 6px 14px rgba(10,37,64,0.4));
    animation: co-bob 4.5s ease-in-out infinite;
    z-index: 3;
  }
  @keyframes co-bob {
    0%, 100% { transform: rotate(-12deg) translateY(0); }
    50%      { transform: rotate(-12deg) translateY(-6px); }
  }

  /* Marquee */
  .co-marquee {
    background: var(--co-navy);
    color: var(--co-lime);
    overflow: hidden;
    padding: .85rem 0;
    border-top: 3px solid var(--co-ink);
  }
  .co-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: co-marquee 32s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  @keyframes co-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* AUDIT                                                   */
  /* ═══════════════════════════════════════════════════════ */
  .co-audit-section {
    background: var(--co-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--co-ink);
  }
  .co-audit-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .co-audit-head { grid-template-columns: 1.5fr 1fr; gap: 3rem; } }

  .co-audit-title {
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: 1rem 0;
  }
  .co-audit-title em { color: var(--co-gold); }
  .co-audit-lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 56ch;
  }
  .co-audit-lead strong { color: var(--co-ink); font-weight: 700; }
  .co-audit-cta {
    display: inline-flex; align-items: center; gap: .65rem;
    background: var(--co-gold);
    color: var(--co-ink);
    padding: 1rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--co-ink);
    box-shadow: 6px 6px 0 var(--co-navy);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
  }
  .co-audit-cta:hover {
    background: var(--co-navy);
    color: var(--co-lime);
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--co-gold);
  }

  .co-audit-stamp {
    max-width: 220px;
    margin: 0 auto;
    transform: rotate(3deg);
    filter: drop-shadow(0 8px 18px rgba(220,27,44,0.18));
  }

  /* Grid 5 cards de auditoría */
  .co-audit-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 560px)  { .co-audit-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px)  { .co-audit-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1280px) { .co-audit-grid { grid-template-columns: repeat(5, 1fr); } }

  .co-audit-card {
    --cat: var(--co-navy);
    position: relative;
    background: var(--co-paper);
    border: 2.5px solid var(--co-ink);
    box-shadow: 5px 5px 0 var(--co-ink);
    padding: 1.4rem 1.25rem 1.35rem;
    display: flex; flex-direction: column;
    overflow: hidden;
    transition: transform .2s, box-shadow .2s;
  }
  .co-audit-card--blue { --cat: var(--co-blue); }
  .co-audit-card--cyan { --cat: var(--co-cyan); }
  .co-audit-card--navy { --cat: var(--co-navy); }
  .co-audit-card--red  { --cat: var(--co-red); }
  .co-audit-card--gold { --cat: var(--co-gold); }

  .co-audit-card__bar { position: absolute; top: 0; left: 0; right: 0; height: 6px; background: var(--cat); }
  .co-audit-card:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--cat); }

  .co-audit-card__head {
    display: flex; align-items: center; justify-content: space-between;
    margin: .25rem 0 1rem;
  }
  .co-audit-card__ic {
    width: 42px; height: 42px; flex: none;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--cat); color: var(--co-paper);
    border: 2.5px solid var(--co-ink);
  }
  .co-audit-card--cyan .co-audit-card__ic,
  .co-audit-card--gold .co-audit-card__ic { color: var(--co-ink); }
  .co-audit-card__code {
    display: flex; flex-direction: column; align-items: flex-end;
    font-size: .92rem; font-weight: 800; line-height: 1; color: var(--co-ink);
  }
  .co-audit-card__code em {
    font-style: normal; font-size: .52rem; letter-spacing: .14em;
    color: var(--brutal-text-secondary); margin-top: .35rem; text-transform: uppercase;
  }

  .co-audit-card__title {
    font-family: var(--font-display);
    font-size: 1.02rem; font-weight: 800; letter-spacing: .04em;
    color: var(--co-ink);
    margin: 0 0 .9rem;
    padding-bottom: .85rem;
    border-bottom: 2px solid rgba(14,13,11,0.12);
  }
  .co-audit-card__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .65rem; }
  .co-audit-card__list li { display: grid; grid-template-columns: 18px 1fr; gap: .55rem; align-items: start; }
  .co-audit-card__check {
    margin-top: .1rem; width: 18px; height: 18px; flex: none;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--cat); color: var(--co-paper);
    border: 1.5px solid var(--co-ink);
  }
  .co-audit-card--cyan .co-audit-card__check,
  .co-audit-card--gold .co-audit-card__check { color: var(--co-ink); }
  .co-audit-card__txt { font-size: .82rem; line-height: 1.4; color: var(--co-ink); }

  /* ═══════════════════════════════════════════════════════ */
  /* PILARES                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .co-pillars-section {
    background: var(--co-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--co-ink);
  }
  .co-pillars {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .co-pillars { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .co-pillars { grid-template-columns: repeat(3, 1fr); } }
  .co-pillar {
    background: var(--co-paper);
    border: 2.5px solid var(--co-ink);
    box-shadow: var(--co-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .co-pillar::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .co-pillar:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 var(--co-ink); }
  .co-pillar--navy { color: var(--co-navy); }
  .co-pillar--gold { color: var(--co-gold); }
  .co-pillar--blue { color: var(--co-blue); }
  .co-pillar--cyan { color: var(--co-cyan); }
  .co-pillar--red  { color: var(--co-red); }
  .co-pillar--mint { color: var(--co-mint); background: var(--co-mint); }

  .co-pillar__head { display: flex; justify-content: space-between; align-items: baseline; padding: .5rem 0; }
  .co-pillar__num { font-size: 1rem; font-weight: 800; color: currentColor; }
  .co-pillar__code {
    background: var(--co-ink);
    color: var(--co-lime);
    padding: .25rem .55rem;
    font-family: var(--font-mono);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .15em;
  }
  .co-pillar__icon { width: 60px; height: 60px; color: currentColor; }
  .co-pillar__title {
    font-size: clamp(1.4rem, 2.5vw, 1.75rem);
    line-height: 1;
    letter-spacing: -.025em;
    color: var(--co-ink);
    margin: 0;
  }
  .co-pillar__sub {
    font-size: .62rem;
    letter-spacing: .25em;
    color: currentColor;
    font-weight: 800;
  }
  .co-pillar__desc {
    font-size: .92rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* TRANSFORM                                               */
  /* ═══════════════════════════════════════════════════════ */
  .co-transform-section {
    background: var(--co-navy);
    color: var(--co-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--co-ink);
    position: relative;
    overflow: hidden;
  }
  .co-transform-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(214,255,68,0.05) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .co-transform-section > * { position: relative; }
  .co-transform {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--co-paper);
    border: 2.5px solid var(--co-paper);
  }
  @media (min-width: 768px)  { .co-transform { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .co-transform { grid-template-columns: repeat(4, 1fr); } }
  .co-transform__item {
    background: var(--co-navy);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: background .25s;
  }
  .co-transform__item:hover { background: rgba(214,255,68,0.08); }
  .co-transform__head { display: flex; align-items: baseline; gap: .65rem; padding-bottom: .65rem; border-bottom: 1.5px dashed rgba(255,252,246,0.18); }
  .co-transform__num { font-size: .75rem; color: var(--co-gold); font-weight: 800; }
  .co-transform__metric {
    font-family: var(--font-display);
    font-size: .92rem;
    font-weight: 700;
    color: var(--co-paper);
    margin: 0;
    line-height: 1.15;
  }
  .co-transform__values {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: .5rem;
    align-items: center;
  }
  .co-transform__before, .co-transform__after { display: flex; flex-direction: column; gap: 2px; text-align: center; }
  .co-transform__lbl { font-size: .55rem; letter-spacing: .2em; color: var(--co-paper); opacity: .55; }
  .co-transform__v {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1;
  }
  .co-transform__v--bad  { color: var(--co-red); text-decoration: line-through; opacity: .7; }
  .co-transform__v--good { color: var(--co-lime); }
  .co-transform__arrow { color: var(--co-gold); }
  .co-transform__improvement {
    text-align: center;
    background: var(--co-lime);
    color: var(--co-ink);
    padding: .35rem;
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    border: 1.5px solid var(--co-paper);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* INTEGRACIONES                                           */
  /* ═══════════════════════════════════════════════════════ */
  .co-integ-section {
    background: var(--co-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--co-ink);
  }
  .co-integ {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px)  { .co-integ { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .co-integ { grid-template-columns: repeat(4, 1fr); } }
  .co-integ__cat {
    background: var(--co-paper);
    border: 2px solid var(--co-ink);
    box-shadow: 5px 5px 0 var(--co-ink);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .2s, box-shadow .2s;
  }
  .co-integ__cat:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--co-navy); }
  .co-integ__cat-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .65rem;
    align-items: baseline;
    padding-bottom: .5rem;
    border-bottom: 2px dashed var(--co-ink);
  }
  .co-integ__cat-num { font-size: .85rem; color: var(--co-gold); font-weight: 800; letter-spacing: .15em; }
  .co-integ__cat-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--co-ink);
    margin: 0;
  }
  .co-integ__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .5rem; }
  .co-integ__item {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: .65rem;
    align-items: center;
    padding: .55rem .75rem;
    background: var(--co-paper-2);
    border: 1.5px solid var(--co-ink);
    font-size: .9rem;
    font-weight: 600;
    color: var(--co-ink);
    transition: background .2s;
  }
  .co-integ__item:hover { background: var(--co-cream); }
  .co-integ__item-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: currentColor;
    border: 1.5px solid var(--co-ink);
  }
  .co-integ__item--orange { color: var(--co-orange); }
  .co-integ__item--cyan   { color: var(--co-cyan); }
  .co-integ__item--red    { color: var(--co-red); }
  .co-integ__item--lime   { color: var(--co-lime); }
  .co-integ__item--navy   { color: var(--co-navy); }
  .co-integ__item--blue   { color: var(--co-blue); }
  .co-integ__item--gold   { color: var(--co-gold); }
  .co-integ__item--mint   { color: var(--co-mint); }
  .co-integ__item--yellow { color: var(--co-yellow); }

  .co-integ-note {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--co-cream);
    border: 2px solid var(--co-ink);
    font-size: .92rem;
    line-height: 1.5;
    color: var(--co-ink);
  }
