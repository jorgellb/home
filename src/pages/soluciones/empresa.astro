// Proceso corporativo (8 pasos con puertas de aprobación)
const proceso = [
  { num: '01', title: 'Briefing ejecutivo',     gate: 'KO/APROBADO',    eta: 'Sem 1', body: 'Sesión inicial con stakeholders. Definimos objetivos, audiencia, KPIs y restricciones.' },
  { num: '02', title: 'Auditoría técnica',      gate: 'INFORME',         eta: 'Sem 1', body: 'Análisis exhaustivo de tu web actual: rendimiento, SEO, accesibilidad, conversión.' },
  { num: '03', title: 'Arquitectura + wireframes', gate: 'APROBACIÓN',    eta: 'Sem 2', body: 'Sitemap + flujos · wireframes de todas las páginas clave. Revisión y aprobación.' },
  { num: '04', title: 'Diseño visual',          gate: 'APROBACIÓN',     eta: 'Sem 3-4', body: 'Mockups en alta fidelidad. 2 rondas de revisión incluidas. Validación stakeholders.' },
  { num: '05', title: 'Desarrollo',             gate: 'STAGING',         eta: 'Sem 4-7', body: 'Construcción real con CWV verde, accesibilidad AA, integraciones. Entorno staging.' },
