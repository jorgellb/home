  { metric: 'Informe mensual',          essential: 'Básico',    pro: 'Avanzado', plus: 'Ejecutivo' },
  { metric: 'Auditoría seguridad',      essential: 'Anual',     pro: 'Semestral',plus: 'Trimestral' },
  { metric: 'Reunión periódica',        essential: '—',         pro: 'Mensual',  plus: 'Quincenal' },
