  { metric: 'Posicionamiento Google',   before: 'Pág. 4', after: 'Pág. 1',  improvement: '4 posic', better: 'after', unit: '', color: 'lime' },
  { metric: 'Mobile-friendly',          before: 'NO',     after: 'SÍ',      improvement: '✓',     better: 'after',  unit: '', color: 'lime' },
