const canonical = "https://platanitorico.com/soluciones/empresa/";

// ─── DATOS ─────────────────────────────────────

// Auditoría gratuita (15 puntos reales)
const auditPoints = [
  { c: 'RENDIMIENTO', color: 'blue', icon: '<path d="M4 17a8 8 0 0116 0"/><path d="M12 17l4-4"/>', items: [
    'Velocidad de carga (Core Web Vitals)',
