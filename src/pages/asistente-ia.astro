---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import AsistenteChat from '../components/asistente/AsistenteChat.tsx';

const title = 'Asistente IA · Demo de agente que responde dudas | Platanito Rico';
const description =
  'Demo de un agente de IA conversacional que atiende a tus clientes como una persona: responde dudas sobre servicios, precios y plazos 24/7. Pruébalo en vivo.';
const canonical = 'https://platanitorico.com/asistente-ia/';

const features = [
  { ico: '💬', t: 'Responde como una persona', d: 'Conversa de forma natural, entiende el contexto y resuelve dudas reales.' },
  { ico: '🕐', t: 'Atiende 24/7', d: 'Sin esperas ni horarios: tus clientes reciben respuesta al instante.' },
  { ico: '🎯', t: 'Conoce tu negocio', d: 'Se entrena con tus servicios, precios y procesos. No inventa.' },
  { ico: '📩', t: 'Capta y deriva', d: 'Detecta interés y pasa el cliente a una persona o a un formulario.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Asistente IA · Platanito Rico',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: canonical,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://platanitorico.com/' },
      { '@type': 'ListItem', position: 2, name: 'Diseño Web', item: 'https://platanitorico.com/desarrollo-web/' },
      { '@type': 'ListItem', position: 3, name: 'Asistente IA', item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-desarrollo-web-calidad.jpg"
  imageAlt="Asistente IA conversacional - Platanito Rico"
  type="website"
  lang="es"
  keywords="asistente IA, chatbot inteligente, agente conversacional, atención al cliente IA, chatbot empresa, IA atención 24/7"
  jsonLd={jsonLd}
>
  <Header />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Diseño Web', href: '/desarrollo-web/' },
    { label: 'Asistente IA' },
  ]} />

  <main id="main-content" class="ai">
    {/* HERO */}
    <section class="ai-hero">
      <div class="container-brutal ai-hero__inner">
        <span class="ai-eyebrow">✦ Demo en vivo · Agente conversacional</span>
        <h1 class="ai-hero__title">Un asistente de IA que <em>atiende</em> por ti</h1>
        <p class="ai-hero__lead">
          Responde las dudas de tus clientes sobre servicios, precios y plazos —como una persona del equipo,
          pero <strong>24/7 y al instante</strong>. Pruébalo aquí mismo: pregúntale lo que quieras sobre
          Platanito Rico.
        </p>
      </div>
    </section>

    {/* CHAT (island React) */}
    <section class="ai-demo" id="demo">
      <div class="container-brutal">
        <AsistenteChat client:load />
        <noscript>
          <p class="ai-noscript">Activa JavaScript para hablar con el asistente.</p>
        </noscript>
      </div>
    </section>

    {/* FEATURES */}
    <section class="ai-features">
      <div class="container-brutal">
        <header class="ai-sec-head">
          <span class="ai-eyebrow ai-eyebrow--dark">✦ Qué hace por tu negocio</span>
          <h2 class="ai-h2">No es un chatbot de respuestas robóticas.</h2>
        </header>
        <ul class="ai-features__grid">
          {features.map((f) => (
            <li class="ai-feature">
              <span class="ai-feature__ico" aria-hidden="true">{f.ico}</span>
              <b>{f.t}</b>
              <p>{f.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* CTA */}
    <section class="ai-cta">
      <div class="container-brutal ai-cta__inner">
        <span class="ai-eyebrow">✦ ¿Lo quieres en tu web?</span>
        <h2 class="ai-cta__title">Te montamos tu asistente de IA a medida.</h2>
        <p class="ai-cta__text">
          Entrenado con tus servicios y conectado a tu web, WhatsApp o ficha de Google. Atiende, resuelve
          y capta clientes mientras tú te dedicas a lo tuyo.
        </p>
        <div class="ai-cta__btns">
          <a href="/contacto/" class="btn-brutal btn-brutal--lg">Quiero mi asistente IA →</a>
          <a href="/vera-ai/" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Ver el agente para negocios</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .ai { background: #05070b; color: #e8edf5; }
  .ai-eyebrow { display: inline-block; font-family: var(--font-mono, monospace); font-size: .66rem; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: #c6ff3a; }
  .ai-eyebrow--dark { color: #FF6B35; }

  .ai-hero {
    padding: 4rem 0 2.5rem;
    background: radial-gradient(90% 60% at 50% -10%, rgba(24,224,255,0.16) 0%, transparent 60%), linear-gradient(180deg, #0a0f18, #05070b);
    border-bottom: 1px solid #1a2233; position: relative; overflow: hidden;
  }
  .ai-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(#18e0ff14 1px, transparent 1px), linear-gradient(90deg, #18e0ff14 1px, transparent 1px);
    background-size: 30px 30px; mask-image: radial-gradient(70% 60% at 50% 0%, #000 0%, transparent 75%);
  }
  .ai-hero__inner { position: relative; }
  .ai-hero__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.3rem, 7vw, 4.5rem); font-weight: 800; line-height: .98; letter-spacing: -.04em; margin: 1rem 0; color: #fff; }
  .ai-hero__title em { font-style: normal; color: #18e0ff; }
  .ai-hero__lead { font-size: clamp(1.05rem, 2.4vw, 1.3rem); line-height: 1.5; color: #b9c4d4; max-width: 60ch; margin: 0; }
  .ai-hero__lead strong { color: #fff; }

  .ai-demo { padding: 3rem 0; background: linear-gradient(180deg, #05070b, #080c14); }
  .ai-noscript { text-align: center; color: #9aa7ba; margin-top: 1.5rem; }

  .ai-features { padding: 4rem 0; background: var(--brutal-bg, #F5F1EA); color: var(--brutal-ink, #0E0D0B); border-top: 3px solid var(--brutal-ink, #0E0D0B); border-bottom: 3px solid var(--brutal-ink, #0E0D0B); }
  .ai-sec-head { max-width: 60ch; margin-bottom: 2rem; }
  .ai-h2 { font-family: var(--font-display, sans-serif); font-size: clamp(1.8rem, 5vw, 3rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin: .6rem 0 0; }
  .ai-features__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 560px) { .ai-features__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .ai-features__grid { grid-template-columns: repeat(4, 1fr); } }
  .ai-feature { background: #fff; border: 2.5px solid var(--brutal-ink, #0E0D0B); box-shadow: 5px 5px 0 var(--brutal-ink, #0E0D0B); padding: 1.4rem 1.25rem; }
  .ai-feature__ico { font-size: 1.7rem; }
  .ai-feature b { display: block; font-family: var(--font-display, sans-serif); font-size: 1.05rem; margin: .5rem 0 .35rem; }
  .ai-feature p { margin: 0; font-size: .85rem; line-height: 1.45; color: #4a453f; }

  .ai-cta { padding: 4.5rem 0; background: radial-gradient(80% 100% at 50% 0%, rgba(198,255,58,0.12) 0%, transparent 60%), #05070b; border-top: 1px solid #1a2233; }
  .ai-cta__inner { max-width: 720px; }
  .ai-cta__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.2rem, 6vw, 4rem); font-weight: 800; letter-spacing: -.04em; line-height: .95; margin: .6rem 0 1rem; color: #fff; }
  .ai-cta__text { font-size: 1.05rem; line-height: 1.55; color: #b9c4d4; margin: 0 0 2rem; }
  .ai-cta__btns { display: flex; flex-wrap: wrap; gap: 1rem; }
  .ai-cta .btn-brutal--ghost { background: transparent; color: #fff; border-color: #2a3445; }
</style>
