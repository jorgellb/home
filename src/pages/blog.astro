---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase();
}
function calculateReadingTime(content: string): number {
  return Math.max(1, Math.ceil((content || '').split(/\s+/).length / 200));
}

const [featured, ...rest] = posts;
---

<BaseLayout
  title="Blog · Tecnología, SEO y Marketing"
  description="Artículos sobre tecnología, VERIFACTU, marketing digital y consejos para empresas y autónomos en Almería."
  canonical="https://platanitorico.com/blog/"
  image="/imagenes/equipo-marketing-web.jpg"
  imageAlt="Blog de tecnología y marketing digital"
  type="website"
  keywords="blog tecnología, VERIFACTU, marketing digital, blog almería"
  jsonLd={[
    { "@context": "https://schema.org", "@type": "Blog", "name": "Blog Platanito Rico", "url": "https://platanitorico.com/blog/", "inLanguage": "es" },
    { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog",  "item": "https://platanitorico.com/blog/" }
    ]}
  ]}
>
  <Header />

  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Blog' }]} />

  <main id="main-content">
    {/* HERO editorial */}
    <section class="blog-hero">
      <div class="container-brutal">
        <header class="blog-hero__head">
          <span class="text-meta">N.º 100 — Diario · Vol. {new Date().getFullYear()}</span>
          <span class="text-meta">{posts.length} entradas publicadas</span>
        </header>
        <div class="divider-brutal-thick"></div>
        <div class="blog-hero__grid">
          <div>
            <span class="text-meta">★ Diario</span>
            <h1 class="blog-hero__title heading-display">
              Notas sobre
              <em class="heading-editorial">tecnología</em>
              y crecimiento.
            </h1>
          </div>
          <p class="blog-hero__lead">
            Pensamientos, prácticas y manuales de campo. Sobre
            <strong>facturación electrónica, performance, SEO, web3</strong> —
            y todo lo que un negocio necesita saber para no quedarse atrás.
          </p>
        </div>
      </div>
    </section>

    {posts.length === 0 ? (
      <section class="section-brutal">
        <div class="container-brutal blog-empty">
          <span class="text-meta">∅ Sin entradas todavía</span>
          <h2 class="heading-display blog-empty__title">Próximamente.</h2>
          <p class="blog-empty__text">Estamos preparando contenido. Mientras tanto, escríbenos.</p>
          <a href="/contacto" class="btn-brutal btn-brutal--lg">Hablemos →</a>
        </div>
      </section>
    ) : (
      <>
        {/* FEATURED POST — XL */}
        {featured && (
          <section class="blog-feature">
            <div class="container-brutal">
              <a href={`/blog/${featured.data.slug}`} class="blog-feature__link">
                <div class="blog-feature__media">
                  {featured.data.featuredImage ? (
                    <img src={featured.data.featuredImage} alt={featured.data.featuredImageAlt || featured.data.title} loading="eager" />
                  ) : (
                    <div class="blog-feature__placeholder dotgrid"></div>
                  )}
                  <span class="blog-feature__badge badge-brutal badge-brutal--lime">★ Destacado</span>
                </div>
                <div class="blog-feature__body">
                  <div class="blog-feature__meta">
                    <span class="text-meta">{formatDate(featured.data.publishedAt)}</span>
                    <span class="text-meta">{featured.data.readingTime || calculateReadingTime(featured.body || '')} min lectura</span>
                    {featured.data.categories && featured.data.categories[0] && (
                      <span class="text-meta">/ {featured.data.categories[0]}</span>
                    )}
                  </div>
                  <h2 class="blog-feature__title heading-display">{featured.data.title}</h2>
                  {featured.data.excerpt && <p class="blog-feature__excerpt">{featured.data.excerpt}</p>}
                  <span class="blog-feature__cta">
                    Leer el artículo →
                  </span>
                </div>
              </a>
            </div>
          </section>
        )}

        {/* GRID resto */}
        <section class="section-brutal" style="padding-top:2rem;">
          <div class="container-brutal">
            <header class="blog-grid__head">
              <span class="text-meta">★ Más entradas</span>
              <div class="divider-brutal"></div>
            </header>
            <ol class="blog-grid">
              {rest.map((post, i) => {
                const rt = post.data.readingTime || calculateReadingTime(post.body || '');
                return (
                  <li class="blog-card" style={`--i:${i}`}>
                    <a href={`/blog/${post.data.slug}`} class="blog-card__link">
                      <div class="blog-card__media">
                        {post.data.featuredImage ? (
                          <img src={post.data.featuredImage} alt={post.data.featuredImageAlt || post.data.title} loading="lazy" />
                        ) : (
                          <div class="blog-card__placeholder crosshatch-soft"></div>
                        )}
                        <span class="blog-card__num text-mono">N.º {String(i + 2).padStart(2, '0')}</span>
                      </div>
                      <div class="blog-card__body">
                        <div class="blog-card__meta">
                          <span class="text-meta">{formatDate(post.data.publishedAt)}</span>
                          <span class="text-meta">{rt} min</span>
                        </div>
                        <h3 class="blog-card__title heading-display">{post.data.title}</h3>
                        {post.data.excerpt && <p class="blog-card__excerpt">{post.data.excerpt}</p>}
                        <div class="blog-card__tags">
                          {(post.data.categories || []).slice(0, 2).map((c: string) => <span class="tag-brutal">{c}</span>)}
                        </div>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ol>
          </div>
        </section>
      </>
    )}

    {/* Newsletter CTA editorial */}
    <section class="blog-cta">
      <div class="container-brutal">
        <div class="blog-cta__inner">
          <div>
            <span class="text-meta">★ Manténte cerca</span>
            <h2 class="heading-display blog-cta__title">
              ¿Quieres leer lo
              <em class="heading-editorial">próximo?</em>
            </h2>
            <p class="blog-cta__text">
              Publicamos cuando tenemos algo que decir, sin spam. Suscríbete por email
              o sígueme en LinkedIn — donde sueles estar.
            </p>
          </div>
          <div class="blog-cta__btns">
            <a href="https://www.linkedin.com/company/platanitorico/" target="_blank" rel="noopener noreferrer" class="btn-brutal btn-brutal--lg">
              LinkedIn →
            </a>
            <a href="/contacto" class="btn-brutal btn-brutal--ghost btn-brutal--lg">
              Suscríbete por email
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .blog-hero {
    padding: 3rem 0;
    background: var(--brutal-bg);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .blog-hero__head {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    padding-bottom: 1rem;
  }
  .blog-hero__grid {
    display: grid; gap: 2rem; margin-top: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .blog-hero__grid { grid-template-columns: 1.6fr 1fr; align-items: end; gap: 4rem; }
  }
  .blog-hero__title {
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: .9;
    letter-spacing: -.045em;
    margin: .75rem 0 0;
    max-width: 18ch;
  }
  .blog-hero__title em { color: var(--brutal-accent); font-style: italic; }
  .blog-hero__lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 44ch; }
  .blog-hero__lead strong { color: var(--brutal-ink); }

  /* Featured */
  .blog-feature {
    padding: 4rem 0;
    background: var(--brutal-bg-alt);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .blog-feature__link {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    box-shadow: 10px 10px 0 0 var(--brutal-ink);
    text-decoration: none;
    color: var(--brutal-ink);
    transition: transform .35s, box-shadow .35s, background .3s;
  }
  .blog-feature__link:hover { transform: translate(-4px,-4px); box-shadow: 14px 14px 0 0 var(--brutal-accent); background: var(--brutal-bg); }
  @media (min-width: 1024px) {
    .blog-feature__link { grid-template-columns: 1.2fr 1fr; }
  }
  .blog-feature__media {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: var(--brutal-surface);
    border-right: 2px solid var(--brutal-ink);
  }
  .blog-feature__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .5s, filter .3s;
    filter: contrast(1.02) grayscale(.15);
  }
  .blog-feature__link:hover .blog-feature__media img { transform: scale(1.04); filter: none; }
  .blog-feature__placeholder { width: 100%; height: 100%; }
  .blog-feature__badge { position: absolute; top: 1rem; left: 1rem; box-shadow: 3px 3px 0 0 var(--brutal-ink); }

  .blog-feature__body { padding: clamp(1.5rem, 4vw, 3rem); display: flex; flex-direction: column; gap: 1rem; }
  .blog-feature__meta { display: flex; flex-wrap: wrap; gap: 1rem; }
  .blog-feature__title {
    font-size: clamp(1.75rem, 4.5vw, 3.25rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 0;
  }
  .blog-feature__excerpt { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); }
  .blog-feature__cta {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--brutal-border-soft);
    font-family: var(--font-mono);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    font-weight: 700;
    color: var(--brutal-ink);
  }
  .blog-feature__link:hover .blog-feature__cta { color: var(--brutal-accent); }

  /* Grid */
  .blog-grid__head { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .blog-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    background: var(--brutal-ink);
    border: 2px solid var(--brutal-ink);
  }
  @media (min-width: 768px) { .blog-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }

  .blog-card { background: var(--brutal-card); }
  .blog-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--brutal-ink);
    transition: background .25s;
  }
  .blog-card__link:hover { background: var(--brutal-bg-alt); }
  .blog-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--brutal-surface);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .blog-card__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .5s, filter .3s;
    filter: contrast(1.02) grayscale(.15);
  }
  .blog-card__link:hover .blog-card__media img { transform: scale(1.04); filter: none; }
  .blog-card__placeholder { width: 100%; height: 100%; }
  .blog-card__num {
    position: absolute; top: 1rem; left: 1rem;
    background: var(--brutal-ink); color: var(--brutal-lime);
    padding: .25rem .55rem; font-size: .62rem;
    text-transform: uppercase; letter-spacing: .15em; font-weight: 700;
  }

  .blog-card__body { padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem; flex: 1; }
  .blog-card__meta { display: flex; gap: 1rem; }
  .blog-card__title {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.05;
    letter-spacing: -.025em;
    margin: 0;
    transition: color .2s;
  }
  .blog-card__link:hover .blog-card__title { color: var(--brutal-accent); }
  .blog-card__excerpt { font-size: .9rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; flex: 1; }
  .blog-card__tags { display: flex; flex-wrap: wrap; gap: .35rem; padding-top: .75rem; border-top: 1px solid var(--brutal-border-soft); }

  /* Empty state */
  .blog-empty { text-align: center; padding: 4rem 0; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .blog-empty__title { font-size: clamp(2rem, 5vw, 3.5rem); margin: 0; }
  .blog-empty__text { color: var(--brutal-text-secondary); max-width: 40ch; }

  /* CTA */
  .blog-cta { padding: 4rem 0; background: var(--brutal-ink); color: var(--brutal-bg); }
  .blog-cta__inner {
    display: grid; gap: 2rem; grid-template-columns: 1fr;
    background: var(--brutal-ink);
  }
  @media (min-width: 1024px) {
    .blog-cta__inner { grid-template-columns: 1.5fr 1fr; align-items: end; gap: 4rem; }
  }
  .blog-cta__inner .text-meta { color: var(--brutal-accent); }
  .blog-cta__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .9;
    letter-spacing: -.04em;
    margin: .5rem 0 0;
    color: var(--brutal-bg);
  }
  .blog-cta__title em { color: var(--brutal-lime); font-style: italic; }
  .blog-cta__text { margin: 1rem 0 0; font-size: 1rem; line-height: 1.55; color: var(--brutal-bg-alt); max-width: 44ch; }
  .blog-cta__btns { display: flex; flex-wrap: wrap; gap: 1rem; }
  .blog-cta .btn-brutal--ghost { background: transparent; color: var(--brutal-bg); border-color: var(--brutal-bg); --shadow-color: var(--brutal-accent); }
</style>
