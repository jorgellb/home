---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import Sitio from '../layouts/Sitio.astro';
import Migas from '../components/sitio/Migas.astro';
import Icono from '../components/sitio/Icono.astro';
import Ilustracion from '../components/sitio/Ilustracion.astro';
import LlamadaFinal from '../components/sitio/LlamadaFinal.astro';
import { SITE } from '../data/negocio';

/* Versiones ligeras de la imagen destacada (800 px), las mismas que el artículo. */
function ligeras(imagen?: string): [string, string][] {
  if (!imagen?.startsWith('/')) return [];
  const base = imagen.replace(/\.(jpe?g|png)$/i, '-800');
  return (['avif', 'webp'] as const)
    .filter((f) => existsSync(join(process.cwd(), 'public', `${base}.${f}`)))
    .map((f) => [`image/${f}`, `${base}.${f}`]);
}

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const [destacado, ...resto] = posts;
const fecha = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const minutos = (p: (typeof posts)[number]) => p.data.readingTime || Math.max(1, Math.ceil((p.body || '').split(/\s+/).length / 200));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog de Platanito Rico',
  url: `${SITE}/blog/`,
  inLanguage: 'es-ES',
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${SITE}/blog/${p.data.slug}/`,
    datePublished: p.data.publishedAt.toISOString(),
  })),
};
---

<Sitio
  title="Blog de diseño web, SEO y tecnología para empresas"
  description="Guías prácticas sobre webs, SEO local, hosting, legalidad digital y tecnología para negocios y autónomos de Almería. Escritas por quien hace el trabajo."
  canonical={`${SITE}/blog/`}
  jsonLd={jsonLd}
>
  <section class="cabeza">
    <div class="contenedor cabeza__rejilla">
      <div class="cabeza__texto">
        <Migas items={[{ nombre: 'Blog' }]} />
        <p class="antetitulo">Blog</p>
        <h1>Para decidir con <span class="subrayado">criterio</span></h1>
        <p class="entradilla">
          Guías largas y honestas sobre webs, SEO, hosting, ley digital y tecnología. Lo que explicaríamos a un cliente
          en una reunión, por escrito y sin vender nada.
        </p>
      </div>
      <Ilustracion nombre="blog" class="cabeza__ilustracion" prioridad />
    </div>
  </section>

  {destacado && (
    <section class="contenedor destacado-caja" aria-label="Artículo más reciente">
      <a href={`/blog/${destacado.data.slug}/`} class="destacado">
        {destacado.data.featuredImage && (
          <picture class="destacado__imagen">
            {ligeras(destacado.data.featuredImage).map(([t, s]) => <source type={t} srcset={s} />)}
            <img src={destacado.data.featuredImage} alt="" width="800" height="600" loading="eager" decoding="async" />
          </picture>
        )}
        <div class="destacado__texto">
          <p class="meta">
            <span class="categoria">{destacado.data.categories?.[0] ?? 'Artículo'}</span>
            {fecha(destacado.data.publishedAt)} · {minutos(destacado)} min
          </p>
          <h2>{destacado.data.title}</h2>
          <p>{destacado.data.excerpt}</p>
          <span class="leer">Leer el artículo <Icono nombre="flecha" tamano={18} /></span>
        </div>
      </a>
    </section>
  )}

  <section class="seccion" aria-labelledby="todos">
    <div class="contenedor">
      <h2 id="todos" class="todos__titulo">Todos los artículos</h2>
      <ul class="rejilla">
        {resto.map((p) => (
          <li>
            <a href={`/blog/${p.data.slug}/`} class="tarjeta">
              {p.data.featuredImage && (
                <picture>
                  {ligeras(p.data.featuredImage).map(([t, s]) => <source type={t} srcset={s} />)}
                  <img src={p.data.featuredImage} alt="" width="800" height="600" loading="lazy" decoding="async" />
                </picture>
              )}
              <div class="tarjeta__texto">
                <p class="meta">
                  <span class="categoria">{p.data.categories?.[0] ?? 'Artículo'}</span>
                  {fecha(p.data.publishedAt)}
                </p>
                <h3>{p.data.title}</h3>
                <p>{p.data.excerpt}</p>
                <span class="leer">{minutos(p)} min de lectura <Icono nombre="flecha" tamano={16} /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <LlamadaFinal />
</Sitio>

<style>
  .cabeza {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) 2.5rem;
  }
  .cabeza__rejilla {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .cabeza__texto {
    display: grid;
    gap: 1.25rem;
  }
  .cabeza h1 {
    font-size: var(--t-3xl);
  }
  .cabeza :global(.cabeza__ilustracion) {
    max-width: 320px;
    justify-self: center;
  }
  @media (min-width: 900px) {
    .cabeza__rejilla {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--tenue);
  }
  .categoria {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--verde-suave);
    color: var(--verde);
    font-weight: 700;
  }
  .leer {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    color: var(--verde);
    font-weight: 680;
    font-size: var(--t-s);
  }
  .destacado {
    display: grid;
    overflow: hidden;
    border-radius: calc(var(--radio-l) * 1.25);
    border: 1px solid var(--linea);
    background: var(--superficie);
    text-decoration: none;
    transition: box-shadow 0.3s;
  }
  .destacado:hover {
    box-shadow: var(--sombra-l);
  }
  .destacado__imagen img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .destacado__texto {
    display: grid;
    gap: 1rem;
    align-content: center;
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .destacado h2 {
    font-size: var(--t-2xl);
  }
  .destacado__texto > p:not(.meta) {
    color: var(--tinta-2);
  }
  @media (min-width: 900px) {
    .destacado {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .todos__titulo {
    font-size: var(--t-xl);
    margin-bottom: 1.5rem;
  }
  .rejilla {
    list-style: none;
    display: grid;
    gap: 1.5rem;
  }
  .tarjeta {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radio-l);
    border: 1px solid var(--linea);
    background: var(--superficie);
    text-decoration: none;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .tarjeta:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra-l);
  }
  .tarjeta img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .tarjeta__texto {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    padding: 1.5rem;
  }
  .tarjeta h3 {
    font-size: var(--t-l);
  }
  .tarjeta__texto > p:not(.meta) {
    color: var(--tinta-2);
    font-size: var(--t-s);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 700px) {
    .rejilla {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .rejilla {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
