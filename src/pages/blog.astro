  <script>
    // El sitio es estático: la fecha y la temperatura se pintan en el navegador
    // para que sean reales en cada visita, sin necesidad de redesplegar.
    (function () {
      const dateEl = document.getElementById('np-today');
      if (dateEl) {
        dateEl.textContent = new Date().toLocaleDateString('es-ES', {
          weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
        });
      }

      // Temperatura real de Almería — Open-Meteo (gratis, sin API key, CORS abierto).
      const LAT = 36.84, LON = -2.46;
      const airEl = document.getElementById('np-air-temp');
      const seaEl = document.getElementById('np-sea-temp');

      const cond = (c: number) => {
        if (c === 0) return 'Sol';
        if (c <= 3) return 'Nubes';
        if (c === 45 || c === 48) return 'Niebla';
        if (c >= 51 && c <= 67) return 'Lluvia';
        if (c >= 71 && c <= 77) return 'Nieve';
        if (c >= 80 && c <= 82) return 'Chubascos';
        if (c >= 95) return 'Tormenta';
        return 'Sol';
      };

      if (airEl) {
        fetch(`https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current=temperature_2m,weather_code&timezone=Europe%2FMadrid`)
          .then((r) => (r.ok ? r.json() : Promise.reject()))
          .then((j) => {
            const t = j && j.current && j.current.temperature_2m;
            const w = j && j.current && j.current.weather_code;
            if (typeof t === 'number') airEl.textContent = `${Math.round(t)}°C · ${cond(w)}`;
          })
          .catch(() => {});
      }

      if (seaEl) {
        fetch(`https://marine-api.open-meteo.com/v1/marine?latitude=${LAT}&longitude=${LON}&current=sea_surface_temperature&timezone=Europe%2FMadrid`)
          .then((r) => (r.ok ? r.json() : Promise.reject()))
          .then((j) => {
            const t = j && j.current && j.current.sea_surface_temperature;
            if (typeof t === 'number') seaEl.textContent = `Mar ${Math.round(t)}°C`;
          })
          .catch(() => {});
      }
    })();
  </script>
