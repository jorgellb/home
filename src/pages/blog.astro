---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

/* Versiones ligeras de la imagen destacada (npm run optimizar:imagenes, 800 px):
   las mismas que usa el artículo. Devuelve [tipo, ruta] de las que existen. */
function ligeras(imagen?: string): [string, string][] {
  if (!imagen?.startsWith('/')) return [];
  const base = imagen.replace(/\.(jpe?g|png)$/i, '-800');
  return (['avif', 'webp'] as const)
    .filter((f) => existsSync(join(process.cwd(), 'public', `${base}.${f}`)))
    .map((f) => [`image/${f}`, `${base}.${f}`]);
}

type Post = CollectionEntry<'posts'>;

const allPosts = await getCollection('posts', ({ data }: Post) => !data.draft);
const posts = allPosts.sort((a: Post, b: Post) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: '2-digit' }).toUpperCase();
}
function formatDateShort(date: Date): string {
  return date.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit' });
}
function calculateReadingTime(content: string): number {
  return Math.max(1, Math.ceil((content || '').split(/\s+/).length / 200));
}

const [featured, ...rest] = posts;

// Datos del periódico
const today = new Date();
const issueNumber = String(100 + posts.length).padStart(3, '0');
const volume = today.getFullYear() - 2017;
const dateLong = today.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const weatherTemp = 22 + Math.floor((today.getMonth() < 5 || today.getMonth() > 9) ? -4 : 6);
const seaTemp = 18 + Math.floor((today.getMonth() < 5 || today.getMonth() > 9) ? -2 : 5);

// Secciones del índice (mock)
const indexSections = [
  { id: 'portada',  name: 'Portada',     page: '01' },
  { id: 'tech',     name: 'Tecnología',  page: '02' },
  { id: 'opinion',  name: 'Opinión',     page: '05' },
  { id: 'mercado',  name: 'Mercado',     page: '08' },
  { id: 'almeria',  name: 'Almería',     page: '11' },
  { id: 'colofon',  name: 'Colofón',     page: 'XX' },
];

// Stock ticker mock
const tickers = [
  { sym: 'WEB',  val: '127.45', d: '+2.3%',  up: true  },
  { sym: 'SEO',  val: '89.12',  d: '+1.1%',  up: true  },
  { sym: 'CMS',  val: '54.80',  d: '-0.4%',  up: false },
  { sym: 'CWV',  val: '99.97',  d: '+0.05%', up: true  },
  { sym: 'JS',   val: '21.7K',  d: '+5.2%',  up: true  },
  { sym: 'WP',   val: '6.8.1',  d: 'STABLE', up: true  },
];

// Categorías observed
const allCategories = Array.from(new Set(posts.flatMap((p: Post) => p.data.categories || []))).slice(0, 8);
---

<BaseLayout
  title="Blog de Diseño Web, SEO y Tecnología"
  description="Periódico digital con artículos sobre tecnología, VERIFACTU, marketing digital y consejos para empresas y autónomos en Almería."
  canonical="https://platanitorico.com/blog/"
  image="/imagenes/equipo-marketing-web.jpg"
  imageAlt="Blog de tecnología y marketing digital"
  type="website"
  keywords="blog tecnología, VERIFACTU, marketing digital, blog almería, diario digital"
  jsonLd={[
    { "@context": "https://schema.org", "@type": "Blog", "name": "Blog Platanito Rico", "url": "https://platanitorico.com/blog/", "inLanguage": "es" },
    { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog",  "item": "https://platanitorico.com/blog/" }
    ]}
  ]}
>
  <Header />

  <Breadcrumb tono="consola" items={[{ label: 'Inicio', href: '/' }, { label: 'Blog' }]} />

  <main id="main-content" class="np">

    {/* ════════════════════════════════════════════════ */}
    {/* NAMEPLATE — Cabecera principal del periódico     */}
    {/* ════════════════════════════════════════════════ */}
    <section class="np-nameplate">
      <div class="container-brutal">

        {/* Top bar antes del nombre */}
        <header class="np-top">
          <div class="np-top__l">
            <span class="np-top__est">Est. MMXVIII</span>
            <span class="np-top__sep">·</span>
            <span>Vol. {volume}</span>
            <span class="np-top__sep">·</span>
            <span>N.º {issueNumber}</span>
          </div>
          <div class="np-top__c">
            <span class="np-top__free">★ EDICIÓN GRATUITA ★</span>
          </div>
          <div class="np-top__r">
            <span>{posts.length} crónicas publicadas</span>
            <span class="np-top__sep">·</span>
            <span>Precio: 0,00 €</span>
          </div>
        </header>

        {/* NOMBRE GIGANTE */}
        <div class="np-masthead">
          {/* Adorno izquierda */}
          <div class="np-masthead__ornament np-masthead__ornament--l" aria-hidden="true">
            <svg viewBox="0 0 80 100" width="100%" height="100%">
              <circle cx="40" cy="50" r="32" fill="none" stroke="currentColor" stroke-width="2"/>
              <circle cx="40" cy="50" r="22" fill="none" stroke="currentColor" stroke-width="1"/>
              <path d="M40 22 L44 42 L64 50 L44 58 L40 78 L36 58 L16 50 L36 42 Z" fill="currentColor"/>
              <text x="40" y="54" text-anchor="middle" font-family="serif" font-size="10" font-weight="bold" fill="#FAF5E6">P★R</text>
            </svg>
          </div>

          {/* Nombre */}
          <div class="np-masthead__title">
            <span class="np-masthead__pre">★  EL  ★</span>
            <h1 class="np-masthead__name">
              <span class="np-masthead__line1">PLATANITO</span>
              <span class="np-masthead__line2">POST</span>
            </h1>
            <span class="np-masthead__sub">— EDICIÓN DIGITAL · ALMERÍA · ESPAÑA —</span>
          </div>

          {/* Adorno derecha */}
          <div class="np-masthead__ornament np-masthead__ornament--r" aria-hidden="true">
            <svg viewBox="0 0 80 100" width="100%" height="100%">
              <rect x="14" y="14" width="52" height="72" fill="none" stroke="currentColor" stroke-width="2"/>
              <rect x="22" y="22" width="36" height="56" fill="none" stroke="currentColor" stroke-width="1"/>
              <line x1="14" y1="34" x2="66" y2="34" stroke="currentColor" stroke-width="1"/>
              <line x1="14" y1="66" x2="66" y2="66" stroke="currentColor" stroke-width="1"/>
              <text x="40" y="56" text-anchor="middle" font-family="serif" font-size="11" font-weight="bold" fill="currentColor">PR</text>
              <text x="40" y="78" text-anchor="middle" font-family="monospace" font-size="6" fill="currentColor">2026</text>
            </svg>
          </div>
        </div>

        {/* Banda de información: fecha + clima + lema */}
        <div class="np-strip">
          <div class="np-strip__item">
            <span class="np-strip__lbl">FECHA</span>
            <span class="np-strip__val" id="np-today">{dateLong}</span>
          </div>

          <div class="np-strip__divider"></div>

          <div class="np-strip__item np-strip__item--motto">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <circle cx="12" cy="12" r="5" fill="currentColor"/>
              {Array.from({length: 8}).map((_, i) => (
                <line x1="12" y1="2" x2="12" y2="5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" transform={`rotate(${i*45} 12 12)`}/>
              ))}
            </svg>
            <span>«Toda la verdad sobre la web — sin filtros, sin spam»</span>
          </div>

          <div class="np-strip__divider"></div>

          <div class="np-strip__item np-strip__item--weather">
            <span class="np-strip__lbl">ALMERÍA</span>
            <svg viewBox="0 0 32 32" width="20" height="20" aria-hidden="true">
              <circle cx="16" cy="16" r="6" fill="#FFD600" stroke="currentColor" stroke-width="1.5"/>
              {Array.from({length: 12}).map((_, i) => (
                <line x1="16" y1="3" x2="16" y2="6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" transform={`rotate(${i*30} 16 16)`}/>
              ))}
            </svg>
            <span class="np-strip__val" id="np-air-temp">{weatherTemp}°C · Sol</span>
            <span class="np-strip__sub" id="np-sea-temp">Mar {seaTemp}°C</span>
          </div>
        </div>

        {/* ÍNDICE / SUMARIO */}
        <nav class="np-index" aria-label="Índice del periódico">
          <span class="np-index__lbl">★ ÍNDICE ★</span>
          {indexSections.map((s) => (
            <a href={`#${s.id}`} class="np-index__item">
              <span class="np-index__name">{s.name}</span>
              <span class="np-index__dots" aria-hidden="true"></span>
              <span class="np-index__page">{s.page}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    {/* ════════════════════════════════════════════════ */}
    {/* STOCK TICKER MARQUEE                              */}
    {/* ════════════════════════════════════════════════ */}
    <section class="np-ticker">
      <div class="np-ticker__lbl">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path d="M3 17l6-6 4 4 8-8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15 7h6v6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>MERCADO · TECH</span>
      </div>
      <div class="np-ticker__track">
        {Array.from({length: 3}).map(() => (
          tickers.map((t) => (
            <span class={`np-ticker__item ${t.up ? 'np-ticker__item--up' : 'np-ticker__item--down'}`}>
              <span class="np-ticker__sym">{t.sym}</span>
              <span class="np-ticker__val">{t.val}</span>
              <span class="np-ticker__d">{t.up ? '▲' : '▼'} {t.d}</span>
            </span>
          ))
        ))}
      </div>
    </section>

    {posts.length === 0 ? (
      <section class="np-empty-section">
        <div class="container-brutal np-empty">
          <span class="text-meta">∅ Sin crónicas todavía</span>
          <h2 class="np-empty__title heading-display">La rotativa <em>está caliente.</em></h2>
          <p class="np-empty__text">Próxima edición a punto de salir. Mientras tanto, escríbenos.</p>
          <a href="/contacto/" class="np-btn">Hablemos →</a>
        </div>
      </section>
    ) : (
      <>
        {/* ═══════════════════════════════════════════ */}
        {/* PORTADA — ABOVE THE FOLD                    */}
        {/* ═══════════════════════════════════════════ */}
        {featured && (
          <section class="np-portada" id="portada">
            <div class="container-brutal">

              {/* Cabecera de sección */}
              <header class="np-section-head">
                <div class="np-section-head__l">
                  <span class="np-section-head__num">— 01 —</span>
                  <h2 class="np-section-head__name">EN PORTADA</h2>
                </div>
                <div class="np-section-head__line"></div>
                <span class="np-section-head__date">{formatDateShort(featured.data.publishedAt)} · ALMERÍA</span>
              </header>

              <a href={`/blog/${featured.data.slug}/`} class="np-portada__link">

                {/* Kicker arriba */}
                <div class="np-portada__kicker">
                  <span class="np-portada__kicker-tag">★ CRÓNICA DESTACADA ★</span>
                  <span class="np-portada__kicker-bar"></span>
                  <span class="np-portada__kicker-date">{formatDate(featured.data.publishedAt)}</span>
                  <span class="np-portada__kicker-bar"></span>
                  <span class="np-portada__kicker-rt">{featured.data.readingTime || calculateReadingTime(featured.body || '')} MIN DE LECTURA</span>
                </div>

                {/* Headline gigante */}
                <h2 class="np-portada__title">{featured.data.title}</h2>

                {/* Byline */}
                <div class="np-portada__byline">
                  <span class="np-portada__byline-by">POR</span>
                  <strong>EL EQUIPO</strong>
                  <span class="np-portada__byline-loc">— DESDE EL ESTUDIO · VERA, ALMERÍA</span>
                </div>

                {/* Grid imagen + standfirst */}
                <div class="np-portada__grid">
                  {/* Imagen / placeholder con halftone */}
                  <figure class="np-portada__figure">
                    {featured.data.featuredImage ? (
                      <picture>{ligeras(featured.data.featuredImage).map(([tipo, src]) => <source type={tipo} srcset={src} />)}<img src={featured.data.featuredImage} alt={featured.data.featuredImageAlt || featured.data.title} loading="eager" decoding="async" class="np-portada__img"/></picture>
                    ) : (
                      <div class="np-portada__placeholder" aria-hidden="true">
                        <svg viewBox="0 0 400 280" width="100%" height="100%">
                          <defs>
                            <pattern id="np-halftone-big" width="6" height="6" patternUnits="userSpaceOnUse">
                              <circle cx="3" cy="3" r="1.5" fill="#1a1614"/>
                            </pattern>
                            <radialGradient id="np-halftone-fade" cx="50%" cy="50%" r="70%">
                              <stop offset="0%"  stop-color="#1a1614" stop-opacity="0"/>
                              <stop offset="60%" stop-color="#1a1614" stop-opacity="0.6"/>
                              <stop offset="100%" stop-color="#1a1614" stop-opacity="1"/>
                            </radialGradient>
                          </defs>
                          <rect width="400" height="280" fill="#FAF5E6"/>
                          <rect width="400" height="280" fill="url(#np-halftone-big)"/>
                          <rect width="400" height="280" fill="url(#np-halftone-fade)" opacity="0.7"/>
                          {/* Old print press illustration */}
                          <g transform="translate(100, 60)" stroke="#FAF5E6" stroke-width="3" fill="none">
                            <rect x="0" y="40" width="200" height="100" fill="#1a1614"/>
                            <rect x="20" y="60" width="160" height="60" fill="#FAF5E6" stroke="#1a1614"/>
                            <line x1="40" y1="75" x2="160" y2="75" stroke="#1a1614" stroke-width="2"/>
                            <line x1="40" y1="85" x2="140" y2="85" stroke="#1a1614" stroke-width="1.5"/>
                            <line x1="40" y1="95" x2="150" y2="95" stroke="#1a1614" stroke-width="1.5"/>
                            <line x1="40" y1="105" x2="120" y2="105" stroke="#1a1614" stroke-width="1.5"/>
                            <circle cx="100" cy="20" r="14" fill="#B81B1B"/>
                            <circle cx="100" cy="20" r="8" fill="#FAF5E6"/>
                            <line x1="100" y1="34" x2="100" y2="40" stroke="#1a1614" stroke-width="3"/>
                            <rect x="-10" y="140" width="220" height="14" fill="#1a1614"/>
                            <circle cx="20" cy="160" r="6" fill="#1a1614"/>
                            <circle cx="180" cy="160" r="6" fill="#1a1614"/>
                          </g>
                          <text x="200" y="240" text-anchor="middle" font-family="monospace" font-size="9" font-weight="bold" fill="#FAF5E6" letter-spacing="3">FOTOGRAFÍA: ARCHIVO</text>
                        </svg>
                      </div>
                    )}
                    {featured.data.categories && featured.data.categories[0] && (
                      <figcaption class="np-portada__caption">
                        FIG. 01 — Sección {featured.data.categories[0]}
                      </figcaption>
                    )}
                  </figure>

                  {/* Standfirst con drop cap */}
                  <div class="np-portada__copy">
                    {featured.data.excerpt && (
                      <p class="np-portada__lead">
                        <span class="np-portada__dropcap">{featured.data.excerpt[0]}</span>{featured.data.excerpt.slice(1)}
                      </p>
                    )}

                    <ul class="np-portada__points">
                      <li><span>★</span>Análisis completo</li>
                      <li><span>★</span>Casos reales</li>
                      <li><span>★</span>Cómo aplicarlo a tu negocio</li>
                    </ul>

                    <span class="np-portada__cta">
                      Continuar leyendo en interior
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            </div>
          </section>
        )}

        {/* ═══════════════════════════════════════════ */}
        {/* FLEURON DIVIDER                              */}
        {/* ═══════════════════════════════════════════ */}
        <div class="np-fleuron" aria-hidden="true">
          <span class="np-fleuron__line"></span>
          <svg viewBox="0 0 120 40" width="120" height="40">
            <g fill="currentColor">
              <circle cx="20" cy="20" r="3"/>
              <circle cx="100" cy="20" r="3"/>
              <path d="M40 20 Q50 10 60 20 Q70 30 80 20 Q70 10 60 20 Q50 30 40 20 Z"/>
              <line x1="30" y1="20" x2="40" y2="20" stroke="currentColor" stroke-width="1"/>
              <line x1="80" y1="20" x2="90" y2="20" stroke="currentColor" stroke-width="1"/>
            </g>
          </svg>
          <span class="np-fleuron__line"></span>
        </div>

        {/* ═══════════════════════════════════════════ */}
        {/* MÁS CRÓNICAS — Grid multicolumna             */}
        {/* ═══════════════════════════════════════════ */}
        <section class="np-articles" id="tech">
          <div class="container-brutal">
            <header class="np-section-head">
              <div class="np-section-head__l">
                <span class="np-section-head__num">— 02 —</span>
                <h2 class="np-section-head__name">ÚLTIMAS CRÓNICAS</h2>
              </div>
              <div class="np-section-head__line"></div>
              <span class="np-section-head__date">{rest.length} ARTÍCULOS · ACTUALIZADO HOY</span>
            </header>

            {/* Filtros categoría como newspaper section tabs */}
            {allCategories.length > 0 && (
              <div class="np-cats">
                <span class="np-cats__lbl">SECCIONES:</span>
                {allCategories.map((c) => <span class="np-cats__tag">{c}</span>)}
              </div>
            )}

            <ol class="np-grid">
              {rest.map((post: Post, i: number) => {
                const rt = post.data.readingTime || calculateReadingTime(post.body || '');
                const sizeClass = i === 0 ? 'np-art--big' : (i % 5 === 4 ? 'np-art--wide' : 'np-art--normal');
                return (
                  <li class={`np-art ${sizeClass}`}>
                    <a href={`/blog/${post.data.slug}/`} class="np-art__link">

                      {/* Cabecera tipo periódico */}
                      <header class="np-art__head">
                        <span class="np-art__num">N.º {String(i + 2).padStart(3, '0')}</span>
                        <span class="np-art__dot">·</span>
                        <span class="np-art__date">{formatDateShort(post.data.publishedAt)}</span>
                        <span class="np-art__dot">·</span>
                        <span class="np-art__rt">{rt} MIN</span>
                      </header>

                      {/* Imagen / placeholder */}
                      <figure class="np-art__figure">
                        {post.data.featuredImage ? (
                          <picture>{ligeras(post.data.featuredImage).map(([tipo, src]) => <source type={tipo} srcset={src} />)}<img src={post.data.featuredImage} alt={post.data.featuredImageAlt || post.data.title} loading="lazy" decoding="async"/></picture>
                        ) : (
                          <div class="np-art__placeholder" aria-hidden="true">
                            <svg viewBox="0 0 200 130" width="100%" height="100%">
                              <defs>
                                <pattern id={`np-ht-${i}`} width="5" height="5" patternUnits="userSpaceOnUse">
                                  <circle cx="2.5" cy="2.5" r={1 + (i % 3) * 0.3} fill="#1a1614"/>
                                </pattern>
                              </defs>
                              <rect width="200" height="130" fill="#F5EEDE"/>
                              <rect width="200" height="130" fill={`url(#np-ht-${i})`} opacity="0.55"/>
                              {/* Decoration variations per index */}
                              {i % 4 === 0 && (
                                <g stroke="#1a1614" stroke-width="2" fill="none">
                                  <rect x="60" y="40" width="80" height="50" fill="#FAF5E6"/>
                                  <line x1="70" y1="55" x2="130" y2="55"/>
                                  <line x1="70" y1="65" x2="120" y2="65"/>
                                  <line x1="70" y1="75" x2="125" y2="75"/>
                                  <circle cx="100" cy="25" r="8" fill="#B81B1B"/>
                                </g>
                              )}
                              {i % 4 === 1 && (
                                <g stroke="#1a1614" stroke-width="2" fill="none">
                                  <circle cx="100" cy="65" r="30" fill="#FAF5E6"/>
                                  <circle cx="100" cy="65" r="20" fill="none"/>
                                  <circle cx="100" cy="65" r="10" fill="#1a1614"/>
                                  {Array.from({length: 8}).map((_, j) => (
                                    <line x1="100" y1="20" x2="100" y2="35" stroke-width="2" transform={`rotate(${j*45} 100 65)`}/>
                                  ))}
                                </g>
                              )}
                              {i % 4 === 2 && (
                                <g stroke="#1a1614" stroke-width="2" fill="none">
                                  <path d="M 40 90 L 70 50 L 100 75 L 130 35 L 160 60" stroke-linecap="round"/>
                                  <circle cx="40" cy="90" r="3" fill="#1a1614"/>
                                  <circle cx="70" cy="50" r="3" fill="#1a1614"/>
                                  <circle cx="100" cy="75" r="3" fill="#1a1614"/>
                                  <circle cx="130" cy="35" r="3" fill="#B81B1B"/>
                                  <circle cx="160" cy="60" r="3" fill="#1a1614"/>
                                  <line x1="20" y1="105" x2="180" y2="105"/>
                                </g>
                              )}
                              {i % 4 === 3 && (
                                <g stroke="#1a1614" stroke-width="2" fill="none">
                                  <rect x="50" y="30" width="100" height="70" fill="#FAF5E6"/>
                                  <text x="100" y="55" text-anchor="middle" font-family="serif" font-size="22" font-weight="bold" fill="#1a1614">★</text>
                                  <line x1="60" y1="68" x2="140" y2="68" stroke-width="1"/>
                                  <line x1="60" y1="78" x2="140" y2="78" stroke-width="1"/>
                                  <line x1="60" y1="88" x2="120" y2="88" stroke-width="1"/>
                                </g>
                              )}
                            </svg>
                          </div>
                        )}
                      </figure>

                      {/* Tag sección */}
                      {post.data.categories && post.data.categories[0] && (
