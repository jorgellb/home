---
/* Plan 360 (centro de mando, spec §6.4): abre con una consola cuyo centro es
   el registro simulado del panel del cliente (siempre etiquetado «demo»),
   la comparativa va en paneles y las condiciones de salida quedan a la
   vista. */
import LecturaLayout from '../layouts/LecturaLayout.astro';
import Boton from '../components/cdm/Boton.astro';
import Fichas from '../components/cdm/Fichas.astro';
import ListaEnlaces from '../components/cdm/ListaEnlaces.astro';
import Panel from '../components/cdm/Panel.astro';
import Preguntas from '../components/cdm/Preguntas.astro';
import RadarCobertura from '../components/cdm/RadarCobertura.astro';
import RegistroDemo from '../components/cdm/RegistroDemo.astro';
import SeccionLectura from '../components/cdm/SeccionLectura.astro';
import ServiciosIT from '../components/cdm/ServiciosIT.astro';
import Contact from '../components/sections/Contact.astro';
import type { Cifra, SeccionIndice } from '../components/cdm/tipos';
import { plan360, pueblosIT, registroPlan360, HUB_IT } from '../data/servicios-it';
import { SITE, PROVEEDOR } from '../data/negocio';

const canonical = `${SITE}${plan360.href}`;
const contactoHref = '/contacto/?servicio=plan-360#contacto';

const datos: Cifra[] = [
  { etiqueta: 'Al mes, + IVA', valor: plan360.precio, sufijo: ' €' },
  { etiqueta: 'Puestos incluidos', valor: plan360.puestos },
  { etiqueta: 'Puesto adicional al mes', valor: plan360.precioPuestoExtra, sufijo: ' €' },
  { etiqueta: 'Meses de permanencia', valor: 0 },
];

const secciones: SeccionIndice[] = [
  { id: 'incluye', etiqueta: 'Qué incluye' },
  { id: 'precio', etiqueta: 'Cuentas claras' },
  { id: 'condiciones', etiqueta: 'Condiciones' },
  { id: 'servicios', etiqueta: 'Servicios' },
  { id: 'cobertura', etiqueta: 'Cobertura' },
  { id: 'faq', etiqueta: 'Preguntas' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'Plan 360: web y mantenimiento informático',
    'serviceType': 'Mantenimiento informático y web para empresas',
    'description': plan360.description,
    'url': canonical,
    'provider': PROVEEDOR,
    'areaServed': [
      ...pueblosIT.map((p) => ({ '@type': 'City', 'name': p.nombre })),
      { '@type': 'AdministrativeArea', 'name': 'Provincia de Almería' },
    ],
    'offers': {
      '@type': 'Offer',
      'url': canonical,
      'price': String(plan360.precio),
      'priceCurrency': 'EUR',
      'availability': 'https://schema.org/InStock',
      'priceSpecification': {
        '@type': 'UnitPriceSpecification',
        'price': String(plan360.precio),
        'priceCurrency': 'EUR',
        'unitCode': 'MON',
        'unitText': 'mes',
        'valueAddedTaxIncluded': false,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': plan360.faq.map((f) => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
  },
];
---

<LecturaLayout
  title={plan360.title}
  description={plan360.description}
  canonical={canonical}
  jsonLd={jsonLd}
  migas={[{ label: 'Inicio', href: '/' }, { label: 'Plan 360' }]}
  h1={plan360.h1.replace(/(\d) €/g, '$1\u00a0€')}
  subtitulo={plan360.h2}
  entradilla={`Tu web, hasta ${plan360.puestos} puestos, servidor, red, copias y ciberseguridad, con visita in situ el mismo día en el Levante y el Almanzora.`}
  datos={datos}
  secciones={secciones}
  coordenadas="Plan 360 · base en Vera"
>
  <Fragment slot="acciones">
    <Boton href={contactoHref}>Quiero el Plan 360</Boton>
    <Boton href="#incluye" variante="linea">Ver qué incluye</Boton>
  </Fragment>

  <RegistroDemo slot="lateral" lineas={registroPlan360} retardo={0.5} />

  <SeccionLectura
    id="incluye"
    titulo="Qué incluye el Plan 360"
    lead={`Todo lo que necesita una pyme de hasta ${plan360.puestos} puestos para que su tecnología funcione, por una cuota fija.`}
  >
    <Fichas columnas={3} items={plan360.incluye.map((b) => ({ titulo: b.t, texto: b.d }))} />
  </SeccionLectura>

  <SeccionLectura id="precio" titulo="Cuánto cuesta tener la tecnología de tu empresa cubierta">
    <div class="p360-comp">
      {plan360.comparativa.map((c) => (
        <Panel titulo={c.concepto} class={c.destacado ? 'p360-comp__panel is-destacado' : 'p360-comp__panel'}>
          <p class="p360-comp__coste">{c.coste}</p>
          <p class="p360-comp__nota">{c.nota}</p>
        </Panel>
      ))}
    </div>
  </SeccionLectura>

  <SeccionLectura id="condiciones" titulo="Sin permanencia y sin cuota de alta">
    <div class="p360-cond">
      <div>
        <p class="p360-texto">{plan360.salida}</p>
        <p class="p360-texto">
          ¿Más de {plan360.puestos} puestos? Cada puesto adicional cuesta {plan360.precioPuestoExtra} € + IVA al mes.
        </p>
        <div class="p360-botones">
          <Boton href={contactoHref}>Pedir el Plan 360</Boton>
        </div>
      </div>
      <Panel titulo="No incluido en la cuota" class="p360-noincluye">
        <ul>
          {plan360.noIncluye.map((x) => <li>{x}</li>)}
        </ul>
      </Panel>
    </div>
  </SeccionLectura>

  <SeccionLectura id="servicios" titulo="Servicios informáticos que cubre el plan">
    <ServiciosIT />
  </SeccionLectura>

  <SeccionLectura
    id="cobertura"
    titulo="Visita el mismo día en el Levante y el Almanzora"
    lead="En el resto de la provincia de Almería el Plan 360 funciona con soporte remoto y visitas programadas."
  >
    <div class="p360-radar"><RadarCobertura /></div>
    <ListaEnlaces columnas={3} items={pueblosIT.map((p) => ({ href: `${HUB_IT}${p.slug}/`, label: `Informático en ${p.nombre}`, sub: p.comarca }))} />
  </SeccionLectura>

  <SeccionLectura id="faq" titulo="Preguntas frecuentes sobre el Plan 360">
    <Preguntas items={plan360.faq} />
  </SeccionLectura>

  <Fragment slot="cierre">
    <Contact tono="consola" />
  </Fragment>
</LecturaLayout>

<style>
  .p360-texto { max-width: 62ch; margin: 1.1rem 0 0; font-size: 1.06rem; line-height: 1.65; color: #b9c5cf; }
  .p360-botones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }

  .p360-comp { display: grid; gap: 1rem; margin-top: 1.75rem; }
  @media (min-width: 900px) { .p360-comp { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* Las clases van en la raíz de Panel (cid del Panel): :global en ellas. */
  :global(.p360-comp__panel.is-destacado) { border-color: var(--color-cdm-ok); }
  .p360-comp__coste {
    margin: 0;
    padding: 1rem 1rem 0;
    font-family: var(--font-display);
    font-stretch: 82%;
    font-weight: 740;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-cdm-texto);
  }
  :global(.p360-comp__panel.is-destacado) .p360-comp__coste { color: var(--color-cdm-ok); }
  .p360-comp__nota { margin: 0; padding: 0.7rem 1rem 1.1rem; font-size: 0.95rem; line-height: 1.55; color: #b9c5cf; }

  .p360-cond { display: grid; gap: 2rem; }
  @media (min-width: 1024px) { .p360-cond { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 3rem; align-items: start; } }
  :global(.p360-noincluye) ul { margin: 0; padding: 0.9rem 1rem 1rem 2.1rem; display: grid; gap: 0.7rem; }
  :global(.p360-noincluye) li { font-size: 0.95rem; line-height: 1.5; color: var(--color-cdm-texto); }

  .p360-radar { max-width: 560px; margin-top: 1.75rem; }
</style>
