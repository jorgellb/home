<style>
  /* ═══════════════════════════════════════════════════════════
     IA PARA EMPRESAS — tono consola, capa de instrumento.
     El color significa quién hace qué: cian máquina, naranja
     persona, lima verificado, rojo trabajo manual o error.
     ═══════════════════════════════════════════════════════════ */
  .ia {
    --ia-suelo: var(--color-cdm-suelo);
    --ia-panel: var(--color-cdm-panel);
    --ia-panel-2: var(--color-cdm-panel-2);
    --ia-regla: var(--color-cdm-regla);
    --ia-regla-2: var(--color-cdm-regla-2);
    --ia-texto: var(--color-cdm-texto);
    --ia-tenue: var(--color-cdm-tenue);
    --ia-maquina: #18e0ff;
    --ia-persona: var(--color-cdm-senal);
    --ia-verificado: var(--color-cdm-ok);
    --ia-atencion: #ff6b6b;
    --ia-reticula: rgb(230 237 242 / 0.04);
    --ia-curva: cubic-bezier(0.2, 0.8, 0.2, 1);
    /* Utilitarios globales dentro, en oscuro. */
    --brutal-ink: var(--color-cdm-texto);
    --brutal-text: var(--color-cdm-texto);
    --brutal-text-secondary: #b9c5cf;
    --brutal-text-muted: var(--color-cdm-tenue);
    --brutal-accent-ink: var(--color-cdm-senal);
    --brutal-border-soft: var(--color-cdm-regla);
    background: var(--ia-suelo);
    color: var(--ia-texto);
    color-scheme: dark;
    position: relative;
  }
  /* El raíl solo aparece cuando hay margen libre de sobra: en pantallas más
     estrechas competiría con las bandas a sangre. */
  .ia :global(.ia-rail) { display: none; }
  @media (min-width: 1560px) {
    .ia :global(.ia-rail) {
      display: block;
      position: fixed;
      top: 7rem;
      left: 2rem;
      width: 180px;
      z-index: 5;
      color: var(--ia-tenue);
    }
  }

  /* ── Tipografía de sección ── */
  .ia-eyebrow, .ia-cap {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .18em;
    text-transform: uppercase;
