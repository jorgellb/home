---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import Boton from '../components/cdm/Boton.astro';
import Relacionados from '../components/cdm/Relacionados.astro';
import IndiceLateral from '../components/cdm/IndiceLateral.astro';
import Lamina from '../components/ia/Lamina.astro';
import FlujoEncargo from '../components/ia/FlujoEncargo.astro';
import MapaSistemas from '../components/ia/MapaSistemas.astro';
import CapaIntegracion from '../components/ia/CapaIntegracion.astro';
import ZonasEjecucion from '../components/ia/ZonasEjecucion.astro';
import SelectorDepartamento from '../components/ia/SelectorDepartamento.astro';
import NivelesControl from '../components/ia/NivelesControl.astro';
import CalculadoraROI from '../components/ia/CalculadoraROI.astro';
import VisorAR from '../components/ia/VisorAR.astro';
import { soluciones, sectores, metodo, servicios, faqIA } from '../data/ia-empresas';
import type { SeccionIndice } from '../components/cdm/tipos';

const title = 'IA para empresas: agentes y automatización | Platanito Rico';
const description =
  'Diseñamos agentes y automatizaciones de IA conectados con tu CRM, tu ERP y tus documentos para atender clientes, procesar papeles y preparar propuestas, con aprobación humana.';
const canonical = 'https://platanitorico.com/ia-empresas/';

const secciones: SeccionIndice[] = [
  { id: 'problema', etiqueta: 'El problema' },
  { id: 'departamentos', etiqueta: 'Por dónde empezar' },
  { id: 'soluciones', etiqueta: 'Qué construimos' },
  { id: 'anatomia', etiqueta: 'Cómo trabaja' },
  { id: 'integraciones', etiqueta: 'Integraciones' },
  { id: 'control', etiqueta: 'Control humano' },
  { id: 'seguridad', etiqueta: 'Seguridad' },
  { id: 'metodo', etiqueta: 'Metodología' },
  { id: 'sectores', etiqueta: 'Sectores' },
  { id: 'servicios', etiqueta: 'Servicios' },
  { id: 'roi', etiqueta: 'Diagnóstico' },
  { id: 'laboratorio', etiqueta: 'Pruébalo' },
  { id: 'faq', etiqueta: 'Preguntas' },
  { id: 'diagnostico', etiqueta: 'Empezar' },
];

const pasosHero = [
  { hora: '09:42', tipo: 'entrada' as const, titulo: 'Entra un correo con un PDF adjunto' },
  { hora: '09:42', tipo: 'agente' as const, titulo: 'El agente se pone a trabajar', detalles: ['identifica la empresa', 'consulta el CRM', 'recupera el histórico', 'aplica la tarifa vigente'] },
  { hora: '09:44', tipo: 'puerta' as const, titulo: 'Aprobación de una persona' },
  { hora: '09:51', tipo: 'salida' as const, titulo: 'Propuesta enviada · CRM actualizado' },
];

const pasosAnatomia = [
  { hora: '09:42', tipo: 'entrada' as const, titulo: 'Entrada', detalles: ['correo del cliente con solicitud y PDF'] },
  { hora: '09:42', tipo: 'agente' as const, titulo: 'Lectura', detalles: ['extrae referencias, cantidades y plazo'] },
  { hora: '09:43', tipo: 'agente' as const, titulo: 'Consulta', detalles: ['CRM: ficha y condiciones del cliente', 'ERP: stock y tarifa vigente'] },
  { hora: '09:43', tipo: 'agente' as const, titulo: 'Comprobación', detalles: ['el descuento supera el límite habitual'] },
  { hora: '09:44', tipo: 'puerta' as const, titulo: 'Aprobación' },
  { hora: '09:51', tipo: 'salida' as const, titulo: 'Respuesta y registro', detalles: ['responde al cliente con la propuesta', 'registra la oportunidad y el seguimiento'] },
];

const controles = [
  ['Permisos', 'El sistema accede solo a lo que su tarea necesita, con credenciales propias y revocables.'],
  ['Registro', 'Queda anotado qué se consultó, qué se generó y quién aprobó.'],
  ['Trazabilidad', 'Cada respuesta puede señalar de qué documento o campo salió.'],
  ['Retención', 'Se decide qué se guarda, dónde y durante cuánto tiempo.'],
  ['Evaluación', 'Antes de producción se prueba contra casos reales tuyos y se mide el acierto.'],
  ['Errores', 'Qué pasa cuando falla, a quién avisa y cómo se revierte.'],
  ['Marco legal', 'RGPD y AI Act como criterios de diseño desde la primera reunión.'],
  ['Salida', 'Tus datos y tu documentación son tuyos y te los llevas.'],
];

const demos = [
  { t: 'Probador virtual AR', d: 'Pruébate gafas o gorras desde la cámara del móvil, sin instalar nada. Lo mismo que puede ir en la ficha de tu tienda.', href: '/probador-virtual-ar/', destacada: true },
  { t: 'De una foto a una ficha que vende', d: 'Sube la foto de un producto y mira cómo sale la ficha completa: descripción, atributos, SEO y traducciones.', href: '/soluciones/ecommerce/#commerce-ai' },
  { t: 'Un asistente que atiende por ti', d: 'Pregúntale por servicios, precios o plazos como lo haría un cliente tuyo.', href: '/asistente-ia/' },
  { t: 'Habla con la IA', d: 'Habla por el micrófono y te responde con voz. Es la base de un agente que coge el teléfono.', href: '/asistente-voz/' },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Sistemas de IA generativa para empresas', serviceType: 'Inteligencia artificial aplicada a procesos de empresa', provider: { '@type': 'ProfessionalService', name: 'Platanito Rico', url: 'https://platanitorico.com', telephone: '+34657085019', address: { '@type': 'PostalAddress', addressLocality: 'Vera', addressRegion: 'Almería', addressCountry: 'ES' } }, areaServed: { '@type': 'AdministrativeArea', name: 'Almería' }, url: canonical, description },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqIA.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<BaseLayout title={title} description={description} canonical={canonical} type="website" lang="es" keywords="ia para empresas, agentes de ia, automatización de procesos, inteligencia artificial almería, procesamiento de documentos, asistente ia empresa" jsonLd={jsonLd}>
  <Header />
  <Breadcrumb tono="consola" items={[{ label: 'Inicio', href: '/' }, { label: 'IA para empresas' }]} />

  <main id="main-content" class="ia">
    <IndiceLateral secciones={secciones} coordenadas="Vera · Almería · sistemas en producción" class="ia-rail" />

    <!-- 01 · HERO -->
    <section class="ia-hero">
      <div class="container-brutal ia-hero__rejilla">
        <div class="ia-hero__texto">
          <span class="ia-eyebrow">IA generativa para empresas</span>
          <h1 class="ia-h1">IA que trabaja <em>dentro</em> de tu empresa.</h1>
          <p class="ia-lead">
            Diseñamos agentes y automatizaciones conectados con tus datos y tus herramientas para
            atender clientes, procesar documentos, preparar propuestas y ejecutar trabajo real.
            <strong>Una persona sigue aprobando lo que importa.</strong>
          </p>
          <div class="ia-hero__cta">
            <Boton href="#diagnostico">Analizar mis procesos</Boton>
            <Boton href="#soluciones" variante="linea">Ver soluciones</Boton>
          </div>
          <p class="ia-hero__micro">
            Cuéntanos un proceso repetitivo. Te diremos qué parte puede automatizarse y cuál
            debería seguir en manos de una persona.
          </p>
        </div>
        <Lamina
          referencia="LÁM. 01"
          titulo="Flujo de un encargo"
          chip="ejemplo"
          descripcion="Un correo con un PDF entra a las 09:42; el agente identifica la empresa, consulta el CRM, recupera el histórico y aplica la tarifa; a las 09:44 espera la aprobación de una persona; a las 09:51 la propuesta sale enviada y el CRM queda actualizado."
          leyenda={[{ color: 'maquina', texto: 'máquina' }, { color: 'persona', texto: 'persona' }, { color: 'verificado', texto: 'completado' }]}
          class="ia-hero__lamina"
        >
          <FlujoEncargo pasos={pasosHero} id="flujo-hero" arranque={true} />
        </Lamina>
      </div>
    </section>

    <!-- 02 · PROBLEMA -->
    <section class="ia-seccion" id="problema">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 01 / Dónde se va el tiempo</span>
          <h2 class="ia-h2">Tus datos ya existen. El problema es el trabajo que hay <em>entre ellos</em>.</h2>
          <p class="ia-parrafo">
            El pedido llega por correo, el precio está en el ERP, el histórico en el CRM, el contrato
            en Drive y la conversación en WhatsApp. Ninguna de esas herramientas habla con la
            siguiente, así que alguien de tu equipo hace de puente: copia, pega, reenvía y recuerda.
            Ese puente es el trabajo que se puede automatizar.
          </p>
        </header>
        <Lamina
          referencia="LÁM. 02"
          titulo="Herramientas sin capa que las una"
          descripcion="Seis herramientas habituales —correo, ERP, CRM, WhatsApp, PDF y Drive— sin conexión entre ellas: el trabajo manual de copiar, pegar, reenviar y recordar lo hace una persona del equipo."
          leyenda={[{ color: 'atencion', texto: 'trabajo manual' }, { color: 'regla', texto: 'sistemas' }]}
        >
          <MapaSistemas />
        </Lamina>
        <ul class="ia-apuntes">
          <li><strong>No es un problema de software.</strong> Cada herramienta hace bien su trabajo; lo que falta es quien las coordine.</li>
          <li><strong>No se arregla con un chat.</strong> Un asistente que no puede consultar ni escribir en tus sistemas solo te da texto.</li>
          <li><strong>Se arregla con una capa que ejecuta.</strong> Recibe, consulta, decide, prepara y actúa; y se para donde tú digas.</li>
        </ul>
      </div>
    </section>

    <!-- 03 · DEPARTAMENTOS -->
    <section class="ia-seccion ia-seccion--panel" id="departamentos">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 02 / Por dónde empezar</span>
          <h2 class="ia-h2">¿Dónde te está costando más tiempo?</h2>
          <p class="ia-parrafo">
            Elige un área y verás los procesos que solemos automatizar primero, porque se repiten
            mucho y se miden fácil.
          </p>
        </header>
        <SelectorDepartamento />
      </div>
    </section>

    <!-- 04 · SOLUCIONES -->
    <section class="ia-seccion" id="soluciones">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 03 / Qué construimos</span>
          <h2 class="ia-h2">Sistemas con un trabajo asignado.</h2>
          <p class="ia-parrafo">
            No vendemos «IA». Construimos piezas que hacen una tarea concreta dentro de tu operación,
            con sus permisos, sus registros y su punto de control. Si vienes de
            <span data-eco-departamento>ventas</span>, empezaríamos por lo que más se repite.
          </p>
        </header>

        <article class="ia-destacada">
          <div class="ia-destacada__texto">
            <h3 class="ia-h3">Agentes para procesos</h3>
            <p>
              Completan encargos de varios pasos usando tus herramientas: reciben una solicitud,
              consultan lo que necesitan, preparan el resultado, esperan aprobación si se lo pides y
              actualizan el sistema que corresponda.
            </p>
            <ul class="ia-chips">
              <li>multi-paso</li><li>con herramientas</li><li>con registro de todo</li>
            </ul>
          </div>
          <Lamina
            referencia="LÁM. 03"
            titulo="Anatomía de un agente"
            descripcion="El agente recibe una solicitud, consulta el CRM y el ERP, comprueba una condición, prepara el resultado, espera aprobación humana y registra la acción."
            class="ia-destacada__lamina"
          >
            <FlujoEncargo pasos={pasosAnatomia.slice(0, 4)} id="flujo-agente" />
          </Lamina>
        </article>

        <article class="ia-destacada ia-destacada--inversa">
          <div class="ia-destacada__texto">
            <h3 class="ia-h3">Comercio: probador virtual y ficha automática</h3>
            <p>
              Tu cliente se prueba el producto desde la cámara del móvil, sin instalar nada, y tu
              catálogo se completa solo a partir de una foto: nombre, descripción, atributos, SEO y
              traducciones.
            </p>
            <ul class="ia-chips">
              <li>menos devoluciones por expectativa</li><li>catálogo listo antes</li>
            </ul>
            <p class="ia-destacada__enlaces">
              <a href="/probador-virtual-ar/">Probar el probador virtual</a>
              <a href="/soluciones/ecommerce/">Ver tiendas online</a>
            </p>
          </div>
          <Lamina
            referencia="LÁM. 07"
            titulo="Probador virtual"
            descripcion="El móvil sigue la cara con seis ejes de libertad, el producto se coloca sobre ella y queda ocluido por la cabeza, y el cliente cambia de modelo desde el catálogo, todo en el navegador y sin instalar nada."
            leyenda={[{ color: 'maquina', texto: 'seguimiento' }, { color: 'verificado', texto: 'producto colocado' }]}
          >
            <VisorAR />
          </Lamina>
        </article>

        <ul class="ia-soluciones">
          {soluciones.map((s) => (
            <li class="ia-solucion">
              <h3 class="ia-solucion__t">{s.titulo}</h3>
              <p class="ia-solucion__d">{s.texto}</p>
              {s.href && <a class="ia-solucion__a" href={s.href}>{s.enlace}</a>}
            </li>
          ))}
        </ul>

        <div class="ia-centro"><Boton href="#diagnostico">Analizar mis procesos</Boton></div>
      </div>
    </section>

    <!-- 05 · ANATOMÍA -->
    <section class="ia-seccion ia-seccion--panel" id="anatomia">
      <div class="container-brutal ia-dos">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 04 / Cómo trabaja por dentro</span>
          <h2 class="ia-h2">Nueve minutos, paso a paso.</h2>
          <p class="ia-parrafo">
            Esto es lo que ocurre entre que entra un correo y sale una propuesta. Cada línea queda
            registrada: qué hizo el sistema, qué consultó y quién aprobó.
          </p>
          <p class="ia-nota">
            Si algo no cuadra —falta un dato, el precio se sale de rango, el documento es ilegible—
            el sistema no improvisa: lo marca y lo deja en manos de una persona.
          </p>
        </header>
        <Lamina
          referencia="LÁM. 04"
          titulo="Registro de un encargo"
          chip="ejemplo"
          descripcion="Registro con seis entradas: entrada del correo, lectura del documento, consulta a CRM y ERP, comprobación de una condición, aprobación humana y envío con registro en el CRM."
          leyenda={[{ color: 'maquina', texto: 'máquina' }, { color: 'persona', texto: 'persona' }]}
        >
          <FlujoEncargo pasos={pasosAnatomia} id="flujo-anatomia" />
        </Lamina>
      </div>
    </section>

    <!-- 06 · INTEGRACIONES -->
    <section class="ia-seccion" id="integraciones">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 05 / Con lo que ya tienes</span>
          <h2 class="ia-h2">La IA no sustituye tus herramientas. <em>Trabaja con ellas.</em></h2>
          <p class="ia-parrafo">
            Nadie va a cambiar de ERP para poner IA. La capa que construimos se conecta a lo que ya
            usáis y deja los datos donde estaban.
          </p>
        </header>
        <Lamina
          referencia="LÁM. 05"
          titulo="Capa de integración"
          descripcion="Los sistemas de la empresa (CRM, ERP, correo y archivos) alimentan una capa de agentes con permisos y registro, que devuelve documentos, registros y respuestas, con un punto de aprobación humana."
          leyenda={[{ color: 'maquina', texto: 'flujo automático' }, { color: 'persona', texto: 'aprobación' }]}
        >
          <CapaIntegracion />
        </Lamina>
        <div class="ia-tres">
          <div><h3 class="ia-h4">Por API</h3><p>Cuando el fabricante la ofrece: es la vía limpia y la primera que miramos.</p></div>
          <div><h3 class="ia-h4">Por fichero o base de datos</h3><p>Cuando no hay API: exportaciones, carpetas vigiladas o lectura directa.</p></div>
          <div><h3 class="ia-h4">Por interfaz</h3><p>Último recurso y solo si es estable: el sistema hace lo que haría una persona.</p></div>
        </div>
        <p class="ia-aviso">
          No publicamos una lista de integraciones «compatibles». Cada programa tiene su versión, su
          licencia y sus permisos, así que la conexión se confirma en el diagnóstico, no en una
          página web.
        </p>
      </div>
    </section>

    <!-- 07 · CONTROL -->
    <section class="ia-seccion ia-seccion--panel" id="control">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 06 / Quién manda</span>
          <h2 class="ia-h2">Automatiza sin perder el control.</h2>
          <p class="ia-parrafo">
            El nivel de autonomía lo decides paso a paso, no de golpe. Empezar por lo conservador y
            subir cuando el sistema se ha ganado la confianza es lo normal, no un fracaso.
          </p>
        </header>
        <NivelesControl />
      </div>
    </section>

    <!-- 08 · SEGURIDAD -->
    <section class="ia-seccion" id="seguridad">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 07 / Datos</span>
          <h2 class="ia-h2">IA útil. <em>Datos bajo control.</em></h2>
          <p class="ia-parrafo">
            Poner IA en producción es bastante más que conectar una API. Esto es lo que definimos en
            cada proyecto, por escrito, antes de encender nada.
          </p>
        </header>
        <div class="ia-dos ia-dos--seguridad">
          <dl class="ia-controles">
            {controles.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          </dl>
          <div>
            <Lamina
              referencia="LÁM. 06"
              titulo="Dónde se ejecuta cada cosa"
              descripcion="Tres zonas: en tu red se quedan el ERP, el CRM, los archivos y las copias; en nuestro servidor viven la lógica, los permisos y el registro; al proveedor del modelo solo llega el texto necesario para resolver cada paso."
              leyenda={[{ color: 'verificado', texto: 'tu red' }, { color: 'maquina', texto: 'nuestro servidor' }, { color: 'regla', texto: 'proveedor' }]}
            >
              <ZonasEjecucion />
            </Lamina>
            <p class="ia-aviso">
              Qué proveedor de modelo se usa, con qué condiciones de tratamiento y qué datos salen de
              tu red se decide y se documenta en el diagnóstico. No firmamos garantías genéricas en
              una web.
            </p>
            <p><a class="ia-enlace-tecnico" href="/contacto/">Hablar con el equipo técnico</a> — si eres responsable de sistemas y quieres la conversación técnica, sáltate el formulario.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 09 · METODOLOGÍA -->
    <section class="ia-seccion ia-seccion--panel" id="metodo">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 08 / Cómo trabajamos</span>
          <h2 class="ia-h2">Empezamos pequeño, medimos y crecemos.</h2>
        </header>
        <ol class="ia-metodo">
          {metodo.map((m) => (
            <li class="ia-etapa">
              <span class="ia-etapa__n">{m.n}</span>
              <h3 class="ia-etapa__t">{m.etapa}</h3>
              <p class="ia-etapa__d">{m.hace}</p>
              <p class="ia-etapa__e"><span>Recibes</span>{m.recibe}</p>
              <p class="ia-etapa__dur">{m.dura}</p>
            </li>
          ))}
        </ol>
        <p class="ia-aviso">Las duraciones son orientativas: dependen del estado de tus datos y de los permisos que haya que pedir.</p>
      </div>
    </section>

    <!-- 10 · SECTORES -->
    <section class="ia-seccion" id="sectores">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 09 / En tu sector</span>
          <h2 class="ia-h2">Ejemplos de aplicación.</h2>
          <p class="ia-parrafo">
            Procesos reales de empresas como las de aquí. Los rotulamos como ejemplos porque son
            escenarios de trabajo, no casos de clientes.
          </p>
        </header>
        <dl class="ia-sectores">
          {sectores.map((s) => (
            <div class="ia-sector">
              <dt class="ia-sector__t">{s.sector}</dt>
              <dd class="ia-sector__d">{s.proceso}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 11 · SERVICIOS -->
    <section class="ia-seccion ia-seccion--panel" id="servicios">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 10 / Cómo se contrata</span>
          <h2 class="ia-h2">Cuatro formas de empezar, según lo lejos que quieras llegar.</h2>
        </header>
        <div class="ia-servicios">
          {servicios.map((s) => (
            <article class:list={['ia-servicio', s.recurrente && 'ia-servicio--rec']}>
              <h3 class="ia-servicio__t">{s.nombre}</h3>
              {s.recurrente && <span class="ia-servicio__chip">recurrente</span>}
              <p class="ia-servicio__quien">{s.quien}</p>
              <p class="ia-servicio__hace">{s.hace}</p>
              <p class="ia-servicio__recibe"><span>Qué recibes</span>{s.recibe}</p>
              <p class="ia-servicio__precio">{s.precio}</p>
            </article>
          ))}
        </div>
        <p class="ia-aviso">
          Lo que ninguno incluye: licencias de terceros, cambios en tus programas que dependan de su
          fabricante, ni el consumo de modelos, que se factura aparte y se estima en el diagnóstico.
        </p>
      </div>
    </section>

    <!-- 12 · ROI -->
    <section class="ia-seccion" id="roi">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 11 / Los números</span>
          <h2 class="ia-h2">Calcula qué te está costando hacerlo a mano.</h2>
        </header>
        <CalculadoraROI />
      </div>
    </section>

    <!-- 13 · LABORATORIO -->
    <section class="ia-seccion ia-seccion--panel" id="laboratorio">
      <div class="container-brutal">
        <header class="ia-cab">
          <span class="ia-cap">Cap. 12 / Pruébalo</span>
          <h2 class="ia-h2">Ahora pruébalo.</h2>
          <p class="ia-parrafo">
            No son maquetas ni vídeos: son sistemas funcionando, construidos por nosotros. Lo que
            vendemos es esto mismo, conectado a tus datos.
          </p>
        </header>
        <ul class="ia-demos">
          {demos.map((d) => (
            <li class:list={['ia-demo', d.destacada && 'ia-demo--destacada']}>
              <span class="ia-demo__chip">demo · en vivo</span>
