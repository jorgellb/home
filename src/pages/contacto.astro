---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Contact from '../components/sections/Contact.astro';
import FAQ from '../components/sections/FAQ.astro';

const phoneNumber = '+34657085019';
const whatsappLink = `https://wa.me/${phoneNumber.replace('+', '')}?text=Hola%2C%20me%20interesa%20contratar%20vuestros%20servicios`;
const telLink = `tel:${phoneNumber}`;

const trust = [
  { num: '01', title: 'Respuesta en <4h',          body: 'No te dejamos esperando. Tu mensaje llega directamente al equipo técnico. Sin tickets, sin filtros, sin "te derivamos a un compañero".' },
  { num: '02', title: 'Equipo local en Almería',   body: 'Personas reales, aquí al lado. Podemos vernos en persona, tomar un café y hablar de tu proyecto cara a cara cuando haga falta.' },
  { num: '03', title: 'Sin compromiso',            body: 'Consultar es gratis. Te damos un presupuesto claro con todo detallado. Sin sorpresas, sin permanencias, sin trampas.' },
  { num: '04', title: '15+ años de experiencia',   body: 'Hemos trabajado con más de 200 negocios en la provincia. Sabemos qué funciona, qué no — y cuándo decirte que no es buen momento.' },
];

const steps = [
  { num: '01', title: 'Nos cuentas tu idea',                eta: 'Hoy',     body: 'WhatsApp, teléfono o formulario. Como prefieras. Cuéntanos qué necesitas sin tecnicismos — nosotros lo traducimos.' },
  { num: '02', title: 'Te enviamos presupuesto claro',      eta: '<24h',    body: 'Plazos, precios y todo lo que incluye. Sin sorpresas ni letra pequeña.' },
  { num: '03', title: 'Arrancamos',                         eta: '2 sem.',  body: 'Comunicación constante, entregas parciales y tú al mando de las decisiones importantes.' },
];
---

<BaseLayout
  title="Contacto | Platanito Rico — Diseño Web y Marketing en Almería"
  description="Contacta con Platanito Rico en Almería. Respuesta en menos de 4h por WhatsApp o formulario. Presupuesto gratis."
  canonical="https://platanitorico.com/contacto/"
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Contacta con el equipo de Platanito Rico"
  type="website"
  lang="es"
  keywords="contacto diseño web almería, presupuesto web, agencia digital almería"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'ContactPage', 'name': 'Contacto — Platanito Rico', 'url': 'https://platanitorico.com/contacto/' },
    { '@context': 'https://schema.org', '@type': 'LocalBusiness', 'name': 'Platanito Rico', 'url': 'https://platanitorico.com', 'telephone': phoneNumber, 'email': 'hola@platanitorico.com', 'address': { '@type': 'PostalAddress', 'streetAddress': 'Ctra de Ronda, 82', 'addressLocality': 'Vera', 'addressRegion': 'Almería', 'postalCode': '04620', 'addressCountry': 'ES' } }
  ]}
>
  <Header />

  <main id="main-content">
    {/* Hero editorial */}
    <section class="contacto-hero">
      <div class="container-brutal">
        <header class="contacto-hero__head">
          <div class="text-meta">N.º 027 — Contacto</div>
          <div class="text-meta"><span class="live-dot"></span> Aceptando proyectos · 2026</div>
        </header>

        <div class="divider-brutal"></div>

        <div class="contacto-hero__grid">
          <div>
            <span class="text-meta">Cap. 01 / Hablemos</span>
            <h1 class="heading-display contacto-hero__title">
              ¿Empezamos
              <em class="heading-editorial">tu próximo</em>
              <span class="text-stroke-ink">proyecto?</span>
            </h1>

            <p class="contacto-hero__lead">
              Cuéntanos qué necesitas y te ayudamos a hacerlo realidad. Llevamos
              <strong>15+ años</strong> ayudando a negocios en Almería a crecer
              en internet. Tu consulta no molesta — nos encanta lo que hacemos.
            </p>

            <div class="contacto-hero__cta">
              <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-brutal btn-brutal--lg">
                Escribir por WhatsApp →
              </a>
              <a href={telLink} class="btn-brutal btn-brutal--ghost btn-brutal--lg">
                Llamar {phoneNumber}
              </a>
            </div>
          </div>

          {/* Spec sheet */}
          <aside class="contacto-hero__specs">
            <div class="contacto-hero__spec contacto-hero__spec--accent">
              <span class="contacto-hero__spec-num text-mono">200<sup>+</sup></span>
              <span class="contacto-hero__spec-lbl">Proyectos</span>
            </div>
            <div class="contacto-hero__spec contacto-hero__spec--lime">
              <span class="contacto-hero__spec-num text-mono">&lt;4h</span>
              <span class="contacto-hero__spec-lbl">Respuesta</span>
            </div>
            <div class="contacto-hero__spec">
              <span class="contacto-hero__spec-num text-mono">15<sup>+</sup></span>
              <span class="contacto-hero__spec-lbl">Años</span>
            </div>
            <div class="contacto-hero__spec contacto-hero__spec--ink">
              <span class="contacto-hero__spec-num text-mono">24/7</span>
              <span class="contacto-hero__spec-lbl">WhatsApp</span>
            </div>
          </aside>
        </div>
      </div>

      {/* Marquee declaration */}
      <div class="contacto-hero__marquee">
        <div class="contacto-hero__marquee-track">
          {Array.from({length: 8}).map(() => (
            <span>RESPUESTA EN MENOS DE 4 HORAS ★</span>
          ))}
        </div>
      </div>
    </section>

    {/* Formulario + canales — usamos componente Contact */}
    <Contact />

    {/* Trust */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Por qué nosotros</span>
            <h2 class="heading-display brutal-section-head__title">
              No somos una agencia
              <em class="heading-editorial">más.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuando nos contactas hablas con las personas que van a trabajar en tu
            proyecto. Sin comerciales, sin gestores intermedios.
          </p>
        </header>

        <ol class="contacto-trust-grid">
          {trust.map((r) => (
            <li class="contacto-trust">
              <span class="contacto-trust__num text-mono">{r.num}</span>
              <h3 class="contacto-trust__title heading-display">{r.title}</h3>
              <p class="contacto-trust__body">{r.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* Cómo funciona */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Cómo funciona</span>
            <h2 class="heading-display brutal-section-head__title">
              Tres pasos,
              <em class="heading-editorial">ningún misterio.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Sin presentaciones interminables ni reuniones de descubrimiento de
            tres semanas. Vamos al grano desde el primer contacto.
          </p>
        </header>

        <ol class="contacto-steps">
          {steps.map((s) => (
            <li class="contacto-step">
              <div class="contacto-step__num text-mono">
                <span>{s.num}</span>
                <small>{s.eta}</small>
              </div>
              <div>
                <h3 class="heading-display contacto-step__title">{s.title}</h3>
                <p class="contacto-step__body">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>

        {/* Horario / data sheet */}
        <div class="contacto-schedule">
          <header class="contacto-schedule__head">
            <span class="text-meta">Horario</span>
            <span class="text-meta">★ ALM</span>
          </header>
          <dl class="spec-list">
            <div><dt class="spec-k">Lunes–Viernes</dt><dd class="spec-v">09:00 – 19:00</dd></div>
            <div><dt class="spec-k">Sábados</dt><dd class="spec-v">10:00 – 14:00</dd></div>
            <div><dt class="spec-k">Domingos</dt><dd class="spec-v">Cerrado · WhatsApp 24/7</dd></div>
            <div><dt class="spec-k">Estudio</dt><dd class="spec-v">Ctra. de Ronda, 82 — Vera</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <FAQ />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .contacto-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background: var(--brutal-bg);
    border-bottom: 3px solid var(--brutal-ink);
  }
  .contacto-hero__head {
    display: flex; justify-content: space-between; padding-bottom: 1rem;
    flex-wrap: wrap; gap: 1rem;
  }
  .contacto-hero__grid {
    display: grid; gap: 3rem;
    grid-template-columns: 1fr;
    padding-block: 3rem;
  }
  @media (min-width: 1024px) { .contacto-hero__grid { grid-template-columns: 1.7fr 1fr; align-items: end; gap: 4rem; } }
  .contacto-hero__title {
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: .85;
    letter-spacing: -.045em;
    margin: 1rem 0 1.5rem;
  }
  .contacto-hero__title em { color: var(--brutal-accent); font-style: italic; }
  .contacto-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 52ch; }
  .contacto-hero__lead strong { color: var(--brutal-ink); font-weight: 700; }
  .contacto-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }

  .contacto-hero__specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 2px solid var(--brutal-ink);
    background: var(--brutal-ink);
  }
  .contacto-hero__spec {
    background: var(--brutal-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    border-right: 2px solid var(--brutal-ink);
    border-bottom: 2px solid var(--brutal-ink);
  }
  .contacto-hero__spec:nth-child(2n) { border-right: none; }
  .contacto-hero__spec:nth-last-child(-n+2) { border-bottom: none; }
  .contacto-hero__spec--accent { background: var(--brutal-accent); color: var(--brutal-ink); }
  .contacto-hero__spec--lime { background: var(--brutal-lime); color: var(--brutal-ink); }
  .contacto-hero__spec--ink { background: var(--brutal-ink); color: var(--brutal-bg); }
  .contacto-hero__spec--ink .contacto-hero__spec-num { color: var(--brutal-lime); }
  .contacto-hero__spec-num { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; line-height: 1; }
  .contacto-hero__spec-num sup { font-size: .5em; vertical-align: super; color: var(--brutal-accent); }
  .contacto-hero__spec-lbl { font-family: var(--font-mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  .contacto-hero__marquee {
    background: var(--brutal-ink);
    color: var(--brutal-lime);
    overflow: hidden;
    padding: 1rem 0;
    border-top: 2px solid var(--brutal-ink);
  }
  .contacto-hero__marquee-track {
    display: flex; gap: 3rem; width: max-content;
    animation: marquee 30s linear infinite;
    font-family: var(--font-mono);
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    font-weight: 700;
  }

  /* Trust */
  .contacto-trust-grid {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--brutal-ink);
    background: var(--brutal-ink);
  }
  @media (min-width: 640px) { .contacto-trust-grid { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  .contacto-trust {
    background: var(--brutal-card);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    transition: background .25s;
  }
  .contacto-trust:hover { background: var(--brutal-bg-alt); }
  .contacto-trust__num { font-size: 1.75rem; font-weight: 700; color: var(--brutal-accent); line-height: 1; }
  .contacto-trust__title { font-size: clamp(1.4rem, 2.5vw, 1.85rem); line-height: 1; letter-spacing: -.025em; margin: .25rem 0 .5rem; }
  .contacto-trust__body { font-size: .95rem; color: var(--brutal-text-secondary); line-height: 1.55; }

  /* Steps */
  .contacto-steps {
    list-style: none; padding: 0; margin: 2rem 0 3rem;
    border-top: 2px solid var(--brutal-ink);
  }
  .contacto-step {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--brutal-border-soft);
  }
  .contacto-step__num { display: flex; flex-direction: column; }
  .contacto-step__num span { font-size: 2rem; font-weight: 700; color: var(--brutal-ink); line-height: 1; }
  .contacto-step__num small { font-family: var(--font-mono); font-size: .65rem; color: var(--brutal-accent); text-transform: uppercase; letter-spacing: .18em; font-weight: 600; margin-top: .25rem; }
  .contacto-step__title { font-size: clamp(1.4rem, 3vw, 2.25rem); line-height: 1; letter-spacing: -.03em; margin: 0 0 .5rem; }
  .contacto-step__body { font-size: .95rem; color: var(--brutal-text-secondary); line-height: 1.55; max-width: 54ch; }

  /* Schedule */
  .contacto-schedule {
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    box-shadow: 6px 6px 0 0 var(--brutal-ink);
    padding: 1.5rem 2rem;
    max-width: 520px;
  }
  .contacto-schedule__head { display: flex; justify-content: space-between; padding-bottom: 1rem; border-bottom: 2px solid var(--brutal-ink); margin-bottom: .5rem; }
</style>
