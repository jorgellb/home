---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FAQ from '../components/sections/FAQ.astro';

const phoneNumber = '+34657085019';
const phoneDisplay = '657 085 019';
const whatsappLink = `https://wa.me/${phoneNumber.replace('+', '')}?text=Hola%2C%20me%20interesa%20contratar%20vuestros%20servicios`;
const telLink = `tel:${phoneNumber}`;
const today = new Date();
const dispatch = `${String(today.getDate()).padStart(2,'0')}.${String(today.getMonth()+1).padStart(2,'0')}.${today.getFullYear()}`;

const channels = [
  { id: 'whatsapp', label: 'WhatsApp',      value: phoneDisplay,           meta: 'Respuesta inmediata', href: whatsappLink,                  ext: true,  color: 'mint',   icon: 'wa',   hint: '24/7 · Lo más rápido' },
  { id: 'tel',      label: 'Llamada',       value: phoneDisplay,           meta: 'L–V · 09–19h',         href: telLink,                       ext: false, color: 'lime',   icon: 'tel',  hint: 'Habla con el equipo' },
  { id: 'email',    label: 'Email',         value: 'hola@platanitorico.com', meta: 'Respuesta < 24h',     href: 'mailto:hola@platanitorico.com', ext: false, color: 'cyan',   icon: 'mail', hint: 'Brief detallado' },
];

const trust = [
  { num: '01', stamp: 'EXPRESS',    title: 'Respuesta < 4h',         body: 'Sin tickets, sin filtros, sin "te derivamos a un compañero". Tu mensaje llega directo al equipo técnico.', color: 'red'    },
  { num: '02', stamp: 'LOCAL',      title: 'Equipo en Almería',      body: 'Personas reales, aquí al lado. Podemos vernos en persona y hablar cara a cara cuando haga falta.',          color: 'blue'   },
  { num: '03', stamp: 'GRATIS',     title: 'Sin compromiso',         body: 'Consultar es gratis. Te damos presupuesto claro con todo detallado. Sin sorpresas, sin permanencias.',        color: 'lime'   },
  { num: '04', stamp: '15+ AÑOS',   title: '200+ proyectos',         body: 'Hemos trabajado con más de 200 negocios en la provincia. Sabemos qué funciona — y cuándo decirte que no.',     color: 'orange' },
];

const steps = [
  { num: '01', tag: 'HOY',     title: 'Nos cuentas tu idea',           body: 'WhatsApp, teléfono o el formulario. Cuéntanos qué necesitas sin tecnicismos — nosotros lo traducimos.', sello: 'RX' },
  { num: '02', tag: '<24H',    title: 'Te enviamos presupuesto',       body: 'Plazos, precios y todo lo que incluye. Sin sorpresas ni letra pequeña. Mini-roadmap incluido.',             sello: 'OK' },
  { num: '03', tag: '2 SEM.',  title: 'Arrancamos producción',         body: 'Comunicación constante, entregas parciales y tú al mando de las decisiones importantes.',                  sello: 'GO' },
];

const dispatchBoard = [
  { k: 'Estado',           v: 'ACEPTANDO PROYECTOS',          tone: 'on' },
  { k: 'Plazas Q3·2026',   v: '03 / 08 disponibles',          tone: 'warn' },
  { k: 'Próxima ventana',  v: '+2 semanas',                   tone: 'off' },
  { k: 'Tiempo respuesta', v: '< 4 horas (jornada laboral)',  tone: 'off' },
  { k: 'Idiomas estudio',  v: 'ES · EN · DE',                 tone: 'off' },
  { k: 'Cobertura',        v: 'Almería · España · UE',        tone: 'off' },
];

const sectores = [
  'Hostelería', 'Inmobiliarias', 'Comercio local', 'Restauración',
  'Construcción', 'Servicios profesionales', 'Educación', 'Salud y bienestar',
];
---

<BaseLayout
  title="Contacto | Platanito Rico — Diseño Web y Marketing en Almería"
  description="Contacta con Platanito Rico en Almería. Respuesta en menos de 4h por WhatsApp o formulario. Presupuesto gratis y sin compromiso."
  canonical="https://platanitorico.com/contacto/"
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Contacta con el equipo de Platanito Rico"
  type="website"
  lang="es"
  keywords="contacto diseño web almería, presupuesto web, agencia digital almería, whatsapp platanito rico, contactar agencia almería"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'ContactPage', 'name': 'Contacto — Platanito Rico', 'url': 'https://platanitorico.com/contacto/' },
    { '@context': 'https://schema.org', '@type': 'LocalBusiness', 'name': 'Platanito Rico', 'url': 'https://platanitorico.com', 'telephone': phoneNumber, 'email': 'hola@platanitorico.com', 'address': { '@type': 'PostalAddress', 'streetAddress': 'Ctra de Ronda, 82', 'addressLocality': 'Vera', 'addressRegion': 'Almería', 'postalCode': '04620', 'addressCountry': 'ES' } },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': 'https://platanitorico.com/' },
      { '@type': 'ListItem', 'position': 2, 'name': 'Contacto', 'item': 'https://platanitorico.com/contacto/' }
    ]}
  ]}
>
  <Header />

  <main id="main-content" class="ct">

    {/* ════════════════════════════════════════════════════ */}
    {/* HERO — SOBRE AIRMAIL                                  */}
    {/* ════════════════════════════════════════════════════ */}
    <section class="ct-hero">
      <div class="container-brutal">

        <header class="ct-hero__top">
          <div class="text-meta">N.º 027 — Correspondencia</div>
          <div class="text-meta"><span class="live-dot"></span> Aceptando proyectos · 2026</div>
        </header>

        <div class="divider-brutal"></div>

        <div class="ct-hero__grid">

          {/* Columna izquierda: titular + lead */}
          <div class="ct-hero__intro">
            <span class="text-meta">Cap. 01 / Hablemos</span>
            <h1 class="ct-hero__title heading-display">
              Escríbenos
              <em class="heading-editorial">como si fuera</em>
              <span class="ct-hero__title-stamp">una carta.</span>
            </h1>
            <p class="ct-hero__lead">
              Cuéntanos qué necesitas y te ayudamos a hacerlo realidad. Llevamos
              <strong>15+ años</strong> ayudando a negocios en Almería a crecer
              en internet. Tu consulta no molesta — nos encanta lo que hacemos.
            </p>
            <div class="ct-hero__cta">
              <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-brutal btn-brutal--lg">Escribir por WhatsApp →</a>
              <a href="#formulario" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Bajar al formulario ↓</a>
            </div>
          </div>

          {/* Columna derecha: SOBRE AIRMAIL */}
          <aside class="ct-envelope" aria-hidden="true">
            <div class="ct-envelope__paper">

              {/* Stripes airmail */}
              <div class="ct-envelope__stripes"></div>

              {/* PAR AVION badge */}
              <div class="ct-envelope__avion">
                <svg viewBox="0 0 60 24" width="60" height="24" aria-hidden="true">
                  <path d="M2 12 L48 6 L52 4 L58 8 L52 10 L40 14 L48 22 L40 22 L30 16 L14 18 L2 12 Z" fill="#DC1B2C"/>
                </svg>
                <span>PAR AVION</span>
                <span class="ct-envelope__avion-sub">POR AVIÓN · BY AIR MAIL</span>
              </div>

              {/* Sellos / stamps */}
              <div class="ct-envelope__stamps">
                <div class="ct-stamp ct-stamp--orange">
                  <svg viewBox="0 0 60 70" width="60" height="70" aria-hidden="true">
                    <path d="M30 8 Q24 22 30 38 Q36 22 30 8 Z" fill="#FFD600" stroke="#0E0D0B" stroke-width="1.5"/>
                    <path d="M30 8 Q26 26 30 38" fill="none" stroke="#0E0D0B" stroke-width="1"/>
                    <circle cx="30" cy="46" r="2" fill="#0E0D0B"/>
                  </svg>
                  <span class="ct-stamp__val">0,75 €</span>
                  <span class="ct-stamp__txt">ESPAÑA · 2026</span>
                </div>
                <div class="ct-stamp ct-stamp--mint">
                  <svg viewBox="0 0 60 70" width="60" height="70" aria-hidden="true">
                    <rect x="14" y="14" width="32" height="32" fill="none" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="14" y1="14" x2="46" y2="46" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="46" y1="14" x2="14" y2="46" stroke="#0E0D0B" stroke-width="2"/>
                    <circle cx="30" cy="30" r="8" fill="#D6FF44" stroke="#0E0D0B" stroke-width="2"/>
                  </svg>
                  <span class="ct-stamp__val">1,50 €</span>
                  <span class="ct-stamp__txt">CORREO URGENTE</span>
                </div>
                <div class="ct-stamp ct-stamp--cyan">
                  <svg viewBox="0 0 60 70" width="60" height="70" aria-hidden="true">
                    <circle cx="30" cy="28" r="14" fill="none" stroke="#0E0D0B" stroke-width="2"/>
                    <circle cx="30" cy="28" r="8" fill="#FF6B35" stroke="#0E0D0B" stroke-width="1.5"/>
                    <circle cx="30" cy="28" r="3" fill="#0E0D0B"/>
                  </svg>
                  <span class="ct-stamp__val">2,00 €</span>
                  <span class="ct-stamp__txt">★ PLATANITO ★</span>
                </div>
              </div>

              {/* Postmark / matasellos */}
              <div class="ct-envelope__postmark">
                <svg viewBox="0 0 120 120" width="100%" height="100%" aria-hidden="true">
                  <defs>
                    <path id="ct-circle" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"/>
                  </defs>
                  <circle cx="60" cy="60" r="52" fill="none" stroke="#003B7A" stroke-width="2"/>
                  <circle cx="60" cy="60" r="44" fill="none" stroke="#003B7A" stroke-width="1.5" stroke-dasharray="3 2"/>
                  <text font-family="monospace" font-size="9" font-weight="bold" fill="#003B7A" letter-spacing="2">
                    <textPath href="#ct-circle" startOffset="0%">★ ALMERÍA · VERA · ESPAÑA · 04620 ★ ALMERÍA · VERA</textPath>
                  </text>
                  <line x1="20" y1="60" x2="100" y2="60" stroke="#003B7A" stroke-width="1.5"/>
                  <text x="60" y="50" text-anchor="middle" font-family="monospace" font-size="10" font-weight="bold" fill="#003B7A">{dispatch}</text>
                  <text x="60" y="74" text-anchor="middle" font-family="monospace" font-size="9" fill="#003B7A">RECIBIDO</text>
                </svg>
              </div>

              {/* Address block */}
              <div class="ct-envelope__address">
                <div class="ct-envelope__address-to">PARA / FOR:</div>
                <div class="ct-envelope__address-name">PLATANITO RICO</div>
                <div class="ct-envelope__address-line">Ctra. de Ronda, 82</div>
                <div class="ct-envelope__address-line">04620 — Vera</div>
                <div class="ct-envelope__address-line">Almería · ESPAÑA</div>
                <div class="ct-envelope__address-tracking">
                  <span class="text-mono">TRACKING:</span>
                  <span class="text-mono">PR-2026-{String(Math.floor(Math.random()*900000+100000))}-ES</span>
                </div>
              </div>

              {/* Watermark big number */}
              <div class="ct-envelope__watermark text-mono">027</div>

              {/* Corner triangles airmail */}
              <span class="ct-envelope__corner ct-envelope__corner--tl"></span>
              <span class="ct-envelope__corner ct-envelope__corner--tr"></span>
              <span class="ct-envelope__corner ct-envelope__corner--bl"></span>
              <span class="ct-envelope__corner ct-envelope__corner--br"></span>
            </div>
          </aside>

        </div>
      </div>

      {/* Telegrama marquee */}
      <div class="ct-telegram">
        <div class="ct-telegram__track">
          {Array.from({length: 4}).map(() => (
            <span class="ct-telegram__item">★ TELEGRAMA ★ PARA: USTED &middot; STOP &middot; RESPUESTA EN MENOS DE 4 HORAS &middot; STOP &middot; PRESUPUESTO GRATIS &middot; STOP &middot; SIN COMPROMISO &middot; STOP &middot; EQUIPO LOCAL ALMERÍA &middot; STOP &middot; ENVÍE BRIEFING &middot;</span>
          ))}
        </div>
      </div>
    </section>

    {/* ════════════════════════════════════════════════════ */}
    {/* CANALES — 3 CARDS GRANDES                             */}
    {/* ════════════════════════════════════════════════════ */}
    <section class="section-brutal ct-channels-section">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Canales directos</span>
            <h2 class="heading-display brutal-section-head__title">
              Tres formas
              <em class="heading-editorial">de empezar.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            La más rápida es WhatsApp, te leemos al instante. La más detallada es
            el formulario. Tú decides.
          </p>
        </header>

        <div class="ct-channels">
          {channels.map((c) => (
            <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener noreferrer' : undefined} class={`ct-channel ct-channel--${c.color}`}>
              <div class="ct-channel__head">
                <span class="ct-channel__num text-mono">0{channels.indexOf(c)+1}</span>
                <span class="ct-channel__label text-mono">{c.label}</span>
                <span class="ct-channel__live"><span class="live-dot"></span></span>
              </div>

              <div class="ct-channel__icon" aria-hidden="true">
                {c.icon === 'wa' && (
                  <svg viewBox="0 0 64 64" width="100%" height="100%">
                    <path d="M32 6C17.6 6 6 17.6 6 32c0 5.1 1.4 9.9 4 14L6 58l12.4-3.9c4 2.1 8.5 3.2 13.6 3.2 14.4 0 26-11.6 26-26S46.4 6 32 6z" fill="#0E0D0B"/>
                    <path d="M44.2 38.4c-.7-.4-3.9-1.9-4.5-2.1-.6-.2-1.1-.4-1.5.4-.5.7-1.7 2.1-2.1 2.6-.4.4-.8.5-1.4.2-3.7-1.8-6-3.3-8.4-7.6-.6-1.1.6-1 1.8-3.4.2-.4 0-.8-.1-1.1-.1-.4-1.5-3.6-2-4.9-.5-1.3-1-1.1-1.5-1.1H23c-.5 0-1.3.2-1.9.9-.6.7-2.5 2.4-2.5 5.8 0 3.4 2.5 6.8 2.9 7.2.4.4 5 7.6 12.1 10.7 4.5 1.9 6.2 2.1 8.4 1.8 1.4-.2 4.1-1.7 4.7-3.3.6-1.6.6-3 .4-3.3-.2-.3-.6-.5-1.3-.9z" fill="#D6FF44"/>
                  </svg>
                )}
                {c.icon === 'tel' && (
                  <svg viewBox="0 0 64 64" width="100%" height="100%">
                    <rect x="6" y="14" width="52" height="36" rx="6" fill="#0E0D0B"/>
                    <path d="M22 26c0-3 2-5 5-5h2l3 8-4 3c2 4 6 8 10 10l3-4 8 3v2c0 3-2 5-5 5h-3c-11 0-19-8-19-19v-3z" fill="#FFD600" stroke="#0E0D0B" stroke-width="1.5"/>
                    <circle cx="14" cy="32" r="2" fill="#FF0040"/>
                  </svg>
                )}
                {c.icon === 'mail' && (
                  <svg viewBox="0 0 64 64" width="100%" height="100%">
                    <rect x="6" y="14" width="52" height="36" fill="#FFFCF6" stroke="#0E0D0B" stroke-width="2.5"/>
                    <path d="M6 14 L32 36 L58 14" fill="none" stroke="#0E0D0B" stroke-width="2.5"/>
                    <path d="M6 50 L24 30 M58 50 L40 30" fill="none" stroke="#0E0D0B" stroke-width="2"/>
                    <circle cx="50" cy="20" r="6" fill="#00E5FF" stroke="#0E0D0B" stroke-width="2"/>
                  </svg>
                )}
              </div>

              <div class="ct-channel__body">
                <div class="ct-channel__value">{c.value}</div>
                <div class="ct-channel__meta text-mono">{c.meta}</div>
                <div class="ct-channel__hint">{c.hint}</div>
              </div>

              <div class="ct-channel__foot">
                <span class="ct-channel__cta">Abrir →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ════════════════════════════════════════════════════ */}
    {/* FORMULARIO BRIEFING                                   */}
    {/* ════════════════════════════════════════════════════ */}
    <section id="formulario" class="ct-form-section">
      <div class="container-brutal">

        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Briefing</span>
            <h2 class="heading-display brutal-section-head__title">
              Formulario
              <em class="heading-editorial">de envío.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuanta más información mejor — pero con 3 líneas también vale. Lo
            importante es empezar a hablar.
          </p>
        </header>

        <div class="ct-form-wrap">

          {/* Cabecera del documento */}
          <header class="ct-form-doc-head">
            <div class="ct-form-doc-head__l">
              <div class="text-mono ct-form-doc-head__id">EXP. № 027 / 2026</div>
              <div class="text-mono ct-form-doc-head__title">BRIEFING — CLIENTE NUEVO</div>
            </div>
            <div class="ct-form-doc-head__r">
              <div class="ct-form-doc-head__stamp">CONFIDENCIAL</div>
              <div class="text-mono ct-form-doc-head__date">{dispatch}</div>
            </div>
          </header>

          {/* Banda fechado lateral */}
          <div class="ct-form-side">
            <span>FECHA · {dispatch}</span>
            <span>·</span>
            <span>EXP · 027</span>
            <span>·</span>
            <span>VERA · ALMERÍA</span>
            <span>·</span>
            <span>ESPAÑA</span>
            <span>·</span>
            <span>FORMULARIO · 2026</span>
          </div>

          <form
            name="contact"
            method="POST"
            action="/api/contact/"
            class="ct-form"
          >
            <p style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
              <label>No rellenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            {/* Sección 1: Tu identidad */}
            <fieldset class="ct-fieldset">
              <legend class="ct-legend">
                <span class="ct-legend__num text-mono">§ 01</span>
                <span class="ct-legend__title">Tu identidad</span>
                <span class="ct-legend__line"></span>
              </legend>

              <div class="ct-row ct-row--2">
                <label class="ct-field">
                  <span class="ct-field__label">Nombre <span class="ct-field__req">★</span></span>
                  <span class="ct-field__hint text-mono">obligatorio · libre</span>
                  <input type="text" name="name" required placeholder="Cómo te llamas" class="ct-input" />
                </label>
                <label class="ct-field">
                  <span class="ct-field__label">Email <span class="ct-field__req">★</span></span>
                  <span class="ct-field__hint text-mono">obligatorio · para responder</span>
                  <input type="email" name="email" required placeholder="tu@email.com" class="ct-input" />
                </label>
              </div>

              <div class="ct-row ct-row--2">
                <label class="ct-field">
                  <span class="ct-field__label">Teléfono</span>
                  <span class="ct-field__hint text-mono">opcional · más rápido</span>
                  <input type="tel" name="phone" placeholder="+34 600 000 000" class="ct-input" />
                </label>
                <label class="ct-field">
                  <span class="ct-field__label">Empresa / proyecto</span>
                  <span class="ct-field__hint text-mono">opcional</span>
                  <input type="text" name="company" placeholder="Nombre o sector" class="ct-input" />
                </label>
              </div>
            </fieldset>

            {/* Sección 2: Servicio */}
            <fieldset class="ct-fieldset">
              <legend class="ct-legend">
                <span class="ct-legend__num text-mono">§ 02</span>
                <span class="ct-legend__title">¿Qué necesitas?</span>
                <span class="ct-legend__line"></span>
              </legend>

              <div class="ct-chips ct-chips--service">
                <input type="radio" id="s1" name="service" value="web" />
                <label for="s1"><span class="ct-chip-dot ct-chip-dot--green"></span>Diseño Web</label>
                <input type="radio" id="s2" name="service" value="audiovisual" />
                <label for="s2"><span class="ct-chip-dot ct-chip-dot--red"></span>Audiovisual / Dron</label>
                <input type="radio" id="s3" name="service" value="marketing" />
                <label for="s3"><span class="ct-chip-dot ct-chip-dot--blue"></span>Marketing / SEO</label>
                <input type="radio" id="s4" name="service" value="branding" />
                <label for="s4"><span class="ct-chip-dot ct-chip-dot--magenta"></span>Diseño gráfico</label>
                <input type="radio" id="s5" name="service" value="soporte" />
                <label for="s5"><span class="ct-chip-dot ct-chip-dot--cyan"></span>Soporte / Mant.</label>
                <input type="radio" id="s6" name="service" value="otro" checked />
                <label for="s6"><span class="ct-chip-dot ct-chip-dot--ink"></span>Otro / Mixto</label>
              </div>
            </fieldset>

            {/* Sección 3: Presupuesto + plazo */}
            <fieldset class="ct-fieldset">
              <legend class="ct-legend">
                <span class="ct-legend__num text-mono">§ 03</span>
                <span class="ct-legend__title">Presupuesto · plazo</span>
                <span class="ct-legend__line"></span>
              </legend>

              <div class="ct-row ct-row--2">
                <div class="ct-field">
                  <span class="ct-field__label">Presupuesto orientativo</span>
                  <span class="ct-field__hint text-mono">no pasa nada si no lo sabes</span>
                  <div class="ct-chips">
                    <input type="radio" id="b1" name="budget" value="0-1000" />
                    <label for="b1">&lt;1.000€</label>
                    <input type="radio" id="b2" name="budget" value="1000-3000" />
                    <label for="b2">1k–3k</label>
                    <input type="radio" id="b3" name="budget" value="3000-7000" />
                    <label for="b3">3k–7k</label>
                    <input type="radio" id="b4" name="budget" value="7000+" />
                    <label for="b4">7k+</label>
                    <input type="radio" id="b5" name="budget" value="no-idea" checked />
                    <label for="b5">No lo sé</label>
                  </div>
                </div>
                <div class="ct-field">
                  <span class="ct-field__label">¿Para cuándo?</span>
                  <span class="ct-field__hint text-mono">aproximado</span>
                  <div class="ct-chips">
                    <input type="radio" id="t1" name="timing" value="urgente" />
                    <label for="t1">URGENTE</label>
                    <input type="radio" id="t2" name="timing" value="1-mes" />
                    <label for="t2">&lt; 1 mes</label>
                    <input type="radio" id="t3" name="timing" value="1-3-meses" checked />
                    <label for="t3">1–3 meses</label>
