  .ct-hero__title-stamp {
    display: inline-block;
    color: var(--ct-red);
    transform: rotate(-2deg);
    border-bottom: 6px solid var(--ct-red);
    padding: 0 .1em;
  }
  .ct-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 52ch;
  }
  .ct-hero__lead strong { color: var(--ct-ink); font-weight: 700; }
  .ct-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  /* ── SOBRE ── */
  .ct-envelope {
    position: relative;
    aspect-ratio: 14 / 9;
    transform: rotate(-1.5deg);
    transition: transform .4s cubic-bezier(.2,.8,.2,1);
  }
  .ct-envelope:hover { transform: rotate(0deg) translateY(-4px); }
  .ct-envelope__paper {
    position: relative;
    width: 100%; height: 100%;
    background:
      repeating-linear-gradient(45deg, transparent 0 8px, rgba(220,27,44,0.04) 8px 9px),
      var(--ct-paper);
    border: 3px solid var(--ct-ink);
    box-shadow: 12px 12px 0 0 var(--ct-ink), 0 30px 60px -20px rgba(0,0,0,0.2);
    overflow: hidden;
  }
  /* Stripes airmail diagonales en el borde */
  .ct-envelope__stripes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      /* arriba */
      linear-gradient(90deg, transparent, transparent) top/100% 12px no-repeat,
      /* abajo */
      repeating-linear-gradient(135deg, var(--ct-red) 0 12px, var(--ct-paper) 12px 18px, var(--ct-blue) 18px 30px, var(--ct-paper) 30px 36px) bottom/100% 14px no-repeat,
      repeating-linear-gradient(45deg,  var(--ct-red) 0 12px, var(--ct-paper) 12px 18px, var(--ct-blue) 18px 30px, var(--ct-paper) 30px 36px) top/100% 14px no-repeat,
      repeating-linear-gradient(45deg,  var(--ct-red) 0 12px, var(--ct-paper) 12px 18px, var(--ct-blue) 18px 30px, var(--ct-paper) 30px 36px) left/14px 100% no-repeat,
      repeating-linear-gradient(135deg, var(--ct-red) 0 12px, var(--ct-paper) 12px 18px, var(--ct-blue) 18px 30px, var(--ct-paper) 30px 36px) right/14px 100% no-repeat;
  }
  .ct-envelope__avion {
    position: absolute;
    top: 22px; left: 22px;
    display: flex; align-items: center; gap: .5rem;
    background: var(--ct-paper);
    padding: .35rem .6rem;
    border: 2px solid var(--ct-ink);
    box-shadow: 3px 3px 0 0 var(--ct-ink);
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .15em;
    color: var(--ct-red);
    z-index: 3;
  }
  .ct-envelope__avion-sub {
    font-size: .55rem;
    color: var(--ct-blue);
    letter-spacing: .12em;
    margin-left: .5rem;
    border-left: 1.5px solid var(--ct-ink);
    padding-left: .5rem;
  }
  .ct-envelope__stamps {
    position: absolute;
    top: 20px; right: 24px;
    display: flex;
    gap: 6px;
    z-index: 3;
    transform: rotate(2deg);
  }
  .ct-stamp {
    width: 60px;
    background: var(--ct-paper);
    border: 1.5px dashed var(--ct-ink);
    padding: 5px 4px 6px;
    display: flex; flex-direction: column; align-items: center;
    box-shadow: 2px 2px 0 rgba(14,13,11,0.15);
    font-family: var(--font-mono);
    text-align: center;
  }
  .ct-stamp svg { display: block; width: 34px; height: 40px; }
  .ct-stamp__val { font-size: .7rem; font-weight: 700; line-height: 1; margin-top: 2px; color: var(--ct-ink); }
  .ct-stamp__txt { font-size: .42rem; letter-spacing: .08em; color: var(--ct-ink); margin-top: 2px; }
  .ct-stamp--orange { background: var(--ct-orange); }
  .ct-stamp--mint   { background: var(--ct-mint); }
  .ct-stamp--cyan   { background: var(--ct-cyan); }
  .ct-stamp:nth-child(1) { transform: rotate(-4deg); }
  .ct-stamp:nth-child(2) { transform: rotate(1deg); }
  .ct-stamp:nth-child(3) { transform: rotate(-2deg); }

  .ct-envelope__postmark {
    position: absolute;
    top: 36%;
    right: 22%;
    width: 110px;
    aspect-ratio: 1;
    transform: rotate(-12deg);
    opacity: 0.85;
    z-index: 2;
    animation: ct-postmark-in .8s ease-out .3s both;
  }
  @keyframes ct-postmark-in {
    0%   { opacity: 0; transform: rotate(-30deg) scale(2); }
    60%  { opacity: 0.95; transform: rotate(-10deg) scale(1.05); }
    100% { opacity: 0.85; transform: rotate(-12deg) scale(1); }
  }

  .ct-envelope__address {
    position: absolute;
    bottom: 50px; left: 26px;
    font-family: var(--font-mono);
    z-index: 2;
    text-align: left;
  }
  .ct-envelope__address-to {
    font-size: .55rem;
    letter-spacing: .15em;
    color: var(--ct-blue);
    margin-bottom: 4px;
  }
  .ct-envelope__address-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--ct-ink);
    border-bottom: 2px solid var(--ct-ink);
    padding-bottom: 4px;
    margin-bottom: 6px;
  }
  .ct-envelope__address-line {
    font-size: .72rem;
    line-height: 1.35;
    color: var(--ct-ink);
  }
  .ct-envelope__address-tracking {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1.5px dashed var(--ct-ink);
    font-size: .55rem;
    letter-spacing: .1em;
    display: flex; gap: .5rem;
    color: var(--ct-blue);
  }
  .ct-envelope__watermark {
    position: absolute;
    bottom: -30px;
    right: -10px;
    font-size: 16rem;
    line-height: 1;
    font-weight: 800;
    color: rgba(14,13,11,0.04);
    pointer-events: none;
    z-index: 1;
  }
  .ct-envelope__corner {
    position: absolute;
    width: 0; height: 0;
    border-style: solid;
    z-index: 1;
  }
  .ct-envelope__corner--tl {
    top: 0; left: 0;
    border-width: 30px 30px 0 0;
    border-color: var(--ct-red) transparent transparent transparent;
  }
  .ct-envelope__corner--tr {
    top: 0; right: 0;
    border-width: 0 30px 30px 0;
    border-color: transparent var(--ct-blue) transparent transparent;
  }
  .ct-envelope__corner--bl {
    bottom: 0; left: 0;
    border-width: 30px 0 0 30px;
    border-color: transparent transparent transparent var(--ct-blue);
  }
  .ct-envelope__corner--br {
    bottom: 0; right: 0;
    border-width: 0 0 30px 30px;
    border-color: transparent transparent var(--ct-red) transparent;
  }

  /* TELEGRAMA marquee */
  .ct-telegram {
    background: var(--ct-ink);
    color: var(--ct-paper);
    overflow: hidden;
    padding: 1rem 0;
    border-top: 3px solid var(--ct-ink);
    position: relative;
  }
  .ct-telegram::before, .ct-telegram::after {
    content: '★';
    position: absolute; top: 50%; transform: translateY(-50%);
    color: var(--ct-yellow);
    font-size: 1.5rem;
    z-index: 2;
  }
  .ct-telegram::before { left: 1rem; }
  .ct-telegram::after  { right: 1rem; }
  .ct-telegram__track {
    display: flex; gap: 4rem; width: max-content;
    animation: marquee 40s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-weight: 700;
  }
  .ct-telegram__item {
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* CANALES                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .ct-channels-section { background: var(--brutal-bg); }
  .ct-channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  @media (min-width: 768px) { .ct-channels { grid-template-columns: repeat(3, 1fr); } }
  .ct-channel {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--ct-paper);
    border: 2.5px solid var(--ct-ink);
    box-shadow: var(--ct-shadow);
    padding: 1.5rem;
    text-decoration: none;
    color: var(--ct-ink);
    transition: transform .25s, box-shadow .25s;
    overflow: hidden;
  }
  .ct-channel:hover {
    transform: translate(-4px, -4px);
    box-shadow: 14px 14px 0 0 var(--ct-ink);
  }
  .ct-channel--mint { background: var(--ct-mint); }
  .ct-channel--lime { background: var(--ct-lime); }
  .ct-channel--cyan { background: var(--ct-cyan); }
  .ct-channel__head {
    display: flex; justify-content: space-between; align-items: center;
    gap: .5rem;
    padding-bottom: .75rem;
    border-bottom: 2px solid var(--ct-ink);
    margin-bottom: 1rem;
  }
  .ct-channel__num {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1;
  }
  .ct-channel__label {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    font-weight: 700;
  }
  .ct-channel__live { display: flex; align-items: center; }
  .ct-channel__live .live-dot { background: var(--ct-ink); }
  .ct-channel__icon {
    width: 64px; height: 64px;
    margin: 0 0 1rem;
  }
  .ct-channel__body { flex: 1; }
  .ct-channel__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1;
    letter-spacing: -.025em;
    margin-bottom: .35rem;
  }
  .ct-channel__meta {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ct-ink);
    opacity: .75;
    margin-bottom: 1rem;
  }
  .ct-channel__hint {
    font-size: .92rem;
    line-height: 1.4;
    color: var(--ct-ink);
    opacity: .85;
  }
  .ct-channel__foot {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px dashed var(--ct-ink);
  }
  .ct-channel__cta {
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .15em;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* FORMULARIO                                              */
  /* ═══════════════════════════════════════════════════════ */
  .ct-form-section {
    padding: 6rem 1.5rem;
    background: var(--ct-paper-2);
    border-block: 3px solid var(--ct-ink);
    position: relative;
  }
  .ct-form-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(14,13,11,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(14,13,11,0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .ct-form-section > * { position: relative; }

  .ct-form-wrap {
    background: var(--ct-paper);
    border: 3px solid var(--ct-ink);
    box-shadow: 16px 16px 0 0 var(--ct-ink);
    margin-top: 2rem;
    position: relative;
    overflow: hidden;
  }
  .ct-form-doc-head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 2rem;
    background: var(--ct-ink);
    color: var(--ct-paper);
    border-bottom: 3px solid var(--ct-ink);
  }
  .ct-form-doc-head__l, .ct-form-doc-head__r { display: flex; flex-direction: column; gap: .25rem; }
  .ct-form-doc-head__r { text-align: right; align-items: flex-end; }
  .ct-form-doc-head__id {
    font-size: .7rem; letter-spacing: .2em;
    color: var(--ct-lime);
  }
  .ct-form-doc-head__title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: .1em;
    line-height: 1;
  }
  .ct-form-doc-head__stamp {
    display: inline-block;
    background: var(--ct-red);
    color: var(--ct-paper);
    padding: .25rem .55rem;
    font-family: var(--font-mono);
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 1.5px solid var(--ct-paper);
    transform: rotate(2deg);
  }
  .ct-form-doc-head__date {
    font-size: .75rem;
    letter-spacing: .15em;
    color: var(--ct-paper);
    opacity: .85;
  }
  .ct-form-side {
    position: absolute;
    top: 90px; right: -20px;
    transform: rotate(90deg);
    transform-origin: right top;
    display: flex; gap: .65rem;
    font-family: var(--font-mono);
    font-size: .55rem;
    letter-spacing: .25em;
    text-transform: uppercase;
    color: var(--ct-ink);
    opacity: .5;
    pointer-events: none;
    z-index: 1;
  }
  @media (max-width: 768px) { .ct-form-side { display: none; } }

  .ct-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem 2rem 2.5rem;
  }
  @media (min-width: 768px) { .ct-form { padding: 2.5rem 3rem 3rem; } }

  .ct-fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ct-legend {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0;
    margin-bottom: .5rem;
  }
  .ct-legend__num {
    font-size: .85rem;
    font-weight: 800;
    color: var(--ct-red);
    letter-spacing: .15em;
  }
  .ct-legend__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -.01em;
    color: var(--ct-ink);
  }
  .ct-legend__line {
    flex: 1; height: 0;
    border-bottom: 2px dashed var(--ct-ink);
  }

  .ct-row {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .ct-row--2 { grid-template-columns: 1fr 1fr; } }

  .ct-field {
    display: flex;
    flex-direction: column;
    gap: .3rem;
  }
  .ct-field__label {
    font-family: var(--font-display);
    font-size: .92rem;
    font-weight: 700;
    color: var(--ct-ink);
    line-height: 1;
  }
  .ct-field__req { color: var(--ct-red); margin-left: .15rem; }
  .ct-field__hint {
    font-size: .62rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--ct-blue);
    opacity: .7;
    margin-bottom: .35rem;
  }

  .ct-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--ct-ink);
    padding: .65rem .25rem .5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ct-ink);
    transition: border-color .2s, padding .2s, background .2s;
  }
  .ct-input::placeholder {
    color: var(--ct-ink);
    opacity: .35;
  }
  .ct-input:focus {
    outline: none;
    background: var(--ct-cream);
    padding-left: .65rem;
    padding-right: .65rem;
    border-bottom-color: var(--ct-red);
  }
  .ct-input--area {
    border: 2px solid var(--ct-ink);
    padding: .85rem 1rem;
    background:
      linear-gradient(transparent calc(1.6rem - 1px), rgba(14,13,11,0.12) calc(1.6rem - 1px), rgba(14,13,11,0.12) 1.6rem, transparent 1.6rem) 0 0/100% 1.6rem;
    line-height: 1.6rem;
    resize: vertical;
    min-height: 8rem;
  }
  .ct-input--area:focus {
    background:
      linear-gradient(transparent calc(1.6rem - 1px), rgba(220,27,44,0.25) calc(1.6rem - 1px), rgba(220,27,44,0.25) 1.6rem, transparent 1.6rem) 0 0/100% 1.6rem,
      var(--ct-paper);
    padding-left: 1rem;
    padding-right: 1rem;
  }

  /* Chips */
  .ct-chips {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: .35rem;
  }
  .ct-chips input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .ct-chips label {
    cursor: pointer;
    padding: .55rem .85rem;
    background: var(--ct-paper);
    border: 2px solid var(--ct-ink);
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ct-ink);
    display: inline-flex; align-items: center; gap: .5rem;
    transition: background .2s, color .2s, transform .15s, box-shadow .15s;
  }
  .ct-chips label:hover {
    background: var(--ct-cream);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 var(--ct-ink);
  }
  .ct-chips input[type="radio"]:checked + label {
    background: var(--ct-ink);
    color: var(--ct-lime);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ct-red);
  }
  .ct-chips--service label { padding: .65rem 1rem; font-size: .78rem; }
  .ct-chip-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--ct-ink);
    display: inline-block;
  }
  .ct-chip-dot--green   { background: #00FF94; }
  .ct-chip-dot--red     { background: var(--ct-red); }
  .ct-chip-dot--blue    { background: var(--ct-blue); }
  .ct-chip-dot--magenta { background: var(--ct-magenta); }
  .ct-chip-dot--cyan    { background: var(--ct-cyan); }
  .ct-chip-dot--ink     { background: var(--ct-ink); }
  .ct-chips input[type="radio"]:checked + label .ct-chip-dot { border-color: var(--ct-lime); }

  /* Checkbox */
  .ct-check {
    display: flex; align-items: flex-start; gap: .85rem;
    cursor: pointer;
    padding: .85rem 1rem;
    background: var(--ct-cream);
    border: 2px solid var(--ct-ink);
    margin-top: 1rem;
  }
  .ct-check input[type="checkbox"] {
    position: absolute; opacity: 0; pointer-events: none;
  }
  .ct-check__box {
    width: 22px; height: 22px;
    border: 2px solid var(--ct-ink);
    background: var(--ct-paper);
    flex-shrink: 0;
    position: relative;
    margin-top: 2px;
  }
  .ct-check input[type="checkbox"]:checked + .ct-check__box::after {
    content: '✓';
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800;
    color: var(--ct-red);
    font-size: 1.1rem;
  }
  .ct-check__txt { font-size: .9rem; line-height: 1.4; color: var(--ct-ink); }

  /* Footer del form */
  .ct-form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 3px solid var(--ct-ink);
    padding-top: 1.5rem;
    margin-top: .5rem;
  }
  .ct-form-foot__legal {
    display: flex; align-items: center; gap: .85rem;
    max-width: 36ch;
  }
  .ct-form-foot__sello {
    background: var(--ct-blue);
    color: var(--ct-paper);
    padding: .25rem .5rem;
    font-size: .65rem;
    letter-spacing: .2em;
    border: 1.5px solid var(--ct-ink);
    box-shadow: 2px 2px 0 var(--ct-ink);
  }
  .ct-form-foot__txt {
    font-size: .8rem;
    line-height: 1.45;
    color: var(--ct-ink);
    opacity: .8;
  }

  .ct-submit {
    position: relative;
    background: var(--ct-ink);
    color: var(--ct-paper);
    border: 3px solid var(--ct-ink);
    padding: 1.25rem 2rem 1.25rem 2.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -.01em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    box-shadow: var(--ct-shadow);
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
  }
  .ct-submit:hover {
    background: var(--ct-red);
    color: var(--ct-paper);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 0 var(--ct-ink);
  }
  .ct-submit__arrow { font-family: var(--font-mono); font-size: 1.5rem; }
  .ct-submit__stamp {
    position: absolute;
    top: -28px; right: -28px;
    width: 70px; height: 70px;
    color: var(--ct-lime);
    transform: rotate(-15deg);
    transition: transform .4s;
    animation: ct-stamp-spin 20s linear infinite;
  }
  .ct-submit:hover .ct-submit__stamp {
    transform: rotate(360deg);
    color: var(--ct-yellow);
    animation: none;
  }
  @keyframes ct-stamp-spin { to { transform: rotate(345deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* DISPATCH BOARD                                          */
  /* ═══════════════════════════════════════════════════════ */
  .ct-dispatch-section {
    background: var(--ct-ink);
    color: var(--ct-paper);
    padding: 6rem 1.5rem;
    border-block: 3px solid var(--ct-ink);
  }
  .ct-dispatch-head {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .ct-dispatch-h2 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .92;
    letter-spacing: -.04em;
    color: var(--ct-paper);
    margin: 1rem 0 0;
  }
  .ct-dispatch-clock {
