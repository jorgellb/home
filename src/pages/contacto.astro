---
import Sitio from '../layouts/Sitio.astro';
import Migas from '../components/sitio/Migas.astro';
import Icono, { type NombreIcono } from '../components/sitio/Icono.astro';
import Ilustracion from '../components/sitio/Ilustracion.astro';
import Formulario from '../components/sitio/Formulario.astro';
import Preguntas from '../components/sitio/Preguntas.astro';
import { CONTACTO } from '../data/navegacion';
import { PROVEEDOR, SITE } from '../data/negocio';

const canales: { icono: NombreIcono; t: string; d: string; href: string; accion: string; externo?: boolean }[] = [
  { icono: 'whatsapp', t: 'WhatsApp', d: 'La vía más rápida. Mándanos un audio o una foto de lo que tienes.', href: `${CONTACTO.whatsapp}?text=${encodeURIComponent('Hola, quería consultaros una cosa')}`, accion: 'Abrir WhatsApp', externo: true },
  { icono: 'telefono', t: 'Teléfono', d: 'De lunes a viernes en horario de oficina. Si no lo cogemos, te llamamos.', href: CONTACTO.telefonoHref, accion: CONTACTO.telefono },
  { icono: 'email', t: 'Email', d: 'Para enviar documentos, referencias o una explicación larga.', href: `mailto:${CONTACTO.email}`, accion: CONTACTO.email },
];

const despues = [
  { t: 'Te respondemos', d: 'En menos de 4 horas laborables, con preguntas concretas sobre tu caso.' },
  { t: 'Hablamos media hora', d: 'Por teléfono, videollamada o en el estudio de Vera. Sin compromiso.' },
  { t: 'Recibes la propuesta', d: 'Por escrito: qué haremos, en qué plazo y qué incluye. Sin letra pequeña.' },
];

const preguntas = [
  { q: '¿La primera consulta tiene coste?', a: '<p>No. La llamada inicial y la propuesta son gratis y no te comprometen a nada. Si vemos que no somos lo que necesitas, te lo decimos y te orientamos hacia quien sí lo sea.</p>' },
  { q: '¿Puedo ir al estudio?', a: `<p>Sí, con cita. Estamos en ${CONTACTO.direccion}. Escríbenos antes para asegurarnos de que hay alguien del equipo.</p>` },
  { q: '¿Trabajáis con negocios fuera de Almería?', a: '<p>Sí. La mayoría de nuestros clientes son de la provincia, pero trabajamos en remoto con negocios de toda España. Para informática presencial, cubrimos el Levante y el Almanzora.</p>' },
  { q: '¿Qué necesitáis para daros un plazo?', a: '<p>Saber qué hace tu negocio, qué quieres conseguir y si ya tienes web, dominio o logotipo. Con eso te damos un plazo realista en la propuesta.</p>' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto',
  url: `${SITE}/contacto/`,
  mainEntity: PROVEEDOR,
};
---

<Sitio
  title="Contacto: cuéntanos tu proyecto"
  description="Escríbenos por WhatsApp, teléfono o formulario. Respondemos en menos de 4 horas laborables y la primera consulta es gratis. Estudio en Vera, Almería."
  canonical={`${SITE}/contacto/`}
  jsonLd={jsonLd}
>
  <section class="cabeza">
    <div class="contenedor cabeza__rejilla">
      <div class="cabeza__texto">
        <Migas items={[{ nombre: 'Contacto' }]} />
        <p class="antetitulo">Contacto</p>
        <h1>Cuéntanos qué necesitas. <span class="subrayado">Te respondemos hoy.</span></h1>
        <p class="entradilla">
          Hablas directamente con quien hará el trabajo: sin comerciales ni centralitas. Si no somos lo que buscas, te lo
          diremos igual.
        </p>
      </div>
      <Ilustracion nombre="contacto" class="cabeza__ilustracion" />
    </div>
  </section>

  <section class="contenedor canales" aria-label="Formas de contacto">
    {canales.map((c) => (
      <a href={c.href} class="canal" {...(c.externo ? { target: '_blank', rel: 'noopener' } : {})}>
        <span class="canal__icono"><Icono nombre={c.icono} tamano={22} /></span>
        <h2>{c.t}</h2>
        <p>{c.d}</p>
        <span class="canal__accion">{c.accion} <Icono nombre="flecha" tamano={16} /></span>
      </a>
    ))}
  </section>

  <section class="seccion" id="formulario" aria-labelledby="formulario-titulo">
    <div class="contenedor formulario-rejilla">
      <div class="formulario-caja">
        <h2 id="formulario-titulo">Escríbenos</h2>
        <p class="formulario-intro">Con tres líneas nos basta para empezar. Los campos con * son obligatorios.</p>
        <Formulario />
      </div>
      <aside class="lateral">
        <div class="lateral__bloque">
          <h3>Qué pasa después</h3>
          <ol class="despues">
            {despues.map((p, i) => (
              <li>
                <span class="despues__num">{i + 1}</span>
                <div><b>{p.t}</b><p>{p.d}</p></div>
              </li>
            ))}
          </ol>
        </div>
        <div class="lateral__bloque">
          <h3>Estudio</h3>
          <p class="direccion"><Icono nombre="ubicacion" /> {CONTACTO.direccion}</p>
          <a class="mapa" href="https://maps.google.com/?q=Ctra+de+Ronda+82+Vera+Almeria" target="_blank" rel="noopener">Cómo llegar <Icono nombre="flecha" tamano={16} /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="seccion seccion--blanca" aria-labelledby="preguntas-titulo">
    <div class="contenedor dos-columnas">
      <div>
        <p class="antetitulo">Preguntas</p>
        <h2 id="preguntas-titulo" class="preguntas-titulo">Antes de escribirnos</h2>
      </div>
      <Preguntas preguntas={preguntas} />
    </div>
  </section>
</Sitio>

<style>
  .cabeza {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) 2.5rem;
  }
  .cabeza__rejilla {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .cabeza__texto {
    display: grid;
    gap: 1.25rem;
  }
  .cabeza h1 {
    font-size: var(--t-3xl);
    max-width: 20ch;
  }
  .cabeza :global(.cabeza__ilustracion) {
    max-width: 340px;
    justify-self: center;
  }
  @media (min-width: 900px) {
    .cabeza__rejilla {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  .canales {
    display: grid;
    gap: 1rem;
  }
  .canal {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: var(--radio-l);
    border: 1px solid var(--linea);
    background: var(--superficie);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .canal:hover {
    border-color: var(--verde);
    transform: translateY(-2px);
  }
  .canal__icono {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.4rem;
    border-radius: 12px;
    background: var(--platano-suave);
    color: var(--verde);
  }
  .canal h2 {
    font-size: var(--t-l);
  }
  .canal p {
    color: var(--tinta-2);
    font-size: var(--t-s);
  }
  .canal__accion {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    color: var(--verde);
    font-weight: 680;
  }
  @media (min-width: 800px) {
    .canales {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .formulario-rejilla {
    display: grid;
    gap: 2rem;
  }
  .formulario-caja {
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border-radius: calc(var(--radio-l) * 1.25);
    border: 1px solid var(--linea);
    background: var(--superficie);
    box-shadow: var(--sombra);
  }
  .formulario-caja h2 {
    font-size: var(--t-2xl);
  }
  .formulario-intro {
    margin: 0.5rem 0 2rem;
    color: var(--tinta-2);
  }
  .lateral {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  .lateral__bloque h3 {
    font-size: var(--t-l);
    margin-bottom: 1rem;
  }
  .despues {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  .despues li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
  }
  .despues__num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--verde);
    color: #fff;
    font-weight: 750;
    font-size: var(--t-s);
  }
  .despues p,
  .direccion {
    color: var(--tinta-2);
    font-size: var(--t-s);
  }
  .direccion {
    display: flex;
    gap: 0.5rem;
  }
  .direccion :global(.icono) {
    color: var(--verde);
    margin-top: 0.15rem;
  }
  .mapa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    color: var(--verde);
    font-weight: 680;
  }
  @media (min-width: 1000px) {
    .formulario-rejilla {
      grid-template-columns: 1.6fr 1fr;
      gap: 3.5rem;
    }
    .lateral {
      position: sticky;
      top: 6rem;
    }
  }
  .dos-columnas {
    display: grid;
    gap: 1.5rem;
  }
  .preguntas-titulo {
    font-size: var(--t-2xl);
    margin-top: 1rem;
  }
  @media (min-width: 960px) {
    .dos-columnas {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
    }
  }
</style>
