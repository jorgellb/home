---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Relacionados from '../components/cdm/Relacionados.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import Boton from '../components/cdm/Boton.astro';
import SonidoMarca from '../components/sonido/SonidoMarca.tsx';

const title = 'Sonido de Marca con IA: Logo Sonoro';
const description =
  'Demo de IA: escribe tu marca y un compositor de IA crea tu logo sonoro y un mini-jingle, sintetizados en el navegador y descargables en WAV.';
const canonical = 'https://platanitorico.com/sonido-marca/';

const feats = [
  { ico: '🎼', t: 'Composición con IA', d: 'Escala, tempo, instrumento y melodía pensados para tu marca.' },
  { ico: '🔊', t: 'Síntesis en vivo', d: 'Se genera el audio en tu navegador, con timbres y reverb.' },
  { ico: '🎵', t: 'Logo + jingle', d: 'Un motivo corto memorable y un mini-jingle con acordes.' },
  { ico: '⬇️', t: 'Descarga en WAV', d: 'Te llevas el audio listo para tus vídeos y redes.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: 'Sonido de Marca con IA', applicationCategory: 'MultimediaApplication', operatingSystem: 'Web',
    url: canonical, description, offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://platanitorico.com/' },
      { '@type': 'ListItem', position: 2, name: 'Laboratorio de IA', item: 'https://platanitorico.com/laboratorio-ia/' },
      { '@type': 'ListItem', position: 3, name: 'Sonido de Marca con IA', item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Sonido de Marca con IA - Platanito Rico"
  type="website"
  lang="es"
  keywords="sonic branding, logo sonoro, jingle IA, identidad sonora, audio marca, música IA Almería, branding sonoro"
  jsonLd={jsonLd}
>
  <Header />

  <Breadcrumb tono="consola" items={[
    { label: 'Inicio', href: '/' },
    { label: 'Laboratorio de IA', href: '/laboratorio-ia/' },
    { label: 'Sonido de Marca con IA' },
  ]} />

  <main id="main-content" class="sm">
    <section class="sm-hero">
      <div class="container-brutal sm-hero__inner">
        <span class="sm-eyebrow">✦ Demo en vivo · Audio IA</span>
        <h1 class="sm-hero__title">Sonido de <em>Marca</em></h1>
        <p class="sm-hero__lead">
          Las marcas no solo se ven: <strong>se escuchan</strong>. Escribe tu marca y un compositor de IA crea
          su <strong>identidad sonora</strong> —un logo sonoro y un mini-jingle—, sintetizados aquí mismo en tu
          navegador y listos para descargar.
        </p>
        <div class="sm-hero__chips">
          <span>🎼 Compone la IA</span><span>🔊 Suena al instante</span><span>⬇️ Descarga WAV</span>
        </div>
      </div>
    </section>

    <section class="sm-feats">
      <div class="container-brutal">
        <ul class="sm-feats__grid">
          {feats.map((s) => (
            <li class="sm-feat">
              <span class="sm-feat__ico" aria-hidden="true">{s.ico}</span>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sm-demo" id="demo">
      <div class="container-brutal">
        <header class="sm-sec-head">
          <span class="sm-eyebrow sm-eyebrow--dark">✦ Pruébalo ahora</span>
          <h2 class="sm-h2">Dale voz a tu marca.</h2>
        </header>
        <SonidoMarca client:only="react" />
        <noscript><p class="sm-noscript">Activa JavaScript para usar el Sonido de Marca.</p></noscript>
      </div>
    </section>

    <section class="sm-cta">
      <div class="container-brutal sm-cta__inner">
        <span class="sm-eyebrow">✦ ¿Suena bien?</span>
        <h2 class="sm-cta__title">Producimos tu sonido de marca de verdad.</h2>
        <p class="sm-cta__text">
          Logo sonoro, jingle y la música de tus vídeos, con calidad de estudio y coherentes con tu identidad
          visual. Que te reconozcan también con los ojos cerrados.
        </p>
        <div class="sm-cta__btns">
          <Boton href="/contacto/">Quiero mi sonido</Boton>
          <Boton href="/laboratorio-ia/" variante="linea">Ver más demos</Boton>
        </div>
      </div>
    </section>
  
    <Relacionados titulo="Sigue por aquí" columnas={3} items={[
      { href: '/diseno-grafico/', label: 'Diseño gráfico y branding', sub: 'La identidad completa, no solo el sonido' },
      { href: '/audiovisual/', label: 'Audiovisual', sub: 'Donde suena tu marca' },
      { href: '/laboratorio-ia/', label: 'Laboratorio de IA', sub: 'Las otras once demos' },
    ]} />
</main>

  <Footer />
</BaseLayout>

<style>
  .sm { background: var(--color-cdm-suelo); color: var(--color-cdm-texto); }
  .sm-eyebrow { display: inline-block; font-family: var(--font-mono, monospace); font-size: .66rem; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: #c6ff3a; }
  .sm-eyebrow--dark { color: #B83E0B; }

  .sm-hero {
    padding: 4rem 0 2.5rem;
    background: radial-gradient(90% 60% at 50% -10%, rgba(198,255,58,0.16) 0%, transparent 60%), linear-gradient(180deg, var(--color-cdm-panel), var(--color-cdm-suelo));
    border-bottom: 1px solid var(--color-cdm-regla); position: relative; overflow: hidden;
  }
  .sm-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(#c6ff3a12 1px, transparent 1px), linear-gradient(90deg, #c6ff3a12 1px, transparent 1px);
    background-size: 30px 30px; mask-image: radial-gradient(70% 60% at 50% 0%, #000 0%, transparent 75%);
  }
  .sm-hero__inner { position: relative; }
  .sm-hero__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.5rem, 8vw, 5rem); font-weight: 800; line-height: .95; letter-spacing: -.04em; margin: 1rem 0; color: var(--color-cdm-texto); }
  .sm-hero__title em { font-style: normal; color: #c6ff3a; }
  .sm-hero__lead { font-size: clamp(1.05rem, 2.4vw, 1.3rem); line-height: 1.5; color: #b9c5cf; max-width: 62ch; margin: 0 0 1.5rem; }
  .sm-hero__lead strong { color: var(--color-cdm-texto); }
  .sm-hero__chips { display: flex; flex-wrap: wrap; gap: .6rem; }
  .sm-hero__chips span { font-family: var(--font-mono, monospace); font-size: .72rem; padding: .45rem .8rem; border: 1px solid var(--color-cdm-regla); border-radius: 0; color: #b9c5cf; background: var(--color-cdm-panel-2); }

  .sm-feats { padding: 2.5rem 0; background: var(--color-cdm-panel); border-bottom: 1px solid var(--color-cdm-regla); }
  .sm-feats__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: .8rem; }
  @media (min-width: 560px) { .sm-feats__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .sm-feats__grid { grid-template-columns: repeat(4, 1fr); } }
  .sm-feat { background: var(--color-cdm-panel-2); border: 1.5px solid var(--color-cdm-regla); border-radius: 0; padding: 1.1rem 1rem; }
  .sm-feat__ico { font-size: 1.5rem; }
  .sm-feat b { display: block; margin: .5rem 0 .3rem; color: var(--color-cdm-texto); font-size: .98rem; }
  .sm-feat span { font-size: .8rem; line-height: 1.4; color: #b9c5cf; }

  /* Placa clara: la isla está diseñada sobre papel y su lógica no se toca. */
  .sm-demo { padding: 3.5rem 0; background: #F5F1EA; color: #0E0D0B; border-block: 1px solid var(--color-cdm-regla-2); }
  .sm-noscript { text-align: center; color: #6a6258; margin-top: 1.5rem; }
  .sm-sec-head { text-align: center; max-width: 60ch; margin: 0 auto 2rem; }
  .sm-h2 { font-family: var(--font-display, sans-serif); font-size: clamp(1.9rem, 5vw, 3rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin: .6rem 0 0; }

  .sm-cta { padding: 4.5rem 0; background: radial-gradient(80% 100% at 50% 0%, rgba(198,255,58,0.14) 0%, transparent 60%), var(--color-cdm-suelo); border-top: 1px solid var(--color-cdm-regla); }
  .sm-cta__inner { max-width: 720px; }
  .sm-cta__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.2rem, 6vw, 4rem); font-weight: 800; letter-spacing: -.04em; line-height: .95; margin: .6rem 0 1rem; color: var(--color-cdm-texto); }
  .sm-cta__text { font-size: 1.05rem; line-height: 1.55; color: #b9c5cf; margin: 0 0 2rem; }
  .sm-cta__btns { display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
