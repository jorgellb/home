---
/* Hub de tecnología. Es la página que de verdad tiene demanda: "programador
   WordPress Almería" es una consulta provincial plausible, mientras que la
   misma consulta con un municipio de 5.000 habitantes probablemente no se
   busca nunca. Por eso el hub lleva el contenido sustancial y las locales
   solo existen donde aportan algo propio.
   `apps` no entra aquí: vive en /desarrollo-aplicaciones-moviles/ porque su
   intención no es "programador web". */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import Seccion from '../../../components/programador/Seccion.astro';
import Marco from '../../../components/programador/Marco.astro';
import Esquema from '../../../components/programador/Esquema.astro';
import Diff from '../../../components/programador/Diff.astro';
import Servicios from '../../../components/programador/Servicios.astro';
import Enlaces from '../../../components/programador/Enlaces.astro';
import Faq from '../../../components/programador/Faq.astro';
import Cta from '../../../components/programador/Cta.astro';
import { TECNOLOGIAS, ORDEN_TECNOLOGIAS, rutaTecnologia, rutaLocal, type SlugTecnologia } from '../../../data/tecnologias';
import { territorioDe } from '../../../data/territorio';
import { matriz } from '../../../data/programador-gate';
import { SITE, PROVEEDOR } from '../../../data/negocio';

export function getStaticPaths() {
  return ORDEN_TECNOLOGIAS
    .filter((t) => t !== 'apps')
    .map((tecnologia) => ({ params: { tecnologia } }));
}

const { tecnologia } = Astro.params as { tecnologia: SlugTecnologia };
const t = TECNOLOGIAS[tecnologia];
const canonical = `${SITE}${rutaTecnologia(tecnologia)}`;

/* Se enlazan TODAS las locales que existen, indexables o no. Una página
   generada que nadie enlaza es una huérfana: no la encuentra ni una persona ni
   un rastreador, y entonces no hay motivo para haberla generado. Que estén en
   noindex no las hace inútiles para quien navega; solo las saca del índice.
   Se ordenan por cercanía a la base y se marcan las que tienen materia propia,
   que son las que de verdad merecen la visita. */
const veredictos = new Map(
  matriz()
    .filter((c) => c.tecnologia === tecnologia)
    .map((c) => [c.municipio, c.veredicto]),
);
const locales = [...veredictos.keys()]
  .map((slug) => ({ t: territorioDe(slug), v: veredictos.get(slug)! }))
  .filter((x): x is { t: NonNullable<ReturnType<typeof territorioDe>>; v: typeof x.v } => x.t !== null)
  /* La capital no tiene local: su página es este mismo hub. */
  .filter((x) => x.t.slug !== 'almeria')
  .sort((a, b) => (a.t.kmDesdeBase ?? 9999) - (b.t.kmDesdeBase ?? 9999));

const relacionadas = t.relacionadas.map((r) => TECNOLOGIAS[r]);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': `Desarrollo con ${t.nombre}`,
    'serviceType': t.intencion,
    'url': canonical,
    'provider': PROVEEDOR,
    'areaServed': { '@type': 'AdministrativeArea', 'name': 'Provincia de Almería' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': t.faq.map((f) => ({
      '@type': 'Question',
      'name': f.q,
      'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
    })),
  },
];
---

<BaseLayout title={t.title} description={t.description} canonical={canonical} jsonLd={jsonLd}>
  <Header />
  <Marco>
  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Programador web', href: '/programador-web/' },
    { label: t.etiqueta },
  ]} />

  <section class="hero">
    <div class="container-brutal hero__in">
      <div class="hero__txt">
        <p class="pw-ref">{`tec.${tecnologia}`}</p>
        <h1 class="hero__h1">{t.h1}</h1>
        <p class="hero__lead">{t.entradilla}</p>
        <p class="hero__para">Para <strong>{t.distintivo}</strong>.</p>
      </div>
      <Esquema tecnologia={tecnologia} class="hero__esq" />
    </div>
  </section>

  <Seccion
    ref="01 · encargos"
    titulo={`Cómo llegan los encargos de desarrollo ${t.etiqueta}`}
    lead="Redactados como problemas, no como especificaciones. Arriba lo que pasa hoy; debajo, en qué queda."
    tono="panel"
  >
    <Diff situaciones={t.situaciones} />
  </Seccion>

  <Seccion ref="02 · repertorio" titulo={`Qué desarrollamos con ${t.nombre}`}>
    <Servicios servicios={t.servicios} />
  </Seccion>

  {locales.length > 0 && (
    <Seccion
      ref="03 · zona"
      titulo={`${t.etiqueta} por municipio`}
      lead={`Damos servicio en toda la provincia desde Vera. Bajo cada municipio está lo que allí se mueve y encaja con ${t.nombre}.`}
      tono="panel"
    >
      <Enlaces enlaces={locales.map((m) => ({
        href: rutaLocal(tecnologia, m.t.slug),
        texto: m.t.nombre,
        sub: m.v.encajes.length
          ? m.v.encajes.map((e) => e.sector.toLowerCase()).slice(0, 2).join(' · ')
          : m.t.comarca,
      }))} />
    </Seccion>
  )}

  <Seccion ref="04 · alrededor" titulo="Tecnologías relacionadas" lead="Con lo que se combina de verdad, no con todo lo que suene parecido.">
    <Enlaces columnas={2} enlaces={[
      ...relacionadas.map((r) => ({
        href: rutaTecnologia(r.slug),
        texto: `Desarrollo con ${r.etiqueta}`,
        sub: `Para ${r.distintivo}.`,
      })),
      ...t.serviciosWeb.map((href) => ({
        href,
        texto: href === '/soporte/' ? 'Mantenimiento web'
          : href === '/desarrollo-web/' ? 'Diseño y desarrollo web'
          : href === '/informatica-empresas/' ? 'Sistemas e informática'
          : href === '/ia-empresas/' ? 'IA para empresas'
          : href === '/soluciones/ecommerce/' ? 'Tiendas online'
          : 'Auditoría web',
        sub: 'Servicio relacionado',
      })),
    ]} />
  </Seccion>

  <Seccion ref="05 · dudas" titulo="Preguntas frecuentes" tono="panel">
    <Faq faq={t.faq} />
  </Seccion>

  <Cta
    titulo={`Cuéntame qué necesitas hacer con ${t.nombre}`}
    texto={t.situaciones[0].encargo.replace(/\.$/, '')
      + ' — si tu caso se parece a eso, con describirlo suele bastar para saber si tiene arreglo y cuánto trabajo es.'}
    servicio={`Desarrollo ${t.etiqueta}`}
  />
  </Marco>
  <Footer />
</BaseLayout>

<style>
  .hero { padding: clamp(2rem, 5vw, 3.25rem) 0 clamp(2.5rem, 5vw, 3.5rem); }
  .hero__in { display: grid; gap: clamp(1.75rem, 4vw, 3rem); align-items: center; }
  .hero__h1 {
    font-size: clamp(2rem, 5.2vw, 3.2rem); font-weight: 800;
    letter-spacing: -.04em; line-height: 1.02; margin: .4rem 0 1.1rem;
  }
  .hero__lead { max-width: 52ch; font-size: 1.07rem; line-height: 1.65; margin: 0 0 .9rem; }
  .hero__para { margin: 0; color: var(--pw-tenue); font-size: .95rem; }
  .hero__para strong { color: var(--pw-luego); font-weight: 600; }
  @media (min-width: 960px) {
    .hero__in { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
  }
</style>
