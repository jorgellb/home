<style>
  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · GARRUCHA · PUERTO PESQUERO                     */
  /* ═══════════════════════════════════════════════════════ */
  .gr {
    --gr-paper:    #FFFBF0;
    --gr-paper-2:  #F4EBD8;
    --gr-sand:     #E8DCC0;
    --gr-ink:      #0E0D0B;
    --gr-gamba:    #D9342C;      /* rojo gamba */
    --gr-gamba-d:  #8E1F1A;
    --gr-navy:     #0A3D62;      /* mar profundo */
    --gr-navy-d:   #062841;
    --gr-copper:   #B87333;      /* cobre · cuerdas */
    --gr-cuerda:   #C8A87C;      /* yute */
    --gr-plata:    #9FB4C1;      /* pescado plata */
    --gr-lima:     #D6FF44;      /* brand */
    --gr-sun:      #FFD600;      /* faro */
    --gr-shadow:   8px 8px 0 var(--gr-ink);
  }
  .gr-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--gr-gamba);
    box-shadow: 0 0 0 0 rgba(217,52,44,0.55);
    animation: gr-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes gr-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(217,52,44,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(217,52,44,0); }
    100% { box-shadow: 0 0 0 0 rgba(217,52,44,0); }
  }
  .gr-spin { transform-origin: 50% 50%; animation: gr-spin 26s linear infinite; }
  @keyframes gr-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .gr-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(10,61,98,0.10), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(217,52,44,0.10), transparent 50%),
      var(--gr-paper);
    border-bottom: 3px solid var(--gr-ink);
    position: relative;
    overflow: hidden;
  }
  .gr-hero::before {
    /* Red de pescador sutil */
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(45deg, transparent 0 22px, rgba(184,115,51,0.06) 22px 23px, transparent 23px 44px),
      linear-gradient(-45deg, transparent 0 22px, rgba(184,115,51,0.06) 22px 23px, transparent 23px 44px);
    pointer-events: none;
  }
  .gr-hero > * { position: relative; }
  .gr-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .gr-hero__status { color: var(--gr-gamba); font-weight: 700; }

  .gr-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 1024px) { .gr-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .gr-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .gr-hero__chapter { color: var(--gr-navy); }
  .gr-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .gr-hero__title em { color: var(--gr-navy); font-style: italic; }
  .gr-hero__title-stamp {
    display: inline-block;
    color: var(--gr-paper);
    background: var(--gr-gamba);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }

  .gr-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 54ch;
  }
  .gr-hero__lead strong { color: var(--gr-ink); font-weight: 700; }
  .gr-hero__lead em { color: var(--gr-gamba); font-style: italic; font-weight: 600; }

  .gr-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }
  .gr-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--gr-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .gr-btn--primary {
    background: var(--gr-gamba);
    color: var(--gr-paper);
    box-shadow: 6px 6px 0 var(--gr-ink);
  }
  .gr-btn--primary:hover {
    background: var(--gr-navy);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--gr-ink);
  }
  .gr-btn--ghost {
    background: transparent;
    color: var(--gr-ink);
    box-shadow: 6px 6px 0 var(--gr-navy);
  }
  .gr-btn--ghost:hover {
    background: var(--gr-ink);
    color: var(--gr-sun);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--gr-navy);
  }

  /* KPIs */
  .gr-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--gr-ink);
    background: var(--gr-ink);
  }
  @media (min-width: 768px) { .gr-kpis { grid-template-columns: repeat(4, 1fr); } }
  .gr-kpi {
    background: var(--gr-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--gr-ink);
    border-bottom: 2px solid var(--gr-ink);
  }
  .gr-kpi:nth-child(2n) { border-right: none; }
  .gr-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .gr-kpi:nth-child(2n)      { border-right: 2px solid var(--gr-ink); }
    .gr-kpi:nth-child(4n)      { border-right: none; }
    .gr-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--gr-ink); }
    .gr-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .gr-kpi--gamba  { background: var(--gr-gamba); color: var(--gr-paper); }
  .gr-kpi--navy   { background: var(--gr-navy); color: var(--gr-paper); }
  .gr-kpi--copper { background: var(--gr-copper); color: var(--gr-paper); }
  .gr-kpi--ink    { background: var(--gr-ink); color: var(--gr-paper); }
  .gr-kpi--ink .gr-kpi__v { color: var(--gr-sun); }
  .gr-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .gr-kpi__v small { font-size: .55em; opacity: .8; }
  .gr-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .gr-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(14,13,11,0.18));
  }
  .gr-postcard {
    background: var(--gr-paper);
    border: 3px solid var(--gr-ink);
    box-shadow: var(--gr-shadow);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .35s;
  }
  .gr-postcard:hover { transform: rotate(0); }
  .gr-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--gr-navy);
    color: var(--gr-paper);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--gr-ink);
  }
  .gr-postcard__profile {
    width: 100%;
    aspect-ratio: 540 / 220;
    border-bottom: 2px solid var(--gr-ink);
    overflow: hidden;
  }
  .gr-postcard__img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid var(--gr-ink);
  }
  .gr-postcard__img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(1.1);
    transition: transform .6s cubic-bezier(.16,1,.3,1);
  }
  .gr-postcard:hover .gr-postcard__img { transform: scale(1.05); }
  .gr-postcard__anchor {
    position: absolute;
    top: 12px; right: 12px;
    width: 80px; height: 80px;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 10px rgba(10,61,98,0.4));
  }
  .gr-postcard__tag {
    position: absolute;
    bottom: 12px; left: 12px;
    background: var(--gr-paper);
    color: var(--gr-ink);
    padding: .4rem .75rem;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 2px solid var(--gr-ink);
    box-shadow: 3px 3px 0 var(--gr-gamba);
    transform: rotate(-2deg);
  }
  .gr-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--gr-paper-2);
    display: grid; gap: .35rem;
  }
  .gr-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
    font-size: .68rem;
  }
  .gr-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .gr-postcard__data-row > span:first-child { color: var(--gr-navy); letter-spacing: .2em; font-weight: 800; }
  .gr-postcard__data-v { color: var(--gr-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .gr-marquee {
    background: var(--gr-navy);
    color: var(--gr-sun);
    overflow: hidden;
    padding: .9rem 0;
    border-top: 3px solid var(--gr-ink);
  }
  .gr-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: gr-marquee 36s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  @keyframes gr-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* GAMBA ROJA SECTION                                      */
  /* ═══════════════════════════════════════════════════════ */
  .gr-gamba-section {
    background: var(--gr-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--gr-ink);
    position: relative;
    overflow: hidden;
  }
  .gr-gamba-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(217,52,44,0.05) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .gr-gamba-section > * { position: relative; }
  .gr-gamba-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .gr-gamba-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }

  .gr-gamba-chapter { color: var(--gr-gamba); }
  .gr-gamba-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0;
  }
  .gr-gamba-title em { color: var(--gr-gamba); }
  .gr-gamba-lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 54ch;
  }
  .gr-gamba-lead strong { color: var(--gr-gamba-d); font-weight: 700; }
  .gr-gamba-lead em { color: var(--gr-navy); font-style: italic; }

  .gr-gamba-facts {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--gr-ink);
    background: var(--gr-paper);
  }
  @media (min-width: 640px) { .gr-gamba-facts { grid-template-columns: 1fr 1fr; } }
  .gr-gamba-facts li {
    padding: .85rem 1rem;
    border-bottom: 1px solid var(--gr-ink);
    display: flex; flex-direction: column; gap: 2px;
  }
  @media (min-width: 640px) {
    .gr-gamba-facts li:nth-child(odd) { border-right: 1px solid var(--gr-ink); }
    .gr-gamba-facts li:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .gr-gamba-facts li:last-child { border-bottom: none; }
  }
  .gr-gamba-facts__k { font-size: .58rem; letter-spacing: .2em; color: var(--gr-navy); font-weight: 800; }
  .gr-gamba-facts__v { font-size: .9rem; color: var(--gr-ink); font-weight: 600; line-height: 1.35; }
  .gr-gamba-facts__v em { color: var(--gr-gamba); font-style: italic; }

  .gr-gamba-r {
    max-width: 400px;
    margin: 0 auto;
  }
  .gr-gamba-anim {
    transform-origin: center;
    animation: gr-gamba-float 4s ease-in-out infinite;
  }
  @keyframes gr-gamba-float {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50%      { transform: translateY(-6px) rotate(1deg); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* LONJA                                                   */
  /* ═══════════════════════════════════════════════════════ */
  .gr-lonja-section {
    background: var(--gr-navy);
    color: var(--gr-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--gr-ink);
    position: relative;
    overflow: hidden;
  }
  .gr-lonja-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,214,0,0.06) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .gr-lonja-section > * { position: relative; }
  .gr-lonja {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) { .gr-lonja { grid-template-columns: 1.2fr 1fr; gap: 3rem; } }

  /* Lonja card mock */
  .gr-lonja-card {
    background: var(--gr-paper);
    color: var(--gr-ink);
    border: 3px solid var(--gr-sun);
    box-shadow: 12px 12px 0 var(--gr-sun);
  }
  .gr-lonja-card__head {
    display: flex; justify-content: space-between; align-items: center;
    padding: .85rem 1.25rem;
    background: var(--gr-ink);
    color: var(--gr-paper);
    border-bottom: 2px solid var(--gr-ink);
    font-size: .7rem;
    letter-spacing: .2em;
  }
  .gr-lonja-card__live {
    background: var(--gr-gamba);
    color: var(--gr-paper);
    padding: .2rem .5rem;
    font-weight: 800;
    border: 1px solid var(--gr-paper);
    animation: gr-blink 1.5s ease-in-out infinite;
  }
  @keyframes gr-blink { 50% { opacity: .55; } }
  .gr-lonja-card__rows { display: flex; flex-direction: column; }
  .gr-lonja-card__row {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px dashed var(--gr-ink);
  }
  .gr-lonja-card__row:last-child { border-bottom: none; }
  .gr-lonja-card__row--top {
    background: var(--gr-sun);
    border-bottom: 2px solid var(--gr-ink);
  }
  .gr-lonja-card__row--top .gr-lonja-card__lbl {
    grid-column: 1 / -1;
    font-size: .58rem;
    letter-spacing: .2em;
    color: var(--gr-gamba-d);
    font-weight: 800;
    margin-bottom: .25rem;
  }
  .gr-lonja-card__row--top .gr-lonja-card__species {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--gr-gamba);
    letter-spacing: -.02em;
  }
  .gr-lonja-card__row--top .gr-lonja-card__price {
    grid-column: 2 / -1;
    font-size: 2rem;
    font-weight: 800;
    color: var(--gr-gamba);
    text-align: right;
  }
  .gr-lonja-card__row--top {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
  }
  .gr-lonja-card__n { font-size: .7rem; color: var(--gr-navy); font-weight: 800; }
  .gr-lonja-card__species { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--gr-ink); }
  .gr-lonja-card__price { font-size: 1rem; font-weight: 800; color: var(--gr-navy); }
  .gr-lonja-card__price--small { font-size: .9rem; }
  .gr-lonja-card__foot {
    padding: .75rem 1.25rem;
    background: var(--gr-paper-2);
    border-top: 2px solid var(--gr-ink);
    font-size: .6rem;
    letter-spacing: .2em;
    color: var(--gr-navy);
    font-weight: 800;
    text-align: center;
  }

  /* Lonja data */
  .gr-lonja-data {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2.5px solid var(--gr-paper);
  }
  .gr-lonja-data li {
    padding: .85rem 1.1rem;
    border-bottom: 1px dashed rgba(255,251,240,0.25);
    display: flex; flex-direction: column; gap: 2px;
    background: rgba(255,251,240,0.04);
  }
  .gr-lonja-data li:last-child { border-bottom: none; }
  .gr-lonja-data__k { font-size: .58rem; letter-spacing: .2em; color: var(--gr-sun); font-weight: 800; }
  .gr-lonja-data__v { font-size: .9rem; color: var(--gr-paper); font-weight: 600; line-height: 1.35; }

  /* ═══════════════════════════════════════════════════════ */
  /* COCINA                                                  */
  /* ═══════════════════════════════════════════════════════ */
  .gr-cocina-section {
    background: var(--gr-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--gr-ink);
  }
  .gr-cocina {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px)  { .gr-cocina { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .gr-cocina { grid-template-columns: repeat(4, 1fr); } }
  .gr-cocina__card {
    background: var(--gr-paper);
    border: 2.5px solid var(--gr-ink);
    box-shadow: 5px 5px 0 var(--gr-ink);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .5rem; align-items: center;
    text-align: center;
    transition: transform .25s, box-shadow .25s;
  }
  .gr-cocina__card:hover { transform: translate(-3px, -3px); box-shadow: 8px 8px 0 currentColor; }
  .gr-cocina__card--gamba  { color: var(--gr-gamba); }
  .gr-cocina__card--navy   { color: var(--gr-navy); }
  .gr-cocina__card--copper { color: var(--gr-copper); }
  .gr-cocina__card--plata  { color: var(--gr-plata); }
  .gr-cocina__icon { width: 80px; height: 80px; }
  .gr-cocina__plato {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--gr-ink);
    margin: .5rem 0 0;
  }
  .gr-cocina__desc {
    font-size: .82rem;
    line-height: 1.4;
    color: var(--brutal-text-secondary);
    margin: 0;
  }
  .gr-cocina__rating {
    font-family: var(--font-mono);
    color: var(--gr-sun);
    font-size: 1rem;
    letter-spacing: 0;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* SECTORES                                                */
  /* ═══════════════════════════════════════════════════════ */
  .gr-sec-section {
    background: var(--gr-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--gr-ink);
  }
  .gr-sec {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .gr-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .gr-sec { grid-template-columns: repeat(3, 1fr); } }
  .gr-sec__card {
    background: var(--gr-paper);
    border: 2.5px solid var(--gr-ink);
    box-shadow: var(--gr-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .gr-sec__card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .gr-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .gr-sec__card--gamba  { color: var(--gr-gamba); }
  .gr-sec__card--navy   { color: var(--gr-navy); }
  .gr-sec__card--copper { color: var(--gr-copper); }
  .gr-sec__card--plata  { color: var(--gr-plata); }
  .gr-sec__card--cuerda { color: var(--gr-cuerda); }
  .gr-sec__card--navy-d { color: var(--gr-navy-d); }

  .gr-sec__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
    gap: .5rem;
  }
  .gr-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .gr-sec__stat-box {
    background: var(--gr-ink); color: var(--gr-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .gr-sec__stat-v { font-size: .95rem; font-weight: 800; color: currentColor; line-height: 1; }
  .gr-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .gr-sec__title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    color: var(--gr-ink);
    margin: 0;
  }
  .gr-sec__desc {
    font-size: .88rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
    flex: 1;
  }
  .gr-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .gr-sec__tag {
    display: flex; align-items: flex-start; gap: .35rem;
    font-size: .78rem;
    line-height: 1.35;
    color: var(--gr-ink);
  }
  .gr-sec__tag span { color: currentColor; font-weight: 800; }
  .gr-sec__foot {
    padding-top: .65rem;
    border-top: 2px solid var(--gr-ink);
  }
  .gr-sec__cta {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* MAPA                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .gr-map-section {
    background: var(--gr-sand);
    border-bottom: 3px solid var(--gr-ink);
  }
  .gr-map-head { padding: 4rem 0 2rem; }
  .gr-map-head__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: end;
  }
  @media (min-width: 768px) { .gr-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .gr-map-chapter { color: var(--gr-navy); }
  .gr-map-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 0;
  }
  .gr-map-title em { color: var(--gr-navy); }
  .gr-map-coords {
    background: var(--gr-gamba);
    color: var(--gr-paper);
    padding: 1rem 1.25rem;
    border: 2px solid var(--gr-ink);
    box-shadow: 5px 5px 0 var(--gr-navy);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem;
    letter-spacing: .15em;
  }

  .gr-map-frame {
    position: relative;
    border-top: 3px solid var(--gr-ink);
    border-bottom: 3px solid var(--gr-ink);
    background: var(--gr-ink);
  }
  .gr-map-anchor {
    position: absolute;
    width: 60px; height: 60px;
    z-index: 5;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.45));
    opacity: 0.85;
  }
  .gr-map-anchor--tl { top: 16px; left: 16px; }
  .gr-map-anchor--br { bottom: 16px; right: 16px; }

  .gr-map-wrap {
    width: 100%;
    height: clamp(420px, 60vh, 600px);
    overflow: hidden;
  }
  .gr-map-wrap > * { width: 100%; height: 100%; }

  /* ═══════════════════════════════════════════════════════ */
  /* DIFERENCIALES                                           */
  /* ═══════════════════════════════════════════════════════ */
  .gr-dif-section {
    background: var(--gr-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--gr-ink);
  }
  .gr-dif {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--gr-ink);
  }
  @media (min-width: 768px) { .gr-dif { grid-template-columns: 1fr 1fr; } }
  .gr-dif__item {
    padding: 1.75rem 1.5rem;
    border-bottom: 1px solid var(--gr-ink);
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .2s;
  }
  @media (min-width: 768px) {
    .gr-dif__item:nth-child(odd) { border-right: 1px solid var(--gr-ink); }
    .gr-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) {
    .gr-dif__item:last-child { border-bottom: none; }
  }
  .gr-dif__item--0 { background: var(--gr-paper-2); }
  .gr-dif__item--1 { background: var(--gr-paper); }
  .gr-dif__item--2 { background: var(--gr-sand); }
  .gr-dif__item--3 { background: var(--gr-paper); }
  .gr-dif__item:hover { background: var(--gr-sun); }
  .gr-dif__num { font-size: .85rem; color: var(--gr-gamba); font-weight: 800; letter-spacing: .15em; }
  .gr-dif__t {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--gr-ink);
    margin: 0;
  }
  .gr-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* ═══════════════════════════════════════════════════════ */
  /* PROCESO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .gr-proc-section {
    background: var(--gr-ink);
    color: var(--gr-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--gr-ink);
    position: relative;
    overflow: hidden;
  }
  .gr-proc-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(217,52,44,0.06) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .gr-proc-section > * { position: relative; }
  .gr-proc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px)  { .gr-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .gr-proc { grid-template-columns: repeat(4, 1fr); } }
  .gr-proc__step {
    background: rgba(255,251,240,0.05);
    border: 2px solid var(--gr-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .gr-proc__step:hover { background: rgba(217,52,44,0.12); transform: translateY(-3px); }
  .gr-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(255,251,240,0.25); }
  .gr-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--gr-sun); line-height: 1; }
  .gr-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--gr-gamba); }
  .gr-proc__t {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--gr-paper);
    margin: .25rem 0 0;
  }
  .gr-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(255,251,240,0.75); flex: 1; }
  .gr-proc__foot {
    font-size: .58rem;
    letter-spacing: .2em;
    color: var(--gr-sun);
    font-weight: 800;
    padding-top: .5rem;
    border-top: 1.5px solid rgba(255,251,240,0.25);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .gr-quote-section {
    background: var(--gr-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--gr-ink);
  }
  .gr-pull {
    position: relative;
    background: var(--gr-sand);
    border: 3px solid var(--gr-ink);
    box-shadow: var(--gr-shadow);
    padding: 3rem 2rem 2rem;
    margin: 2rem 0;
  }
  .gr-pull__seal {
    position: absolute;
    top: -30px; right: 30px;
    width: 90px; aspect-ratio: 1;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 8px rgba(217,52,44,0.4));
  }
  .gr-pull__q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.3;
    margin: 0 0 1.5rem;
    color: var(--gr-ink);
    max-width: 56ch;
  }
  .gr-pull__cap { display: flex; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 2px dashed var(--gr-ink); }
  .gr-pull__avatar {
    width: 48px; height: 48px;
    background: var(--gr-gamba); color: var(--gr-paper);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-size: 1.35rem; font-weight: 800;
    border-radius: 50%;
  }
  .gr-pull__cap div { display: flex; flex-direction: column; }
  .gr-pull__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--gr-ink); }
  .gr-pull__role { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; opacity: .65; text-transform: uppercase; }

  .gr-quotes {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .gr-quotes { grid-template-columns: repeat(2, 1fr); } }
  .gr-quote {
    position: relative;
    background: var(--gr-paper);
    border: 2px solid var(--gr-ink);
    box-shadow: 5px 5px 0 var(--gr-ink);
    padding: 1.75rem 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .gr-quote:hover { transform: translateY(-3px); }
  .gr-quote--0 { background: var(--gr-paper); }
  .gr-quote--1 { background: var(--gr-sand); }
  .gr-quote__mark {
    position: absolute;
    top: -8px; left: 14px;
    font-family: serif;
    font-size: 4rem;
    line-height: 1;
    color: var(--gr-gamba);
    opacity: .45;
  }
  .gr-quote p { font-size: .92rem; line-height: 1.5; color: var(--gr-ink); flex: 1; margin: 0; }
  .gr-quote footer { display: flex; align-items: center; gap: .75rem; padding-top: .85rem; border-top: 1.5px dashed var(--gr-ink); }
  .gr-quote__avatar {
    width: 36px; height: 36px;
    background: var(--gr-navy); color: var(--gr-paper);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .gr-quote footer div { display: flex; flex-direction: column; }
