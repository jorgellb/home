  description={description}
  canonical={canonical}
  image="/imagenes/diseno-web-seo-macael.jpg"
  imageAlt="Diseño web en Macael - Mármol Blanco y exportación mundial"
  type="service"
  keywords="diseño web macael, mármol blanco macael, web empresa mármol, exportación mármol, seo mármol internacional, catálogo piedra natural"
  jsonLd={jsonLdSchemas}
>
  <Header />

  <main id="main-content" class="mc">

    <IndiceLateral secciones={secciones} coordenadas="37.343° N · 2.320° W · 6.000 hab" class="mc-rail" />

    {/* ════════════════════════════════════════════════ */}
    {/* HERO                                              */}
    {/* ════════════════════════════════════════════════ */}
    <section class="mc-hero">
