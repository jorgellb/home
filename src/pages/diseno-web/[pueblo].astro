>
  <Header />

  <main id="main-content">
    {/* HERO editorial del pueblo */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º {String(pueblo.poblacion ? Math.min(99, Math.floor(pueblo.poblacion / 1000)) : 10).padStart(3, '0')} — {pueblo.comarca}</span>
          <span class="text-meta">
            <span class="live-dot"></span>
            {pueblo.destacado ? 'Localidad destacada · proyectos activos' : `Cobertura · ${pueblo.comarca}`}
          </span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Diseño Web · {pueblo.comarca}</span>
            <h1 class="svc-hero__title">
              Diseño web
              <em>en {pueblo.nombre},</em>
              <span class="text-stroke-ink">SEO local</span>
              que vende.
            </h1>
            <p class="svc-hero__lead">
              {pueblo.descripcion} Creamos <strong>páginas web profesionales</strong>
              que impulsan tu negocio y te posicionan en Google para búsquedas locales en {pueblo.nombre}.
            </p>

            <div class="pueblo-tags">
              {pueblo.caracteristicas.slice(0, 4).map((tag) => (
                <span class="tag-brutal">★ {tag}</span>
              ))}
            </div>

            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">
                Presupuesto en 24h →
              </a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">
                657 085 019
              </a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">450€</span>
              <span class="svc-hero__spec-lbl">Desde · web pro</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">0€</span>
              <span class="svc-hero__spec-lbl">Hosting web estática</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">1–2sem</span>
              <span class="svc-hero__spec-lbl">A producción</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">99/100</span>
              <span class="svc-hero__spec-lbl">Lighthouse target</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ {pueblo.nombre.toUpperCase()} ★ {pueblo.comarca.toUpperCase()} ★ DISEÑO WEB ★ SEO LOCAL ★ HOSTING GRATIS ★</span>
          ))}
        </div>
      </div>
    </section>

    {/* Mapa interactivo si hay coords */}
    {pueblo.coords && (
      <section class="section-brutal" style="padding:0;background:var(--brutal-bg-alt);border-bottom:2px solid var(--brutal-ink);">
        <div class="pueblo-map-wrap">
          <InteractiveMap center={pueblo.coords} zoom={13} pitch={25} bearing={-15} label={pueblo.nombre} />
        </div>
      </section>
    )}

    {/* SERVICIOS — bento brutal */}
    <section class="section-brutal" id="servicios">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 01 / Servicios para {pueblo.nombre}</span>
            <h2 class="brutal-section-head__title">
              Qué hacemos por
              <em>tu negocio.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Seis servicios que cubren todo el ciclo digital: desde la web
            hasta el SEO local, el e-commerce y el mantenimiento mensual.
          </p>
        </header>

        <ol class="svc-bento">
          {servicios.map((s, i) => {
            const accents = ['accent', 'paper', 'lime', 'paper', 'ink', 'paper'];
            const accent = accents[i % accents.length];
            return (
              <li class={`svc-card svc-card--${accent}`}>
                <header class="svc-card__head">
                  <span class="svc-card__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-card__kicker">{pueblo.nombre}</span>
                </header>
                <h3 class="svc-card__title">{s.titulo}</h3>
                <p class="svc-card__desc">{s.descripcion}</p>
                <ul class="svc-card__features">
                  {s.beneficios.map((b) => (
                    <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{b}</span></li>
                  ))}
                </ul>
                <footer class="svc-card__foot">
                  <div class="svc-card__figure">
                    <span class="svc-card__figure-val">★</span>
                    <span class="svc-card__figure-lbl">Para {pueblo.comarca}</span>
                  </div>
                  <a href="/contacto" class="svc-card__cta">Pedir →</a>
                </footer>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    {/* Sector principal + especificaciones */}
    {pueblo.sectorPrincipal && (
      <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 02 / Especialización en {pueblo.nombre}</span>
              <h2 class="brutal-section-head__title">
                Conocemos
                <em>tu sector.</em>
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Trabajamos con negocios del sector
              <strong> {pueblo.sectorPrincipal.toLowerCase()}</strong> en {pueblo.nombre}.
              Conocemos el mercado local y los códigos visuales del sector.
            </p>
          </header>

          <dl class="spec-list" style="max-width:760px;margin:2rem auto 0;">
            <div><dt class="spec-k">Localidad</dt><dd class="spec-v">{pueblo.nombre}</dd></div>
            <div><dt class="spec-k">Comarca</dt><dd class="spec-v">{pueblo.comarca}</dd></div>
            {pueblo.poblacion && <div><dt class="spec-k">Población</dt><dd class="spec-v">{pueblo.poblacion.toLocaleString('es-ES')} habitantes</dd></div>}
            <div><dt class="spec-k">Sector principal</dt><dd class="spec-v">{pueblo.sectorPrincipal}</dd></div>
            {pueblo.lugarIconico && <div><dt class="spec-k">Lugar icónico</dt><dd class="spec-v">{pueblo.lugarIconico}</dd></div>}
            <div><dt class="spec-k">Cobertura</dt><dd class="spec-v">Reuniones presenciales · entregas remotas</dd></div>
          </dl>
        </div>
      </section>
    )}

    {/* Sectores locales si existen */}
    {pueblo.sectores && pueblo.sectores.length > 0 && (
      <section class="section-brutal">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 03 / Quién contrata en {pueblo.nombre}</span>
              <h2 class="brutal-section-head__title">
                Para
                <em>quién diseñamos</em>
                en {pueblo.nombre}.
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Sectores locales que ya venden más online con una web hecha
              con criterio. Identifica el tuyo y pide presupuesto.
            </p>
          </header>

          <ul class="svc-sectors">
            {pueblo.sectores.map((s, i) => (
              <li class={`svc-sector svc-sector--${i % 3}`}>
                <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
                <h3 class="svc-sector__title">{s.nombre}</h3>
                <p class="svc-sector__desc">{s.descripcion}</p>
                {s.keywords && s.keywords.length > 0 && (
                  <div class="pueblo-sector-keys">
                    {s.keywords.slice(0, 3).map((k) => <span class="tag-brutal">{k}</span>)}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Por qué nosotros */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Por qué Platanito Rico</span>
            <h2 class="brutal-section-head__title">
              Estudio local
              <em>con criterio.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            No somos una agencia genérica que vende plantillas. Conocemos
            {' '}{pueblo.comarca} y entendemos las necesidades específicas de
            negocios de {pueblo.nombre}.
          </p>
        </header>

        <ul class="svc-sectors">
          {razones.map((r, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">★ Razón {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{r.titulo}</h3>
              <p class="svc-sector__desc">{r.descripcion}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Proceso */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Método</span>
            <h2 class="brutal-section-head__title">
              De cero a producción
              <em>en 2 semanas.</em>
