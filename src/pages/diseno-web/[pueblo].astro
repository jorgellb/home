---
/* Landing de diseño web por municipio: una sola plantilla para los 98.
   El contenido propio de cada pueblo sale de src/data/servicios/pueblo-web.ts;
   la indexación, de src/data/pueblos-indexables.ts. */
import PlantillaPueblo from '../../components/sitio/PlantillaPueblo.astro';
import { pueblos, type Pueblo } from '../../data/pueblos-almeria';
import { contenidoWebPueblo } from '../../data/servicios/pueblo-web';

export function getStaticPaths() {
  return pueblos.map((pueblo) => ({ params: { pueblo: pueblo.slug }, props: { pueblo } }));
}

interface Props {
  pueblo: Pueblo;
}

const datos = contenidoWebPueblo(Astro.props.pueblo);
---

<PlantillaPueblo datos={datos} />
