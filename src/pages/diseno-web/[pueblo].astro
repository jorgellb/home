---
/* Plantilla única de las landings de diseño web por municipio (brutal tech).
   El contenido propio de cada pueblo sale de src/data/landings.ts, que une
   las antiguas páginas hechas a mano con los datos base. La indexación sigue
   gobernada por pueblos-indexables.ts. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Contact from '../../components/sections/Contact.astro';
import ServiciosPueblo from '../../components/sections/ServiciosPueblo.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import BlueprintHero from '../../components/brutal/BlueprintHero.astro';
import Ticker from '../../components/brutal/Ticker.astro';
import LugaresBento from '../../components/brutal/LugaresBento.astro';
import FichaDatos from '../../components/brutal/FichaDatos.astro';
import SectoresGrid from '../../components/brutal/SectoresGrid.astro';
import ItemsLista from '../../components/brutal/ItemsLista.astro';
import Testimonios from '../../components/brutal/Testimonios.astro';
import Pasos from '../../components/brutal/Pasos.astro';
import PueblosLinks from '../../components/brutal/PueblosLinks.astro';
import ItSection from '../../components/it/ItSection.astro';
import SectionHead from '../../components/it/SectionHead.astro';
import BloquesGrid from '../../components/it/BloquesGrid.astro';
import FaqList from '../../components/it/FaqList.astro';
import Plan360Teaser from '../../components/it/Plan360Teaser.astro';
import { pueblos, getPueblosByComarca, type Pueblo } from '../../data/pueblos-almeria';
import { esPuebloIndexable } from '../../data/pueblos-indexables';
import { getLanding } from '../../data/landings';
import { getPuebloIT, HUB_IT } from '../../data/servicios-it';
import { SITE, PROVEEDOR } from '../../data/negocio';

export function getStaticPaths() {
  /* Los pueblos con página propia hecha a mano (con sus ilustraciones SVG)
     se excluyen: se deducen de los ficheros del directorio. */
  const conPaginaPropia = new Set(
    Object.keys(import.meta.glob('./*.astro'))
      .map((ruta) => ruta.replace(/^\.\//, '').replace(/\.astro$/, ''))
      .filter((slug) => slug !== 'index' && slug !== '[pueblo]'),
  );
  return pueblos
    .filter((pueblo) => !conPaginaPropia.has(pueblo.slug))
    .map((pueblo) => ({ params: { pueblo: pueblo.slug }, props: { pueblo } }));
}

interface Props {
  pueblo: Pueblo;
}

const { pueblo } = Astro.props;
const l = getLanding(pueblo);
const n = l.nombre;
const canonical = `${SITE}/diseno-web/${l.slug}/`;

const fmtCoord = (v: number) => Math.abs(v).toFixed(4).replace('.', ',');
const coords = l.coords ? `${fmtCoord(l.coords[1])} N · ${fmtCoord(l.coords[0])} O` : undefined;

const pasos = [
  { t: 'Llamada de 30 minutos', d: `Nos cuentas tu negocio en ${n} y qué quieres conseguir. Sin compromiso.` },
  { t: 'Presupuesto cerrado', d: 'Precio, plazo y entregables por escrito en menos de 24 horas.' },
  { t: 'Diseño y desarrollo', d: 'Apruebas el diseño antes de programar y ves el avance en un entorno de pruebas.' },
  { t: 'Publicación y SEO local', d: `Publicamos, damos de alta tu ficha de Google y te formamos para gestionarla.` },
];

const it = getPuebloIT(l.slug);

// Primero los municipios indexables: son los que merece la pena enlazar.
const vecinos = getPueblosByComarca(l.comarca)
  .filter((p) => p.slug !== l.slug)
  .sort((a, b) => Number(esPuebloIndexable(b.slug)) - Number(esPuebloIndexable(a.slug)))
  .slice(0, 10)
  .map((p) => ({ href: `/diseno-web/${p.slug}/`, label: `Diseño web en ${p.nombre}` }));

const ticker = [
  ...(l.sectores.length > 0 ? l.sectores.map((s) => s.nombre) : l.caracteristicas),
  'Web desde 500 €',
  'Presupuesto en 24 horas',
  'Sin permanencia',
];

let lamina = 0;
const siguienteLamina = () => `Lámina ${String(++lamina).padStart(2, '0')}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'serviceType': 'Diseño web',
    'name': `Diseño web en ${n}`,
    'description': l.description,
    'url': canonical,
    'provider': PROVEEDOR,
    'areaServed': { '@type': 'City', 'name': n, 'containedInPlace': { '@type': 'AdministrativeArea', 'name': l.comarca } },
    'offers': { '@type': 'Offer', 'price': '500', 'priceCurrency': 'EUR', 'description': 'Web profesional desde 500 €' },
  },
  ...(l.faq.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        'mainEntity': l.faq.map((f) => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
      }]
    : []),
];
---

<BaseLayout
  title={l.title}
  description={l.description}
  noindex={!l.indexable}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt={`Diseño web en ${n} por Platanito Rico`}
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Diseño web en Almería', href: '/diseno-web/' }, { label: n }]} />

  <main id="main-content">
    <BlueprintHero
      size="compact"
      h1Lines={[l.h1]}
      h2={`Páginas web que traen clientes a negocios de ${n}`}
      lead={l.lead}
      primary={{ href: '/contacto/?servicio=web#contacto', label: 'Pedir presupuesto' }}
      secondary={{ href: 'tel:+34657085019', label: 'Llamar al 657 085 019' }}
      place={`${n}, ${l.comarca}`}
      coords={coords}
      proyecto={`Diseño web en ${n}`}
      lamina="DW"
      specs={[
        { k: 'Web profesional', v: 'Desde 500 €' },
        { k: 'Tienda online', v: 'Desde 700 €' },
        { k: 'Presupuesto', v: 'En 24 horas' },
        { k: 'Comarca', v: l.comarca },
      ]}
    />
    <Ticker label={`Diseño web para negocios de ${n}`} items={ticker} />

    {l.lugares.length > 0 ? (
      <ItSection tone="bone" labelledby="dw-lugares">
        <SectionHead id="dw-lugares" kicker={siguienteLamina()} title={l.cabeceras.lugares.h2} lead={l.cabeceras.lugares.lead || undefined} />
        <LugaresBento items={l.lugares} />
      </ItSection>
    ) : (
      <ItSection tone="bone" labelledby="dw-panorama">
        <div class="dw-panorama">
          <div>
            <SectionHead id="dw-panorama" kicker={siguienteLamina()} title={`El tejido de ${n} en internet`} />
            {l.panorama.length > 0
              ? l.panorama.map((p) => <p class="dw-panorama__p">{p}</p>)
              : <p class="dw-panorama__p">{l.lead}</p>}
          </div>
          <ul class="dw-chips">
            {l.caracteristicas.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </ItSection>
    )}

    {l.datos.length > 0 && (
      <ItSection tone="paper" labelledby="dw-datos">
        <SectionHead id="dw-datos" kicker={siguienteLamina()} title={l.cabeceras.datos.h2} lead={l.cabeceras.datos.lead || undefined} />
        <FichaDatos items={l.datos} />
      </ItSection>
    )}

    {l.coords && (
      <section class="dw-map" aria-label={`Mapa de ${n}`}>
        <InteractiveMap center={l.coords} zoom={13} pitch={25} bearing={-15} label={n} themeColor="#FF5A00" themeColorDark="#0E0D0B" townInitial={n.charAt(0)} />
      </section>
    )}

    {l.sectores.length > 0 && (
      <ItSection tone="bone" labelledby="dw-sectores">
        <SectionHead id="dw-sectores" kicker={siguienteLamina()} title={l.cabeceras.sectores.h2} lead={l.cabeceras.sectores.lead || undefined} />
        <SectoresGrid items={l.sectores} />
      </ItSection>
    )}

    {l.extras.map((e, i) => (
      <ItSection tone={i % 2 === 0 ? 'night' : 'paper'} labelledby={`dw-extra-${e.key}`}>
        <SectionHead id={`dw-extra-${e.key}`} kicker={siguienteLamina()} title={e.titulo} lead={e.lead || undefined} />
        <ItemsLista items={e.items} />
      </ItSection>
    ))}

    <ItSection tone="paper" labelledby="dw-diferenciales">
      <SectionHead id="dw-diferenciales" kicker={siguienteLamina()} title={l.cabeceras.diferenciales.h2} lead={l.cabeceras.diferenciales.lead || undefined} />
      <BloquesGrid items={l.diferenciales} columns={2} />
    </ItSection>

    <ItSection tone="bone" labelledby="dw-proceso">
      <SectionHead id="dw-proceso" kicker={siguienteLamina()} title={`Cómo hacemos tu página web en ${n}`} />
      <Pasos items={pasos} />
    </ItSection>

    {l.testimonios.length > 0 && (
      <ItSection tone="night" labelledby="dw-testimonios">
        <SectionHead id="dw-testimonios" kicker={siguienteLamina()} title={l.cabeceras.testimonios.h2} lead={l.cabeceras.testimonios.lead || undefined} />
        <Testimonios items={l.testimonios} />
      </ItSection>
    )}

    {it && (
      <ItSection tone="paper" labelledby="dw-it">
        <SectionHead
          id="dw-it"
          kicker={siguienteLamina()}
          title={`Web e informática en ${n}, en una sola cuota`}
          lead={`En ${n} también mantenemos ordenadores, redes y copias de seguridad, con técnico en tu empresa el mismo día.`}
        />
        <Plan360Teaser />
        <p class="dw-it-link"><a href={`${HUB_IT}${it.slug}/`}>Mantenimiento informático en {n}</a></p>
      </ItSection>
    )}

    {l.faq.length > 0 && (
      <ItSection tone="bone" labelledby="dw-faq">
        <SectionHead id="dw-faq" kicker={siguienteLamina()} title={l.cabeceras.faq.h2} lead={l.cabeceras.faq.lead || undefined} />
        <FaqList items={l.faq} />
      </ItSection>
    )}

    {vecinos.length > 0 && (
      <ItSection tone="paper" labelledby="dw-vecinos">
        <SectionHead
          id="dw-vecinos"
          kicker={siguienteLamina()}
          title={`Diseño web en ${l.comarca}`}
          lead="Otros municipios de la comarca donde trabajamos. Si el tuyo no aparece, escríbenos: cubrimos toda la provincia."
        />
        <PueblosLinks items={[...vecinos, { href: '/diseno-web/', label: 'Todos los municipios de Almería' }]} />
      </ItSection>
    )}

    <ServiciosPueblo pueblo={n} />
    <Contact />
  </main>

  <Footer />
</BaseLayout>

<style>
  .dw-panorama { display: grid; gap: 2rem; }
  @media (min-width: 1024px) { .dw-panorama { grid-template-columns: 1.5fr 1fr; gap: 4rem; align-items: start; } }
  .dw-panorama__p { margin: 0 0 1.1rem; max-width: 64ch; font-size: 1.08rem; line-height: 1.65; }
  .dw-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; align-content: start; }
  .dw-chips li { padding: .45rem .8rem; font-family: var(--font-mono); font-size: .82rem; background: var(--color-plano-lima); border: 2px solid var(--color-plano-tinta); }
  .dw-map { height: clamp(360px, 50vh, 520px); border-bottom: 3px solid var(--color-plano-tinta); }
  .dw-map > :global(*) { width: 100%; height: 100%; }
  .dw-it-link { margin: 1.75rem 0 0; font-family: var(--font-mono); font-weight: 800; }
  .dw-it-link a { color: var(--it-accent); text-underline-offset: 4px; text-decoration-thickness: 2px; }
</style>
