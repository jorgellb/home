---
/* Plantilla única de las landings de diseño web por municipio sin página
   propia (centro de mando, spec §6.3): plantilla de lectura con índice
   lateral y, si el pueblo sale en el mapa, el radar de cobertura con el
   pueblo resaltado. El contenido propio de cada pueblo sale de
   src/data/landings.ts; la indexación sigue en pueblos-indexables.ts. */
import LecturaLayout from '../../layouts/LecturaLayout.astro';
import Boton from '../../components/cdm/Boton.astro';
import RadarCobertura from '../../components/cdm/RadarCobertura.astro';
import Contact from '../../components/sections/Contact.astro';
import ServiciosPueblo from '../../components/sections/ServiciosPueblo.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import type { Cifra, SeccionIndice } from '../../components/cdm/tipos';
import { pueblos, getPueblosByComarca, type Pueblo } from '../../data/pueblos-almeria';
import { esPuebloIndexable } from '../../data/pueblos-indexables';
import { getLanding } from '../../data/landings';
import { getPuebloIT, HUB_IT, plan360 } from '../../data/servicios-it';
import { dentroDeCaja } from '../../data/cobertura';
import { SITE, PROVEEDOR } from '../../data/negocio';

export function getStaticPaths() {
  /* Los pueblos con página propia hecha a mano (con sus ilustraciones SVG)
     se excluyen: se deducen de los ficheros del directorio. */
  const conPaginaPropia = new Set(
    Object.keys(import.meta.glob('./*.astro'))
      .map((ruta) => ruta.replace(/^\.\//, '').replace(/\.astro$/, ''))
      .filter((slug) => slug !== 'index' && slug !== '[pueblo]'),
  );
  return pueblos
    .filter((pueblo) => !conPaginaPropia.has(pueblo.slug))
    .map((pueblo) => ({ params: { pueblo: pueblo.slug }, props: { pueblo } }));
}

interface Props {
  pueblo: Pueblo;
}

const { pueblo } = Astro.props;
const l = getLanding(pueblo);
const n = l.nombre;
const canonical = `${SITE}/diseno-web/${l.slug}/`;

const fmtCoord = (v: number) => Math.abs(v).toFixed(4).replace('.', ',');
const coords = l.coords ? `${fmtCoord(l.coords[1])} N · ${fmtCoord(l.coords[0])} O` : undefined;
/* l.coords va en [lon, lat], como lo pide el mapa interactivo. */
const enRadar = l.coords ? dentroDeCaja(l.coords[1], l.coords[0]) : false;

const pasos = [
  { t: 'Llamada de 30 minutos', d: `Nos cuentas tu negocio en ${n} y qué quieres conseguir. Sin compromiso.` },
  { t: 'Presupuesto cerrado', d: 'Precio, plazo y entregables por escrito en menos de 24 horas.' },
  { t: 'Diseño y desarrollo', d: 'Apruebas el diseño antes de programar y ves el avance en un entorno de pruebas.' },
  { t: 'Publicación y SEO local', d: `Publicamos, damos de alta tu ficha de Google y te formamos para gestionarla.` },
];

const it = getPuebloIT(l.slug);

// Primero los municipios indexables: son los que merece la pena enlazar.
const deComarca = getPueblosByComarca(l.comarca);
const vecinos = deComarca
  .filter((p) => p.slug !== l.slug)
  .sort((a, b) => Number(esPuebloIndexable(b.slug)) - Number(esPuebloIndexable(a.slug)))
  .slice(0, 10)
  .map((p) => ({ href: `/diseno-web/${p.slug}/`, label: `Diseño web en ${p.nombre}` }));

const datosCabecera: Cifra[] = [
  { etiqueta: 'Web profesional, desde', valor: 500, sufijo: ' €' },
  { etiqueta: 'Tienda online, desde', valor: 700, sufijo: ' €' },
  { etiqueta: 'Presupuesto cerrado', valor: 24, sufijo: ' h' },
  { etiqueta: 'Municipios de la comarca', valor: deComarca.length },
];

const secciones: SeccionIndice[] = [
  l.lugares.length > 0 ? { id: 'lugares', etiqueta: 'Lugares' } : { id: 'panorama', etiqueta: 'Panorama' },
  ...(l.datos.length > 0 ? [{ id: 'datos', etiqueta: 'En datos' }] : []),
  ...(l.coords ? [{ id: 'mapa', etiqueta: 'Mapa' }] : []),
  ...(l.sectores.length > 0 ? [{ id: 'sectores', etiqueta: 'Sectores' }] : []),
  ...l.extras.map((e) => ({ id: `extra-${e.key}`, etiqueta: e.titulo })),
  { id: 'porque', etiqueta: 'Por qué una web' },
  { id: 'metodo', etiqueta: 'Método' },
  ...(l.testimonios.length > 0 ? [{ id: 'testimonios', etiqueta: 'Testimonios' }] : []),
  ...(it ? [{ id: 'informatica', etiqueta: 'Web e informática' }] : []),
  ...(l.faq.length > 0 ? [{ id: 'faq', etiqueta: 'Preguntas' }] : []),
  ...(vecinos.length > 0 ? [{ id: 'comarca', etiqueta: l.comarca }] : []),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'serviceType': 'Diseño web',
    'name': `Diseño web en ${n}`,
    'description': l.description,
    'url': canonical,
    'provider': PROVEEDOR,
    'areaServed': { '@type': 'City', 'name': n, 'containedInPlace': { '@type': 'AdministrativeArea', 'name': l.comarca } },
    'offers': { '@type': 'Offer', 'price': '500', 'priceCurrency': 'EUR', 'description': 'Web profesional desde 500 €' },
  },
  ...(l.faq.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        'mainEntity': l.faq.map((f) => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
      }]
    : []),
];
---

<LecturaLayout
  title={l.title}
  description={l.description}
  noindex={!l.indexable}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt={`Diseño web en ${n} por Platanito Rico`}
  jsonLd={jsonLd}
  migas={[{ label: 'Inicio', href: '/' }, { label: 'Diseño web en Almería', href: '/diseno-web/' }, { label: n }]}
  h1={l.h1}
  subtitulo={`Páginas web que traen clientes a negocios de ${n}`}
  entradilla={l.lead}
  datos={datosCabecera}
  secciones={secciones}
  coordenadas={coords}
>
  <Fragment slot="acciones">
    <Boton href="/contacto/?servicio=web#contacto">Pedir presupuesto</Boton>
    <Boton href="tel:+34657085019" variante="linea">Llamar al 657 085 019</Boton>
  </Fragment>

  {enRadar && l.coords && (
    <RadarCobertura slot="lateral" pueblo={{ slug: l.slug, nombre: n, lat: l.coords[1], lon: l.coords[0] }} />
  )}

  {l.lugares.length > 0 ? (
    <section class="dw-sec" id="lugares" aria-labelledby="dw-lugares">
      <h2 class="dw-h2" id="dw-lugares">{l.cabeceras.lugares.h2}</h2>
      {l.cabeceras.lugares.lead && <p class="dw-lead">{l.cabeceras.lugares.lead}</p>}
      <ul class="dw-rejilla">
        {l.lugares.map((lugar) => (
          <li class="dw-ficha">
            <h3 class="dw-h3">{lugar.name}</h3>
            <p class="dw-meta">{lugar.sub}</p>
            <p class="dw-texto">{lugar.desc}</p>
            <p class="dw-dato">{lugar.dato}</p>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <section class="dw-sec" id="panorama" aria-labelledby="dw-panorama">
      <h2 class="dw-h2" id="dw-panorama">{`El tejido de ${n} en internet`}</h2>
      {l.panorama.length > 0
        ? l.panorama.map((p) => <p class="dw-texto dw-texto--largo">{p}</p>)
        : <p class="dw-texto dw-texto--largo">{l.lead}</p>}
      <ul class="dw-chips">
        {l.caracteristicas.map((c) => <li>{c}</li>)}
      </ul>
    </section>
  )}

  {l.datos.length > 0 && (
    <section class="dw-sec" id="datos" aria-labelledby="dw-datos">
      <h2 class="dw-h2" id="dw-datos">{l.cabeceras.datos.h2}</h2>
      {l.cabeceras.datos.lead && <p class="dw-lead">{l.cabeceras.datos.lead}</p>}
      <dl class="dw-datos">
        {l.datos.map((d) => (
          <div>
            <dt>{d.k}</dt>
            <dd>{d.v}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {l.coords && (
    <section class="dw-sec" id="mapa" aria-label={`Mapa de ${n}`}>
      <div class="dw-mapa">
        <InteractiveMap center={l.coords} zoom={13} pitch={25} bearing={-15} label={n} themeColor="#FF5A00" themeColorDark="#0E0D0B" townInitial={n.charAt(0)} />
      </div>
    </section>
  )}

  {l.sectores.length > 0 && (
    <section class="dw-sec" id="sectores" aria-labelledby="dw-sectores">
      <h2 class="dw-h2" id="dw-sectores">{l.cabeceras.sectores.h2}</h2>
      {l.cabeceras.sectores.lead && <p class="dw-lead">{l.cabeceras.sectores.lead}</p>}
      <ul class="dw-rejilla">
        {l.sectores.map((s) => (
          <li class="dw-ficha">
            <p class="dw-cifra">{s.stat}</p>
            <h3 class="dw-h3">{s.nombre}</h3>
            <p class="dw-texto">{s.desc}</p>
            {s.tags.length > 0 && (
              <ul class="dw-chips dw-chips--pequenas">
                {s.tags.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {l.extras.map((e) => (
    <section class="dw-sec" id={`extra-${e.key}`} aria-labelledby={`dw-extra-${e.key}`}>
      <h2 class="dw-h2" id={`dw-extra-${e.key}`}>{e.titulo}</h2>
      {e.lead && <p class="dw-lead">{e.lead}</p>}
      <ul class="dw-lista">
        {e.items.map((item) => (
          <li>
            {item.meta && <p class="dw-meta">{item.meta}</p>}
            <h3 class="dw-h3">{item.t}</h3>
            <p class="dw-texto">{item.d}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="dw-sec" id="porque" aria-labelledby="dw-porque">
    <h2 class="dw-h2" id="dw-porque">{l.cabeceras.diferenciales.h2}</h2>
    {l.cabeceras.diferenciales.lead && <p class="dw-lead">{l.cabeceras.diferenciales.lead}</p>}
    <ul class="dw-rejilla">
      {l.diferenciales.map((d) => (
        <li class="dw-ficha">
          <h3 class="dw-h3">{d.t}</h3>
          <p class="dw-texto">{d.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="dw-sec" id="metodo" aria-labelledby="dw-metodo">
    <h2 class="dw-h2" id="dw-metodo">{`Cómo hacemos tu página web en ${n}`}</h2>
    <ol class="dw-pasos">
      {pasos.map((p) => (
        <li>
          <h3 class="dw-h3">{p.t}</h3>
          <p class="dw-texto">{p.d}</p>
        </li>
      ))}
    </ol>
  </section>

  {l.testimonios.length > 0 && (
    <section class="dw-sec" id="testimonios" aria-labelledby="dw-testimonios">
      <h2 class="dw-h2" id="dw-testimonios">{l.cabeceras.testimonios.h2}</h2>
      {l.cabeceras.testimonios.lead && <p class="dw-lead">{l.cabeceras.testimonios.lead}</p>}
      <ul class="dw-voces">
        {l.testimonios.map((t) => (
          <li>
            <figure>
              <blockquote class="dw-texto">{t.texto}</blockquote>
              <figcaption><strong>{t.nombre}</strong> · {t.negocio}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}

  {it && (
    <section class="dw-sec" id="informatica" aria-labelledby="dw-it">
      <h2 class="dw-h2" id="dw-it">{`Web e informática en ${n}, en una sola cuota`}</h2>
      <p class="dw-lead">{`En ${n} también mantenemos ordenadores, redes y copias de seguridad, con técnico en tu empresa el mismo día.`}</p>
      <div class="dw-plan">
        <p class="dw-plan__titulo">Plan 360 <span>400 € + IVA al mes</span></p>
        <p class="dw-texto">
          Tu web, hasta {plan360.puestos} puestos, servidor, red, copias y ciberseguridad, con técnico en tu
          empresa el mismo día. Sin permanencia ni alta.
        </p>
        <div class="dw-plan__enlaces">
          <Boton href={plan360.href}>Ver el Plan 360</Boton>
          <Boton href={`${HUB_IT}${it.slug}/`} variante="linea">Mantenimiento informático en {n}</Boton>
        </div>
      </div>
    </section>
  )}

  {l.faq.length > 0 && (
    <section class="dw-sec" id="faq" aria-labelledby="dw-faq">
      <h2 class="dw-h2" id="dw-faq">{l.cabeceras.faq.h2}</h2>
      {l.cabeceras.faq.lead && <p class="dw-lead">{l.cabeceras.faq.lead}</p>}
      <ul class="dw-faq">
        {l.faq.map((f, i) => (
          <li>
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p class="dw-texto">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </section>
  )}

  {vecinos.length > 0 && (
    <section class="dw-sec" id="comarca" aria-labelledby="dw-comarca">
      <h2 class="dw-h2" id="dw-comarca">{`Diseño web en ${l.comarca}`}</h2>
      <p class="dw-lead">Otros municipios de la comarca donde trabajamos. Si el tuyo no aparece, escríbenos: cubrimos toda la provincia.</p>
      <ul class="dw-enlaces">
        {[...vecinos, { href: '/diseno-web/', label: 'Todos los municipios de Almería' }].map((v) => (
          <li><a href={v.href}>{v.label}</a></li>
        ))}
      </ul>
    </section>
  )}

  <Fragment slot="cierre">
    <ServiciosPueblo pueblo={n} />
    <Contact tono="consola" />
  </Fragment>
</LecturaLayout>

<style>
  .dw-sec { scroll-margin-top: 96px; }
  .dw-sec + .dw-sec { margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: clamp(2.5rem, 5vw, 3.5rem); border-top: 1px solid var(--color-cdm-regla); }

  .dw-h2 {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-stretch: 82%;
    font-weight: 720;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-cdm-texto);
  }
  .dw-lead { margin: 0.9rem 0 0; font-size: 1.05rem; line-height: 1.6; color: var(--color-cdm-tenue); }
  .dw-h3 { margin: 0; font-family: var(--font-display); font-stretch: 88%; font-weight: 680; font-size: 1.2rem; line-height: 1.15; color: var(--color-cdm-texto); }
  .dw-texto { margin: 0.55rem 0 0; font-size: 0.98rem; line-height: 1.6; color: #b9c5cf; }
  .dw-texto--largo { font-size: 1.06rem; margin-top: 1.1rem; }
  .dw-meta { margin: 0 0 0.35rem; font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-cdm-tenue); }
  .dw-dato { margin: 0.9rem 0 0; padding-top: 0.7rem; border-top: 1px dashed var(--color-cdm-regla-2); font-family: var(--font-mono); font-size: 0.82rem; color: var(--color-cdm-senal); }
  .dw-cifra { margin: 0 0 0.5rem; font-family: var(--font-mono); font-size: 1.35rem; font-weight: 700; color: var(--color-cdm-senal); }

  .dw-rejilla { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 1px; background: var(--color-cdm-regla); border: 1px solid var(--color-cdm-regla); }
  @media (min-width: 720px) {
    .dw-rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Con un número impar, la última ficha ocupa la fila: si no, el hueco
       vacío enseña el color de la regla como un bloque. */
    .dw-rejilla > li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .dw-ficha { padding: 1.35rem 1.4rem 1.5rem; background: var(--color-cdm-panel); }

  .dw-chips { list-style: none; margin: 1.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .dw-chips li { padding: 0.35rem 0.7rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-cdm-texto); border: 1px solid var(--color-cdm-regla-2); background: var(--color-cdm-panel-2); }
  .dw-chips--pequenas { margin-top: 1rem; }
  .dw-chips--pequenas li { font-size: 0.7rem; padding: 0.25rem 0.55rem; }

  .dw-datos { margin: 1.75rem 0 0; display: grid; gap: 1px; background: var(--color-cdm-regla); border: 1px solid var(--color-cdm-regla); }
  @media (min-width: 640px) {
    .dw-datos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dw-datos > div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .dw-datos > div { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.9rem 1.1rem; background: var(--color-cdm-panel); }
  .dw-datos dt { font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-cdm-tenue); }
  .dw-datos dd { margin: 0; font-size: 1rem; line-height: 1.45; color: var(--color-cdm-texto); }

  .dw-mapa { height: clamp(360px, 50vh, 520px); border: 1px solid var(--color-cdm-regla-2); }
  .dw-mapa > :global(*) { width: 100%; height: 100%; }

  .dw-lista { list-style: none; margin: 1.5rem 0 0; padding: 0; }
  .dw-lista > li { padding: 1.1rem 0; border-bottom: 1px solid var(--color-cdm-regla); }
  .dw-lista > li:first-child { border-top: 1px solid var(--color-cdm-regla); }

  /* Los pasos son una secuencia de verdad: aquí sí va numeración. */
  .dw-pasos { list-style: none; counter-reset: paso; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 1px; background: var(--color-cdm-regla); border: 1px solid var(--color-cdm-regla); }
  @media (min-width: 720px) { .dw-pasos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .dw-pasos > li { counter-increment: paso; padding: 1.3rem 1.4rem; background: var(--color-cdm-panel); }
  .dw-pasos > li::before { content: counter(paso, decimal-leading-zero); display: block; margin-bottom: 0.6rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-cdm-senal); }

  .dw-voces { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 1rem; }
  .dw-voces figure { margin: 0; padding: 1.3rem 1.4rem; background: var(--color-cdm-panel); border-left: 2px solid var(--color-cdm-senal); }
  .dw-voces blockquote { margin: 0; font-size: 1.02rem; color: var(--color-cdm-texto); }
  .dw-voces figcaption { margin-top: 0.8rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-cdm-tenue); }
  .dw-voces figcaption strong { color: var(--color-cdm-texto); font-weight: 600; }

  .dw-plan { margin-top: 1.75rem; padding: 1.4rem 1.5rem 1.5rem; background: var(--color-cdm-panel); border: 1px solid var(--color-cdm-regla-2); }
  .dw-plan__titulo { margin: 0; font-family: var(--font-display); font-stretch: 88%; font-weight: 700; font-size: 1.35rem; color: var(--color-cdm-texto); }
  .dw-plan__titulo span { margin-left: 0.5rem; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500; color: var(--color-cdm-ok); }
  .dw-plan__enlaces { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }

  .dw-faq { list-style: none; margin: 1.5rem 0 0; padding: 0; border-top: 1px solid var(--color-cdm-regla); }
  .dw-faq > li { border-bottom: 1px solid var(--color-cdm-regla); }
  .dw-faq summary { display: flex; justify-content: space-between; gap: 1rem; padding: 1.05rem 0; cursor: pointer; list-style: none; font-weight: 600; font-size: 1.02rem; line-height: 1.4; color: var(--color-cdm-texto); }
  .dw-faq summary::-webkit-details-marker { display: none; }
  .dw-faq summary::after { content: '+'; flex: none; font-family: var(--font-mono); color: var(--color-cdm-senal); }
  .dw-faq details[open] summary::after { content: '−'; }
  .dw-faq summary:focus-visible { outline: 2px solid var(--color-cdm-senal); outline-offset: 3px; }
  .dw-faq details p { margin: 0 0 1.2rem; }

  .dw-enlaces { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 1px; background: var(--color-cdm-regla); border: 1px solid var(--color-cdm-regla); }
  @media (min-width: 640px) {
    .dw-enlaces { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dw-enlaces > li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .dw-enlaces a { display: block; padding: 0.85rem 1.1rem; background: var(--color-cdm-panel); color: var(--color-cdm-texto); text-decoration: none; transition: background-color 0.15s, color 0.15s; }
  .dw-enlaces a:hover { background: var(--color-cdm-panel-2); color: var(--color-cdm-senal); }
  .dw-enlaces a:focus-visible { outline: 2px solid var(--color-cdm-senal); outline-offset: -2px; }
</style>
