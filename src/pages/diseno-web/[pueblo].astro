export async function getStaticPaths() {
  return pueblos
    .filter((pueblo) => pueblo.slug !== 'almeria' && pueblo.slug !== 'mojacar' && pueblo.slug !== 'huercal-overa' && pueblo.slug !== 'albox' && pueblo.slug !== 'vera')
    .map((pueblo) => ({
      params: { pueblo: pueblo.slug },
      props: { pueblo },
    }));
}

