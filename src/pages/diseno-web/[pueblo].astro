---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ServiciosPueblo from '../../components/sections/ServiciosPueblo.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import { pueblos, getPueblosByComarca, type Pueblo } from '../../data/pueblos-almeria';
import { esPuebloIndexable } from '../../data/pueblos-indexables';

export async function getStaticPaths() {
  /* Pueblos que ya tienen su propia página a medida en este directorio. Se
     deducen de los ficheros para no mantener la lista a mano: antes era una
     cadena de `!==` a la que se le habían olvidado dos slugs, y el build
     avisaba de rutas en conflicto. Al añadir un `mi-pueblo.astro` se excluye
     solo. Va dentro de la función porque Astro extrae `getStaticPaths` a su
     propio módulo y no ve las constantes del frontmatter. */
  const conPaginaPropia = new Set(
    Object.keys(import.meta.glob('./*.astro'))
      .map((ruta) => ruta.replace(/^\.\//, '').replace(/\.astro$/, ''))
      .filter((slug) => slug !== 'index' && slug !== '[pueblo]'),
  );

  return pueblos
    .filter((pueblo) => !conPaginaPropia.has(pueblo.slug))
    .map((pueblo) => ({
      params: { pueblo: pueblo.slug },
      props: { pueblo },
    }));
}

interface Props {
  pueblo: Pueblo;
}

const { pueblo } = Astro.props;

// Servicios con iconos premium
const servicios = [
  {
    titulo: 'Diseño Web Profesional',
    descripcion: `Creamos sitios web únicos y personalizados para empresas y negocios de ${pueblo.nombre}. Diseño moderno, responsive y optimizado para convertir visitantes en clientes.`,
    icon: 'globe',
    beneficios: ['Diseño 100% personalizado', 'Adaptable a todos los dispositivos', 'Velocidad de carga optimizada', 'Experiencia de usuario premium']
  },
  {
    titulo: 'Desarrollo Web a Medida',
    descripcion: `Desarrollamos soluciones web avanzadas para negocios de ${pueblo.nombre}. Desde tiendas online hasta aplicaciones web complejas con las últimas tecnologías.`,
    icon: 'code',
    beneficios: ['Código limpio y escalable', 'Integraciones personalizadas', 'Panel de administración', 'Soporte técnico continuo']
  },
  {
    titulo: 'SEO y Posicionamiento',
    descripcion: `Posicionamos tu negocio de ${pueblo.nombre} en las primeras posiciones de Google. Estrategias SEO locales para atraer clientes de tu zona.`,
    icon: 'chart',
    beneficios: [`SEO local para ${pueblo.nombre}`, 'Optimización On-Page', 'Link building estratégico', 'Informes mensuales']
  },
  {
    titulo: 'Marketing Digital',
    descripcion: `Estrategias de marketing digital adaptadas a negocios de ${pueblo.nombre}. Redes sociales, publicidad online y contenido que conecta con tu audiencia.`,
    icon: 'megaphone',
    beneficios: ['Gestión de redes sociales', 'Campañas de publicidad', 'Email marketing', 'Contenido estratégico']
  },
  {
    titulo: 'Tiendas Online',
    descripcion: `Crea tu tienda online y vende tus productos desde ${pueblo.nombre} a toda España. Plataformas seguras, fáciles de gestionar y listas para vender.`,
    icon: 'cart',
    beneficios: ['Catálogo de productos', 'Pasarelas de pago seguras', 'Gestión de inventario', 'Envíos automatizados']
  },
  {
    titulo: 'Mantenimiento Web',
    descripcion: `Mantenemos tu web siempre actualizada, segura y funcionando perfectamente. Servicio de mantenimiento profesional para empresas de ${pueblo.nombre}.`,
    icon: 'shield',
    beneficios: ['Actualizaciones de seguridad', 'Copias de seguridad', 'Soporte prioritario', 'Monitorización 24/7']
  }
];

// Razones para elegirnos
const razones = [
  { titulo: 'Conocemos la zona', descripcion: `Trabajamos con negocios de ${pueblo.comarca} y entendemos las necesidades locales.`, icon: 'map' },
  { titulo: 'Resultados garantizados', descripcion: 'Nuestros clientes mejoran su presencia online y aumentan sus ventas.', icon: 'trending' },
  { titulo: 'Atención personalizada', descripcion: 'Trato directo, sin intermediarios. Tu proyecto es nuestra prioridad.', icon: 'users' },
  { titulo: 'Tecnología puntera', descripcion: 'Utilizamos las últimas tecnologías para webs rápidas y modernas.', icon: 'rocket' },
];

// Proceso de trabajo
const proceso = [
  { paso: 1, titulo: 'Consulta gratuita', descripcion: 'Analizamos tu negocio y objetivos sin compromiso' },
  { paso: 2, titulo: 'Propuesta personalizada', descripcion: 'Diseñamos una solución a medida para tu proyecto' },
  { paso: 3, titulo: 'Desarrollo', descripcion: 'Creamos tu web con revisión continua y feedback' },
  { paso: 4, titulo: 'Lanzamiento', descripcion: 'Publicamos tu web y te formamos para gestionarla' },
];

// SEO Meta - Custom titles and descriptions for specific pueblos
const title = pueblo.sectorPrincipal
  ? `Diseño Web en ${pueblo.nombre} | ${pueblo.sectorPrincipal.slice(0, 50)}`
  : `Diseño Web en ${pueblo.nombre} | Páginas Web y SEO Local en ${pueblo.comarca}`;
const description = pueblo.sectorPrincipal
  ? `Diseño web en ${pueblo.nombre} para ${pueblo.sectorPrincipal.slice(0, 45)}. Desde 500€ con hosting gratis de por vida. Presupuesto en 24h.`
  : `Diseño web en ${pueblo.nombre}, ${pueblo.comarca}. Desde 500€ con hosting gratis. SEO local incluido. Presupuesto gratis en 24h.`;

// Indexación selectiva: solo los pueblos del Tier 1 (lista blanca) se indexan.
// El resto se sirve con noindex para evitar el estado "Descubierta: actualmente
// sin indexar" provocado por el exceso de landings locales casi idénticas.
const noindex = !esPuebloIndexable(pueblo.slug);

---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={`https://platanitorico.com/diseno-web/${pueblo.slug}/`}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt={`Diseño web en ${pueblo.nombre} - Platanito Rico`}
  type="website"
  lang="es"
  keywords={`diseño web ${pueblo.nombre}, agencia web ${pueblo.comarca}, páginas web ${pueblo.nombre}, seo ${pueblo.nombre}, tienda online ${pueblo.nombre}`}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://platanitorico.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Diseño Web Almería",
          "item": "https://platanitorico.com/desarrollo-web/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": pueblo.nombre,
          "item": `https://platanitorico.com/diseno-web/${pueblo.slug}/`
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": `Platanito Rico — Diseño Web en ${pueblo.nombre}`,
      "url": `https://platanitorico.com/diseno-web/${pueblo.slug}/`,
      "telephone": "+34657085019",
      "email": "hola@platanitorico.com",
      "priceRange": "€€",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ctra de Ronda, 82",
        "addressLocality": "Vera",
        "addressRegion": "Almería",
        "postalCode": "04620",
        "addressCountry": "ES"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": "37.2450", "longitude": "-1.8614" },
      "areaServed": { "@type": "City", "name": pueblo.nombre },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "87",
        "bestRating": "5",
        "worstRating": "1"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Diseño Web",
      "name": `Diseño Web en ${pueblo.nombre}`,
      "description": description,
      "url": `https://platanitorico.com/diseno-web/${pueblo.slug}/`,
      "areaServed": {
        "@type": "City",
        "name": pueblo.nombre,
        "containedInPlace": {
          "@type": "AdministrativeArea",
          "name": pueblo.comarca
        }
      },
      "provider": {
        "@type": "LocalBusiness",
        "name": "Platanito Rico",
        "url": "https://platanitorico.com",
        "telephone": "+34657085019",
        "email": "hola@platanitorico.com",
        "priceRange": "€€",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Ctra de Ronda, 82",
          "addressLocality": "Vera",
          "addressRegion": "Almería",
          "postalCode": "04620",
          "addressCountry": "ES"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "37.2450",
          "longitude": "-1.8614"
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": `Servicios Web en ${pueblo.nombre}`,
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Diseño Web Profesional",
              "description": `Sitios web personalizados para empresas de ${pueblo.nombre}`
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "SEO Local",
              "description": `Posicionamiento en Google para negocios de ${pueblo.nombre}`
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Tienda Online",
              "description": `E-commerce para vender desde ${pueblo.nombre}`
            }
          }
        ]
      }
    },
    ...(pueblo.faqs && pueblo.faqs.length > 0 ? [{
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": pueblo.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }] : []),
  ]}
>
  <Header />

  <main id="main-content">
    {/* HERO editorial del pueblo */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º {String(pueblo.poblacion ? Math.min(99, Math.floor(pueblo.poblacion / 1000)) : 10).padStart(3, '0')} — {pueblo.comarca}</span>
          <span class="text-meta">
            <span class="live-dot"></span>
            {pueblo.destacado ? 'Localidad destacada · proyectos activos' : `Cobertura · ${pueblo.comarca}`}
          </span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Diseño Web · {pueblo.comarca}</span>
            <h1 class="svc-hero__title">
              Diseño web
              <em>en {pueblo.nombre},</em>
              <span class="text-stroke-ink">SEO local</span>
              que vende.
            </h1>
            <p class="svc-hero__lead">
              {pueblo.descripcion} Creamos <strong>páginas web profesionales</strong>
              que impulsan tu negocio y te posicionan en Google para búsquedas locales en {pueblo.nombre}.
            </p>

            <div class="pueblo-tags">
              {pueblo.caracteristicas.slice(0, 4).map((tag) => (
                <span class="tag-brutal">★ {tag}</span>
              ))}
            </div>

            <div class="svc-hero__cta">
              <a href="/contacto/" class="btn-brutal btn-brutal--lg">
                Presupuesto en 24h →
              </a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">
                657 085 019
              </a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">500€</span>
              <span class="svc-hero__spec-lbl">Desde · web pro</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">0€</span>
              <span class="svc-hero__spec-lbl">Hosting web estática</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">1–2sem</span>
              <span class="svc-hero__spec-lbl">A producción</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">99/100</span>
              <span class="svc-hero__spec-lbl">Lighthouse target</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ {pueblo.nombre.toUpperCase()} ★ {pueblo.comarca.toUpperCase()} ★ DISEÑO WEB ★ SEO LOCAL ★ HOSTING GRATIS ★</span>
          ))}
        </div>
      </div>
    </section>

    {/* Panorama digital local — contenido ÚNICO por pueblo (anti contenido fino) */}
    <section class="section-brutal pueblo-panorama">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">★ Panorama digital · {pueblo.nombre}</span>
            <h2 class="brutal-section-head__title">
              El tejido de
              <em>{pueblo.nombre}</em>
              en internet.
            </h2>
          </div>
          <p class="brutal-section-head__lead">{pueblo.descripcion}.</p>
        </header>

        <div class="pueblo-panorama__grid">
          <div class="pueblo-panorama__text">
            {pueblo.panorama && pueblo.panorama.length > 0
              ? pueblo.panorama.map((p) => <p class="pueblo-panorama__p">{p}</p>)
              : (
                <p class="pueblo-panorama__p">
                  {pueblo.nombre} ({pueblo.comarca}{pueblo.poblacion ? `, ${pueblo.poblacion.toLocaleString('es-ES')} habitantes` : ''}) es {pueblo.descripcion.charAt(0).toLowerCase() + pueblo.descripcion.slice(1)}.
                  {pueblo.lugarIconico ? ` Con ${pueblo.lugarIconico} como referencia, sus` : ' Sus'} negocios —comercio, hostelería, servicios y turismo— compiten cada día en Google por aparecer cuando un cliente busca {pueblo.sectorPrincipal ? pueblo.sectorPrincipal.toLowerCase() : 'servicios'} en {pueblo.nombre}. Una web rápida, bien estructurada y posicionada en local es la diferencia entre captar a ese cliente o perderlo ante la competencia de la comarca.
                </p>
              )
            }
            <ul class="pueblo-panorama__keys">
              {pueblo.caracteristicas.map((c) => <li class="tag-brutal">★ {c}</li>)}
            </ul>
          </div>

          {pueblo.hitos && pueblo.hitos.length > 0 && (
            <ul class="pueblo-panorama__hitos">
              {pueblo.hitos.map((h) => (
                <li class="pueblo-panorama__hito">
                  <span class="pueblo-panorama__hk">{h.k}</span>
                  <span class="pueblo-panorama__hv">{h.v}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>

    {/* Mapa interactivo si hay coords */}
    {pueblo.coords && (
      <section class="section-brutal" style="padding:0;background:var(--brutal-bg-alt);border-bottom:2px solid var(--brutal-ink);">
        <div class="pueblo-map-wrap">
          <InteractiveMap center={pueblo.coords} zoom={13} pitch={25} bearing={-15} label={pueblo.nombre} themeColor="#FF6B35" themeColorDark="#0E0D0B" townInitial={pueblo.nombre.charAt(0)} />
        </div>
      </section>
    )}

    {/* SERVICIOS — bento brutal */}
    <section class="section-brutal" id="servicios">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 01 / Servicios para {pueblo.nombre}</span>
            <h2 class="brutal-section-head__title">
              Qué hacemos por
              <em>tu negocio.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Seis servicios que cubren todo el ciclo digital: desde la web
            hasta el SEO local, el e-commerce y el mantenimiento mensual.
          </p>
        </header>

        <ol class="svc-bento">
          {servicios.map((s, i) => {
            const accents = ['accent', 'paper', 'lime', 'paper', 'ink', 'paper'];
            const accent = accents[i % accents.length];
            return (
              <li class={`svc-card svc-card--${accent}`}>
                <header class="svc-card__head">
                  <span class="svc-card__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-card__kicker">{pueblo.nombre}</span>
                </header>
                <h3 class="svc-card__title">{s.titulo}</h3>
                <p class="svc-card__desc">{s.descripcion}</p>
                <ul class="svc-card__features">
                  {s.beneficios.map((b) => (
                    <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{b}</span></li>
                  ))}
                </ul>
                <footer class="svc-card__foot">
                  <div class="svc-card__figure">
                    <span class="svc-card__figure-val">★</span>
                    <span class="svc-card__figure-lbl">Para {pueblo.comarca}</span>
                  </div>
                  <a href="/contacto/" class="svc-card__cta">Pedir →</a>
                </footer>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    {/* Sector principal + especificaciones */}
    {pueblo.sectorPrincipal && (
      <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 02 / Especialización en {pueblo.nombre}</span>
              <h2 class="brutal-section-head__title">
                Conocemos
                <em>tu sector.</em>
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Trabajamos con negocios del sector
              <strong> {pueblo.sectorPrincipal.toLowerCase()}</strong> en {pueblo.nombre}.
              Conocemos el mercado local y los códigos visuales del sector.
            </p>
          </header>

          <dl class="spec-list" style="max-width:760px;margin:2rem auto 0;">
            <div><dt class="spec-k">Localidad</dt><dd class="spec-v">{pueblo.nombre}</dd></div>
            <div><dt class="spec-k">Comarca</dt><dd class="spec-v">{pueblo.comarca}</dd></div>
            {pueblo.poblacion && <div><dt class="spec-k">Población</dt><dd class="spec-v">{pueblo.poblacion.toLocaleString('es-ES')} habitantes</dd></div>}
            <div><dt class="spec-k">Sector principal</dt><dd class="spec-v">{pueblo.sectorPrincipal}</dd></div>
            {pueblo.lugarIconico && <div><dt class="spec-k">Lugar icónico</dt><dd class="spec-v">{pueblo.lugarIconico}</dd></div>}
            <div><dt class="spec-k">Cobertura</dt><dd class="spec-v">Reuniones presenciales · entregas remotas</dd></div>
          </dl>
        </div>
      </section>
    )}

    {/* Sectores locales si existen */}
    {pueblo.sectores && pueblo.sectores.length > 0 && (
      <section class="section-brutal">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 03 / Quién contrata en {pueblo.nombre}</span>
              <h2 class="brutal-section-head__title">
                Para
                <em>quién diseñamos</em>
                en {pueblo.nombre}.
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Sectores locales que ya venden más online con una web hecha
              con criterio. Identifica el tuyo y pide presupuesto.
            </p>
          </header>

          <ul class="svc-sectors">
            {pueblo.sectores.map((s, i) => (
              <li class={`svc-sector svc-sector--${i % 3}`}>
                <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
                <h3 class="svc-sector__title">{s.nombre}</h3>
                <p class="svc-sector__desc">{s.descripcion}</p>
                {s.keywords && s.keywords.length > 0 && (
                  <div class="pueblo-sector-keys">
                    {s.keywords.slice(0, 3).map((k) => <span class="tag-brutal">{k}</span>)}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Por qué nosotros */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Por qué Platanito Rico</span>
            <h2 class="brutal-section-head__title">
              Estudio local
              <em>con criterio.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            No somos una agencia genérica que vende plantillas. Conocemos
            {' '}{pueblo.comarca} y entendemos las necesidades específicas de
            negocios de {pueblo.nombre}.
          </p>
        </header>

        <ul class="svc-sectors">
          {razones.map((r, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">★ Razón {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{r.titulo}</h3>
              <p class="svc-sector__desc">{r.descripcion}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Proceso */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Método</span>
            <h2 class="brutal-section-head__title">
              De cero a producción
              <em>en 2 semanas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases con entregables claros. Sin sorpresas, sin retrasos —
            sabes exactamente qué pasa en cada paso.
          </p>
        </header>

        <ol class="svc-process">
          {proceso.map((p, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < proceso.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{String(p.paso).padStart(2, '0')}</span>
                <span class="svc-process__eta">Fase {p.paso}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{p.titulo}</h3>
                <p class="svc-process__body">{p.descripcion}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* Testimonios locales si existen */}
    {pueblo.testimonios && pueblo.testimonios.length > 0 && (
      <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 06 / Voces de {pueblo.nombre}</span>
              <h2 class="brutal-section-head__title">
                Lo que dicen
                <em>negocios locales.</em>
              </h2>
            </div>
          </header>

          <figure class="svc-pull">
            <div class="svc-pull__marks" aria-hidden="true">“</div>
            <blockquote class="svc-pull__quote">{pueblo.testimonios[0].texto}</blockquote>
            <figcaption class="svc-pull__cap">
              <span class="svc-pull__avatar">{pueblo.testimonios[0].nombre[0]}</span>
              <div>
                <span class="svc-pull__name">{pueblo.testimonios[0].nombre}</span>
                <span class="svc-pull__role">{pueblo.testimonios[0].sector} · {pueblo.nombre}</span>
              </div>
            </figcaption>
          </figure>

          {pueblo.testimonios.length > 1 && (
            <ul class="svc-quotes">
              {pueblo.testimonios.slice(1, 4).map((t, i) => (
                <li class={`svc-quote svc-quote--${i}`}>
                  <p>"{t.texto}"</p>
                  <footer>
                    <span class="svc-quote__avatar">{t.nombre[0]}</span>
                    <div>
                      <span class="svc-quote__name">{t.nombre}</span>
                      <span class="svc-quote__role">{t.sector}</span>
                    </div>
                  </footer>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    {/* FAQs locales si existen */}
    {pueblo.faqs && pueblo.faqs.length > 0 && (
      <section class="section-brutal">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 07 / Preguntas en {pueblo.nombre}</span>
              <h2 class="brutal-section-head__title">
                Lo que más
                <em>nos preguntan.</em>
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Plazos, precios, hosting, SEO local y reuniones presenciales en
              {' '}{pueblo.nombre}. Si no está aquí, escríbenos y respondemos en 24h.
            </p>
          </header>

          <ol class="svc-faq">
            {pueblo.faqs.map((f, i) => (
              <li class="svc-faq__item">
                <details class="svc-faq__details" open={i === 0}>
                  <summary class="svc-faq__sum">
                    <span class="svc-faq__num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="svc-faq__q">{f.q}</span>
                    <span class="svc-faq__toggle" aria-hidden="true">+</span>
                  </summary>
                  <div class="svc-faq__answer"><p>{f.a}</p></div>
                </details>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {/* Otros pueblos de la comarca */}
    {(() => {
      const otros = getPueblosByComarca(pueblo.comarca).filter(p => p.slug !== pueblo.slug).slice(0, 8);
      return otros.length > 0 ? (
        <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);">
          <div class="container-brutal">
            <header class="brutal-section-head">
              <div class="brutal-section-head__col">
                <span class="text-meta">Cap. 08 / Cobertura {pueblo.comarca}</span>
                <h2 class="brutal-section-head__title">
                  También en
                  <em>tu comarca.</em>
                </h2>
              </div>
              <p class="brutal-section-head__lead">
                Otras localidades de {pueblo.comarca} donde ya trabajamos.
                Si tu pueblo no está, escríbenos — cubrimos toda Almería.
              </p>
            </header>

            <ul class="cobertura-grid" style="margin-top:2rem;">
              {otros.map((p, i) => (
                <li>
                  <a href={`/diseno-web/${p.slug}/`} class={`cobertura-tile cobertura-tile--${i % 6}`}>
                    <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
                    <span class="cobertura-tile__name heading-display">{p.nombre}</span>
                    <span class="cobertura-tile__sub text-mono">{p.comarca}</span>
                    <span class="cobertura-tile__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>

            <div style="margin-top:2rem;text-align:center;">
              <a href="/diseno-web/" class="btn-brutal btn-brutal--ghost btn-brutal--lg">
                Ver todos los municipios con diseño web en Almería →
              </a>
            </div>
          </div>
        </section>
      ) : null;
    })()}

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="svc-final__title">
            ¿Empezamos tu web en
            <em>{pueblo.nombre}?</em>
          </h2>
          <p class="svc-final__text">
            Cuéntanos tu proyecto y te enviamos presupuesto detallado en 24h.
            Hosting gratuito para webs estáticas, sin permanencia, soporte local
            en {pueblo.comarca}.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto/" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
    <ServiciosPueblo pueblo={pueblo.nombre} />

  </main>

  <Footer />
</BaseLayout>

