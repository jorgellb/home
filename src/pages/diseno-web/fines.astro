<style>
  /* ═══════════════════════════════════════════════ */
  /* FINES DESIGN SYSTEM                              */
  /* ═══════════════════════════════════════════════ */

  :root {
    --fn-paper:    #F5F0E8;
    --fn-paper-2:  #E8E0D0;
    --fn-stone:    #D1C9B8;
    --fn-ink:      #1A1816;
    --fn-marble:   #A09888;
    --fn-terrazo:  #B89850;
    --fn-accent:   #D97A3A;
    --fn-blue:     #3A5A7A;
    --fn-shadow:   8px 8px 0 var(--fn-ink);
  }

  .fn-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--fn-accent);
    box-shadow: 0 0 0 0 rgba(217,122,58,0.55);
    animation: fn-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes fn-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(217,122,58,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(217,122,58,0); }
    100% { box-shadow: 0 0 0 0 rgba(217,122,58,0); }
  }
  .fn-pull__spin { transform-origin: 50% 50%; animation: fn-spin 24s linear infinite; }
  @keyframes fn-spin { to { transform: rotate(360deg); } }
  .fn-final-gear { transform-origin: 50% 50%; animation: fn-gear-spin 20s linear infinite; }
  @keyframes fn-gear-spin { to { transform: rotate(360deg); } }
  .fn-tripiana-svg .fn-tripiana-gear { transform-origin: 50% 50%; animation: fn-gear-spin 18s linear infinite; }

  /* HERO */
  .fn-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 65% 30%, rgba(217,122,58,0.08), transparent 50%),
      radial-gradient(circle at 30% 70%, rgba(58,90,122,0.08), transparent 50%),
      var(--fn-paper);
    border-bottom: 3px solid var(--fn-ink);
    position: relative;
    overflow: hidden;
  }
  .fn-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(45deg, transparent 0 22px, rgba(217,122,58,0.05) 22px 23px, transparent 23px 44px),
      linear-gradient(-45deg, transparent 0 22px, rgba(217,122,58,0.05) 22px 23px, transparent 23px 44px);
    pointer-events: none;
  }
  .fn-hero > * { position: relative; }
  .fn-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .fn-hero__status { color: var(--fn-accent); font-weight: 700; }
  .fn-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .fn-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .fn-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .fn-hero__chapter { color: var(--fn-blue); }
  .fn-hero__title { font-size: clamp(2.5rem, 7vw, 5rem); line-height: .92; letter-spacing: -.04em; margin: .25rem 0; }
  .fn-hero__title em { color: var(--fn-blue); font-style: italic; }
  .fn-hero__title-stamp { display: inline-block; color: var(--fn-paper); background: var(--fn-accent); padding: 0 .2em; transform: rotate(-1deg); }
  .fn-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 54ch; }
  .fn-hero__lead strong { color: var(--fn-ink); font-weight: 700; }
  .fn-hero__lead em { color: var(--fn-accent); font-style: italic; font-weight: 600; }
  .fn-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .fn-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--fn-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .fn-btn--primary { background: var(--fn-accent); color: var(--fn-paper); box-shadow: 6px 6px 0 var(--fn-ink); }
  .fn-btn--primary:hover { background: var(--fn-blue); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--fn-ink); }
  .fn-btn--ghost { background: transparent; color: var(--fn-ink); box-shadow: 6px 6px 0 var(--fn-terrazo); }
  .fn-btn--ghost:hover { background: var(--fn-ink); color: var(--fn-terrazo); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--fn-terrazo); }

  /* KPIs */
  .fn-kpis { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; margin-top: 1.5rem; border: 2.5px solid var(--fn-ink); background: var(--fn-ink); }
  @media (min-width: 768px) { .fn-kpis { grid-template-columns: repeat(4, 1fr); } }
  .fn-kpi { background: var(--fn-paper); padding: 1.25rem; display: flex; flex-direction: column; gap: .35rem; border-right: 2px solid var(--fn-ink); border-bottom: 2px solid var(--fn-ink); }
  .fn-kpi:nth-child(2n) { border-right: none; }
  .fn-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .fn-kpi:nth-child(2n)       { border-right: 2px solid var(--fn-ink); }
    .fn-kpi:nth-child(4n)       { border-right: none; }
    .fn-kpi:nth-last-child(-n+2)  { border-bottom: 2px solid var(--fn-ink); }
    .fn-kpi:nth-last-child(-n+4)  { border-bottom: none; }
  }
  .fn-kpi--stone  { background: var(--fn-stone); color: var(--fn-ink); }
  .fn-kpi--accent { background: var(--fn-accent); color: var(--fn-paper); }
  .fn-kpi--blue   { background: var(--fn-blue); color: var(--fn-paper); }
  .fn-kpi--ink    { background: var(--fn-ink); color: var(--fn-paper); }
  .fn-kpi--ink .fn-kpi__v { color: var(--fn-terrazo); }
  .fn-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .fn-kpi__v small { font-size: .55em; opacity: .8; }
  .fn-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .fn-hero__postcard { width: 100%; max-width: 540px; margin: 0 auto; filter: drop-shadow(0 14px 30px rgba(26,24,22,0.18)); }
  .fn-postcard { background: var(--fn-paper); border: 3px solid var(--fn-ink); box-shadow: var(--fn-shadow); overflow: hidden; transform: rotate(-1deg); transition: transform .35s; }
  .fn-postcard:hover { transform: rotate(0); }
  .fn-postcard__head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; padding: .65rem 1rem; background: var(--fn-ink); color: var(--fn-paper); font-size: .58rem; letter-spacing: .15em; border-bottom: 2px solid var(--fn-ink); }
  .fn-postcard__profile { width: 100%; aspect-ratio: 540 / 220; border-bottom: 2px solid var(--fn-ink); overflow: hidden; }
  .fn-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--fn-ink); }
  .fn-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.1); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .fn-postcard:hover .fn-postcard__img { transform: scale(1.05); }
  .fn-postcard__gear { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(10deg); filter: drop-shadow(0 4px 10px rgba(217,122,58,0.5)); }
  .fn-postcard__tag { position: absolute; bottom: 12px; left: 12px; background: var(--fn-paper); color: var(--fn-ink); padding: .4rem .75rem; font-size: .65rem; font-weight: 800; letter-spacing: .2em; border: 2px solid var(--fn-ink); box-shadow: 3px 3px 0 var(--fn-accent); transform: rotate(-2deg); }
  .fn-postcard__data { padding: 1rem 1.25rem; background: var(--fn-paper-2); display: grid; gap: .35rem; }
  .fn-postcard__data-row { display: flex; justify-content: space-between; align-items: center; padding-bottom: .35rem; border-bottom: 1px dashed rgba(26,24,22,0.15); font-size: .68rem; }
  .fn-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .fn-postcard__data-row > span:first-child { color: var(--fn-blue); letter-spacing: .2em; font-weight: 800; }
  .fn-postcard__data-v { color: var(--fn-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .fn-marquee { background: var(--fn-ink); color: var(--fn-terrazo); overflow: hidden; padding: .9rem 0; border-top: 3px solid var(--fn-ink); }
  .fn-marquee__track { display: flex; gap: 3rem; width: max-content; animation: fn-marquee 42s linear infinite; font-family: var(--font-mono); font-size: .82rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  @keyframes fn-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ICONOS */
  .fn-iconos-section { background: var(--fn-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--fn-ink); position: relative; overflow: hidden; }
  .fn-iconos-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(217,122,58,0.04) 1.2px, transparent 1.2px); background-size: 24px 24px; pointer-events: none; }
  .fn-iconos-section > * { position: relative; }
