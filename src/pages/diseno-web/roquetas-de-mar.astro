<style>
  /* ══════════════════════════════════════════════════════
     PALETA · ROQUETAS · CAPITAL TURÍSTICA
     ══════════════════════════════════════════════════════ */
  .rq {
    --rq-paper:    #FFFCF6;
    --rq-paper-2:  #F4E8D0;
    --rq-arena:    #EAD9B5;
    --rq-ink:      #0E0D0B;
    --rq-azul:     #0099CC;       /* Bandera azul FEE */
    --rq-azul-d:   #005F80;
    --rq-turquesa: #00B8C7;       /* Mar turquesa */
    --rq-sol:      #FFD230;
    --rq-coral:    #FF6B6B;       /* Coral resort */
    --rq-morado:   #9b5de5;       /* Atardecer */
    --rq-green:    #43AA8B;       /* Golf */
    --rq-lima:     #D6FF44;
    --rq-shadow:   8px 8px 0 var(--rq-ink);
  }
  .rq-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--rq-azul);
    box-shadow: 0 0 0 0 rgba(0,153,204,0.55);
    animation: rq-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes rq-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(0,153,204,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(0,153,204,0); }
    100% { box-shadow: 0 0 0 0 rgba(0,153,204,0); }
  }
  .rq-spin { transform-origin: 50% 50%; animation: rq-spin 28s linear infinite; }
  @keyframes rq-spin { to { transform: rotate(360deg); } }

  /* HERO */
  .rq-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(0,153,204,0.10), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(255,210,48,0.10), transparent 50%),
      var(--rq-paper);
    border-bottom: 3px solid var(--rq-ink);
    position: relative;
    overflow: hidden;
  }
  .rq-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(120deg, transparent 0 40px, rgba(0,184,199,0.04) 40px 41px);
    pointer-events: none;
  }
  .rq-hero > * { position: relative; }
  .rq-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .rq-hero__status { color: var(--rq-azul); font-weight: 700; }
  .rq-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .rq-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .rq-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .rq-hero__chapter { color: var(--rq-azul); }
  .rq-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .rq-hero__title em { color: var(--rq-azul); font-style: italic; }
  .rq-hero__title-stamp {
    display: inline-block;
    color: var(--rq-paper);
    background: var(--rq-coral);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .rq-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 54ch; }
  .rq-hero__lead strong { color: var(--rq-ink); font-weight: 700; }
  .rq-hero__lead em { color: var(--rq-coral); font-style: italic; font-weight: 600; }
  .rq-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .rq-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--rq-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .rq-btn--primary { background: var(--rq-azul); color: var(--rq-paper); box-shadow: 6px 6px 0 var(--rq-ink); }
  .rq-btn--primary:hover { background: var(--rq-coral); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--rq-ink); }
  .rq-btn--ghost { background: transparent; color: var(--rq-ink); box-shadow: 6px 6px 0 var(--rq-azul); }
  .rq-btn--ghost:hover { background: var(--rq-ink); color: var(--rq-sol); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--rq-azul); }

  /* KPIs */
  .rq-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--rq-ink);
    background: var(--rq-ink);
  }
  @media (min-width: 768px) { .rq-kpis { grid-template-columns: repeat(4, 1fr); } }
  .rq-kpi {
    background: var(--rq-paper); padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--rq-ink); border-bottom: 2px solid var(--rq-ink);
  }
  .rq-kpi:nth-child(2n) { border-right: none; }
  .rq-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .rq-kpi:nth-child(2n)      { border-right: 2px solid var(--rq-ink); }
    .rq-kpi:nth-child(4n)      { border-right: none; }
    .rq-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--rq-ink); }
    .rq-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .rq-kpi--azul  { background: var(--rq-azul); color: var(--rq-paper); }
  .rq-kpi--sol   { background: var(--rq-sol); color: var(--rq-ink); }
  .rq-kpi--coral { background: var(--rq-coral); color: var(--rq-paper); }
  .rq-kpi--ink   { background: var(--rq-ink); color: var(--rq-paper); }
  .rq-kpi--ink .rq-kpi__v { color: var(--rq-sol); }
  .rq-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .rq-kpi__v small { font-size: .55em; opacity: .8; }
  .rq-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .rq-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(14,13,11,0.18));
  }
  .rq-postcard {
    background: var(--rq-paper);
    border: 3px solid var(--rq-ink);
    box-shadow: var(--rq-shadow);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .35s;
  }
  .rq-postcard:hover { transform: rotate(0); }
  .rq-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--rq-azul);
    color: var(--rq-paper);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--rq-ink);
  }
  .rq-postcard__profile {
    width: 100%; aspect-ratio: 540 / 240;
    border-bottom: 2px solid var(--rq-ink);
    overflow: hidden;
  }
  .rq-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--rq-ink); }
  .rq-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.1); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .rq-postcard:hover .rq-postcard__img { transform: scale(1.05); }
  .rq-postcard__seal { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(-10deg); filter: drop-shadow(0 4px 10px rgba(0,153,204,0.5)); }
  .rq-postcard__tag {
    position: absolute; bottom: 12px; left: 12px;
    background: var(--rq-sol); color: var(--rq-ink);
    padding: .4rem .75rem;
    font-size: .65rem; font-weight: 800; letter-spacing: .2em;
    border: 2px solid var(--rq-ink);
    box-shadow: 3px 3px 0 var(--rq-azul);
    transform: rotate(-2deg);
  }
  .rq-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--rq-paper-2);
    display: grid; gap: .35rem;
  }
  .rq-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
    font-size: .68rem;
  }
  .rq-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .rq-postcard__data-row > span:first-child { color: var(--rq-azul-d); letter-spacing: .2em; font-weight: 800; }
  .rq-postcard__data-v { color: var(--rq-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .rq-marquee {
    background: var(--rq-azul); color: var(--rq-paper);
    overflow: hidden; padding: .9rem 0;
    border-top: 3px solid var(--rq-ink);
  }
  .rq-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: rq-marquee 36s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem; font-weight: 800;
    letter-spacing: .15em; text-transform: uppercase;
  }
  @keyframes rq-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* BANDERA AZUL SECTION */
  .rq-flag-section {
    background: var(--rq-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--rq-ink);
    position: relative;
    overflow: hidden;
  }
  .rq-flag-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(0,153,204,0.05) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .rq-flag-section > * { position: relative; }
  .rq-flag-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .rq-flag-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .rq-flag-chapter { color: var(--rq-azul); }
  .rq-flag-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; }
  .rq-flag-title em { color: var(--rq-azul); }
  .rq-flag-lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); margin-bottom: 1.5rem; max-width: 54ch; }
  .rq-flag-lead strong { color: var(--rq-azul-d); font-weight: 700; }
  .rq-flag-lead em { color: var(--rq-coral); font-style: italic; }
  .rq-flag-facts {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2px solid var(--rq-ink); background: var(--rq-paper);
  }
  @media (min-width: 640px) { .rq-flag-facts { grid-template-columns: 1fr 1fr; } }
  .rq-flag-facts li { padding: .85rem 1rem; border-bottom: 1px solid var(--rq-ink); display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 640px) {
    .rq-flag-facts li:nth-child(odd) { border-right: 1px solid var(--rq-ink); }
    .rq-flag-facts li:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .rq-flag-facts li:last-child { border-bottom: none; } }
  .rq-flag-facts__k { font-size: .58rem; letter-spacing: .2em; color: var(--rq-coral); font-weight: 800; }
  .rq-flag-facts__v { font-size: .9rem; color: var(--rq-ink); font-weight: 600; line-height: 1.35; }
  .rq-flag-r { max-width: 360px; margin: 0 auto; }
  .rq-flag-wave { transform-origin: 54px 113px; animation: rq-flag-wave 3s ease-in-out infinite; }
  @keyframes rq-flag-wave {
    0%, 100% { transform: skewX(0deg) skewY(0deg); }
    50%      { transform: skewX(-3deg) skewY(1deg); }
  }

  /* ICONOS */
  .rq-iconos-section { background: var(--rq-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--rq-ink); }
  .rq-iconos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 1024px) { .rq-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .rq-icono {
    position: relative;
    background: var(--rq-paper);
    border: 3px solid var(--rq-ink);
    box-shadow: var(--rq-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .rq-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .rq-icono--turquesa { color: var(--rq-turquesa); }
  .rq-icono--coral    { color: var(--rq-coral); }
  .rq-icono--sun      { color: var(--rq-sol); }
  .rq-icono__code {
    position: absolute; top: -16px; right: 20px;
    background: var(--rq-ink); color: var(--rq-sol);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .rq-icono__svg { width: 100%; aspect-ratio: 1; max-width: 200px; margin: 0 auto; color: currentColor; }
  .rq-icono__name { font-size: clamp(1.5rem, 2.8vw, 1.85rem); line-height: 1; letter-spacing: -.025em; color: var(--rq-ink); margin: .5rem 0 0; text-align: center; }
  .rq-icono__sub { font-size: .62rem; letter-spacing: .25em; color: currentColor; font-weight: 800; text-align: center; }
  .rq-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; text-align: center; }
  .rq-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .rq-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* IDIOMAS */
  .rq-idiomas-section { background: var(--rq-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--rq-ink); }
  .rq-idiomas {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 1.25rem;
  }
  @media (min-width: 640px)  { .rq-idiomas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .rq-idiomas { grid-template-columns: repeat(4, 1fr); } }
  .rq-idioma {
    background: var(--rq-paper);
    border: 2.5px solid var(--rq-ink);
    box-shadow: 6px 6px 0 var(--rq-ink);
    transition: transform .25s, box-shadow .25s;
  }
  .rq-idioma:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--rq-azul); }
  .rq-idioma__head {
    display: grid; grid-template-columns: 50px 1fr auto;
    gap: .85rem; align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 2px solid var(--rq-ink);
    background: var(--rq-paper-2);
  }
  .rq-idioma__flag { width: 50px; flex-shrink: 0; border: 1.5px solid var(--rq-ink); line-height: 0; }
  .rq-idioma__head-r { display: flex; flex-direction: column; gap: 2px; }
  .rq-idioma__code { font-size: 1.25rem; font-weight: 800; color: var(--rq-coral); letter-spacing: .1em; line-height: 1; }
  .rq-idioma__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--rq-ink); }
  .rq-idioma__pct {
    background: var(--rq-azul); color: var(--rq-paper);
    padding: .35rem .55rem;
    font-family: var(--font-mono);
    font-size: .9rem; font-weight: 800;
    border: 1.5px solid var(--rq-ink);
  }
  .rq-idioma__body { padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: .65rem; }
  .rq-idioma__row {
    display: flex; flex-direction: column; gap: 2px;
    padding-bottom: .5rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
  }
  .rq-idioma__row:last-child { border-bottom: none; padding-bottom: 0; }
  .rq-idioma__k { font-size: .55rem; letter-spacing: .2em; color: var(--rq-azul-d); font-weight: 800; }
  .rq-idioma__v { font-size: .85rem; color: var(--rq-ink); line-height: 1.35; }
  .rq-idioma__keyword { font-family: var(--font-mono); color: var(--rq-coral); font-weight: 700; }
  .rq-idiomas-note {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--rq-azul);
    color: var(--rq-paper);
    border: 2px solid var(--rq-ink);
    font-size: .9rem;
    line-height: 1.5;
  }
  .rq-idiomas-note strong { color: var(--rq-sol); }

  /* HITOS */
  .rq-hitos-section {
    background: var(--rq-ink); color: var(--rq-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--rq-ink);
    position: relative; overflow: hidden;
  }
  .rq-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(0,153,204,0.08) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .rq-hitos-section > * { position: relative; }
  .rq-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2.5px solid var(--rq-paper);
  }
  @media (min-width: 640px)  { .rq-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .rq-hitos { grid-template-columns: repeat(3, 1fr); } }
  .rq-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(255,252,246,0.25);
    border-right: 1px solid rgba(255,252,246,0.25);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(255,252,246,0.04);
    transition: background .25s;
  }
  .rq-hito:hover { background: rgba(0,153,204,0.18); }
  @media (min-width: 1024px) {
    .rq-hito:nth-child(3n) { border-right: none; }
    .rq-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .rq-hito:nth-child(2n) { border-right: none; }
    .rq-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .rq-hito { border-right: none; } .rq-hito:last-child { border-bottom: none; } }
  .rq-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--rq-sol); font-weight: 800; }
  .rq-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--rq-paper); line-height: 1.35; }

  /* SECTORES */
  .rq-sec-section { background: var(--rq-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--rq-ink); }
  .rq-sec { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px)  { .rq-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .rq-sec { grid-template-columns: repeat(3, 1fr); } }
  .rq-sec__card {
    background: var(--rq-paper);
    border: 2.5px solid var(--rq-ink);
    box-shadow: var(--rq-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
  }
  .rq-sec__card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: currentColor; }
  .rq-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .rq-sec__card--azul     { color: var(--rq-azul); }
  .rq-sec__card--coral    { color: var(--rq-coral); }
  .rq-sec__card--turquesa { color: var(--rq-turquesa); }
  .rq-sec__card--green    { color: var(--rq-green); }
  .rq-sec__card--sol      { color: var(--rq-sol); }
  .rq-sec__card--morado   { color: var(--rq-morado); }
  .rq-sec__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; gap: .5rem; }
  .rq-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .rq-sec__stat-box {
    background: var(--rq-ink); color: var(--rq-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .rq-sec__stat-v { font-size: .95rem; font-weight: 800; color: currentColor; line-height: 1; }
  .rq-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .rq-sec__title { font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.1; letter-spacing: -.02em; color: var(--rq-ink); margin: 0; }
  .rq-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; }
  .rq-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .rq-sec__tag { display: flex; align-items: flex-start; gap: .35rem; font-size: .78rem; line-height: 1.35; color: var(--rq-ink); }
  .rq-sec__tag span { color: currentColor; font-weight: 800; }
  .rq-sec__foot { padding-top: .65rem; border-top: 2px solid var(--rq-ink); }
  .rq-sec__cta { font-family: var(--font-mono); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .15em; color: currentColor; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px; }

  /* MAPA */
  .rq-map-section { background: var(--rq-arena); border-bottom: 3px solid var(--rq-ink); }
  .rq-map-head { padding: 4rem 0 2rem; }
  .rq-map-head__inner { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; }
  @media (min-width: 768px) { .rq-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .rq-map-chapter { color: var(--rq-azul); }
  .rq-map-title { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0 0; }
  .rq-map-title em { color: var(--rq-azul); }
  .rq-map-coords {
    background: var(--rq-azul); color: var(--rq-paper);
    padding: 1rem 1.25rem;
    border: 2px solid var(--rq-ink);
    box-shadow: 5px 5px 0 var(--rq-sol);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem; letter-spacing: .15em;
  }
  .rq-map-frame { border-top: 3px solid var(--rq-ink); border-bottom: 3px solid var(--rq-ink); background: var(--rq-ink); }
  .rq-map-wrap > * { width: 100%; }

  /* DIFERENCIALES */
  .rq-dif-section { background: var(--rq-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--rq-ink); }
  .rq-dif { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 0; border: 2px solid var(--rq-ink); }
  @media (min-width: 768px) { .rq-dif { grid-template-columns: 1fr 1fr; } }
  .rq-dif__item { padding: 1.75rem 1.5rem; border-bottom: 1px solid var(--rq-ink); display: flex; flex-direction: column; gap: .65rem; transition: background .2s; }
  @media (min-width: 768px) {
    .rq-dif__item:nth-child(odd) { border-right: 1px solid var(--rq-ink); }
    .rq-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) { .rq-dif__item:last-child { border-bottom: none; } }
  .rq-dif__item--0 { background: var(--rq-paper-2); }
  .rq-dif__item--1 { background: var(--rq-paper); }
  .rq-dif__item--2 { background: var(--rq-arena); }
  .rq-dif__item--3 { background: var(--rq-paper); }
  .rq-dif__item:hover { background: var(--rq-sol); }
  .rq-dif__num { font-size: .85rem; color: var(--rq-coral); font-weight: 800; letter-spacing: .15em; }
  .rq-dif__t { font-size: clamp(1.3rem, 2.2vw, 1.65rem); line-height: 1.05; letter-spacing: -.025em; color: var(--rq-ink); margin: 0; }
  .rq-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* PROCESO */
  .rq-proc-section { background: var(--rq-ink); color: var(--rq-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--rq-ink); position: relative; overflow: hidden; }
  .rq-proc-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(255,210,48,0.07) 1.2px, transparent 1.2px); background-size: 22px 22px; pointer-events: none; }
  .rq-proc-section > * { position: relative; }
  .rq-proc { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 768px)  { .rq-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .rq-proc { grid-template-columns: repeat(4, 1fr); } }
  .rq-proc__step {
    background: rgba(255,252,246,0.05);
    border: 2px solid var(--rq-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .rq-proc__step:hover { background: rgba(0,153,204,0.12); transform: translateY(-3px); }
  .rq-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(255,252,246,0.25); }
  .rq-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--rq-sol); line-height: 1; }
  .rq-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--rq-coral); }
  .rq-proc__t { font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.05; letter-spacing: -.02em; color: var(--rq-paper); margin: .25rem 0 0; }
  .rq-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(255,252,246,0.75); flex: 1; }
  .rq-proc__foot { font-size: .58rem; letter-spacing: .2em; color: var(--rq-sol); font-weight: 800; padding-top: .5rem; border-top: 1.5px solid rgba(255,252,246,0.25); }

  /* TESTIMONIOS */
  .rq-quote-section { background: var(--rq-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--rq-ink); }
