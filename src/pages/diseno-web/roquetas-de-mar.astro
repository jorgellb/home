                  <circle cx="80" cy="40" r="0.8" fill="#FFFCF6"/>
                  <circle cx="120" cy="20" r="1" fill="#FFFCF6"/>

                  {/* Pájaros */}
                  <g fill="none" stroke="#FFFCF6" stroke-width="1.5" stroke-linecap="round">
                    <path d="M 200 45 Q 205 41 210 45 Q 215 41 220 45"/>
                    <path d="M 270 35 Q 274 31 278 35 Q 282 31 286 35"/>
                  </g>

                  {/* Skyline urbano — torres apartamentos */}
                  <g stroke="#0E0D0B" stroke-width="2">
                    {/* Torres izquierda */}
                    <rect x="20" y="80" width="32" height="50" fill="#FFFCF6"/>
                    {Array.from({length: 5}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={24 + c*9} y={85 + r*9} width="6" height="6" fill={(r+c) % 3 === 0 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}

                    <rect x="58" y="60" width="36" height="70" fill="#FFFCF6"/>
                    {Array.from({length: 7}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={62 + c*10} y={65 + r*9} width="6" height="6" fill={(r+c) % 4 === 0 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}

                    <rect x="100" y="70" width="30" height="60" fill="#FFFCF6"/>
                    {Array.from({length: 6}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={104 + c*8.5} y={75 + r*9} width="5.5" height="6" fill={(r+c) % 3 === 1 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}

                    {/* CASTILLO Santa Ana — centro */}
                    <rect x="160" y="80" width="50" height="40" fill="#F4E8D0"/>
                    <path d="M 160 80 L 160 72 L 166 72 L 166 76 L 173 76 L 173 72 L 180 72 L 180 76 L 187 76 L 187 72 L 194 72 L 194 76 L 201 76 L 201 72 L 210 72 L 210 80" fill="#F4E8D0" stroke="#0E0D0B" stroke-width="2"/>
                    {/* Torre central */}
                    <rect x="178" y="58" width="14" height="22" fill="#F4E8D0"/>
                    <path d="M 178 58 L 178 52 L 182 52 L 182 56 L 188 56 L 188 52 L 192 52 L 192 58" fill="#F4E8D0" stroke="#0E0D0B" stroke-width="2"/>
                    {/* Bandera */}
                    <line x1="185" y1="52" x2="185" y2="40" stroke="#0E0D0B" stroke-width="1.5"/>
                    <path d="M 185 40 L 198 43 L 196 46 L 198 49 L 185 46 Z" fill="#0099CC" stroke="#0E0D0B" stroke-width="1"/>
                    {/* Ventanas */}
                    <rect x="170" y="95" width="8" height="14" fill="#0E0D0B"/>
                    <path d="M 170 95 Q 174 90 178 95" fill="#0E0D0B"/>
                    <rect x="195" y="95" width="8" height="14" fill="#0E0D0B"/>
                    <path d="M 195 95 Q 199 90 203 95" fill="#0E0D0B"/>

                    {/* Más apartamentos derecha */}
                    <rect x="220" y="75" width="34" height="55" fill="#FFFCF6"/>
                    {Array.from({length: 6}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={224 + c*10} y={80 + r*8} width="6" height="6" fill={(r+c) % 3 === 0 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}

                    <rect x="260" y="65" width="32" height="65" fill="#FFFCF6"/>
                    {Array.from({length: 7}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={264 + c*9} y={70 + r*8} width="5.5" height="6" fill={(r+c) % 4 === 1 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}

                    <rect x="298" y="78" width="30" height="52" fill="#FFFCF6"/>
                    {Array.from({length: 5}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={302 + c*8.5} y={83 + r*8.5} width="5.5" height="6" fill={(r+c) % 3 === 0 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}

                    {/* FARO de Roquetas */}
                    <rect x="340" y="65" width="14" height="65" fill="#FFFCF6"/>
                    <rect x="340" y="78" width="14" height="6" fill="#FF6B6B"/>
                    <rect x="340" y="98" width="14" height="6" fill="#FF6B6B"/>
                    <rect x="340" y="118" width="14" height="6" fill="#FF6B6B"/>
                    <rect x="336" y="60" width="22" height="6" fill="#0E0D0B"/>
                    <rect x="343" y="50" width="8" height="10" fill="#FFD230" stroke="#0E0D0B" stroke-width="1"/>
                    <path d="M 336 50 L 358 50 L 354 44 L 340 44 Z" fill="#FF6B6B" stroke="#0E0D0B" stroke-width="1.5"/>
                    {/* Haz de luz */}
                    <path d="M 347 47 L 320 35 L 335 47 Z" fill="#FFD230" opacity="0.5"/>
                    <path d="M 347 47 L 374 35 L 359 47 Z" fill="#FFD230" opacity="0.5"/>

                    {/* Más torres */}
                    <rect x="370" y="80" width="30" height="50" fill="#FFFCF6"/>
                    {Array.from({length: 5}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={374 + c*8.5} y={85 + r*9} width="5.5" height="6" fill={(r+c) % 3 === 1 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}

                    <rect x="450" y="85" width="36" height="45" fill="#FFFCF6"/>
                    {Array.from({length: 4}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={454 + c*10} y={90 + r*10} width="6" height="6" fill={(r+c) % 3 === 0 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}

                    <rect x="490" y="70" width="32" height="60" fill="#FFFCF6"/>
                    {Array.from({length: 6}).map((_, r) =>
                      Array.from({length: 3}).map((_, c) => (
                        <rect x={494 + c*9} y={75 + r*9} width="5.5" height="6" fill={(r+c) % 4 === 0 ? "#FFD230" : "#0E0D0B"}/>
                      ))
                    )}
