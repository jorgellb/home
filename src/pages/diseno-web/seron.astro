    filter: drop-shadow(0 14px 30px rgba(0,0,0,0.3));
  }

  /* ═══════════════════════════════════════════════════════ */
  /* MAPA                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .sn-map-section {
    background: var(--sn-paper-2);
    border-bottom: 3px solid var(--sn-ink);
    padding-bottom: 0;
  }
  .sn-map-head { padding: 4rem 0 2rem; }
  .sn-map-head__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: end;
  }
  @media (min-width: 768px) { .sn-map-head__inner { grid-template-columns: 1.6fr 1fr; } }
  .sn-map-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 0;
  }
  .sn-map-title em { color: var(--sn-tierra); }
  .sn-map-coords {
    background: var(--sn-ink);
    color: var(--sn-oro);
    padding: 1rem 1.25rem;
    border: 2px solid var(--sn-oro);
    box-shadow: 5px 5px 0 var(--sn-oro);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem;
    letter-spacing: .15em;
  }

  .sn-map-frame {
    position: relative;
    border-top: 3px solid var(--sn-ink);
    border-bottom: 3px solid var(--sn-ink);
    background: var(--sn-ink);
  }
  .sn-map-frame__corner {
    position: absolute;
    width: 30px; height: 30px;
    border: 3px solid var(--sn-tierra);
    z-index: 5;
    pointer-events: none;
  }
  .sn-map-frame__corner--tl { top: 12px; left: 12px; border-right: none; border-bottom: none; }
  .sn-map-frame__corner--tr { top: 12px; right: 12px; border-left: none; border-bottom: none; }
  .sn-map-frame__corner--bl { bottom: 12px; left: 12px; border-right: none; border-top: none; }
  .sn-map-frame__corner--br { bottom: 12px; right: 12px; border-left: none; border-top: none; }
  .sn-map-frame__label {
    position: absolute;
    z-index: 5;
    background: var(--sn-ink);
    color: var(--sn-oro);
    padding: .25rem .55rem;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 1.5px solid var(--sn-oro);
    pointer-events: none;
  }
  .sn-map-frame__label--n { top: 14px; left: 50%; transform: translateX(-50%); }
  .sn-map-frame__label--s { bottom: 14px; left: 50%; transform: translateX(-50%); }
  .sn-map-frame__label--e { right: 14px; top: 50%; transform: translateY(-50%); }
  .sn-map-frame__label--w { left: 14px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .sn-map-frame__label--e, .sn-map-frame__label--w { display: none; }
  }
  .sn-map-wrap {
    width: 100%;
    height: clamp(420px, 60vh, 600px);
    overflow: hidden;
  }
  .sn-map-wrap > * { width: 100%; height: 100%; }

  /* ═══════════════════════════════════════════════════════ */
  /* SECTORES                                                */
  /* ═══════════════════════════════════════════════════════ */
  .sn-sec-section {
    background: var(--sn-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sn-ink);
  }
  .sn-sec {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .sn-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sn-sec { grid-template-columns: repeat(3, 1fr); } }
  .sn-sec__card {
    background: var(--sn-paper);
    border: 2.5px solid var(--sn-ink);
    box-shadow: var(--sn-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s, background .25s;
    position: relative;
    overflow: hidden;
  }
  .sn-sec__card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .sn-sec__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 12px 12px 0 currentColor;
  }
  .sn-sec__card--tierra { color: var(--sn-tierra); }
  .sn-sec__card--bosque  { color: var(--sn-bosque); }
  .sn-sec__card--oro     { color: var(--sn-oro); }
  .sn-sec__card--barro   { color: var(--sn-barro); }
  .sn-sec__card--pino    { color: var(--sn-pino); }
  .sn-sec__card--ink     { color: var(--sn-ink); }

  .sn-sec__head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
  }
  .sn-sec__num { font-size: 1.25rem; font-weight: 800; color: currentColor; }
  .sn-sec__stat-box { display: flex; flex-direction: column; align-items: flex-end; }
  .sn-sec__stat-v { font-size: 1.1rem; font-weight: 800; color: currentColor; line-height: 1; }
  .sn-sec__stat-l { font-size: .55rem; letter-spacing: .12em; color: currentColor; font-weight: 700; text-transform: uppercase; }
  .sn-sec__title {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    color: var(--sn-ink);
    margin: 0;
  }
  .sn-sec__desc {
    font-size: .9rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
    flex: 1;
  }
  .sn-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .sn-sec__tag {
    display: flex; align-items: flex-start; gap: .35rem;
    font-size: .8rem;
    line-height: 1.35;
    color: var(--sn-ink);
  }
  .sn-sec__tag span { color: currentColor; font-weight: 800; }
  .sn-sec__foot {
    padding-top: .65rem;
    border-top: 2px solid var(--sn-ink);
  }
  .sn-sec__cta {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* DIFERENCIALES                                           */
  /* ═══════════════════════════════════════════════════════ */
  .sn-dif-section {
    background: var(--sn-tierra-d);
    color: var(--sn-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sn-ink);
    position: relative;
    overflow: hidden;
  }
  .sn-dif-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(212,167,106,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .sn-dif-section > * { position: relative; }
  .sn-dif {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px)  { .sn-dif { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sn-dif { grid-template-columns: repeat(4, 1fr); } }
  .sn-dif__item {
    background: rgba(255,252,246,0.05);
    border: 2px solid var(--sn-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .sn-dif__item:hover { background: rgba(212,167,106,0.12); transform: translateY(-3px); }
  .sn-dif__num { font-size: .85rem; color: var(--sn-oro); font-weight: 800; letter-spacing: .15em; }
  .sn-dif__t {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--sn-paper);
    margin: 0;
  }
  .sn-dif__desc { font-size: .85rem; line-height: 1.45; color: rgba(255,252,246,0.75); margin: 0; }

  /* ═══════════════════════════════════════════════════════ */
  /* PROCESO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .sn-proc-section {
    background: var(--sn-bosque-d);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sn-ink);
    position: relative;
  }
  .sn-proc-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(135deg, transparent 0 24px, rgba(212,167,106,0.04) 24px 25px);
    pointer-events: none;
  }
  .sn-proc-section > * { position: relative; }
  .sn-proc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .sn-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sn-proc { grid-template-columns: repeat(4, 1fr); } }
  .sn-proc__step {
    background: rgba(255,252,246,0.06);
    border: 2px solid var(--sn-oro);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: background .25s, transform .25s;
    position: relative;
  }
  .sn-proc__step:hover { background: rgba(255,252,246,0.10); transform: translateY(-3px); }
  .sn-proc__head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: .5rem;
    border-bottom: 2px dashed var(--sn-oro);
  }
  .sn-proc__num { font-size: 1.35rem; font-weight: 800; color: var(--sn-oro); letter-spacing: .1em; }
  .sn-proc__eta { font-size: .6rem; color: var(--sn-oro); letter-spacing: .15em; font-weight: 700; }
  .sn-proc__t {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--sn-paper);
    margin: 0;
  }
  .sn-proc__body { font-size: .85rem; line-height: 1.5; color: rgba(255,252,246,0.7); flex: 1; }
  .sn-proc__foot {
    font-size: .65rem;
    color: var(--sn-oro);
    letter-spacing: .12em;
    padding-top: .5rem;
    border-top: 1.5px solid rgba(212,167,106,0.3);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .sn-quote-section {
    background: var(--sn-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sn-ink);
  }
  .sn-pull {
    position: relative;
    background: var(--sn-paper-2);
    border: 3px solid var(--sn-ink);
    box-shadow: var(--sn-shadow);
    padding: 3rem 2rem 2rem;
    margin: 2rem 0;
  }
  .sn-pull__seal {
    position: absolute;
    top: -30px; right: 30px;
    width: 90px; aspect-ratio: 1;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 8px rgba(184,110,74,0.35));
  }
  .sn-pull__q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.3;
    margin: 0 0 1.5rem;
    color: var(--sn-ink);
    max-width: 56ch;
  }
  .sn-pull__cap { display: flex; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 2px dashed var(--sn-ink); }
  .sn-pull__avatar {
    width: 48px; height: 48px;
    background: var(--sn-tierra); color: var(--sn-paper);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-size: 1.35rem; font-weight: 800;
    border-radius: 50%;
  }
  .sn-pull__cap div { display: flex; flex-direction: column; }
  .sn-pull__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--sn-ink); }
  .sn-pull__role { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; opacity: .65; text-transform: uppercase; }

  .sn-quotes {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .sn-quotes { grid-template-columns: repeat(3, 1fr); } }
  .sn-quote {
    position: relative;
    background: var(--sn-paper);
    border: 2px solid var(--sn-ink);
    box-shadow: 5px 5px 0 var(--sn-ink);
    padding: 1.75rem 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .sn-quote:hover { transform: translateY(-3px); }
  .sn-quote--0 { background: var(--sn-paper-2); }
  .sn-quote--1 { background: #EAE0C8; }
  .sn-quote--2 { background: var(--sn-paper); }
  .sn-quote__mark {
    position: absolute;
    top: -8px; left: 14px;
    font-family: var(--font-serif, serif);
    font-size: 4rem;
    line-height: 1;
    color: var(--sn-tierra);
    opacity: .45;
  }
  .sn-quote p { font-size: .92rem; line-height: 1.5; color: var(--sn-ink); flex: 1; margin: 0; }
  .sn-quote footer { display: flex; align-items: center; gap: .75rem; padding-top: .85rem; border-top: 1.5px dashed var(--sn-ink); }
  .sn-quote__avatar {
    width: 36px; height: 36px;
    background: var(--sn-bosque); color: var(--sn-paper);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .sn-quote footer div { display: flex; flex-direction: column; }
  .sn-quote__name { font-family: var(--font-display); font-weight: 700; font-size: .9rem; }
  .sn-quote__role { font-family: var(--font-mono); font-size: .6rem; letter-spacing: .1em; opacity: .65; text-transform: uppercase; }

  /* ═══════════════════════════════════════════════════════ */
  /* FAQ                                                     */
  /* ═══════════════════════════════════════════════════════ */
  .sn-faq-section {
    background: var(--sn-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sn-ink);
  }
  .sn-faq {
    list-style: none; padding: 0; margin: 2rem 0 0;
    border-top: 2.5px solid var(--sn-ink);
  }
  .sn-faq__item { border-bottom: 2px solid var(--sn-ink); }
  .sn-faq__det summary { list-style: none; cursor: pointer; }
  .sn-faq__det summary::-webkit-details-marker { display: none; }
  .sn-faq__sum {
    display: grid;
    grid-template-columns: 60px 1fr 40px;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem 0;
    transition: padding .2s, background .2s;
  }
  .sn-faq__sum:hover { padding-inline: 1rem; background: var(--sn-paper); }
  .sn-faq__num { font-size: 1rem; font-weight: 800; color: var(--sn-tierra-d); letter-spacing: .1em; }
  .sn-faq__q {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.3;
    letter-spacing: -.015em;
    color: var(--sn-ink);
    font-weight: 700;
  }
  .sn-faq__toggle {
    width: 40px; height: 40px;
    border: 2px solid var(--sn-ink);
    background: var(--sn-paper);
    color: var(--sn-ink);
    display: flex; align-items: center; justify-content: center;
    transition: transform .3s, background .2s, color .2s;
  }
  .sn-faq__det[open] .sn-faq__toggle { transform: rotate(180deg); background: var(--sn-tierra); color: var(--sn-paper); }
  .sn-faq__ans {
    padding: 0 0 1.5rem 76px;
    color: var(--brutal-text-secondary);
    font-size: .98rem;
    line-height: 1.55;
    max-width: 70ch;
  }
  @media (max-width: 640px) {
    .sn-faq__sum { grid-template-columns: 40px 1fr 32px; gap: .5rem; }
    .sn-faq__ans { padding-left: 48px; }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PUEBLOS VECINOS                                         */
  /* ═══════════════════════════════════════════════════════ */
  .sn-vecinos-section {
    background: var(--sn-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sn-ink);
  }
  .sn-vecinos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--sn-ink);
    background: var(--sn-ink);
  }
  @media (min-width: 640px)  { .sn-vecinos { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  @media (min-width: 1024px) { .sn-vecinos { grid-template-columns: repeat(4, 1fr); } }
  .sn-vecino {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    gap: .35rem;
    padding: 1.5rem;
    background: var(--sn-paper);
    color: var(--sn-ink);
    text-decoration: none;
    min-height: 160px;
    transition: background .25s, color .25s;
    grid-template-areas: 'n arrow' 'name name' 'sub sub';
  }
  .sn-vecino__n { grid-area: n; font-size: .58rem; letter-spacing: .2em; opacity: .55; }
  .sn-vecino__name { grid-area: name; font-size: clamp(1.4rem, 2.5vw, 1.8rem); line-height: .95; letter-spacing: -.025em; }
  .sn-vecino__sub { grid-area: sub; font-size: .58rem; letter-spacing: .15em; opacity: .55; text-transform: uppercase; }
  .sn-vecino__arrow { grid-area: arrow; align-self: start; font-family: var(--font-mono); color: var(--sn-tierra); font-size: 1.3rem; transition: transform .25s; }
  .sn-vecino:hover { background: var(--sn-tierra); color: var(--sn-paper); }
  .sn-vecino:hover .sn-vecino__sub, .sn-vecino:hover .sn-vecino__n { opacity: .85; }
  .sn-vecino:hover .sn-vecino__arrow { color: var(--sn-paper); transform: translateX(4px); }
  .sn-vecino--1:hover { background: var(--sn-bosque); color: var(--sn-paper); }
  .sn-vecino--2:hover { background: var(--sn-ink); color: var(--sn-oro); }
  .sn-vecino--2:hover .sn-vecino__arrow { color: var(--sn-oro); }
  .sn-vecino--3:hover { background: var(--sn-oro); color: var(--sn-ink); }

  /* ═══════════════════════════════════════════════════════ */
  /* CTA FINAL                                               */
  /* ═══════════════════════════════════════════════════════ */
  .sn-final {
    background: var(--sn-ink);
    color: var(--sn-paper);
    padding: 6rem 1.5rem 0;
    position: relative;
    overflow: hidden;
  }
  .sn-final::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(135deg, transparent 0 24px, rgba(212,167,106,0.04) 24px 25px);
    pointer-events: none;
  }
  .sn-final > * { position: relative; }
  .sn-final__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    padding-bottom: 4rem;
  }
  @media (min-width: 1024px) { .sn-final__grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .sn-final__chapter { color: var(--sn-oro); }
  .sn-final__title {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: .9;
    letter-spacing: -.045em;
    color: var(--sn-paper);
    margin: 1rem 0;
  }
  .sn-final__title em { color: var(--sn-oro); font-style: italic; display: block; }
  .sn-final__lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255,252,246,0.75);
    max-width: 52ch;
  }
  .sn-final__lead strong { color: var(--sn-oro); }
  .sn-final__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.75rem 0 1.5rem; }
  .sn-final__btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.15rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
  }
  .sn-final__btn--primary {
    background: var(--sn-tierra); color: var(--sn-paper); border-color: var(--sn-tierra);
    box-shadow: 6px 6px 0 var(--sn-oro);
  }
  .sn-final__btn--primary:hover {
    background: var(--sn-oro); color: var(--sn-ink); border-color: var(--sn-oro);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--sn-tierra);
  }
  .sn-final__btn--ghost {
    background: transparent; color: var(--sn-paper); border-color: var(--sn-paper);
    box-shadow: 6px 6px 0 var(--sn-paper);
  }
  .sn-final__btn--ghost:hover {
    background: var(--sn-paper); color: var(--sn-ink);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--sn-paper);
  }
  .sn-final__trust {
    display: flex; flex-wrap: wrap;
    gap: 1rem 1.75rem;
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .15em;
    color: rgba(255,252,246,0.55);
    text-transform: uppercase;
    margin-top: 1.5rem;
  }
  .sn-final__trust .sn-pulse { background: var(--sn-oro); margin: 0 .25rem 0 0; box-shadow: 0 0 0 0 rgba(212,167,106,0.55); }

  .sn-final__r { display: flex; align-items: center; justify-content: center; max-width: 360px; margin: 0 auto; }
  .sn-final-svg { display: block; width: 100%; height: 100%; filter: drop-shadow(0 12px 36px rgba(184,110,74,0.25)); }

  .sn-final__marquee {
    background: var(--sn-oro);
    color: var(--sn-ink);
