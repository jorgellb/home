<style>
  /* ══════════════════════════════════════════════════════
     PALETA · EL EJIDO · MAR DE PLÁSTICO + AGRO-EXPORT
     ══════════════════════════════════════════════════════ */
  .ej {
    --ej-paper:    #F0F3EE;       /* Plástico / plata invernadero */
    --ej-paper-2:  #E4E9DF;
    --ej-arena:    #D7DECF;
    --ej-ink:      #14160F;       /* Verde-negro tierra */
    --ej-green:    #3F9B3A;       /* Verde invernadero (PRIMARY) */
    --ej-green-l:  #4CA832;
    --ej-green-d:  #256B23;
    --ej-red:      #D6312B;       /* Rojo tomate/pimiento */
    --ej-yellow:   #F2B233;       /* Amarillo pimiento/sol */
    --ej-auber:    #5B3A6B;       /* Berenjena */
    --ej-sky:      #4E9CD4;       /* Azul industrial / Almerimar */
    --ej-slate:    #6E7A62;       /* Sierra de Gádor */
    --ej-shadow:   8px 8px 0 var(--ej-ink);
  }
  .ej-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--ej-green);
    box-shadow: 0 0 0 0 rgba(63,155,58,0.55);
    animation: ej-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes ej-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(63,155,58,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(63,155,58,0); }
    100% { box-shadow: 0 0 0 0 rgba(63,155,58,0); }
  }
  .ej-spin { transform-origin: 50% 50%; animation: ej-spin 30s linear infinite; }
  @keyframes ej-spin { to { transform: rotate(360deg); } }

  /* HERO */
  .ej-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 18%, rgba(78,156,212,0.12), transparent 50%),
      radial-gradient(circle at 12% 82%, rgba(63,155,58,0.10), transparent 50%),
      var(--ej-paper);
    border-bottom: 3px solid var(--ej-ink);
    position: relative;
    overflow: hidden;
  }
  .ej-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(115deg, transparent 0 36px, rgba(63,155,58,0.04) 36px 37px);
    pointer-events: none;
  }
  .ej-hero > * { position: relative; }
  .ej-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .ej-hero__status { color: var(--ej-green-d); font-weight: 700; }
  .ej-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .ej-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .ej-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .ej-hero__chapter { color: var(--ej-green-d); }
  .ej-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .ej-hero__title em { color: var(--ej-green); font-style: italic; }
  .ej-hero__title-stamp {
    display: inline-block;
    color: var(--ej-paper);
    background: var(--ej-red);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .ej-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 54ch; }
  .ej-hero__lead strong { color: var(--ej-ink); font-weight: 700; }
  .ej-hero__lead em { color: var(--ej-red); font-style: italic; font-weight: 600; }
  .ej-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .ej-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--ej-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .ej-btn--primary { background: var(--ej-green); color: var(--ej-paper); box-shadow: 6px 6px 0 var(--ej-ink); }
  .ej-btn--primary:hover { background: var(--ej-red); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--ej-ink); }
  .ej-btn--ghost { background: transparent; color: var(--ej-ink); box-shadow: 6px 6px 0 var(--ej-green); }
  .ej-btn--ghost:hover { background: var(--ej-ink); color: var(--ej-yellow); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--ej-green); }

  /* KPIs */
  .ej-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--ej-ink);
    background: var(--ej-ink);
  }
  @media (min-width: 768px) { .ej-kpis { grid-template-columns: repeat(4, 1fr); } }
  .ej-kpi {
    background: var(--ej-paper); padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--ej-ink); border-bottom: 2px solid var(--ej-ink);
  }
  .ej-kpi:nth-child(2n) { border-right: none; }
  .ej-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .ej-kpi:nth-child(2n)      { border-right: 2px solid var(--ej-ink); }
    .ej-kpi:nth-child(4n)      { border-right: none; }
    .ej-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--ej-ink); }
    .ej-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .ej-kpi--green  { background: var(--ej-green); color: var(--ej-paper); }
  .ej-kpi--red    { background: var(--ej-red); color: var(--ej-paper); }
  .ej-kpi--yellow { background: var(--ej-yellow); color: var(--ej-ink); }
  .ej-kpi--ink    { background: var(--ej-ink); color: var(--ej-paper); }
  .ej-kpi--ink .ej-kpi__v { color: var(--ej-yellow); }
  .ej-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .ej-kpi__v small { font-size: .55em; opacity: .8; }
  .ej-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .ej-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(20,22,15,0.2));
  }
  .ej-postcard {
    background: var(--ej-paper);
    border: 3px solid var(--ej-ink);
    box-shadow: var(--ej-shadow);
    overflow: hidden;
    transform: rotate(1deg);
    transition: transform .35s;
  }
  .ej-postcard:hover { transform: rotate(0); }
  .ej-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--ej-green);
    color: var(--ej-paper);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--ej-ink);
  }
  .ej-postcard__profile {
    width: 100%; aspect-ratio: 540 / 240;
    border-bottom: 2px solid var(--ej-ink);
    overflow: hidden;
  }
  .ej-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--ej-ink); }
  .ej-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.05); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .ej-postcard:hover .ej-postcard__img { transform: scale(1.05); }
  .ej-postcard__seal { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(9deg); filter: drop-shadow(0 4px 10px rgba(63,155,58,0.5)); }
  .ej-postcard__tag {
    position: absolute; bottom: 12px; left: 12px;
    background: var(--ej-yellow); color: var(--ej-ink);
    padding: .4rem .75rem;
    font-size: .62rem; font-weight: 800; letter-spacing: .15em;
    border: 2px solid var(--ej-ink);
    box-shadow: 3px 3px 0 var(--ej-green);
    transform: rotate(-2deg);
  }
  .ej-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--ej-paper-2);
    display: grid; gap: .35rem;
  }
  .ej-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(20,22,15,0.18);
    font-size: .68rem;
  }
  .ej-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .ej-postcard__data-row > span:first-child { color: var(--ej-green-d); letter-spacing: .2em; font-weight: 800; }
  .ej-postcard__data-v { color: var(--ej-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .ej-marquee {
    background: var(--ej-green); color: var(--ej-paper);
    overflow: hidden; padding: .9rem 0;
    border-top: 3px solid var(--ej-ink);
  }
  .ej-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: ej-marquee 40s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem; font-weight: 800;
    letter-spacing: .15em; text-transform: uppercase;
  }
  @keyframes ej-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* MAR DE PLÁSTICO SECTION */
  .ej-plastic-section {
    background: var(--ej-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ej-ink);
    position: relative;
    overflow: hidden;
  }
  .ej-plastic-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(63,155,58,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .ej-plastic-section > * { position: relative; }
  .ej-plastic-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .ej-plastic-grid { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }
  .ej-plastic-chapter { color: var(--ej-green); }
  .ej-plastic-title { font-size: clamp(2.5rem, 6vw, 4.25rem); line-height: .92; letter-spacing: -.04em; margin: 1rem 0; }
  .ej-plastic-title em { color: var(--ej-green); }
  .ej-plastic-lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); margin-bottom: 1.75rem; max-width: 56ch; }
  .ej-plastic-lead strong { color: var(--ej-ink); font-weight: 700; }
  .ej-plastic-lead em { color: var(--ej-red); font-style: italic; }
  .ej-plastic-facts { display: grid; grid-template-columns: 1fr; gap: 0; border: 2.5px solid var(--ej-ink); background: var(--ej-paper); box-shadow: 6px 6px 0 var(--ej-ink); }
  @media (min-width: 640px) { .ej-plastic-facts { grid-template-columns: 1fr 1fr; } }
  .ej-plastic-fact { padding: .85rem 1rem; border-bottom: 1px solid var(--ej-ink); display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 640px) {
    .ej-plastic-fact:nth-child(odd) { border-right: 1px solid var(--ej-ink); }
    .ej-plastic-fact:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .ej-plastic-fact:last-child { border-bottom: none; } }
  .ej-plastic-fact__k { font-size: .58rem; letter-spacing: .2em; color: var(--ej-red); font-weight: 800; }
  .ej-plastic-fact__v { font-size: .88rem; color: var(--ej-ink); font-weight: 600; line-height: 1.35; }

  /* Vista satélite */
  .ej-plastic-r { max-width: 360px; margin: 0 auto; width: 100%; }
  .ej-sat { border: 3px solid var(--ej-ink); box-shadow: var(--ej-shadow); background: #2B3326; }
  .ej-sat__bar { display: flex; justify-content: space-between; gap: .5rem; padding: .5rem .75rem; background: var(--ej-ink); color: var(--ej-green-l); font-size: .56rem; letter-spacing: .12em; border-bottom: 2px solid var(--ej-green-d); }
  .ej-sat__svg { display: block; width: 100%; aspect-ratio: 1; }
  .ej-sat-ping { transform-origin: 0 0; animation: ej-ping 2s ease-out infinite; }
  @keyframes ej-ping { 0% { opacity: 1; transform: scale(0.6); } 100% { opacity: 0; transform: scale(1.8); } }
  .ej-sat__foot { padding: .55rem .75rem; background: var(--ej-ink); color: var(--ej-paper); font-size: .58rem; letter-spacing: .15em; font-weight: 800; border-top: 2px solid var(--ej-green-d); text-align: center; }

  /* ICONOS */
  .ej-iconos-section { background: var(--ej-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ej-ink); }
  .ej-iconos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 1024px) { .ej-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .ej-icono {
    position: relative;
    background: var(--ej-paper);
    border: 3px solid var(--ej-ink);
    box-shadow: var(--ej-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .ej-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .ej-icono--green { color: var(--ej-green); }
  .ej-icono--red   { color: var(--ej-red); }
  .ej-icono--sky   { color: var(--ej-sky); }
  .ej-icono__code {
    position: absolute; top: -16px; right: 20px;
    background: var(--ej-ink); color: var(--ej-yellow);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .ej-icono__svg { width: 100%; aspect-ratio: 1; max-width: 200px; margin: 0 auto; color: currentColor; }
  .ej-icono__name { font-size: clamp(1.5rem, 2.8vw, 1.85rem); line-height: 1; letter-spacing: -.025em; color: var(--ej-ink); margin: .5rem 0 0; text-align: center; }
  .ej-icono__sub { font-size: .62rem; letter-spacing: .25em; color: currentColor; font-weight: 800; text-align: center; }
  .ej-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; text-align: center; }
  .ej-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .ej-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* HUERTA DE EUROPA */
  .ej-huerta-section { background: var(--ej-green-d); color: var(--ej-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ej-ink); position: relative; overflow: hidden; }
  .ej-huerta-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(240,243,238,0.06) 1.3px, transparent 1.3px); background-size: 26px 26px; pointer-events: none; }
  .ej-huerta-section > * { position: relative; }
  .ej-huerta-head { max-width: 760px; margin-bottom: 2.5rem; }
  .ej-huerta-chapter { color: var(--ej-yellow); }
  .ej-huerta-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; color: var(--ej-paper); }
  .ej-huerta-title em { color: var(--ej-yellow); }
  .ej-huerta-lead { font-size: 1.1rem; line-height: 1.55; color: rgba(240,243,238,0.8); max-width: 60ch; }
  .ej-huerta-lead strong { color: var(--ej-paper); font-weight: 700; }
  .ej-huerta-lead em { color: var(--ej-yellow); font-style: italic; }

  /* Caja de hortalizas */
  .ej-crate { background: var(--ej-paper); border: 3px solid var(--ej-ink); box-shadow: var(--ej-shadow); margin-bottom: 2.5rem; overflow: hidden; }
  .ej-crate__label { display: block; background: var(--ej-red); color: var(--ej-paper); padding: .65rem 1rem; font-size: .68rem; letter-spacing: .2em; font-weight: 800; border-bottom: 3px solid var(--ej-ink); }
  .ej-veg { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 560px) { .ej-veg { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .ej-veg { grid-template-columns: repeat(6, 1fr); } }
  .ej-veg__item { display: flex; flex-direction: column; align-items: center; gap: .5rem; padding: 1.5rem 1rem; border-right: 1px solid var(--ej-ink); border-bottom: 1px solid var(--ej-ink); background: var(--ej-paper); transition: background .25s, transform .25s; }
  .ej-veg__item:hover { transform: translateY(-4px); }
  .ej-veg__item--red:hover   { background: rgba(214,49,43,0.12); }
  .ej-veg__item--green:hover { background: rgba(63,155,58,0.12); }
  .ej-veg__item--cuke:hover  { background: rgba(76,168,50,0.12); }
  .ej-veg__item--zuke:hover  { background: rgba(46,125,50,0.12); }
  .ej-veg__item--auber:hover { background: rgba(91,58,107,0.12); }
  .ej-veg__item--melon:hover { background: rgba(46,125,50,0.12); }
  @media (min-width: 900px) { .ej-veg__item:nth-child(6n) { border-right: none; } }
  .ej-veg__svg { width: 70px; height: 70px; }
  .ej-veg__name { font-family: var(--font-mono); font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ej-ink); }

  /* Export */
  .ej-export { background: rgba(240,243,238,0.06); border: 2.5px solid var(--ej-paper); padding: 1.75rem; }
  .ej-export__title { font-size: clamp(1.4rem, 2.6vw, 1.9rem); line-height: 1.05; letter-spacing: -.02em; color: var(--ej-paper); margin: 0 0 1.25rem; }
  .ej-mercados { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; grid-template-columns: 1fr; gap: .75rem; }
  @media (min-width: 640px) { .ej-mercados { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ej-mercados { grid-template-columns: repeat(4, 1fr); } }
  .ej-mercado { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: .75rem; background: var(--ej-paper); border: 2px solid var(--ej-ink); padding: .75rem; box-shadow: 4px 4px 0 var(--ej-ink); transition: transform .2s, box-shadow .2s; }
  .ej-mercado:hover { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 var(--ej-yellow); }
  .ej-mercado__flag { width: 44px; border: 1.5px solid var(--ej-ink); line-height: 0; }
  .ej-mercado__info { display: flex; flex-direction: column; }
  .ej-mercado__lang { font-size: 1.1rem; font-weight: 800; color: var(--ej-red); line-height: 1; }
  .ej-mercado__name { font-family: var(--font-display); font-size: .85rem; font-weight: 700; color: var(--ej-ink); }
  .ej-mercado__pct { font-family: var(--font-mono); font-size: 1rem; font-weight: 800; color: var(--ej-green-d); background: var(--ej-arena); padding: .25rem .5rem; border: 1.5px solid var(--ej-ink); }
  .ej-export__note { font-size: .92rem; line-height: 1.5; color: rgba(240,243,238,0.85); margin: 0; }
  .ej-export__note strong { color: var(--ej-yellow); }

  /* HITOS */
  .ej-hitos-section {
    background: var(--ej-ink); color: var(--ej-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ej-ink);
    position: relative; overflow: hidden;
  }
  .ej-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(63,155,58,0.09) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .ej-hitos-section > * { position: relative; }
  .ej-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2.5px solid var(--ej-paper);
  }
  @media (min-width: 640px)  { .ej-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ej-hitos { grid-template-columns: repeat(3, 1fr); } }
  .ej-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(240,243,238,0.22);
    border-right: 1px solid rgba(240,243,238,0.22);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(240,243,238,0.03);
    transition: background .25s;
  }
  .ej-hito:hover { background: rgba(63,155,58,0.2); }
  @media (min-width: 1024px) {
    .ej-hito:nth-child(3n) { border-right: none; }
    .ej-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .ej-hito:nth-child(2n) { border-right: none; }
    .ej-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .ej-hito { border-right: none; } .ej-hito:last-child { border-bottom: none; } }
  .ej-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--ej-yellow); font-weight: 800; }
  .ej-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--ej-paper); line-height: 1.35; }

  /* SECTORES */
  .ej-sec-section { background: var(--ej-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ej-ink); }
  .ej-sec { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px)  { .ej-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ej-sec { grid-template-columns: repeat(3, 1fr); } }
  .ej-sec__card {
    background: var(--ej-paper);
    border: 2.5px solid var(--ej-ink);
    box-shadow: var(--ej-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
  }
  .ej-sec__card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: currentColor; }
  .ej-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .ej-sec__card--green  { color: var(--ej-green); }
  .ej-sec__card--red    { color: var(--ej-red); }
  .ej-sec__card--yellow { color: var(--ej-yellow); }
  .ej-sec__card--auber  { color: var(--ej-auber); }
  .ej-sec__card--sky    { color: var(--ej-sky); }
  .ej-sec__card--slate  { color: var(--ej-slate); }
  .ej-sec__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; gap: .5rem; }
  .ej-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .ej-sec__stat-box {
    background: var(--ej-ink); color: var(--ej-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .ej-sec__stat-v { font-size: .9rem; font-weight: 800; color: currentColor; line-height: 1; }
  .ej-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .ej-sec__title { font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.1; letter-spacing: -.02em; color: var(--ej-ink); margin: 0; }
  .ej-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; }
  .ej-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .ej-sec__tag { display: flex; align-items: flex-start; gap: .35rem; font-size: .78rem; line-height: 1.35; color: var(--ej-ink); }
  .ej-sec__tag span { color: currentColor; font-weight: 800; }
  .ej-sec__foot { padding-top: .65rem; border-top: 2px solid var(--ej-ink); }
  .ej-sec__cta { font-family: var(--font-mono); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .15em; color: currentColor; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px; }

  /* MAPA */
  .ej-map-section { background: var(--ej-arena); border-bottom: 3px solid var(--ej-ink); }
  .ej-map-head { padding: 4rem 0 2rem; }
  .ej-map-head__inner { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; }
  @media (min-width: 768px) { .ej-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .ej-map-chapter { color: var(--ej-green-d); }
  .ej-map-title { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0 0; }
  .ej-map-title em { color: var(--ej-green-d); }
  .ej-map-coords {
    background: var(--ej-green); color: var(--ej-paper);
    padding: 1rem 1.25rem;
    border: 2px solid var(--ej-ink);
    box-shadow: 5px 5px 0 var(--ej-yellow);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem; letter-spacing: .15em;
  }
  .ej-map-frame { border-top: 3px solid var(--ej-ink); border-bottom: 3px solid var(--ej-ink); background: var(--ej-ink); }
  .ej-map-wrap > * { width: 100%; }

  /* DIFERENCIALES */
  .ej-dif-section { background: var(--ej-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ej-ink); }
  .ej-dif { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 0; border: 2px solid var(--ej-ink); }
  @media (min-width: 768px) { .ej-dif { grid-template-columns: 1fr 1fr; } }
  .ej-dif__item { padding: 1.75rem 1.5rem; border-bottom: 1px solid var(--ej-ink); display: flex; flex-direction: column; gap: .65rem; transition: background .2s; }
  @media (min-width: 768px) {
    .ej-dif__item:nth-child(odd) { border-right: 1px solid var(--ej-ink); }
    .ej-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) { .ej-dif__item:last-child { border-bottom: none; } }
  .ej-dif__item--0 { background: var(--ej-paper-2); }
  .ej-dif__item--1 { background: var(--ej-paper); }
  .ej-dif__item--2 { background: var(--ej-arena); }
  .ej-dif__item--3 { background: var(--ej-paper); }
  .ej-dif__item:hover { background: var(--ej-yellow); }
  .ej-dif__num { font-size: .85rem; color: var(--ej-red); font-weight: 800; letter-spacing: .15em; }
  .ej-dif__t { font-size: clamp(1.3rem, 2.2vw, 1.65rem); line-height: 1.05; letter-spacing: -.025em; color: var(--ej-ink); margin: 0; }
