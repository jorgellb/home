---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import { getPueblosByComarca } from '../../data/pueblos-almeria';

const pueblosLevante = getPueblosByComarca('Levante Almeriense').filter(p => p.slug !== 'vera');

const title = 'Diseño Web en Vera | Páginas Web Vera Playa y Puerto Rey · Almería';
const description = 'Agencia de diseño web en Vera, Vera Playa y Puerto Rey. Webs profesionales para inmobiliarias, hoteles, restaurantes y comercios. Hosting gratuito, SEO local y tiendas online. Presupuesto gratis sin compromiso.';
const canonical = 'https://platanitorico.com/diseno-web/vera/';

// ── Sectores clave de Vera ──
const sectores = [
  {
    nombre: 'Inmobiliarias y Alquiler Vacacional',
    slug: 'inmobiliarias',
    icon: 'home',
    stat: '+180% leads',
    desc: 'Vera Playa y Puerto Rey concentran la mayor demanda inmobiliaria del Levante. Creamos portales de propiedades con búsqueda avanzada, galería profesional, integración con portales nacionales y captación de clientes británicos y alemanes.',
    tags: ['Portales inmobiliarios', 'Multiidioma EN/DE', 'Integración Idealista', 'Reservas directas']
  },
  {
    nombre: 'Hostelería y Restauración',
    slug: 'hosteleria',
    icon: 'restaurant',
    stat: '+95% reservas',
    desc: 'Restaurantes frente al mar, chiringuitos y hoteles boutique. Webs con carta digital, reservas online y galería de platos que atrae tanto a turistas internacionales como a residentes locales.',
    tags: ['Reservas online', 'Carta digital', 'Google Hotel Ads', 'Tripadvisor']
  },
  {
    nombre: 'Comercio y Tiendas Online',
    slug: 'comercio',
    icon: 'shop',
    stat: 'Venta 24h',
    desc: 'Comercios de Vera ciudad con presencia en todo el municipio. Tiendas online rápidas, catálogos con stock en tiempo real y estrategia de captación local con Google Shopping.',
    tags: ['E-commerce Astro', 'Google Shopping', 'Pasarela de pago', 'Gestión stock']
  },
  {
    nombre: 'Turismo y Actividades',
    slug: 'turismo',
    icon: 'sun',
    stat: 'Visibilidad total',
    desc: 'Vera cuenta con una de las playas naturistas más grandes de Europa. Actividades náuticas, surf, buceo, rutas culturales y ecoturismo en el Parque Natural de la Sierra de Almagro.',
    tags: ['Booking widget', 'Multiidioma', 'SEO turístico', 'Galería 4K']
  },
  {
    nombre: 'Servicios Profesionales',
    slug: 'servicios',
    icon: 'briefcase',
    stat: '+60% contactos',
    desc: 'Clínicas, despachos, gestorías y profesionales liberales que sirven a Vera y toda la comarca. Webs que transmiten autoridad y convierten visitas en consultas cualificadas.',
    tags: ['Landing de captación', 'Formularios cualificados', 'Google Business', 'SEO local']
  },
  {
    nombre: 'Construcción e Industria',
    slug: 'construccion',
    icon: 'building',
    stat: 'Presencia premium',
    desc: 'Constructoras, reformas y empresas industriales del Levante. Portfolios de obras, memorias de calidad y generación de presupuestos online para diferenciarse en un sector muy competitivo.',
    tags: ['Portfolio de obras', 'Presupuestador online', 'SEO local', 'Certificaciones']
  }
];

// ── Diferenciales de Vera ──
const diferenciales = [
  {
    icon: 'beach',
    title: 'Vera Playa + Puerto Rey',
    desc: 'El municipio más completo del Levante: ciudad histórica, playa naturista de referencia europea y urbanización de lujo. Tres mercados, tres estrategias SEO en una sola web.'
  },
  {
    icon: 'globe',
    title: 'Turismo internacional',
    desc: 'Residentes y turistas de Reino Unido, Alemania, Holanda y Escandinavia. Webs multiidioma que posicionan en Google.co.uk y Google.de para captar clientes extranjeros.'
  },
  {
    icon: 'chart',
    title: 'Economía diversificada',
    desc: 'Con 17.000 habitantes y tres núcleos diferenciados, Vera combina turismo costero, servicios urbanos y agroindustria. El potencial digital es enorme y la competencia aún baja.'
  },
  {
    icon: 'map',
    title: 'Capital del Levante',
    desc: 'Vera es cabecera de comarca y centro de servicios de Garrucha, Palomares y Antas. Una web bien posicionada en Vera capta clientes de todo el territorio comarcal.'
  }
];

// ── Testimonios ──
const testimonios = [
  {
    nombre: 'Javier Ruiz',
    negocio: 'Inmobiliaria Vera Playa',
    texto: 'Necesitábamos captar clientes de Madrid y del Reino Unido. Platanito Rico nos hizo un portal inmobiliario impecable con SEO internacional. Ahora recibimos leads diarios de compradores extranjeros.',
    rating: 5
  },
  {
    nombre: 'Elena Soto',
    negocio: 'Restaurante Puerto Rey',
    texto: 'Tengo un restaurante frente al mar y desde que pusimos en marcha la web con reservas online, gestionamos todo mucho mejor y la ocupación ha subido notablemente en temporada media.',
    rating: 5
  },
  {
    nombre: 'Antonio Gómez',
    negocio: 'Hotel Boutique Vera',
    texto: 'Entendieron la esencia de nuestro hotel en Vera Pueblo. Las fotos brillan, la navegación es rápida y las reservas directas han aumentado. El ROI fue inmediato.',
    rating: 5
  },
  {
    nombre: 'Laura Navarro',
    negocio: 'Clínica Dental Vera',
    texto: 'Nos modernizaron toda la imagen digital. El tráfico local desde Google se ha disparado y los pacientes que llegan ya vienen convencidos por lo que ven en la web.',
    rating: 5
  }
];

// ── FAQ ──
const faqs = [
  {
    q: '¿Cuánto cuesta una página web para un negocio en Vera?',
    a: 'Una web corporativa profesional en Vera parte desde 450€. Para inmobiliarias con portal de propiedades o restaurantes con reservas online el precio está entre 900€ y 1.800€. Las tiendas online completas varían entre 900€ y 2.500€. Siempre presupuesto gratuito y sin compromiso.'
  },
  {
    q: '¿Hacéis webs para negocios en Vera Playa y Puerto Rey?',
    a: 'Sí, trabajamos en todo el término municipal de Vera: Vera ciudad, Vera Playa y Puerto Rey. Conocemos cada zona y adaptamos la estrategia SEO a la audiencia de cada núcleo — local, turista nacional o turista internacional.'
  },
  {
    q: '¿Podéis hacer la web en inglés y alemán para captar turistas?',
    a: 'Absolutamente. Especializamos webs multiidioma para inmobiliarias, hoteles y restaurantes de Vera Playa que quieren captar clientes de Reino Unido, Irlanda, Alemania y países escandinavos. Incluimos hreflang y SEO en cada idioma.'
  },
  {
    q: '¿Ofrecéis hosting gratuito para webs en Vera?',
    a: 'Sí. Nuestras webs estáticas con Astro se alojan en servidores premium sin coste anual para ti. Sin renovaciones, sin sustos de factura. Es una ventaja real frente a webs WordPress que cobran 100-300€/año de hosting.'
  },
  {
    q: '¿En cuánto tiempo tendré mi web lista en Vera?',
    a: 'Una web corporativa estándar suele estar lista en 1-2 semanas. Para portales inmobiliarios o tiendas online con catálogo amplio, el plazo es de 3-4 semanas. Te mantenemos informado en cada fase.'
  },
  {
    q: '¿Hacéis SEO local para posicionar en "diseño web Vera" o "restaurante Vera Playa"?',
    a: 'Sí, es nuestra especialidad. Optimizamos tu Google Business Profile, estructuramos el contenido con palabras clave locales y construimos una arquitectura SEO que te posicione para búsquedas como "dentista Vera", "inmobiliaria Puerto Rey" o "hotel Vera Playa".'
  },
  {
    q: '¿Podéis integrar reservas para mi hotel o restaurante en Puerto Rey?',
    a: 'Sí. Integramos sistemas de reservas (Booking widget, sistemas propios) para que gestiones todo desde un panel sencillo sin depender de comisiones de terceros.'
  },
  {
    q: '¿Trabajáis solo en Vera o también en municipios cercanos?',
    a: 'Trabajamos en toda la comarca del Levante Almeriense: Garrucha, Mojácar, Huércal-Overa, Antas, Cuevas del Almanzora y más. Si tienes negocio en la zona, estamos cerca.'
  }
];

// ── JSON-LD ──
const jsonLdSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonical,
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", "h2", ".speakable"]
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
        { "@type": "ListItem", "position": 2, "name": "Diseño Web", "item": "https://platanitorico.com/diseno-web/" },
        { "@type": "ListItem", "position": 3, "name": "Diseño Web Vera", "item": canonical }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Platanito Rico — Diseño Web Vera",
    "url": canonical,
    "telephone": "+34657085019",
    "image": "https://platanitorico.com/imagenes/creacion-paginas-webs-vera.jpg",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Vera",
      "addressRegion": "Almería",
      "postalCode": "04620",
      "addressCountry": "ES"
    },
    "areaServed": ["Vera", "Vera Playa", "Puerto Rey", "Garrucha", "Mojácar", "Levante Almeriense"],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "78",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Javier Ruiz" },
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Nuestra inmobiliaria en Vera Playa necesitaba captar clientes de Madrid y Reino Unido. Platanito Rico nos hizo un portal impecable. Ahora recibimos leads internacionales cada día."
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Elena Soto" },
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Mi restaurante en Puerto Rey ha mejorado notablemente. La web con reservas online ha subido la ocupación en temporada media y baja."
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Antonio Gómez" },
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Hotel boutique en Vera ciudad. Las reservas directas han aumentado considerablemente desde el lanzamiento de la nueva web."
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Laura Navarro" },
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Clínica dental en Vera. El tráfico local desde Google se ha disparado y los pacientes llegan ya convencidos por la web."
      }
    ],
    "offerCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios de diseño web en Vera",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Diseño web profesional Vera", "description": "Web corporativa desde 450€" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Portal inmobiliario Vera Playa", "description": "Portales con búsqueda avanzada y multiidioma" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web con reservas Puerto Rey", "description": "Hoteles y restaurantes con sistema de reservas" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tienda online Vera", "description": "E-commerce desde 900€" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SEO local Vera", "description": "Posicionamiento en Google para negocios locales" } }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo conseguir una web profesional para tu negocio en Vera",
    "description": "Proceso para crear una página web profesional para negocios de Vera, Vera Playa y Puerto Rey",
    "totalTime": "P14D",
    "estimatedCost": { "@type": "MonetaryAmount", "currency": "EUR", "value": "450" },
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Consulta gratuita", "text": "Analizamos tu negocio en Vera y definimos los objetivos de la web" },
      { "@type": "HowToStep", "position": 2, "name": "Propuesta personalizada", "text": "Diseño, tecnología y estrategia SEO adaptados a tu sector en Vera" },
      { "@type": "HowToStep", "position": 3, "name": "Desarrollo con revisiones", "text": "Creamos tu web con feedback continuo y ajustes en tiempo real" },
      { "@type": "HowToStep", "position": 4, "name": "Lanzamiento y formación", "text": "Publicamos tu web con hosting gratuito y te enseñamos a gestionarla" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />
  <main>

    <!-- ════════════════════════════════════════════
         JSON-LD
    ════════════════════════════════════════════ -->
    {jsonLdSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- ════════════════════════════════════════════
         HERO
    ════════════════════════════════════════════ -->
    <section class="relative overflow-hidden bg-white pt-24 pb-16 md:pt-32 md:pb-20">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_65%_40%,rgba(20,184,166,0.07)_0%,transparent_55%)]"></div>
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-bl from-teal-50 to-transparent rounded-full -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">

          <!-- Texto -->
          <div>
            <div class="flex flex-wrap gap-2 mb-6 animate-fade-up stagger-1">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-teal-50 border border-teal-200 text-teal-700 text-xs font-semibold uppercase tracking-wide">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                </svg>
                Vera · Vera Playa · Puerto Rey
              </span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-700 text-xs font-semibold">
                Hosting gratuito incluido
              </span>
            </div>

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight mb-6 animate-fade-up stagger-2">
              Diseño web en<br/>
              <span class="text-gradient-vera">Vera</span> que posiciona<br/>
              en Google
            </h1>

            <p class="text-lg text-slate-600 mb-8 leading-relaxed animate-fade-up stagger-3 speakable">
              Creamos páginas web profesionales para negocios de <strong>Vera, Vera Playa y Puerto Rey</strong>. Inmobiliarias, hoteles, restaurantes, comercios y servicios. <strong>Hosting gratuito</strong>, SEO local y diseño que convierte visitas en clientes.
            </p>

            <!-- Stats rápidas -->
            <div class="grid grid-cols-3 gap-4 mb-10 animate-fade-up stagger-4">
              <div class="text-center p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="text-2xl font-bold text-slate-900">450€</div>
                <div class="text-xs text-slate-500 mt-1">Desde</div>
              </div>
              <div class="text-center p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="text-2xl font-bold text-slate-900">&lt;1s</div>
                <div class="text-xs text-slate-500 mt-1">Carga</div>
              </div>
              <div class="text-center p-4 rounded-2xl bg-teal-50 border border-teal-100">
                <div class="text-2xl font-bold text-teal-600">0€</div>
                <div class="text-xs text-teal-600 mt-1">Hosting/año</div>
              </div>
            </div>

            <div class="flex flex-wrap gap-4 animate-fade-up stagger-5">
              <a href="/#contacto" class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-teal-500 to-cyan-600 text-white font-semibold shadow-lg shadow-teal-500/25 hover:shadow-xl hover:shadow-teal-500/35 hover:-translate-y-1 transition-all duration-300">
                <span>Pedir presupuesto gratis</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
              <a href="tel:+34657085019" class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-slate-100 text-slate-900 font-semibold hover:bg-slate-200 hover:-translate-y-1 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
                <span>657 085 019</span>
              </a>
            </div>
          </div>

          <!-- Imagen hero -->
          <div class="relative animate-fade-up stagger-3">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl">
              <img
                src="/imagenes/creacion-paginas-webs-vera.jpg"
                alt="Creación de páginas web en Vera y Vera Playa — diseño profesional para negocios locales"
                width="700"
                height="500"
                class="w-full h-auto object-cover"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
              <div class="absolute bottom-5 left-5 flex gap-2">
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/20 backdrop-blur-sm border border-white/30 text-white text-sm font-medium">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                  </svg>
                  Vera · Almería
                </span>
              </div>
            </div>
            <div class="absolute -inset-4 bg-gradient-to-r from-teal-500/20 to-cyan-500/20 rounded-3xl blur-2xl -z-10"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════
         TRES NÚCLEOS — VERA / VERA PLAYA / PUERTO REY
    ════════════════════════════════════════════ -->
    <section class="py-20 bg-gradient-to-b from-slate-50 to-white relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_60%,rgba(20,184,166,0.05)_0%,transparent_50%)]"></div>
      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="text-center mb-14">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-teal-50 border border-teal-200 text-teal-700 text-sm font-medium mb-5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
            </svg>
            Un municipio, tres mercados
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
            Diseño web para <span class="text-gradient-vera">cada zona de Vera</span>
          </h2>
          <p class="text-slate-500 max-w-2xl mx-auto">Vera es el único municipio del Levante con ciudad histórica, playa naturista internacional y urbanización costera de lujo. Cada zona tiene su audiencia y su estrategia.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <!-- Vera ciudad -->
          <div class="group rounded-3xl bg-white border border-slate-200 shadow-sm hover:shadow-xl hover:border-teal-300 transition-all duration-500 hover:-translate-y-1 overflow-hidden">
            <div class="h-2 bg-gradient-to-r from-teal-500 to-cyan-500"></div>
            <div class="p-8">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-teal-400 to-cyan-500 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
                </svg>
              </div>
