    --vp-coral:    #FF5A52;
    --vp-olive:    #768A4F;
    --vp-shadow:   8px 8px 0 var(--vp-ink);
  }

  .vp-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--vp-sunset);
    box-shadow: 0 0 0 0 rgba(255,107,53,0.55);
    animation: vp-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes vp-pulse {
    0% { box-shadow: 0 0 0 0 rgba(255,107,53,0.6); }
    70% { box-shadow: 0 0 0 10px rgba(255,107,53,0); }
    100% { box-shadow: 0 0 0 0 rgba(255,107,53,0); }
  }
  .vp-spin { transform-origin: 50% 50%; animation: vp-spin 25s linear infinite; }
  @keyframes vp-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .vp-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(0,120,255,0.10), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(255,184,51,0.10), transparent 50%),
      var(--vp-paper);
    border-bottom: 3px solid var(--vp-ink);
    position: relative;
    overflow: hidden;
  }
  .vp-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(135deg, transparent 0 24px, rgba(0,120,255,0.04) 24px 25px);
    pointer-events: none;
  }
  .vp-hero > * { position: relative; }

  .vp-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .vp-hero__status { color: var(--vp-sunset); font-weight: 700; }

  .vp-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 1024px) { .vp-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }

  .vp-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .vp-hero__chapter { color: var(--vp-sea); }
  .vp-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .95;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .vp-hero__title em { color: var(--vp-sunset); font-style: italic; }
  .vp-hero__title-sea {
    color: var(--vp-sea);
    border-bottom: 6px solid var(--vp-sea);
    padding: 0 .1em;
    display: inline-block;
    transform: rotate(-1deg);
  }
  .vp-hero__title-and { color: var(--vp-ink); margin: 0 .15em; }
  .vp-hero__title-sun {
    color: var(--vp-sun);
    background: var(--vp-ink);
    padding: 0 .15em;
    display: inline-block;
  }

  .vp-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 54ch;
  }
  .vp-hero__lead strong { color: var(--vp-ink); font-weight: 700; }
  .vp-hero__lead em { color: var(--vp-sunset); font-style: italic; font-weight: 600; }
  .vp-hero__lead-bold {
    display: block;
    margin-top: .75rem;
    background: var(--vp-lime);
    color: var(--vp-ink);
    padding: .25rem .55rem;
    font-weight: 800;
    border: 2px solid var(--vp-ink);
    box-shadow: 3px 3px 0 var(--vp-ink);
  }

  .vp-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .vp-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--vp-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .vp-btn--primary {
    background: var(--vp-sea);
    color: var(--vp-paper);
    box-shadow: 6px 6px 0 var(--vp-ink);
  }
  .vp-btn--primary:hover {
    background: var(--vp-sunset);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--vp-ink);
  }
  .vp-btn--ghost {
    background: transparent;
    color: var(--vp-ink);
    box-shadow: 6px 6px 0 var(--vp-sea);
  }
  .vp-btn--ghost:hover {
    background: var(--vp-ink);
    color: var(--vp-sun);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--vp-sea);
  }

  /* KPIs */
  .vp-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--vp-ink);
    background: var(--vp-ink);
  }
  @media (min-width: 768px) { .vp-kpis { grid-template-columns: repeat(4, 1fr); } }
  .vp-kpi {
    background: var(--vp-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--vp-ink);
    border-bottom: 2px solid var(--vp-ink);
  }
  .vp-kpi:nth-child(2n) { border-right: none; }
  .vp-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .vp-kpi:nth-child(2n)      { border-right: 2px solid var(--vp-ink); }
    .vp-kpi:nth-child(4n)      { border-right: none; }
    .vp-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--vp-ink); }
    .vp-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .vp-kpi--sea { background: var(--vp-sea); color: var(--vp-paper); }
  .vp-kpi--sun { background: var(--vp-sun); color: var(--vp-ink); }
  .vp-kpi--ink { background: var(--vp-ink); color: var(--vp-paper); }
  .vp-kpi--ink .vp-kpi__v { color: var(--vp-lime); }
  .vp-kpi__v { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; line-height: 1; }
  .vp-kpi__v small { font-size: .5em; opacity: .8; }
  .vp-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTAL VERA */
  .vp-hero__postal {
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(14,13,11,0.18));
  }
  .vp-postal {
    background: var(--vp-paper);
    border: 3px solid var(--vp-ink);
    box-shadow: var(--vp-shadow);
    overflow: hidden;
    position: relative;
    transform: rotate(-1deg);
    transition: transform .35s;
  }
  .vp-postal:hover { transform: rotate(0); }
  .vp-postal__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .75rem 1rem;
    background: var(--vp-sea);
    color: var(--vp-paper);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--vp-ink);
  }
  .vp-postal__img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 2px solid var(--vp-ink);
  }
  .vp-postal__img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(1.1);
    transition: transform .6s cubic-bezier(.16,1,.3,1);
  }
  .vp-postal:hover .vp-postal__img { transform: scale(1.05); }
  .vp-postal__stamp {
    position: absolute;
    top: 12px; right: 12px;
    width: 80px; height: 80px;
    transform: rotate(-12deg);
    filter: drop-shadow(0 4px 10px rgba(255,107,53,0.4));
  }
  .vp-postal__sede {
    position: absolute;
    bottom: 12px; left: 12px;
    background: var(--vp-lime);
    color: var(--vp-ink);
    padding: .4rem .75rem;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 2px solid var(--vp-ink);
    box-shadow: 3px 3px 0 var(--vp-ink);
    transform: rotate(-2deg);
  }
  .vp-postal__data {
    padding: 1rem 1.25rem;
    background: var(--vp-paper-2);
    display: grid; gap: .35rem;
  }
  .vp-postal__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
    font-size: .68rem;
  }
  .vp-postal__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .vp-postal__data-row > span:first-child {
    color: var(--vp-sea-d);
    letter-spacing: .2em;
    font-weight: 800;
  }
  .vp-postal__data-v {
    color: var(--vp-ink);
    font-weight: 700;
    letter-spacing: .05em;
  }

  /* Marquee */
  .vp-marquee {
    background: var(--vp-sea);
    color: var(--vp-paper);
    overflow: hidden;
    padding: .9rem 0;
    border-top: 3px solid var(--vp-ink);
  }
  .vp-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: vp-marquee 38s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  @keyframes vp-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* 3 NÚCLEOS                                               */
  /* ═══════════════════════════════════════════════════════ */
  .vp-nucleos-section {
    background: var(--vp-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--vp-ink);
  }
  .vp-nucleos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) { .vp-nucleos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .vp-nucleo {
    position: relative;
    background: var(--vp-paper);
    border: 3px solid var(--vp-ink);
    box-shadow: var(--vp-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .vp-nucleo:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .vp-nucleo--sand   { color: var(--vp-sand); }
  .vp-nucleo--sea    { color: var(--vp-sea); }
  .vp-nucleo--sunset { color: var(--vp-sunset); }
  .vp-nucleo__code {
    position: absolute;
    top: -16px; right: 20px;
    background: var(--vp-ink);
    color: var(--vp-lime);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .vp-nucleo__icon {
    width: 100%;
    aspect-ratio: 1;
    max-width: 200px;
    margin: 0 auto;
    color: currentColor;
  }
  .vp-nucleo__name {
    font-size: clamp(1.5rem, 2.8vw, 1.85rem);
    line-height: 1;
    letter-spacing: -.025em;
    color: var(--vp-ink);
    margin: .5rem 0 0;
    text-align: center;
  }
  .vp-nucleo__sub {
    font-size: .62rem;
    letter-spacing: .25em;
    color: currentColor;
    font-weight: 800;
    text-align: center;
  }
  .vp-nucleo__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .75rem;
    padding-top: .75rem;
    border-top: 2px dashed currentColor;
    margin-top: auto;
  }
  .vp-nucleo__stats > div { display: flex; flex-direction: column; gap: 2px; }
  .vp-nucleo__stat-l { font-size: .55rem; letter-spacing: .2em; color: var(--vp-sea-d); opacity: .75; }
  .vp-nucleo__stat-v { font-size: .85rem; color: var(--vp-ink); font-weight: 700; line-height: 1.3; }

  /* ═══════════════════════════════════════════════════════ */
  /* MAPA                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .vp-map-section {
    background: var(--vp-paper-2);
    border-bottom: 3px solid var(--vp-ink);
    padding-bottom: 0;
  }
  .vp-map-head {
    padding: 4rem 0 2rem;
  }
  .vp-map-head__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: end;
  }
  @media (min-width: 768px) { .vp-map-head__inner { grid-template-columns: 1.6fr 1fr; } }
  .vp-map-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 0;
  }
  .vp-map-title em { color: var(--vp-sea); }
  .vp-map-coords {
    background: var(--vp-ink);
    color: var(--vp-sun);
    padding: 1rem 1.25rem;
    border: 2px solid var(--vp-sun);
    box-shadow: 5px 5px 0 var(--vp-sun);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem;
    letter-spacing: .15em;
  }

  .vp-map-frame {
    position: relative;
    border-top: 3px solid var(--vp-ink);
    border-bottom: 3px solid var(--vp-ink);
    background: var(--vp-ink);
  }
  .vp-map-frame__corner {
    position: absolute;
    width: 30px; height: 30px;
    border: 3px solid var(--vp-sunset);
    z-index: 5;
    pointer-events: none;
  }
  .vp-map-frame__corner--tl { top: 12px; left: 12px; border-right: none; border-bottom: none; }
  .vp-map-frame__corner--tr { top: 12px; right: 12px; border-left: none; border-bottom: none; }
  .vp-map-frame__corner--bl { bottom: 12px; left: 12px; border-right: none; border-top: none; }
  .vp-map-frame__corner--br { bottom: 12px; right: 12px; border-left: none; border-top: none; }
  .vp-map-frame__label {
    position: absolute;
    z-index: 5;
    background: var(--vp-ink);
    color: var(--vp-sun);
    padding: .25rem .55rem;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 1.5px solid var(--vp-sun);
    pointer-events: none;
  }
  .vp-map-frame__label--n { top: 14px; left: 50%; transform: translateX(-50%); }
  .vp-map-frame__label--s { bottom: 14px; left: 50%; transform: translateX(-50%); }
  .vp-map-frame__label--e { right: 14px; top: 50%; transform: translateY(-50%); }
  .vp-map-frame__label--w { left: 14px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .vp-map-frame__label--e, .vp-map-frame__label--w { display: none; }
  }
  .vp-map-wrap {
    width: 100%;
    height: clamp(420px, 60vh, 600px);
    overflow: hidden;
  }
  .vp-map-wrap > * { width: 100%; height: 100%; }

  /* ═══════════════════════════════════════════════════════ */
  /* ESTUDIO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .vp-studio-section {
    background: var(--vp-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--vp-ink);
  }
  .vp-studio {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .vp-studio { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }

  .vp-studio__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: .95;
    letter-spacing: -.04em;
    margin: 1rem 0;
  }
  .vp-studio__title em { color: var(--vp-sunset); }
  .vp-studio__lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    margin-bottom: 1.5rem;
  }
  .vp-studio__lead strong { color: var(--vp-ink); font-weight: 700; }

  .vp-studio__data {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0 0 1.5rem;
    border: 2px solid var(--vp-ink);
    background: var(--vp-paper-2);
  }
  @media (min-width: 640px) { .vp-studio__data { grid-template-columns: 1fr 1fr; } }
  .vp-studio__data > div {
    padding: .85rem 1rem;
    display: flex; flex-direction: column; gap: 2px;
    border-bottom: 1px solid var(--vp-ink);
  }
  @media (min-width: 640px) {
    .vp-studio__data > div:nth-child(odd) { border-right: 1px solid var(--vp-ink); }
    .vp-studio__data > div:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .vp-studio__data > div:last-child { border-bottom: none; }
  }
  .vp-studio__data dt {
    font-size: .58rem;
    letter-spacing: .2em;
    color: var(--vp-sea-d);
    opacity: .8;
  }
  .vp-studio__data dd {
    font-size: .88rem;
    line-height: 1.4;
    color: var(--vp-ink);
    margin: 0;
  }
  .vp-link {
    color: var(--vp-ink);
    text-decoration: underline;
    text-decoration-color: var(--vp-sunset);
    text-underline-offset: 3px;
    transition: color .2s;
  }
  .vp-link:hover { color: var(--vp-sunset); }

  .vp-studio__cta { display: flex; flex-wrap: wrap; gap: 1rem; }
  .vp-studio__r {
    position: relative;
    border: 3px solid var(--vp-ink);
    box-shadow: var(--vp-shadow);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    transform: rotate(1deg);
    transition: transform .35s;
  }
  .vp-studio__r:hover { transform: rotate(0); }
  .vp-studio__img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(1.1);
  }
  .vp-studio__caption {
    position: absolute;
    bottom: 0; left: 0;
    background: var(--vp-ink);
    color: var(--vp-lime);
    padding: .55rem 1rem;
    font-size: .65rem;
    letter-spacing: .2em;
    border-top: 2px solid var(--vp-ink);
    border-right: 2px solid var(--vp-ink);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* SECTORES                                                */
  /* ═══════════════════════════════════════════════════════ */
  .vp-sec-section {
    background: var(--vp-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--vp-ink);
  }
  .vp-sec {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .vp-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .vp-sec { grid-template-columns: repeat(3, 1fr); } }
  .vp-sec__card {
    background: var(--vp-paper);
    border: 2.5px solid var(--vp-ink);
    box-shadow: var(--vp-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s, background .25s;
    position: relative;
    overflow: hidden;
  }
  .vp-sec__card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .vp-sec__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 12px 12px 0 currentColor;
  }
  .vp-sec__card--sea    { color: var(--vp-sea); }
  .vp-sec__card--sunset { color: var(--vp-sunset); }
  .vp-sec__card--sun    { color: var(--vp-sun); }
  .vp-sec__card--sand   { color: var(--vp-sand); }
  .vp-sec__card--coral  { color: var(--vp-coral); }
  .vp-sec__card--olive  { color: var(--vp-olive); }

  .vp-sec__head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
  }
  .vp-sec__num { font-size: 1.25rem; font-weight: 800; color: currentColor; }
  .vp-sec__stat { font-size: .68rem; letter-spacing: .12em; color: currentColor; font-weight: 800; }
  .vp-sec__title {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    color: var(--vp-ink);
    margin: 0;
  }
  .vp-sec__desc {
    font-size: .9rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
    flex: 1;
  }
  .vp-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .vp-sec__tag {
    display: flex; align-items: flex-start; gap: .35rem;
    font-size: .8rem;
    line-height: 1.35;
    color: var(--vp-ink);
  }
  .vp-sec__tag span { color: currentColor; font-weight: 800; }
  .vp-sec__foot {
    padding-top: .65rem;
    border-top: 2px solid var(--vp-ink);
  }
  .vp-sec__cta {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* DIFERENCIALES                                           */
  /* ═══════════════════════════════════════════════════════ */
  .vp-dif-section {
    background: var(--vp-sea-d);
    color: var(--vp-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--vp-ink);
    position: relative;
    overflow: hidden;
  }
  .vp-dif-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,184,51,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .vp-dif-section > * { position: relative; }
  .vp-dif {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px)  { .vp-dif { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .vp-dif { grid-template-columns: repeat(4, 1fr); } }
  .vp-dif__item {
    background: rgba(255,252,246,0.05);
    border: 2px solid var(--vp-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .vp-dif__item:hover { background: rgba(255,184,51,0.12); transform: translateY(-3px); }
  .vp-dif__num { font-size: .85rem; color: var(--vp-sun); font-weight: 800; letter-spacing: .15em; }
  .vp-dif__t {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--vp-paper);
    margin: 0;
  }
  .vp-dif__desc { font-size: .85rem; line-height: 1.45; color: rgba(255,252,246,0.75); margin: 0; }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .vp-quote-section {
    background: var(--vp-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--vp-ink);
  }
  .vp-pull {
    position: relative;
    background: var(--vp-foam);
    border: 3px solid var(--vp-ink);
    box-shadow: var(--vp-shadow);
    padding: 3rem 2rem 2rem;
    margin: 2rem 0;
  }
  .vp-pull__seal {
    position: absolute;
    top: -30px; right: 30px;
    width: 90px; aspect-ratio: 1;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 8px rgba(0,120,255,0.35));
  }
  .vp-pull__q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.3;
    margin: 0 0 1.5rem;
    color: var(--vp-ink);
    max-width: 56ch;
  }
  .vp-pull__cap { display: flex; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 2px dashed var(--vp-ink); }
  .vp-pull__avatar {
    width: 48px; height: 48px;
    background: var(--vp-sea); color: var(--vp-paper);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-size: 1.35rem; font-weight: 800;
    border-radius: 50%;
  }
  .vp-pull__cap div { display: flex; flex-direction: column; }
  .vp-pull__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--vp-ink); }
  .vp-pull__role { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; opacity: .65; text-transform: uppercase; }

  .vp-quotes {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .vp-quotes { grid-template-columns: repeat(3, 1fr); } }
  .vp-quote {
    position: relative;
    background: var(--vp-paper);
    border: 2px solid var(--vp-ink);
    box-shadow: 5px 5px 0 var(--vp-ink);
    padding: 1.75rem 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .vp-quote:hover { transform: translateY(-3px); }
