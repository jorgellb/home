<style>
  /* ══════════════════════════════════════════════════════
     PALETA · NÍJAR · CABO DE GATA VOLCÁNICO + ARTESANÍA
     ══════════════════════════════════════════════════════ */
  .nj {
    --nj-paper:    #F6EEDD;       /* Arena cálida */
    --nj-paper-2:  #EFE3CB;
    --nj-arena:    #E8C77E;       /* Arena dorada */
    --nj-ink:      #1A120C;       /* Tierra volcánica casi negra */
    --nj-volcan:   #C0492B;       /* Roca volcánica rojiza */
    --nj-volcan-d: #8E3D22;
    --nj-turquesa: #1B9AAA;       /* Mar turquesa cala */
    --nj-turquesa2:#28B5C0;
    --nj-ceramica: #2F7E54;       /* Verde loza de Níjar */
    --nj-ceramica-d:#1C4F36;
    --nj-ocre:     #E0A02E;       /* Ocre desierto / sol */
    --nj-esparto:  #B98A3C;       /* Fibra esparto */
    --nj-rosa:     #EE6C8A;       /* Flamenco */
    --nj-pita:     #7A8B5A;       /* Verde agave */
    --nj-shadow:   8px 8px 0 var(--nj-ink);
  }
  .nj-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--nj-ceramica);
    box-shadow: 0 0 0 0 rgba(47,126,84,0.55);
    animation: nj-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes nj-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(47,126,84,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(47,126,84,0); }
    100% { box-shadow: 0 0 0 0 rgba(47,126,84,0); }
  }
  .nj-spin { transform-origin: 50% 50%; animation: nj-spin 30s linear infinite; }
  @keyframes nj-spin { to { transform: rotate(360deg); } }

  /* HERO */
  .nj-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 78% 18%, rgba(224,160,46,0.12), transparent 50%),
      radial-gradient(circle at 12% 82%, rgba(27,154,170,0.10), transparent 50%),
      var(--nj-paper);
    border-bottom: 3px solid var(--nj-ink);
    position: relative;
    overflow: hidden;
  }
  .nj-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(135deg, transparent 0 38px, rgba(192,73,43,0.04) 38px 39px);
    pointer-events: none;
  }
  .nj-hero > * { position: relative; }
  .nj-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .nj-hero__status { color: var(--nj-ceramica); font-weight: 700; }
  .nj-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .nj-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .nj-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .nj-hero__chapter { color: var(--nj-volcan); }
  .nj-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .nj-hero__title em { color: var(--nj-volcan); font-style: italic; }
  .nj-hero__title-stamp {
    display: inline-block;
    color: var(--nj-paper);
    background: var(--nj-ceramica);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .nj-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 54ch; }
  .nj-hero__lead strong { color: var(--nj-ink); font-weight: 700; }
  .nj-hero__lead em { color: var(--nj-turquesa); font-style: italic; font-weight: 600; }
  .nj-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .nj-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--nj-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .nj-btn--primary { background: var(--nj-volcan); color: var(--nj-paper); box-shadow: 6px 6px 0 var(--nj-ink); }
  .nj-btn--primary:hover { background: var(--nj-ceramica); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--nj-ink); }
  .nj-btn--ghost { background: transparent; color: var(--nj-ink); box-shadow: 6px 6px 0 var(--nj-turquesa); }
  .nj-btn--ghost:hover { background: var(--nj-ink); color: var(--nj-ocre); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--nj-turquesa); }

  /* KPIs */
  .nj-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--nj-ink);
    background: var(--nj-ink);
  }
  @media (min-width: 768px) { .nj-kpis { grid-template-columns: repeat(4, 1fr); } }
  .nj-kpi {
    background: var(--nj-paper); padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--nj-ink); border-bottom: 2px solid var(--nj-ink);
  }
  .nj-kpi:nth-child(2n) { border-right: none; }
  .nj-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .nj-kpi:nth-child(2n)      { border-right: 2px solid var(--nj-ink); }
    .nj-kpi:nth-child(4n)      { border-right: none; }
    .nj-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--nj-ink); }
    .nj-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .nj-kpi--turquesa { background: var(--nj-turquesa); color: var(--nj-paper); }
  .nj-kpi--ocre     { background: var(--nj-ocre); color: var(--nj-ink); }
  .nj-kpi--ceramica { background: var(--nj-ceramica); color: var(--nj-paper); }
  .nj-kpi--ink      { background: var(--nj-ink); color: var(--nj-paper); }
  .nj-kpi--ink .nj-kpi__v { color: var(--nj-ocre); }
  .nj-kpi__v { font-size: clamp(1.5rem, 3.6vw, 2.1rem); font-weight: 800; line-height: 1; }
  .nj-kpi__v small { font-size: .5em; opacity: .8; }
  .nj-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .nj-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(26,18,12,0.2));
  }
  .nj-postcard {
    background: var(--nj-paper);
    border: 3px solid var(--nj-ink);
    box-shadow: var(--nj-shadow);
    overflow: hidden;
    transform: rotate(1deg);
    transition: transform .35s;
  }
  .nj-postcard:hover { transform: rotate(0); }
  .nj-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--nj-ceramica);
    color: var(--nj-paper);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--nj-ink);
  }
  .nj-postcard__profile {
    width: 100%; aspect-ratio: 540 / 240;
    border-bottom: 2px solid var(--nj-ink);
    overflow: hidden;
  }
  .nj-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--nj-ink); }
  .nj-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.08) sepia(0.08); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .nj-postcard:hover .nj-postcard__img { transform: scale(1.05); }
  .nj-postcard__seal { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(8deg); filter: drop-shadow(0 4px 10px rgba(47,126,84,0.5)); }
  .nj-postcard__tag {
    position: absolute; bottom: 12px; left: 12px;
    background: var(--nj-ocre); color: var(--nj-ink);
    padding: .4rem .75rem;
    font-size: .65rem; font-weight: 800; letter-spacing: .2em;
    border: 2px solid var(--nj-ink);
    box-shadow: 3px 3px 0 var(--nj-volcan);
    transform: rotate(-2deg);
  }
  .nj-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--nj-paper-2);
    display: grid; gap: .35rem;
  }
  .nj-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(26,18,12,0.18);
    font-size: .68rem;
  }
  .nj-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .nj-postcard__data-row > span:first-child { color: var(--nj-volcan-d); letter-spacing: .2em; font-weight: 800; }
  .nj-postcard__data-v { color: var(--nj-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .nj-marquee {
    background: var(--nj-volcan); color: var(--nj-paper);
    overflow: hidden; padding: .9rem 0;
    border-top: 3px solid var(--nj-ink);
  }
  .nj-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: nj-marquee 38s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem; font-weight: 800;
    letter-spacing: .15em; text-transform: uppercase;
  }
  @keyframes nj-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* PARQUE NATURAL SECTION */
  .nj-parque-section {
    background: var(--nj-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--nj-ink);
    position: relative;
    overflow: hidden;
  }
  .nj-parque-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(27,154,170,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .nj-parque-section > * { position: relative; }
  .nj-parque-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .nj-parque-grid { grid-template-columns: 1.25fr 1fr; gap: 4rem; } }
  .nj-parque-chapter { color: var(--nj-turquesa); }
  .nj-parque-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; }
  .nj-parque-title em { color: var(--nj-turquesa); }
  .nj-parque-lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); margin-bottom: 1.75rem; max-width: 56ch; }
  .nj-parque-lead strong { color: var(--nj-ink); font-weight: 700; }
  .nj-parque-lead em { color: var(--nj-volcan); font-style: italic; }
  .nj-calas { border: 2.5px solid var(--nj-ink); background: var(--nj-paper); box-shadow: 6px 6px 0 var(--nj-ink); }
  .nj-calas__label { display: block; background: var(--nj-turquesa); color: var(--nj-paper); padding: .65rem 1rem; font-size: .65rem; letter-spacing: .2em; font-weight: 800; border-bottom: 2px solid var(--nj-ink); }
  .nj-calas__list { list-style: none; margin: 0; padding: 0; }
  .nj-cala { display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: .75rem; padding: .7rem 1rem; border-bottom: 1px dashed rgba(26,18,12,0.18); }
  .nj-cala:last-child { border-bottom: none; }
  .nj-cala__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--nj-turquesa); border: 1.5px solid var(--nj-ink); }
  .nj-cala__n { font-family: var(--font-display); font-weight: 700; font-size: .95rem; color: var(--nj-ink); }
  .nj-cala__d { font-family: var(--font-mono); font-size: .68rem; color: var(--brutal-text-secondary); text-align: right; letter-spacing: .03em; }
  .nj-parque-r { max-width: 320px; margin: 0 auto; border: 3px solid var(--nj-ink); box-shadow: var(--nj-shadow); line-height: 0; }

  /* ICONOS */
  .nj-iconos-section { background: var(--nj-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--nj-ink); }
  .nj-iconos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 1024px) { .nj-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .nj-icono {
    position: relative;
    background: var(--nj-paper);
    border: 3px solid var(--nj-ink);
    box-shadow: var(--nj-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .nj-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .nj-icono--turquesa { color: var(--nj-turquesa); }
  .nj-icono--rosa     { color: var(--nj-rosa); }
  .nj-icono--volcan   { color: var(--nj-volcan); }
  .nj-icono__code {
    position: absolute; top: -16px; right: 20px;
    background: var(--nj-ink); color: var(--nj-ocre);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .nj-icono__svg { width: 100%; aspect-ratio: 1; max-width: 200px; margin: 0 auto; color: currentColor; }
  .nj-icono__name { font-size: clamp(1.5rem, 2.8vw, 1.85rem); line-height: 1; letter-spacing: -.025em; color: var(--nj-ink); margin: .5rem 0 0; text-align: center; }
  .nj-icono__sub { font-size: .62rem; letter-spacing: .25em; color: currentColor; font-weight: 800; text-align: center; }
  .nj-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; text-align: center; }
  .nj-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .nj-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* ARTESANÍA */
  .nj-art-section { background: var(--nj-ceramica-d); color: var(--nj-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--nj-ink); position: relative; overflow: hidden; }
  .nj-art-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(246,238,221,0.06) 1.3px, transparent 1.3px); background-size: 26px 26px; pointer-events: none; }
  .nj-art-section > * { position: relative; }
  .nj-art-head { max-width: 760px; margin-bottom: 2.5rem; }
  .nj-art-chapter { color: var(--nj-ocre); }
  .nj-art-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; color: var(--nj-paper); }
  .nj-art-title em { color: var(--nj-ocre); }
  .nj-art-lead { font-size: 1.1rem; line-height: 1.55; color: rgba(246,238,221,0.8); max-width: 60ch; }
  .nj-art-lead strong { color: var(--nj-paper); font-weight: 700; }
  .nj-art-lead em { color: var(--nj-turquesa2); font-style: italic; }

  /* TELAR */
  .nj-loom {
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 3px solid var(--nj-ink);
    background: var(--nj-paper);
    box-shadow: var(--nj-shadow);
    margin-bottom: 2.5rem;
    overflow: hidden;
  }
  @media (min-width: 900px) { .nj-loom { grid-template-columns: 1.4fr 1fr; } }
  .nj-loom__svg { background: #5E3A22; padding: 1.5rem; line-height: 0; border-bottom: 3px solid var(--nj-ink); }
  @media (min-width: 900px) { .nj-loom__svg { border-bottom: none; border-right: 3px solid var(--nj-ink); } }
  .nj-loom__caption { padding: 1.75rem; display: flex; flex-direction: column; gap: .65rem; justify-content: center; }
  .nj-loom__cap-k { font-size: .65rem; letter-spacing: .25em; color: var(--nj-volcan); font-weight: 800; }
  .nj-loom__caption p { font-size: .95rem; line-height: 1.55; color: var(--nj-ink); margin: 0; }
  .nj-loom__caption strong { color: var(--nj-volcan); }

  /* OFICIOS */
  .nj-oficios { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) { .nj-oficios { grid-template-columns: repeat(3, 1fr); } }
  .nj-oficio {
    background: var(--nj-paper);
    border: 2.5px solid var(--nj-ink);
    box-shadow: 6px 6px 0 var(--nj-ink);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
  }
  .nj-oficio::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: currentColor; }
  .nj-oficio:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .nj-oficio--jarapa   { color: var(--nj-volcan); }
  .nj-oficio--ceramica { color: var(--nj-ceramica); }
  .nj-oficio--esparto  { color: var(--nj-esparto); }
  .nj-oficio__head { display: flex; justify-content: space-between; align-items: center; }
  .nj-oficio__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .nj-oficio__tag { font-size: .58rem; letter-spacing: .2em; font-weight: 800; color: var(--nj-paper); background: currentColor; padding: .25rem .55rem; }
  .nj-oficio__svg { width: 100%; max-width: 130px; aspect-ratio: 1; margin: .25rem auto; color: currentColor; }
  .nj-oficio__name { font-size: clamp(1.35rem, 2.4vw, 1.65rem); line-height: 1; letter-spacing: -.02em; color: var(--nj-ink); margin: 0; text-align: center; }
  .nj-oficio__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); text-align: center; }

  /* HITOS */
  .nj-hitos-section {
    background: var(--nj-ink); color: var(--nj-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--nj-ink);
    position: relative; overflow: hidden;
  }
  .nj-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(224,160,46,0.08) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .nj-hitos-section > * { position: relative; }
  .nj-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2.5px solid var(--nj-paper);
  }
  @media (min-width: 640px)  { .nj-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .nj-hitos { grid-template-columns: repeat(3, 1fr); } }
  .nj-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(246,238,221,0.22);
    border-right: 1px solid rgba(246,238,221,0.22);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(246,238,221,0.03);
    transition: background .25s;
  }
  .nj-hito:hover { background: rgba(192,73,43,0.16); }
  @media (min-width: 1024px) {
    .nj-hito:nth-child(3n) { border-right: none; }
    .nj-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .nj-hito:nth-child(2n) { border-right: none; }
    .nj-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .nj-hito { border-right: none; } .nj-hito:last-child { border-bottom: none; } }
  .nj-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--nj-ocre); font-weight: 800; }
  .nj-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--nj-paper); line-height: 1.35; }

  /* SECTORES */
  .nj-sec-section { background: var(--nj-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--nj-ink); }
  .nj-sec { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px)  { .nj-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .nj-sec { grid-template-columns: repeat(3, 1fr); } }
  .nj-sec__card {
    background: var(--nj-paper);
    border: 2.5px solid var(--nj-ink);
    box-shadow: var(--nj-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
  }
  .nj-sec__card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: currentColor; }
  .nj-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .nj-sec__card--turquesa { color: var(--nj-turquesa); }
  .nj-sec__card--ceramica { color: var(--nj-ceramica); }
  .nj-sec__card--volcan   { color: var(--nj-volcan); }
  .nj-sec__card--ocre     { color: var(--nj-ocre); }
  .nj-sec__card--esparto  { color: var(--nj-esparto); }
  .nj-sec__card--ink      { color: var(--nj-pita); }
  .nj-sec__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; gap: .5rem; }
  .nj-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .nj-sec__stat-box {
    background: var(--nj-ink); color: var(--nj-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .nj-sec__stat-v { font-size: .95rem; font-weight: 800; color: currentColor; line-height: 1; }
  .nj-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .nj-sec__title { font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.1; letter-spacing: -.02em; color: var(--nj-ink); margin: 0; }
  .nj-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; }
  .nj-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .nj-sec__tag { display: flex; align-items: flex-start; gap: .35rem; font-size: .78rem; line-height: 1.35; color: var(--nj-ink); }
  .nj-sec__tag span { color: currentColor; font-weight: 800; }
  .nj-sec__foot { padding-top: .65rem; border-top: 2px solid var(--nj-ink); }
  .nj-sec__cta { font-family: var(--font-mono); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .15em; color: currentColor; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px; }

  /* MAPA */
  .nj-map-section { background: var(--nj-arena); border-bottom: 3px solid var(--nj-ink); }
  .nj-map-head { padding: 4rem 0 2rem; }
  .nj-map-head__inner { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; }
  @media (min-width: 768px) { .nj-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .nj-map-chapter { color: var(--nj-ceramica-d); }
  .nj-map-title { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0 0; }
  .nj-map-title em { color: var(--nj-ceramica-d); }
  .nj-map-coords {
    background: var(--nj-ceramica); color: var(--nj-paper);
    padding: 1rem 1.25rem;
    border: 2px solid var(--nj-ink);
    box-shadow: 5px 5px 0 var(--nj-ocre);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem; letter-spacing: .15em;
  }
  .nj-map-frame { border-top: 3px solid var(--nj-ink); border-bottom: 3px solid var(--nj-ink); background: var(--nj-ink); }
  .nj-map-wrap > * { width: 100%; }

  /* DIFERENCIALES */
