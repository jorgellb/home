    <section class="cb-lonja-section" id="lonja">
      <div class="container-brutal">
        <header class="cb-lonja-head">
          <span class="text-meta cb-lonja-chapter">Cap. 04 / Pesca artesanal</span>
          <h2 class="cb-lonja-title heading-display">
            De la lonja
            <em class="heading-editorial">a la mesa, el mismo día.</em>
          </h2>
          <p class="cb-lonja-lead">
            Carboneras conserva una <strong>flota de pesca artesanal</strong> y
            su <em>lonja</em>. El pescado que se subasta por la tarde se sirve
            esa misma noche. Esa frescura es un <strong>argumento de venta
            brutal</strong> — y casi ningún restaurante lo cuenta bien online.
          </p>
        </header>

        {/* Timeline del pescado */}
        <ol class="cb-lonja-flow">
          {lonjaFlow.map((s, i) => (
            <li class={`cb-flow cb-flow--${s.color}`}>
              <div class="cb-flow__time text-mono">{s.h}</div>
              <Postal class="cb-flow__postal">
                <div class="cb-flow__icon" aria-hidden="true">
                {i === 0 && (
                  <svg viewBox="0 0 60 60" width="100%" height="100%">
                    {/* Barca volviendo */}
                    <path d="M 6 34 L 54 34 L 47 48 L 13 48 Z" fill="currentColor" stroke="#0B1416" stroke-width="2.5"/>
                    <rect x="16" y="30" width="28" height="4" fill="#0B1416"/>
                    <line x1="30" y1="34" x2="30" y2="12" stroke="#0B1416" stroke-width="2"/>
                    <path d="M 30 12 L 46 24 L 30 28 Z" fill="#FFF7E8" stroke="#0B1416" stroke-width="1.5"/>
                    <path d="M 4 40 Q 14 36 24 40" fill="none" stroke="#0B1416" stroke-width="1.2" opacity="0.5"/>
                  </svg>
                )}
                {i === 1 && (
                  <svg viewBox="0 0 60 60" width="100%" height="100%">
                    {/* Caja de pescado + balanza */}
                    <rect x="8" y="34" width="44" height="18" fill="currentColor" stroke="#0B1416" stroke-width="2.5"/>
                    <path d="M 8 34 L 52 34" stroke="#0B1416" stroke-width="1"/>
                    {/* Pescados */}
                    <g fill="#E9FBFB" stroke="#0B1416" stroke-width="1.2">
                      <path d="M 14 40 Q 22 36 30 40 Q 22 44 14 40 Z M 14 40 L 10 37 L 10 43 Z"/>
                      <path d="M 30 44 Q 38 40 46 44 Q 38 48 30 44 Z M 30 44 L 26 41 L 26 47 Z"/>
                    </g>
                    {/* Martillo subasta */}
                    <g transform="translate(40, 16) rotate(20)">
                      <rect x="-3" y="0" width="6" height="16" fill="#8E5436" stroke="#0B1416" stroke-width="1.5"/>
                      <rect x="-9" y="-8" width="18" height="10" rx="2" fill="#C9A877" stroke="#0B1416" stroke-width="1.5"/>
                    </g>
                  </svg>
                )}
                {i === 2 && (
                  <svg viewBox="0 0 60 60" width="100%" height="100%">
                    {/* Plato con pescado */}
                    <ellipse cx="30" cy="36" rx="24" ry="10" fill="#FFF7E8" stroke="#0B1416" stroke-width="2.5"/>
                    <ellipse cx="30" cy="34" rx="18" ry="7" fill="none" stroke="currentColor" stroke-width="1.5"/>
                    <g fill="currentColor" stroke="#0B1416" stroke-width="1.3">
                      <path d="M 20 34 Q 30 28 40 34 Q 30 40 20 34 Z"/>
                      <path d="M 20 34 L 14 30 L 14 38 Z"/>
                    </g>
                    <circle cx="34" cy="32" r="1.3" fill="#0B1416"/>
                    {/* Limón */}
                    <circle cx="46" cy="38" r="4" fill="#E5A92B" stroke="#0B1416" stroke-width="1.2"/>
                    {/* Tenedor */}
                    <g transform="translate(10, 22)" stroke="#0B1416" stroke-width="1.5">
                      <line x1="0" y1="0" x2="0" y2="18"/><line x1="-3" y1="0" x2="-3" y2="6"/><line x1="3" y1="0" x2="3" y2="6"/>
                    </g>
                  </svg>
                )}
                </div>
              </Postal>
              <h3 class="cb-flow__t heading-display">{s.t}</h3>
              <p class="cb-flow__d">{s.d}</p>
              {i < lonjaFlow.length - 1 && <span class="cb-flow__arrow" aria-hidden="true">→</span>}
            </li>
          ))}
