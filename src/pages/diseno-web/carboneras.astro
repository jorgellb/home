<style>
  /* ══════════════════════════════════════════════════════
     PALETA · CARBONERAS · COSTA SALVAJE CRISTALINA
     ══════════════════════════════════════════════════════ */
  /* Fase 2 · consola. paper hacía de fondo y de tinta clara a la vez, e ink
     de borde, sombra, fondo y texto: cada uno se reparte. El mediterráneo
     profundo y la roca no llegaban a 4,5:1 sobre suelo y suben; deep-d y
     navy ya eran fondos hondos y se quedan como tales. Las ilustraciones
     no se tocan: van en postal (§3.3.6). */
  .cb {
    --cb-paper:    var(--color-cdm-panel);
    --cb-paper-2:  var(--color-cdm-panel-2);
    --cb-arena:    var(--color-cdm-panel-2);
    --cb-suelo:    var(--color-cdm-suelo);
    --cb-tinta:    var(--color-cdm-texto);
    --cb-tenue:    var(--color-cdm-tenue);
    --cb-ink:      var(--color-cdm-regla-2);
    --cb-aqua:     #3CC2C9;       /* Aguamarina cristal */
    --cb-aqua-l:   #2FCBCF;
    --cb-deep:     #3FA8B8;       /* Mediterráneo, aclarado para leer */
    --cb-deep-d:   #093A44;       /* mar hondo: solo fondo */
    --cb-navy:     #0A2F38;       /* azul hondo: solo fondo */
    --cb-coral:    #F26B3A;       /* Coral atardecer */
    --cb-oro:      #E5A92B;       /* Oro faro */
    --cb-slate:    #B08258;       /* Roca/acantilado, aclarada */
    --cb-shadow:   8px 8px 0 var(--color-cdm-regla-2);

    background: var(--cb-suelo);
    color: var(--cb-tinta);
  }

  /* Globales heredados, que venían en tinta oscura sobre papel. */
  .cb :global(.brutal-section-head__title) { color: var(--cb-tinta); }
  .cb :global(.brutal-section-head__title em) { color: var(--cb-deep); }
  .cb :global(.brutal-section-head__lead) { color: var(--cb-tenue); }
  .cb :global(:where(.text-meta)) { color: var(--cb-tenue); } /* :where: sin especificidad, para que el color propio de cada capítulo mande */
  .cb :global(.divider-brutal) { background: var(--color-cdm-regla); }

  .cb section[id] { scroll-margin-top: 96px; }

  /* Iconos y recorrido de la lonja van en postal: son line-art sobre
     transparente y sus trazos se perderían sobre el panel oscuro. */
  .cb-icono__postal { max-width: 220px; margin: 0 auto; }
  .cb-flow__postal { max-width: 120px; margin: .25rem auto; }

  /* El enlace al índice de municipios estaba suelto y con estilos inline,
     fuera de todo contenedor: se iba a sangre. */
  .cb-todos { background: var(--cb-suelo); padding: 2.5rem 1.5rem; text-align: center; }
  .cb-todos a { font-weight: 700; font-size: 1.05rem; color: var(--cb-aqua-l); text-decoration: underline; text-underline-offset: 3px; }

  /* Raíl del índice: banda izquierda a partir de 1280 px, fuera de la caja
     de contenido; por debajo, solo la barra de progreso. */
  @media (min-width: 1280px) {
    .cb :global(.cdm-indice) {
      position: fixed;
      top: 96px;
      left: 0;
      width: 208px;
      padding-inline: clamp(1rem, 2vw, 1.75rem) 1rem;
      z-index: 30;
    }
    .cb :global(.container-brutal) { padding-left: calc(var(--container-gutter) + 208px); }
    .cb-marquee,
    .cb-map-frame,
    .cb-final__marquee { padding-left: 208px; }
  }
  @media (max-width: 1279px) {
    .cb :global(.cdm-indice) {
      display: block;
      position: sticky;
      top: 64px;
      z-index: 40;
      background: var(--cb-suelo);
      border-bottom: 1px solid var(--color-cdm-regla);
    }
    .cb :global(.cdm-indice__titulo),
    .cb :global(.cdm-indice__lista),
    .cb :global(.cdm-indice__coord) { display: none; }
    .cb :global(.cdm-indice__progreso) { height: 3px; background: transparent; }
  }
  .cb-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--cb-coral);
    box-shadow: 0 0 0 0 rgba(242,107,58,0.55);
    animation: cb-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes cb-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(242,107,58,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(242,107,58,0); }
    100% { box-shadow: 0 0 0 0 rgba(242,107,58,0); }
  }
  .cb-spin { transform-origin: 50% 50%; animation: cb-spin 30s linear infinite; }
  @keyframes cb-spin { to { transform: rotate(360deg); } }

  /* HERO */
  .cb-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(22,168,176,0.12), transparent 50%),
      radial-gradient(circle at 12% 80%, rgba(242,107,58,0.10), transparent 50%),
      var(--cb-suelo);
    border-bottom: 3px solid var(--cb-ink);
    position: relative;
    overflow: hidden;
  }
  .cb-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(125deg, transparent 0 40px, rgba(14,100,112,0.04) 40px 41px);
    pointer-events: none;
  }
  .cb-hero > * { position: relative; }
  .cb-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .cb-hero__status { color: var(--cb-deep); font-weight: 700; }
  .cb-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .cb-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .cb-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .cb-hero__chapter { color: var(--cb-deep); }
  .cb-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .cb-hero__title em { color: var(--cb-deep); font-style: italic; }
  .cb-hero__title-stamp {
    display: inline-block;
    color: var(--cb-suelo);
    background: var(--cb-coral);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .cb-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--cb-tenue); max-width: 54ch; }
  .cb-hero__lead strong { color: var(--cb-tinta); font-weight: 700; }
  .cb-hero__lead em { color: var(--cb-aqua); font-style: italic; font-weight: 600; }
  .cb-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .cb-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--cb-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .cb-btn--primary { background: var(--cb-deep); color: var(--cb-suelo); box-shadow: 6px 6px 0 var(--cb-ink); }
  .cb-btn--primary:hover { background: var(--cb-coral); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--cb-ink); }
  .cb-btn--ghost { background: transparent; color: var(--cb-tinta); box-shadow: 6px 6px 0 var(--cb-aqua); }
  .cb-btn--ghost:hover { background: var(--cb-ink); color: var(--cb-aqua-l); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--cb-aqua); }

  /* KPIs */
  .cb-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--cb-ink);
    background: var(--cb-ink);
  }
  @media (min-width: 768px) { .cb-kpis { grid-template-columns: repeat(4, 1fr); } }
  .cb-kpi {
    background: var(--cb-paper); padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--cb-ink); border-bottom: 2px solid var(--cb-ink);
  }
  .cb-kpi:nth-child(2n) { border-right: none; }
  .cb-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .cb-kpi:nth-child(2n)      { border-right: 2px solid var(--cb-ink); }
    .cb-kpi:nth-child(4n)      { border-right: none; }
    .cb-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--cb-ink); }
    .cb-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .cb-kpi--aqua  { background: var(--cb-aqua); color: var(--cb-suelo); }
  .cb-kpi--oro   { background: var(--cb-oro); color: var(--cb-suelo); }
  .cb-kpi--coral { background: var(--cb-coral); color: var(--cb-suelo); }
  .cb-kpi--ink   { background: var(--cb-navy); color: var(--cb-tinta); }
  .cb-kpi--ink .cb-kpi__v { color: var(--cb-aqua-l); }
  .cb-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .cb-kpi__v small { font-size: .55em; opacity: .8; }
  .cb-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .cb-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(11,20,22,0.22));
  }
  .cb-postcard {
    background: var(--cb-paper);
    border: 3px solid var(--cb-ink);
    box-shadow: var(--cb-shadow);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .35s;
  }
  .cb-postcard:hover { transform: rotate(0); }
  .cb-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--cb-deep);
    color: var(--cb-suelo);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--cb-ink);
  }
  .cb-postcard__profile {
    width: 100%; aspect-ratio: 540 / 240;
    border-bottom: 2px solid var(--cb-ink);
    overflow: hidden;
  }
  .cb-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--cb-ink); }
  .cb-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.1); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .cb-postcard:hover .cb-postcard__img { transform: scale(1.05); }
  .cb-postcard__seal { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(-9deg); filter: drop-shadow(0 4px 10px rgba(14,100,112,0.5)); }
  .cb-postcard__tag {
    position: absolute; bottom: 12px; left: 12px;
    background: var(--cb-oro); color: var(--cb-suelo);
    padding: .4rem .75rem;
    font-size: .65rem; font-weight: 800; letter-spacing: .2em;
    border: 2px solid var(--cb-ink);
    box-shadow: 3px 3px 0 var(--cb-deep);
    transform: rotate(-2deg);
  }
  .cb-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--cb-paper-2);
    display: grid; gap: .35rem;
  }
  .cb-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(230,237,242,0.16);
    font-size: .68rem;
  }
  .cb-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .cb-postcard__data-row > span:first-child { color: var(--cb-deep); letter-spacing: .2em; font-weight: 800; }
  .cb-postcard__data-v { color: var(--cb-tinta); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .cb-marquee {
    background: var(--cb-deep); color: var(--cb-suelo);
    overflow: hidden; padding: .9rem 0;
    border-top: 3px solid var(--cb-ink);
  }
  .cb-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: cb-marquee 40s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem; font-weight: 800;
    letter-spacing: .15em; text-transform: uppercase;
  }
  @keyframes cb-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* PLAYA DE LOS MUERTOS SECTION */
  .cb-playa-section {
    background: var(--cb-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--cb-ink);
    position: relative;
    overflow: hidden;
  }
  .cb-playa-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(22,168,176,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .cb-playa-section > * { position: relative; }
  .cb-playa-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .cb-playa-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .cb-playa-chapter { color: var(--cb-aqua); }
  .cb-playa-title { font-size: clamp(2.5rem, 6vw, 4.25rem); line-height: .92; letter-spacing: -.04em; margin: 1rem 0; }
  .cb-playa-title em { color: var(--cb-deep); }
  .cb-playa-lead { font-size: 1.05rem; line-height: 1.55; color: var(--cb-tenue); margin-bottom: 1.75rem; max-width: 56ch; }
  .cb-playa-lead strong { color: var(--cb-tinta); font-weight: 700; }
  .cb-playa-lead em { color: var(--cb-coral); font-style: italic; }
  .cb-playa-facts { display: grid; grid-template-columns: 1fr; gap: 0; border: 2.5px solid var(--cb-ink); background: var(--cb-paper); box-shadow: 6px 6px 0 var(--cb-ink); margin-bottom: 1.5rem; }
  @media (min-width: 640px) { .cb-playa-facts { grid-template-columns: 1fr 1fr; } }
  .cb-playa-fact { padding: .85rem 1rem; border-bottom: 1px solid var(--cb-ink); display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 640px) {
    .cb-playa-fact:nth-child(odd) { border-right: 1px solid var(--cb-ink); }
    .cb-playa-fact:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .cb-playa-fact:last-child { border-bottom: none; } }
  .cb-playa-fact__k { font-size: .58rem; letter-spacing: .2em; color: var(--cb-coral); font-weight: 800; }
  .cb-playa-fact__v { font-size: .88rem; color: var(--cb-tinta); font-weight: 600; line-height: 1.35; }
  /* Sigue siendo un bloque de llamada oscuro: el mar aclarado ya es texto. */
  .cb-playa-note { padding: 1rem 1.25rem; background: var(--cb-deep-d); color: var(--cb-tinta); border: 2px solid var(--cb-ink); font-size: .92rem; line-height: 1.5; }
  .cb-playa-note strong { color: var(--cb-oro); }
  .cb-playa-r { max-width: 320px; margin: 0 auto; border: 3px solid var(--cb-ink); box-shadow: var(--cb-shadow); line-height: 0; background: #F6C98E; }

  /* ICONOS */
  .cb-iconos-section { background: var(--cb-suelo); padding: 5rem 1.5rem; border-bottom: 3px solid var(--cb-ink); }
  .cb-iconos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 1024px) { .cb-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .cb-icono {
    position: relative;
    background: var(--cb-paper);
    border: 3px solid var(--cb-ink);
    box-shadow: var(--cb-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .cb-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .cb-icono--aqua { color: var(--cb-aqua); }
  .cb-icono--oro  { color: var(--cb-oro); }
  .cb-icono--deep { color: var(--cb-deep); }
  .cb-icono__code {
    position: absolute; top: -16px; right: 20px;
    background: var(--cb-ink); color: var(--cb-aqua-l);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .cb-icono__svg { width: 100%; aspect-ratio: 1; max-width: 200px; margin: 0 auto; color: currentColor; }
  /* Dentro de la lámina clara el acento recupera su tono original. */
  .cb-icono--aqua .cb-icono__postal { color: #16A8B0; }
  .cb-icono--oro  .cb-icono__postal { color: #E5A92B; }
  .cb-icono--deep .cb-icono__postal { color: #0E6470; }
  .cb-icono__name { font-size: clamp(1.5rem, 2.8vw, 1.85rem); line-height: 1; letter-spacing: -.025em; color: var(--cb-tinta); margin: .5rem 0 0; text-align: center; }
  .cb-icono__sub { font-size: .62rem; letter-spacing: .25em; color: currentColor; font-weight: 800; text-align: center; }
  .cb-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--cb-tenue); flex: 1; text-align: center; }
  .cb-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .cb-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* LONJA */
  .cb-lonja-section { background: var(--cb-navy); color: var(--cb-tinta); padding: 5rem 1.5rem; border-bottom: 3px solid var(--cb-ink); position: relative; overflow: hidden; }
  .cb-lonja-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(47,203,207,0.07) 1.3px, transparent 1.3px); background-size: 26px 26px; pointer-events: none; }
  .cb-lonja-section > * { position: relative; }
  .cb-lonja-head { max-width: 760px; margin-bottom: 2.5rem; }
  .cb-lonja-chapter { color: var(--cb-oro); }
  .cb-lonja-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; color: var(--cb-tinta); }
  .cb-lonja-title em { color: var(--cb-aqua-l); }
  .cb-lonja-lead { font-size: 1.1rem; line-height: 1.55; color: rgba(237,232,218,0.8); max-width: 60ch; }
  .cb-lonja-lead strong { color: var(--cb-tinta); font-weight: 700; }
  .cb-lonja-lead em { color: var(--cb-oro); font-style: italic; }

  .cb-lonja-flow { list-style: none; padding: 0; margin: 0 0 2.5rem; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 880px) { .cb-lonja-flow { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .cb-flow { position: relative; background: rgba(237,232,218,0.05); border: 2.5px solid rgba(230,237,242,0.28); padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem; transition: transform .25s, background .25s; }
  .cb-flow:hover { transform: translateY(-4px); background: rgba(22,168,176,0.12); }
  .cb-flow__time { display: inline-block; align-self: flex-start; background: currentColor; padding: .3rem .7rem; font-size: .9rem; font-weight: 800; letter-spacing: .1em; border: 2px solid var(--cb-ink); }
  .cb-flow--navy  { color: var(--cb-aqua-l); }
  .cb-flow--deep  { color: var(--cb-oro); }
  .cb-flow--coral { color: var(--cb-coral); }
  .cb-flow__time { color: var(--cb-suelo); }
  .cb-flow--navy .cb-flow__time  { background: var(--cb-aqua-l); }
  .cb-flow--deep .cb-flow__time  { background: var(--cb-oro); }
  .cb-flow--coral .cb-flow__time { background: var(--cb-coral); color: var(--cb-suelo); }
  .cb-flow__icon { width: 64px; height: 64px; color: currentColor; }
  /* Dentro de la lámina clara el acento recupera su tono original. */
  .cb-flow--navy  .cb-flow__postal { color: #0E6470; }
  .cb-flow--deep  .cb-flow__postal { color: #16A8B0; }
  .cb-flow--coral .cb-flow__postal { color: #F26B3A; }
  .cb-flow__t { font-size: clamp(1.2rem, 2.2vw, 1.5rem); line-height: 1.05; letter-spacing: -.02em; color: var(--cb-tinta); margin: 0; }
  .cb-flow__d { font-size: .9rem; line-height: 1.5; color: rgba(237,232,218,0.75); margin: 0; }
  .cb-flow__arrow { position: absolute; top: 50%; right: -1.75rem; transform: translateY(-50%); font-family: var(--font-mono); font-size: 1.6rem; color: var(--cb-oro); font-weight: 800; display: none; }
  @media (min-width: 880px) { .cb-flow__arrow { display: block; } }

  .cb-lonja-cta { display: grid; grid-template-columns: 1fr; gap: 1.25rem; align-items: center; padding: 1.75rem; background: var(--cb-deep-d); border: 2.5px solid rgba(230,237,242,0.28); box-shadow: 7px 7px 0 var(--cb-aqua); }
  @media (min-width: 768px) { .cb-lonja-cta { grid-template-columns: 1fr auto; } }
  .cb-lonja-cta p { font-size: .95rem; line-height: 1.55; color: var(--cb-tinta); margin: 0; max-width: 60ch; }
  .cb-lonja-cta strong { color: var(--cb-oro); }
  .cb-lonja-cta__btn { white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; padding: 1rem 1.5rem; background: var(--cb-oro); color: var(--cb-suelo); font-family: var(--font-display); font-weight: 800; border: 2.5px solid var(--cb-ink); box-shadow: 4px 4px 0 var(--cb-ink); text-decoration: none; transition: transform .2s, box-shadow .2s, background .2s, color .2s; }
  .cb-lonja-cta__btn:hover { background: var(--cb-coral); color: var(--cb-suelo); transform: translate(-2px,-2px); box-shadow: 7px 7px 0 var(--cb-ink); }

  /* HITOS */
  .cb-hitos-section {
    background: var(--cb-deep-d); color: var(--cb-tinta);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--cb-ink);
    position: relative; overflow: hidden;
  }
  .cb-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(22,168,176,0.08) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .cb-hitos-section > * { position: relative; }
  .cb-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2.5px solid rgba(230,237,242,0.25);
  }
  @media (min-width: 640px)  { .cb-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cb-hitos { grid-template-columns: repeat(3, 1fr); } }
  .cb-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(237,232,218,0.22);
    border-right: 1px solid rgba(237,232,218,0.22);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(237,232,218,0.03);
    transition: background .25s;
  }
  .cb-hito:hover { background: rgba(14,100,112,0.22); }
  @media (min-width: 1024px) {
    .cb-hito:nth-child(3n) { border-right: none; }
    .cb-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .cb-hito:nth-child(2n) { border-right: none; }
    .cb-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .cb-hito { border-right: none; } .cb-hito:last-child { border-bottom: none; } }
  .cb-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--cb-aqua-l); font-weight: 800; }
  .cb-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--cb-tinta); line-height: 1.35; }

  /* SECTORES */
  .cb-sec-section { background: var(--cb-suelo); padding: 5rem 1.5rem; border-bottom: 3px solid var(--cb-ink); }
  .cb-sec { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px)  { .cb-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cb-sec { grid-template-columns: repeat(3, 1fr); } }
  .cb-sec__card {
    background: var(--cb-paper);
    border: 2.5px solid var(--cb-ink);
    box-shadow: var(--cb-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
  }
  .cb-sec__card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: currentColor; }
  .cb-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .cb-sec__card--aqua  { color: var(--cb-aqua); }
  .cb-sec__card--coral { color: var(--cb-coral); }
  .cb-sec__card--deep  { color: var(--cb-deep); }
  .cb-sec__card--oro   { color: var(--cb-oro); }
  .cb-sec__card--navy  { color: var(--cb-aqua); }
  .cb-sec__card--slate { color: var(--cb-slate); }
  .cb-sec__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; gap: .5rem; }
  .cb-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .cb-sec__stat-box {
    background: var(--cb-suelo); color: var(--cb-tinta);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .cb-sec__stat-v { font-size: .9rem; font-weight: 800; color: currentColor; line-height: 1; }
  .cb-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .cb-sec__title { font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.1; letter-spacing: -.02em; color: var(--cb-tinta); margin: 0; }
  .cb-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--cb-tenue); flex: 1; }
  .cb-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .cb-sec__tag { display: flex; align-items: flex-start; gap: .35rem; font-size: .78rem; line-height: 1.35; color: var(--cb-tinta); }
  .cb-sec__tag span { color: currentColor; font-weight: 800; }
  .cb-sec__foot { padding-top: .65rem; border-top: 2px solid var(--cb-ink); }
  .cb-sec__cta { font-family: var(--font-mono); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .15em; color: currentColor; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px; }

  /* MAPA */
  .cb-map-section { background: var(--cb-arena); border-bottom: 3px solid var(--cb-ink); }
  .cb-map-head { padding: 4rem 0 2rem; }
  .cb-map-head__inner { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; }
  @media (min-width: 768px) { .cb-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
