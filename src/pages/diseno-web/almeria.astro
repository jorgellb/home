                    <rect x="290" y="116" width="4" height="4" fill="#C25E2B"/>
                    <rect x="298" y="116" width="4" height="4" fill="#C25E2B"/>
                    <rect x="306" y="116" width="4" height="4" fill="#C25E2B"/>

                    {/* Continuación muralla der */}
