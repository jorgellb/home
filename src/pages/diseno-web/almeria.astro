                  {/* Sol grande detrás de la Alcazaba */}
                  <circle cx="380" cy="80" r="44" fill="#E5A726" opacity="0.9"/>
                  <circle cx="380" cy="80" r="32" fill="#FFCC44"/>

                  {/* Estrellas en el indigo superior */}
                  <circle cx="40"  cy="20" r="1.5" fill="#FFFBF0"/>
                  <circle cx="80"  cy="40" r="1"   fill="#FFFBF0"/>
                  <circle cx="140" cy="15" r="1.5" fill="#FFFBF0"/>
                  <circle cx="500" cy="20" r="1"   fill="#FFFBF0"/>

                  {/* Cerro y montañas detrás */}
