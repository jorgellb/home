                    <path d="M 360 172 L 360 150 L 372 150 L 372 156 L 384 156 L 384 150 L 396 150 L 396 156 L 408 156 L 408 150 L 420 150 L 420 178" fill="url(#al-stone)"/>

                    {/* Continuación muralla izq */}
                    <path d="M 100 175 L 100 168 L 88 168 L 88 174 L 76 174 L 76 168 L 64 168 L 64 174 L 50 174 L 50 168 L 38 168 L 38 174 L 26 174 L 26 168 L 14 168 L 14 174 L 0 174 L 0 195" fill="#C25E2B" stroke="#0E0D0B" stroke-width="2.5"/>
