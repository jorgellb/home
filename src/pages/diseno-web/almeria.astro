---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import { getPueblosByComarca } from '../../data/pueblos-almeria';

const pueblosMetro = getPueblosByComarca('Almería Metropolitana').filter(p => p.slug !== 'almeria');

const title = 'Diseño Web en Almería | Agencia de Páginas Web y SEO Local';
const description = 'Agencia de diseño web en Almería capital. Creamos páginas web profesionales con hosting gratuito, tiendas online y SEO local para posicionar tu negocio en Google. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/diseno-web/almeria/';

const sectores = [
  { nombre: 'Hostelería y restauración', stat: 'QR + reservas', desc: 'Webs con carta digital, sistema de reservas online y optimización para búsquedas tipo "restaurante en Almería". Tu mejor camarero 24h.', tags: ['Carta digital QR','Reservas online','SEO "restaurante Almería"','Fotos pro de platos'] },
  { nombre: 'Inmobiliarias',              stat: 'Portal MLS', desc: 'Portales inmobiliarios con buscador de propiedades, fichas detalladas con galería y captación de leads cualificados en un mercado en auge.', tags: ['Portal propiedades','Buscador avanzado','Captación leads','Integración MLS'] },
  { nombre: 'Salud y bienestar',          stat: 'Citas online', desc: 'Páginas web para clínicas dentales, centros médicos, fisioterapeutas y centros de estética en Almería. Con sistema de citas online y cumplimiento RGPD sanitario.', tags: ['Citas online','Ficha médica digital','RGPD sanitario','SEO local salud'] },
  { nombre: 'Comercio y retail',          stat: 'E-com Astro', desc: 'Tiendas online para comercios almerienses que quieren vender a toda España. Desde productos locales hasta moda, con pasarela segura y envíos automatizados.', tags: ['E-commerce','Pasarela de pago','Gestión de stock','Envíos automáticos'] },
  { nombre: 'Servicios profesionales',    stat: 'B2B / corporate', desc: 'Webs corporativas para abogados, gestorías, arquitectos e ingenieros de Almería. Diseño que transmite confianza con formularios cualificados.', tags: ['Web corporativa','Portfolio','Formularios inteligentes','Blog de autoridad'] },
  { nombre: 'Turismo y ocio',             stat: 'Multiidioma', desc: 'Almería es destino de cine, playa y naturaleza. Webs para hoteles, casas rurales, empresas de actividades y guías turísticos con motor de reservas y multiidioma.', tags: ['Motor reservas','Multiidioma','Galería inmersiva','Booking integrado'] },
];

const diferenciales = [
  { title: 'Capital de provincia',        desc: 'Almería capital concentra servicios, comercio, salud, educación y administración. El mercado más diverso de la provincia — y el que más recompensa una web bien hecha.' },
  { title: 'Volumen de búsquedas',        desc: 'Más de 200k habitantes y miles de búsquedas locales diarias en Google. SEO en Almería capital genera tráfico cualificado todos los días del año.' },
  { title: 'Universidad y profesionales', desc: 'La UAL genera ecosistema de servicios profesionales, consultorías y proyectos de I+D. Webs corporativas que conecten con perfil cualificado.' },
  { title: 'Puerto y conexiones',         desc: 'Almería capital es nodo logístico y turístico. Conexión con Norte de África, costa, aeropuerto. Audiencia internacional ya está aquí.' },
];

const proceso = [
  { num: '01', title: 'Auditoría y estrategia',      eta: '1–2 días', body: 'Analizamos tu negocio, competencia y mercado en Almería. Definimos objetivos, keywords y arquitectura web ideal para tu sector.', deliverable: 'Briefing + roadmap' },
  { num: '02', title: 'Diseño y prototipo',          eta: '3–5 días', body: 'Diseño visual de tu web: estructura, colores, tipografías y experiencia de usuario. Tú apruebas antes de pasar a desarrollo.', deliverable: 'Prototipo Figma navegable' },
  { num: '03', title: 'Desarrollo + SEO técnico',    eta: '5–10 días', body: 'Programamos con Astro y Tailwind: velocidad óptima, datos estructurados y SEO técnico desde el código.', deliverable: 'Web en staging + auditoría' },
  { num: '04', title: 'Lanzamiento y formación',     eta: '1–2 días', body: 'Publicamos con hosting gratuito, indexamos en Google y te formamos para que gestiones tu contenido con autonomía.', deliverable: 'Sitio en producción + manual' },
];

const testimonios = [
  { nombre: 'María Bautista',  negocio: 'Clínica dental · Almería capital', texto: 'Nos modernizaron toda la imagen digital. El tráfico local desde Google se ha disparado y los pacientes que llegan ya vienen convencidos.' },
  { nombre: 'Carlos D.',       negocio: 'Despacho de arquitectura · Almería', texto: 'La web nueva nos posiciona como referente del sector. Los proyectos entran más cualificados, presupuestos más altos y menos curiosos.' },
  { nombre: 'Sofía R.',        negocio: 'Boutique · Almería centro',        texto: 'Pasamos de Instagram a tienda online y la facturación digital ya supera el 40% del total. Gestión muy sencilla y soporte impecable.' },
  { nombre: 'Manuel G.',       negocio: 'Restaurante · Paseo Marítimo',     texto: 'La carta digital QR y las reservas online han cambiado el restaurante. Menos llamadas, más eficiencia y mucha mejor experiencia de cliente.' },
];

const faqs = [
  { q: '¿Cuánto cuesta una página web profesional en Almería?', a: 'Web corporativa profesional desde 450€ con diseño personalizado, SEO técnico, hosting gratuito y formación. Tiendas online con pasarela: 900€–2.500€ según funcionalidades. Presupuesto cerrado sin sorpresas.' },
  { q: '¿Por qué el hosting es gratuito en vuestras webs?', a: 'Usamos generación estática (Astro) que produce webs ultrarrápidas servidas desde CDN global sin servidor ni base de datos. Netlify o Cloudflare Pages ofrecen hosting gratuito ilimitado. Ahorras 60–200€/año en hosting para siempre.' },
  { q: '¿En cuánto tiempo tendré mi web lista?', a: 'Web corporativa estándar: 1–2 semanas. Proyectos complejos (tiendas online, reservas): 3–4 semanas. Metodología ágil: ves avances desde la primera semana.' },
  { q: '¿Mi web aparecerá en Google si os contrato?', a: 'Todas las webs se entregan optimizadas para SEO desde el código: velocidad óptima, datos estructurados (Schema.org), meta etiquetas, sitemap XML. Para posicionamiento en búsquedas competitivas (dentista Almería, restaurante Almería) ofrecemos planes de SEO mensual.' },
  { q: '¿Qué ventaja tiene una web estática frente a WordPress?', a: 'Carga <1s (vs 3–8s en WP), sin base de datos hackeable, sin actualizaciones de plugins, hosting gratuito y mejor rendimiento en Google. Para webs corporativas, portfolios y landings es la mejor opción técnica y económica.' },
  { q: '¿Puedo gestionar mi web yo mismo después?', a: 'Sí. Formación y documentación incluidas. Para webs con blog o catálogo integramos un CMS headless intuitivo. Soporte técnico disponible si necesitas ayuda.' },
  { q: '¿Hacéis reuniones presenciales en Almería?', a: 'Sí. Nos reunimos en persona en Almería capital y en toda la provincia. También videollamada. Primera consulta gratuita y sin compromiso.' },
  { q: '¿Trabajáis con negocios de toda la provincia de Almería?', a: 'Sí. Esta página se centra en la capital, pero damos servicio a Roquetas, Níjar, El Ejido, Mojácar, Vera, Huércal-Overa y más de 100 localidades. Cada pueblo tiene su propia página.' },
];

const jsonLd = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Diseño Web","item":"https://platanitorico.com/diseno-web/"},{"@type":"ListItem","position":3,"name":"Almería","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico - Diseño Web Almería","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","priceRange":"€€","address":{"@type":"PostalAddress","streetAddress":"Ctra de Ronda, 82","addressLocality":"Vera","addressRegion":"Almería","postalCode":"04620","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":36.8340,"longitude":-2.4637},"areaServed":[{"@type":"City","name":"Almería"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","reviewCount":"54","bestRating":"5"},"review":testimonios.map(t=>({"@type":"Review","author":{"@type":"Person","name":t.nombre},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":t.texto})) },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo creamos tu web en Almería","step":proceso.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/diseno-web-almeria.jpg"
  imageAlt="Diseño web en Almería capital - Platanito Rico"
  type="service"
  keywords="diseño web almería, agencia web almería, páginas web almería capital, seo almería, tienda online almería"
  jsonLd={jsonLd}
>
  <Header />

  <main id="main-content">
    {/* HERO */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 200 — Capital de la provincia</span>
          <span class="text-meta"><span class="live-dot"></span> 200k habitantes · puerto + UAL</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Diseño Web · Almería capital</span>
            <h1 class="svc-hero__title">
              Diseño web en
              <em>Almería capital,</em>
              <span class="text-stroke-ink">SEO</span>
              que aparece.
            </h1>
            <p class="svc-hero__lead">
              Capital de provincia, <strong>200k habitantes</strong>, ecosistema universitario,
              puerto y turismo. La audiencia más diversa de Almería — y la que mejor responde
              a una web bien hecha.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">Presupuesto en 24h →</a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">200k</span>
              <span class="svc-hero__spec-lbl">Habitantes</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">450€</span>
              <span class="svc-hero__spec-lbl">Desde · web pro</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">0€</span>
              <span class="svc-hero__spec-lbl">Hosting web estática</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">99/100</span>
              <span class="svc-hero__spec-lbl">Lighthouse target</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ ALMERÍA CAPITAL ★ UAL ★ PUERTO ★ COMERCIO ★ HOSTELERÍA ★ SERVICIOS ★ SALUD ★</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section-brutal" style="padding:0;background:var(--brutal-bg-alt);border-bottom:2px solid var(--brutal-ink);">
      <div class="pueblo-map-wrap">
        <InteractiveMap center={[-2.4637, 36.8340]} zoom={13} pitch={25} bearing={-15} label="Almería" />
      </div>
    </section>

    {/* SECTORES */}
    <section class="section-brutal" id="sectores">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 01 / Sectores Almería capital</span>
            <h2 class="brutal-section-head__title">
              Para quién
              <em>diseñamos</em>
              en Almería.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Seis sectores que dominan el ecosistema de la capital. Cada uno con
            su estrategia SEO específica y su sistema técnico.
          </p>
        </header>

        <ol class="svc-bento">
          {sectores.map((s, i) => {
            const accents = ['accent', 'paper', 'lime', 'paper', 'ink', 'paper'];
            return (
              <li class={`svc-card svc-card--${accents[i]}`}>
                <header class="svc-card__head">
                  <span class="svc-card__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-card__kicker">{s.stat}</span>
                </header>
                <h3 class="svc-card__title">{s.nombre}</h3>
                <p class="svc-card__desc">{s.desc}</p>
                <ul class="svc-card__features">
                  {s.tags.map((t) => (
                    <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{t}</span></li>
                  ))}
                </ul>
                <footer class="svc-card__foot">
                  <div class="svc-card__figure">
                    <span class="svc-card__figure-val">★</span>
                    <span class="svc-card__figure-lbl">Almería capital</span>
                  </div>
                  <a href="/contacto" class="svc-card__cta">Pedir →</a>
                </footer>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    {/* DIFERENCIALES */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Por qué Almería capital</span>
            <h2 class="brutal-section-head__title">
              Capital de
              <em>oportunidades.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Almería capital es el mercado más diverso, conectado y exigente
            de la provincia. Una web mediocre se ahoga; una web buena destaca.
          </p>
        </header>

        <ul class="svc-sectors">
          {diferenciales.map((d, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">★ {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{d.title}</h3>
              <p class="svc-sector__desc">{d.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Método</span>
            <h2 class="brutal-section-head__title">
              De cero a producción
              <em>en 2 semanas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases con entregables claros. Auditoría, diseño, desarrollo
            con SEO técnico y lanzamiento con formación incluida.
          </p>
        </header>

        <ol class="svc-process">
          {proceso.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < proceso.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* TESTIMONIOS */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Clientes en Almería capital</span>
            <h2 class="brutal-section-head__title">
              Negocios de la capital
              <em>que ya venden más.</em>
            </h2>
          </div>
        </header>

        <figure class="svc-pull">
          <div class="svc-pull__marks" aria-hidden="true">“</div>
          <blockquote class="svc-pull__quote">{testimonios[0].texto}</blockquote>
          <figcaption class="svc-pull__cap">
            <span class="svc-pull__avatar">{testimonios[0].nombre[0]}</span>
            <div>
              <span class="svc-pull__name">{testimonios[0].nombre}</span>
              <span class="svc-pull__role">{testimonios[0].negocio}</span>
            </div>
          </figcaption>
        </figure>

        <ul class="svc-quotes">
          {testimonios.slice(1).map((t, i) => (
            <li class={`svc-quote svc-quote--${i}`}>
              <p>"{t.texto}"</p>
              <footer>
                <span class="svc-quote__avatar">{t.nombre[0]}</span>
                <div>
                  <span class="svc-quote__name">{t.nombre}</span>
                  <span class="svc-quote__role">{t.negocio}</span>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* FAQ */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Preguntas Almería</span>
            <h2 class="brutal-section-head__title">
              Lo que más
              <em>preguntan</em>
              en la capital.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Plazos, hosting, SEO, plataformas. Si no está aquí, escríbenos y
            respondemos en menos de 24h.
          </p>
        </header>

        <ol class="svc-faq">
          {faqs.map((f, i) => (
            <li class="svc-faq__item">
              <details class="svc-faq__details" open={i === 0}>
                <summary class="svc-faq__sum">
                  <span class="svc-faq__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-faq__q">{f.q}</span>
                  <span class="svc-faq__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-faq__answer"><p>{f.a}</p></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* OTROS PUEBLOS METRO */}
    {pueblosMetro.length > 0 && (
      <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 06 / Almería metropolitana</span>
              <h2 class="brutal-section-head__title">
                También en el
                <em>área metropolitana.</em>
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Localidades del entorno metropolitano de la capital donde ya
              trabajamos. Si tu pueblo no está, escríbenos.
            </p>
          </header>

          <ul class="cobertura-grid" style="margin-top:2rem;">
            {pueblosMetro.slice(0, 8).map((p, i) => (
              <li>
                <a href={`/diseno-web/${p.slug}/`} class={`cobertura-tile cobertura-tile--${i % 6}`}>
                  <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
                  <span class="cobertura-tile__name heading-display">{p.nombre}</span>
                  <span class="cobertura-tile__sub text-mono">{p.comarca}</span>
                  <span class="cobertura-tile__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="svc-final__title">
            ¿Empezamos tu web
            <em>en Almería capital?</em>
          </h2>
          <p class="svc-final__text">
            Cuéntanos qué necesitas — restaurante, clínica, despacho, comercio,
            inmobiliaria — y te enviamos presupuesto detallado en 24h. Reuniones
            presenciales disponibles en Almería capital.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .pueblo-map-wrap { width: 100%; height: clamp(360px, 50vh, 520px); overflow: hidden; }
  .pueblo-map-wrap > * { width: 100%; height: 100%; }
</style>
