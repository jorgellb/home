                    <rect x="445" y="155" width="65" height="45" fill="#EAD9B5"/>
                    <path d="M 445 155 L 477 138 L 510 155 Z" fill="#C25E2B"/>
                    {/* Torres catedral */}
                    <rect x="450" y="140" width="14" height="60" fill="#EAD9B5"/>
                    <rect x="492" y="140" width="14" height="60" fill="#EAD9B5"/>
                    {/* Cúpulas */}
                    <path d="M 450 140 Q 457 128 464 140 Z" fill="#C25E2B"/>
                    <path d="M 492 140 Q 499 128 506 140 Z" fill="#C25E2B"/>
                    {/* Cruces */}
                    <line x1="457" y1="128" x2="457" y2="118" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="454" y1="122" x2="460" y2="122" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="499" y1="128" x2="499" y2="118" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="496" y1="122" x2="502" y2="122" stroke="#0E0D0B" stroke-width="1.5"/>
                    {/* Puerta y rosetón */}
                    <path d="M 470 175 L 470 200 L 485 200 L 485 175 Q 485 168 477 168 Q 470 168 470 175 Z" fill="#0E0D0B"/>
