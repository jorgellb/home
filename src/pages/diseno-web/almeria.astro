<style>
  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · ALMERÍA · CONSOLA (fase 2)                     */
  /* El índigo era a la vez fondo de tres secciones y color  */
  /* de acento: se queda como fondo y el acento pasa a       */
  /* indigo-l. Alcazaba, cine y oro-d se aclaran para llegar */
  /* a 4,5:1 sobre suelo. Las ilustraciones no se tocan.     */
  /* ═══════════════════════════════════════════════════════ */
  .al {
    --al-paper:      var(--color-cdm-panel);
    --al-paper-2:    var(--color-cdm-panel-2);
    --al-piedra:     var(--color-cdm-panel-2);
    --al-arena:      var(--color-cdm-panel-2);
    --al-suelo:      var(--color-cdm-suelo);
    --al-tinta:      var(--color-cdm-texto);
    --al-tenue:      var(--color-cdm-tenue);
    --al-ink:        var(--color-cdm-regla-2);
    --al-alcazaba:   #D97A45;       /* muralla terracota, aclarada */
    --al-alcazaba-d: #8E3F1A;
    --al-oro:        #E5A726;       /* oro almeriense */
    --al-oro-d:      #D2A33C;
    --al-indigo:     #16203C;       /* mar/cielo profundo: solo fondo */
    --al-indigo-l:   #6C8BD0;       /* el mismo, para leer sobre oscuro */
    --al-cine:       #E14356;       /* rojo cine, aclarado */
    --al-gata:       #2FBDBD;       /* turquesa Cabo Gata */
    --al-sun:        #FFCC44;
    --al-lima:       #D6FF44;       /* solo «ok/verificado» */
    --al-shadow:     8px 8px 0 var(--color-cdm-regla-2);

    background: var(--al-suelo);
    color: var(--al-tinta);
  }

  /* Globales heredados, que venían en tinta oscura sobre papel. */
  .al :global(.brutal-section-head__title) { color: var(--al-tinta); }
  .al :global(.brutal-section-head__title em) { color: var(--al-oro); }
  .al :global(.brutal-section-head__lead) { color: var(--al-tenue); }
  .al :global(.text-meta) { color: var(--al-tenue); }
  .al :global(.divider-brutal) { background: var(--color-cdm-regla); }

  /* Raíl del índice: banda izquierda a partir de 1280 px, fuera de la caja
     de contenido; por debajo, solo la barra de progreso. */
  @media (min-width: 1280px) {
    .al :global(.cdm-indice) {
      position: fixed;
      top: 96px;
      left: 0;
      width: 208px;
      padding-inline: clamp(1rem, 2vw, 1.75rem) 1rem;
      z-index: 30;
    }
    .al :global(.container-brutal) { padding-left: calc(var(--container-gutter) + 208px); }
    .al-map-frame,
    .al-marquee,
    .al-final__marquee { padding-left: 208px; }
  }
  @media (max-width: 1279px) {
    .al :global(.cdm-indice) {
      display: block;
      position: sticky;
      top: 64px;
      z-index: 40;
      background: var(--al-suelo);
      border-bottom: 1px solid var(--color-cdm-regla);
    }
    .al :global(.cdm-indice__titulo),
    .al :global(.cdm-indice__lista),
    .al :global(.cdm-indice__coord) { display: none; }
    .al :global(.cdm-indice__progreso) { height: 3px; background: transparent; }
  }

  /* Los tres iconos van en postal: sus trazos negros y sus paredes claras
     se perderían sobre el panel oscuro (spec §6.3.4). */
  .al-icono__postal { max-width: 220px; margin: 0 auto; }
  .al-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--al-oro);
    box-shadow: 0 0 0 0 rgba(229,167,38,0.55);
    animation: al-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes al-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(229,167,38,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(229,167,38,0); }
    100% { box-shadow: 0 0 0 0 rgba(229,167,38,0); }
  }
  .al-spin { transform-origin: 50% 50%; animation: al-spin 28s linear infinite; }
  @keyframes al-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .al-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(229,167,38,0.16), transparent 55%),
      radial-gradient(circle at 10% 80%, rgba(217,122,69,0.14), transparent 55%),
      var(--al-suelo);
    border-bottom: 1px solid var(--color-cdm-regla);
    position: relative;
    overflow: hidden;
  }
  .al-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(60deg, transparent 0 40px, rgba(194,94,43,0.04) 40px 41px);
    pointer-events: none;
  }
  .al-hero > * { position: relative; }
  .al-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .al-hero__status { color: var(--al-alcazaba); font-weight: 700; }

  .al-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 1024px) { .al-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .al-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .al-hero__chapter { color: var(--al-alcazaba); }
  .al-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .al-hero__title em { color: var(--al-alcazaba); font-style: italic; }
  .al-hero__title-stamp {
    display: inline-block;
    color: var(--al-suelo);
    background: var(--al-cine);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }

  .al-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--al-tenue);
    max-width: 54ch;
  }
  .al-hero__lead strong { color: var(--al-tinta); font-weight: 700; }
  .al-hero__lead em { color: var(--al-cine); font-style: italic; font-weight: 600; }

  .al-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }
  .al-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--color-cdm-regla-2);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .al-btn--primary {
    background: var(--al-alcazaba);
    color: #1a0802;
    box-shadow: 6px 6px 0 var(--color-cdm-regla-2);
  }
  .al-btn--primary:hover {
    background: var(--al-cine);
    color: #1a0208;
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--color-cdm-regla-2);
  }
  .al-btn--ghost {
    background: transparent;
    color: var(--al-tinta);
    box-shadow: 6px 6px 0 var(--al-oro);
  }
  .al-btn--ghost:hover {
    background: var(--color-cdm-panel-2);
    color: var(--al-sun);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--al-oro);
  }

  /* KPIs */
  .al-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 1px solid var(--color-cdm-regla-2);
    background: var(--color-cdm-regla);
  }
  @media (min-width: 768px) { .al-kpis { grid-template-columns: repeat(4, 1fr); } }
  .al-kpi {
    background: var(--al-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 1px solid var(--color-cdm-regla);
    border-bottom: 1px solid var(--color-cdm-regla);
  }
  .al-kpi:nth-child(2n) { border-right: none; }
  .al-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .al-kpi:nth-child(2n)      { border-right: 1px solid var(--color-cdm-regla); }
    .al-kpi:nth-child(4n)      { border-right: none; }
    .al-kpi:nth-last-child(-n+2) { border-bottom: 1px solid var(--color-cdm-regla); }
    .al-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .al-kpi--alcazaba { background: var(--al-alcazaba); color: var(--al-suelo); }
  .al-kpi--oro      { background: var(--al-oro); color: var(--al-suelo); }
  .al-kpi--gata     { background: var(--al-gata); color: var(--al-suelo); }
  .al-kpi--ink      { background: var(--color-cdm-panel-2); color: var(--al-tinta); }
  .al-kpi--ink .al-kpi__v { color: var(--al-sun); }
  .al-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .al-kpi__v small { font-size: .55em; opacity: .8; }
  .al-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .al-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(14,13,11,0.18));
  }
  /* La postal conserva su papel original (spec §3.3.6): es pieza a mano,
     no interfaz. Por eso lleva valores literales. */
  .al-postcard {
    background: #FFFBF0;
    border: 3px solid #0E0D0B;
    box-shadow: 8px 8px 0 var(--color-cdm-regla-2);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .35s;
  }
  .al-postcard:hover { transform: rotate(0); }
  .al-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: #1A2647;
    color: #FFCC44;
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid #0E0D0B;
  }
  .al-postcard__profile {
    width: 100%;
    aspect-ratio: 540 / 240;
    border-bottom: 2px solid #0E0D0B;
    overflow: hidden;
  }
  .al-postcard__img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid #0E0D0B;
  }
  .al-postcard__img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(1.1);
    transition: transform .6s cubic-bezier(.16,1,.3,1);
  }
  .al-postcard:hover .al-postcard__img { transform: scale(1.05); }
  .al-postcard__seal {
    position: absolute;
    top: 12px; right: 12px;
    width: 80px; height: 80px;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 10px rgba(26,38,71,0.5));
  }
  .al-postcard__tag {
    position: absolute;
    bottom: 12px; left: 12px;
    background: #B91C2C;
    color: #FFFBF0;
    padding: .4rem .75rem;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 2px solid #0E0D0B;
    box-shadow: 3px 3px 0 #0E0D0B;
    transform: rotate(-2deg);
  }
  .al-postcard__data {
    padding: 1rem 1.25rem;
    background: #F2E8CC;
    display: grid; gap: .35rem;
  }
  .al-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
    font-size: .68rem;
  }
  .al-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .al-postcard__data-row > span:first-child { color: #C25E2B; letter-spacing: .2em; font-weight: 800; }
  .al-postcard__data-v { color: #0E0D0B; font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .al-marquee {
    background: var(--al-indigo);
    color: var(--al-sun);
    overflow: hidden;
    padding: .9rem 0;
    border-top: 1px solid var(--color-cdm-regla);
  }
  .al-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: al-marquee 36s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  @keyframes al-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* ICONOS                                                  */
  /* ═══════════════════════════════════════════════════════ */
  .al-iconos-section {
    background: var(--al-suelo);
    padding: 5rem 1.5rem;
    border-bottom: 1px solid var(--color-cdm-regla);
  }
  .al-iconos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) { .al-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .al-icono {
    position: relative;
    background: var(--al-paper);
    border: 1px solid var(--color-cdm-regla-2);
    box-shadow: var(--al-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .al-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .al-icono--alcazaba { color: var(--al-alcazaba); }
  .al-icono--oro      { color: var(--al-oro); }
  .al-icono--gata     { color: var(--al-gata); }
  .al-icono__code {
    position: absolute;
    top: -16px; right: 20px;
    background: var(--color-cdm-panel-2);
    color: var(--al-sun);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .al-icono__svg { width: 100%; aspect-ratio: 1; margin: 0 auto; color: currentColor; }
  .al-icono__name { font-size: clamp(1.5rem, 2.8vw, 1.85rem); line-height: 1; letter-spacing: -.025em; color: var(--al-tinta); margin: .5rem 0 0; text-align: center; }
  .al-icono__sub { font-size: .62rem; letter-spacing: .25em; color: currentColor; font-weight: 800; text-align: center; }
  .al-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--al-tenue); flex: 1; text-align: center; }
  .al-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .al-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* ═══════════════════════════════════════════════════════ */
  /* ALMERIWOOD                                              */
  /* ═══════════════════════════════════════════════════════ */
  .al-aw-section {
    background: var(--color-cdm-panel-2);
    color: var(--al-tinta);
    padding: 5rem 1.5rem;
    border-bottom: 1px solid var(--color-cdm-regla);
    position: relative;
    overflow: hidden;
  }
  .al-aw-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(229,167,38,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .al-aw-section > * { position: relative; }
  .al-aw-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .al-aw-head { grid-template-columns: 1.4fr 1fr; gap: 3rem; } }
  .al-aw-chapter { color: var(--al-cine); }
  .al-aw-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .9;
    letter-spacing: -.045em;
    color: var(--al-tinta);
    margin: 1rem 0;
  }
  .al-aw-title em { color: var(--al-cine); display: block; }
  .al-aw-lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255,251,240,0.75);
    max-width: 56ch;
  }
  .al-aw-lead strong { color: var(--al-sun); }
  .al-aw-lead em { color: var(--al-cine); font-style: italic; }

  .al-claqueta {
    max-width: 260px;
    margin: 0 auto;
    filter: drop-shadow(0 8px 18px rgba(0,0,0,0.4));
  }

  /* Filmstrip */
  .al-filmstrip-wrap {
    overflow-x: auto;
    padding-bottom: 1rem;
    margin: 0 -1.5rem;
    padding-inline: 1.5rem;
  }
  .al-filmstrip {
    display: grid;
    grid-template-columns: repeat(6, minmax(280px, 1fr));
    gap: 1rem;
    min-width: max-content;
  }
  @media (min-width: 1280px) {
    .al-filmstrip-wrap { overflow-x: visible; margin: 0; padding: 0; }
    .al-filmstrip { min-width: 0; grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .al-filmstrip-wrap { overflow-x: visible; margin: 0; padding: 0; }
    .al-filmstrip { min-width: 0; grid-template-columns: repeat(2, 1fr); }
  }
  .al-film {
    background: var(--color-cdm-panel);
    color: var(--al-tinta);
    border: 1px solid var(--color-cdm-regla-2);
    overflow: hidden;
    display: grid;
    grid-template-rows: 16px 1fr 16px;
    transition: transform .25s, border-color .25s;
  }
  .al-film:hover { transform: translateY(-4px); border-color: var(--al-oro); }
  /* Las perforaciones siguen alternando, en tonos de consola. */
  .al-film__perforation {
    background: var(--color-cdm-panel-2);
    background-image:
      repeating-linear-gradient(90deg,
        var(--color-cdm-suelo) 0 8px,
        var(--color-cdm-regla-2) 8px 14px);
    border-block: 1px solid var(--color-cdm-regla);
  }
  .al-film__body {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1rem;
    padding: 1rem;
    align-items: center;
  }
  .al-film__frame {
    background: var(--color-cdm-suelo);
    color: var(--al-sun);
    aspect-ratio: 1;
    border: 2px solid var(--al-cine);
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem;
    box-shadow: inset 0 0 0 4px var(--color-cdm-panel-2), inset 0 0 0 6px var(--color-cdm-suelo);
  }
  .al-film__data { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .al-film__head { display: flex; justify-content: space-between; gap: .5rem; align-items: baseline; }
  .al-film__year {
    background: var(--al-cine); color: var(--al-suelo);
    padding: .15rem .4rem;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .12em;
  }
  .al-film__dir { font-size: .55rem; letter-spacing: .15em; color: var(--al-alcazaba); opacity: .85; }
  .al-film__title {
    font-size: 1rem;
    line-height: 1.1;
    letter-spacing: -.015em;
    color: var(--al-tinta);
    margin: .15rem 0 0;
  }
  .al-film__escena {
    font-size: .65rem;
    letter-spacing: .1em;
    color: var(--al-alcazaba);
    line-height: 1.3;
  }

  .al-aw-note {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: rgba(229,167,38,0.1);
    border: 2px solid var(--al-oro);
    font-size: .92rem;
    line-height: 1.5;
    color: var(--al-tinta);
  }
  .al-aw-note strong { color: var(--al-sun); }

  /* ═══════════════════════════════════════════════════════ */
  /* HITOS                                                   */
  /* ═══════════════════════════════════════════════════════ */
  .al-hitos-section {
    background: var(--al-indigo);
    color: var(--al-tinta);
    padding: 5rem 1.5rem;
    border-bottom: 1px solid var(--color-cdm-regla);
    position: relative;
    overflow: hidden;
  }
  .al-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(229,167,38,0.07) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .al-hitos-section > * { position: relative; }
  .al-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid rgba(255,251,240,0.35);
  }
  @media (min-width: 640px)  { .al-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .al-hitos { grid-template-columns: repeat(3, 1fr); } }
  .al-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(255,251,240,0.25);
    border-right: 1px solid rgba(255,251,240,0.25);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(255,251,240,0.04);
    transition: background .25s;
  }
  .al-hito:hover { background: rgba(229,167,38,0.15); }
  @media (min-width: 1024px) {
    .al-hito:nth-child(3n) { border-right: none; }
    .al-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .al-hito:nth-child(2n) { border-right: none; }
    .al-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .al-hito { border-right: none; }
    .al-hito:last-child { border-bottom: none; }
  }
  .al-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--al-oro); font-weight: 800; }
  .al-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--al-tinta); line-height: 1.35; }

  /* ═══════════════════════════════════════════════════════ */
  /* SECTORES                                                */
  /* ═══════════════════════════════════════════════════════ */
  .al-sec-section {
    background: var(--al-suelo);
    padding: 5rem 1.5rem;
    border-bottom: 1px solid var(--color-cdm-regla);
  }
  .al-sec {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .al-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .al-sec { grid-template-columns: repeat(3, 1fr); } }
  .al-sec__card {
    background: var(--al-paper);
    border: 1px solid var(--color-cdm-regla-2);
    box-shadow: var(--al-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .al-sec__card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .al-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .al-sec__card--alcazaba { color: var(--al-alcazaba); }
  .al-sec__card--oro      { color: var(--al-oro); }
  .al-sec__card--cine     { color: var(--al-cine); }
  .al-sec__card--gata     { color: var(--al-gata); }
  .al-sec__card--indigo   { color: var(--al-indigo-l); }
  .al-sec__card--oro-d    { color: var(--al-oro-d); }

  .al-sec__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
    gap: .5rem;
  }
  .al-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .al-sec__stat-box {
    background: var(--color-cdm-panel-2); color: var(--al-tinta);
    padding: .35rem .65rem;
    border: 1.5px solid currentColor;
  }
  .al-sec__stat-v { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }
  .al-sec__title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    color: var(--al-tinta);
    margin: 0;
  }
  .al-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--al-tenue); flex: 1; }
  .al-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .al-sec__tag {
    display: flex; align-items: flex-start; gap: .35rem;
    font-size: .78rem;
    line-height: 1.35;
    color: var(--al-tinta);
  }
  .al-sec__tag span { color: currentColor; font-weight: 800; }
  .al-sec__foot {
    padding-top: .65rem;
    border-top: 1px solid var(--color-cdm-regla);
  }
  .al-sec__cta {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* MAPA                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .al-map-section {
    background: var(--al-suelo);
    border-bottom: 1px solid var(--color-cdm-regla);
  }
  .al-map-head { padding: 4rem 0 2rem; }
  .al-map-head__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: end;
  }
  @media (min-width: 768px) { .al-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .al-map-chapter { color: var(--al-alcazaba); }
  .al-map-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 0;
  }
  .al-map-title em { color: var(--al-alcazaba); }
  .al-map-coords {
    background: var(--al-indigo);
    color: var(--al-sun);
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-cdm-regla-2);
    box-shadow: 5px 5px 0 var(--al-oro);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem;
    letter-spacing: .15em;
  }

  .al-map-frame {
    position: relative;
    border-top: 1px solid var(--color-cdm-regla);
    border-bottom: 1px solid var(--color-cdm-regla);
    background: var(--color-cdm-panel-2);
  }
  .al-map-deco {
    position: absolute;
    width: 60px; height: 60px;
    z-index: 5;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(229,167,38,0.45));
  }
  .al-map-deco--tl { top: 16px; left: 16px; }
  .al-map-deco--br { bottom: 16px; right: 16px; }

  .al-map-wrap {
    width: 100%;
    height: clamp(420px, 60vh, 600px);
    overflow: hidden;
  }
  .al-map-wrap > * { width: 100%; height: 100%; }

  /* ═══════════════════════════════════════════════════════ */
  /* DIFERENCIALES                                           */
  /* ═══════════════════════════════════════════════════════ */
  .al-dif-section {
    background: var(--al-suelo);
    padding: 5rem 1.5rem;
    border-bottom: 1px solid var(--color-cdm-regla);
  }
  .al-dif {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid var(--color-cdm-regla-2);
  }
  @media (min-width: 768px) { .al-dif { grid-template-columns: 1fr 1fr; } }
  .al-dif__item {
    padding: 1.75rem 1.5rem;
    border-bottom: 1px solid var(--color-cdm-regla);
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .2s;
  }
  @media (min-width: 768px) {
    .al-dif__item:nth-child(odd) { border-right: 1px solid var(--color-cdm-regla); }
    .al-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) {
    .al-dif__item:last-child { border-bottom: none; }
  }
  .al-dif__item--0 { background: var(--al-paper-2); }
  .al-dif__item--1 { background: var(--al-paper); }
  .al-dif__item--2 { background: var(--al-paper-2); }
  .al-dif__item--3 { background: var(--al-paper); }
  /* El hover era oro sobre papel; sobre suelo basta con levantar el panel. */
  .al-dif__item:hover { background: var(--color-cdm-regla); }
  .al-dif__num { font-size: .85rem; color: var(--al-cine); font-weight: 800; letter-spacing: .15em; }
  .al-dif__t {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--al-tinta);
    margin: 0;
  }
  .al-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--al-tenue); margin: 0; }

  /* ═══════════════════════════════════════════════════════ */
  /* PROCESO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .al-proc-section {
    background: var(--al-indigo);
    color: var(--al-tinta);
    padding: 5rem 1.5rem;
    border-bottom: 1px solid var(--color-cdm-regla);
    position: relative;
    overflow: hidden;
  }
  .al-proc-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(229,167,38,0.06) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .al-proc-section > * { position: relative; }
  .al-proc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px)  { .al-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .al-proc { grid-template-columns: repeat(4, 1fr); } }
  .al-proc__step {
    background: rgba(255,251,240,0.05);
    border: 1px solid rgba(255,251,240,0.35);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .al-proc__step:hover { background: rgba(229,167,38,0.12); transform: translateY(-3px); }
  .al-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(255,251,240,0.25); }
  .al-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--al-sun); line-height: 1; }
  .al-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--al-cine); }
  .al-proc__t {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--al-tinta);
    margin: .25rem 0 0;
  }
  .al-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(255,251,240,0.75); flex: 1; }
  .al-proc__foot {
    font-size: .58rem;
    letter-spacing: .2em;
    color: var(--al-sun);
    font-weight: 800;
    padding-top: .5rem;
    border-top: 1.5px solid rgba(255,251,240,0.25);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
