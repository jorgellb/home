---

<BaseLayout
  title={title}
  description={description}
  image="/imagenes/diseno-web-almeria.jpg"
  imageAlt="Diseño Web en Almería - Agencia Platanito Rico"
  type="website"
  lang="es"
  canonical={canonical}
  keywords="diseño web almería, páginas web almería, agencia web almería, seo almería, tienda online almería, desarrollo web almería"
  jsonLd={jsonLd}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- ═══════════════════════════════════════════
         HERO — Almería Capital
    ════���══════════════════════════════════════ -->
    <section class="relative py-24 lg:py-32 overflow-hidden">
      <div class="absolute inset-0 bg-white"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
      <div class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-purple-500/10 rounded-full blur-[150px]"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-blue-500/10 rounded-full blur-[150px]"></div>

      <div class="relative max-w-6xl mx-auto px-6">
        <!-- Breadcrumb -->
        <nav class="mb-8 animate-fade-up" aria-label="Migas de pan">
          <ol class="flex items-center gap-2 text-sm text-slate-500">
            <li><a href="/" class="hover:text-purple-500 transition-colors">Inicio</a></li>
            <li aria-hidden="true"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
            <li><a href="/desarrollo-web" class="hover:text-purple-500 transition-colors">Diseño Web</a></li>
            <li aria-hidden="true"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
            <li><span class="text-purple-500 font-medium" aria-current="page">Almería</span></li>
          </ol>
        </nav>

        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <!-- Columna texto -->
          <div>
            <div class="flex items-center gap-4 mb-8 animate-fade-up stagger-1">
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-100 border border-slate-200 text-sm text-slate-600">
                <svg class="w-4 h-4 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                Almería Capital · 200.000 habitantes
              </span>
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-sm text-emerald-600">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Hosting gratuito incluido
              </span>
            </div>

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6 animate-fade-up stagger-2">
              Diseño Web en<br/>
              <span class="text-gradient">Almería</span>
            </h1>

            <p class="speakable-intro text-xl md:text-2xl text-slate-600 mb-8 leading-relaxed animate-fade-up stagger-3">
              Creamos <strong class="text-slate-900">páginas web profesionales</strong> para empresas y negocios de Almería. Tecnología moderna, <strong class="text-slate-900">hosting gratuito de por vida</strong> y posicionamiento en Google desde el primer día.
            </p>

            <!-- Datos rápidos -->
            <div class="grid grid-cols-3 gap-4 mb-10 animate-fade-up stagger-4">
              <div class="text-center p-3 rounded-2xl bg-slate-50 border border-slate-200">
                <p class="text-2xl font-bold text-purple-600">450€</p>
                <p class="text-xs text-slate-500 mt-1">Desde</p>
              </div>
              <div class="text-center p-3 rounded-2xl bg-slate-50 border border-slate-200">
                <p class="text-2xl font-bold text-purple-600">&lt;1s</p>
                <p class="text-xs text-slate-500 mt-1">Tiempo de carga</p>
              </div>
              <div class="text-center p-3 rounded-2xl bg-slate-50 border border-slate-200">
                <p class="text-2xl font-bold text-purple-600">0€</p>
                <p class="text-xs text-slate-500 mt-1">Hosting/año</p>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="flex flex-wrap gap-4 animate-fade-up stagger-5">
              <a href="/#contacto" class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-purple-500 to-violet-600 text-white font-semibold hover:shadow-lg hover:shadow-purple-500/30 hover:-translate-y-1 transition-all duration-300">
                <span>Solicitar presupuesto gratis</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <a href="tel:+34657085019" class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-slate-100 text-slate-900 font-semibold hover:bg-slate-200 hover:-translate-y-1 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                <span>657 085 019</span>
              </a>
            </div>
          </div>

          <!-- Columna imagen -->
          <div class="relative animate-fade-up stagger-3">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl">
              <img
                src="/imagenes/diseno-web-almeria.jpg"
                alt="Diseño web profesional en Almería - Vista de la Alcazaba y la ciudad"
                width="700"
                height="500"
                class="w-full h-auto object-cover"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
              <div class="absolute bottom-5 left-5">
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/20 backdrop-blur-sm border border-white/30 text-white text-sm font-medium">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  Almería Capital · Andalucía
                </span>
              </div>
            </div>
            <div class="absolute -inset-4 bg-gradient-to-r from-purple-500/20 to-violet-500/20 rounded-3xl blur-2xl -z-10"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         PROPUESTA DE VALOR — Hosting gratuito
