                    <rect x="206" y="100" width="50" height="65" fill="url(#al-stone)"/>
                    <path d="M 206 100 L 206 92 L 214 92 L 214 98 L 224 98 L 224 92 L 232 92 L 232 98 L 240 98 L 240 92 L 248 92 L 248 98 L 256 98 L 256 100 Z" fill="#C25E2B" stroke="#0E0D0B" stroke-width="2.5"/>
                    {/* Ventana de la torre */}
                    <rect x="222" y="120" width="18" height="22" fill="#0E0D0B"/>
                    <path d="M 222 120 Q 231 110 240 120" fill="#0E0D0B"/>

                    {/* Bandera al viento */}
                    <line x1="231" y1="92" x2="231" y2="64" stroke="#0E0D0B" stroke-width="2"/>
                    <path d="M 231 64 L 268 70 L 264 78 L 268 86 L 231 80 Z" fill="#E5A726" stroke="#0E0D0B" stroke-width="1.5"/>

                    {/* Muralla media (continuación a la derecha) */}
