                    <rect x="30" y="195" width="20" height="27"/>
                    <rect x="52" y="200" width="18" height="22"/>
                    <rect x="72" y="198" width="22" height="24"/>
                    <rect x="96" y="202" width="18" height="20"/>
                    <rect x="116" y="198" width="20" height="24"/>
