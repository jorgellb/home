                <svg viewBox="0 0 540 240" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
                  <defs>
                    <linearGradient id="al-sky" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%"  stop-color="#1A2647"/>
                      <stop offset="55%" stop-color="#C25E2B"/>
                      <stop offset="100%" stop-color="#E5A726"/>
