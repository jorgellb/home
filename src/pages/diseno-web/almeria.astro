---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import { getPueblosByComarca } from '../../data/pueblos-almeria';

const pueblosMetro = getPueblosByComarca('Almería Metropolitana').filter(p => p.slug !== 'almeria');

const title = 'Diseño Web en Almería | Agencia de Páginas Web y SEO Local';
const description = 'Agencia de diseño web en Almería capital. Creamos páginas web profesionales con hosting gratuito, tiendas online y SEO local para posicionar tu negocio en Google. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/diseno-web/almeria/';

// ── Sectores clave de Almería ──
const sectores = [
  {
    nombre: 'Hostelería y Restauración',
    descripcion: 'Webs con carta digital, sistema de reservas online y optimización para búsquedas tipo "restaurante en Almería". El turismo mueve la hostelería almeriense y tu web es tu mejor camarero 24h.',
    icon: 'restaurant',
    keywords: ['Carta digital QR', 'Reservas online', 'SEO "restaurante Almería"', 'Fotos profesionales de platos']
  },
  {
    nombre: 'Inmobiliarias',
    descripcion: 'Portales inmobiliarios con buscador de propiedades, fichas detalladas con galería y captación de leads cualificados. Almería tiene un mercado inmobiliario en auge y tu web es tu escaparate principal.',
    icon: 'building',
    keywords: ['Portal de propiedades', 'Buscador avanzado', 'Captación de leads', 'Integración MLS']
  },
  {
    nombre: 'Salud y Bienestar',
    descripcion: 'Páginas web para clínicas dentales, centros médicos, fisioterapeutas y centros de estética en Almería. Con sistema de citas online y cumplimiento RGPD sanitario.',
    icon: 'health',
    keywords: ['Citas online', 'Ficha médica digital', 'RGPD sanitario', 'SEO local salud']
  },
  {
    nombre: 'Comercio y Retail',
    descripcion: 'Tiendas online para comercios almerienses que quieren vender a toda España. Desde productos locales hasta moda, con pasarela de pago segura y gestión de envíos automatizada.',
    icon: 'shop',
    keywords: ['E-commerce completo', 'Pasarela de pago', 'Gestión de stock', 'Envíos automatizados']
  },
  {
    nombre: 'Servicios Profesionales',
    descripcion: 'Webs corporativas para abogados, gestorías, arquitectos e ingenieros de Almería. Diseño que transmite confianza y profesionalidad, con formularios de contacto cualificados.',
    icon: 'briefcase',
    keywords: ['Web corporativa', 'Portfolio de proyectos', 'Formularios inteligentes', 'Blog de autoridad']
  },
  {
    nombre: 'Turismo y Ocio',
    descripcion: 'Almería es destino de cine, playa y naturaleza. Webs para hoteles, casas rurales, empresas de actividades y guías turísticos, con motor de reservas y multiidioma.',
    icon: 'sun',
    keywords: ['Motor de reservas', 'Multiidioma', 'Galería inmersiva', 'Integración Booking']
  }
];

// ── Proceso de trabajo ──
const proceso = [
  { paso: 1, titulo: 'Auditoría y estrategia', descripcion: 'Analizamos tu negocio, competencia y mercado en Almería. Definimos objetivos, palabras clave y la arquitectura web ideal para tu sector.', duracion: '1-2 días' },
  { paso: 2, titulo: 'Diseño y prototipo', descripcion: 'Creamos el diseño visual de tu web: estructura, colores, tipografías y experiencia de usuario. Tú apruebas antes de pasar a desarrollo.', duracion: '3-5 días' },
  { paso: 3, titulo: 'Desarrollo y SEO técnico', descripcion: 'Programamos tu web con tecnología moderna (Astro, Tailwind), velocidad de carga óptima, datos estructurados y SEO técnico desde el código.', duracion: '5-10 días' },
  { paso: 4, titulo: 'Lanzamiento y formación', descripcion: 'Publicamos tu web con hosting gratuito incluido, la indexamos en Google y te formamos para que gestiones tu contenido con total autonomía.', duracion: '1-2 días' },
];

// ── Comparativa ──
const comparativa = [
  { caracteristica: 'Velocidad de carga', profesional: 'Menos de 1 segundo (Core Web Vitals verdes)', amateur: '3-8 segundos (penaliza en Google)' },
  { caracteristica: 'SEO técnico', profesional: 'Datos estructurados, sitemap, robots.txt, meta tags optimizados', amateur: 'Sin configurar o mal implementado' },
  { caracteristica: 'Diseño responsive', profesional: 'Pixel-perfect en móvil, tablet y escritorio', amateur: 'Se descuadra en algunas pantallas' },
  { caracteristica: 'Hosting', profesional: 'Gratuito de por vida para webs estáticas (CDN global)', amateur: '60-200€/año en hosting compartido lento' },
  { caracteristica: 'Seguridad', profesional: 'SSL, headers de seguridad, sin plugins vulnerables', amateur: 'Vulnerable a ataques (plugins desactualizados)' },
  { caracteristica: 'Mantenimiento', profesional: 'Mínimo: sin base de datos ni actualizaciones de WordPress', amateur: 'Actualizaciones constantes, riesgo de rotura' },
];

// ── FAQ estratégica ──
const faqs = [
  {
    q: '¿Cuánto cuesta una página web profesional en Almería?',
    a: 'Una web corporativa profesional en Almería parte desde 450€. Incluye diseño personalizado, SEO técnico, hosting gratuito y formación. Tiendas online con pasarela de pago oscilan entre 900€ y 2.500€ según funcionalidades. Siempre presupuesto cerrado, sin sorpresas.'
  },
  {
    q: '¿Por qué el hosting es gratuito en vuestras webs?',
    a: 'Utilizamos tecnología de generación estática (Astro) que produce webs ultrarrápidas que se sirven desde CDN global sin necesidad de servidor ni base de datos. Plataformas como Netlify o Cloudflare Pages ofrecen hosting gratuito ilimitado para este tipo de webs. Tu negocio en Almería se ahorra entre 60€ y 200€ al año en hosting, para siempre.'
  },
  {
    q: '¿En cuánto tiempo tendré mi web lista?',
    a: 'Una web corporativa estándar se completa en 1-2 semanas. Proyectos más complejos (tiendas online, plataformas con reservas) pueden requerir 3-4 semanas. Trabajamos con metodología ágil: ves avances desde la primera semana.'
  },
  {
    q: '¿Mi web aparecerá en Google si os contrato?',
    a: 'Todas nuestras webs se entregan optimizadas para SEO desde el código: velocidad de carga óptima, datos estructurados (Schema.org), meta etiquetas, sitemap XML y contenido indexable. Para posicionamiento agresivo en búsquedas competitivas como "dentista Almería" o "restaurante Almería", ofrecemos planes de SEO mensual con informes de resultados.'
  },
  {
    q: '¿Qué ventaja tiene una web estática frente a WordPress?',
    a: 'Una web estática carga en menos de 1 segundo (WordPress tarda 3-8s), no tiene base de datos que hackear, no necesita actualizaciones de plugins, el hosting es gratuito y el rendimiento en Google es superior. Para webs corporativas, portfolios y landing pages es la mejor opción técnica y económica.'
  },
  {
    q: '¿Puedo gestionar mi web yo mismo después?',
    a: 'Sí. Entregamos formación personalizada y documentación para que actualices textos, imágenes y contenidos. Para webs con blog o catálogo de productos, integramos un CMS headless intuitivo. Además, nuestro soporte técnico está disponible si necesitas ayuda.'
  },
  {
    q: '¿Hacéis reuniones presenciales en Almería?',
    a: 'Sí. Nos reunimos en persona en Almería capital y en toda la provincia. También ofrecemos videollamada si te resulta más cómodo. La primera consulta es siempre gratuita y sin compromiso.'
  },
  {
    q: '¿Trabajáis con negocios de toda la provincia de Almería?',
    a: 'Sí. Aunque esta página se centra en Almería capital, damos servicio a negocios de toda la provincia: Roquetas de Mar, Níjar, El Ejido, Mojácar, Vera, Huércal-Overa y más de 100 localidades. Cada pueblo tiene su propia página de servicio adaptada.'
  }
];

// ── JSON-LD Schema avanzado ──
const jsonLd = [
  // 1. WebPage
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonical,
    "inLanguage": "es",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Platanito Rico",
      "url": "https://platanitorico.com"
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
        { "@type": "ListItem", "position": 2, "name": "Diseño Web", "item": "https://platanitorico.com/desarrollo-web" },
        { "@type": "ListItem", "position": 3, "name": "Almería", "item": canonical }
      ]
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", ".speakable-intro"]
    }
  },
  // 2. ProfessionalService (más específico que LocalBusiness para servicios)
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Platanito Rico - Diseño Web Almería",
    "url": canonical,
    "telephone": "+34657085019",
    "email": "hola@platanitorico.com",
    "image": "https://platanitorico.com/imagenes/diseno-web-almeria.jpg",
    "logo": "https://platanitorico.com/imagenes/logo.png",
    "priceRange": "€€",
    "currenciesAccepted": "EUR",
    "paymentAccepted": "Transferencia, Bizum, Tarjeta",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ctra de Ronda, 82",
      "addressLocality": "Vera",
      "addressRegion": "Almería",
      "postalCode": "04620",
      "addressCountry": "ES"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "36.8381",
      "longitude": "-2.4597"
    },
    "areaServed": [
      { "@type": "City", "name": "Almería", "sameAs": "https://es.wikipedia.org/wiki/Almer%C3%ADa" },
      { "@type": "State", "name": "Provincia de Almería" }
    ],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "18:00"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "68",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Carmen López" },
        "datePublished": "2024-09-15",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Llevaba años con una web obsoleta que no aparecía en Google. Platanito Rico me hizo una web espectacular en tiempo récord y en dos meses ya aparecía en la primera página para búsquedas de Almería."
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Manuel Fernández" },
        "datePublished": "2024-10-22",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Necesitaba una tienda online para mi negocio de productos frescos de Almería. El equipo entendió perfectamente lo que quería y el resultado superó todas mis expectativas."
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Ana Martínez" },
        "datePublished": "2024-11-08",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Como agencia inmobiliaria en Almería necesitábamos posicionarnos mejor. Platanito Rico nos creó una web profesional con SEO local increíble. Ahora aparecemos entre los primeros."
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Roberto García" },
        "datePublished": "2025-01-10",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Tenía un restaurante en el Paseo Marítimo de Almería sin presencia online. Gracias a la web y al SEO local que me hicieron, las reservas online no paran."
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios de Diseño Web en Almería",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "Diseño Web Corporativo", "description": "Páginas web profesionales para empresas de Almería con hosting gratuito" },
          "priceSpecification": { "@type": "PriceSpecification", "price": "450", "priceCurrency": "EUR", "minPrice": "450" }
        },
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "Tienda Online", "description": "E-commerce para vender desde Almería a toda España" },
          "priceSpecification": { "@type": "PriceSpecification", "price": "900", "priceCurrency": "EUR", "minPrice": "900" }
        },
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "SEO Local Almería", "description": "Posicionamiento en Google para negocios de Almería" }
        }
      ]
    }
  },
  // 3. HowTo (proceso de trabajo)
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo crear una página web profesional en Almería",
    "description": "Proceso paso a paso para diseñar y lanzar una página web profesional para tu negocio en Almería con hosting gratuito incluido.",
    "totalTime": "P14D",
    "estimatedCost": { "@type": "MonetaryAmount", "currency": "EUR", "value": "450" },
    "step": proceso.map((p, i) => ({
      "@type": "HowToStep",
      "position": i + 1,
      "name": p.titulo,
      "text": p.descripcion
    }))
  },
  // 4. FAQPage
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  // 5. VideoObject
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "Diseño Web en Almería - Impulsa tu negocio en internet",
    "description": "Aprende cómo los negocios de Almería pueden destacar en internet con diseño web profesional y estrategias SEO locales.",
    "thumbnailUrl": "https://img.youtube.com/vi/cy8kLyLn2kc/maxresdefault.jpg",
    "uploadDate": "2024-01-15",
    "duration": "PT5M30S",
    "contentUrl": "https://www.youtube.com/watch?v=cy8kLyLn2kc",
    "embedUrl": "https://www.youtube.com/embed/cy8kLyLn2kc",
    "publisher": {
      "@type": "Organization",
      "name": "Platanito Rico",
      "logo": { "@type": "ImageObject", "url": "https://platanitorico.com/imagenes/logo.png" }
