                    <path d="M 256 145 L 256 138 L 268 138 L 268 144 L 280 144 L 280 138 L 292 138 L 292 144 L 305 144 L 305 138 L 318 138 L 318 144 L 330 144 L 330 138 L 345 138 L 345 144 L 360 144 L 360 172" fill="url(#al-stone)"/>

                    {/* Torres secundarias */}
