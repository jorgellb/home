---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import { getPueblosByComarca } from '../../data/pueblos-almeria';

const pueblosValle = getPueblosByComarca('Valle del Almanzora').filter(p => p.slug !== 'albox');

const title = 'Diseño Web en Albox | Creación de Páginas Web, Tiendas Online y SEO Local';
const description = 'Diseñador web en Albox, Valle del Almanzora. Páginas web profesionales para comercios, industria del mármol, servicios profesionales y hostelería. Hosting gratuito, tiendas online y posicionamiento SEO. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/diseno-web/albox/';

const sectores = [
  { nombre: 'Comercio local y mercado',   stat: '12k',   statLabel: 'habitantes', desc: 'Albox es el centro comercial del Valle, con su famoso mercado semanal. Creamos tiendas online para que tus productos lleguen a toda España, catálogos digitales y webs con reserva de pedidos.', tags: ['Tienda online','Catálogo digital','Pasarela de pago','Pedidos online'] },
  { nombre: 'Industria del mármol y piedra', stat: 'B2B', statLabel: 'exportación mundial', desc: 'El Valle del Almanzora es referencia mundial en mármol. Webs corporativas para canteras, fábricas y distribuidores con catálogo técnico multiidioma y captación de leads internacionales.', tags: ['Catálogo técnico','Fichas de producto','Multiidioma','Leads internacionales'] },
  { nombre: 'Servicios profesionales',    stat: '#1',    statLabel: 'Google local', desc: 'Abogados, gestorías, aseguradoras, arquitectos e ingenieros de Albox. Webs que transmiten confianza con formularios cualificados, blog de autoridad y posicionamiento local.', tags: ['Web corporativa','Formularios inteligentes','SEO local','Blog profesional'] },
  { nombre: 'Salud y bienestar',          stat: '24/7',  statLabel: 'citas online', desc: 'Clínicas dentales, fisioterapeutas, psicólogos, farmacias, veterinarios y centros de estética en Albox. Citas online, RGPD sanitario y posicionamiento para captar pacientes de toda la comarca.', tags: ['Citas online','RGPD sanitario','Ficha de servicios','SEO salud'] },
  { nombre: 'Hostelería y restauración',  stat: 'x2',    statLabel: 'reservas online', desc: 'Restaurantes, bares, cafeterías y alojamientos rurales. Carta digital QR, reservas online, integración Google Maps y fotografía profesional de platos.', tags: ['Carta digital QR','Reservas online','Google Maps','Fotos profesionales'] },
  { nombre: 'Construcción e inmobiliarias', stat: '+35%', statLabel: 'presupuestos', desc: 'Constructoras, reformas, electricistas, fontaneros e inmobiliarias de Albox. Portales con buscador de propiedades, portfolios de obras y SEO local.', tags: ['Portfolio de obras','Presupuestos online','Portal propiedades','SEO construcción'] },
];

const diferenciales = [
  { title: 'Capital del Valle del Almanzora',     desc: 'Con 12.000 habitantes, Albox es el centro de servicios, comercio y administración de toda la comarca. Tu web sirve a Olula, Macael, Cantoria, Fines, Arboleas y decenas de localidades.' },
  { title: 'Mercado tradicional con proyección digital', desc: 'El famoso mercado de Albox atrae visitantes cada semana. El mercado digital está abierto 24/7. Una web profesional extiende tu negocio más allá del martes de mercado.' },
  { title: 'Industria del mármol: escaparate mundial', desc: 'Macael y el Valle del Almanzora exportan mármol a todo el mundo. Las empresas del sector necesitan webs multiidioma con catálogos técnicos a la altura del producto.' },
  { title: 'Comunidad expatriada británica',      desc: 'Albox y alrededores tienen una importante comunidad británica. Muchos negocios locales se benefician de una web bilingüe español-inglés para captar este mercado.' },
];

const proceso = [
  { num: '01', title: 'Reunión en Albox',           eta: '1–2 días', body: 'Reunión en tu negocio (presencial o videollamada). Análisis de sector, competencia y mercado. Definimos objetivos, keywords y arquitectura web.', deliverable: 'Briefing + roadmap' },
  { num: '02', title: 'Diseño personalizado',        eta: '3–5 días', body: 'Diseño visual adaptado a tu negocio: estructura, colores, tipografías y UX. Nada de plantillas — tú apruebas cada decisión.', deliverable: 'Prototipo Figma · approved' },
  { num: '03', title: 'Desarrollo + SEO',            eta: '5–10 días', body: 'Astro ultrarrápido, SEO técnico desde el código, Schema.org, Core Web Vitals y contenido orientado a posicionar en Albox.', deliverable: 'Web en staging + auditoría' },
  { num: '04', title: 'Lanzamiento + formación',     eta: '1–2 días', body: 'Publicamos con hosting gratuito, configuramos Google Business Profile, Search Console y te formamos para que gestiones tu web con autonomía.', deliverable: 'Sitio en producción + manual' },
];

const testimonios = [
  { nombre: 'José Antonio M.', negocio: 'Gestoría · Albox',                texto: 'Mi gestoría no tenía web. Me hicieron una página profesional con SEO local y en pocas semanas ya aparecía para "gestoría Albox" en Google. Ahora recibo consultas de toda la comarca sin mover un dedo.' },
  { nombre: 'Rafael G.',       negocio: 'Empresa de mármol · Valle',       texto: 'Necesitábamos una web con catálogo técnico en español e inglés. El resultado es profesional, rápido y nos ha abierto puertas con distribuidores de otros países.' },
  { nombre: 'Paqui L.',        negocio: 'Restaurante · Albox',             texto: 'Mi restaurante estaba en Google Maps pero sin web. Ahora tenemos carta digital, reservas online y aparecemos los primeros cuando alguien busca "dónde comer en Albox". Un antes y un después.' },
  { nombre: 'David H.',        negocio: 'Inmobiliaria · Albox',            texto: 'Como inmobiliaria, necesitábamos un portal bilingüe para captar compradores británicos y del norte de Europa. La web tiene buscador, fichas detalladas y genera leads cualificados cada semana.' },
];

const faq = [
  { q: '¿Cuánto cuesta el diseño web en Albox?', a: 'Web profesional desde 450€. Incluye diseño personalizado, SEO técnico, hosting gratuito de por vida (para webs estáticas) y formación. Tiendas online: 900€–2.500€ según funcionalidades. Presupuesto cerrado sin sorpresas.' },
  { q: '¿Por qué el hosting es gratuito en Albox?', a: 'Generación estática con Astro: webs ultrarrápidas servidas desde CDN global sin servidor ni base de datos. Vercel o Cloudflare Pages ofrecen hosting gratuito ilimitado. Tu negocio se ahorra 60–200€/año.' },
  { q: '¿Sois diseñadores web en Albox? ¿Hacéis reuniones presenciales?', a: 'Sí. Agencia local que trabaja habitualmente en Albox, Olula del Río, Macael, Cantoria y todo el Valle del Almanzora. Reuniones en tu negocio o videollamada. Primera consulta gratuita.' },
  { q: '¿Cuánto tarda la creación de una página web en Albox?', a: 'Web corporativa: 1–2 semanas. Tienda online: 2–4 semanas según complejidad. Metodología ágil: ves avances desde la primera semana. Si tienes urgencia, priorizamos.' },
  { q: '¿Mi web aparecerá en Google para búsquedas en Albox?', a: 'Sí. SEO técnico desde el código: velocidad óptima, datos estructurados, meta etiquetas, sitemap y contenido optimizado para keywords como "diseño web Albox", "abogado Albox" o "restaurante Albox". Configuramos también Google Business Profile.' },
  { q: '¿Hacéis tiendas online para comercios de Albox?', a: 'Sí. Tiendas online completas con catálogo, pasarela de pago segura (Stripe, Redsys), gestión de stock, envíos automatizados y diseño responsive. Ideal para vender a toda España sin depender solo del mercado local.' },
  { q: '¿Qué ventaja tiene una web estática frente a WordPress?', a: 'Carga <1s (vs 3–8s en WP), sin base de datos hackeable, sin actualizaciones de plugins, hosting gratuito y mejor rendimiento en Google. Para webs corporativas, portfolios y landings es la mejor opción.' },
  { q: '¿Puedo gestionar mi página web yo mismo?', a: 'Sí. Formación personalizada para actualizar textos, imágenes y contenidos sin programar. Para blog o catálogo, CMS headless intuitivo. Soporte técnico siempre disponible.' },
];

const jsonLdSchemas = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Diseño Web","item":"https://platanitorico.com/diseno-web/"},{"@type":"ListItem","position":3,"name":"Albox","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico - Diseño Web Albox","url":canonical,"telephone":"+34657085019","priceRange":"€€","address":{"@type":"PostalAddress","addressLocality":"Albox","addressRegion":"Almería","postalCode":"04800","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":37.387,"longitude":-2.149},"areaServed":["Albox","Olula del Río","Macael","Cantoria","Valle del Almanzora"],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","reviewCount":"41","bestRating":"5"},"review":testimonios.map(t=>({"@type":"Review","author":{"@type":"Person","name":t.nombre},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":t.texto})) },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo creamos tu web en Albox","step":proceso.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/diseno-web-albox.jpg"
  imageAlt="Diseño web en Albox - Platanito Rico"
  type="service"
  keywords="diseño web albox, agencia web albox, tienda online albox, seo albox, valle almanzora, mármol macael"
  jsonLd={jsonLdSchemas}
>
  <Header />

  <main id="main-content">
    {/* HERO */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 048 — Valle del Almanzora · Mercado &amp; mármol</span>
          <span class="text-meta"><span class="live-dot"></span> 12.000 habitantes · centro comarcal</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Diseño Web · Albox · Valle del Almanzora</span>
            <h1 class="svc-hero__title">
              Diseño web en
              <em>Albox,</em>
              <span class="text-stroke-ink">capital</span>
              del Valle.
            </h1>
            <p class="svc-hero__lead">
              <strong>Centro comercial</strong> del Valle del Almanzora, mercado tradicional
              y puerta a la industria del mármol mundial. Webs para comercio, industria,
              servicios profesionales y hostelería con SEO local y bilingüe ES/EN.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">Presupuesto en 24h →</a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">12k</span>
              <span class="svc-hero__spec-lbl">Habitantes</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">ES/EN</span>
              <span class="svc-hero__spec-lbl">Comunidad UK</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">450€</span>
              <span class="svc-hero__spec-lbl">Desde · web pro</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">4.9★</span>
              <span class="svc-hero__spec-lbl">41 reseñas</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ ALBOX ★ VALLE DEL ALMANZORA ★ MÁRMOL ★ MACAEL ★ MERCADO ★ COMERCIO ★ BILINGÜE ★</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section-brutal" style="padding:0;background:var(--brutal-bg-alt);border-bottom:2px solid var(--brutal-ink);">
      <div class="pueblo-map-wrap">
        <InteractiveMap center={[-2.149, 37.387]} zoom={13} pitch={25} bearing={-15} label="Albox" />
      </div>
    </section>

    {/* SECTORES */}
    <section class="section-brutal" id="sectores">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 01 / Sectores Albox</span>
            <h2 class="brutal-section-head__title">
              Para quién
              <em>diseñamos</em>
              en Albox.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Seis sectores fuertes en Albox y Valle del Almanzora: mercado,
            mármol, servicios, salud, hostelería y construcción. Cada uno con
            estrategia propia.
          </p>
        </header>

        <ol class="svc-bento">
          {sectores.map((s, i) => {
            const accents = ['accent', 'paper', 'lime', 'paper', 'ink', 'paper'];
            return (
              <li class={`svc-card svc-card--${accents[i]}`}>
                <header class="svc-card__head">
                  <span class="svc-card__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-card__kicker">{s.stat} · {s.statLabel}</span>
                </header>
                <h3 class="svc-card__title">{s.nombre}</h3>
                <p class="svc-card__desc">{s.desc}</p>
                <ul class="svc-card__features">
                  {s.tags.map((t) => (
                    <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{t}</span></li>
                  ))}
                </ul>
                <footer class="svc-card__foot">
                  <div class="svc-card__figure">
                    <span class="svc-card__figure-val">{s.stat}</span>
                    <span class="svc-card__figure-lbl">{s.statLabel}</span>
                  </div>
                  <a href="/contacto" class="svc-card__cta">Pedir →</a>
                </footer>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    {/* DIFERENCIALES */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Por qué Albox</span>
            <h2 class="brutal-section-head__title">
              Centro del Valle,
              <em>puerta del mármol.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Tres mercados se cruzan en Albox: comercio comarcal, industria del
            mármol exportadora y comunidad británica residente. Tres oportunidades
            digitales bien diferenciadas.
          </p>
        </header>

        <ul class="svc-sectors">
          {diferenciales.map((d, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">★ {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{d.title}</h3>
              <p class="svc-sector__desc">{d.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Método</span>
            <h2 class="brutal-section-head__title">
              De cero a producción
              <em>en 2 semanas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases con entregables claros. Reunión en Albox, diseño,
            desarrollo con SEO técnico y lanzamiento con formación incluida.
          </p>
        </header>

        <ol class="svc-process">
          {proceso.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < proceso.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* TESTIMONIOS */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Voces de Albox</span>
            <h2 class="brutal-section-head__title">
              Negocios locales que
              <em>ya facturan más.</em>
            </h2>
          </div>
        </header>

        <figure class="svc-pull">
          <div class="svc-pull__marks" aria-hidden="true">“</div>
          <blockquote class="svc-pull__quote">{testimonios[0].texto}</blockquote>
          <figcaption class="svc-pull__cap">
            <span class="svc-pull__avatar">{testimonios[0].nombre[0]}</span>
            <div>
              <span class="svc-pull__name">{testimonios[0].nombre}</span>
              <span class="svc-pull__role">{testimonios[0].negocio}</span>
            </div>
          </figcaption>
        </figure>

        <ul class="svc-quotes">
          {testimonios.slice(1).map((t, i) => (
            <li class={`svc-quote svc-quote--${i}`}>
              <p>"{t.texto}"</p>
              <footer>
                <span class="svc-quote__avatar">{t.nombre[0]}</span>
                <div>
                  <span class="svc-quote__name">{t.nombre}</span>
                  <span class="svc-quote__role">{t.negocio}</span>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* FAQ */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Preguntas Albox</span>
            <h2 class="brutal-section-head__title">
              Lo que más
              <em>preguntan</em>
              en Albox.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Plazos, precios, hosting, mármol y bilingüe. Si no está aquí,
            escríbenos y respondemos en menos de 24h.
          </p>
        </header>

        <ol class="svc-faq">
          {faq.map((f, i) => (
            <li class="svc-faq__item">
              <details class="svc-faq__details" open={i === 0}>
                <summary class="svc-faq__sum">
                  <span class="svc-faq__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-faq__q">{f.q}</span>
                  <span class="svc-faq__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-faq__answer"><p>{f.a}</p></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* OTROS PUEBLOS DEL VALLE */}
    {pueblosValle.length > 0 && (
      <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 06 / Valle del Almanzora</span>
              <h2 class="brutal-section-head__title">
                También en el
                <em>Valle del Almanzora.</em>
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Otros municipios del Valle del Almanzora donde ya trabajamos.
              Si tu pueblo no está, escríbenos.
            </p>
          </header>

          <ul class="cobertura-grid" style="margin-top:2rem;">
            {pueblosValle.slice(0, 8).map((p, i) => (
              <li>
                <a href={`/diseno-web/${p.slug}/`} class={`cobertura-tile cobertura-tile--${i % 6}`}>
                  <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
                  <span class="cobertura-tile__name heading-display">{p.nombre}</span>
                  <span class="cobertura-tile__sub text-mono">{p.comarca}</span>
                  <span class="cobertura-tile__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="svc-final__title">
            ¿Empezamos tu web
            <em>en Albox?</em>
          </h2>
          <p class="svc-final__text">
            Cuéntanos qué necesitas — comercio, mármol, gestoría, hostelería,
            inmobiliaria — y te enviamos un presupuesto detallado en 24h.
            Reuniones presenciales en Albox y todo el Valle.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .pueblo-map-wrap { width: 100%; height: clamp(360px, 50vh, 520px); overflow: hidden; }
  .pueblo-map-wrap > * { width: 100%; height: 100%; }
</style>
