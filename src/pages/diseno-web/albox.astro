                    <line x1="26" y1="0" x2="26" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="42" y1="0" x2="42" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    {/* Postes */}
                    <line x1="-28" y1="6" x2="-28" y2="40" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="48" y1="6" x2="48" y2="40" stroke="#0E0D0B" stroke-width="2"/>
                    {/* Mesa */}
                    <rect x="-30" y="20" width="80" height="12" fill="#8B5A2B" stroke="#0E0D0B" stroke-width="1.5"/>
                    {/* Cajas de fruta */}
                    <rect x="-26" y="14" width="22" height="8" fill="#5F8B4C" stroke="#0E0D0B" stroke-width="1"/>
                    <circle cx="-21" cy="12" r="2" fill="#D9AF3A"/>
                    <circle cx="-17" cy="12" r="2" fill="#D9AF3A"/>
                    <circle cx="-13" cy="12" r="2" fill="#D9AF3A"/>
                    <rect x="0" y="14" width="22" height="8" fill="#B0241F" stroke="#0E0D0B" stroke-width="1"/>
                    <circle cx="5" cy="12" r="2" fill="#E96B2A"/>
                    <circle cx="11" cy="12" r="2" fill="#E96B2A"/>
                    <circle cx="17" cy="12" r="2" fill="#E96B2A"/>
                    <rect x="26" y="14" width="22" height="8" fill="#D9AF3A" stroke="#0E0D0B" stroke-width="1"/>
                    <circle cx="32" cy="12" r="2" fill="#5F8B4C"/>
                    <circle cx="38" cy="12" r="2" fill="#5F8B4C"/>
                    <circle cx="44" cy="12" r="2" fill="#5F8B4C"/>
                  </g>

                  {/* PUESTO 2 — Embutidos (toldo amarillo) */}
                  <g transform="translate(160, 105)">
                    <path d="M -30 0 L 50 0 L 50 6 L -30 6 Z" fill="#D9AF3A" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="-22" y1="0" x2="-22" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="-6" y1="0" x2="-6" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="10" y1="0" x2="10" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="26" y1="0" x2="26" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="42" y1="0" x2="42" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="-28" y1="6" x2="-28" y2="45" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="48" y1="6" x2="48" y2="45" stroke="#0E0D0B" stroke-width="2"/>
                    {/* Mesa */}
                    <rect x="-30" y="25" width="80" height="12" fill="#8B5A2B" stroke="#0E0D0B" stroke-width="1.5"/>
                    {/* Chorizos colgando */}
                    <line x1="-22" y1="6" x2="-22" y2="25" stroke="#0E0D0B" stroke-width="1.5"/>
                    <ellipse cx="-22" cy="18" rx="4" ry="9" fill="#B0241F" stroke="#0E0D0B" stroke-width="1"/>
                    <line x1="-6" y1="6" x2="-6" y2="25" stroke="#0E0D0B" stroke-width="1.5"/>
                    <ellipse cx="-6" cy="18" rx="4" ry="9" fill="#B0241F" stroke="#0E0D0B" stroke-width="1"/>
                    <line x1="10" y1="6" x2="10" y2="25" stroke="#0E0D0B" stroke-width="1.5"/>
                    <ellipse cx="10" cy="18" rx="4" ry="9" fill="#8B5A2B" stroke="#0E0D0B" stroke-width="1"/>
                    <line x1="26" y1="6" x2="26" y2="25" stroke="#0E0D0B" stroke-width="1.5"/>
                    <ellipse cx="26" cy="18" rx="4" ry="9" fill="#B0241F" stroke="#0E0D0B" stroke-width="1"/>
                  </g>

                  {/* PUESTO 3 — Ropa (toldo rojo) */}
                  <g transform="translate(270, 108)">
                    <path d="M -30 0 L 50 0 L 50 6 L -30 6 Z" fill="#B0241F" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="-22" y1="0" x2="-22" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="-6" y1="0" x2="-6" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="10" y1="0" x2="10" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="26" y1="0" x2="26" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="42" y1="0" x2="42" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="-28" y1="6" x2="-28" y2="42" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="48" y1="6" x2="48" y2="42" stroke="#0E0D0B" stroke-width="2"/>
                    {/* Perchas con ropa */}
                    <line x1="-30" y1="14" x2="50" y2="14" stroke="#0E0D0B" stroke-width="1.5"/>
                    <g fill="#1F3A6E" stroke="#0E0D0B" stroke-width="1">
                      <path d="M -22 16 L -22 32 L -14 32 L -14 16 L -16 14 L -20 14 Z"/>
                    </g>
                    <g fill="#5F8B4C" stroke="#0E0D0B" stroke-width="1">
                      <path d="M -8 16 L -8 32 L 0 32 L 0 16 L -2 14 L -6 14 Z"/>
                    </g>
                    <g fill="#D9AF3A" stroke="#0E0D0B" stroke-width="1">
                      <path d="M 6 16 L 6 32 L 14 32 L 14 16 L 12 14 L 8 14 Z"/>
                    </g>
                    <g fill="#E96B2A" stroke="#0E0D0B" stroke-width="1">
                      <path d="M 20 16 L 20 32 L 28 32 L 28 16 L 26 14 L 22 14 Z"/>
                    </g>
                    <g fill="#B0241F" stroke="#0E0D0B" stroke-width="1">
                      <path d="M 34 16 L 34 32 L 42 32 L 42 16 L 40 14 L 36 14 Z"/>
