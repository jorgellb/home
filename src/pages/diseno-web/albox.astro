<style>
  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · ALBOX · MERCADO DEL VALLE                      */
  /* ═══════════════════════════════════════════════════════ */
  .ab {
    --ab-paper:    #F8F4EC;          /* mármol blanco */
    --ab-paper-2:  #F0E8D3;
    --ab-marble:   #EAE0CA;          /* veta */
    --ab-marble-d: #D5C9B6;
    --ab-ink:      #0E0D0B;
    --ab-naranja:  #E96B2A;          /* toldos naranja */
    --ab-naranja-d:#A04317;
    --ab-verde:    #5F8B4C;          /* vega + toldos verdes */
    --ab-verde-d:  #43631F;
    --ab-rojo:     #B0241F;          /* toldos rojos */
    --ab-azul:     #1F3A6E;          /* UK + toldos azules */
    --ab-mostaza:  #D9AF3A;          /* toldos amarillos */
    --ab-tierra:   #8B5A2B;          /* mesa madera */
    --ab-lima:     #D6FF44;
    --ab-shadow:   8px 8px 0 var(--ab-ink);
  }
  .ab-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--ab-naranja);
    box-shadow: 0 0 0 0 rgba(233,107,42,0.55);
    animation: ab-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes ab-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(233,107,42,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(233,107,42,0); }
    100% { box-shadow: 0 0 0 0 rgba(233,107,42,0); }
  }
  .ab-spin { transform-origin: 50% 50%; animation: ab-spin 26s linear infinite; }
  @keyframes ab-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .ab-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(233,107,42,0.10), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(95,139,76,0.08), transparent 50%),
      var(--ab-paper);
    border-bottom: 3px solid var(--ab-ink);
    position: relative;
    overflow: hidden;
  }
  .ab-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(90deg, transparent 0 40px, rgba(213,201,182,0.15) 40px 41px);
    pointer-events: none;
  }
  .ab-hero > * { position: relative; }
  .ab-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .ab-hero__status { color: var(--ab-naranja); font-weight: 700; }

  .ab-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 1024px) { .ab-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .ab-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .ab-hero__chapter { color: var(--ab-naranja); }
  .ab-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .ab-hero__title em { color: var(--ab-naranja); font-style: italic; }
  .ab-hero__title-stamp {
    display: inline-block;
    color: var(--ab-paper);
    background: var(--ab-verde);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .ab-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 54ch;
  }
  .ab-hero__lead strong { color: var(--ab-ink); font-weight: 700; }
  .ab-hero__lead em { color: var(--ab-naranja); font-style: italic; font-weight: 600; }

  .ab-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }
  .ab-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--ab-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .ab-btn--primary {
    background: var(--ab-naranja); color: var(--ab-paper);
    box-shadow: 6px 6px 0 var(--ab-ink);
  }
  .ab-btn--primary:hover {
    background: var(--ab-verde);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ab-ink);
  }
  .ab-btn--ghost {
    background: transparent; color: var(--ab-ink);
    box-shadow: 6px 6px 0 var(--ab-naranja);
  }
  .ab-btn--ghost:hover {
    background: var(--ab-ink); color: var(--ab-mostaza);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ab-naranja);
  }

  /* KPIs */
  .ab-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--ab-ink);
    background: var(--ab-ink);
  }
  @media (min-width: 768px) { .ab-kpis { grid-template-columns: repeat(4, 1fr); } }
  .ab-kpi {
    background: var(--ab-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--ab-ink);
    border-bottom: 2px solid var(--ab-ink);
  }
  .ab-kpi:nth-child(2n) { border-right: none; }
  .ab-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .ab-kpi:nth-child(2n)      { border-right: 2px solid var(--ab-ink); }
    .ab-kpi:nth-child(4n)      { border-right: none; }
    .ab-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--ab-ink); }
    .ab-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .ab-kpi--naranja { background: var(--ab-naranja); color: var(--ab-paper); }
  .ab-kpi--verde   { background: var(--ab-verde); color: var(--ab-paper); }
  .ab-kpi--azul    { background: var(--ab-azul); color: var(--ab-paper); }
  .ab-kpi--ink     { background: var(--ab-ink); color: var(--ab-paper); }
  .ab-kpi--ink .ab-kpi__v { color: var(--ab-mostaza); }
  .ab-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .ab-kpi__v small { font-size: .55em; opacity: .8; }
  .ab-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .ab-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(14,13,11,0.18));
  }
  .ab-postcard {
    background: var(--ab-paper);
    border: 3px solid var(--ab-ink);
    box-shadow: var(--ab-shadow);
    overflow: hidden;
    transform: rotate(-1.5deg);
    transition: transform .35s;
  }
  .ab-postcard:hover { transform: rotate(0); }
  .ab-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--ab-naranja);
    color: var(--ab-paper);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--ab-ink);
  }
  .ab-postcard__profile {
    width: 100%;
    aspect-ratio: 540 / 220;
    border-bottom: 2px solid var(--ab-ink);
    overflow: hidden;
  }
  .ab-postcard__img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid var(--ab-ink);
  }
  .ab-postcard__img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(1.05);
    transition: transform .6s cubic-bezier(.16,1,.3,1);
  }
  .ab-postcard:hover .ab-postcard__img { transform: scale(1.05); }
  .ab-postcard__seal {
    position: absolute;
    top: 12px; right: 12px;
    width: 80px; height: 80px;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 10px rgba(233,107,42,0.5));
  }
  .ab-postcard__tag {
    position: absolute;
    bottom: 12px; left: 12px;
    background: var(--ab-mostaza);
    color: var(--ab-ink);
    padding: .4rem .75rem;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 2px solid var(--ab-ink);
    box-shadow: 3px 3px 0 var(--ab-naranja);
    transform: rotate(-2deg);
  }
  .ab-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--ab-paper-2);
    display: grid; gap: .35rem;
  }
  .ab-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
    font-size: .68rem;
  }
  .ab-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .ab-postcard__data-row > span:first-child { color: var(--ab-naranja-d); letter-spacing: .2em; font-weight: 800; }
  .ab-postcard__data-v { color: var(--ab-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .ab-marquee {
    background: var(--ab-verde);
    color: var(--ab-paper);
    overflow: hidden;
    padding: .9rem 0;
    border-top: 3px solid var(--ab-ink);
  }
  .ab-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: ab-marquee 36s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  @keyframes ab-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* MERCADO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .ab-mercado-section {
    background: var(--ab-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ab-ink);
  }
  .ab-mercado {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) { .ab-mercado { grid-template-columns: 1.4fr 1fr; gap: 3rem; } }

  /* Timeline */
  .ab-mercado__timeline {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column;
    border: 3px solid var(--ab-ink);
    background: var(--ab-paper);
    box-shadow: var(--ab-shadow);
  }
  .ab-mercado__step {
    display: grid;
    grid-template-columns: 90px 1fr;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1.5px dashed rgba(14,13,11,0.18);
    gap: 1rem;
    transition: background .25s;
  }
  .ab-mercado__step:last-child { border-bottom: none; }
  .ab-mercado__step:hover { background: var(--ab-paper-2); }
  .ab-mercado__step--0 { background: rgba(233,107,42,0.06); }
  .ab-mercado__step--2 { background: rgba(217,175,58,0.08); }
  .ab-mercado__step--4 { background: rgba(95,139,76,0.08); }
  .ab-mercado__hora {
    background: var(--ab-ink); color: var(--ab-mostaza);
    padding: .4rem .55rem;
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .12em;
    border: 2px solid var(--ab-ink);
    text-align: center;
  }
  .ab-mercado__body { display: flex; flex-direction: column; gap: 2px; }
  .ab-mercado__act {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--ab-ink);
    margin: 0;
  }
  .ab-mercado__desc { font-size: .85rem; line-height: 1.45; color: var(--brutal-text-secondary); margin: 0; }

  /* Puestos */
  .ab-mercado__puestos {
    background: var(--ab-ink);
    color: var(--ab-paper);
    padding: 1.75rem 1.5rem;
    border: 3px solid var(--ab-ink);
    box-shadow: 8px 8px 0 var(--ab-naranja);
    display: flex; flex-direction: column; gap: 1rem;
  }
  .ab-mercado__puestos-h {
    font-size: .7rem;
    letter-spacing: .25em;
    color: var(--ab-mostaza);
    font-weight: 800;
  }
  .ab-mercado__puestos-list {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .55rem;
  }
  .ab-puesto {
    display: flex; align-items: center; gap: .55rem;
    padding: .55rem .7rem;
    background: rgba(248,244,236,0.06);
    border: 1.5px solid currentColor;
    transition: background .2s;
  }
  .ab-puesto:hover { background: rgba(248,244,236,0.14); }
  .ab-puesto--naranja { color: var(--ab-naranja); }
  .ab-puesto--verde   { color: var(--ab-verde); }
  .ab-puesto--azul    { color: var(--ab-azul); }
  .ab-puesto--rojo    { color: var(--ab-rojo); }
  .ab-puesto--mostaza { color: var(--ab-mostaza); }
  .ab-puesto__ic { font-size: 1.05rem; line-height: 1; }
  .ab-puesto__name { font-size: .82rem; color: var(--ab-paper); font-weight: 700; }

  .ab-mercado__note {
    padding: .85rem 1rem;
    background: var(--ab-mostaza);
    color: var(--ab-ink);
    font-size: .85rem;
    line-height: 1.45;
    border-left: 4px solid var(--ab-naranja);
  }
  .ab-mercado__note strong { color: var(--ab-naranja-d); }
  .ab-mercado__note em { color: var(--ab-rojo); font-style: italic; font-weight: 600; }

  /* ═══════════════════════════════════════════════════════ */
  /* MÁRMOL                                                  */
  /* ═══════════════════════════════════════════════════════ */
  .ab-marmol-section {
    background: var(--ab-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ab-ink);
    position: relative;
    overflow: hidden;
  }
  .ab-marmol-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(135deg, transparent 0 30px, rgba(213,201,182,0.18) 30px 31px);
    pointer-events: none;
  }
  .ab-marmol-section > * { position: relative; }
  .ab-marmol {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .ab-marmol { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }

  .ab-marmol-chapter { color: var(--ab-tierra); }
  .ab-marmol-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0;
  }
  .ab-marmol-title em { color: var(--ab-tierra); }
  .ab-marmol-lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 54ch;
  }
  .ab-marmol-lead strong { color: var(--ab-tierra); font-weight: 700; }

  .ab-marmol__features {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .85rem;
  }
  .ab-marmol__feat {
    display: grid;
    grid-template-columns: 36px 1fr;
    grid-template-rows: auto auto;
    gap: 0 .85rem;
    padding: 1rem 1.25rem;
    background: var(--ab-marble);
    border: 2px solid var(--ab-ink);
    box-shadow: 4px 4px 0 var(--ab-tierra);
  }
  .ab-marmol__feat-n {
    grid-row: 1 / span 2;
    align-self: center;
    background: var(--ab-tierra);
    color: var(--ab-paper);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-size: .85rem;
    font-weight: 800;
    border: 1.5px solid var(--ab-ink);
  }
  .ab-marmol__feat-t {
    grid-column: 2; grid-row: 1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -.015em;
    color: var(--ab-ink);
  }
  .ab-marmol__feat-d {
    grid-column: 2; grid-row: 2;
    font-size: .8rem;
    color: var(--brutal-text-secondary);
    margin-top: 2px;
  }

  .ab-marmol__r { max-width: 360px; margin: 0 auto; }

  /* ═══════════════════════════════════════════════════════ */
  /* HITOS                                                   */
  /* ═══════════════════════════════════════════════════════ */
  .ab-hitos-section {
    background: var(--ab-ink);
    color: var(--ab-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ab-ink);
    position: relative;
    overflow: hidden;
  }
  .ab-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(233,107,42,0.08) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .ab-hitos-section > * { position: relative; }
  .ab-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2.5px solid var(--ab-paper);
  }
  @media (min-width: 640px)  { .ab-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ab-hitos { grid-template-columns: repeat(3, 1fr); } }
  .ab-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(248,244,236,0.25);
    border-right: 1px solid rgba(248,244,236,0.25);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(248,244,236,0.04);
    transition: background .25s;
  }
  .ab-hito:hover { background: rgba(233,107,42,0.15); }
  @media (min-width: 1024px) {
    .ab-hito:nth-child(3n) { border-right: none; }
    .ab-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .ab-hito:nth-child(2n) { border-right: none; }
    .ab-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .ab-hito { border-right: none; }
    .ab-hito:last-child { border-bottom: none; }
  }
  .ab-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--ab-mostaza); font-weight: 800; }
  .ab-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--ab-paper); line-height: 1.35; }

  /* ═══════════════════════════════════════════════════════ */
  /* SECTORES                                                */
  /* ═══════════════════════════════════════════════════════ */
  .ab-sec-section {
    background: var(--ab-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ab-ink);
  }
  .ab-sec {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .ab-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ab-sec { grid-template-columns: repeat(3, 1fr); } }
  .ab-sec__card {
    background: var(--ab-paper);
    border: 2.5px solid var(--ab-ink);
    box-shadow: var(--ab-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .ab-sec__card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .ab-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .ab-sec__card--naranja { color: var(--ab-naranja); }
  .ab-sec__card--marble  { color: var(--ab-tierra); }
  .ab-sec__card--azul    { color: var(--ab-azul); }
  .ab-sec__card--verde   { color: var(--ab-verde); }
  .ab-sec__card--mostaza { color: var(--ab-mostaza); }
  .ab-sec__card--rojo    { color: var(--ab-rojo); }

  .ab-sec__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
    gap: .5rem;
  }
  .ab-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .ab-sec__stat-box {
    background: var(--ab-ink); color: var(--ab-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .ab-sec__stat-v { font-size: .95rem; font-weight: 800; color: currentColor; line-height: 1; }
  .ab-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .ab-sec__title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    color: var(--ab-ink);
    margin: 0;
  }
  .ab-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; }
  .ab-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .ab-sec__tag {
    display: flex; align-items: flex-start; gap: .35rem;
    font-size: .78rem;
    line-height: 1.35;
    color: var(--ab-ink);
  }
  .ab-sec__tag span { color: currentColor; font-weight: 800; }
  .ab-sec__foot {
    padding-top: .65rem;
    border-top: 2px solid var(--ab-ink);
  }
  .ab-sec__cta {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* MAPA                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .ab-map-section {
    background: var(--ab-marble);
    border-bottom: 3px solid var(--ab-ink);
  }
  .ab-map-head { padding: 4rem 0 2rem; }
  .ab-map-head__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: end;
  }
  @media (min-width: 768px) { .ab-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .ab-map-chapter { color: var(--ab-naranja); }
  .ab-map-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 0;
  }
  .ab-map-title em { color: var(--ab-naranja); }
  .ab-map-coords {
    background: var(--ab-ink);
    color: var(--ab-mostaza);
    padding: 1rem 1.25rem;
    border: 2px solid var(--ab-naranja);
    box-shadow: 5px 5px 0 var(--ab-naranja);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem;
    letter-spacing: .15em;
  }
  .ab-map-frame {
    border-top: 3px solid var(--ab-ink);
    border-bottom: 3px solid var(--ab-ink);
    background: var(--ab-ink);
  }
  .ab-map-wrap > * { width: 100%; }

  /* ═══════════════════════════════════════════════════════ */
  /* DIFERENCIALES                                           */
  /* ═══════════════════════════════════════════════════════ */
  .ab-dif-section {
    background: var(--ab-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ab-ink);
  }
  .ab-dif {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--ab-ink);
  }
  @media (min-width: 768px) { .ab-dif { grid-template-columns: 1fr 1fr; } }
  .ab-dif__item {
    padding: 1.75rem 1.5rem;
    border-bottom: 1px solid var(--ab-ink);
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .2s;
  }
  @media (min-width: 768px) {
    .ab-dif__item:nth-child(odd) { border-right: 1px solid var(--ab-ink); }
    .ab-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) {
    .ab-dif__item:last-child { border-bottom: none; }
  }
  .ab-dif__item--0 { background: var(--ab-paper-2); }
  .ab-dif__item--1 { background: var(--ab-paper); }
  .ab-dif__item--2 { background: var(--ab-marble); }
  .ab-dif__item--3 { background: var(--ab-paper); }
  .ab-dif__item:hover { background: var(--ab-mostaza); }
  .ab-dif__num { font-size: .85rem; color: var(--ab-naranja); font-weight: 800; letter-spacing: .15em; }
  .ab-dif__t {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--ab-ink);
    margin: 0;
  }
  .ab-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* ═══════════════════════════════════════════════════════ */
  /* PROCESO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .ab-proc-section {
    background: var(--ab-ink);
    color: var(--ab-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ab-ink);
    position: relative;
    overflow: hidden;
  }
  .ab-proc-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(217,175,58,0.07) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .ab-proc-section > * { position: relative; }
  .ab-proc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px)  { .ab-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ab-proc { grid-template-columns: repeat(4, 1fr); } }
  .ab-proc__step {
    background: rgba(248,244,236,0.05);
    border: 2px solid var(--ab-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .ab-proc__step:hover { background: rgba(233,107,42,0.12); transform: translateY(-3px); }
  .ab-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(248,244,236,0.25); }
  .ab-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--ab-mostaza); line-height: 1; }
  .ab-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--ab-naranja); }
  .ab-proc__t {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--ab-paper);
    margin: .25rem 0 0;
  }
  .ab-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(248,244,236,0.75); flex: 1; }
  .ab-proc__foot {
    font-size: .58rem;
    letter-spacing: .2em;
    color: var(--ab-mostaza);
    font-weight: 800;
    padding-top: .5rem;
    border-top: 1.5px solid rgba(248,244,236,0.25);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .ab-quote-section {
    background: var(--ab-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ab-ink);
  }
  .ab-pull {
    position: relative;
    background: var(--ab-marble);
    border: 3px solid var(--ab-ink);
    box-shadow: var(--ab-shadow);
    padding: 3rem 2rem 2rem;
    margin: 2rem 0;
  }
  .ab-pull__seal {
    position: absolute;
    top: -30px; right: 30px;
    width: 90px; aspect-ratio: 1;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 8px rgba(233,107,42,0.4));
  }
  .ab-pull__q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.3;
    margin: 0 0 1.5rem;
    color: var(--ab-ink);
    max-width: 56ch;
  }
  .ab-pull__cap { display: flex; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 2px dashed var(--ab-ink); }
  .ab-pull__avatar {
    width: 48px; height: 48px;
    background: var(--ab-naranja); color: var(--ab-paper);
