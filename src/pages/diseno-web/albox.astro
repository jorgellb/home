  keywords="diseño web albox, creación de páginas web albox, hosting gratuito albox, diseñador web en albox, página web albox, tienda online albox, seo albox, agencia web valle del almanzora"
  jsonLd={jsonLdSchemas}
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="section-brutal flex items-center justify-center bg-brutal-bg border-b border-brutal-border">
      <div class="container-brutal py-24">
