                  <path d="M 0 110 L 80 95 L 160 105 L 240 90 L 320 100 L 400 88 L 480 100 L 540 95 L 540 130 L 0 130 Z" fill="#5F8B4C"/>

                  {/* Suelo plaza */}
                  <rect x="0" y="130" width="540" height="90" fill="#E8D9B0" stroke="#0E0D0B" stroke-width="2"/>
                  {/* Pavimento */}
                  <g stroke="#0E0D0B" stroke-width="0.6" opacity="0.3">
                    <line x1="0" y1="155" x2="540" y2="155"/>
                    <line x1="0" y1="180" x2="540" y2="180"/>
                    {Array.from({length: 9}).map((_, i) => (
                      <line x1={60*i} y1="130" x2={60*i} y2="220"/>
                    ))}
                  </g>

                  {/* PUESTO 1 — Frutas (toldo naranja) */}
                  <g transform="translate(50, 110)">
                    {/* Toldo a rayas */}
                    <path d="M -30 0 L 50 0 L 50 6 L -30 6 Z" fill="#E96B2A" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="-22" y1="0" x2="-22" y2="6" stroke="#FFFCF6" stroke-width="3"/>
                    <line x1="-6" y1="0" x2="-6" y2="6" stroke="#FFFCF6" stroke-width="3"/>
