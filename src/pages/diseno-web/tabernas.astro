    --tb-rose:     #8C3A5A;
    --tb-shadow:   8px 8px 0 var(--tb-ink);
  }

  .tb-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--tb-terracota);
