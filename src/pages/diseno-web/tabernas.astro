    animation: tb-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes tb-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(200,90,58,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(200,90,58,0); }
    100% { box-shadow: 0 0 0 0 rgba(200,90,58,0); }
  }
  .tb-pull__spin { transform-origin: 50% 50%; animation: tb-spin 22s linear infinite; }
  @keyframes tb-spin { to { transform: rotate(360deg); } }
  .tb-final-star { transform-origin: 50% 50%; animation: tb-pulse-star 3s ease-in-out infinite; }
  @keyframes tb-pulse-star {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.08); opacity: 0.85; }
  }

  /* HERO */
  .tb-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 75% 30%, rgba(200,90,58,0.10), transparent 50%),
      radial-gradient(circle at 25% 75%, rgba(212,161,74,0.08), transparent 50%),
      var(--tb-paper);
    border-bottom: 3px solid var(--tb-ink);
    position: relative;
    overflow: hidden;
  }
  .tb-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(45deg, transparent 0 22px, rgba(200,90,58,0.06) 22px 23px, transparent 23px 44px),
      linear-gradient(-45deg, transparent 0 22px, rgba(200,90,58,0.06) 22px 23px, transparent 23px 44px);
    pointer-events: none;
  }
  .tb-hero > * { position: relative; }
