<style>
  /* ═══════════════════════════════════════════════ */
  /* TABERNAS DESIGN SYSTEM                          */
  /* ═══════════════════════════════════════════════ */

  :root {
    --tb-paper:    #FFF5E6;
    --tb-paper-2:  #F0E2CC;
    --tb-sand:     #E3CDA4;
    --tb-ink:      #1C1512;
    --tb-terracota:#C85A3A;
    --tb-gold:     #D4A14A;
    --tb-sky:      #2C4C6B;
    --tb-sage:     #5A7A5A;
