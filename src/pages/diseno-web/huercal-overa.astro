                    <rect x="-78" y="24" width="22" height="16" fill="#FBF5E7"/>
                    <path d="M -72 32 Q -67 24 -62 32 L -62 40 L -72 40 Z" fill="#0E0D0B"/>
                    {/* Cúpula campanario */}
                    <path d="M -78 24 Q -67 8 -56 24 Z" fill="#7E2A3F"/>
                    {/* Cruz */}
                    <line x1="-67" y1="12" x2="-67" y2="0" stroke="#0E0D0B" stroke-width="2"/>
                    <line x1="-71" y1="4" x2="-63" y2="4" stroke="#0E0D0B" stroke-width="2"/>
                    {/* Reloj */}
                    <circle cx="-67" cy="60" r="6" fill="#FFCC44" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="-67" y1="60" x2="-67" y2="57" stroke="#0E0D0B" stroke-width="1"/>
                    <line x1="-67" y1="60" x2="-65" y2="62" stroke="#0E0D0B" stroke-width="1"/>
                    {/* Ventanas laterales */}
                    <rect x="-30" y="110" width="12" height="20" fill="#0E0D0B"/>
                    <rect x="18" y="110" width="12" height="20" fill="#0E0D0B"/>
                    <path d="M -30 110 Q -24 102 -18 110 L -18 130 L -30 130 Z" fill="#0E0D0B"/>
                    <path d="M 18 110 Q 24 102 30 110 L 30 130 L 18 130 Z" fill="#0E0D0B"/>
                  </g>

                  {/* Casas blancas a derecha */}
                  <g stroke="#0E0D0B" stroke-width="2">
                    <rect x="425" y="130" width="44" height="40" fill="#FBF5E7"/>
                    <path d="M 425 130 L 447 118 L 469 130 Z" fill="#7E2A3F"/>
                    <rect x="437" y="142" width="8" height="12" fill="#0E0D0B"/>
                    <rect x="453" y="142" width="8" height="12" fill="#0E0D0B"/>

                    <rect x="478" y="120" width="50" height="50" fill="#FBF5E7"/>
                    <path d="M 478 120 L 503 105 L 528 120 Z" fill="#7E2A3F"/>
                    <rect x="488" y="135" width="10" height="14" fill="#0E0D0B"/>
                    <rect x="508" y="135" width="10" height="14" fill="#0E0D0B"/>
                  </g>

                  {/* Persona pequeña en la plaza */}
                  <g transform="translate(220, 180)" fill="#0E0D0B">
                    <circle cx="0" cy="-4" r="2"/>
                    <line x1="0" y1="-2" x2="0" y2="6" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="-2" y1="6" x2="-2" y2="12" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="2" y1="6" x2="2" y2="12" stroke="#0E0D0B" stroke-width="1.5"/>
                  </g>
                  <g transform="translate(340, 182)" fill="#0E0D0B">
                    <circle cx="0" cy="-3" r="2"/>
                    <line x1="0" y1="-1" x2="0" y2="6" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="-2" y1="6" x2="-2" y2="10" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="2" y1="6" x2="2" y2="10" stroke="#0E0D0B" stroke-width="1.5"/>
                  </g>

                  {/* Pájaros */}
                  <g fill="none" stroke="#0E0D0B" stroke-width="1.2" stroke-linecap="round">
                    <path d="M 100 50 Q 105 46 110 50 Q 115 46 120 50"/>
                    <path d="M 410 40 Q 415 36 420 40 Q 425 36 430 40"/>
                  </g>
                </svg>
              </div>

              {/* Imagen real */}
              <div class="hu-postcard__img-wrap">
                <img
                  src="/imagenes/diseno-web-huercal-overa.jpg"
                  alt="Huércal-Overa, capital comarcal del Levante Almeriense"
                  width="640" height="320"
                  loading="eager"
                  decoding="async"
                  class="hu-postcard__img"
                />
                {/* Sello "TRIGO" centro comercial flotante */}
                <div class="hu-postcard__seal" aria-hidden="true">
                  <svg viewBox="0 0 80 80" width="100%" height="100%">
                    <defs>
                      <path id="hu-seal-arc" d="M40,40 m-33,0 a33,33 0 1,1 66,0 a33,33 0 1,1 -66,0"/>
                    </defs>
                    <circle cx="40" cy="40" r="38" fill="#D4A33D"/>
                    <circle cx="40" cy="40" r="33" fill="none" stroke="#0E0D0B" stroke-width="1.5" stroke-dasharray="2 1.5"/>
                    <g class="hu-spin">
                      <text font-family="monospace" font-size="7" font-weight="bold" fill="#0E0D0B" letter-spacing="2.5">
                        <textPath href="#hu-seal-arc" startOffset="0%">★ CAPITAL · COMARCAL · 04600 ★</textPath>
                      </text>
                    </g>
                    {/* Gavilla de trigo dentro */}
                    <g fill="none" stroke="#0E0D0B" stroke-width="2" stroke-linecap="round">
                      <line x1="40" y1="56" x2="40" y2="32"/>
                      <line x1="36" y1="52" x2="36" y2="36"/>
                      <line x1="44" y1="52" x2="44" y2="36"/>
                      <line x1="40" y1="32" x2="36" y2="28"/>
