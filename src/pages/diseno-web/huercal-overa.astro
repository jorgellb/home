<style>
  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · HUÉRCAL-OVERA · CAPITAL COMARCAL               */
  /* ═══════════════════════════════════════════════════════ */
  .hu {
    --hu-paper:    #FBF5E7;       /* cal pueblo */
    --hu-paper-2:  #F0E7CC;
    --hu-cream:    #E8D9B0;
    --hu-ink:      #0E0D0B;
    --hu-trigo:    #D4A33D;       /* trigo dorado */
    --hu-trigo-d:  #B08527;
    --hu-oliva:    #5C7A2C;       /* oliva campos */
    --hu-oliva-d:  #43591F;
    --hu-granate:  #7E2A3F;       /* vino granate */
    --hu-granate-d:#561C2A;
    --hu-tierra:   #A85D38;       /* arcilla */
    --hu-naranja:  #E8703F;       /* persimón */
    --hu-sun:      #FFCC44;
    --hu-lima:     #D6FF44;
    --hu-shadow:   8px 8px 0 var(--hu-ink);
  }

  .hu-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--hu-trigo);
    box-shadow: 0 0 0 0 rgba(212,163,61,0.55);
    animation: hu-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes hu-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(212,163,61,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(212,163,61,0); }
    100% { box-shadow: 0 0 0 0 rgba(212,163,61,0); }
  }
  .hu-spin { transform-origin: 50% 50%; animation: hu-spin 26s linear infinite; }
  @keyframes hu-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .hu-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(212,163,61,0.10), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(126,42,63,0.08), transparent 50%),
      var(--hu-paper);
    border-bottom: 3px solid var(--hu-ink);
    position: relative;
    overflow: hidden;
  }
  .hu-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(90deg, transparent 0 40px, rgba(168,93,56,0.03) 40px 41px);
    pointer-events: none;
  }
  .hu-hero > * { position: relative; }
  .hu-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .hu-hero__status { color: var(--hu-granate); font-weight: 700; }

  .hu-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 1024px) { .hu-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .hu-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .hu-hero__chapter { color: var(--hu-granate); }
  .hu-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .hu-hero__title em { color: var(--hu-granate); font-style: italic; }
  .hu-hero__title-stamp {
    display: inline-block;
    color: var(--hu-paper);
    background: var(--hu-oliva);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }

  .hu-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 54ch;
  }
  .hu-hero__lead strong { color: var(--hu-ink); font-weight: 700; }
  .hu-hero__lead em { color: var(--hu-granate); font-style: italic; font-weight: 600; }

  .hu-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }
  .hu-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--hu-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .hu-btn--primary {
    background: var(--hu-granate);
    color: var(--hu-paper);
    box-shadow: 6px 6px 0 var(--hu-ink);
  }
  .hu-btn--primary:hover {
    background: var(--hu-oliva);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--hu-ink);
  }
  .hu-btn--ghost {
    background: transparent;
    color: var(--hu-ink);
    box-shadow: 6px 6px 0 var(--hu-granate);
  }
  .hu-btn--ghost:hover {
    background: var(--hu-ink);
    color: var(--hu-trigo);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--hu-granate);
  }

  /* KPIs */
  .hu-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--hu-ink);
    background: var(--hu-ink);
  }
  @media (min-width: 768px) { .hu-kpis { grid-template-columns: repeat(4, 1fr); } }
  .hu-kpi {
    background: var(--hu-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--hu-ink);
    border-bottom: 2px solid var(--hu-ink);
  }
  .hu-kpi:nth-child(2n) { border-right: none; }
  .hu-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .hu-kpi:nth-child(2n)      { border-right: 2px solid var(--hu-ink); }
    .hu-kpi:nth-child(4n)      { border-right: none; }
    .hu-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--hu-ink); }
    .hu-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .hu-kpi--granate { background: var(--hu-granate); color: var(--hu-paper); }
  .hu-kpi--oliva   { background: var(--hu-oliva); color: var(--hu-paper); }
  .hu-kpi--trigo   { background: var(--hu-trigo); color: var(--hu-ink); }
  .hu-kpi--ink     { background: var(--hu-ink); color: var(--hu-paper); }
  .hu-kpi--ink .hu-kpi__v { color: var(--hu-sun); }
  .hu-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .hu-kpi__v small { font-size: .55em; opacity: .8; }
  .hu-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .hu-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(14,13,11,0.18));
  }
  .hu-postcard {
    background: var(--hu-paper);
    border: 3px solid var(--hu-ink);
    box-shadow: var(--hu-shadow);
    overflow: hidden;
    transform: rotate(-1.5deg);
    transition: transform .35s;
  }
  .hu-postcard:hover { transform: rotate(0); }
  .hu-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--hu-granate);
    color: var(--hu-paper);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--hu-ink);
  }
  .hu-postcard__profile {
    width: 100%;
    aspect-ratio: 540 / 220;
    border-bottom: 2px solid var(--hu-ink);
    overflow: hidden;
