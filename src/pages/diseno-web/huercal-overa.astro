                  {/* Líneas de baldosa */}
                  <g stroke="#0E0D0B" stroke-width="0.8" opacity="0.4">
                    <line x1="0" y1="180" x2="540" y2="180"/>
                    <line x1="0" y1="200" x2="540" y2="200"/>
                    {Array.from({length: 11}).map((_, i) => (
                      <line x1={50+i*50} y1="170" x2={50+i*50} y2="220"/>
                    ))}
                  </g>

                  {/* Casas blancas a izq */}
                  <g stroke="#0E0D0B" stroke-width="2">
                    <rect x="10" y="120" width="56" height="50" fill="#FBF5E7"/>
                    <path d="M 10 120 L 38 105 L 66 120 Z" fill="#7E2A3F"/>
                    <rect x="20" y="135" width="10" height="14" fill="#0E0D0B"/>
                    <rect x="40" y="135" width="10" height="14" fill="#0E0D0B"/>
                    <rect x="28" y="155" width="20" height="15" fill="#5C7A2C"/>

                    <rect x="70" y="130" width="44" height="40" fill="#FBF5E7"/>
                    <path d="M 70 130 L 92 118 L 114 130 Z" fill="#7E2A3F"/>
                    <rect x="80" y="142" width="8" height="12" fill="#0E0D0B"/>
                    <rect x="96" y="142" width="8" height="12" fill="#0E0D0B"/>
                  </g>

                  {/* IGLESIA DE LA ASUNCIÓN — centrada y prominente */}
                  <g transform="translate(270, 30)" stroke="#0E0D0B" stroke-width="2.5">
                    {/* Cuerpo principal */}
                    <rect x="-50" y="80" width="100" height="60" fill="#FBF5E7"/>
                    {/* Tejado a dos aguas */}
                    <path d="M -56 80 L 0 56 L 56 80 Z" fill="#7E2A3F"/>
                    {/* Puerta central */}
                    <path d="M -10 110 L -10 140 L 10 140 L 10 110 Q 10 105 0 105 Q -10 105 -10 110 Z" fill="#0E0D0B"/>
                    {/* Vidriera roseta */}
                    <circle cx="0" cy="92" r="6" fill="#D4A33D" stroke="#0E0D0B" stroke-width="1.5"/>
                    <line x1="0" y1="86" x2="0" y2="98" stroke="#0E0D0B" stroke-width="1"/>
                    <line x1="-6" y1="92" x2="6" y2="92" stroke="#0E0D0B" stroke-width="1"/>
                    {/* TORRE CAMPANARIO a la izquierda */}
                    <rect x="-78" y="40" width="22" height="100" fill="#FBF5E7"/>
                    <rect x="-78" y="40" width="22" height="100" fill="none"/>
                    <rect x="-72" y="56" width="10" height="14" fill="#0E0D0B"/>
                    <rect x="-72" y="78" width="10" height="14" fill="#0E0D0B"/>
