    keywords: ['Carta digital QR', 'Reservas online', 'Google Maps', 'Fotos profesionales']
  },
  {
    nombre: 'Construcción e inmobiliarias',
    desc: 'Portales inmobiliarios con buscador de propiedades, fichas detalladas con galería y captación de leads. Webs para constructoras, reformas y promociones inmobiliarias en el Levante Almeriense.',
    icon: 'building',
    stat: '+35%',
    statLabel: 'más leads cualificados',
