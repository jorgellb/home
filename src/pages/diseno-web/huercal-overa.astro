// ── Por qué Huércal-Overa necesita una web profesional ──
const diferenciales = [
  {
    title: 'Centro del Levante Almeriense',
    desc: 'Con 19.000 habitantes, Huércal-Overa es el núcleo de servicios y comercio de toda la comarca. Tu web no solo sirve a tu pueblo: sirve a Albox, Cuevas, Vera y toda la zona norte del Levante.',
    icon: 'map'
  },
  {
    title: 'Economía diversificada',
    desc: 'Agricultura, comercio, servicios profesionales, sanidad, construcción... Huércal-Overa tiene una economía real y variada. Cada sector necesita una web adaptada a su público y objetivos específicos.',
    icon: 'chart'
  },
  {
    title: 'Competencia digital creciente',
    desc: 'Cada vez más negocios de la zona tienen web. Los que no la tienen pierden clientes ante quienes sí aparecen en Google. Si te buscan y no te encuentran, el cliente se va a la competencia.',
    icon: 'trending'
  },
  {
    title: 'Conexión con toda la provincia',
    desc: 'Huércal-Overa conecta el Levante con el Valle del Almanzora y Lorca. Tu web puede atraer clientes de un radio mucho mayor que tu ubicación física, las 24 horas del día, los 365 días del año.',
