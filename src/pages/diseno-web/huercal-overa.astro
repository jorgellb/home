  /* ═══════════════════════════════════════════════════════ */
  /* HITOS                                                   */
  /* ═══════════════════════════════════════════════════════ */
  .hu-hitos-section {
    background: var(--hu-granate-d);
    color: var(--hu-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--hu-ink);
    position: relative;
    overflow: hidden;
  }
  .hu-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(212,163,61,0.07) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .hu-hitos-section > * { position: relative; }
  .hu-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2.5px solid var(--hu-paper);
  }
  @media (min-width: 640px)  { .hu-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .hu-hitos { grid-template-columns: repeat(3, 1fr); } }
  .hu-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(251,245,231,0.25);
    border-right: 1px solid rgba(251,245,231,0.25);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(251,245,231,0.04);
    transition: background .25s;
  }
  .hu-hito:hover { background: rgba(212,163,61,0.15); }
  @media (min-width: 1024px) {
    .hu-hito:nth-child(3n) { border-right: none; }
    .hu-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .hu-hito:nth-child(2n) { border-right: none; }
    .hu-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .hu-hito { border-right: none; }
    .hu-hito:last-child { border-bottom: none; }
  }
  .hu-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--hu-trigo); font-weight: 800; }
  .hu-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--hu-paper); line-height: 1.35; }

  /* ═══════════════════════════════════════════════════════ */
  /* SECTORES                                                */
  /* ═══════════════════════════════════════════════════════ */
  .hu-sec-section {
    background: var(--hu-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--hu-ink);
  }
  .hu-sec {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .hu-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .hu-sec { grid-template-columns: repeat(3, 1fr); } }
  .hu-sec__card {
    background: var(--hu-paper);
    border: 2.5px solid var(--hu-ink);
    box-shadow: var(--hu-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .hu-sec__card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .hu-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .hu-sec__card--granate { color: var(--hu-granate); }
  .hu-sec__card--oliva   { color: var(--hu-oliva); }
  .hu-sec__card--trigo   { color: var(--hu-trigo); }
  .hu-sec__card--tierra  { color: var(--hu-tierra); }
  .hu-sec__card--naranja { color: var(--hu-naranja); }
  .hu-sec__card--oliva-d { color: var(--hu-oliva-d); }

  .hu-sec__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
    gap: .5rem;
  }
  .hu-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .hu-sec__stat-box {
    background: var(--hu-ink); color: var(--hu-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .hu-sec__stat-v { font-size: .95rem; font-weight: 800; color: currentColor; line-height: 1; }
  .hu-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .hu-sec__title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    color: var(--hu-ink);
    margin: 0;
  }
  .hu-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; }
  .hu-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .hu-sec__tag {
    display: flex; align-items: flex-start; gap: .35rem;
    font-size: .78rem;
    line-height: 1.35;
    color: var(--hu-ink);
  }
  .hu-sec__tag span { color: currentColor; font-weight: 800; }
  .hu-sec__foot {
    padding-top: .65rem;
    border-top: 2px solid var(--hu-ink);
  }
  .hu-sec__cta {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* MAPA                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .hu-map-section {
    background: var(--hu-cream);
    border-bottom: 3px solid var(--hu-ink);
  }
  .hu-map-head { padding: 4rem 0 2rem; }
  .hu-map-head__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: end;
  }
  @media (min-width: 768px) { .hu-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .hu-map-chapter { color: var(--hu-granate); }
  .hu-map-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 0;
  }
  .hu-map-title em { color: var(--hu-granate); }
  .hu-map-coords {
    background: var(--hu-trigo);
    color: var(--hu-ink);
    padding: 1rem 1.25rem;
    border: 2px solid var(--hu-ink);
    box-shadow: 5px 5px 0 var(--hu-granate);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem;
    letter-spacing: .15em;
  }

  .hu-map-frame {
    position: relative;
    border-top: 3px solid var(--hu-ink);
    border-bottom: 3px solid var(--hu-ink);
    background: var(--hu-ink);
  }
  .hu-map-deco {
    position: absolute;
    width: 60px; height: 60px;
    z-index: 5;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(212,163,61,0.45));
  }
  .hu-map-deco--tl { top: 16px; left: 16px; }
  .hu-map-deco--br { bottom: 16px; right: 16px; }

  .hu-map-wrap {
    width: 100%;
    height: clamp(420px, 60vh, 600px);
    overflow: hidden;
  }
  .hu-map-wrap > * { width: 100%; height: 100%; }

  /* ═══════════════════════════════════════════════════════ */
  /* DIFERENCIALES                                           */
  /* ═══════════════════════════════════════════════════════ */
  .hu-dif-section {
    background: var(--hu-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--hu-ink);
  }
  .hu-dif {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--hu-ink);
  }
  @media (min-width: 768px) { .hu-dif { grid-template-columns: 1fr 1fr; } }
  .hu-dif__item {
    padding: 1.75rem 1.5rem;
    border-bottom: 1px solid var(--hu-ink);
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .2s;
  }
  @media (min-width: 768px) {
    .hu-dif__item:nth-child(odd) { border-right: 1px solid var(--hu-ink); }
    .hu-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) {
    .hu-dif__item:last-child { border-bottom: none; }
  }
  .hu-dif__item--0 { background: var(--hu-paper-2); }
  .hu-dif__item--1 { background: var(--hu-paper); }
  .hu-dif__item--2 { background: var(--hu-cream); }
  .hu-dif__item--3 { background: var(--hu-paper); }
  .hu-dif__item:hover { background: var(--hu-trigo); }
  .hu-dif__num { font-size: .85rem; color: var(--hu-granate); font-weight: 800; letter-spacing: .15em; }
  .hu-dif__t {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--hu-ink);
    margin: 0;
  }
  .hu-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* ═══════════════════════════════════════════════════════ */
  /* PROCESO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .hu-proc-section {
    background: var(--hu-ink);
    color: var(--hu-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--hu-ink);
    position: relative;
    overflow: hidden;
  }
  .hu-proc-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(212,163,61,0.06) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .hu-proc-section > * { position: relative; }
  .hu-proc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px)  { .hu-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .hu-proc { grid-template-columns: repeat(4, 1fr); } }
  .hu-proc__step {
    background: rgba(251,245,231,0.05);
    border: 2px solid var(--hu-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .hu-proc__step:hover { background: rgba(212,163,61,0.12); transform: translateY(-3px); }
  .hu-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(251,245,231,0.25); }
  .hu-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--hu-trigo); line-height: 1; }
  .hu-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--hu-naranja); }
  .hu-proc__t {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--hu-paper);
    margin: .25rem 0 0;
  }
  .hu-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(251,245,231,0.75); flex: 1; }
  .hu-proc__foot {
    font-size: .58rem;
    letter-spacing: .2em;
    color: var(--hu-trigo);
    font-weight: 800;
    padding-top: .5rem;
    border-top: 1.5px solid rgba(251,245,231,0.25);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .hu-quote-section {
    background: var(--hu-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--hu-ink);
  }
  .hu-pull {
    position: relative;
    background: var(--hu-cream);
    border: 3px solid var(--hu-ink);
    box-shadow: var(--hu-shadow);
    padding: 3rem 2rem 2rem;
    margin: 2rem 0;
  }
  .hu-pull__seal {
    position: absolute;
    top: -30px; right: 30px;
    width: 90px; aspect-ratio: 1;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 8px rgba(126,42,63,0.4));
  }
  .hu-pull__q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.3;
    margin: 0 0 1.5rem;
    color: var(--hu-ink);
    max-width: 56ch;
  }
  .hu-pull__cap { display: flex; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 2px dashed var(--hu-ink); }
  .hu-pull__avatar {
    width: 48px; height: 48px;
    background: var(--hu-granate); color: var(--hu-paper);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-size: 1.35rem; font-weight: 800;
    border-radius: 50%;
  }
  .hu-pull__cap div { display: flex; flex-direction: column; }
  .hu-pull__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--hu-ink); }
  .hu-pull__role { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; opacity: .65; text-transform: uppercase; }

  .hu-quotes {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .hu-quotes { grid-template-columns: repeat(3, 1fr); } }
  .hu-quote {
    position: relative;
    background: var(--hu-paper);
    border: 2px solid var(--hu-ink);
    box-shadow: 5px 5px 0 var(--hu-ink);
    padding: 1.75rem 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .hu-quote:hover { transform: translateY(-3px); }
  .hu-quote--0 { background: var(--hu-paper); }
  .hu-quote--1 { background: var(--hu-cream); }
  .hu-quote--2 { background: var(--hu-paper-2); }
  .hu-quote__mark {
    position: absolute;
    top: -8px; left: 14px;
    font-family: serif;
    font-size: 4rem;
    line-height: 1;
    color: var(--hu-granate);
    opacity: .45;
  }
  .hu-quote p { font-size: .92rem; line-height: 1.5; color: var(--hu-ink); flex: 1; margin: 0; }
  .hu-quote footer { display: flex; align-items: center; gap: .75rem; padding-top: .85rem; border-top: 1.5px dashed var(--hu-ink); }
  .hu-quote__avatar {
    width: 36px; height: 36px;
    background: var(--hu-oliva); color: var(--hu-paper);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hu-quote footer div { display: flex; flex-direction: column; }
  .hu-quote__name { font-family: var(--font-display); font-weight: 700; font-size: .9rem; }
  .hu-quote__role { font-family: var(--font-mono); font-size: .6rem; letter-spacing: .1em; opacity: .65; text-transform: uppercase; }

  /* ═══════════════════════════════════════════════════════ */
  /* FAQ                                                     */
  /* ═══════════════════════════════════════════════════════ */
  .hu-faq-section {
    background: var(--hu-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--hu-ink);
  }
  .hu-faq {
    list-style: none; padding: 0; margin: 2rem 0 0;
    border-top: 2.5px solid var(--hu-ink);
  }
  .hu-faq__item { border-bottom: 2px solid var(--hu-ink); }
  .hu-faq__det summary { list-style: none; cursor: pointer; }
  .hu-faq__det summary::-webkit-details-marker { display: none; }
  .hu-faq__sum {
    display: grid;
    grid-template-columns: 60px 1fr 40px;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem 0;
    transition: padding .2s, background .2s;
  }
  .hu-faq__sum:hover { padding-inline: 1rem; background: var(--hu-paper-2); }
  .hu-faq__num { font-size: 1rem; font-weight: 800; color: var(--hu-granate); letter-spacing: .1em; }
  .hu-faq__q {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.3;
    letter-spacing: -.015em;
    color: var(--hu-ink);
    font-weight: 700;
  }
  .hu-faq__toggle {
    width: 40px; height: 40px;
    border: 2px solid var(--hu-ink);
    background: var(--hu-paper);
    color: var(--hu-ink);
    display: flex; align-items: center; justify-content: center;
    transition: transform .3s, background .2s, color .2s;
  }
  .hu-faq__det[open] .hu-faq__toggle { transform: rotate(180deg); background: var(--hu-granate); color: var(--hu-paper); }
  .hu-faq__ans {
    padding: 0 0 1.5rem 76px;
    color: var(--brutal-text-secondary);
    font-size: .98rem;
    line-height: 1.55;
    max-width: 70ch;
  }
  @media (max-width: 640px) {
    .hu-faq__sum { grid-template-columns: 40px 1fr 32px; gap: .5rem; }
    .hu-faq__ans { padding-left: 48px; }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PUEBLOS VECINOS                                         */
  /* ═══════════════════════════════════════════════════════ */
  .hu-vecinos-section {
    background: var(--hu-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--hu-ink);
  }
  .hu-vecinos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--hu-ink);
    background: var(--hu-ink);
  }
  @media (min-width: 640px)  { .hu-vecinos { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  @media (min-width: 1024px) { .hu-vecinos { grid-template-columns: repeat(4, 1fr); } }
  .hu-vecino {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    gap: .35rem;
    padding: 1.5rem;
    background: var(--hu-paper);
    color: var(--hu-ink);
    text-decoration: none;
    min-height: 160px;
    transition: background .25s, color .25s;
    grid-template-areas: 'n arrow' 'name name' 'sub sub';
  }
  .hu-vecino__n { grid-area: n; font-size: .58rem; letter-spacing: .2em; opacity: .55; }
  .hu-vecino__name { grid-area: name; font-size: clamp(1.4rem, 2.5vw, 1.8rem); line-height: .95; letter-spacing: -.025em; }
  .hu-vecino__sub { grid-area: sub; font-size: .58rem; letter-spacing: .15em; opacity: .55; text-transform: uppercase; }
  .hu-vecino__arrow { grid-area: arrow; align-self: start; font-family: var(--font-mono); color: var(--hu-granate); font-size: 1.3rem; transition: transform .25s; }
  .hu-vecino:hover { background: var(--hu-granate); color: var(--hu-paper); }
  .hu-vecino:hover .hu-vecino__sub, .hu-vecino:hover .hu-vecino__n { opacity: .85; }
  .hu-vecino:hover .hu-vecino__arrow { color: var(--hu-paper); transform: translateX(4px); }
  .hu-vecino--1:hover { background: var(--hu-oliva); color: var(--hu-paper); }
  .hu-vecino--2:hover { background: var(--hu-tierra); color: var(--hu-paper); }
  .hu-vecino--3:hover { background: var(--hu-ink); color: var(--hu-trigo); }
  .hu-vecino--3:hover .hu-vecino__arrow { color: var(--hu-trigo); }

  /* ═══════════════════════════════════════════════════════ */
  /* CTA FINAL                                               */
  /* ═══════════════════════════════════════════════════════ */
  .hu-final {
    background: var(--hu-granate-d);
    color: var(--hu-paper);
    padding: 6rem 1.5rem 0;
    position: relative;
    overflow: hidden;
  }
  .hu-final::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(255,204,68,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .hu-final > * { position: relative; }
  .hu-final__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    padding-bottom: 4rem;
  }
  @media (min-width: 1024px) { .hu-final__grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .hu-final__chapter { color: var(--hu-sun); }
  .hu-final__title {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: .9;
    letter-spacing: -.045em;
    color: var(--hu-paper);
    margin: 1rem 0;
  }
  .hu-final__title em { color: var(--hu-trigo); font-style: italic; display: block; }
  .hu-final__lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(251,245,231,0.75);
    max-width: 52ch;
  }
  .hu-final__lead strong { color: var(--hu-sun); }
  .hu-final__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.75rem 0 1.5rem; }
  .hu-final__btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.15rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
  }
  .hu-final__btn--primary {
    background: var(--hu-trigo); color: var(--hu-ink); border-color: var(--hu-trigo);
    box-shadow: 6px 6px 0 var(--hu-sun);
