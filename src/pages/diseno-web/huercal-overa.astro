    icon: 'briefcase',
    stat: '#1',
    statLabel: 'en Google local',
    keywords: ['Web corporativa', 'Formularios inteligentes', 'SEO local', 'Blog de autoridad']
  },
  {
    nombre: 'Salud y bienestar',
    desc: 'Páginas web para clínicas dentales, fisioterapeutas, psicólogos, veterinarios y centros de estética. Sistema de citas online, cumplimiento RGPD sanitario y SEO para captar pacientes.',
    icon: 'health',
