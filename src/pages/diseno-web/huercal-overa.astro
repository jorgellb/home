const canonical = 'https://platanitorico.com/diseno-web/huercal-overa/';

// ── Sectores clave de Huércal-Overa ──
const sectores = [
  {
    nombre: 'Comercio y retail',
    desc: 'Huércal-Overa es el centro comercial del Levante Almeriense. Tiendas online para vender a toda España, catálogos digitales, gestión de stock y pasarela de pago segura. Extiende tu negocio más allá de la comarca.',
