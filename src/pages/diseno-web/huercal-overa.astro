---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import { getPueblosByComarca } from '../../data/pueblos-almeria';

const pueblosLevante = getPueblosByComarca('Levante Almeriense').filter(p => p.slug !== 'huercal-overa');

const title = 'Diseño Web en Huércal-Overa | Páginas Web, Tiendas Online y SEO Local';
const description = 'Agencia de diseño web en Huércal-Overa. Páginas web profesionales para comercios, empresas agrícolas, clínicas y servicios profesionales. Hosting gratuito para webs estáticas, tiendas online y SEO local. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/diseno-web/huercal-overa/';

const sectores = [
  { nombre: 'Comercio y retail',           stat: '19k', statLabel: 'habitantes', desc: 'Huércal-Overa es el centro comercial del Levante Almeriense. Tiendas online para vender a toda España, catálogos digitales, gestión de stock y pasarela segura.', tags: ['E-commerce','Catálogo digital','Pasarela de pago','Gestión de stock'] },
  { nombre: 'Agricultura y agroalimentación', stat: '+60%', statLabel: 'agro de la zona', desc: 'Webs para cooperativas, empresas hortofrutícolas y productores locales. Presenta tu producto, genera leads de distribuidores y exporta con una imagen profesional.', tags: ['Catálogo de productos','Fichas técnicas','Multiidioma exportación','Leads B2B'] },
  { nombre: 'Servicios profesionales',     stat: '#1',  statLabel: 'Google local', desc: 'Webs corporativas para abogados, gestorías, arquitectos, ingenieros y aseguradoras de Huércal-Overa. Diseño que transmite confianza con formularios cualificados.', tags: ['Web corporativa','Formularios inteligentes','SEO local','Blog de autoridad'] },
  { nombre: 'Salud y bienestar',           stat: '24/7', statLabel: 'citas online', desc: 'Páginas web para clínicas dentales, fisioterapeutas, psicólogos, veterinarios y centros de estética. Citas online, RGPD sanitario y SEO para captar pacientes.', tags: ['Citas online','RGPD sanitario','Ficha de servicios','SEO salud'] },
  { nombre: 'Hostelería y restauración',   stat: 'x2',  statLabel: 'reservas online', desc: 'Webs para restaurantes, bares y hoteles. Carta digital QR, sistema de reservas, integración Google Maps y SEO local para que te encuentren.', tags: ['Carta digital QR','Reservas online','Google Maps','Fotos profesionales'] },
  { nombre: 'Construcción e inmobiliarias', stat: '+35%', statLabel: 'leads cualificados', desc: 'Portales inmobiliarios con buscador, fichas detalladas y galería. Webs para constructoras, reformas y promociones inmobiliarias del Levante.', tags: ['Portal propiedades','Buscador avanzado','Galería inmersiva','Captación leads'] },
];

const diferenciales = [
  { title: 'Centro del Levante Almeriense', desc: 'Con 19.000 habitantes, Huércal-Overa es el núcleo de servicios y comercio de toda la comarca. Tu web no solo sirve a tu pueblo: sirve a Albox, Cuevas, Vera y toda la zona norte.' },
  { title: 'Economía diversificada',         desc: 'Agricultura, comercio, servicios profesionales, sanidad, construcción. Huércal-Overa tiene una economía real y variada. Cada sector necesita una web adaptada a su público.' },
  { title: 'Competencia digital creciente',  desc: 'Cada vez más negocios de la zona tienen web. Los que no la tienen pierden clientes. Si te buscan y no te encuentran, el cliente se va a la competencia.' },
  { title: 'Conexión con toda la provincia', desc: 'Huércal-Overa conecta el Levante con el Valle del Almanzora y Lorca. Tu web puede atraer clientes en un radio mucho mayor que tu ubicación física.' },
];

const proceso = [
  { num: '01', title: 'Consulta y análisis',         eta: '1–2 días', body: 'Reunión en Huércal-Overa (presencial o videollamada). Análisis de negocio, competencia y mercado. Definimos objetivos y keywords.', deliverable: 'Briefing + keywords' },
  { num: '02', title: 'Diseño y prototipo',           eta: '3–5 días', body: 'Diseño visual: estructura, colores, tipografías y UX. Tú apruebas cada paso antes de avanzar.', deliverable: 'Prototipo Figma · approved' },
  { num: '03', title: 'Desarrollo + SEO técnico',     eta: '5–10 días', body: 'Programamos con Astro (ultrarrápido). SEO técnico integrado, datos estructurados y Core Web Vitals optimizados desde el código.', deliverable: 'Web en staging + auditoría' },
  { num: '04', title: 'Lanzamiento + formación',      eta: '1–2 días', body: 'Publicamos con hosting gratuito (webs estáticas). Google Business, Search Console y formación de gestión.', deliverable: 'Sitio en producción + manual' },
];

const testimonios = [
  { nombre: 'Antonio M.',         negocio: 'Gestoría · Huércal-Overa',         texto: 'Teníamos una web antigua que no nos traía clientes. Nos hicieron una nueva con SEO local y en dos meses estábamos en la primera página de Google para "gestoría Huércal-Overa". Las consultas se han triplicado.' },
  { nombre: 'Carmen L.',          negocio: 'Cooperativa agrícola · H-O',       texto: 'Nuestra cooperativa necesitaba una web profesional para presentar productos a distribuidores europeos. Fichas de producto, multiidioma y formulario de contacto cualificado. Impecable.' },
  { nombre: 'Dr. Francisco R.',   negocio: 'Clínica dental · Huércal-Overa',  texto: 'Abrí mi clínica y necesitaba sistema de citas online. Me la montaron en tiempo récord. Ahora más del 40% de las citas nuevas vienen por la web.' },
  { nombre: 'María José P.',      negocio: 'Tienda de moda · Huércal-Overa',   texto: 'Mi tienda en el centro llevaba años sin presencia online. Ahora vendo a toda España y el coste de hosting es cero. No me lo podía creer al principio.' },
];

const faq = [
  { q: '¿Cuánto cuesta una página web profesional en Huércal-Overa?', a: 'Web corporativa desde 450€. Incluye diseño personalizado, SEO técnico, hosting gratuito de por vida (para webs estáticas) y formación. Tiendas online: 900€–2.500€ según funcionalidades. Presupuesto cerrado sin sorpresas.' },
  { q: '¿Por qué el hosting es gratuito en vuestras webs?', a: 'Generación estática con Astro: webs ultrarrápidas servidas desde CDN global sin servidor ni base de datos. Netlify o Cloudflare Pages ofrecen hosting gratuito ilimitado. Ahorras 60–200€/año.' },
  { q: '¿Hacéis reuniones presenciales en Huércal-Overa?', a: 'Sí. Somos locales y trabajamos habitualmente en Huércal-Overa, Albox, Vera, Cuevas y toda la comarca. Podemos reunirnos en tu negocio o videollamada si prefieres.' },
  { q: '¿Cuánto tarda en estar lista la web?', a: 'Web corporativa: 1–2 semanas. Tienda online: 2–4 semanas según complejidad. Metodología ágil: ves avances desde la primera semana y participas en cada decisión de diseño.' },
  { q: '¿Mi web aparecerá en Google para búsquedas de Huércal-Overa?', a: 'Sí. SEO técnico desde el código: velocidad óptima, datos estructurados, meta etiquetas, sitemap y contenido optimizado para keywords locales como "abogado Huércal-Overa" o "clínica dental Huércal-Overa".' },
  { q: '¿Qué ventaja tiene una web estática frente a WordPress?', a: 'Carga <1s (vs 3–8s en WP), sin base de datos hackeable, sin actualizaciones de plugins, hosting gratuito y mejor rendimiento en Google. Para webs corporativas, portfolios y landings es la mejor opción.' },
  { q: '¿Puedo gestionar mi web yo mismo después?', a: 'Sí. Formación personalizada incluida. Para blog o catálogo integramos un CMS headless intuitivo. Soporte técnico siempre disponible.' },
  { q: '¿También hacéis tiendas online y marketing digital?', a: 'Sí. Además de diseño web: tiendas online con pasarela, marketing digital (SEO, Google Ads, redes), producción audiovisual con dron 4K y mantenimiento web desde 39€/mes.' },
];

const jsonLdSchemas = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Diseño Web","item":"https://platanitorico.com/diseno-web/"},{"@type":"ListItem","position":3,"name":"Huércal-Overa","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico - Diseño Web Huércal-Overa","url":canonical,"telephone":"+34657085019","priceRange":"€€","address":{"@type":"PostalAddress","addressLocality":"Huércal-Overa","addressRegion":"Almería","postalCode":"04600","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":37.3892,"longitude":-1.9437},"areaServed":["Huércal-Overa","Albox","Cuevas","Vera","Levante Almeriense"],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","reviewCount":"46","bestRating":"5"},"review":testimonios.map(t=>({"@type":"Review","author":{"@type":"Person","name":t.nombre},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":t.texto})) },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo creamos tu web en Huércal-Overa","step":proceso.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/diseno-web-huercal-overa.jpg"
  imageAlt="Diseño web en Huércal-Overa - Platanito Rico"
  type="service"
  keywords="diseño web huércal-overa, agencia web huércal-overa, tienda online huércal-overa, seo huércal-overa"
  jsonLd={jsonLdSchemas}
>
  <Header />

  <main id="main-content">
    {/* HERO */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 019 — Levante Almeriense · Centro comercial</span>
          <span class="text-meta"><span class="live-dot"></span> 19.000 habitantes · capital comarcal</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Diseño Web · Huércal-Overa</span>
            <h1 class="svc-hero__title">
              Diseño web en
              <em>Huércal-Overa,</em>
              <span class="text-stroke-ink">centro</span>
              del Levante.
            </h1>
            <p class="svc-hero__lead">
              <strong>19.000 habitantes</strong>, centro comercial y de servicios
              del Levante. Webs para comercio, agroalimentación, salud y servicios
              profesionales con SEO local que pone tu negocio en Google.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">Presupuesto en 24h →</a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">19k</span>
              <span class="svc-hero__spec-lbl">Habitantes</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">450€</span>
              <span class="svc-hero__spec-lbl">Desde · web pro</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">0€</span>
              <span class="svc-hero__spec-lbl">Hosting web estática</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">4.9★</span>
              <span class="svc-hero__spec-lbl">46 reseñas</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ HUÉRCAL-OVERA ★ LEVANTE NORTE ★ AGROALIMENTACIÓN ★ COMERCIO ★ SERVICIOS ★ SALUD ★</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section-brutal" style="padding:0;background:var(--brutal-bg-alt);border-bottom:2px solid var(--brutal-ink);">
      <div class="pueblo-map-wrap">
        <InteractiveMap center={[-1.9437, 37.3892]} zoom={13} pitch={25} bearing={-15} label="Huércal-Overa" />
      </div>
    </section>

    {/* SECTORES */}
    <section class="section-brutal" id="sectores">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 01 / Sectores Huércal-Overa</span>
            <h2 class="brutal-section-head__title">
              Para quién
              <em>diseñamos</em>
              en H-O.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Seis sectores con presencia fuerte en Huércal-Overa y comarca norte
            del Levante. Cada uno con estrategia SEO específica.
          </p>
        </header>

        <ol class="svc-bento">
          {sectores.map((s, i) => {
            const accents = ['accent', 'paper', 'lime', 'paper', 'ink', 'paper'];
            return (
              <li class={`svc-card svc-card--${accents[i]}`}>
                <header class="svc-card__head">
                  <span class="svc-card__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-card__kicker">{s.stat} · {s.statLabel}</span>
                </header>
                <h3 class="svc-card__title">{s.nombre}</h3>
                <p class="svc-card__desc">{s.desc}</p>
                <ul class="svc-card__features">
                  {s.tags.map((t) => (
                    <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{t}</span></li>
                  ))}
                </ul>
                <footer class="svc-card__foot">
                  <div class="svc-card__figure">
                    <span class="svc-card__figure-val">{s.stat}</span>
                    <span class="svc-card__figure-lbl">{s.statLabel}</span>
                  </div>
                  <a href="/contacto" class="svc-card__cta">Pedir →</a>
                </footer>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    {/* DIFERENCIALES */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Por qué Huércal-Overa</span>
            <h2 class="brutal-section-head__title">
              Centro
              <em>de toda</em>
              una comarca.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Huércal-Overa no sirve solo a su pueblo: sirve a toda la comarca
            norte del Levante y conecta con Lorca. Una web bien posicionada
            captura clientes en un radio enorme.
          </p>
        </header>

        <ul class="svc-sectors">
          {diferenciales.map((d, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">★ {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{d.title}</h3>
              <p class="svc-sector__desc">{d.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Método</span>
            <h2 class="brutal-section-head__title">
              De cero a producción
              <em>en 2 semanas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases con entregables claros. Desde la consulta inicial hasta
            el lanzamiento con Google Business Profile configurado.
          </p>
        </header>

        <ol class="svc-process">
          {proceso.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < proceso.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* TESTIMONIOS */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Voces de Huércal-Overa</span>
            <h2 class="brutal-section-head__title">
              Negocios locales que
              <em>ya facturan más.</em>
            </h2>
          </div>
        </header>

        <figure class="svc-pull">
          <div class="svc-pull__marks" aria-hidden="true">“</div>
          <blockquote class="svc-pull__quote">{testimonios[0].texto}</blockquote>
          <figcaption class="svc-pull__cap">
            <span class="svc-pull__avatar">{testimonios[0].nombre[0]}</span>
            <div>
              <span class="svc-pull__name">{testimonios[0].nombre}</span>
              <span class="svc-pull__role">{testimonios[0].negocio}</span>
            </div>
          </figcaption>
        </figure>

        <ul class="svc-quotes">
          {testimonios.slice(1).map((t, i) => (
            <li class={`svc-quote svc-quote--${i}`}>
              <p>"{t.texto}"</p>
              <footer>
                <span class="svc-quote__avatar">{t.nombre[0]}</span>
                <div>
                  <span class="svc-quote__name">{t.nombre}</span>
                  <span class="svc-quote__role">{t.negocio}</span>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* FAQ */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Preguntas H-O</span>
            <h2 class="brutal-section-head__title">
              Lo que más
              <em>preguntan</em>
              en Huércal-Overa.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Plazos, hosting, SEO local, plataformas. Si no está aquí, escríbenos
            y respondemos en menos de 24h.
          </p>
        </header>

        <ol class="svc-faq">
          {faq.map((f, i) => (
            <li class="svc-faq__item">
              <details class="svc-faq__details" open={i === 0}>
                <summary class="svc-faq__sum">
                  <span class="svc-faq__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-faq__q">{f.q}</span>
                  <span class="svc-faq__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-faq__answer"><p>{f.a}</p></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* OTROS PUEBLOS DEL LEVANTE */}
    {pueblosLevante.length > 0 && (
      <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 06 / Levante Almeriense</span>
              <h2 class="brutal-section-head__title">
                También en
                <em>el Levante.</em>
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Otros municipios del Levante donde ya trabajamos. Si tu pueblo
              no está, escríbenos.
            </p>
          </header>

          <ul class="cobertura-grid" style="margin-top:2rem;">
            {pueblosLevante.slice(0, 8).map((p, i) => (
              <li>
                <a href={`/diseno-web/${p.slug}/`} class={`cobertura-tile cobertura-tile--${i % 6}`}>
                  <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
                  <span class="cobertura-tile__name heading-display">{p.nombre}</span>
                  <span class="cobertura-tile__sub text-mono">{p.comarca}</span>
                  <span class="cobertura-tile__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="svc-final__title">
            ¿Empezamos tu web
            <em>en Huércal-Overa?</em>
          </h2>
          <p class="svc-final__text">
            Cuéntanos qué necesitas y te enviamos un presupuesto detallado en 24h.
            Reuniones presenciales en H-O, Albox o cualquier punto de la comarca.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .pueblo-map-wrap { width: 100%; height: clamp(360px, 50vh, 520px); overflow: hidden; }
  .pueblo-map-wrap > * { width: 100%; height: 100%; }
</style>
