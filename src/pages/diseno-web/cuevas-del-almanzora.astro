<style>
  /* ══════════════════════════════════════════════════════
     PALETA · CUEVAS DEL ALMANZORA · PATRIMONIO + MINERÍA
     ══════════════════════════════════════════════════════ */
  /* Fase 2 · consola. paper hacía de fondo y de tinta clara a la vez, e ink
     de borde, sombra, fondo y texto: cada uno se reparte. El #1A1410 original
     era demasiado buen fondo de tierra para perderlo, así que sobrevive como
     tierra-honda. Almagre, azul, plata, verdín, oro oscuro y oliva no
     llegaban a 4,5:1 sobre suelo y suben. Las ilustraciones no se tocan. */
  .cv {
    --cv-paper:       var(--color-cdm-panel);
    --cv-paper-2:     var(--color-cdm-panel-2);
    --cv-arena:       var(--color-cdm-panel-2);
    --cv-suelo:       var(--color-cdm-suelo);
    --cv-tinta:       var(--color-cdm-texto);
    --cv-tenue:       var(--color-cdm-tenue);
    --cv-ink:         var(--color-cdm-regla-2);
    --cv-tierra-honda:#1A1410;       /* Tierra oscura: solo fondo */
    --cv-almagra:     #E0654A;       /* Almagre, aclarado para leer */
    --cv-almagra-d:   #7E2E1C;       /* Almagre hondo: solo fondo */
    --cv-gold:        #C49A3F;       /* Oro sillería castillo */
    --cv-gold-d:      #B99239;       /* aclarado: era casi ilegible */
    --cv-silver:      #A6A6B4;       /* Plata-peltre, aclarada */
    --cv-verdigris:   #45AE99;       /* Verdín, aclarado */
    --cv-blue:        #3FA0C4;       /* Mar Villaricos, aclarado */
    --cv-olive:       #A89E56;       /* Valle del Almanzora, aclarado */
    --cv-shadow:      8px 8px 0 var(--color-cdm-regla-2);

    background: var(--cv-suelo);
    color: var(--cv-tinta);
  }

  /* Globales heredados, que venían en tinta oscura sobre papel. */
  .cv :global(.brutal-section-head__title) { color: var(--cv-tinta); }
  .cv :global(.brutal-section-head__lead) { color: var(--cv-tenue); }
  .cv :global(:where(.text-meta)) { color: var(--cv-tenue); } /* :where: sin especificidad, para que el color propio de cada capítulo mande */
  .cv :global(.divider-brutal) { background: var(--color-cdm-regla); }

  .cv section[id] { scroll-margin-top: 96px; }

  /* Los tres iconos van en postal: son line-art sobre transparente y sus
     trazos se perderían sobre el panel oscuro (§3.3.6). */
  .cv-icono__postal { max-width: 220px; margin: 0 auto; }
  .cv-icono--gold    .cv-icono__postal { color: #C49A3F; }
  .cv-icono--almagra .cv-icono__postal { color: #B5472E; }
  .cv-icono--blue    .cv-icono__postal { color: #1E6E8C; }

  /* El enlace al índice de municipios estaba suelto y con estilos inline,
     fuera de todo contenedor: se iba a sangre. */
  .cv-todos { background: var(--cv-suelo); padding: 2.5rem 1.5rem; text-align: center; }
  .cv-todos a { font-weight: 700; font-size: 1.05rem; color: var(--cv-gold); text-decoration: underline; text-underline-offset: 3px; }

  /* Raíl del índice: banda izquierda a partir de 1280 px, fuera de la caja
     de contenido; por debajo, solo la barra de progreso. */
  @media (min-width: 1280px) {
    .cv :global(.cdm-indice) {
      position: fixed;
      top: 96px;
      left: 0;
      width: 208px;
      padding-inline: clamp(1rem, 2vw, 1.75rem) 1rem;
      z-index: 30;
    }
    .cv :global(.container-brutal) { padding-left: calc(var(--container-gutter) + 208px); }
    .cv-marquee,
    .cv-map-frame,
    .cv-final__marquee { padding-left: 208px; }
  }
  @media (max-width: 1279px) {
    .cv :global(.cdm-indice) {
      display: block;
      position: sticky;
      top: 64px;
      z-index: 40;
      background: var(--cv-suelo);
      border-bottom: 1px solid var(--color-cdm-regla);
    }
    .cv :global(.cdm-indice__titulo),
    .cv :global(.cdm-indice__lista),
    .cv :global(.cdm-indice__coord) { display: none; }
    .cv :global(.cdm-indice__progreso) { height: 3px; background: transparent; }
  }
  .cv-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--cv-almagra);
    box-shadow: 0 0 0 0 rgba(181,71,46,0.55);
    animation: cv-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes cv-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(181,71,46,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(181,71,46,0); }
    100% { box-shadow: 0 0 0 0 rgba(181,71,46,0); }
  }
  .cv-spin { transform-origin: 50% 50%; animation: cv-spin 30s linear infinite; }
  @keyframes cv-spin { to { transform: rotate(360deg); } }
  .cv-smoke { stroke-dasharray: 4 6; animation: cv-smoke 3s linear infinite; }
  @keyframes cv-smoke { to { stroke-dashoffset: -40; } }

  /* HERO */
  .cv-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 18%, rgba(196,154,63,0.14), transparent 50%),
      radial-gradient(circle at 12% 82%, rgba(181,71,46,0.10), transparent 50%),
      var(--cv-suelo);
    border-bottom: 3px solid var(--cv-ink);
    position: relative;
    overflow: hidden;
  }
  .cv-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(125deg, transparent 0 38px, rgba(181,71,46,0.04) 38px 39px);
    pointer-events: none;
  }
  .cv-hero > * { position: relative; }
  .cv-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .cv-hero__status { color: var(--cv-almagra); font-weight: 700; }
  .cv-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .cv-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .cv-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .cv-hero__chapter { color: var(--cv-almagra); }
  .cv-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .cv-hero__title em { color: var(--cv-almagra); font-style: italic; }
  .cv-hero__title-stamp {
    display: inline-block;
    color: var(--cv-suelo);
    background: var(--cv-verdigris);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .cv-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--cv-tenue); max-width: 54ch; }
  .cv-hero__lead strong { color: var(--cv-tinta); font-weight: 700; }
  .cv-hero__lead em { color: var(--cv-almagra); font-style: italic; font-weight: 600; }
  .cv-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .cv-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--cv-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .cv-btn--primary { background: var(--cv-almagra); color: var(--cv-suelo); box-shadow: 6px 6px 0 var(--cv-ink); }
  .cv-btn--primary:hover { background: var(--cv-verdigris); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--cv-ink); }
  .cv-btn--ghost { background: transparent; color: var(--cv-tinta); box-shadow: 6px 6px 0 var(--cv-gold); }
  .cv-btn--ghost:hover { background: var(--cv-ink); color: var(--cv-gold); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--cv-gold); }

  /* KPIs */
  .cv-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--cv-ink);
    background: var(--cv-ink);
  }
  @media (min-width: 768px) { .cv-kpis { grid-template-columns: repeat(4, 1fr); } }
  .cv-kpi {
    background: var(--cv-paper); padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--cv-ink); border-bottom: 2px solid var(--cv-ink);
  }
  .cv-kpi:nth-child(2n) { border-right: none; }
  .cv-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .cv-kpi:nth-child(2n)      { border-right: 2px solid var(--cv-ink); }
    .cv-kpi:nth-child(4n)      { border-right: none; }
    .cv-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--cv-ink); }
    .cv-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .cv-kpi--gold    { background: var(--cv-gold); color: var(--cv-suelo); }
  .cv-kpi--almagra { background: var(--cv-almagra); color: var(--cv-suelo); }
  .cv-kpi--blue    { background: var(--cv-blue); color: var(--cv-suelo); }
  .cv-kpi--ink     { background: var(--cv-tierra-honda); color: var(--cv-tinta); }
  .cv-kpi--ink .cv-kpi__v { color: var(--cv-gold); }
  .cv-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .cv-kpi__v small { font-size: .55em; opacity: .8; }
  .cv-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .cv-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(26,20,16,0.22));
  }
  .cv-postcard {
    background: var(--cv-paper);
    border: 3px solid var(--cv-ink);
    box-shadow: var(--cv-shadow);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .35s;
  }
  .cv-postcard:hover { transform: rotate(0); }
  .cv-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--cv-almagra);
    color: var(--cv-suelo);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--cv-ink);
  }
  .cv-postcard__profile {
    width: 100%; aspect-ratio: 540 / 240;
    border-bottom: 2px solid var(--cv-ink);
    overflow: hidden;
  }
  .cv-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--cv-ink); }
  .cv-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.05) sepia(0.06); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .cv-postcard:hover .cv-postcard__img { transform: scale(1.05); }
  .cv-postcard__seal { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(-9deg); filter: drop-shadow(0 4px 10px rgba(181,71,46,0.5)); }
  .cv-postcard__tag {
    position: absolute; bottom: 12px; left: 12px;
    background: var(--cv-gold); color: var(--cv-suelo);
    padding: .4rem .75rem;
    font-size: .62rem; font-weight: 800; letter-spacing: .15em;
    border: 2px solid var(--cv-ink);
    box-shadow: 3px 3px 0 var(--cv-almagra);
    transform: rotate(-2deg);
  }
  .cv-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--cv-paper-2);
    display: grid; gap: .35rem;
  }
  .cv-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(230,237,242,0.16);
    font-size: .68rem;
  }
  .cv-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .cv-postcard__data-row > span:first-child { color: var(--cv-almagra); letter-spacing: .2em; font-weight: 800; }
  .cv-postcard__data-v { color: var(--cv-tinta); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .cv-marquee {
    background: var(--cv-almagra); color: var(--cv-suelo);
    overflow: hidden; padding: .9rem 0;
    border-top: 3px solid var(--cv-ink);
  }
  .cv-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: cv-marquee 42s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem; font-weight: 800;
    letter-spacing: .15em; text-transform: uppercase;
  }
  @keyframes cv-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* CASTILLO SECTION */
  .cv-castle-section {
    background: var(--cv-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--cv-ink);
    position: relative;
    overflow: hidden;
  }
  .cv-castle-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(196,154,63,0.07) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .cv-castle-section > * { position: relative; }
  .cv-castle-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .cv-castle-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .cv-castle-chapter { color: var(--cv-gold-d); }
  .cv-castle-title { font-size: clamp(2.25rem, 5vw, 3.6rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; }
  .cv-castle-title em { color: var(--cv-gold-d); }
  .cv-castle-lead { font-size: 1.05rem; line-height: 1.55; color: var(--cv-tenue); margin-bottom: 1.75rem; max-width: 56ch; }
  .cv-castle-lead strong { color: var(--cv-tinta); font-weight: 700; }
  .cv-castle-lead em { color: var(--cv-almagra); font-style: italic; }
  .cv-castle-facts { display: grid; grid-template-columns: 1fr; gap: 0; border: 2.5px solid var(--cv-ink); background: var(--cv-paper); box-shadow: 6px 6px 0 var(--cv-ink); margin-bottom: 1.5rem; }
  @media (min-width: 640px) { .cv-castle-facts { grid-template-columns: 1fr 1fr; } }
  .cv-castle-fact { padding: .85rem 1rem; border-bottom: 1px solid var(--cv-ink); display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 640px) {
    .cv-castle-fact:nth-child(odd) { border-right: 1px solid var(--cv-ink); }
    .cv-castle-fact:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .cv-castle-fact:last-child { border-bottom: none; } }
  .cv-castle-fact__k { font-size: .58rem; letter-spacing: .2em; color: var(--cv-almagra); font-weight: 800; }
  .cv-castle-fact__v { font-size: .88rem; color: var(--cv-tinta); font-weight: 600; line-height: 1.35; }
  .cv-castle-note { padding: 1rem 1.25rem; background: var(--cv-gold); color: var(--cv-suelo); border: 2px solid var(--cv-ink); font-size: .92rem; line-height: 1.5; }
  .cv-castle-note strong { color: var(--cv-suelo); }
  .cv-castle-r { max-width: 320px; margin: 0 auto; border: 3px solid var(--cv-ink); box-shadow: var(--cv-shadow); line-height: 0; background: #EFD9A0; }

  /* ICONOS */
  .cv-iconos-section { background: var(--cv-suelo); padding: 5rem 1.5rem; border-bottom: 3px solid var(--cv-ink); }
  .cv-iconos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 1024px) { .cv-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .cv-icono {
    position: relative;
    background: var(--cv-paper);
    border: 3px solid var(--cv-ink);
    box-shadow: var(--cv-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .cv-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .cv-icono--gold    { color: var(--cv-gold); }
  .cv-icono--almagra { color: var(--cv-almagra); }
  .cv-icono--blue    { color: var(--cv-blue); }
  .cv-icono__code {
    position: absolute; top: -16px; right: 20px;
    background: var(--cv-ink); color: var(--cv-gold);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .cv-icono__svg { width: 100%; aspect-ratio: 1; max-width: 200px; margin: 0 auto; color: currentColor; }
  .cv-icono__name { font-size: clamp(1.4rem, 2.8vw, 1.8rem); line-height: 1; letter-spacing: -.025em; color: var(--cv-tinta); margin: .5rem 0 0; text-align: center; }
  .cv-icono__sub { font-size: .6rem; letter-spacing: .22em; color: currentColor; font-weight: 800; text-align: center; }
  .cv-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--cv-tenue); flex: 1; text-align: center; }
  .cv-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .cv-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* FIEBRE DE LA PLATA */
  .cv-plata-section { background: var(--cv-tierra-honda); color: var(--cv-tinta); padding: 5rem 1.5rem; border-bottom: 3px solid var(--cv-ink); position: relative; overflow: hidden; }
  .cv-plata-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(181,71,46,0.1) 1.3px, transparent 1.3px); background-size: 26px 26px; pointer-events: none; }
  .cv-plata-section > * { position: relative; }
  .cv-plata-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .cv-plata-grid { grid-template-columns: 1.25fr 1fr; gap: 4rem; } }
  .cv-plata-chapter { color: var(--cv-almagra); }
  .cv-plata-title { font-size: clamp(2.5rem, 6vw, 4.25rem); line-height: .92; letter-spacing: -.04em; margin: 1rem 0; color: var(--cv-tinta); }
  .cv-plata-title em { color: #C9C9D2; }
  .cv-plata-lead { font-size: 1.05rem; line-height: 1.55; color: rgba(241,235,223,0.8); margin-bottom: 1.75rem; max-width: 56ch; }
  .cv-plata-lead strong { color: var(--cv-tinta); font-weight: 700; }
  .cv-plata-lead em { color: var(--cv-almagra); font-style: italic; }
  .cv-plata-time { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0; border: 2px solid rgba(230,237,242,0.28); }
  .cv-plata-step { display: grid; grid-template-columns: 70px 1fr; gap: 1rem; padding: 1rem; border-bottom: 1px dashed rgba(241,235,223,0.25); align-items: start; }
  .cv-plata-step:last-child { border-bottom: none; }
  .cv-plata-step__y { font-size: 1rem; font-weight: 800; color: var(--cv-suelo); background: var(--cv-almagra); padding: .35rem .4rem; text-align: center; border: 1.5px solid rgba(230,237,242,0.28); align-self: start; }
  .cv-plata-step--1 .cv-plata-step__y { background: var(--cv-gold); }
  .cv-plata-step--2 .cv-plata-step__y { background: #C9C9D2; }
  .cv-plata-step__body { display: flex; flex-direction: column; gap: 2px; }
  .cv-plata-step__t { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--cv-tinta); }
  .cv-plata-step__d { font-size: .85rem; line-height: 1.45; color: rgba(241,235,223,0.7); }
  .cv-plata-vestigios { border: 2px solid rgba(230,237,242,0.28); background: rgba(241,235,223,0.04); }
  .cv-plata-vestigios__label { display: block; background: var(--cv-almagra); color: var(--cv-suelo); padding: .55rem 1rem; font-size: .62rem; letter-spacing: .2em; font-weight: 800; }
  .cv-plata-vestigios ul { list-style: none; margin: 0; padding: 0; }
  .cv-plata-vestigios li { display: grid; grid-template-columns: 110px 1fr; gap: .75rem; padding: .6rem 1rem; border-bottom: 1px dashed rgba(241,235,223,0.2); align-items: baseline; }
  .cv-plata-vestigios li:last-child { border-bottom: none; }
  .cv-plata-vestigios__k { font-size: .58rem; letter-spacing: .15em; color: var(--cv-gold); font-weight: 800; }
  .cv-plata-vestigios__v { font-size: .82rem; color: rgba(241,235,223,0.8); line-height: 1.35; }
  .cv-plata-r { max-width: 300px; margin: 0 auto; border: 3px solid rgba(230,237,242,0.28); box-shadow: 8px 8px 0 var(--cv-almagra); line-height: 0; }

  /* HITOS */
  .cv-hitos-section {
    background: var(--cv-almagra-d); color: var(--cv-tinta);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--cv-ink);
    position: relative; overflow: hidden;
  }
  .cv-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(196,154,63,0.1) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .cv-hitos-section > * { position: relative; }
  .cv-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2.5px solid rgba(230,237,242,0.25);
  }
  @media (min-width: 640px)  { .cv-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cv-hitos { grid-template-columns: repeat(3, 1fr); } }
  .cv-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(241,235,223,0.22);
    border-right: 1px solid rgba(241,235,223,0.22);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(241,235,223,0.04);
    transition: background .25s;
  }
  .cv-hito:hover { background: rgba(196,154,63,0.2); }
  @media (min-width: 1024px) {
    .cv-hito:nth-child(3n) { border-right: none; }
    .cv-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
