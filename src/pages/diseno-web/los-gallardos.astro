  .lg-hero__lead em { color: var(--lg-navy); font-style: italic; font-weight: 600; }
  .lg-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .lg-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
