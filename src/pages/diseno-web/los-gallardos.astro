  .lg-btn--primary { background: var(--lg-green); color: var(--lg-paper); box-shadow: 6px 6px 0 var(--lg-ink); }
  .lg-btn--primary:hover { background: var(--lg-navy); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--lg-ink); }
  .lg-btn--ghost { background: transparent; color: var(--lg-ink); box-shadow: 6px 6px 0 var(--lg-citrus); }
  .lg-btn--ghost:hover { background: var(--lg-ink); color: var(--lg-citrus); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--lg-citrus); }

  /* KPIs */
  .lg-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--lg-ink);
    background: var(--lg-ink);
  }
  @media (min-width: 768px) { .lg-kpis { grid-template-columns: repeat(4, 1fr); } }
  .lg-kpi {
    background: var(--lg-paper); padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--lg-ink); border-bottom: 2px solid var(--lg-ink);
  }
  .lg-kpi:nth-child(2n) { border-right: none; }
  .lg-kpi:nth-last-child(-n+2) { border-bottom: none; }
