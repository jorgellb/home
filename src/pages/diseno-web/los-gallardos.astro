    .lg-kpi:nth-child(2n)      { border-right: 2px solid var(--lg-ink); }
    .lg-kpi:nth-child(4n)      { border-right: none; }
    .lg-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--lg-ink); }
