    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(22,23,15,0.18);
    font-size: .68rem;
  }
  .lg-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .lg-postcard__data-row > span:first-child { color: var(--lg-green-d); letter-spacing: .2em; font-weight: 800; }
  .lg-postcard__data-v { color: var(--lg-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .lg-marquee {
    background: var(--lg-navy); color: var(--lg-paper);
    overflow: hidden; padding: .9rem 0;
    border-top: 3px solid var(--lg-ink);
  }
  .lg-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: lg-marquee 40s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem; font-weight: 800;
    letter-spacing: .15em; text-transform: uppercase;
  }
  @keyframes lg-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* GOLF SECTION */
  .lg-golf-section {
    background: var(--lg-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--lg-ink);
    position: relative;
    overflow: hidden;
  }
  .lg-golf-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(47,125,82,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .lg-golf-section > * { position: relative; }
  .lg-golf-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .lg-golf-grid { grid-template-columns: 1.25fr 1fr; gap: 4rem; } }
  .lg-golf-chapter { color: var(--lg-green); }
  .lg-golf-title { font-size: clamp(2.5rem, 6vw, 4.25rem); line-height: .92; letter-spacing: -.04em; margin: 1rem 0; }
  .lg-golf-title em { color: var(--lg-green); }
  .lg-golf-lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); margin-bottom: 1.75rem; max-width: 56ch; }
  .lg-golf-lead strong { color: var(--lg-ink); font-weight: 700; }
  .lg-golf-lead em { color: var(--lg-navy); font-style: italic; }
  .lg-golf-facts { display: grid; grid-template-columns: 1fr; gap: 0; border: 2.5px solid var(--lg-ink); background: var(--lg-paper); box-shadow: 6px 6px 0 var(--lg-ink); margin-bottom: 1.5rem; }
  @media (min-width: 640px) { .lg-golf-facts { grid-template-columns: 1fr 1fr; } }
  .lg-golf-fact { padding: .85rem 1rem; border-bottom: 1px solid var(--lg-ink); display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 640px) {
    .lg-golf-fact:nth-child(odd) { border-right: 1px solid var(--lg-ink); }
    .lg-golf-fact:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .lg-golf-fact:last-child { border-bottom: none; } }
  .lg-golf-fact__k { font-size: .58rem; letter-spacing: .2em; color: var(--lg-navy); font-weight: 800; }
  .lg-golf-fact__v { font-size: .88rem; color: var(--lg-ink); font-weight: 600; line-height: 1.35; }
  .lg-golf-note { padding: 1rem 1.25rem; background: var(--lg-green); color: var(--lg-paper); border: 2px solid var(--lg-ink); font-size: .92rem; line-height: 1.5; }
  .lg-golf-note strong { color: var(--lg-citrus); }
  .lg-golf-r { max-width: 320px; margin: 0 auto; border: 3px solid var(--lg-ink); box-shadow: var(--lg-shadow); line-height: 0; background: #9BD0E8; }

  /* ICONOS */
  .lg-iconos-section { background: var(--lg-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--lg-ink); }
  .lg-iconos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 1024px) { .lg-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .lg-icono {
    position: relative;
    background: var(--lg-paper);
    border: 3px solid var(--lg-ink);
    box-shadow: var(--lg-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .lg-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .lg-icono--green  { color: var(--lg-green); }
  .lg-icono--navy   { color: var(--lg-navy); }
  .lg-icono--citrus { color: var(--lg-citrus); }
  .lg-icono__code {
    position: absolute; top: -16px; right: 20px;
    background: var(--lg-ink); color: var(--lg-citrus);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .lg-icono__svg { width: 100%; aspect-ratio: 1; max-width: 200px; margin: 0 auto; color: currentColor; }
  .lg-icono__name { font-size: clamp(1.4rem, 2.8vw, 1.8rem); line-height: 1; letter-spacing: -.025em; color: var(--lg-ink); margin: .5rem 0 0; text-align: center; }
  .lg-icono__sub { font-size: .6rem; letter-spacing: .22em; color: currentColor; font-weight: 800; text-align: center; }
  .lg-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; text-align: center; }
  .lg-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .lg-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* BILINGÜE */
  .lg-bil-section { background: var(--lg-navy); color: var(--lg-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--lg-ink); position: relative; overflow: hidden; }
  .lg-bil-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(244,240,228,0.06) 1.3px, transparent 1.3px); background-size: 26px 26px; pointer-events: none; }
  .lg-bil-section > * { position: relative; }
  .lg-bil-head { max-width: 760px; margin-bottom: 2.5rem; }
  .lg-bil-chapter { color: var(--lg-citrus); }
  .lg-bil-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; color: var(--lg-paper); }
  .lg-bil-title em { color: var(--lg-citrus); }
  .lg-bil-lead { font-size: 1.1rem; line-height: 1.55; color: rgba(244,240,228,0.82); max-width: 60ch; }
  .lg-bil-lead strong { color: var(--lg-paper); font-weight: 700; }
  .lg-bil-lead em { color: var(--lg-citrus); font-style: italic; }
  .lg-bil-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .lg-bil-grid { grid-template-columns: 1fr 1fr; gap: 3rem; } }
  .lg-bil-list { display: flex; flex-direction: column; gap: 1rem; }
  .lg-bil-item { display: grid; grid-template-columns: 48px 1fr; gap: 1rem; align-items: start; background: rgba(244,240,228,0.05); border: 2px solid var(--lg-paper); padding: 1.1rem 1.25rem; transition: background .2s; }
  .lg-bil-item:hover { background: rgba(242,165,46,0.14); }
  .lg-bil-item__n { font-family: var(--font-mono); font-size: 1.2rem; font-weight: 800; color: var(--lg-citrus); }
  .lg-bil-item__t { font-size: 1.1rem; line-height: 1.05; letter-spacing: -.02em; color: var(--lg-paper); margin: 0 0 .35rem; }
  .lg-bil-item__d { font-size: .86rem; line-height: 1.5; color: rgba(244,240,228,0.72); margin: 0; }

  /* Browser mock */
  .lg-bil-mock { display: flex; flex-direction: column; align-items: center; gap: .85rem; }
  .lg-browser { width: 100%; max-width: 380px; background: var(--lg-paper); border: 3px solid var(--lg-ink); box-shadow: var(--lg-shadow); overflow: hidden; }
  .lg-browser__bar { display: flex; align-items: center; gap: .4rem; padding: .55rem .75rem; background: var(--lg-ink); }
  .lg-browser__dot { width: 9px; height: 9px; border-radius: 50%; background: #6b6b5e; }
  .lg-browser__dot:nth-child(1) { background: var(--lg-red); }
  .lg-browser__dot:nth-child(2) { background: var(--lg-citrus); }
  .lg-browser__dot:nth-child(3) { background: var(--lg-green-l); }
  .lg-browser__url { margin-left: .5rem; flex: 1; background: rgba(244,240,228,0.12); color: var(--lg-paper); font-size: .6rem; padding: .25rem .6rem; letter-spacing: .05em; }
  .lg-browser__toolbar { display: flex; justify-content: space-between; align-items: center; padding: .65rem .85rem; background: var(--lg-green-d); border-bottom: 2px solid var(--lg-ink); }
  .lg-browser__logo { font-size: .68rem; font-weight: 800; color: var(--lg-paper); letter-spacing: .1em; }
  .lg-browser__lang { display: inline-flex; border: 1.5px solid var(--lg-paper); }
  .lg-lang { font-family: var(--font-mono); font-size: .62rem; font-weight: 800; padding: .2rem .5rem; color: var(--lg-paper); }
  .lg-lang--on { background: var(--lg-citrus); color: var(--lg-ink); }
  .lg-browser__body { padding: 1rem; display: flex; flex-direction: column; gap: .75rem; }
  .lg-browser__h { font-size: .72rem; font-weight: 800; letter-spacing: .1em; color: var(--lg-green-d); }
  .lg-props { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
  .lg-prop { display: grid; grid-template-columns: 76px 1fr; gap: .65rem; align-items: center; border: 2px solid var(--lg-ink); background: var(--lg-paper-2); padding: .4rem; box-shadow: 3px 3px 0 var(--lg-ink); }
  .lg-prop__img { width: 76px; line-height: 0; border: 1.5px solid var(--lg-ink); }
  .lg-prop__info { display: flex; flex-direction: column; gap: 2px; }
  .lg-prop__t { font-family: var(--font-display); font-weight: 700; font-size: .82rem; color: var(--lg-ink); }
  .lg-prop__p { font-size: .68rem; font-weight: 800; color: var(--lg-navy); letter-spacing: .03em; }
  .lg-browser__cta { text-align: center; background: var(--lg-navy); color: var(--lg-paper); font-family: var(--font-display); font-weight: 800; font-size: .82rem; padding: .6rem; border: 2px solid var(--lg-ink); letter-spacing: .05em; }
  .lg-bil-mock__note { font-size: .62rem; letter-spacing: .2em; color: var(--lg-citrus); font-weight: 800; }

  /* HITOS */
  .lg-hitos-section {
    background: var(--lg-ink); color: var(--lg-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--lg-ink);
    position: relative; overflow: hidden;
  }
  .lg-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(47,125,82,0.1) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .lg-hitos-section > * { position: relative; }
  .lg-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2.5px solid var(--lg-paper);
  }
  @media (min-width: 640px)  { .lg-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .lg-hitos { grid-template-columns: repeat(3, 1fr); } }
  .lg-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(244,240,228,0.22);
    border-right: 1px solid rgba(244,240,228,0.22);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(244,240,228,0.03);
    transition: background .25s;
  }
  .lg-hito:hover { background: rgba(47,125,82,0.22); }
  @media (min-width: 1024px) {
    .lg-hito:nth-child(3n) { border-right: none; }
    .lg-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .lg-hito:nth-child(2n) { border-right: none; }
    .lg-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .lg-hito { border-right: none; } .lg-hito:last-child { border-bottom: none; } }
  .lg-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--lg-citrus); font-weight: 800; }
  .lg-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--lg-paper); line-height: 1.35; }

  /* SECTORES */
  .lg-sec-section { background: var(--lg-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--lg-ink); }
  .lg-sec { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px)  { .lg-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .lg-sec { grid-template-columns: repeat(3, 1fr); } }
  .lg-sec__card {
    background: var(--lg-paper);
    border: 2.5px solid var(--lg-ink);
    box-shadow: var(--lg-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
  }
  .lg-sec__card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: currentColor; }
  .lg-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .lg-sec__card--navy   { color: var(--lg-navy); }
  .lg-sec__card--green  { color: var(--lg-green); }
  .lg-sec__card--red    { color: var(--lg-red); }
  .lg-sec__card--citrus { color: var(--lg-citrus); }
  .lg-sec__card--lime   { color: var(--lg-green-l); }
  .lg-sec__card--sky    { color: var(--lg-sky); }
  .lg-sec__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; gap: .5rem; }
  .lg-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .lg-sec__stat-box {
    background: var(--lg-ink); color: var(--lg-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .lg-sec__stat-v { font-size: .9rem; font-weight: 800; color: currentColor; line-height: 1; }
  .lg-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .lg-sec__title { font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.1; letter-spacing: -.02em; color: var(--lg-ink); margin: 0; }
  .lg-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; }
  .lg-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .lg-sec__tag { display: flex; align-items: flex-start; gap: .35rem; font-size: .78rem; line-height: 1.35; color: var(--lg-ink); }
  .lg-sec__tag span { color: currentColor; font-weight: 800; }
  .lg-sec__foot { padding-top: .65rem; border-top: 2px solid var(--lg-ink); }
  .lg-sec__cta { font-family: var(--font-mono); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .15em; color: currentColor; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px; }

  /* MAPA */
  .lg-map-section { background: var(--lg-arena); border-bottom: 3px solid var(--lg-ink); }
  .lg-map-head { padding: 4rem 0 2rem; }
  .lg-map-head__inner { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; }
  @media (min-width: 768px) { .lg-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .lg-map-chapter { color: var(--lg-green-d); }
  .lg-map-title { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0 0; }
  .lg-map-title em { color: var(--lg-green-d); }
  .lg-map-coords {
    background: var(--lg-green); color: var(--lg-paper);
    padding: 1rem 1.25rem;
    border: 2px solid var(--lg-ink);
    box-shadow: 5px 5px 0 var(--lg-citrus);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem; letter-spacing: .15em;
  }
  .lg-map-frame { border-top: 3px solid var(--lg-ink); border-bottom: 3px solid var(--lg-ink); background: var(--lg-ink); }
  .lg-map-wrap > * { width: 100%; }

  /* DIFERENCIALES */
  .lg-dif-section { background: var(--lg-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--lg-ink); }
  .lg-dif { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 0; border: 2px solid var(--lg-ink); }
  @media (min-width: 768px) { .lg-dif { grid-template-columns: 1fr 1fr; } }
  .lg-dif__item { padding: 1.75rem 1.5rem; border-bottom: 1px solid var(--lg-ink); display: flex; flex-direction: column; gap: .65rem; transition: background .2s; }
  @media (min-width: 768px) {
    .lg-dif__item:nth-child(odd) { border-right: 1px solid var(--lg-ink); }
    .lg-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) { .lg-dif__item:last-child { border-bottom: none; } }
  .lg-dif__item--0 { background: var(--lg-paper-2); }
  .lg-dif__item--1 { background: var(--lg-paper); }
  .lg-dif__item--2 { background: var(--lg-arena); }
  .lg-dif__item--3 { background: var(--lg-paper); }
  .lg-dif__item:hover { background: var(--lg-citrus); }
  .lg-dif__num { font-size: .85rem; color: var(--lg-navy); font-weight: 800; letter-spacing: .15em; }
  .lg-dif__t { font-size: clamp(1.3rem, 2.2vw, 1.65rem); line-height: 1.05; letter-spacing: -.025em; color: var(--lg-ink); margin: 0; }
  .lg-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* PROCESO */
  .lg-proc-section { background: var(--lg-green-d); color: var(--lg-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--lg-ink); position: relative; overflow: hidden; }
  .lg-proc-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(242,165,46,0.09) 1.2px, transparent 1.2px); background-size: 22px 22px; pointer-events: none; }
  .lg-proc-section > * { position: relative; }
  .lg-proc { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 768px)  { .lg-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .lg-proc { grid-template-columns: repeat(4, 1fr); } }
  .lg-proc__step {
    background: rgba(244,240,228,0.06);
    border: 2px solid var(--lg-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .lg-proc__step:hover { background: rgba(242,165,46,0.16); transform: translateY(-3px); }
  .lg-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(244,240,228,0.25); }
  .lg-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--lg-citrus); line-height: 1; }
  .lg-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--lg-green-l); }
  .lg-proc__t { font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.05; letter-spacing: -.02em; color: var(--lg-paper); margin: .25rem 0 0; }
  .lg-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(244,240,228,0.75); flex: 1; }
  .lg-proc__foot { font-size: .58rem; letter-spacing: .2em; color: var(--lg-citrus); font-weight: 800; padding-top: .5rem; border-top: 1.5px solid rgba(244,240,228,0.25); }

  /* TESTIMONIOS */
  .lg-quote-section { background: var(--lg-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--lg-ink); }
  .lg-pull { position: relative; background: var(--lg-arena); border: 3px solid var(--lg-ink); box-shadow: var(--lg-shadow); padding: 3rem 2rem 2rem; margin: 2rem 0; }
  .lg-pull__seal { position: absolute; top: -30px; right: 30px; width: 90px; aspect-ratio: 1; transform: rotate(-9deg); filter: drop-shadow(0 4px 8px rgba(30,58,95,0.4)); }
  .lg-pull__q { font-family: var(--font-display); font-style: italic; font-size: clamp(1.35rem, 2.4vw, 2rem); line-height: 1.3; margin: 0 0 1.5rem; color: var(--lg-ink); max-width: 56ch; }
  .lg-pull__cap { display: flex; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 2px dashed var(--lg-ink); }
  .lg-pull__avatar { width: 48px; height: 48px; background: var(--lg-navy); color: var(--lg-paper); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; border-radius: 50%; }
  .lg-pull__cap div { display: flex; flex-direction: column; }
  .lg-pull__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--lg-ink); }
  .lg-pull__role { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; opacity: .65; text-transform: uppercase; }
