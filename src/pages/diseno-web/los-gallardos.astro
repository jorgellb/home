  .lg-kpi--navy   { background: var(--lg-navy); color: var(--lg-paper); }
  .lg-kpi--citrus { background: var(--lg-citrus); color: var(--lg-ink); }
  .lg-kpi--ink    { background: var(--lg-ink); color: var(--lg-paper); }
  .lg-kpi--ink .lg-kpi__v { color: var(--lg-citrus); }
