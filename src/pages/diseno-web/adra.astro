<style>
  /* ═══════════════════════════════════════════════ */
  /* ADRA DESIGN SYSTEM — puerto, sal y plástico      */
  /* ═══════════════════════════════════════════════ */

  /* Fase 2 · consola. La paleta estaba en :root, que Astro no scopea: se
     filtraba a todo el sitio. Pasa a .ad, que es el <main> de esta página.
     paper hacía de fondo y de tinta clara a la vez, e ink de borde, sombra,
     fondo y texto: cada uno se reparte. El mar y el verde no llegaban a
     4,5:1 sobre suelo y suben; el azul de madrugada se queda como fondo. */
  .ad {
    --ad-paper:     var(--color-cdm-panel);
    --ad-paper-2:   var(--color-cdm-panel-2);
    --ad-suelo:     var(--color-cdm-suelo);
    --ad-tinta:     var(--color-cdm-texto);
    --ad-tenue:     var(--color-cdm-tenue);
    --ad-ink:       var(--color-cdm-regla-2);
    --ad-sea:       #3FB4C9;      /* mar, aclarado para leer */
    --ad-sea-2:     #2E90A3;
    --ad-sea-hondo: #0B3A45;      /* mar hondo: solo fondo */
    --ad-deep:      #0E2A33;      /* madrugada en el puerto: solo fondo */
    --ad-accent:    #E2703A;
    --ad-sand:      #E0CFA8;
    --ad-green:     #5FB07E;      /* verde de albufera, aclarado */
    --ad-plastic:   #CBD8D5;
    --ad-shadow:    8px 8px 0 var(--color-cdm-regla-2);

    background: var(--ad-suelo);
    color: var(--ad-tinta);
  }

  /* Globales heredados, que venían en tinta oscura sobre papel. */
  .ad :global(.brutal-section-head__title) { color: var(--ad-tinta); }
  .ad :global(.brutal-section-head__title em) { color: var(--ad-sea); }
  .ad :global(.brutal-section-head__lead) { color: var(--ad-tenue); }
  .ad :global(:where(.text-meta)) { color: var(--ad-tenue); } /* :where: sin especificidad, para que el color propio de cada capítulo mande */
  .ad :global(.divider-brutal) { background: var(--color-cdm-regla); }

  .ad section[id] { scroll-margin-top: 96px; }

  /* Raíl del índice: banda izquierda a partir de 1280 px, fuera de la caja
     de contenido; por debajo, solo la barra de progreso. */
  @media (min-width: 1280px) {
    .ad :global(.cdm-indice) {
      position: fixed;
      top: 96px;
      left: 0;
      width: 208px;
      padding-inline: clamp(1rem, 2vw, 1.75rem) 1rem;
      z-index: 30;
    }
    .ad :global(.container-brutal) { padding-left: calc(var(--container-gutter) + 208px); }
  }
  @media (max-width: 1279px) {
    .ad :global(.cdm-indice) {
      display: block;
      position: sticky;
      top: 64px;
      z-index: 40;
      background: var(--ad-suelo);
      border-bottom: 1px solid var(--color-cdm-regla);
    }
    .ad :global(.cdm-indice__titulo),
    .ad :global(.cdm-indice__lista),
    .ad :global(.cdm-indice__coord) { display: none; }
    .ad :global(.cdm-indice__progreso) { height: 3px; background: transparent; }
  }

  .ad-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--ad-accent);
    box-shadow: 0 0 0 0 rgba(226,112,58,0.55);
    animation: ad-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes ad-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(226,112,58,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(226,112,58,0); }
    100% { box-shadow: 0 0 0 0 rgba(226,112,58,0); }
  }

  /* ── HERO ── */
  .ad-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 70% 25%, rgba(27,108,125,0.10), transparent 52%),
      radial-gradient(circle at 25% 75%, rgba(226,112,58,0.08), transparent 52%),
      var(--ad-suelo);
    border-bottom: 3px solid var(--ad-ink);
    position: relative;
    overflow: hidden;
  }
  .ad-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(0deg, transparent 0 26px, rgba(27,108,125,0.05) 26px 27px);
    pointer-events: none;
  }
  .ad-hero > * { position: relative; }
  .ad-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .ad-hero__status { color: var(--ad-sea); font-weight: 700; }
  .ad-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 2.5rem 0 4rem;
  }
  @media (min-width: 1024px) {
    .ad-hero__grid { grid-template-columns: 1.05fr .95fr; align-items: center; gap: 4rem; }
  }
  .ad-hero__chapter { color: var(--ad-accent); display: block; margin-bottom: .8rem; }
  .ad-hero__title { font-size: clamp(2.6rem, 6.5vw, 5rem); line-height: .95; margin: 0 0 1.5rem; }
  .ad-hero__title em { display: block; color: var(--ad-sea); }
  .ad-hero__title-stamp { display: block; }
  .ad-hero__lead { font-size: clamp(1rem, 1.6vw, 1.2rem); line-height: 1.65; max-width: 46ch; margin-bottom: 2rem; }
  .ad-hero__lead em { color: var(--ad-sea); font-style: italic; }
  .ad-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem; }

  .ad-hero__kpis { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 560px) { .ad-hero__kpis { grid-template-columns: repeat(4, 1fr); } }
  .ad-kpi {
    border: 2px solid var(--ad-ink);
    padding: .9rem .8rem;
    background: var(--ad-paper);
    box-shadow: 4px 4px 0 var(--ad-ink);
    display: flex; flex-direction: column; gap: .2rem;
  }
  .ad-kpi__v { font-size: 1.7rem; font-weight: 800; line-height: 1; }
  .ad-kpi__v small { font-size: .9rem; }
  .ad-kpi__l { font-size: .68rem; text-transform: uppercase; letter-spacing: .07em; opacity: .75; }
  .ad-kpi--sea .ad-kpi__v { color: var(--ad-sea); }
  .ad-kpi--accent .ad-kpi__v { color: var(--ad-accent); }
  .ad-kpi--green .ad-kpi__v { color: var(--ad-green); }
  .ad-kpi--ink .ad-kpi__v { color: var(--ad-tinta); }

  /* ── POSTAL ── */
  .ad-postcard {
    border: 3px solid var(--ad-ink);
    background: var(--ad-paper);
    box-shadow: var(--ad-shadow);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .4s cubic-bezier(.16,1,.3,1);
  }
  .ad-postcard:hover { transform: rotate(0deg) translateY(-4px); }
  .ad-postcard__head,
  .ad-postcard__foot {
    display: flex; justify-content: space-between; gap: .5rem;
    padding: .6rem .9rem;
    font-size: .62rem; letter-spacing: .08em;
    background: var(--ad-paper-2);
    border-bottom: 2px solid var(--ad-ink);
  }
  .ad-postcard__foot { border-bottom: none; border-top: 2px solid var(--ad-ink); justify-content: center; color: var(--ad-sea); font-weight: 700; }
  .ad-postcard__profile { aspect-ratio: 540 / 220; border-bottom: 2px solid var(--ad-ink); }
  .ad-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--ad-ink); }
  .ad-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.05); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .ad-postcard:hover .ad-postcard__img { transform: scale(1.05); }
  .ad-postcard__seal { position: absolute; top: 12px; right: 12px; width: 82px; height: 82px; transform: rotate(9deg); filter: drop-shadow(0 4px 10px rgba(27,108,125,0.5)); }

  /* ── BOTONES ── */
  .ad-btn {
    display: inline-flex; align-items: center; gap: .55rem;
    padding: .85rem 1.4rem;
    border: 2px solid var(--ad-ink);
    font-weight: 700; font-size: .92rem;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--ad-ink);
    transition: transform .2s, box-shadow .2s;
  }
  .ad-btn:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 var(--ad-ink); }
  .ad-btn:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--ad-ink); }
  .ad-btn--primary { background: var(--ad-sea); color: var(--ad-suelo); }
  .ad-btn--ghost { background: transparent; color: var(--ad-tinta); }
  .ad-btn--sand { background: var(--ad-sand); color: var(--ad-suelo); }
  .ad-btn--lg { padding: 1.05rem 1.9rem; font-size: 1.02rem; }

  /* ── HITOS ── */
  .ad-hitos-section { background: var(--ad-deep); padding: 1.6rem 0; }
  .ad-hitos { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem 1.6rem; list-style: none; padding: 0; margin: 0; }
  .ad-hito { display: flex; flex-direction: column; gap: .15rem; }
  .ad-hito__k { font-size: .62rem; letter-spacing: .12em; color: var(--ad-accent); }
  .ad-hito__v { font-size: .84rem; color: var(--ad-tinta); }

  /* ── ICONOS ── */
  .ad-ico-section { background: var(--ad-suelo); padding: 4.5rem 0; border-bottom: 3px solid var(--ad-ink); }
  .ad-chapter { color: var(--ad-accent); display: block; margin-bottom: .7rem; }
  .ad-ico { display: grid; grid-template-columns: 1fr; gap: 1.4rem; list-style: none; padding: 0; margin: 2.5rem 0 0; }
  @media (min-width: 768px) { .ad-ico { grid-template-columns: repeat(2, 1fr); } }
  .ad-ico__item {
    display: flex; gap: 1.1rem;
    border: 2px solid var(--ad-ink);
    background: var(--ad-paper);
    padding: 1.4rem;
    box-shadow: 6px 6px 0 var(--ad-ink);
    transition: transform .25s, box-shadow .25s;
  }
  .ad-ico__item:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--ad-ink); }
  .ad-ico__code {
    flex: none;
    width: 44px; height: 44px;
    display: grid; place-items: center;
    font-size: 1.2rem; font-weight: 800;
    border: 2px solid var(--ad-ink);
    color: var(--ad-suelo);
  }
  .ad-ico__item--sea     .ad-ico__code { background: var(--ad-sea); }
  .ad-ico__item--accent  .ad-ico__code { background: var(--ad-accent); }
  .ad-ico__item--green   .ad-ico__code { background: var(--ad-green); }
  .ad-ico__item--plastic .ad-ico__code { background: var(--ad-plastic); color: var(--ad-suelo); }
  .ad-ico__sub { font-size: .6rem; color: var(--ad-sea); }
  .ad-ico__name { font-size: 1.35rem; margin: .2rem 0 .5rem; line-height: 1.1; }
  .ad-ico__desc { font-size: .9rem; line-height: 1.6; margin: 0 0 .7rem; color: var(--ad-tenue); }
  .ad-ico__dato { font-size: .68rem; color: var(--ad-accent); font-weight: 700; }

  /* ── PUERTO ── */
  .ad-port-section { background: var(--ad-deep); padding: 5rem 0; border-bottom: 3px solid var(--ad-ink); }
  .ad-port__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; margin-top: 2.5rem; }
  @media (min-width: 1024px) { .ad-port__grid { grid-template-columns: 1.1fr .9fr; align-items: center; gap: 3.5rem; } }
  .ad-port__svg-wrap { border: 3px solid var(--ad-ink); box-shadow: var(--ad-shadow); overflow: hidden; aspect-ratio: 600 / 340; background: var(--ad-deep); }
  .ad-port__lead { font-size: 1.15rem; line-height: 1.6; color: var(--ad-sand); margin: 0 0 1.1rem; font-weight: 600; }
  .ad-port__lead em { font-style: italic; color: var(--ad-tinta); }
  .ad-port__text { font-size: .95rem; line-height: 1.7; color: rgba(242,239,230,0.82); margin: 0 0 1.3rem; }
  .ad-port__list { list-style: none; padding: 0; margin: 0 0 1.8rem; display: grid; gap: .6rem; }
  .ad-port__list li { font-size: .9rem; line-height: 1.55; color: rgba(242,239,230,0.9); padding-left: 1.4rem; position: relative; }
  .ad-port__list li::before { content: '▸'; position: absolute; left: 0; color: var(--ad-accent); font-weight: 800; }
  .ad-port__list strong { color: var(--ad-tinta); }

  /* ── ALBUFERAS ── */
  .ad-alb-section { background: var(--ad-paper-2); padding: 5rem 0; border-bottom: 3px solid var(--ad-ink); }
  .ad-alb__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  @media (min-width: 1024px) { .ad-alb__grid { grid-template-columns: .9fr 1.1fr; align-items: center; gap: 3.5rem; } }
  .ad-alb__title { font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1; margin: 0 0 1.2rem; }
  .ad-alb__title em { display: block; color: var(--ad-green); }
