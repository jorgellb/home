  .ol-pull { position: relative; background: var(--ol-paper); border: 3px solid var(--ol-ink); box-shadow: 8px 8px 0 var(--ol-gold); padding: 3rem 2rem 2rem; margin: 2.5rem 0 2rem; }
  .ol-pull::before { content: '"'; position: absolute; top: -20px; left: 24px; font-family: serif; font-size: 6rem; line-height: 1; color: var(--ol-gold); opacity: 0.3; pointer-events: none; }
  .ol-pull__seal { position: absolute; top: -30px; right: 30px; width: 90px; aspect-ratio: 1; transform: rotate(-10deg); filter: drop-shadow(0 4px 8px rgba(200,168,78,0.4)); z-index: 2; }
