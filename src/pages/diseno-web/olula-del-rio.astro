  .ol-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--ol-gold);
    box-shadow: 0 0 0 0 rgba(200,168,78,0.55);
    animation: ol-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes ol-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(200,168,78,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(200,168,78,0); }
    100% { box-shadow: 0 0 0 0 rgba(200,168,78,0); }
  }
  .ol-pull__spin { transform-origin: 50% 50%; animation: ol-spin 24s linear infinite; }
  @keyframes ol-spin { to { transform: rotate(360deg); } }
  .ol-final-gear { transform-origin: 50% 50%; animation: ol-gear-spin 20s linear infinite; }
  @keyframes ol-gear-spin { to { transform: rotate(360deg); } }
  .ol-export-svg .ol-export-gear { transform-origin: 50% 50%; animation: ol-gear-spin 18s linear infinite; }
  .ol-export-svg .ol-export-rings { transform-origin: 50% 50%; animation: ol-ring-spin 30s linear infinite; }
  @keyframes ol-ring-spin { to { transform: rotate(360deg); } }
  .ol-export-svg .ol-export-globe { transform-origin: 50% 50%; animation: ol-globe-float 8s ease-in-out infinite; }
  @keyframes ol-globe-float {
    0%, 100% { transform: translate(170px, 158px); }
    50% { transform: translate(170px, 154px); }
  }
  .ol-export-route { stroke-dashoffset: 100; animation: ol-dash 3s linear infinite; }
  @keyframes ol-dash { to { stroke-dashoffset: 0; } }
  .ol-export-dot { animation: ol-dot-pulse 2.4s ease-in-out infinite; }
  .ol-export-dot:nth-child(2) { animation-delay: .4s; }
  .ol-export-dot:nth-child(3) { animation-delay: .8s; }
  .ol-export-dot:nth-child(4) { animation-delay: 1.2s; }
  .ol-export-dot:nth-child(5) { animation-delay: 1.6s; }
  .ol-export-dot:nth-child(6) { animation-delay: 2s; }
  @keyframes ol-dot-pulse {
    0%, 100% { opacity: 0.4; r: 3; }
    50% { opacity: 0.8; r: 4; }
  }
  .ol-export-sparkle { animation: ol-sparkle 3s ease-in-out infinite; }
  @keyframes ol-sparkle {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.6; }
  }
  .ol-fs-glow { animation: ol-fs-glow 4s ease-in-out infinite; }
  @keyframes ol-fs-glow {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.5; }
  }
  .ol-final-sparkle { animation: ol-sparkle 2.5s ease-in-out infinite; }

