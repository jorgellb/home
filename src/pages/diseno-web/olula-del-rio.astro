  .ol-export-section::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--ol-navy), var(--ol-gold), var(--ol-navy)); pointer-events: none; }
  .ol-export-section > * { position: relative; }
  .ol-export-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .ol-export-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .ol-export-chapter { color: var(--ol-navy); }
