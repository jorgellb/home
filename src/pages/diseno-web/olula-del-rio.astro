  .ol-faq__toggle { width: 40px; height: 40px; border: 2px solid var(--ol-ink); background: var(--ol-paper); color: var(--ol-ink); display: flex; align-items: center; justify-content: center; transition: transform .3s, background .2s, color .2s; }
