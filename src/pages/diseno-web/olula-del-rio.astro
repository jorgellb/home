  /* KPIs */
  .ol-kpis { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; margin-top: 1.5rem; border: 2.5px solid var(--ol-ink); background: var(--ol-ink); }
