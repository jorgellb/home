  .ol-flagship-facts li { padding: .75rem 1rem; border-bottom: 1px solid var(--ol-ink); display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 640px) { .ol-flagship-facts li:nth-child(odd) { border-right: 1px solid var(--ol-ink); } .ol-flagship-facts li:nth-last-child(-n+2) { border-bottom: none; } }
  @media (max-width: 639px) { .ol-flagship-facts li:last-child { border-bottom: none; } }
  .ol-flagship-facts__k { font-size: .58rem; letter-spacing: .2em; color: var(--ol-navy); font-weight: 800; }
  .ol-flagship-facts__v { font-size: .9rem; color: var(--ol-ink); font-weight: 600; line-height: 1.35; }
