  @media (min-width: 768px)  { .ol-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ol-sec { grid-template-columns: repeat(3, 1fr); } }
  .ol-sec__card { background: var(--ol-paper); border: 2.5px solid var(--ol-ink); box-shadow: var(--ol-shadow); padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem; transition: transform .25s, box-shadow .25s; position: relative; overflow: hidden; }
