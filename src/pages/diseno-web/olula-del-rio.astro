  @media (min-width: 768px) { .ol-dif { grid-template-columns: 1fr 1fr; } }
  .ol-dif__item { padding: 1.75rem 1.5rem; border-bottom: 1px solid var(--ol-ink); display: flex; flex-direction: column; gap: .65rem; transition: background .2s; }
  @media (min-width: 768px) { .ol-dif__item:nth-child(odd) { border-right: 1px solid var(--ol-ink); } .ol-dif__item:nth-last-child(-n+2) { border-bottom: none; } }
