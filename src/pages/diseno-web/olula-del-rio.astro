  .ol-faq__ans { padding: 0 0 1.5rem 76px; color: var(--brutal-text-secondary); font-size: .98rem; line-height: 1.55; max-width: 70ch; }
  @media (max-width: 640px) { .ol-faq__sum { grid-template-columns: 40px 1fr 32px; gap: .5rem; } .ol-faq__ans { padding-left: 48px; } }

  /* PUEBLOS VECINOS */
  .ol-vecinos-section { background: var(--ol-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ol-ink); }
  .ol-vecinos-chapter { color: var(--ol-stone); }
