  .ol-quote__role { font-family: var(--font-mono); font-size: .6rem; letter-spacing: .1em; opacity: .65; text-transform: uppercase; }

  /* FAQ */
  .ol-faq-section { background: var(--ol-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ol-ink); }
  .ol-faq-chapter { color: var(--ol-stone); }
  .ol-faq-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; }
