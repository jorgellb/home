  .ol-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* PROCESO */
  .ol-proc-section { background: var(--ol-ink); color: var(--ol-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ol-ink); position: relative; overflow: hidden; }
  .ol-proc-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(200,168,78,0.08) 1.2px, transparent 1.2px); background-size: 22px 22px; pointer-events: none; }
  .ol-proc-section::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--ol-gold), var(--ol-navy), var(--ol-gold)); pointer-events: none; }
  .ol-proc-section > * { position: relative; }
  .ol-proc-chapter { color: var(--ol-gold); }
  .ol-proc-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; }
