  /* SECTORES */
  .ol-sec-section { background: var(--ol-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ol-ink); }
  .ol-sec-chapter { color: var(--ol-stone); }
  .ol-sec-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; }
