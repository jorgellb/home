  .ol-proc__step { background: rgba(245,240,232,0.05); border: 2px solid var(--ol-paper); padding: 1.5rem 1.25rem; display: flex; flex-direction: column; gap: .65rem; transition: background .25s, transform .25s, border-color .25s; position: relative; overflow: hidden; }
  .ol-proc__step::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 0; background: var(--ol-gold); transition: height .35s; }
  .ol-proc__step:hover { background: rgba(200,168,78,0.12); transform: translateY(-4px); border-color: var(--ol-gold); }
  .ol-proc__step:hover::before { height: 100%; }
  .ol-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(245,240,232,0.25); }
  .ol-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--ol-gold); line-height: 1; }
