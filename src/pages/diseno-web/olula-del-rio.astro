  /* MAPA */
  .ol-map-section { background: var(--ol-marble); border-bottom: 3px solid var(--ol-ink); }
  .ol-map-head { padding: 4rem 0 2rem; }
  .ol-map-head__inner { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; }
  @media (min-width: 768px) { .ol-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .ol-map-chapter { color: var(--ol-navy); }
