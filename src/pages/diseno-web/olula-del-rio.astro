  /* TESTIMONIOS */
  .ol-quote-section { background: var(--ol-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ol-ink); position: relative; }
  .ol-quote-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--ol-navy), var(--ol-gold), var(--ol-navy)); pointer-events: none; }
