  .ol-hero__postcard { width: 100%; max-width: 540px; margin: 0 auto; filter: drop-shadow(0 14px 30px rgba(26,24,22,0.18)); }
  .ol-postcard { background: var(--ol-paper); border: 3px solid var(--ol-ink); box-shadow: var(--ol-shadow); overflow: hidden; transform: rotate(-1deg); transition: transform .35s; }
  .ol-postcard:hover { transform: rotate(0); }
