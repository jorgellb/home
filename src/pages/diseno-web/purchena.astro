<style>
  /* ═══════════════════════════════════════════════ */
  /* PURCHENA DESIGN SYSTEM                           */
  /* ═══════════════════════════════════════════════ */

  :root {
    --pn-paper:    #F5F0E8;
    --pn-paper-2:  #E8E0D0;
    --pn-stone:    #8A9BA8;
    --pn-ink:      #1A1816;
    --pn-green:    #3A7A5A;
    --pn-green2:   #5A8B6A;
    --pn-accent:   #C84A2E;
    --pn-steel:    #6B7B8D;
    --pn-shadow:   8px 8px 0 var(--pn-ink);
  }

  .pn-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--pn-accent);
    box-shadow: 0 0 0 0 rgba(200,74,46,0.55);
    animation: pn-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes pn-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(200,74,46,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(200,74,46,0); }
    100% { box-shadow: 0 0 0 0 rgba(200,74,46,0); }
  }
  .pn-pull__spin { transform-origin: 50% 50%; animation: pn-spin 24s linear infinite; }
  @keyframes pn-spin { to { transform: rotate(360deg); } }
  .pn-final-gear { transform-origin: 50% 50%; animation: pn-gear-spin 20s linear infinite; }
  @keyframes pn-gear-spin { to { transform: rotate(360deg); } }
  .pn-pinon-svg .pn-pinon-gear { transform-origin: 50% 50%; animation: pn-gear-spin 18s linear infinite; }

  /* HERO */
  .pn-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 65% 30%, rgba(200,74,46,0.08), transparent 50%),
      radial-gradient(circle at 30% 70%, rgba(58,122,90,0.08), transparent 50%),
      var(--pn-paper);
    border-bottom: 3px solid var(--pn-ink);
    position: relative;
    overflow: hidden;
  }
  .pn-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(45deg, transparent 0 22px, rgba(200,74,46,0.05) 22px 23px, transparent 23px 44px),
      linear-gradient(-45deg, transparent 0 22px, rgba(200,74,46,0.05) 22px 23px, transparent 23px 44px);
    pointer-events: none;
  }
  .pn-hero > * { position: relative; }
  .pn-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .pn-hero__status { color: var(--pn-accent); font-weight: 700; }
  .pn-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .pn-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .pn-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .pn-hero__chapter { color: var(--pn-green); }
  .pn-hero__title { font-size: clamp(2.5rem, 7vw, 5rem); line-height: .92; letter-spacing: -.04em; margin: .25rem 0; }
  .pn-hero__title em { color: var(--pn-green); font-style: italic; }
  .pn-hero__title-stamp { display: inline-block; color: var(--pn-paper); background: var(--pn-accent); padding: 0 .2em; transform: rotate(-1deg); }
  .pn-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 54ch; }
  .pn-hero__lead strong { color: var(--pn-ink); font-weight: 700; }
  .pn-hero__lead em { color: var(--pn-accent); font-style: italic; font-weight: 600; }
  .pn-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .pn-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--pn-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .pn-btn--primary { background: var(--pn-accent); color: var(--pn-paper); box-shadow: 6px 6px 0 var(--pn-ink); }
  .pn-btn--primary:hover { background: var(--pn-green); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--pn-ink); }
  .pn-btn--ghost { background: transparent; color: var(--pn-ink); box-shadow: 6px 6px 0 var(--pn-steel); }
  .pn-btn--ghost:hover { background: var(--pn-ink); color: var(--pn-paper); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--pn-steel); }

  /* KPIs */
  .pn-kpis { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; margin-top: 1.5rem; border: 2.5px solid var(--pn-ink); background: var(--pn-ink); }
  @media (min-width: 768px) { .pn-kpis { grid-template-columns: repeat(4, 1fr); } }
  .pn-kpi { background: var(--pn-paper); padding: 1.25rem; display: flex; flex-direction: column; gap: .35rem; border-right: 2px solid var(--pn-ink); border-bottom: 2px solid var(--pn-ink); }
  .pn-kpi:nth-child(2n) { border-right: none; }
  .pn-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .pn-kpi:nth-child(2n)       { border-right: 2px solid var(--pn-ink); }
    .pn-kpi:nth-child(4n)       { border-right: none; }
    .pn-kpi:nth-last-child(-n+2)  { border-bottom: 2px solid var(--pn-ink); }
    .pn-kpi:nth-last-child(-n+4)  { border-bottom: none; }
  }
  .pn-kpi--green  { background: var(--pn-green); color: var(--pn-paper); }
  .pn-kpi--accent { background: var(--pn-accent); color: var(--pn-paper); }
  .pn-kpi--steel  { background: var(--pn-steel); color: var(--pn-paper); }
  .pn-kpi--ink    { background: var(--pn-ink); color: var(--pn-paper); }
  .pn-kpi--ink .pn-kpi__v { color: var(--pn-accent); }
  .pn-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .pn-kpi__v small { font-size: .55em; opacity: .8; }
  .pn-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .pn-hero__postcard { width: 100%; max-width: 540px; margin: 0 auto; filter: drop-shadow(0 14px 30px rgba(26,24,22,0.18)); }
  .pn-postcard { background: var(--pn-paper); border: 3px solid var(--pn-ink); box-shadow: var(--pn-shadow); overflow: hidden; transform: rotate(-1deg); transition: transform .35s; }
  .pn-postcard:hover { transform: rotate(0); }
  .pn-postcard__head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; padding: .65rem 1rem; background: var(--pn-ink); color: var(--pn-paper); font-size: .58rem; letter-spacing: .15em; border-bottom: 2px solid var(--pn-ink); }
  .pn-postcard__profile { width: 100%; aspect-ratio: 540 / 220; border-bottom: 2px solid var(--pn-ink); overflow: hidden; }
  .pn-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--pn-ink); }
  .pn-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.1); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .pn-postcard:hover .pn-postcard__img { transform: scale(1.05); }
  .pn-postcard__gear { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(10deg); filter: drop-shadow(0 4px 10px rgba(200,74,46,0.5)); }
  .pn-postcard__tag { position: absolute; bottom: 12px; left: 12px; background: var(--pn-paper); color: var(--pn-ink); padding: .4rem .75rem; font-size: .65rem; font-weight: 800; letter-spacing: .2em; border: 2px solid var(--pn-ink); box-shadow: 3px 3px 0 var(--pn-accent); transform: rotate(-2deg); }
  .pn-postcard__data { padding: 1rem 1.25rem; background: var(--pn-paper-2); display: grid; gap: .35rem; }
  .pn-postcard__data-row { display: flex; justify-content: space-between; align-items: center; padding-bottom: .35rem; border-bottom: 1px dashed rgba(26,24,22,0.15); font-size: .68rem; }
  .pn-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .pn-postcard__data-row > span:first-child { color: var(--pn-green); letter-spacing: .2em; font-weight: 800; }
  .pn-postcard__data-v { color: var(--pn-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .pn-marquee { background: var(--pn-ink); color: var(--pn-accent); overflow: hidden; padding: .9rem 0; border-top: 3px solid var(--pn-ink); }
  .pn-marquee__track { display: flex; gap: 3rem; width: max-content; animation: pn-marquee 42s linear infinite; font-family: var(--font-mono); font-size: .82rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  @keyframes pn-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ICONOS */
  .pn-iconos-section { background: var(--pn-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--pn-ink); position: relative; overflow: hidden; }
  .pn-iconos-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(200,74,46,0.04) 1.2px, transparent 1.2px); background-size: 24px 24px; pointer-events: none; }
  .pn-iconos-section > * { position: relative; }
  .pn-iconos-chapter { color: var(--pn-steel); }
  .pn-iconos-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; }
  .pn-iconos-title em { color: var(--pn-accent); }
  .pn-iconos { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 640px)  { .pn-iconos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .pn-iconos { grid-template-columns: repeat(4, 1fr); } }
  .pn-icono { display: flex; flex-direction: column; gap: .5rem; padding: 2rem 1.5rem; background: var(--pn-paper); border: 2.5px solid var(--pn-ink); box-shadow: var(--pn-shadow); align-items: center; text-align: center; transition: transform .25s, box-shadow .25s; }
  .pn-icono:hover { transform: translate(-4px, -4px); }
  .pn-icono--accent:hover  { box-shadow: 12px 12px 0 var(--pn-accent); }
  .pn-icono--green:hover   { box-shadow: 12px 12px 0 var(--pn-green); }
