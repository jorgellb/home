<style>
  /* ══════════════════════════════════════════════════════
     PALETA · SAN JUAN DE LOS TERREROS · ATARDECER DORADO
     ══════════════════════════════════════════════════════ */
  .sj {
    --sj-paper:    #FBF4E4;       /* Crema arena cálida */
    --sj-paper-2:  #F2E7CE;
    --sj-sand:     #EAD6A6;       /* Arena dorada */
    --sj-ink:      #16120A;       /* Tierra cálida oscura */
    --sj-gold:     #E3A52C;       /* Oro miel / sol (PRIMARY) */
    --sj-gold-d:   #B27C1B;
    --sj-turq:     #25C0BE;       /* Turquesa laguna */
    --sj-turq-d:   #14807E;
    --sj-coral:    #F2674B;       /* Coral atardecer */
    --sj-stone:    #C98A4B;       /* Sillería castillo */
    --sj-blue:     #2E7196;       /* Mar profundo */
    --sj-shadow:   8px 8px 0 var(--sj-ink);
  }
  .sj-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--sj-gold);
    box-shadow: 0 0 0 0 rgba(227,165,44,0.55);
    animation: sj-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes sj-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(227,165,44,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(227,165,44,0); }
    100% { box-shadow: 0 0 0 0 rgba(227,165,44,0); }
  }
  .sj-spin { transform-origin: 50% 50%; animation: sj-spin 30s linear infinite; }
  @keyframes sj-spin { to { transform: rotate(360deg); } }
  .sj-flag-wave, .sj-final-flag { transform-origin: left center; animation: sj-flag 2.6s ease-in-out infinite; }
  @keyframes sj-flag { 0%, 100% { transform: skewY(0deg) scaleX(1); } 50% { transform: skewY(-4deg) scaleX(.94); } }

  /* HERO */
  .sj-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 16%, rgba(227,165,44,0.14), transparent 50%),
      radial-gradient(circle at 12% 84%, rgba(37,192,190,0.12), transparent 50%),
      var(--sj-paper);
    border-bottom: 3px solid var(--sj-ink);
    position: relative;
    overflow: hidden;
  }
  .sj-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(125deg, transparent 0 38px, rgba(227,165,44,0.05) 38px 39px);
    pointer-events: none;
  }
  .sj-hero > * { position: relative; }
  .sj-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .sj-hero__status { color: var(--sj-gold-d); font-weight: 700; }
  .sj-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .sj-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .sj-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .sj-hero__chapter { color: var(--sj-gold-d); }
  .sj-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .sj-hero__title em { color: var(--sj-gold-d); font-style: italic; }
  .sj-hero__title-stamp {
    display: inline-block;
    color: var(--sj-paper);
    background: var(--sj-turq-d);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .sj-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 54ch; }
  .sj-hero__lead strong { color: var(--sj-ink); font-weight: 700; }
  .sj-hero__lead em { color: var(--sj-turq-d); font-style: italic; font-weight: 600; }
  .sj-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .sj-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--sj-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .sj-btn--primary { background: var(--sj-gold); color: var(--sj-ink); box-shadow: 6px 6px 0 var(--sj-ink); }
  .sj-btn--primary:hover { background: var(--sj-coral); color: var(--sj-paper); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--sj-ink); }
  .sj-btn--ghost { background: transparent; color: var(--sj-ink); box-shadow: 6px 6px 0 var(--sj-turq); }
  .sj-btn--ghost:hover { background: var(--sj-ink); color: var(--sj-turq); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--sj-turq); }

  /* KPIs */
  .sj-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--sj-ink);
    background: var(--sj-ink);
  }
  @media (min-width: 768px) { .sj-kpis { grid-template-columns: repeat(4, 1fr); } }
  .sj-kpi {
    background: var(--sj-paper); padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--sj-ink); border-bottom: 2px solid var(--sj-ink);
  }
  .sj-kpi:nth-child(2n) { border-right: none; }
  .sj-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .sj-kpi:nth-child(2n)      { border-right: 2px solid var(--sj-ink); }
    .sj-kpi:nth-child(4n)      { border-right: none; }
    .sj-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--sj-ink); }
    .sj-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .sj-kpi--gold  { background: var(--sj-gold); color: var(--sj-ink); }
  .sj-kpi--turq  { background: var(--sj-turq); color: var(--sj-ink); }
  .sj-kpi--coral { background: var(--sj-coral); color: var(--sj-paper); }
  .sj-kpi--ink   { background: var(--sj-ink); color: var(--sj-paper); }
  .sj-kpi--ink .sj-kpi__v { color: var(--sj-gold); }
  .sj-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .sj-kpi__v small { font-size: .55em; opacity: .8; }
  .sj-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .sj-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(22,18,10,0.2));
  }
  .sj-postcard {
    background: var(--sj-paper);
    border: 3px solid var(--sj-ink);
    box-shadow: var(--sj-shadow);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .35s;
  }
  .sj-postcard:hover { transform: rotate(0); }
  .sj-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--sj-gold);
    color: var(--sj-ink);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--sj-ink);
  }
  .sj-postcard__profile {
    width: 100%; aspect-ratio: 540 / 240;
    border-bottom: 2px solid var(--sj-ink);
    overflow: hidden;
  }
  .sj-postcard__img-wrap { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 2px solid var(--sj-ink); }
  .sj-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.04) saturate(1.08); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .sj-postcard:hover .sj-postcard__img { transform: scale(1.05); }
  .sj-postcard__seal { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(-9deg); filter: drop-shadow(0 4px 10px rgba(227,165,44,0.55)); }
  .sj-postcard__tag {
    position: absolute; bottom: 12px; left: 12px;
    background: var(--sj-turq); color: var(--sj-ink);
    padding: .4rem .75rem;
    font-size: .62rem; font-weight: 800; letter-spacing: .18em;
    border: 2px solid var(--sj-ink);
    box-shadow: 3px 3px 0 var(--sj-coral);
    transform: rotate(-2deg);
  }
  .sj-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--sj-paper-2);
    display: grid; gap: .35rem;
  }
  .sj-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(22,18,10,0.18);
    font-size: .68rem;
  }
  .sj-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .sj-postcard__data-row > span:first-child { color: var(--sj-gold-d); letter-spacing: .2em; font-weight: 800; }
  .sj-postcard__data-v { color: var(--sj-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .sj-marquee {
    background: var(--sj-gold); color: var(--sj-ink);
    overflow: hidden; padding: .9rem 0;
    border-top: 3px solid var(--sj-ink);
  }
  .sj-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: sj-marquee 40s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem; font-weight: 800;
    letter-spacing: .15em; text-transform: uppercase;
  }
  @keyframes sj-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* CASTILLO SECTION */
  .sj-castle-section {
    background: var(--sj-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sj-ink);
    position: relative;
    overflow: hidden;
  }
  .sj-castle-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(227,165,44,0.07) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .sj-castle-section > * { position: relative; }
  .sj-castle-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .sj-castle-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .sj-castle-chapter { color: var(--sj-gold-d); }
  .sj-castle-title { font-size: clamp(2.5rem, 6vw, 4.25rem); line-height: .92; letter-spacing: -.04em; margin: 1rem 0; }
  .sj-castle-title em { color: var(--sj-turq-d); }
  .sj-castle-lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); margin-bottom: 1.75rem; max-width: 56ch; }
  .sj-castle-lead strong { color: var(--sj-ink); font-weight: 700; }
  .sj-castle-lead em { color: var(--sj-coral); font-style: italic; }
  .sj-castle-facts { display: grid; grid-template-columns: 1fr; gap: 0; border: 2.5px solid var(--sj-ink); background: var(--sj-paper); box-shadow: 6px 6px 0 var(--sj-ink); margin-bottom: 1.5rem; }
  @media (min-width: 640px) { .sj-castle-facts { grid-template-columns: 1fr 1fr; } }
  .sj-castle-fact { padding: .85rem 1rem; border-bottom: 1px solid var(--sj-ink); display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 640px) {
    .sj-castle-fact:nth-child(odd) { border-right: 1px solid var(--sj-ink); }
    .sj-castle-fact:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .sj-castle-fact:last-child { border-bottom: none; } }
  .sj-castle-fact__k { font-size: .58rem; letter-spacing: .2em; color: var(--sj-gold-d); font-weight: 800; }
  .sj-castle-fact__v { font-size: .88rem; color: var(--sj-ink); font-weight: 600; line-height: 1.35; }
  .sj-castle-note { padding: 1rem 1.25rem; background: var(--sj-turq); color: var(--sj-ink); border: 2px solid var(--sj-ink); font-size: .92rem; line-height: 1.5; }
  .sj-castle-note strong { color: var(--sj-turq-d); }
  .sj-castle-r { max-width: 320px; margin: 0 auto; border: 3px solid var(--sj-ink); box-shadow: var(--sj-shadow); line-height: 0; background: #FBD98C; }

  /* ICONOS */
  .sj-iconos-section { background: var(--sj-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--sj-ink); }
  .sj-iconos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 1024px) { .sj-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .sj-icono {
    position: relative;
    background: var(--sj-paper);
    border: 3px solid var(--sj-ink);
    box-shadow: var(--sj-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .sj-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .sj-icono--stone { color: var(--sj-stone); }
  .sj-icono--turq  { color: var(--sj-turq-d); }
  .sj-icono--coral { color: var(--sj-coral); }
  .sj-icono__code {
    position: absolute; top: -16px; right: 20px;
    background: var(--sj-ink); color: var(--sj-gold);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .sj-icono__svg { width: 100%; aspect-ratio: 1; max-width: 200px; margin: 0 auto; color: currentColor; }
  .sj-icono__name { font-size: clamp(1.4rem, 2.8vw, 1.8rem); line-height: 1; letter-spacing: -.025em; color: var(--sj-ink); margin: .5rem 0 0; text-align: center; }
  .sj-icono__sub { font-size: .6rem; letter-spacing: .22em; color: currentColor; font-weight: 800; text-align: center; }
  .sj-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; text-align: center; }
  .sj-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .sj-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* TEMPORADA */
  .sj-season-section { background: var(--sj-blue); color: var(--sj-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--sj-ink); position: relative; overflow: hidden; }
  .sj-season-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(251,244,228,0.06) 1.3px, transparent 1.3px); background-size: 26px 26px; pointer-events: none; }
  .sj-season-section > * { position: relative; }
  .sj-season-head { max-width: 760px; margin-bottom: 2.5rem; }
  .sj-season-chapter { color: var(--sj-gold); }
  .sj-season-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; color: var(--sj-paper); }
  .sj-season-title em { color: var(--sj-gold); }
  .sj-season-lead { font-size: 1.1rem; line-height: 1.55; color: rgba(251,244,228,0.82); max-width: 60ch; }
  .sj-season-lead strong { color: var(--sj-paper); font-weight: 700; }
  .sj-season-lead em { color: var(--sj-gold); font-style: italic; }

  .sj-season-card { background: var(--sj-paper); border: 3px solid var(--sj-ink); box-shadow: var(--sj-shadow); padding: 1.75rem; }
  .sj-season-card__head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .75rem; padding-bottom: 1.25rem; border-bottom: 2px dashed var(--sj-ink); }
  .sj-season-card__head > .text-mono { font-size: .68rem; letter-spacing: .2em; font-weight: 800; color: var(--sj-blue); }
  .sj-season-legend { display: flex; gap: 1rem; }
  .sj-leg { display: inline-flex; align-items: center; gap: .4rem; font-family: var(--font-mono); font-size: .62rem; font-weight: 700; color: var(--sj-ink); letter-spacing: .05em; }
  .sj-leg > span { width: 12px; height: 12px; border: 1.5px solid var(--sj-ink); }
  .sj-leg--antes > span { background: var(--sj-sand); }
  .sj-leg--ahora > span { background: var(--sj-gold); }

  .sj-chart { list-style: none; margin: 1.5rem 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: .5rem; align-items: end; }
  .sj-chart__col { display: flex; flex-direction: column; align-items: center; gap: .5rem; }
  .sj-chart__bars { display: flex; align-items: flex-end; gap: 4px; height: 180px; width: 100%; justify-content: center; }
  .sj-bar { position: relative; width: 42%; max-width: 26px; border: 2px solid var(--sj-ink); transform-origin: bottom; }
  .sj-bar--antes { background: var(--sj-sand); height: var(--h); animation: sj-grow .9s cubic-bezier(.16,1,.3,1) both; }
  .sj-bar--ahora { background: var(--sj-gold); height: var(--h); animation: sj-grow 1.1s .15s cubic-bezier(.16,1,.3,1) both; }
  .sj-bar b { position: absolute; top: -16px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: .56rem; font-weight: 800; color: var(--sj-ink); }
  .sj-bar--ahora b { color: var(--sj-gold-d); }
  @keyframes sj-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .sj-chart__m { font-family: var(--font-mono); font-size: .62rem; font-weight: 800; letter-spacing: .12em; color: var(--sj-ink); }
  .sj-chart__col:nth-child(4) .sj-chart__m { color: var(--sj-coral); }

  .sj-season-card__foot { font-size: .95rem; line-height: 1.55; color: var(--sj-ink); margin: 1.25rem 0 1.25rem; padding-top: 1.25rem; border-top: 2px dashed var(--sj-ink); }
  .sj-season-card__foot strong { color: var(--sj-blue); }
  .sj-season-cta { display: inline-flex; align-items: center; justify-content: center; padding: .9rem 1.5rem; background: var(--sj-gold); color: var(--sj-ink); font-family: var(--font-display); font-weight: 800; border: 2.5px solid var(--sj-ink); box-shadow: 4px 4px 0 var(--sj-ink); text-decoration: none; transition: transform .2s, box-shadow .2s, background .2s, color .2s; }
  .sj-season-cta:hover { background: var(--sj-coral); color: var(--sj-paper); transform: translate(-2px,-2px); box-shadow: 7px 7px 0 var(--sj-ink); }

  /* HITOS */
  .sj-hitos-section {
    background: var(--sj-ink); color: var(--sj-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sj-ink);
    position: relative; overflow: hidden;
  }
  .sj-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(227,165,44,0.1) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .sj-hitos-section > * { position: relative; }
  .sj-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2.5px solid var(--sj-paper);
  }
  @media (min-width: 640px)  { .sj-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sj-hitos { grid-template-columns: repeat(3, 1fr); } }
  .sj-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(251,244,228,0.22);
    border-right: 1px solid rgba(251,244,228,0.22);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(251,244,228,0.03);
    transition: background .25s;
  }
  .sj-hito:hover { background: rgba(227,165,44,0.2); }
  @media (min-width: 1024px) {
    .sj-hito:nth-child(3n) { border-right: none; }
    .sj-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .sj-hito:nth-child(2n) { border-right: none; }
    .sj-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .sj-hito { border-right: none; } .sj-hito:last-child { border-bottom: none; } }
  .sj-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--sj-gold); font-weight: 800; }
  .sj-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--sj-paper); line-height: 1.35; }

  /* SECTORES */
  .sj-sec-section { background: var(--sj-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--sj-ink); }
  .sj-sec { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px)  { .sj-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sj-sec { grid-template-columns: repeat(3, 1fr); } }
  .sj-sec__card {
    background: var(--sj-paper);
    border: 2.5px solid var(--sj-ink);
    box-shadow: var(--sj-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
  }
  .sj-sec__card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: currentColor; }
  .sj-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .sj-sec__card--gold  { color: var(--sj-gold-d); }
  .sj-sec__card--turq  { color: var(--sj-turq-d); }
  .sj-sec__card--coral { color: var(--sj-coral); }
  .sj-sec__card--blue  { color: var(--sj-blue); }
  .sj-sec__card--stone { color: var(--sj-stone); }
  .sj-sec__card--ink   { color: var(--sj-gold-d); }
  .sj-sec__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; gap: .5rem; }
  .sj-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .sj-sec__stat-box {
    background: var(--sj-ink); color: var(--sj-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .sj-sec__stat-v { font-size: .9rem; font-weight: 800; color: currentColor; line-height: 1; }
  .sj-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .sj-sec__title { font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.1; letter-spacing: -.02em; color: var(--sj-ink); margin: 0; }
  .sj-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; }
  .sj-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .sj-sec__tag { display: flex; align-items: flex-start; gap: .35rem; font-size: .78rem; line-height: 1.35; color: var(--sj-ink); }
  .sj-sec__tag span { color: currentColor; font-weight: 800; }
  .sj-sec__foot { padding-top: .65rem; border-top: 2px solid var(--sj-ink); }
  .sj-sec__cta { font-family: var(--font-mono); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .15em; color: currentColor; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px; }

  /* MAPA */
  .sj-map-section { background: var(--sj-sand); border-bottom: 3px solid var(--sj-ink); }
  .sj-map-head { padding: 4rem 0 2rem; }
  .sj-map-head__inner { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; }
  @media (min-width: 768px) { .sj-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .sj-map-chapter { color: var(--sj-gold-d); }
  .sj-map-title { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0 0; }
  .sj-map-title em { color: var(--sj-gold-d); }
  .sj-map-coords {
    background: var(--sj-gold); color: var(--sj-ink);
    padding: 1rem 1.25rem;
    border: 2px solid var(--sj-ink);
    box-shadow: 5px 5px 0 var(--sj-turq);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem; letter-spacing: .15em;
  }
  .sj-map-frame { border-top: 3px solid var(--sj-ink); border-bottom: 3px solid var(--sj-ink); background: var(--sj-ink); }
  .sj-map-wrap > * { width: 100%; }

  /* DIFERENCIALES */
  .sj-dif-section { background: var(--sj-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--sj-ink); }
  .sj-dif { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 0; border: 2px solid var(--sj-ink); }
  @media (min-width: 768px) { .sj-dif { grid-template-columns: 1fr 1fr; } }
  .sj-dif__item { padding: 1.75rem 1.5rem; border-bottom: 1px solid var(--sj-ink); display: flex; flex-direction: column; gap: .65rem; transition: background .2s; }
  @media (min-width: 768px) {
    .sj-dif__item:nth-child(odd) { border-right: 1px solid var(--sj-ink); }
    .sj-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) { .sj-dif__item:last-child { border-bottom: none; } }
  .sj-dif__item--0 { background: var(--sj-paper-2); }
  .sj-dif__item--1 { background: var(--sj-paper); }
  .sj-dif__item--2 { background: var(--sj-sand); }
  .sj-dif__item--3 { background: var(--sj-paper); }
  .sj-dif__item:hover { background: var(--sj-gold); }
  .sj-dif__num { font-size: .85rem; color: var(--sj-coral); font-weight: 800; letter-spacing: .15em; }
  .sj-dif__t { font-size: clamp(1.3rem, 2.2vw, 1.65rem); line-height: 1.05; letter-spacing: -.025em; color: var(--sj-ink); margin: 0; }
  .sj-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* PROCESO */
  .sj-proc-section { background: var(--sj-ink); color: var(--sj-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--sj-ink); position: relative; overflow: hidden; }
  .sj-proc-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(37,192,190,0.08) 1.2px, transparent 1.2px); background-size: 22px 22px; pointer-events: none; }
  .sj-proc-section > * { position: relative; }
  .sj-proc { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 768px)  { .sj-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sj-proc { grid-template-columns: repeat(4, 1fr); } }
  .sj-proc__step {
    background: rgba(251,244,228,0.05);
    border: 2px solid var(--sj-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .sj-proc__step:hover { background: rgba(37,192,190,0.16); transform: translateY(-3px); }
  .sj-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(251,244,228,0.25); }
  .sj-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--sj-gold); line-height: 1; }
  .sj-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--sj-turq); }
  .sj-proc__t { font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.05; letter-spacing: -.02em; color: var(--sj-paper); margin: .25rem 0 0; }
  .sj-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(251,244,228,0.75); flex: 1; }
  .sj-proc__foot { font-size: .58rem; letter-spacing: .2em; color: var(--sj-gold); font-weight: 800; padding-top: .5rem; border-top: 1.5px solid rgba(251,244,228,0.25); }

  /* TESTIMONIOS */
  .sj-quote-section { background: var(--sj-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--sj-ink); }
  .sj-pull { position: relative; background: var(--sj-sand); border: 3px solid var(--sj-ink); box-shadow: var(--sj-shadow); padding: 3rem 2rem 2rem; margin: 2rem 0; }
  .sj-pull__seal { position: absolute; top: -30px; right: 30px; width: 90px; aspect-ratio: 1; transform: rotate(-9deg); filter: drop-shadow(0 4px 8px rgba(227,165,44,0.4)); }
  .sj-pull__q { font-family: var(--font-display); font-style: italic; font-size: clamp(1.35rem, 2.4vw, 2rem); line-height: 1.3; margin: 0 0 1.5rem; color: var(--sj-ink); max-width: 56ch; }
  .sj-pull__cap { display: flex; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 2px dashed var(--sj-ink); }
  .sj-pull__avatar { width: 48px; height: 48px; background: var(--sj-gold); color: var(--sj-ink); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; border-radius: 50%; }
  .sj-pull__cap div { display: flex; flex-direction: column; }
  .sj-pull__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--sj-ink); }
  .sj-pull__role { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; opacity: .65; text-transform: uppercase; }
  .sj-quotes { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) { .sj-quotes { grid-template-columns: repeat(3, 1fr); } }
