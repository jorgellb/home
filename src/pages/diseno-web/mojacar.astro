---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import InteractiveMap from '../../components/sections/InteractiveMap.astro';
import { getPueblosByComarca } from '../../data/pueblos-almeria';

const pueblosLevante = getPueblosByComarca('Levante Almeriense').filter(p => p.slug !== 'mojacar');

const title = 'Diseño Web en Mojácar | Webs Multiidioma para Turismo, Hostelería e Inmobiliarias';
const description = 'Agencia de diseño web en Mojácar especializada en turismo internacional. Webs multiidioma (ES/EN/FR/DE), reservas directas, hosting gratuito para webs estáticas y SEO local para captar turistas de UK, Alemania y Francia. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/diseno-web/mojacar/';

const sectores = [
  { nombre: 'Hoteles y alojamientos',   stat: '70%',    statLabel: 'turismo busca online',   desc: 'Motor de reservas directo, galería inmersiva, multiidioma (ES/EN/FR/DE) y SEO internacional para captar turistas que buscan "hotel in Mojácar" sin pagar comisiones del 15–20%.', tags: ['Motor de reservas','Multiidioma nativo','Galería inmersiva','SEO internacional'] },
  { nombre: 'Restaurantes y chiringuitos', stat: '#1', statLabel: 'en Google Maps', desc: 'Carta digital QR multiidioma, sistema de reservas, integración con Google Maps y SEO local para que turistas y residentes te encuentren al buscar "where to eat in Mojácar".', tags: ['Carta digital QR','Reservas online','Google Maps','Menú multiidioma'] },
  { nombre: 'Alquiler vacacional',      stat: '0%',     statLabel: 'comisiones propias',    desc: 'Plataforma propia con calendario de disponibilidad, pasarela de pago segura, galería 360° y multiidioma. Deja de depender de Airbnb y sus comisiones del 15–20%.', tags: ['Calendario disponibilidad','Pago seguro','Galería 360°','Sin comisiones'] },
  { nombre: 'Inmobiliarias',            stat: '+40%',  statLabel: 'leads cualificados',     desc: 'Portal con buscador avanzado, fichas detalladas multiidioma y captación de leads de compradores internacionales de UK, Alemania, Bélgica y Francia.', tags: ['Portal propiedades','Buscador avanzado','Leads internacionales','Fichas multiidioma'] },
  { nombre: 'Comercios y boutiques',    stat: '24/7',   statLabel: 'tu tienda nunca cierra', desc: 'E-commerce para vender artesanía, moda y productos locales a toda España y Europa. Catálogo visual atractivo, gestión de stock y envíos automatizados.', tags: ['E-commerce','Pasarela de pago','Gestión de stock','Envíos automáticos'] },
  { nombre: 'Actividades y ocio',       stat: 'x3',     statLabel: 'más reservas online',   desc: 'Webs para empresas de kayak, buceo, rutas, spa y excursiones en Mojácar. Con reservas online multiidioma, calendario de actividades y reviews integradas.', tags: ['Reservas online','Calendario actividades','Reviews integradas','Multiidioma'] },
];

const diferenciales = [
  { title: 'Turismo internacional',     desc: 'Mojácar recibe visitantes de UK, Alemania, Francia y Bélgica. Tu web necesita estar en su idioma para convertir. No vale traducción automática: cada versión debe estar optimizada para SEO en ese idioma.' },
  { title: 'Estacionalidad inteligente', desc: 'El SEO local trabaja 365 días. Cuando llega la temporada, tu web ya está posicionada y capturando reservas. Los primeros puestos en Google no se improvisan en junio.' },
  { title: 'Pueblo + Playa = 2 mercados', desc: 'Mojácar Pueblo atrae cultura, gastronomía y boutiques. Mojácar Playa atrae turismo de sol, ocio y deportes acuáticos. Tu web debe hablarle a ambos públicos.' },
  { title: 'Competencia feroz online',  desc: 'Booking, Airbnb y TripAdvisor dominan las búsquedas. Una web propia con SEO local, reservas directas y marca diferenciada te devuelve el control y elimina comisiones.' },
];

const proceso = [
  { num: '01', title: 'Inmersión local',       eta: '1–2 días', body: 'Visitamos tu negocio en Mojácar, entendemos a tu cliente (turista, residente, expatriado) y definimos la estrategia digital y palabras clave en cada idioma.', deliverable: 'Briefing + keywords por idioma' },
  { num: '02', title: 'Diseño mediterráneo',   eta: '3–5 días', body: 'Diseño que refleja la esencia de Mojácar: pueblo blanco, mar, luz. Nada de plantillas genéricas. Tú apruebas antes de programar.', deliverable: 'Prototipo Figma · approved' },
  { num: '03', title: 'Desarrollo multiidioma', eta: '5–10 días', body: 'Astro ultrarrápido, multiidioma nativo con SEO por idioma, datos estructurados y Core Web Vitals perfectos desde el primer commit.', deliverable: 'Web en staging + auditoría' },
  { num: '04', title: 'Lanzamiento + SEO',     eta: '1–2 días', body: 'Publicamos con hosting gratuito, configuramos Google Business Profile, Search Console e indexación. Te formamos para gestionar contenido.', deliverable: 'Sitio en producción + manual' },
];

const testimonios = [
  { nombre: 'Luis S.',   negocio: 'Restaurante · Mojácar Playa', texto: 'Nuestro restaurante necesitaba carta digital y reservas online en varios idiomas. Nos hicieron una web espectacular y gracias al SEO local captamos reservas todo el año, incluso en temporada baja.' },
  { nombre: 'Marta F.',  negocio: 'Boutique · Mojácar Pueblo',   texto: 'Tengo una boutique y quería vender online a toda España. Platanito Rico desarrolló mi e-commerce con un diseño que capta la esencia de la tienda. Las ventas online ya son el 30% de mi facturación.' },
  { nombre: 'Tomás R.',  negocio: 'Hotel · Mojácar',             texto: 'Desde que lanzaron la nueva web hemos duplicado las reservas directas y reducido la dependencia de Booking al 40%. El multiidioma inglés-alemán fue clave para captar turistas del norte de Europa.' },
  { nombre: 'Isabel G.', negocio: 'Alquiler vacacional · Mojácar', texto: 'Como agencia de alquiler vacacional, necesitábamos una plataforma rápida y visual con multiidioma. La presencia en búsquedas desde Reino Unido ha mejorado un 300%.' },
];

const faq = [
  { q: '¿Cuánto cuesta una web para un negocio en Mojácar?', a: 'Web corporativa básica desde 450€ con hosting gratuito incluido. Tiendas online o plataformas de reservas multiidioma requieren más según funcionalidades. Presupuesto personalizado y gratuito sin compromiso.' },
  { q: '¿Hacéis webs multiidioma para el turismo de Mojácar?', a: 'Sí, es una de nuestras especialidades. UK, Alemania, Francia y Bélgica. Cambio de idioma nativo (no traducción automática) y SEO optimizado por idioma para aparecer en búsquedas como "hotels in Mojácar" o "Ferienwohnung Mojácar".' },
  { q: '¿Podéis hacer un sistema de reservas directas para mi hotel o restaurante?', a: 'Sí. Integramos motores de reservas directas para que tus clientes reserven sin pasar por Booking o TripAdvisor. Elimina comisiones del 15–20% y te da el control total sobre los datos de tus clientes.' },
  { q: '¿Cuánto tarda en estar lista la web?', a: 'Web corporativa: 1–2 semanas. Tienda online o plataforma de reservas multiidioma: 2–4 semanas. Si necesitas algo urgente para temporada, podemos priorizar.' },
  { q: '¿Hacéis SEO local para posicionar en Mojácar?', a: 'Sí. Optimizamos Google Business Profile, estructuramos contenido con keywords locales ("restaurante Mojácar Playa", "inmobiliaria Mojácar") y trabajamos el SEO técnico para que cargue en <1s.' },
  { q: '¿Ofrecéis reuniones presenciales en Mojácar?', a: 'Sí, somos locales. Trabajamos habitualmente en Mojácar, Garrucha, Vera y toda la comarca del Levante Almeriense. Podemos reunirnos en tu local para entender la esencia del negocio.' },
  { q: '¿Qué es el hosting gratuito para webs estáticas?', a: 'Las webs sin base de datos (corporativas, portfolios, landings) pueden alojarse gratis en Netlify o Cloudflare Pages. Más rápidas, más seguras, sin hosting mensual. Solo pagas el dominio (10–15€/año).' },
  { q: '¿Puedo gestionar el contenido yo mismo?', a: 'Sí. Te entregamos un panel intuitivo y te formamos para actualizar textos, imágenes, productos y contenido en todos los idiomas sin programar.' },
];

const jsonLdSchemas = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Diseño Web","item":"https://platanitorico.com/diseno-web/"},{"@type":"ListItem","position":3,"name":"Mojácar","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Diseño Web en Mojácar","url":canonical,"telephone":"+34657085019","address":{"@type":"PostalAddress","addressLocality":"Mojácar","addressRegion":"Almería","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":37.140,"longitude":-1.852},"areaServed":["Mojácar Pueblo","Mojácar Playa","Garrucha","Vera","Levante Almeriense"],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","reviewCount":"62","bestRating":"5","worstRating":"1"},"review":testimonios.map(t=>({"@type":"Review","author":{"@type":"Person","name":t.nombre},"reviewRating":{"@type":"Rating","ratingValue":"5","bestRating":"5"},"reviewBody":t.texto})) },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo creamos tu web en Mojácar","step":proceso.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/diseno-web-mojacar.jpg"
  imageAlt="Diseño web en Mojácar - Platanito Rico"
  type="service"
  keywords="diseño web mojácar, web mojácar playa, hotel mojácar, restaurante mojácar, multiidioma turismo"
  jsonLd={jsonLdSchemas}
>
  <Header />

  <main id="main-content">
    {/* HERO */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 020 — Levante Almeriense · Turismo internacional</span>
          <span class="text-meta"><span class="live-dot"></span> Pueblo blanco · 4 idiomas</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Diseño Web · Mojácar · Pueblo &amp; Playa</span>
            <h1 class="svc-hero__title">
              Mojácar en
              <em>cuatro idiomas.</em>
              <span class="text-stroke-ink">Reservas</span>
              sin comisiones.
            </h1>
            <p class="svc-hero__lead">
              Hoteles, restaurantes, inmobiliarias y alquiler vacacional con
              <strong>multiidioma nativo (ES/EN/FR/DE)</strong> y SEO internacional.
              Cero comisiones de Booking o Airbnb — tus reservas, tu cliente.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">Presupuesto en 24h →</a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">ES/EN</span>
              <span class="svc-hero__spec-lbl">+ FR · DE</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">0%</span>
              <span class="svc-hero__spec-lbl">Comisiones Booking</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">x2</span>
              <span class="svc-hero__spec-lbl">Reservas directas</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">4.9★</span>
              <span class="svc-hero__spec-lbl">62 reseñas</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ MOJÁCAR ★ PUEBLO BLANCO ★ MOJÁCAR PLAYA ★ MULTIIDIOMA ★ TURISMO INTERNACIONAL ★</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section-brutal" style="padding:0;background:var(--brutal-bg-alt);border-bottom:2px solid var(--brutal-ink);">
      <div class="pueblo-map-wrap">
        <InteractiveMap center={[-1.852, 37.140]} zoom={13} pitch={25} bearing={-15} label="Mojácar" />
      </div>
    </section>

    {/* SECTORES */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 01 / Sectores Mojácar</span>
            <h2 class="brutal-section-head__title">
              Quién contrata
              <em>en Mojácar.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Seis sectores con potencial real en Mojácar Pueblo y Mojácar Playa.
            Cada uno con su estrategia SEO multiidioma y sistema técnico.
          </p>
        </header>

        <ol class="svc-bento">
          {sectores.map((s, i) => {
            const accents = ['accent', 'paper', 'lime', 'paper', 'ink', 'paper'];
            return (
              <li class={`svc-card svc-card--${accents[i]}`}>
                <header class="svc-card__head">
                  <span class="svc-card__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-card__kicker">{s.stat} · {s.statLabel}</span>
                </header>
                <h3 class="svc-card__title">{s.nombre}</h3>
                <p class="svc-card__desc">{s.desc}</p>
                <ul class="svc-card__features">
                  {s.tags.map((t) => (
                    <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{t}</span></li>
                  ))}
                </ul>
                <footer class="svc-card__foot">
                  <div class="svc-card__figure">
                    <span class="svc-card__figure-val">{s.stat}</span>
                    <span class="svc-card__figure-lbl">{s.statLabel}</span>
                  </div>
                  <a href="/contacto" class="svc-card__cta">Pedir →</a>
                </footer>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    {/* DIFERENCIALES */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Mojácar es único</span>
            <h2 class="brutal-section-head__title">
              Por qué Mojácar
              <em>necesita</em>
              estrategia digital.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Dos núcleos, cuatro idiomas, una estacionalidad marcada. Mojácar es
            un mercado complejo — y por eso una web bien hecha marca la diferencia.
          </p>
        </header>

        <ul class="svc-sectors">
          {diferenciales.map((d, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">★ {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{d.title}</h3>
              <p class="svc-sector__desc">{d.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Método</span>
            <h2 class="brutal-section-head__title">
              Web multiidioma
              <em>en 2–3 semanas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases. Desde la inmersión en Mojácar hasta el lanzamiento
            con Google Business Profile configurado y Core Web Vitals verdes.
          </p>
        </header>

        <ol class="svc-process">
          {proceso.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < proceso.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* TESTIMONIOS */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Voces de Mojácar</span>
            <h2 class="brutal-section-head__title">
              Negocios locales que
              <em>ya facturan más.</em>
            </h2>
          </div>
        </header>

        <figure class="svc-pull">
          <div class="svc-pull__marks" aria-hidden="true">“</div>
          <blockquote class="svc-pull__quote">{testimonios[0].texto}</blockquote>
          <figcaption class="svc-pull__cap">
            <span class="svc-pull__avatar">{testimonios[0].nombre[0]}</span>
            <div>
              <span class="svc-pull__name">{testimonios[0].nombre}</span>
              <span class="svc-pull__role">{testimonios[0].negocio}</span>
            </div>
          </figcaption>
        </figure>

        <ul class="svc-quotes">
          {testimonios.slice(1).map((t, i) => (
            <li class={`svc-quote svc-quote--${i}`}>
              <p>"{t.texto}"</p>
              <footer>
                <span class="svc-quote__avatar">{t.nombre[0]}</span>
                <div>
                  <span class="svc-quote__name">{t.nombre}</span>
                  <span class="svc-quote__role">{t.negocio}</span>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* FAQ */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Preguntas Mojácar</span>
            <h2 class="brutal-section-head__title">
              Lo que más
              <em>preguntan</em>
              en Mojácar.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Multiidioma, reservas directas, SEO turístico, hosting. Si no
            está aquí, escríbenos y respondemos en 24h.
          </p>
        </header>

        <ol class="svc-faq">
          {faq.map((f, i) => (
            <li class="svc-faq__item">
              <details class="svc-faq__details" open={i === 0}>
                <summary class="svc-faq__sum">
                  <span class="svc-faq__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-faq__q">{f.q}</span>
                  <span class="svc-faq__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-faq__answer"><p>{f.a}</p></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* OTROS PUEBLOS DEL LEVANTE */}
    {pueblosLevante.length > 0 && (
      <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);">
        <div class="container-brutal">
          <header class="brutal-section-head">
            <div class="brutal-section-head__col">
              <span class="text-meta">Cap. 06 / Levante Almeriense</span>
              <h2 class="brutal-section-head__title">
                También cubrimos
                <em>el Levante.</em>
              </h2>
            </div>
            <p class="brutal-section-head__lead">
              Otros municipios del Levante con los que ya trabajamos. Si tu
              pueblo no está, escríbenos.
            </p>
          </header>

          <ul class="cobertura-grid" style="margin-top:2rem;">
            {pueblosLevante.slice(0, 8).map((p, i) => (
              <li>
                <a href={`/diseno-web/${p.slug}/`} class={`cobertura-tile cobertura-tile--${i % 6}`}>
                  <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
                  <span class="cobertura-tile__name heading-display">{p.nombre}</span>
                  <span class="cobertura-tile__sub text-mono">{p.comarca}</span>
                  <span class="cobertura-tile__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="svc-final__title">
            ¿Empezamos tu web
            <em>en Mojácar?</em>
          </h2>
          <p class="svc-final__text">
            Cuéntanos qué necesitas — hotel, restaurante, inmobiliaria,
            alquiler vacacional — y te enviamos un presupuesto detallado en 24h.
            Reuniones presenciales en Mojácar disponibles.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .pueblo-map-wrap { width: 100%; height: clamp(360px, 50vh, 520px); overflow: hidden; }
  .pueblo-map-wrap > * { width: 100%; height: 100%; }
</style>
