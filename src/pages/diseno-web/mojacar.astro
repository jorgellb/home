<style>
  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · MOJÁCAR · PUEBLO BLANCO BOHEMIO                */
  /* ═══════════════════════════════════════════════════════ */
  .mj {
    --mj-white:         #FAFAF5;          /* encalado */
    --mj-paper:         #FFFCF6;
    --mj-paper-2:       #F4EDDA;
    --mj-cream:         #F0E9D2;          /* adobe */
    --mj-ink:           #0E0D0B;
    --mj-indalo:        #C5512E;          /* terracota indalo */
    --mj-indalo-d:      #8E3A20;
    --mj-bougainvillea: #C73572;          /* fucsia bougainvillea */
    --mj-indigo:        #2D4B7A;          /* puerta cobalto */
    --mj-clay:          #B86E4A;          /* barro */
    --mj-olive:         #8B8842;          /* olivo */
    --mj-lime:          #D6FF44;          /* brand */
    --mj-sun:           #FFB833;          /* sol */
    --mj-shadow:        8px 8px 0 var(--mj-ink);
  }

  .mj-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--mj-bougainvillea);
    box-shadow: 0 0 0 0 rgba(199,53,114,0.55);
    animation: mj-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes mj-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(199,53,114,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(199,53,114,0); }
    100% { box-shadow: 0 0 0 0 rgba(199,53,114,0); }
  }
  .mj-spin { transform-origin: 50% 50%; animation: mj-spin 25s linear infinite; }
  @keyframes mj-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .mj-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(199,53,114,0.10), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(197,81,46,0.10), transparent 50%),
      var(--mj-white);
    border-bottom: 3px solid var(--mj-ink);
    position: relative;
    overflow: hidden;
  }
  .mj-hero::before {
    /* Patrón de encalado sutil */
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(0deg, transparent 0 30px, rgba(14,13,11,0.02) 30px 31px),
      repeating-linear-gradient(90deg, transparent 0 30px, rgba(14,13,11,0.02) 30px 31px);
    pointer-events: none;
  }
  .mj-hero > * { position: relative; }

  .mj-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .mj-hero__status { color: var(--mj-bougainvillea); font-weight: 700; }

  .mj-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 1024px) { .mj-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }

  .mj-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .mj-hero__chapter { color: var(--mj-indalo); }
  .mj-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .mj-hero__title em { color: var(--mj-indalo); font-style: italic; }
  .mj-hero__title-stamp {
    display: inline-block;
    color: var(--mj-bougainvillea);
    background: var(--mj-ink);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .mj-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 54ch;
  }
  .mj-hero__lead strong { color: var(--mj-ink); font-weight: 700; }
  .mj-hero__lead em { color: var(--mj-bougainvillea); font-style: italic; font-weight: 600; }
  .mj-hero__lead-bold {
    display: block;
    margin-top: .75rem;
    background: var(--mj-lime);
    color: var(--mj-ink);
    padding: .25rem .55rem;
    font-weight: 800;
    border: 2px solid var(--mj-ink);
    box-shadow: 3px 3px 0 var(--mj-ink);
  }

  .mj-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }
  .mj-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--mj-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .mj-btn--primary {
    background: var(--mj-indalo);
    color: var(--mj-white);
    box-shadow: 6px 6px 0 var(--mj-ink);
  }
  .mj-btn--primary:hover {
    background: var(--mj-bougainvillea);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--mj-ink);
  }
  .mj-btn--ghost {
    background: transparent;
    color: var(--mj-ink);
    box-shadow: 6px 6px 0 var(--mj-bougainvillea);
  }
  .mj-btn--ghost:hover {
    background: var(--mj-ink);
    color: var(--mj-lime);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--mj-bougainvillea);
  }

  /* KPIs */
  .mj-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--mj-ink);
    background: var(--mj-ink);
  }
  @media (min-width: 768px) { .mj-kpis { grid-template-columns: repeat(4, 1fr); } }
  .mj-kpi {
    background: var(--mj-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--mj-ink);
    border-bottom: 2px solid var(--mj-ink);
  }
  .mj-kpi:nth-child(2n) { border-right: none; }
  .mj-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .mj-kpi:nth-child(2n)      { border-right: 2px solid var(--mj-ink); }
    .mj-kpi:nth-child(4n)      { border-right: none; }
    .mj-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--mj-ink); }
    .mj-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .mj-kpi--bougainvillea { background: var(--mj-bougainvillea); color: var(--mj-white); }
  .mj-kpi--indigo        { background: var(--mj-indigo); color: var(--mj-white); }
  .mj-kpi--indalo        { background: var(--mj-indalo); color: var(--mj-white); }
  .mj-kpi--ink           { background: var(--mj-ink); color: var(--mj-white); }
  .mj-kpi--ink .mj-kpi__v { color: var(--mj-lime); }
  .mj-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .mj-kpi__v small { font-size: .55em; opacity: .8; }
  .mj-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .mj-hero__postal {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(14,13,11,0.18));
  }
  .mj-postcard {
    background: var(--mj-white);
    border: 3px solid var(--mj-ink);
    box-shadow: var(--mj-shadow);
    overflow: hidden;
    transform: rotate(1deg);
    transition: transform .35s;
  }
  .mj-postcard:hover { transform: rotate(0); }
  .mj-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--mj-indalo);
    color: var(--mj-white);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--mj-ink);
  }
  .mj-postcard__profile {
    width: 100%;
    aspect-ratio: 540 / 220;
    border-bottom: 2px solid var(--mj-ink);
    overflow: hidden;
  }
  .mj-postcard__img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid var(--mj-ink);
  }
  .mj-postcard__img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(1.1);
    transition: transform .6s cubic-bezier(.16,1,.3,1);
  }
  .mj-postcard:hover .mj-postcard__img { transform: scale(1.05); }
  .mj-postcard__indalo {
    position: absolute;
    top: 12px; right: 12px;
    width: 80px; height: 80px;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 10px rgba(197,81,46,0.4));
  }
  .mj-postcard__tag {
    position: absolute;
    bottom: 12px; left: 12px;
    background: var(--mj-white);
    color: var(--mj-ink);
    padding: .4rem .75rem;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 2px solid var(--mj-ink);
    box-shadow: 3px 3px 0 var(--mj-indalo);
    transform: rotate(-2deg);
  }
  .mj-postcard__flags {
    padding: .85rem 1rem;
    background: var(--mj-paper-2);
    display: flex; align-items: center; gap: .75rem;
    flex-wrap: wrap;
  }
  .mj-postcard__flags-lbl { font-size: .58rem; letter-spacing: .2em; color: var(--mj-indalo-d); font-weight: 800; }
  .mj-postcard__flags-list { display: flex; gap: .4rem; flex-wrap: wrap; }
  .mj-flag {
    display: inline-block;
    border: 1.5px solid var(--mj-ink);
    line-height: 0;
  }

  /* Marquee */
  .mj-marquee {
    background: var(--mj-bougainvillea);
    color: var(--mj-white);
    overflow: hidden;
    padding: .9rem 0;
    border-top: 3px solid var(--mj-ink);
  }
  .mj-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: mj-marquee 36s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  @keyframes mj-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* INDALO SECTION                                          */
  /* ═══════════════════════════════════════════════════════ */
  .mj-indalo-section {
    background: var(--mj-cream);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--mj-ink);
    position: relative;
    overflow: hidden;
  }
  .mj-indalo-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(45deg, transparent 0 24px, rgba(197,81,46,0.04) 24px 25px);
    pointer-events: none;
  }
  .mj-indalo-section > * { position: relative; }
  .mj-indalo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) { .mj-indalo-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }

  .mj-indalo-chapter { color: var(--mj-indalo); }
  .mj-indalo-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0;
  }
  .mj-indalo-title em { color: var(--mj-indalo); }
  .mj-indalo-lead {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 54ch;
  }
  .mj-indalo-lead strong { color: var(--mj-indalo-d); font-weight: 700; }

  .mj-indalo-facts {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--mj-ink);
    background: var(--mj-white);
  }
  @media (min-width: 640px) { .mj-indalo-facts { grid-template-columns: 1fr 1fr; } }
  .mj-indalo-facts li {
    padding: .85rem 1rem;
    border-bottom: 1px solid var(--mj-ink);
    display: flex; flex-direction: column; gap: 2px;
  }
  @media (min-width: 640px) {
    .mj-indalo-facts li:nth-child(odd) { border-right: 1px solid var(--mj-ink); }
    .mj-indalo-facts li:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .mj-indalo-facts li:last-child { border-bottom: none; }
  }
  .mj-indalo-facts__k { font-size: .58rem; letter-spacing: .2em; color: var(--mj-bougainvillea); font-weight: 800; }
  .mj-indalo-facts__v { font-size: .9rem; color: var(--mj-ink); font-weight: 600; line-height: 1.35; }

  .mj-indalo-r {
    max-width: 360px;
    margin: 0 auto;
  }
  .mj-indalo-anim {
    transform-origin: center;
    animation: mj-indalo-breath 4s ease-in-out infinite;
  }
  @keyframes mj-indalo-breath {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.85; transform: scale(1.02); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* 2 ZONAS                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .mj-zonas-section {
    background: var(--mj-white);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--mj-ink);
  }
  .mj-zonas {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .mj-zonas { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  .mj-zona {
    position: relative;
    background: var(--mj-white);
    border: 3px solid var(--mj-ink);
    box-shadow: var(--mj-shadow);
    padding: 1.75rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .mj-zona:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .mj-zona--pueblo { color: var(--mj-indalo); background: var(--mj-paper-2); }
  .mj-zona--playa  { color: var(--mj-indigo); background: var(--mj-paper); }

  .mj-zona__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
  }
  .mj-zona__code {
    background: var(--mj-ink);
    color: var(--mj-lime);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    border: 2px solid currentColor;
  }
  .mj-zona__elev {
    font-size: .7rem;
    color: currentColor;
    font-weight: 800;
    letter-spacing: .12em;
  }
  .mj-zona__icon {
    width: 100%;
    max-width: 200px;
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .mj-zona__name {
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1;
    letter-spacing: -.025em;
    color: var(--mj-ink);
    margin: .5rem 0 0;
    text-align: center;
  }
  .mj-zona__sub {
    font-size: .62rem;
    letter-spacing: .25em;
    color: currentColor;
    font-weight: 800;
    text-align: center;
  }
  .mj-zona__desc {
    font-size: .92rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
  }
  .mj-zona__tags {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .35rem;
    padding-top: .75rem;
    border-top: 2px solid currentColor;
  }
  .mj-zona__tags li {
    font-family: var(--font-mono);
    font-size: .72rem;
    color: var(--mj-ink);
    letter-spacing: .05em;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* IDIOMAS                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .mj-idiomas-section {
    background: var(--mj-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--mj-ink);
  }
  .mj-idiomas {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px)  { .mj-idiomas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .mj-idiomas { grid-template-columns: repeat(4, 1fr); } }
  .mj-idioma {
    background: var(--mj-white);
    border: 2.5px solid var(--mj-ink);
    box-shadow: 6px 6px 0 var(--mj-ink);
    transition: transform .25s, box-shadow .25s;
  }
  .mj-idioma:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--mj-bougainvillea); }
  .mj-idioma--0 { --mj-idioma-tint: rgba(170,21,27,0.08); }
  .mj-idioma--1 { --mj-idioma-tint: rgba(1,33,105,0.08); }
  .mj-idioma--2 { --mj-idioma-tint: rgba(255,206,0,0.10); }
  .mj-idioma--3 { --mj-idioma-tint: rgba(0,35,149,0.08); }
  .mj-idioma__head {
    display: flex; align-items: center; gap: .85rem;
    padding: 1rem 1.25rem;
    border-bottom: 2px solid var(--mj-ink);
    background: var(--mj-idioma-tint);
  }
  .mj-idioma__flag {
    width: 50px;
    flex-shrink: 0;
    border: 1.5px solid var(--mj-ink);
    line-height: 0;
  }
  .mj-idioma__head-r { display: flex; flex-direction: column; gap: 2px; }
  .mj-idioma__code {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--mj-bougainvillea);
    letter-spacing: .1em;
    line-height: 1;
  }
  .mj-idioma__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--mj-ink);
  }
  .mj-idioma__body {
    padding: 1rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
  }
  .mj-idioma__row {
    display: flex; flex-direction: column; gap: 2px;
    padding-bottom: .5rem;
    border-bottom: 1px dashed rgba(14,13,11,0.15);
  }
  .mj-idioma__row:last-child { border-bottom: none; padding-bottom: 0; }
  .mj-idioma__k { font-size: .55rem; letter-spacing: .2em; color: var(--mj-indalo); font-weight: 800; }
  .mj-idioma__v { font-size: .85rem; color: var(--mj-ink); line-height: 1.35; }
  .mj-idioma__keyword { font-family: var(--font-mono); color: var(--mj-indigo); font-weight: 700; }

  /* ═══════════════════════════════════════════════════════ */
  /* MAPA                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .mj-map-section {
    background: var(--mj-cream);
    border-bottom: 3px solid var(--mj-ink);
  }
  .mj-map-head { padding: 4rem 0 2rem; }
  .mj-map-head__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: end;
  }
  @media (min-width: 768px) { .mj-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .mj-map-chapter { color: var(--mj-bougainvillea); }
  .mj-map-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 0;
  }
  .mj-map-title em { color: var(--mj-bougainvillea); }
  .mj-map-coords {
    background: var(--mj-indalo);
    color: var(--mj-white);
    padding: 1rem 1.25rem;
    border: 2px solid var(--mj-ink);
    box-shadow: 5px 5px 0 var(--mj-bougainvillea);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem;
    letter-spacing: .15em;
  }

  .mj-map-frame {
    position: relative;
    border-top: 3px solid var(--mj-ink);
    border-bottom: 3px solid var(--mj-ink);
    background: var(--mj-ink);
  }
  .mj-map-bouga {
    position: absolute;
    width: 60px; height: 60px;
    z-index: 5;
    pointer-events: none;
    filter: drop-shadow(0 4px 10px rgba(199,53,114,0.4));
  }
  .mj-map-bouga--tl { top: 16px; left: 16px; transform: rotate(-15deg); }
  .mj-map-bouga--br { bottom: 16px; right: 16px; transform: rotate(20deg); }

  .mj-map-wrap {
    width: 100%;
    height: clamp(420px, 60vh, 600px);
    overflow: hidden;
  }
  .mj-map-wrap > * { width: 100%; height: 100%; }

  .mj-map-pin {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -100%);
    z-index: 4;
    pointer-events: none;
    filter: drop-shadow(0 6px 14px rgba(197,81,46,0.55));
    animation: mj-pin-bounce 2.8s ease-in-out infinite;
  }
  @keyframes mj-pin-bounce {
    0%, 100% { transform: translate(-50%, -100%); }
    50%      { transform: translate(-50%, -112%); }
  }
  .mj-map-pin__label {
    position: absolute;
    bottom: -22px; left: 50%;
    transform: translateX(-50%);
    background: var(--mj-ink);
    color: var(--mj-bougainvillea);
    padding: .2rem .55rem;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 1.5px solid var(--mj-bougainvillea);
    white-space: nowrap;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* SECTORES                                                */
  /* ═══════════════════════════════════════════════════════ */
  .mj-sec-section {
    background: var(--mj-white);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--mj-ink);
  }
  .mj-sec {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .mj-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .mj-sec { grid-template-columns: repeat(3, 1fr); } }
  .mj-sec__card {
    background: var(--mj-white);
    border: 2.5px solid var(--mj-ink);
    box-shadow: var(--mj-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .mj-sec__card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .mj-sec__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 12px 12px 0 currentColor;
  }
  .mj-sec__card--indalo        { color: var(--mj-indalo); }
  .mj-sec__card--bougainvillea { color: var(--mj-bougainvillea); }
  .mj-sec__card--indigo        { color: var(--mj-indigo); }
  .mj-sec__card--clay          { color: var(--mj-clay); }
  .mj-sec__card--olive         { color: var(--mj-olive); }
  .mj-sec__card--sun           { color: var(--mj-sun); }

  .mj-sec__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
    gap: .5rem;
  }
  .mj-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .mj-sec__stat-box {
    background: var(--mj-ink); color: var(--mj-white);
    padding: .35rem .65rem;
    display: flex; flex-direction: column; gap: 0;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .mj-sec__stat-v { font-size: .95rem; font-weight: 800; color: currentColor; line-height: 1; }
  .mj-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .mj-sec__title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    color: var(--mj-ink);
    margin: 0;
  }
  .mj-sec__desc {
    font-size: .88rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
    flex: 1;
  }
  .mj-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .mj-sec__tag {
    display: flex; align-items: flex-start; gap: .35rem;
    font-size: .78rem;
    line-height: 1.35;
    color: var(--mj-ink);
  }
  .mj-sec__tag span { color: currentColor; font-weight: 800; }
  .mj-sec__foot {
    padding-top: .65rem;
    border-top: 2px solid var(--mj-ink);
  }
  .mj-sec__cta {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PROCESO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .mj-proc-section {
    background: var(--mj-ink);
    color: var(--mj-white);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--mj-ink);
    position: relative;
    overflow: hidden;
  }
  .mj-proc-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(199,53,114,0.08) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .mj-proc-section > * { position: relative; }
  .mj-proc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px)  { .mj-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .mj-proc { grid-template-columns: repeat(4, 1fr); } }
  .mj-proc__step {
    background: rgba(250,250,245,0.05);
    border: 2px solid var(--mj-white);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .mj-proc__step:hover { background: rgba(199,53,114,0.12); transform: translateY(-3px); }
  .mj-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(250,250,245,0.25); }
  .mj-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--mj-sun); line-height: 1; }
  .mj-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--mj-bougainvillea); }
  .mj-proc__t {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--mj-white);
    margin: .25rem 0 0;
  }
  .mj-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(250,250,245,0.75); flex: 1; }
  .mj-proc__foot {
    font-size: .58rem;
    letter-spacing: .2em;
    color: var(--mj-sun);
    font-weight: 800;
    padding-top: .5rem;
    border-top: 1.5px solid rgba(250,250,245,0.25);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* DIFERENCIALES                                           */
  /* ═══════════════════════════════════════════════════════ */
  .mj-dif-section {
    background: var(--mj-white);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--mj-ink);
  }
  .mj-dif {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--mj-ink);
  }
  @media (min-width: 768px) { .mj-dif { grid-template-columns: 1fr 1fr; } }
  .mj-dif__item {
    padding: 1.75rem 1.5rem;
    border-bottom: 1px solid var(--mj-ink);
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .2s;
  }
  @media (min-width: 768px) {
    .mj-dif__item:nth-child(odd) { border-right: 1px solid var(--mj-ink); }
    .mj-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) {
    .mj-dif__item:last-child { border-bottom: none; }
  }
  .mj-dif__item--0 { background: var(--mj-paper-2); }
  .mj-dif__item--1 { background: var(--mj-paper); }
  .mj-dif__item--2 { background: var(--mj-cream); }
  .mj-dif__item--3 { background: var(--mj-paper); }
  .mj-dif__item:hover { background: var(--mj-lime); }
  .mj-dif__num { font-size: .85rem; color: var(--mj-bougainvillea); font-weight: 800; letter-spacing: .15em; }
  .mj-dif__t {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.05;
    letter-spacing: -.025em;
    color: var(--mj-ink);
    margin: 0;
  }
  .mj-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .mj-quote-section {
    background: var(--mj-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--mj-ink);
  }
  .mj-pull {
    position: relative;
    background: var(--mj-cream);
    border: 3px solid var(--mj-ink);
    box-shadow: var(--mj-shadow);
    padding: 3rem 2rem 2rem;
    margin: 2rem 0;
  }
  .mj-pull__seal {
    position: absolute;
    top: -30px; right: 30px;
    width: 90px; aspect-ratio: 1;
    transform: rotate(-10deg);
    filter: drop-shadow(0 4px 8px rgba(197,81,46,0.4));
  }
  .mj-pull__q {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.3;
    margin: 0 0 1.5rem;
    color: var(--mj-ink);
    max-width: 56ch;
  }
  .mj-pull__cap { display: flex; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 2px dashed var(--mj-ink); }
  .mj-pull__avatar {
    width: 48px; height: 48px;
    background: var(--mj-indalo); color: var(--mj-white);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-size: 1.35rem; font-weight: 800;
    border-radius: 50%;
  }
  .mj-pull__cap div { display: flex; flex-direction: column; }
  .mj-pull__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--mj-ink); }
  .mj-pull__role { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; opacity: .65; text-transform: uppercase; }

  .mj-quotes {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .mj-quotes { grid-template-columns: repeat(3, 1fr); } }
  .mj-quote {
    position: relative;
    background: var(--mj-white);
    border: 2px solid var(--mj-ink);
    box-shadow: 5px 5px 0 var(--mj-ink);
    padding: 1.75rem 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .mj-quote:hover { transform: translateY(-3px); }
  .mj-quote--0 { background: var(--mj-white); }
  .mj-quote--1 { background: var(--mj-paper-2); }
  .mj-quote--2 { background: var(--mj-cream); }
  .mj-quote__mark {
    position: absolute;
    top: -8px; left: 14px;
    font-family: serif;
    font-size: 4rem;
