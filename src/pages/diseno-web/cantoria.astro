  .ct-quote { position: relative; background: var(--ct-paper); border: 2px solid var(--ct-ink); box-shadow: 5px 5px 0 var(--ct-ink); padding: 1.75rem 1.5rem 1.25rem; display: flex; flex-direction: column; gap: 1rem; transition: transform .25s; }
