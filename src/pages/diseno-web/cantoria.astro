  .ct-icono--ink:hover     { box-shadow: 12px 12px 0 var(--ct-stone); }
  .ct-icono__code { width: 80px; height: 80px; flex-shrink: 0; }
  .ct-icono__letter { font-family: var(--font-display); font-size: 2.5rem; font-weight: 800; line-height: 1; letter-spacing: -.04em; color: var(--ct-accent); }
  .ct-icono--quarry .ct-icono__letter { color: var(--ct-quarry); }
  .ct-icono--blue .ct-icono__letter   { color: var(--ct-blue); }
  .ct-icono--ink .ct-icono__letter    { color: var(--ct-stone); }
  .ct-icono__name { font-size: clamp(1.2rem, 2.2vw, 1.5rem); line-height: 1; letter-spacing: -.025em; color: var(--ct-tinta); margin: 0; }
