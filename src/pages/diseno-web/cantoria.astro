  .ct-postcard__tag { position: absolute; bottom: 12px; left: 12px; background: var(--ct-paper); color: var(--ct-tinta); padding: .4rem .75rem; font-size: .65rem; font-weight: 800; letter-spacing: .2em; border: 2px solid var(--ct-ink); box-shadow: 3px 3px 0 var(--ct-accent); transform: rotate(-2deg); }
