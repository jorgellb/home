  .ct-icono--quarry .ct-icono__sub { color: var(--ct-quarry); }
  .ct-icono--blue .ct-icono__sub   { color: var(--ct-blue); }
  .ct-icono--ink .ct-icono__sub    { color: var(--ct-stone); }
  .ct-icono__desc { font-size: .82rem; line-height: 1.45; color: var(--ct-tenue); margin: 0; flex: 1; }
  .ct-icono__dato { font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; color: var(--ct-tinta); border-top: 2px dashed var(--ct-ink); padding-top: .5rem; width: 100%; }

  /* FLAGSHIP */
  .ct-flagship-section { background: var(--ct-stone-hondo); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ct-ink); position: relative; overflow: hidden; }
  .ct-flagship-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(30,74,107,0.04) 1.2px, transparent 1.2px); background-size: 22px 22px; pointer-events: none; }
