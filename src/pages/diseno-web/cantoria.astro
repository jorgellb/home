  @media (min-width: 1024px) { .ct-iconos { grid-template-columns: repeat(4, 1fr); } }
  .ct-icono { display: flex; flex-direction: column; gap: .5rem; padding: 2rem 1.5rem; background: var(--ct-paper); border: 2.5px solid var(--ct-ink); box-shadow: var(--ct-shadow); align-items: center; text-align: center; transition: transform .25s, box-shadow .25s; }
