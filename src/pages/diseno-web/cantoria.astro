  @media (min-width: 640px) { .ct-flagship-facts li:nth-child(odd) { border-right: 1px solid var(--ct-ink); } .ct-flagship-facts li:nth-last-child(-n+2) { border-bottom: none; } }
  @media (max-width: 639px) { .ct-flagship-facts li:last-child { border-bottom: none; } }
  .ct-flagship-facts__k { font-size: .58rem; letter-spacing: .2em; color: var(--ct-blue); font-weight: 800; }
