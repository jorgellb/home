<style>
  /* ═══════════════════════════════════════════════ */
  /* CANTORIA DESIGN SYSTEM                           */
  /* ═══════════════════════════════════════════════ */

  /* Fase 2 · consola. La paleta estaba en :root, que Astro no scopea: pasa
     a .ct, el <main> de esta página. paper hacía de fondo y de tinta clara a
     la vez, e ink de borde, sombra, fondo y texto: cada uno se reparte. El
     azul y la pizarra no llegaban a 4,5:1 sobre suelo y suben; la piedra y
     la cantera eran fondos a sangre claros y se hunden. Las ilustraciones
     llevan sus hex literales, para conservar su lámina clara (§3.3.6). */
  .ct {
    --ct-paper:       var(--color-cdm-panel);
    --ct-paper-2:     var(--color-cdm-panel-2);
    --ct-suelo:       var(--color-cdm-suelo);
    --ct-tinta:       var(--color-cdm-texto);
    --ct-tenue:       var(--color-cdm-tenue);
    --ct-ink:         var(--color-cdm-regla-2);
    --ct-stone:       #A09888;      /* piedra: acento y hover */
    --ct-stone-hondo: #2A2620;      /* piedra honda: solo fondo */
    --ct-quarry:      #B8A898;
    --ct-blue:        #4E9FE0;      /* azul, aclarado para leer */
    --ct-accent:      #D4A843;
    --ct-slate:       #8FA3B8;      /* pizarra, aclarada para leer */
    --ct-shadow:      8px 8px 0 var(--color-cdm-regla-2);

    background: var(--ct-suelo);
    color: var(--ct-tinta);
  }

  /* Globales heredados, que venían en tinta oscura sobre papel. */
  .ct :global(.brutal-section-head__title) { color: var(--ct-tinta); }
  .ct :global(.brutal-section-head__lead) { color: var(--ct-tenue); }
  .ct :global(:where(.text-meta)) { color: var(--ct-tenue); } /* :where: sin especificidad, para que el color propio de cada capítulo mande */
  .ct :global(.divider-brutal) { background: var(--color-cdm-regla); }

  .ct section[id] { scroll-margin-top: 96px; }

  /* El enlace al índice de municipios estaba suelto y con estilos inline,
     fuera de todo contenedor: se iba a sangre. */
  .ct-todos { background: var(--ct-suelo); padding: 2.5rem 1.5rem; text-align: center; }
  .ct-todos a { font-weight: 700; font-size: 1.05rem; color: var(--ct-accent); text-decoration: underline; text-underline-offset: 3px; }

  /* Raíl del índice: banda izquierda a partir de 1280 px, fuera de la caja
     de contenido; por debajo, solo la barra de progreso. */
  @media (min-width: 1280px) {
    .ct :global(.cdm-indice) {
      position: fixed;
      top: 96px;
      left: 0;
      width: 208px;
      padding-inline: clamp(1rem, 2vw, 1.75rem) 1rem;
      z-index: 30;
    }
    .ct :global(.container-brutal) { padding-left: calc(var(--container-gutter) + 208px); }
    .ct-map-frame { padding-left: 208px; }
  }
  @media (max-width: 1279px) {
    .ct :global(.cdm-indice) {
      display: block;
      position: sticky;
      top: 64px;
      z-index: 40;
      background: var(--ct-suelo);
      border-bottom: 1px solid var(--color-cdm-regla);
    }
    .ct :global(.cdm-indice__titulo),
    .ct :global(.cdm-indice__lista),
    .ct :global(.cdm-indice__coord) { display: none; }
    .ct :global(.cdm-indice__progreso) { height: 3px; background: transparent; }
  }

  .ct-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--ct-accent);
    box-shadow: 0 0 0 0 rgba(212,168,67,0.55);
    animation: ct-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes ct-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(212,168,67,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(212,168,67,0); }
    100% { box-shadow: 0 0 0 0 rgba(212,168,67,0); }
  }
  .ct-pull__spin { transform-origin: 50% 50%; animation: ct-spin 24s linear infinite; }
  @keyframes ct-spin { to { transform: rotate(360deg); } }
  .ct-final-gear { transform-origin: 50% 50%; animation: ct-gear-spin 20s linear infinite; }
  @keyframes ct-gear-spin { to { transform: rotate(360deg); } }
  .ct-export-svg .ct-export-gear { transform-origin: 50% 50%; animation: ct-gear-spin 18s linear infinite; }

  /* HERO */
  .ct-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 65% 30%, rgba(212,168,67,0.08), transparent 50%),
      radial-gradient(circle at 30% 70%, rgba(30,74,107,0.08), transparent 50%),
      var(--ct-suelo);
    border-bottom: 3px solid var(--ct-ink);
    position: relative;
    overflow: hidden;
  }
  .ct-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(45deg, transparent 0 22px, rgba(212,168,67,0.05) 22px 23px, transparent 23px 44px),
      linear-gradient(-45deg, transparent 0 22px, rgba(212,168,67,0.05) 22px 23px, transparent 23px 44px);
    pointer-events: none;
  }
  .ct-hero > * { position: relative; }
  .ct-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .ct-hero__status { color: var(--ct-accent); font-weight: 700; }
  .ct-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .ct-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .ct-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .ct-hero__chapter { color: var(--ct-blue); }
  .ct-hero__title { font-size: clamp(2.5rem, 7vw, 5rem); line-height: .92; letter-spacing: -.04em; margin: .25rem 0; }
  .ct-hero__title em { color: var(--ct-blue); font-style: italic; }
  .ct-hero__title-stamp { display: inline-block; color: var(--ct-suelo); background: var(--ct-accent); padding: 0 .2em; transform: rotate(-1deg); }
  .ct-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--ct-tenue); max-width: 54ch; }
  .ct-hero__lead strong { color: var(--ct-tinta); font-weight: 700; }
  .ct-hero__lead em { color: var(--ct-accent); font-style: italic; font-weight: 600; }
  .ct-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .ct-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--ct-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .ct-btn--primary { background: var(--ct-accent); color: var(--ct-suelo); box-shadow: 6px 6px 0 var(--ct-ink); }
  .ct-btn--primary:hover { background: var(--ct-blue); color: var(--ct-suelo); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--ct-ink); }
  .ct-btn--ghost { background: transparent; color: var(--ct-tinta); box-shadow: 6px 6px 0 var(--ct-stone); }
  .ct-btn--ghost:hover { background: var(--ct-ink); color: var(--ct-accent); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--ct-stone); }

  /* KPIs */
  .ct-kpis { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; margin-top: 1.5rem; border: 2.5px solid var(--ct-ink); background: var(--ct-ink); }
  @media (min-width: 768px) { .ct-kpis { grid-template-columns: repeat(4, 1fr); } }
  .ct-kpi { background: var(--ct-paper); padding: 1.25rem; display: flex; flex-direction: column; gap: .35rem; border-right: 2px solid var(--ct-ink); border-bottom: 2px solid var(--ct-ink); }
  .ct-kpi:nth-child(2n) { border-right: none; }
  .ct-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .ct-kpi:nth-child(2n)       { border-right: 2px solid var(--ct-ink); }
    .ct-kpi:nth-child(4n)       { border-right: none; }
    .ct-kpi:nth-last-child(-n+2)  { border-bottom: 2px solid var(--ct-ink); }
    .ct-kpi:nth-last-child(-n+4)  { border-bottom: none; }
  }
  .ct-kpi--quarry { background: var(--ct-quarry); color: var(--ct-suelo); }
  .ct-kpi--blue   { background: var(--ct-blue); color: var(--ct-suelo); }
  .ct-kpi--accent { background: var(--ct-accent); color: var(--ct-suelo); }
  .ct-kpi--ink    { background: var(--ct-stone-hondo); color: var(--ct-tinta); }
  .ct-kpi--ink .ct-kpi__v { color: var(--ct-accent); }
  .ct-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .ct-kpi__v small { font-size: .55em; opacity: .8; }
  .ct-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .ct-hero__postcard { width: 100%; max-width: 540px; margin: 0 auto; filter: drop-shadow(0 14px 30px rgba(26,24,22,0.18)); }
  .ct-postcard { background: var(--ct-paper); border: 3px solid var(--ct-ink); box-shadow: var(--ct-shadow); overflow: hidden; transform: rotate(-1deg); transition: transform .35s; }
  .ct-postcard:hover { transform: rotate(0); }
  .ct-postcard__head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; padding: .65rem 1rem; background: var(--ct-ink); color: var(--ct-tinta); font-size: .58rem; letter-spacing: .15em; border-bottom: 2px solid var(--ct-ink); }
  .ct-postcard__profile { width: 100%; aspect-ratio: 540 / 220; border-bottom: 2px solid var(--ct-ink); overflow: hidden; }
  .ct-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--ct-ink); }
  .ct-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.1); transition: transform .6s cubic-bezier(.16,1,.3,1); }
