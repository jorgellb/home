  @media (min-width: 1024px) { .ct-sec { grid-template-columns: repeat(3, 1fr); } }
  .ct-sec__card { background: var(--ct-paper); border: 2.5px solid var(--ct-ink); box-shadow: var(--ct-shadow); padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem; transition: transform .25s, box-shadow .25s; position: relative; overflow: hidden; }
