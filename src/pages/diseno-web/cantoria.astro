  @keyframes ct-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ICONOS */
  .ct-iconos-section { background: var(--ct-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--ct-ink); position: relative; overflow: hidden; }
  .ct-iconos-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(212,168,67,0.04) 1.2px, transparent 1.2px); background-size: 24px 24px; pointer-events: none; }
