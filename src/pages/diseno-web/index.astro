---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { pueblos, comarcas, comarcaColors, getPueblosByComarca } from '../../data/pueblos-almeria';

const title = 'Diseño Web en toda la Provincia de Almería | Agencia Local';
const description = 'Páginas web profesionales para cualquier municipio de Almería. Tiendas online, SEO local y hosting gratuito. Presupuesto sin compromiso en 24h.';
const canonical = 'https://platanitorico.com/diseno-web/';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Diseño web en toda la provincia de Almería - Platanito Rico"
  keywords="diseño web almería provincia, agencia web almería, páginas web pueblos almería, diseño web todas las localidades almería"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Diseño Web en toda la Provincia de Almería",
      "description": description,
      "url": canonical,
      "inLanguage": "es",
      "isPartOf": { "@type": "WebSite", "name": "Platanito Rico", "url": "https://platanitorico.com" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
          { "@type": "ListItem", "position": 2, "name": "Diseño Web por Localidad", "item": canonical }
        ]
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Platanito Rico — Diseño Web en Almería",
      "url": "https://platanitorico.com",
      "telephone": "+34657085019",
      "areaServed": { "@type": "AdministrativeArea", "name": "Almería" },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ctra de Ronda, 82",
        "addressLocality": "Vera",
        "addressRegion": "Almería",
        "postalCode": "04620",
        "addressCountry": "ES"
      }
    }
  ]}
>
  <Header />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Diseño Web por Localidad' }
  ]} />

  <main id="main-content" class="pt-6 pb-24">

    <!-- Hero -->
    <section class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-800 to-purple-950"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(139,92,246,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(139,92,246,0.05)_1px,transparent_1px)] bg-[size:60px_60px]"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-purple-500/10 rounded-full blur-[120px]"></div>

      <div class="relative max-w-4xl mx-auto px-6 text-center">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-sm text-white/70 mb-8">
          <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {pueblos.length} municipios · 7 comarcas · toda Almería
        </span>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          Diseño Web en<br/>
          <span class="bg-gradient-to-r from-purple-400 to-violet-300 bg-clip-text text-transparent">toda la Provincia</span>
        </h1>
        <p class="text-lg text-white/70 max-w-2xl mx-auto mb-10">
          Trabajamos con negocios de cualquier municipio de Almería. Encuentra tu localidad y descubre cómo podemos posicionar tu negocio en Google.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/contacto/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-purple-500 hover:bg-purple-600 text-white font-semibold transition-colors duration-200">
            Presupuesto gratis
          </a>
          <a href="/desarrollo-web/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/10 border border-white/20 hover:bg-white/20 text-white font-semibold transition-colors duration-200">
            Ver servicios
          </a>
        </div>
      </div>
    </section>

    <!-- Por comarca -->
    {comarcas.map(comarca => {
      const pueblosComarca = getPueblosByComarca(comarca);
      const colors = comarcaColors[comarca];
      if (!pueblosComarca.length) return null;
      return (
        <section class="py-16 border-b border-slate-100 last:border-0">
          <div class="max-w-6xl mx-auto px-6">
            <div class="flex items-center gap-4 mb-8">
              <span class={`inline-flex items-center gap-2 px-4 py-2 rounded-full border text-sm font-semibold ${colors.badge}`}>
                <svg class={`w-4 h-4 ${colors.icon}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                {comarca}
              </span>
              <span class="text-sm text-slate-400">{pueblosComarca.length} municipios</span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
              {pueblosComarca.map(p => (
                <a
                  href={`/diseno-web/${p.slug}/`}
                  class={`group relative flex flex-col p-4 rounded-2xl bg-white border border-slate-200 hover:border-slate-300 hover:shadow-md transition-all duration-200 ${colors.shadow}`}
                >
                  {p.destacado && (
                    <span class={`absolute top-2 right-2 w-2 h-2 rounded-full bg-gradient-to-br ${colors.gradient}`}></span>
                  )}
                  <span class="text-sm font-semibold text-slate-800 group-hover:text-slate-900 leading-tight mb-1">
                    {p.nombre}
                  </span>
                  {p.sectorPrincipal ? (
                    <span class="text-xs text-slate-400 line-clamp-2 leading-tight">{p.sectorPrincipal}</span>
                  ) : p.poblacion ? (
                    <span class="text-xs text-slate-400">{p.poblacion.toLocaleString('es-ES')} hab.</span>
                  ) : null}
                </a>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    <!-- CTA final -->
    <section class="py-20">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          ¿No encuentras tu municipio?
        </h2>
        <p class="text-slate-600 mb-8">
          Trabajamos con cualquier localidad de la provincia de Almería. Contáctanos y te hacemos un presupuesto personalizado para tu zona.
        </p>
        <a href="/contacto/" class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-semibold text-lg transition-colors duration-200">
          Consulta gratuita sin compromiso
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
