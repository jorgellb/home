---
import Sitio from '../../layouts/Sitio.astro';
import Boton from '../../components/sitio/Boton.astro';
import Icono from '../../components/sitio/Icono.astro';
import Ilustracion from '../../components/sitio/Ilustracion.astro';
import Encabezado from '../../components/sitio/Encabezado.astro';
import Migas from '../../components/sitio/Migas.astro';
import Puntos from '../../components/sitio/Puntos.astro';
import Preguntas from '../../components/sitio/Preguntas.astro';
import LlamadaFinal from '../../components/sitio/LlamadaFinal.astro';
import { comarcas, getPueblosByComarca, comarcaSlug, pueblos } from '../../data/pueblos-almeria';
import { esPuebloIndexable } from '../../data/pueblos-indexables';
import { COMARCAS_INFO } from '../../data/comarcas';
import { CONTACTO } from '../../data/navegacion';
import { PROVEEDOR, SITE } from '../../data/negocio';

const grupos = comarcas
  .map((c) => ({ comarca: c, id: comarcaSlug(c), info: COMARCAS_INFO[c], pueblos: getPueblosByComarca(c) }))
  .filter((g) => g.pueblos.length > 0);

const porque = [
  { icono: 'ubicacion' as const, t: 'SEO local de verdad', d: 'Web, ficha de Google y una página por servicio y zona, para ganar las búsquedas de tu pueblo y los de alrededor.' },
  { icono: 'globo' as const, t: 'Los idiomas de tus clientes', d: 'En la costa, inglés, alemán o francés. En el interior, versiones para distribuidores de fuera. Con SEO propio en cada uno.' },
  { icono: 'equipo' as const, t: 'Cerca de verdad', d: 'Estudio en Vera. Nos desplazamos para arrancar los proyectos y el resto lo trabajamos en remoto, sin perder el trato directo.' },
];

const preguntas = [
  { q: '¿Trabajáis con negocios de cualquier pueblo de Almería?', a: `<p>Sí. Tenemos el estudio en Vera y trabajamos con negocios de las ${grupos.length} comarcas de la provincia. Nos desplazamos para arrancar los proyectos; el día a día se trabaja en remoto.</p>` },
  { q: '¿Por qué una página por municipio?', a: '<p>Porque así busca la gente: «fontanero en Albox», «restaurante en Garrucha». Una web con páginas para cada servicio y cada zona donde trabajas tiene más opciones de aparecer en esas búsquedas que una sola portada.</p>' },
  { q: '¿Cuánto cuesta una web para un negocio de mi pueblo?', a: '<p>Depende de lo que necesite hacer la web: páginas, tienda, reservas o idiomas. Tras una llamada te enviamos una propuesta cerrada por escrito, sin compromiso.</p>' },
  { q: 'Mi pueblo no aparece en la lista', a: `<p>Escríbenos igual. Trabajamos en toda la provincia y fuera de ella; la lista recoge los municipios donde ya hemos estudiado su tejido de negocio.</p>` },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Diseño web en la provincia de Almería',
  url: `${SITE}/diseno-web/`,
  about: { '@type': 'Service', name: 'Diseño web', provider: PROVEEDOR, areaServed: { '@type': 'AdministrativeArea', name: 'Provincia de Almería' } },
};
---

<Sitio
  title="Diseño web en toda la provincia de Almería"
  description={`Diseño web y SEO local para negocios de ${pueblos.length} municipios de Almería, comarca a comarca. Webs a medida, rápidas y a tu nombre. Estudio en Vera.`}
  canonical={`${SITE}/diseno-web/`}
  jsonLd={jsonLd}
>
  <section class="cabeza">
    <div class="contenedor cabeza__rejilla">
      <div class="cabeza__texto">
        <Migas items={[{ nombre: 'Diseño web por municipio' }]} />
        <p class="antetitulo">Dónde trabajamos</p>
        <h1>Diseño web en toda la provincia de <span class="subrayado">Almería</span></h1>
        <p class="entradilla">
          No compite igual un restaurante en Mojácar que una cantera en Macael. Para cada municipio hemos estudiado sus
          sectores y lo que buscan sus clientes. Busca el tuyo.
        </p>
        <nav class="saltos" aria-label="Comarcas">
          {grupos.map((g) => <a href={`#${g.id}`}>{g.comarca}</a>)}
        </nav>
      </div>
      <Ilustracion nombre="mapa" titulo="Mapa isométrico de la provincia de Almería con los municipios donde trabajamos" class="cabeza__ilustracion" prioridad />
    </div>
  </section>

  <section class="seccion seccion--blanca" aria-labelledby="porque-titulo">
    <div class="contenedor">
      <Encabezado id="porque-titulo" antetitulo="Por qué local" titulo="Una web pensada para ganar en tu zona" />
      <Puntos items={porque} sobre="blanco" />
    </div>
  </section>

  {grupos.map((g, n) => (
    <section class:list={['seccion', 'comarca', { 'seccion--blanca': n % 2 === 1 }]} id={g.id} aria-labelledby={`${g.id}-titulo`}>
      <div class="contenedor comarca__rejilla">
        <div class="comarca__cabeza">
          <p class="antetitulo">{g.pueblos.length} municipios</p>
          <h2 id={`${g.id}-titulo`}>{g.comarca}</h2>
          {g.info && <p class="comarca__intro">{g.info.intro}</p>}
          {g.info?.sectores && <ul class="etiquetas">{g.info.sectores.map((s) => <li>{s}</li>)}</ul>}
        </div>
        <ul class="municipios">
          {g.pueblos.map((p) => (
            <li>
              <a href={`/diseno-web/${p.slug}/`} class:list={['municipio', { 'municipio--destacado': esPuebloIndexable(p.slug) }]}>
                <span class="municipio__nombre">{p.nombre}</span>
                <span class="municipio__dato">{p.sectorPrincipal ?? (p.poblacion ? `${p.poblacion.toLocaleString('es-ES')} hab.` : g.comarca)}</span>
                <Icono nombre="chevron" tamano={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="seccion seccion--blanca" aria-labelledby="preguntas-titulo">
    <div class="contenedor dos-columnas">
      <div>
        <Encabezado id="preguntas-titulo" antetitulo="Preguntas" titulo="Lo que pregunta todo negocio" />
        <Boton href={CONTACTO.telefonoHref} variante="secundario" icono="telefono">Llamar al {CONTACTO.telefono}</Boton>
      </div>
      <Preguntas preguntas={preguntas} />
    </div>
  </section>

  <LlamadaFinal servicio="web" />
</Sitio>

<style>
  .cabeza {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .cabeza__rejilla {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .cabeza__texto {
    display: grid;
    gap: 1.25rem;
  }
  .cabeza h1 {
    font-size: var(--t-3xl);
    max-width: 18ch;
  }
  .cabeza :global(.cabeza__ilustracion) {
    max-width: 600px;
    justify-self: center;
  }
  @media (min-width: 960px) {
    .cabeza__rejilla {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .saltos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .saltos a {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--linea-2);
    border-radius: 999px;
    background: var(--superficie);
    font-size: var(--t-s);
    font-weight: 600;
    text-decoration: none;
  }
  .saltos a:hover {
    border-color: var(--verde);
    color: var(--verde);
  }
  .comarca__rejilla {
    display: grid;
    gap: 2rem;
  }
  .comarca__cabeza {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .comarca__cabeza h2 {
    font-size: var(--t-2xl);
  }
  .comarca__intro {
    color: var(--tinta-2);
  }
  .etiquetas {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .etiquetas li {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--verde-suave);
    color: var(--verde);
    font-size: var(--t-xs);
    font-weight: 700;
  }
  .municipios {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    align-content: start;
  }
  .municipio {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 0.5rem;
    align-items: center;
    height: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--superficie);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .seccion--blanca .municipio {
    background: var(--fondo);
  }
  .municipio:hover {
    border-color: var(--verde);
  }
  .municipio--destacado {
    border-color: var(--linea-2);
  }
  .municipio__nombre {
    font-weight: 680;
  }
  .municipio--destacado .municipio__nombre::after {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-left: 0.45rem;
    vertical-align: middle;
    background: var(--platano);
    transform: rotate(45deg);
    border-radius: 1px;
  }
  .municipio__dato {
    grid-column: 1;
    font-size: var(--t-xs);
    color: var(--tenue);
    line-height: 1.35;
  }
  .municipio :global(.icono) {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: var(--verde);
  }
  @media (min-width: 1000px) {
    .comarca__rejilla {
      grid-template-columns: 0.75fr 1.25fr;
      gap: 3.5rem;
    }
    .comarca__cabeza {
      position: sticky;
      top: 6rem;
    }
  }
  .dos-columnas {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 960px) {
    .dos-columnas {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
    }
  }
</style>
