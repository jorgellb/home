---
/* Hub de diseño web por localidad (centro de mando, spec §6.3): plantilla de
   lectura con el radar de cobertura en la cabecera y un índice lateral por
   comarcas. Los id de cada comarca se conservan: la home enlaza a
   /diseno-web/#<comarca>. */
import LecturaLayout from '../../layouts/LecturaLayout.astro';
import Boton from '../../components/cdm/Boton.astro';
import Fichas from '../../components/cdm/Fichas.astro';
import ListaEnlaces from '../../components/cdm/ListaEnlaces.astro';
import Preguntas from '../../components/cdm/Preguntas.astro';
import RadarCobertura from '../../components/cdm/RadarCobertura.astro';
import SeccionLectura from '../../components/cdm/SeccionLectura.astro';
import type { Cifra, SeccionIndice } from '../../components/cdm/tipos';
import { pueblos, comarcas, getPueblosByComarca, comarcaSlug } from '../../data/pueblos-almeria';

const title = 'Diseño Web en la Provincia de Almería';
const description = 'Diseño web y SEO local para negocios de cualquier pueblo de Almería: 8 comarcas, +90 municipios. Tiendas online y hosting incluido. Presupuesto en 24h.';
const canonical = 'https://platanitorico.com/diseno-web/';

/* Contexto económico real + oportunidad digital por comarca (contenido único, anti-boilerplate) */
const comarcaInfo: Record<string, { intro: string; sectores: string[] }> = {
  "Almería Metropolitana": {
    intro: "El motor económico de la provincia: la capital, su puerto y el gran polo turístico de Roquetas de Mar concentran el grueso del comercio, la hostelería y los servicios profesionales. Aquí la competencia digital es máxima, y una web rápida con SEO local bien trabajado marca la diferencia entre aparecer o desaparecer ante miles de clientes que buscan cada día.",
    sectores: ["Turismo", "Comercio", "Servicios", "Puerto"],
  },
  "Levante Almeriense": {
    intro: "La costa turística por excelencia: Mojácar, Vera, Garrucha y Pulpí viven del turismo, la hostelería y el residente extranjero, con una demanda multilingüe y muy estacional. Captar reservas, vender segunda residencia o llenar un restaurante aquí exige una web que posicione en varios idiomas y convierta al visitante en cliente antes de que llegue.",
    sectores: ["Turismo costero", "Hostelería", "Residencial", "Náutica"],
  },
  "Valle del Almanzora": {
    intro: "El gran corredor industrial del interior: Macael y Olula del Río exportan mármol blanco a más de 60 países, mientras Albox concentra el comercio que abastece a toda la comarca. Un tejido de pymes industriales y comerciales con clientes nacionales e internacionales, donde una web profesional y multilingüe es una herramienta de venta directa, no un simple escaparate.",
    sectores: ["Mármol", "Industria", "Comercio", "Exportación"],
  },
  "Los Filabres-Tabernas": {
    intro: "Tierra de cine y cielos infinitos: el desierto de Tabernas, único de Europa, atrae rodajes y turismo, mientras los Filabres guardan el Observatorio de Calar Alto y un naciente turismo de naturaleza y astronomía. Negocios singulares con un público de nicho —turismo activo, experiencias, productos de origen— que solo encuentran a su cliente si destacan online.",
    sectores: ["Cine y turismo", "Astronomía", "Energía solar", "Naturaleza"],
  },
  "Poniente Almeriense": {
    intro: "La huerta de Europa: El Ejido, Vícar y La Mojonera concentran el mayor mar de invernaderos del mundo, un sector hortofrutícola que mueve miles de millones y exporta a todo el continente. Conviven la agroindustria exportadora y un denso tejido comercial; ambos necesitan webs corporativas serias, multilingües y orientadas a captar distribuidores y clientes.",
    sectores: ["Agricultura intensiva", "Exportación", "Agroindustria", "Comercio"],
  },
  "Alpujarra Almeriense": {
    intro: "La Almería verde y auténtica: el valle del Andarax y las laderas de Sierra Nevada ofrecen vino, aceite, frutos secos y un turismo rural en alza que huye de la masificación. Pequeños productores y casas rurales con productos de identidad única que, bien contados en una web, alcanzan al consumidor gourmet y al viajero consciente de toda España.",
    sectores: ["Turismo rural", "Vino y aceite", "Agroalimentario", "Naturaleza"],
  },
  "Alto Almanzora": {
    intro: "El nacimiento del Almanzora, entre sierras: Serón y Tíjola lideran una comarca de gastronomía con sello —el jamón de Serón es marca reconocida—, naturaleza de montaña y patrimonio. Productos agroalimentarios de calidad y turismo de interior que encuentran su mejor mercado cuando una tienda online y un buen SEO los sacan de la comarca.",
    sectores: ["Agroalimentario", "Jamón de Serón", "Turismo de interior", "Patrimonio"],
  },
  "Los Vélez": {
    intro: "El norte monumental: Vélez-Blanco y Vélez-Rubio custodian castillos renacentistas, el Parque Natural de Sierra María y el arte rupestre que dio origen al Indalo, símbolo de Almería. Una comarca de turismo cultural, naturaleza y agroalimentario de altura cuyo gran reto es la visibilidad: estar en internet es estar en el mapa del viajero.",
    sectores: ["Turismo cultural", "Naturaleza", "Patrimonio", "Agroalimentario"],
  },
};

const valores = [
  { t: 'SEO local de verdad', d: 'Optimizamos tu web y tu ficha de Google Business para las búsquedas de tu municipio y comarca. Apareces cuando tu cliente te busca, no en la página diez.', href: '/marketing/', enlace: 'Ver SEO y marketing' },
  { t: 'Velocidad y Core Web Vitals', d: 'Webs ultrarrápidas que cargan en menos de un segundo. Google premia la velocidad y tus visitantes no se marchan esperando.', href: '/desarrollo-web/', enlace: 'Ver desarrollo web' },
  { t: 'Multilingüe donde importa', d: 'En la costa y el Almanzora el cliente habla varios idiomas. Tu web también, y posicionada en cada uno para captar al comprador internacional.', href: '/soluciones/ecommerce/', enlace: 'Ver tiendas online' },
  { t: 'Trato directo y cercano', d: 'Hablas siempre con quien hace tu web, no con un call center. Conocemos Almería porque trabajamos aquí, pueblo a pueblo.', href: '/contacto/', enlace: 'Hablar con nosotros' },
];

/* FAQ — contenido único + FAQPage schema (rich results) */
const faqs = [
  {
    q: "¿Cuánto cuesta una página web para un negocio en Almería?",
    a: "Una web profesional con Platanito Rico arranca desde 500 € (web corporativa); una landing de una página desde 350 € y una tienda online desde 700 €, con diseño a medida, hosting el primer año, certificado SSL y SEO local incluido. El precio final depende del número de páginas, de si necesitas tienda online y de los idiomas. Te damos presupuesto cerrado y sin sorpresas en 24 horas.",
  },
  {
    q: "¿Trabajáis con negocios de cualquier pueblo de la provincia?",
    a: "Sí. Cubrimos las 8 comarcas y más de 90 municipios de Almería, desde la capital hasta Los Vélez. Trabajamos en remoto y presencialmente cuando hace falta: la distancia no es problema y el trato es siempre directo y cercano.",
  },
  {
    q: "¿Qué es el SEO local y por qué lo necesito?",
    a: "El SEO local hace que tu negocio aparezca cuando alguien busca tu servicio en tu pueblo o «cerca de mí» (por ejemplo, «fontanero en Vera» o «restaurante en Mojácar»). Optimizamos tu web y tu ficha de Google Business para que captures esas búsquedas, que son las que traen clientes reales de tu zona.",
  },
  {
    q: "¿La web servirá para captar clientes extranjeros?",
    a: "En comarcas como el Levante o el Almanzora el cliente internacional es clave. Creamos webs multilingües (inglés, francés, alemán…) y las posicionamos en cada idioma, de modo que captes tanto al residente extranjero como al turista o comprador que busca desde fuera de España.",
  },
  {
    q: "¿Cuánto tarda en estar lista mi web?",
    a: "Una web corporativa estándar está lista en 2-4 semanas desde que tenemos los contenidos; una tienda online, algo más. Trabajamos con plazos cerrados y te mantenemos informado en cada fase del proyecto.",
  },
  {
    q: "¿Incluye mantenimiento y hosting?",
    a: "El primer año de hosting y el certificado SSL van incluidos. Después puedes contratar nuestro mantenimiento —copias de seguridad, actualizaciones, seguridad y soporte— sin permanencia, o gestionarlo por tu cuenta. Tú decides.",
  },
];

const comarcasConPueblos = comarcas
  .map((comarca) => ({ comarca, lista: getPueblosByComarca(comarca) }))
  .filter((c) => c.lista.length > 0);

const datosCabecera: Cifra[] = [
  { etiqueta: 'Municipios', valor: pueblos.length },
  { etiqueta: 'Comarcas', valor: comarcas.length },
  { etiqueta: 'Provincia cubierta', valor: 100, sufijo: ' %' },
  { etiqueta: 'Web profesional, desde', valor: 500, sufijo: ' €' },
];

const secciones: SeccionIndice[] = [
  { id: 'por-que', etiqueta: 'Por qué local' },
  ...comarcasConPueblos.map((c) => ({ id: comarcaSlug(c.comarca), etiqueta: c.comarca })),
  { id: 'faq', etiqueta: 'Preguntas' },
  { id: 'empezar', etiqueta: 'Empezar' },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Diseño Web en toda la Provincia de Almería",
    "description": description,
    "url": canonical,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "Platanito Rico", "url": "https://platanitorico.com" },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
        { "@type": "ListItem", "position": 2, "name": "Diseño Web por Localidad", "item": canonical }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Platanito Rico — Diseño Web en Almería",
    "url": "https://platanitorico.com",
    "telephone": "+34657085019",
    "areaServed": { "@type": "AdministrativeArea", "name": "Almería" },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ctra de Ronda, 82",
      "addressLocality": "Vera",
      "addressRegion": "Almería",
      "postalCode": "04620",
      "addressCountry": "ES"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<LecturaLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Diseño web en toda la provincia de Almería - Platanito Rico"
  jsonLd={jsonLd}
  migas={[{ label: 'Inicio', href: '/' }, { label: 'Diseño Web por Localidad' }]}
  h1="Diseño web en toda la provincia de Almería."
  entradilla={`Trabajamos con negocios de cualquier municipio de Almería. ${pueblos.length} localidades, ${comarcas.length} comarcas, una misma calidad. Encuentra tu pueblo y posiciónate en búsquedas locales.`}
  datos={datosCabecera}
  secciones={secciones}
  coordenadas="37,2471 N · 1,8673 O"
>
  <Fragment slot="acciones">
    <Boton href="/contacto/">Presupuesto gratis</Boton>
    <Boton href="/desarrollo-web/" variante="linea">Ver servicios</Boton>
  </Fragment>

  <RadarCobertura slot="lateral" />

  <SeccionLectura
    id="por-que"
    titulo="Una web pensada para vender en tu zona."
    lead="No hacemos plantillas genéricas. Cada negocio de Almería compite por un cliente concreto —el vecino que busca en Google, el turista que reserva desde otro país, el distribuidor que busca proveedor— y cada web que diseñamos está construida para ganar esa búsqueda."
  >
    <Fichas items={valores.map((v) => ({ titulo: v.t, texto: v.d, href: v.href, enlace: v.enlace }))} />
  </SeccionLectura>

  {comarcasConPueblos.map(({ comarca, lista }) => {
    const info = comarcaInfo[comarca];
    return (
      <SeccionLectura
        id={comarcaSlug(comarca)}
        meta={`${lista.length} municipios`}
        titulo={comarca}
        lead={info?.intro ?? `Municipios donde trabajamos en ${comarca}. Cada pueblo tiene su propia página con SEO local optimizado.`}
      >
        {info?.sectores && (
          <ul class="hub-chips">
            {info.sectores.map((sector) => <li>{sector}</li>)}
          </ul>
        )}
        <ListaEnlaces
          columnas={4}
          items={lista.map((p) => ({
            href: `/diseno-web/${p.slug}/`,
            label: p.nombre,
            sub: p.sectorPrincipal ?? (p.poblacion ? `${p.poblacion.toLocaleString('es-ES')} hab.` : comarca),
            destacado: p.destacado,
          }))}
        />
      </SeccionLectura>
    );
  })}

  <SeccionLectura
    id="faq"
    titulo="Lo que todo negocio pregunta."
    lead="Resolvemos las dudas más habituales sobre diseño web, SEO local y presupuestos para negocios de la provincia de Almería."
  >
    <Preguntas items={faqs} />
  </SeccionLectura>

  <SeccionLectura
    id="empezar"
    meta="¿No encuentras tu municipio?"
    titulo="Cubrimos toda Almería."
    lead="Si tu pueblo no está en el atlas, escríbenos. Trabajamos con cualquier localidad de la provincia y te hacemos presupuesto personalizado para tu zona."
  >
    <div class="hub-acciones">
      <Boton href="/contacto/">Consulta gratuita</Boton>
      <Boton href="tel:+34657085019" variante="linea">Llamar al 657 085 019</Boton>
    </div>
  </SeccionLectura>
</LecturaLayout>

<style>
  .hub-chips { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .hub-chips li { padding: 0.3rem 0.65rem; font-family: var(--font-mono); font-size: 0.74rem; color: var(--color-cdm-texto); border: 1px solid var(--color-cdm-regla-2); background: var(--color-cdm-panel-2); }
  .hub-acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
</style>
