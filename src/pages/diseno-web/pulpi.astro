<style>
  /* ══════════════════════════════════════════════════════
     PALETA · PULPÍ · GEODA GIGANTE · CRISTAL MÁGICO
     ══════════════════════════════════════════════════════ */
  .pu {
    --pu-paper:    #F3EEF9;       /* Lila cristal muy pálido */
    --pu-paper-2:  #E9E1F2;
    --pu-arena:    #DED2EC;
    --pu-ink:      #14111F;       /* Índigo casi negro */
    --pu-violet:   #7B4FA3;       /* Amatista (PRIMARY) */
    --pu-violet-d: #4E2E70;
    --pu-indigo:   #211A45;       /* Noche de mina */
    --pu-cyan:     #36B0C4;       /* Hielo cristal */
    --pu-amber:    #E0A33E;       /* Ámbar yeso / linterna */
    --pu-rose:     #DD7AA6;       /* Rosa cuarzo */
    --pu-green:    #4FA38C;       /* Campo de Pulpí */
    --pu-shadow:   8px 8px 0 var(--pu-ink);
  }
  .pu-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--pu-violet);
    box-shadow: 0 0 0 0 rgba(123,79,163,0.55);
    animation: pu-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes pu-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(123,79,163,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(123,79,163,0); }
    100% { box-shadow: 0 0 0 0 rgba(123,79,163,0); }
  }
  .pu-spin { transform-origin: 50% 50%; animation: pu-spin 30s linear infinite; }
  @keyframes pu-spin { to { transform: rotate(360deg); } }
  .pu-sparkle { animation: pu-twinkle 2.4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .pu-sparkle:nth-child(even) { animation-delay: -1.2s; }
  @keyframes pu-twinkle { 0%, 100% { opacity: .35; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.15); } }

  /* HERO */
  .pu-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 18%, rgba(123,79,163,0.14), transparent 50%),
      radial-gradient(circle at 12% 82%, rgba(54,176,196,0.12), transparent 50%),
      var(--pu-paper);
    border-bottom: 3px solid var(--pu-ink);
    position: relative;
    overflow: hidden;
  }
  .pu-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(120deg, transparent 0 38px, rgba(123,79,163,0.045) 38px 39px);
    pointer-events: none;
  }
  .pu-hero > * { position: relative; }
  .pu-hero__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-bottom: 1rem; }
  .pu-hero__status { color: var(--pu-violet); font-weight: 700; }
  .pu-hero__grid { display: grid; grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
  @media (min-width: 1024px) { .pu-hero__grid { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .pu-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .pu-hero__chapter { color: var(--pu-violet); }
  .pu-hero__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: .92;
    letter-spacing: -.04em;
    margin: .25rem 0;
  }
  .pu-hero__title em { color: var(--pu-violet); font-style: italic; }
  .pu-hero__title-stamp {
    display: inline-block;
    color: var(--pu-paper);
    background: var(--pu-cyan);
    padding: 0 .2em;
    transform: rotate(-1deg);
  }
  .pu-hero__lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 54ch; }
  .pu-hero__lead strong { color: var(--pu-ink); font-weight: 700; }
  .pu-hero__lead em { color: var(--pu-violet); font-style: italic; font-weight: 600; }
  .pu-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }

  .pu-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--pu-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .pu-btn--primary { background: var(--pu-violet); color: var(--pu-paper); box-shadow: 6px 6px 0 var(--pu-ink); }
  .pu-btn--primary:hover { background: var(--pu-cyan); color: var(--pu-ink); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--pu-ink); }
  .pu-btn--ghost { background: transparent; color: var(--pu-ink); box-shadow: 6px 6px 0 var(--pu-cyan); }
  .pu-btn--ghost:hover { background: var(--pu-ink); color: var(--pu-cyan); transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--pu-cyan); }

  /* KPIs */
  .pu-kpis {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--pu-ink);
    background: var(--pu-ink);
  }
  @media (min-width: 768px) { .pu-kpis { grid-template-columns: repeat(4, 1fr); } }
  .pu-kpi {
    background: var(--pu-paper); padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--pu-ink); border-bottom: 2px solid var(--pu-ink);
  }
  .pu-kpi:nth-child(2n) { border-right: none; }
  .pu-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .pu-kpi:nth-child(2n)      { border-right: 2px solid var(--pu-ink); }
    .pu-kpi:nth-child(4n)      { border-right: none; }
    .pu-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--pu-ink); }
    .pu-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .pu-kpi--violet { background: var(--pu-violet); color: var(--pu-paper); }
  .pu-kpi--cyan   { background: var(--pu-cyan); color: var(--pu-ink); }
  .pu-kpi--amber  { background: var(--pu-amber); color: var(--pu-ink); }
  .pu-kpi--ink    { background: var(--pu-ink); color: var(--pu-paper); }
  .pu-kpi--ink .pu-kpi__v { color: var(--pu-cyan); }
  .pu-kpi__v { font-size: clamp(1.65rem, 3.8vw, 2.25rem); font-weight: 800; line-height: 1; }
  .pu-kpi__v small { font-size: .55em; opacity: .8; }
  .pu-kpi__l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* POSTCARD */
  .pu-hero__postcard {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 30px rgba(20,17,31,0.28));
  }
  .pu-postcard {
    background: var(--pu-paper);
    border: 3px solid var(--pu-ink);
    box-shadow: var(--pu-shadow);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .35s;
  }
  .pu-postcard:hover { transform: rotate(0); }
  .pu-postcard__head {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: .5rem;
    padding: .65rem 1rem;
    background: var(--pu-violet);
    color: var(--pu-paper);
    font-size: .58rem;
    letter-spacing: .15em;
    border-bottom: 2px solid var(--pu-ink);
  }
  .pu-postcard__profile {
    width: 100%; aspect-ratio: 540 / 240;
    border-bottom: 2px solid var(--pu-ink);
    overflow: hidden;
    background: #161031;
  }
  .pu-postcard__img-wrap { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--pu-ink); }
  .pu-postcard__img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(1.08); transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .pu-postcard:hover .pu-postcard__img { transform: scale(1.05); }
  .pu-postcard__seal { position: absolute; top: 12px; right: 12px; width: 80px; height: 80px; transform: rotate(-9deg); filter: drop-shadow(0 4px 10px rgba(78,46,112,0.55)); }
  .pu-postcard__tag {
    position: absolute; bottom: 12px; left: 12px;
    background: var(--pu-cyan); color: var(--pu-ink);
    padding: .4rem .75rem;
    font-size: .65rem; font-weight: 800; letter-spacing: .2em;
    border: 2px solid var(--pu-ink);
    box-shadow: 3px 3px 0 var(--pu-violet);
    transform: rotate(-2deg);
  }
  .pu-postcard__data {
    padding: 1rem 1.25rem;
    background: var(--pu-paper-2);
    display: grid; gap: .35rem;
  }
  .pu-postcard__data-row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .35rem;
    border-bottom: 1px dashed rgba(20,17,31,0.18);
    font-size: .68rem;
  }
  .pu-postcard__data-row:last-child { border-bottom: none; padding-bottom: 0; }
  .pu-postcard__data-row > span:first-child { color: var(--pu-violet-d); letter-spacing: .2em; font-weight: 800; }
  .pu-postcard__data-v { color: var(--pu-ink); font-weight: 700; letter-spacing: .05em; }

  /* Marquee */
  .pu-marquee {
    background: var(--pu-violet); color: var(--pu-paper);
    overflow: hidden; padding: .9rem 0;
    border-top: 3px solid var(--pu-ink);
  }
  .pu-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: pu-marquee 40s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem; font-weight: 800;
    letter-spacing: .15em; text-transform: uppercase;
  }
  @keyframes pu-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* GEODA SECTION */
  .pu-geode-section {
    background: var(--pu-indigo);
    color: var(--pu-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--pu-ink);
    position: relative;
    overflow: hidden;
  }
  .pu-geode-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(183,155,232,0.1) 1.3px, transparent 1.3px);
    background-size: 26px 26px;
    pointer-events: none;
  }
  .pu-geode-section > * { position: relative; }
  .pu-geode-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) { .pu-geode-grid { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }
  .pu-geode-chapter { color: var(--pu-cyan); }
  .pu-geode-title { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: .9; letter-spacing: -.04em; margin: 1rem 0; color: var(--pu-paper); }
  .pu-geode-title em { color: #C7AEEC; }
  .pu-geode-lead { font-size: 1.05rem; line-height: 1.55; color: rgba(243,236,251,0.82); margin-bottom: 1.75rem; max-width: 56ch; }
  .pu-geode-lead strong { color: var(--pu-paper); font-weight: 700; }
  .pu-geode-lead em { color: var(--pu-cyan); font-style: italic; }
  .pu-geode-facts { display: grid; grid-template-columns: 1fr; gap: 0; border: 2.5px solid var(--pu-paper); background: rgba(243,236,251,0.04); margin-bottom: 1.5rem; }
  @media (min-width: 640px) { .pu-geode-facts { grid-template-columns: 1fr 1fr; } }
  .pu-geode-fact { padding: .85rem 1rem; border-bottom: 1px solid rgba(243,236,251,0.25); display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 640px) {
    .pu-geode-fact:nth-child(odd) { border-right: 1px solid rgba(243,236,251,0.25); }
    .pu-geode-fact:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .pu-geode-fact:last-child { border-bottom: none; } }
  .pu-geode-fact__k { font-size: .58rem; letter-spacing: .2em; color: var(--pu-cyan); font-weight: 800; }
  .pu-geode-fact__v { font-size: .88rem; color: var(--pu-paper); font-weight: 600; line-height: 1.35; }
  .pu-geode-note { padding: 1rem 1.25rem; background: var(--pu-violet); color: var(--pu-paper); border: 2px solid var(--pu-paper); font-size: .92rem; line-height: 1.5; }
  .pu-geode-note strong { color: var(--pu-cyan); }
  .pu-geode-r { max-width: 300px; margin: 0 auto; border: 3px solid var(--pu-paper); box-shadow: 8px 8px 0 var(--pu-violet); line-height: 0; }

  /* ICONOS */
  .pu-iconos-section { background: var(--pu-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--pu-ink); }
  .pu-iconos { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 1024px) { .pu-iconos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .pu-icono {
    position: relative;
    background: var(--pu-paper);
    border: 3px solid var(--pu-ink);
    box-shadow: var(--pu-shadow);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
  }
  .pu-icono:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .pu-icono--violet { color: var(--pu-violet); }
  .pu-icono--cyan   { color: var(--pu-cyan); }
  .pu-icono--amber  { color: var(--pu-amber); }
  .pu-icono__code {
    position: absolute; top: -16px; right: 20px;
    background: var(--pu-ink); color: var(--pu-cyan);
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    border: 2.5px solid currentColor;
    box-shadow: 3px 3px 0 currentColor;
  }
  .pu-icono__svg { width: 100%; aspect-ratio: 1; max-width: 200px; margin: 0 auto; color: currentColor; }
  .pu-icono__name { font-size: clamp(1.4rem, 2.8vw, 1.8rem); line-height: 1; letter-spacing: -.025em; color: var(--pu-ink); margin: .5rem 0 0; text-align: center; }
  .pu-icono__sub { font-size: .6rem; letter-spacing: .22em; color: currentColor; font-weight: 800; text-align: center; }
  .pu-icono__desc { font-size: .9rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; text-align: center; }
  .pu-icono__foot { padding-top: .75rem; border-top: 2px dashed currentColor; text-align: center; }
  .pu-icono__dato { font-size: .85rem; font-weight: 800; color: currentColor; letter-spacing: .1em; }

  /* RESERVAS */
  .pu-res-section { background: var(--pu-paper-2); padding: 5rem 1.5rem; border-bottom: 3px solid var(--pu-ink); position: relative; overflow: hidden; }
  .pu-res-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(54,176,196,0.07) 1.2px, transparent 1.2px); background-size: 24px 24px; pointer-events: none; }
  .pu-res-section > * { position: relative; }
  .pu-res-head { max-width: 760px; margin-bottom: 2.5rem; }
  .pu-res-chapter { color: var(--pu-violet); }
  .pu-res-title { font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0; }
  .pu-res-title em { color: var(--pu-violet); }
  .pu-res-lead { font-size: 1.1rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 60ch; }
  .pu-res-lead strong { color: var(--pu-ink); font-weight: 700; }
  .pu-res-lead em { color: var(--pu-cyan); font-style: italic; }
  .pu-res-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .pu-res-grid { grid-template-columns: 1.1fr 1fr; gap: 3rem; } }
  .pu-res-steps { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .pu-res-step { display: grid; grid-template-columns: 56px 1fr; gap: 1rem; align-items: start; background: var(--pu-paper); border: 2.5px solid var(--pu-ink); box-shadow: 5px 5px 0 var(--pu-ink); padding: 1.25rem; transition: transform .2s, box-shadow .2s; }
  .pu-res-step:hover { transform: translate(-3px,-3px); box-shadow: 8px 8px 0 var(--pu-violet); }
  .pu-res-step__n { font-family: var(--font-mono); font-size: 1.6rem; font-weight: 800; color: var(--pu-violet); background: var(--pu-arena); border: 2px solid var(--pu-ink); display: flex; align-items: center; justify-content: center; aspect-ratio: 1; }
  .pu-res-step__t { font-size: 1.2rem; line-height: 1; letter-spacing: -.02em; color: var(--pu-ink); margin: .15rem 0 .4rem; }
  .pu-res-step__d { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* Ticket mock */
  .pu-res-mock { display: flex; flex-direction: column; align-items: center; gap: .85rem; }
  .pu-ticket { width: 100%; max-width: 340px; background: var(--pu-indigo); border: 3px solid var(--pu-ink); box-shadow: var(--pu-shadow); overflow: hidden; }
  .pu-ticket__bar { display: flex; justify-content: space-between; align-items: center; padding: .6rem .85rem; background: var(--pu-ink); color: var(--pu-cyan); font-size: .58rem; letter-spacing: .15em; }
  .pu-ticket__live { display: inline-flex; align-items: center; gap: .35rem; color: var(--pu-amber); }
  .pu-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--pu-amber); animation: pu-pulse 1.6s ease-out infinite; }
  .pu-ticket__body { padding: 1rem; display: flex; flex-direction: column; gap: .75rem; }
  .pu-ticket__label { font-size: .6rem; letter-spacing: .2em; color: rgba(243,236,251,0.6); }
  .pu-cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .pu-cal__d { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: .68rem; font-weight: 700; color: var(--pu-paper); background: rgba(243,236,251,0.08); border: 1px solid rgba(243,236,251,0.15); }
  .pu-cal__d--full { color: rgba(243,236,251,0.3); text-decoration: line-through; }
  .pu-cal__d--sel { background: var(--pu-cyan); color: var(--pu-ink); border-color: var(--pu-cyan); }
  .pu-ticket__slots { display: flex; flex-direction: column; gap: .35rem; }
  .pu-slot { font-family: var(--font-mono); font-size: .7rem; font-weight: 700; padding: .5rem .65rem; border: 1.5px solid rgba(243,236,251,0.25); color: var(--pu-paper); background: rgba(243,236,251,0.05); }
  .pu-slot--off { color: rgba(243,236,251,0.35); text-decoration: line-through; }
  .pu-slot--on { background: var(--pu-violet); border-color: var(--pu-cyan); color: var(--pu-paper); }
  .pu-ticket__row { display: flex; justify-content: space-between; align-items: center; padding-top: .35rem; border-top: 1px dashed rgba(243,236,251,0.2); }
  .pu-ticket__lang { display: inline-flex; align-items: center; gap: .45rem; font-size: .62rem; color: var(--pu-paper); }
  .pu-ticket__flag { width: 22px; border: 1px solid rgba(243,236,251,0.4); line-height: 0; }
  .pu-ticket__price { font-size: .6rem; color: var(--pu-amber); letter-spacing: .12em; }
  .pu-ticket__cta { margin-top: .25rem; text-align: center; background: var(--pu-cyan); color: var(--pu-ink); font-family: var(--font-display); font-weight: 800; font-size: .92rem; padding: .7rem; border: 2px solid var(--pu-ink); }
  .pu-res-mock__note { font-size: .62rem; letter-spacing: .2em; color: var(--pu-violet-d); font-weight: 800; }

  /* HITOS */
  .pu-hitos-section {
    background: var(--pu-ink); color: var(--pu-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--pu-ink);
    position: relative; overflow: hidden;
  }
  .pu-hitos-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(183,155,232,0.1) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .pu-hitos-section > * { position: relative; }
  .pu-hitos {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 2.5px solid var(--pu-paper);
  }
  @media (min-width: 640px)  { .pu-hitos { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .pu-hitos { grid-template-columns: repeat(3, 1fr); } }
  .pu-hito {
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(243,236,251,0.22);
    border-right: 1px solid rgba(243,236,251,0.22);
    display: flex; flex-direction: column; gap: .35rem;
    background: rgba(243,236,251,0.03);
    transition: background .25s;
  }
  .pu-hito:hover { background: rgba(123,79,163,0.25); }
  @media (min-width: 1024px) {
    .pu-hito:nth-child(3n) { border-right: none; }
    .pu-hito:nth-last-child(-n+3) { border-bottom: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .pu-hito:nth-child(2n) { border-right: none; }
    .pu-hito:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) { .pu-hito { border-right: none; } .pu-hito:last-child { border-bottom: none; } }
  .pu-hito__k { font-size: .62rem; letter-spacing: .25em; color: var(--pu-amber); font-weight: 800; }
  .pu-hito__v { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--pu-paper); line-height: 1.35; }

  /* SECTORES */
  .pu-sec-section { background: var(--pu-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--pu-ink); }
  .pu-sec { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px)  { .pu-sec { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .pu-sec { grid-template-columns: repeat(3, 1fr); } }
  .pu-sec__card {
    background: var(--pu-paper);
    border: 2.5px solid var(--pu-ink);
    box-shadow: var(--pu-shadow);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
  }
  .pu-sec__card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: currentColor; }
  .pu-sec__card:hover { transform: translate(-3px, -3px); box-shadow: 12px 12px 0 currentColor; }
  .pu-sec__card--violet { color: var(--pu-violet); }
  .pu-sec__card--cyan   { color: var(--pu-cyan); }
  .pu-sec__card--amber  { color: var(--pu-amber); }
  .pu-sec__card--rose   { color: var(--pu-rose); }
  .pu-sec__card--green  { color: var(--pu-green); }
  .pu-sec__card--indigo { color: var(--pu-violet-d); }
  .pu-sec__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: .5rem; border-bottom: 2px dashed currentColor; gap: .5rem; }
  .pu-sec__num { font-size: 1.5rem; font-weight: 800; color: currentColor; line-height: 1; }
  .pu-sec__stat-box {
    background: var(--pu-ink); color: var(--pu-paper);
    padding: .35rem .65rem;
    display: flex; flex-direction: column;
    border: 1.5px solid currentColor;
    text-align: right;
  }
  .pu-sec__stat-v { font-size: .9rem; font-weight: 800; color: currentColor; line-height: 1; }
  .pu-sec__stat-l { font-size: .5rem; letter-spacing: .12em; opacity: .85; text-transform: uppercase; }
  .pu-sec__title { font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.1; letter-spacing: -.02em; color: var(--pu-ink); margin: 0; }
  .pu-sec__desc { font-size: .88rem; line-height: 1.5; color: var(--brutal-text-secondary); flex: 1; }
  .pu-sec__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .3rem; }
  .pu-sec__tag { display: flex; align-items: flex-start; gap: .35rem; font-size: .78rem; line-height: 1.35; color: var(--pu-ink); }
  .pu-sec__tag span { color: currentColor; font-weight: 800; }
  .pu-sec__foot { padding-top: .65rem; border-top: 2px solid var(--pu-ink); }
  .pu-sec__cta { font-family: var(--font-mono); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .15em; color: currentColor; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 2px; }

  /* MAPA */
  .pu-map-section { background: var(--pu-arena); border-bottom: 3px solid var(--pu-ink); }
  .pu-map-head { padding: 4rem 0 2rem; }
  .pu-map-head__inner { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; }
  @media (min-width: 768px) { .pu-map-head__inner { grid-template-columns: 1.5fr 1fr; } }
  .pu-map-chapter { color: var(--pu-violet); }
  .pu-map-title { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: .95; letter-spacing: -.035em; margin: 1rem 0 0; }
  .pu-map-title em { color: var(--pu-violet); }
  .pu-map-coords {
    background: var(--pu-violet); color: var(--pu-paper);
    padding: 1rem 1.25rem;
    border: 2px solid var(--pu-ink);
    box-shadow: 5px 5px 0 var(--pu-cyan);
    display: flex; flex-direction: column; gap: .35rem;
    font-size: .7rem; letter-spacing: .15em;
  }
  .pu-map-frame { border-top: 3px solid var(--pu-ink); border-bottom: 3px solid var(--pu-ink); background: var(--pu-ink); }
  .pu-map-wrap > * { width: 100%; }

  /* DIFERENCIALES */
  .pu-dif-section { background: var(--pu-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--pu-ink); }
  .pu-dif { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 0; border: 2px solid var(--pu-ink); }
  @media (min-width: 768px) { .pu-dif { grid-template-columns: 1fr 1fr; } }
  .pu-dif__item { padding: 1.75rem 1.5rem; border-bottom: 1px solid var(--pu-ink); display: flex; flex-direction: column; gap: .65rem; transition: background .2s; }
  @media (min-width: 768px) {
    .pu-dif__item:nth-child(odd) { border-right: 1px solid var(--pu-ink); }
    .pu-dif__item:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 767px) { .pu-dif__item:last-child { border-bottom: none; } }
  .pu-dif__item--0 { background: var(--pu-paper-2); }
  .pu-dif__item--1 { background: var(--pu-paper); }
  .pu-dif__item--2 { background: var(--pu-arena); }
  .pu-dif__item--3 { background: var(--pu-paper); }
  .pu-dif__item:hover { background: var(--pu-cyan); }
  .pu-dif__num { font-size: .85rem; color: var(--pu-violet); font-weight: 800; letter-spacing: .15em; }
  .pu-dif__t { font-size: clamp(1.3rem, 2.2vw, 1.65rem); line-height: 1.05; letter-spacing: -.025em; color: var(--pu-ink); margin: 0; }
  .pu-dif__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0; }

  /* PROCESO */
  .pu-proc-section { background: var(--pu-indigo); color: var(--pu-paper); padding: 5rem 1.5rem; border-bottom: 3px solid var(--pu-ink); position: relative; overflow: hidden; }
  .pu-proc-section::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(224,163,62,0.08) 1.2px, transparent 1.2px); background-size: 22px 22px; pointer-events: none; }
  .pu-proc-section > * { position: relative; }
  .pu-proc { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 768px)  { .pu-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .pu-proc { grid-template-columns: repeat(4, 1fr); } }
  .pu-proc__step {
    background: rgba(243,236,251,0.05);
    border: 2px solid var(--pu-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    transition: background .25s, transform .25s;
  }
  .pu-proc__step:hover { background: rgba(123,79,163,0.22); transform: translateY(-3px); }
  .pu-proc__head { display: flex; justify-content: space-between; padding-bottom: .35rem; border-bottom: 1.5px dashed rgba(243,236,251,0.25); }
  .pu-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--pu-amber); line-height: 1; }
  .pu-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--pu-cyan); }
  .pu-proc__t { font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.05; letter-spacing: -.02em; color: var(--pu-paper); margin: .25rem 0 0; }
  .pu-proc__body { font-size: .85rem; line-height: 1.45; color: rgba(243,236,251,0.75); flex: 1; }
  .pu-proc__foot { font-size: .58rem; letter-spacing: .2em; color: var(--pu-amber); font-weight: 800; padding-top: .5rem; border-top: 1.5px solid rgba(243,236,251,0.25); }

