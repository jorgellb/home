---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = "Términos y Condiciones | Platanito Rico";
const description = "Condiciones generales de contratación de servicios de Platanito Rico.";
const lastUpdate = "febrero 2026";
const docId = "TC-2026-031";

const toc = [
  { n: '01', id: 's1', label: 'Objeto de los servicios' },
  { n: '02', id: 's2', label: 'Presupuestos y aceptación' },
  { n: '03', id: 's3', label: 'Condiciones de pago' },
  { n: '04', id: 's4', label: 'Propiedad intelectual' },
  { n: '05', id: 's5', label: 'Obligaciones y plazos' },
  { n: '06', id: 's6', label: 'Mantenimiento web' },
  { n: '07', id: 's7', label: 'Garantías y revisiones' },
  { n: '08', id: 's8', label: 'Derecho de desistimiento' },
  { n: '09', id: 's9', label: 'Limitación de responsabilidad' },
  { n: '10', id: 's10', label: 'Ley aplicable y jurisdicción' },
];
---

<BaseLayout title={title} description={description} noindex={true}>
  <Header />

  <main class="legal">
    <div class="legal-gazette" aria-hidden="true">
      <div class="legal-gazette__track">
        {Array.from({length: 4}).map(() => (
          <>
            <span>Documento Oficial</span><span>★</span>
            <span>Condiciones Generales de Contratación</span><span>★</span>
            <span>Validez 30 días · 50%/50%</span><span>★</span>
            <span>Garantía 30 días naturales</span><span>★</span>
            <span>ID · {docId}</span><span>★</span>
          </>
        ))}
      </div>
    </div>

    <section class="legal-mast">
      <div class="container-brutal">
        <header class="legal-mast__head">
          <span class="legal-mast__edition">N.º 031 — Documentos Oficiales · Vol. 2026</span>
          <span class="legal-mast__edition">★ Vigente desde {lastUpdate}</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="legal-mast__doc">
          <div>
            <span class="legal-mast__num">031</span>
            <h1 class="legal-mast__title">
              Términos y
              <em>condiciones.</em>
            </h1>
          </div>
          <div style="display:flex;gap:1rem;flex-wrap:wrap;">
            <div class="legal-seal">
              <span class="legal-seal__star">⚖</span>
              <span class="legal-seal__line">CONDICIONES</span>
              <span class="legal-seal__line legal-seal__line--big">GENERALES</span>
              <span class="legal-seal__line">de contratación</span>
            </div>
            <div class="legal-seal legal-seal--accent">
              <span class="legal-seal__star">★</span>
              <span class="legal-seal__line">GARANTÍA</span>
              <span class="legal-seal__line legal-seal__line--big">30 DÍAS</span>
              <span class="legal-seal__line">tras entrega</span>
            </div>
          </div>
        </div>

        <p class="legal-mast__intro">
          Las presentes condiciones generales regulan la relación comercial entre
          <strong>Platanito Rico</strong> y el cliente que contrata sus servicios. La aceptación de un
          presupuesto o el inicio de la prestación implica la aceptación plena de estas condiciones.
        </p>

        <dl class="legal-mast__spec">
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Documento</dt>
            <dd class="legal-mast__spec-v">{docId}</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Última actualización</dt>
            <dd class="legal-mast__spec-v">{lastUpdate}</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Validez presupuesto</dt>
            <dd class="legal-mast__spec-v">30 días naturales</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Tiempo de lectura</dt>
            <dd class="legal-mast__spec-v">~6 minutos</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="container-brutal">
      <div class="legal-grid">
        <aside class="legal-toc" aria-label="Índice del documento">
          <header class="legal-toc__head">
            <span class="text-meta">Índice</span>
            <span class="text-meta">{toc.length} cláusulas</span>
          </header>
          <ol class="legal-toc__list">
            {toc.map((t) => (
              <li class="legal-toc__item">
                <a href={`#${t.id}`} class="legal-toc__link" data-toc-link>
                  <span class="legal-toc__num">{t.n}</span>
                  <span>{t.label}</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="legal-toc__seals">
            <button type="button" class="legal-toc__action" onclick="window.print()">⎙ Imprimir</button>
            <a href="/privacidad/" class="legal-toc__action">→ Privacidad</a>
          </div>
        </aside>

        <article class="legal-article">
          <p>
            Las presentes <strong>Condiciones Generales de Contratación</strong> regulan la relación
            comercial entre <strong>Platanito Rico</strong> (Jorge Luis López Barrio) y el cliente que
            contrata sus servicios. La aceptación de un presupuesto o el inicio de la prestación del
            servicio implica la <strong>aceptación plena y sin reservas</strong> de estas condiciones.
          </p>

          <section id="s1" class="legal-section">
            <span class="legal-section__num">N.º 01</span>
            <h2 class="legal-section__title">
              Objeto
              <em>de los servicios.</em>
            </h2>
            <p>Platanito Rico presta servicios digitales que incluyen, pero no se limitan a:</p>
            <ul>
              <li>Diseño y desarrollo de sitios web y tiendas online.</li>
              <li>Diseño gráfico y branding (identidad corporativa).</li>
              <li>Producción y edición de vídeo · servicios audiovisuales.</li>
              <li>Marketing digital, gestión de redes sociales y SEO.</li>
              <li>Mantenimiento técnico de sitios web.</li>
            </ul>
          </section>

          <section id="s2" class="legal-section">
            <span class="legal-section__num">N.º 02</span>
            <h2 class="legal-section__title">
              Presupuestos
              <em>y aceptación.</em>
            </h2>
            <p>
              Los presupuestos emitidos tienen una validez de <strong>30 días naturales</strong> desde su
              fecha de emisión. Pasado este plazo, Platanito Rico se reserva el derecho de modificar las
              tarifas o condiciones.
            </p>
            <p>
              La contratación se formalizará mediante la aceptación del presupuesto por escrito (correo
              electrónico o firma digital) y el pago del anticipo estipulado.
            </p>
          </section>

          <section id="s3" class="legal-section">
            <span class="legal-section__num">N.º 03</span>
            <h2 class="legal-section__title">
              Condiciones
              <em>de pago.</em>
            </h2>
            <ul class="legal-bento">
              <li>
                <span class="legal-bento__num">50% / 50%</span>
                <h3 class="legal-bento__t">Forma de pago</h3>
                <p class="legal-bento__d"><strong>50% por adelantado</strong> a la aceptación + 50% a la entrega final, antes de la publicación.</p>
              </li>
              <li>
                <span class="legal-bento__num">Métodos</span>
                <h3 class="legal-bento__t">Aceptados</h3>
                <p class="legal-bento__d">Transferencia bancaria o tarjeta.</p>
              </li>
              <li>
                <span class="legal-bento__num">Impago</span>
                <h3 class="legal-bento__t">En caso de</h3>
                <p class="legal-bento__d">Suspensión temporal de servicios o no entrega hasta regularizar la deuda.</p>
              </li>
            </ul>
          </section>

          <section id="s4" class="legal-section">
            <span class="legal-section__num">N.º 04</span>
            <h2 class="legal-section__title">
              Propiedad
              <em>intelectual.</em>
            </h2>

            <div class="legal-highlight legal-highlight--ink">
              <div class="legal-highlight__icon">©</div>
              <div class="legal-highlight__body">
                <h2 class="legal-highlight__title">Reserva de dominio</h2>
                <p>
                  La propiedad intelectual y los derechos de explotación sobre los trabajos realizados
                  (código, diseños, logotipos, vídeos, textos) se transmitirán al Cliente
                  <strong>ÚNICAMENTE cuando se haya abonado el 100% del precio acordado</strong>.
                </p>
              </div>
            </div>

            <p>
              Hasta el pago completo, Platanito Rico conserva todos los derechos sobre el trabajo. Una vez
              pagado, el cliente ostentará los derechos de explotación necesarios para su actividad comercial.
            </p>
            <p>
              <strong>Derecho de autopromoción:</strong> Platanito Rico se reserva el derecho de mostrar los
              trabajos realizados en su portafolio web, redes sociales y materiales promocionales como muestra
              de su trabajo, salvo que el cliente solicite expresamente confidencialidad por escrito antes
              del inicio del proyecto.
            </p>
          </section>

          <blockquote class="legal-pull">
            "Tu proyecto es <em>tuyo</em> al 100% — cuando el último 50% ha sido pagado."
          </blockquote>

          <section id="s5" class="legal-section">
            <span class="legal-section__num">N.º 05</span>
            <h2 class="legal-section__title">
              Obligaciones
              <em>y plazos.</em>
            </h2>
            <ul>
              <li>
                <strong>Colaboración del cliente:</strong> El cliente se compromete a entregar los contenidos
                (textos, imágenes, credenciales) necesarios en los plazos acordados. Los retrasos en la
                entrega de material posponen las fechas de entrega y no son imputables a Platanito Rico.
              </li>
              <li>
                <strong>Plazos de entrega:</strong> Los plazos del presupuesto son <em>estimados</em>.
                Platanito Rico hará todo lo posible por cumplirlos, pero pueden alterarse por modificaciones
                solicitadas, retrasos del cliente o causas de fuerza mayor.
              </li>
            </ul>
          </section>

          <section id="s6" class="legal-section">
            <span class="legal-section__num">N.º 06</span>
            <h2 class="legal-section__title">
              Mantenimiento
              <em>web.</em>
            </h2>
            <p>Nuestro servicio de mantenimiento web incluye:</p>
            <ul>
              <li>Actualizaciones de contenidos y seguridad.</li>
              <li>Cambios de imágenes y textos.</li>
              <li>Publicación de noticias y artículos.</li>
              <li>Creación de enlaces internos.</li>
              <li>Actualización de datos de contacto.</li>
              <li>Mejora de velocidad de carga.</li>
              <li>Traslados a otros servidores.</li>
              <li>Revisión de funcionamiento.</li>
              <li>Configuración de copias de seguridad.</li>
              <li>Gestión de cuentas de correo.</li>
              <li>Formación para utilizar tu web.</li>
              <li>Y mucho más según las necesidades de tu proyecto.</li>
            </ul>
          </section>

          <section id="s7" class="legal-section">
            <span class="legal-section__num">N.º 07</span>
            <h2 class="legal-section__title">
              Garantías
              <em>y revisiones.</em>
            </h2>
            <p>
              Se ofrece un periodo de garantía de <strong>30 días naturales</strong> tras la entrega del
              proyecto web para corregir cualquier error o "bug" técnico imputable al desarrollo. Esta
              garantía no cubre modificaciones por cambio de criterio del cliente ni errores derivados de
              un mal uso del panel de administración.
            </p>
          </section>

          <section id="s8" class="legal-section">
            <span class="legal-section__num">N.º 08</span>
            <h2 class="legal-section__title">
              Derecho de
              <em>desistimiento.</em>
            </h2>
            <p>
              Conforme al art. 103 de la Ley General para la Defensa de los Consumidores y Usuarios, el
              derecho de desistimiento de 14 días <strong>NO será aplicable</strong> a los contratos de
              prestación de servicios una vez que el servicio haya sido completamente ejecutado, ni cuando
              la ejecución haya comenzado con el previo consentimiento expreso del consumidor.
            </p>
          </section>

          <section id="s9" class="legal-section">
            <span class="legal-section__num">N.º 09</span>
            <h2 class="legal-section__title">
              Limitación de
              <em>responsabilidad.</em>
            </h2>
            <p>
              Platanito Rico no será responsable en ningún caso de daños indirectos, pérdida de beneficios,
              pérdida de datos o interrupción de negocio que pudiera sufrir el cliente, incluso si se
              hubiera avisado de la posibilidad de tales daños. La <strong>responsabilidad máxima estará
              limitada al importe abonado</strong> por el cliente por el servicio concreto.
            </p>
          </section>

          <section id="s10" class="legal-section">
            <span class="legal-section__num">N.º 10</span>
            <h2 class="legal-section__title">
              Ley aplicable
              <em>y jurisdicción.</em>
            </h2>
            <p>
              Estas Condiciones se rigen por la <strong>legislación española</strong>. Cualquier controversia
              se someterá a los <strong>Juzgados y tribunales de Almería</strong>, salvo que la Ley aplicable
              disponga otra cosa.
            </p>
          </section>

          <footer class="legal-colophon">
            <div class="legal-colophon__text">
              Condiciones generales <strong>{docId}</strong>.<br/>
              Vigentes desde <strong>{lastUpdate}</strong>.<br/>
              Cualquier duda: <strong><a href="mailto:hola@platanitorico.com">hola@platanitorico.com</a></strong>.
            </div>
            <div class="legal-colophon__sig">
              <span class="legal-colophon__sig-name">Jorge L. López</span>
              <span class="legal-colophon__sig-role">Titular · Platanito Rico</span>
            </div>
          </footer>
        </article>
      </div>
    </div>

    <section class="legal-final">
      <div class="container-brutal">
        <div class="legal-final__inner">
          <span class="text-meta">★ ¿Listo para empezar?</span>
          <h2 class="legal-final__title">
            Pide tu
            <em>presupuesto.</em>
          </h2>
          <p class="legal-final__text">
            Si has llegado hasta aquí leyendo las condiciones, ya sabes cómo trabajamos:
            sin sorpresas, sin letra pequeña, garantía de 30 días.
          </p>
          <div class="legal-final__btns">
            <a href="/contacto/" class="btn-brutal btn-brutal--lg">Pedir presupuesto →</a>
            <a href="/privacidad/" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Política de privacidad</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const links = document.querySelectorAll('[data-toc-link]');
  const sections = Array.from(links).map(a => document.querySelector(a.getAttribute('href') || ''));
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        links.forEach(l => l.classList.toggle('is-active', l.getAttribute('href') === `#${id}`));
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(s => s && observer.observe(s));
</script>
