---
/* SPIKE desechable: validación del pipeline AR (pose métrica + oclusión real).
   No se enlaza desde ningún sitio y va con noindex. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SpikeAR from '../components/ar/SpikeAR.tsx';

---

<BaseLayout title="Spike AR" description="Prueba interna del pipeline AR" noindex={true}>
  <main id="main-content" style="background:#070b10;color:#e6edf2;padding:2rem;min-height:100vh">
    <h1 style="font-size:1.2rem;font-family:var(--font-mono)">Spike AR · pose métrica + oclusión</h1>
    <SpikeAR client:only="react" />
  </main>
</BaseLayout>
