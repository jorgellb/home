---
/* Una sola ruta dinámica para las páginas de servicio IT y las landings IT
   por pueblo: comparten nivel de URL (/informatica-empresas/<slug>/) y los
   slugs no se solapan. Cada tipo tiene su vista. */
import ServicioITView from '../../components/sistemas-it/ServicioITView.astro';
import PuebloITView from '../../components/sistemas-it/PuebloITView.astro';
import { serviciosIT, pueblosIT } from '../../data/servicios-it';

export function getStaticPaths() {
  return [
    ...serviciosIT.map((s) => ({ params: { slug: s.slug }, props: { kind: 'servicio' as const } })),
    ...pueblosIT.map((p) => ({ params: { slug: p.slug }, props: { kind: 'pueblo' as const } })),
  ];
}

interface Props {
  kind: 'servicio' | 'pueblo';
}

const { slug } = Astro.params;
const { kind } = Astro.props;
---

{kind === 'servicio' ? <ServicioITView slug={slug} /> : <PuebloITView slug={slug} />}
