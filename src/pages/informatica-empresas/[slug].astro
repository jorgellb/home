---
/* Servicios IT y landings IT por municipio comparten nivel de URL
   (/informatica-empresas/<slug>/); los slugs no se solapan. */
import PlantillaServicio from '../../components/sitio/PlantillaServicio.astro';
import PlantillaPueblo from '../../components/sitio/PlantillaPueblo.astro';
import { serviciosIT, pueblosIT } from '../../data/servicios-it';
import { contenidoServicioIT } from '../../data/servicios/informatica';
import { contenidoITPueblo } from '../../data/servicios/pueblo-it';

export function getStaticPaths() {
  return [
    ...serviciosIT.map((s) => ({ params: { slug: s.slug }, props: { servicio: contenidoServicioIT(s), pueblo: null } })),
    ...pueblosIT.map((p) => ({ params: { slug: p.slug }, props: { servicio: null, pueblo: contenidoITPueblo(p) } })),
  ];
}

const { servicio, pueblo } = Astro.props;
---

{servicio ? <PlantillaServicio datos={servicio} /> : pueblo && <PlantillaPueblo datos={pueblo} />}
