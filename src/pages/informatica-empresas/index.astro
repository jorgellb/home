---
/* Hub de Sistemas IT (centro de mando, spec §6.4): plantilla de lectura con
   el radar de cobertura in situ en la cabecera. */
import LecturaLayout from '../../layouts/LecturaLayout.astro';
import Boton from '../../components/cdm/Boton.astro';
import Fichas from '../../components/cdm/Fichas.astro';
import ListaEnlaces from '../../components/cdm/ListaEnlaces.astro';
import Plan360Panel from '../../components/cdm/Plan360Panel.astro';
import Preguntas from '../../components/cdm/Preguntas.astro';
import RadarCobertura from '../../components/cdm/RadarCobertura.astro';
import SeccionLectura from '../../components/cdm/SeccionLectura.astro';
import ServiciosIT from '../../components/cdm/ServiciosIT.astro';
import Contact from '../../components/sections/Contact.astro';
import type { Cifra, SeccionIndice } from '../../components/cdm/tipos';
import { serviciosIT, pueblosIT, plan360, getServicioIT, HUB_IT, type Bloque, type Faq } from '../../data/servicios-it';
import { SITE, PROVEEDOR } from '../../data/negocio';

const canonical = `${SITE}${HUB_IT}`;
const title = 'Mantenimiento Informático Empresas Almería';
const description = 'Mantenimiento informático para empresas en Almería: redes, servidores, copias, ordenadores y ciberseguridad, con técnico el mismo día en Levante y Almanzora.';

const proceso: Bloque[] = [
  { t: 'Auditoría inicial', d: 'Visitamos tu empresa y revisamos equipos, red, copias y seguridad para saber de dónde partimos.' },
  { t: 'Propuesta cerrada', d: 'Te decimos qué urge, qué puede esperar y cuánto cuesta cada cosa, por escrito y sin tecnicismos.' },
  { t: 'Puesta a punto', d: 'Corregimos lo crítico primero: copias que no funcionan, equipos sin proteger y redes mal configuradas.' },
  { t: 'Mantenimiento continuo', d: 'Preventivo mensual, helpdesk remoto y visita el mismo día. Tú te olvidas de la informática.' },
];

// Preguntas más buscadas, reunidas desde los servicios para no duplicar copy.
const faq: Faq[] = [
  ['mantenimiento-informatico', 0],
  ['mantenimiento-informatico', 1],
  ['mantenimiento-informatico', 2],
  ['servidores-copias-seguridad', 2],
  ['ciberseguridad', 0],
].flatMap(([slug, i]) => {
  const item = getServicioIT(slug as string)?.faq[i as number];
  return item ? [item] : [];
});

const datos: Cifra[] = [
  { etiqueta: 'Pueblos con visita el mismo día', valor: pueblosIT.length },
  { etiqueta: 'Servicios informáticos', valor: serviciosIT.length },
  { etiqueta: 'Plan 360 al mes, + IVA', valor: plan360.precio, sufijo: ' €' },
  { etiqueta: 'Meses de permanencia', valor: 0 },
];

const secciones: SeccionIndice[] = [
  { id: 'servicios', etiqueta: 'Servicios' },
  { id: 'plan-360', etiqueta: 'Plan 360' },
  { id: 'metodo', etiqueta: 'Método' },
  { id: 'cobertura', etiqueta: 'Cobertura' },
  { id: 'faq', etiqueta: 'Preguntas' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'Mantenimiento informático para empresas',
    'serviceType': 'Mantenimiento informático',
    'description': description,
    'url': canonical,
    'provider': PROVEEDOR,
    'areaServed': [
      ...pueblosIT.map((p) => ({ '@type': 'City', 'name': p.nombre })),
      { '@type': 'AdministrativeArea', 'name': 'Provincia de Almería' },
    ],
    'hasOfferCatalog': {
      '@type': 'OfferCatalog',
      'name': 'Servicios informáticos para empresas',
      'itemListElement': serviciosIT.map((s) => ({
        '@type': 'Offer',
        'itemOffered': { '@type': 'Service', 'name': s.nav, 'url': `${canonical}${s.slug}/` },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faq.map((f) => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } })),
  },
];
---

<LecturaLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  migas={[{ label: 'Inicio', href: '/' }, { label: 'Sistemas IT' }]}
  h1="Mantenimiento informático para empresas en Almería"
  subtitulo="Tu departamento IT en el Levante y el Almanzora, con visita el mismo día"
  entradilla="Visita in situ el mismo día, helpdesk remoto ilimitado, copias de seguridad verificadas cada mes y antivirus gestionado. Sin permanencia."
  datos={datos}
  secciones={secciones}
  coordenadas="Sistemas IT · base en Vera"
>
  <Fragment slot="acciones">
    <Boton href="/contacto/?servicio=sistemas-it#contacto">Pedir presupuesto</Boton>
    <Boton href={plan360.href} variante="linea">Ver el Plan 360</Boton>
  </Fragment>

  <RadarCobertura slot="lateral" />

  <SeccionLectura
    id="servicios"
    titulo="Servicios informáticos para empresas"
    lead="Nuestro equipo de sistemas se ocupa de todo lo que hace funcionar tu oficina: ordenadores, red, servidores, copias y seguridad. Un solo interlocutor y una sola factura."
  >
    <ServiciosIT />
  </SeccionLectura>

  <SeccionLectura
    id="plan-360"
    titulo="Web e informática en una sola cuota"
    lead={`Para pymes de hasta ${plan360.puestos} puestos: tu web, tus equipos, el servidor, la red y las copias por un precio fijo al mes.`}
  >
    <Plan360Panel />
  </SeccionLectura>

  <SeccionLectura id="metodo" titulo="Cómo empezamos a cuidar tu informática">
    <Fichas numeradas items={proceso.map((p) => ({ titulo: p.t, texto: p.d }))} />
  </SeccionLectura>

  <SeccionLectura
    id="cobertura"
    titulo="Técnico informático in situ en el Levante y el Almanzora"
    lead="Si una incidencia no se resuelve en remoto, vamos a tu empresa el mismo día. En el resto de la provincia damos soporte remoto y visitas programadas."
  >
    <ListaEnlaces columnas={3} items={pueblosIT.map((p) => ({ href: `${HUB_IT}${p.slug}/`, label: `Informático en ${p.nombre}`, sub: p.comarca }))} />
  </SeccionLectura>

  <SeccionLectura id="faq" titulo="Preguntas frecuentes sobre mantenimiento informático">
    <Preguntas items={faq} />
  </SeccionLectura>

  <Fragment slot="cierre">
    <Contact tono="consola" />
  </Fragment>
</LecturaLayout>
