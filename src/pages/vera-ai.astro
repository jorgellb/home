---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import VeraAgent from '../components/vera/VeraAgent.tsx';

const title = 'Vera AI: Demo de IA para Negocios Locales';
const description =
  'Demo de IA que analiza tu negocio local y propone automatizaciones: elige tu sector, cuenta tu problema y recibe diagnóstico, solución y precio orientativo.';
const canonical = 'https://platanitorico.com/vera-ai/';

const sectores = [
  { ico: '🏖️', t: 'Alquiler vacacional', d: 'Asistente de huéspedes, reservas directas, reseñas.' },
  { ico: '🏠', t: 'Inmobiliarias', d: 'CRM inteligente, captación de propietarios, anuncios.' },
  { ico: '🍽️', t: 'Restaurantes', d: 'Bot de reservas, menú inteligente, recordatorios.' },
  { ico: '💆', t: 'Clínicas y estética', d: 'Agenda inteligente, recordatorios, reactivación.' },
  { ico: '🧾', t: 'Facturación / pymes', d: 'Lector de facturas, panel de cobros, alertas.' },
];

const pasos = [
  { n: '01', t: 'Eliges tu sector', d: 'Apartamentos, inmobiliaria, restaurante, clínica o facturación.' },
  { n: '02', t: 'Cuentas tu problema', d: 'En tus palabras: qué te quita tiempo o te hace perder clientes.' },
  { n: '03', t: 'Vera analiza', d: 'Detecta el dolor principal y lo cruza con una oportunidad de automatización.' },
  { n: '04', t: 'Recibes la propuesta', d: 'Diagnóstico, solución con nombre, funciones, precio y mensaje de venta.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Vera AI Business Agent',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: canonical,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://platanitorico.com/' },
      { '@type': 'ListItem', position: 2, name: 'Vera AI Business Agent', item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Vera AI Business Agent - demo de IA para negocios locales"
  type="website"
  lang="es"
  keywords="agente IA negocios locales, automatización pymes Almería, demo IA, asistente IA empresas, chatbot negocio, IA para restaurantes inmobiliarias clínicas"
  jsonLd={jsonLd}
>
  <Header />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Vera AI Business Agent' },
  ]} />

  <main id="main-content" class="vp">
    {/* HERO */}
    <section class="vp-hero">
      <div class="container-brutal vp-hero__inner">
        <span class="vp-eyebrow">✦ Demo en vivo · Agente de IA</span>
        <h1 class="vp-hero__title">Vera <em>AI</em> Business Agent</h1>
        <p class="vp-hero__lead">
          Un asistente de IA que <strong>analiza tu negocio local</strong> y te propone qué
          automatizaciones o apps podrían mejorarlo. Elige tu sector, cuéntale tu problema y
          recibe una propuesta clara: diagnóstico, solución, funciones y precio orientativo.
        </p>
        <div class="vp-hero__chips">
          <span>🧠 Analiza el problema real</span>
          <span>🛠️ Propone una solución concreta</span>
          <span>💬 Te da un mensaje de venta</span>
        </div>
      </div>
    </section>

    {/* SECTORES */}
    <section class="vp-sectors">
      <div class="container-brutal">
        <ul class="vp-sectors__grid">
          {sectores.map((s) => (
            <li class="vp-sector">
              <span class="vp-sector__ico" aria-hidden="true">{s.ico}</span>
              <b>{s.t}</b>
              <span>{s.d}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* DEMO (island React) */}
    <section class="vp-demo" id="demo">
      <div class="container-brutal">
        <header class="vp-sec-head">
          <span class="vp-eyebrow vp-eyebrow--dark">✦ Pruébalo ahora</span>
          <h2 class="vp-h2">Cuéntale tu caso a Vera.</h2>
        </header>
        <VeraAgent client:load />
        <noscript>
          <p class="vp-noscript">Activa JavaScript para usar la demo de Vera AI.</p>
        </noscript>
      </div>
    </section>

    {/* CÓMO FUNCIONA */}
    <section class="vp-steps">
      <div class="container-brutal">
        <header class="vp-sec-head">
          <span class="vp-eyebrow">✦ Cómo funciona</span>
          <h2 class="vp-h2 vp-h2--light">De un problema real a una solución vendible.</h2>
        </header>
        <ol class="vp-steps__list">
          {pasos.map((s) => (
            <li class="vp-step">
              <span class="vp-step__n">{s.n}</span>
              <div>
                <h3 class="vp-step__t">{s.t}</h3>
                <p class="vp-step__d">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="vp-note">
          Esta demo es una demostración de portfolio: muestra cómo una IA puede actuar como
          <strong> consultor de negocio</strong>, no como un simple chatbot. En un proyecto real se
          conecta con WhatsApp, el CRM o las herramientas del cliente. La IA no sustituye decisiones
          importantes y nunca inventa precios ni condiciones legales.
        </p>
      </div>
    </section>

    {/* CTA */}
    <section class="vp-cta">
      <div class="container-brutal vp-cta__inner">
        <span class="vp-eyebrow">✦ ¿Lo quieres para tu negocio?</span>
        <h2 class="vp-cta__title">Te montamos tu agente de IA a medida.</h2>
        <p class="vp-cta__text">
          Creamos asistentes de IA que captan clientes, responden solos y automatizan tareas para
          apartamentos turísticos, inmobiliarias, restaurantes, clínicas y pymes.
        </p>
        <div class="vp-cta__btns">
          <a href="/contacto/" class="btn-brutal btn-brutal--lg">Quiero mi agente de IA →</a>
          <a href="/soluciones/empresa/" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Ver soluciones</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .vp { background: #05070b; color: #e8edf5; }
  .vp-eyebrow {
    display: inline-block; font-family: var(--font-mono, monospace);
    font-size: .66rem; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: #c6ff3a;
  }
  .vp-eyebrow--dark { color: #FF6B35; }

  .vp-hero {
    padding: 4rem 0 2.5rem;
    background: radial-gradient(90% 60% at 50% -10%, rgba(198,255,58,0.14) 0%, transparent 60%), linear-gradient(180deg, #0a0f18, #05070b);
    border-bottom: 1px solid #1a2233; position: relative; overflow: hidden;
  }
  .vp-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(#c6ff3a12 1px, transparent 1px), linear-gradient(90deg, #c6ff3a12 1px, transparent 1px);
    background-size: 30px 30px; mask-image: radial-gradient(70% 60% at 50% 0%, #000 0%, transparent 75%);
  }
  .vp-hero__inner { position: relative; }
  .vp-hero__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.5rem, 8vw, 5rem); font-weight: 800; line-height: .95; letter-spacing: -.04em; margin: 1rem 0; color: #fff; }
  .vp-hero__title em { font-style: normal; color: #c6ff3a; }
  .vp-hero__lead { font-size: clamp(1.05rem, 2.4vw, 1.3rem); line-height: 1.5; color: #b9c4d4; max-width: 60ch; margin: 0 0 1.5rem; }
  .vp-hero__lead strong { color: #fff; }
  .vp-hero__chips { display: flex; flex-wrap: wrap; gap: .6rem; }
  .vp-hero__chips span { font-family: var(--font-mono, monospace); font-size: .72rem; padding: .45rem .8rem; border: 1px solid #232a38; border-radius: 999px; color: #cdd7e6; background: #0c111b; }

  .vp-sectors { padding: 2.5rem 0; background: #080c14; border-bottom: 1px solid #1a2233; }
  .vp-sectors__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: .8rem; }
  @media (min-width: 560px) { .vp-sectors__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .vp-sectors__grid { grid-template-columns: repeat(5, 1fr); } }
  .vp-sector { background: #0c111b; border: 1.5px solid #1f2735; border-radius: 14px; padding: 1.1rem 1rem; }
  .vp-sector__ico { font-size: 1.5rem; }
  .vp-sector b { display: block; margin: .5rem 0 .3rem; color: #fff; font-size: .98rem; }
  .vp-sector span { font-size: .8rem; line-height: 1.4; color: #aeb9c9; }

  .vp-demo { padding: 3.5rem 0; background: var(--brutal-bg, #F5F1EA); color: var(--brutal-ink, #0E0D0B); border-top: 3px solid var(--brutal-ink, #0E0D0B); border-bottom: 3px solid var(--brutal-ink, #0E0D0B); }
  .vp-noscript { text-align: center; color: #6a6258; margin-top: 1.5rem; }
  .vp-sec-head { text-align: center; max-width: 60ch; margin: 0 auto 2rem; }
  .vp-h2 { font-family: var(--font-display, sans-serif); font-size: clamp(1.9rem, 5vw, 3rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin: .6rem 0 0; }
  .vp-h2--light { color: #fff; }

  .vp-steps { padding: 4rem 0; background: #080c14; }
  .vp-steps__list { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 768px) { .vp-steps__list { grid-template-columns: 1fr 1fr; } }
  .vp-step { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.4rem 1.3rem; background: #0c111b; border: 1.5px solid #1f2735; border-radius: 16px; }
  .vp-step__n { font-family: var(--font-mono, monospace); font-weight: 800; color: #c6ff3a; }
  .vp-step__t { margin: 0 0 .4rem; font-family: var(--font-display, sans-serif); font-size: 1.1rem; font-weight: 800; color: #fff; }
  .vp-step__d { margin: 0; font-size: .9rem; line-height: 1.5; color: #aeb9c9; }
  .vp-note { margin: 2rem 0 0; padding: 1.3rem 1.4rem; border: 1px dashed #2a3445; border-radius: 14px; background: #0a0f18; font-size: .9rem; line-height: 1.6; color: #aeb9c9; }
  .vp-note strong { color: #fff; }

  .vp-cta { padding: 4.5rem 0; background: radial-gradient(80% 100% at 50% 0%, rgba(255,107,53,0.14) 0%, transparent 60%), #05070b; border-top: 1px solid #1a2233; }
  .vp-cta__inner { max-width: 720px; }
  .vp-cta__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.2rem, 6vw, 4rem); font-weight: 800; letter-spacing: -.04em; line-height: .95; margin: .6rem 0 1rem; color: #fff; }
  .vp-cta__text { font-size: 1.05rem; line-height: 1.55; color: #b9c4d4; margin: 0 0 2rem; }
  .vp-cta__btns { display: flex; flex-wrap: wrap; gap: 1rem; }
  .vp-cta .btn-brutal--ghost { background: transparent; color: #fff; border-color: #2a3445; }
</style>
