---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = "Política de Cookies | Platanito Rico";
const description = "Información sobre el uso de cookies técnicas en el sitio web de Platanito Rico.";
const lastUpdate = "febrero 2026";
const docId = "CO-2026-029";

const toc = [
  { n: '01', id: 's1', label: '¿Qué son las cookies?' },
  { n: '02', id: 's2', label: 'Tipos que utilizamos' },
  { n: '03', id: 's3', label: 'Qué NO utilizamos' },
  { n: '04', id: 's4', label: 'Gestión y desactivación' },
];
---

<BaseLayout title={title} description={description} noindex={true}>
  <Header />

  <main class="legal">
    <div class="legal-gazette" aria-hidden="true">
      <div class="legal-gazette__track">
        {Array.from({length: 4}).map(() => (
          <>
            <span>Documento Oficial</span><span>★</span>
            <span>Política de Cookies</span><span>★</span>
            <span>LSSI · Art. 22.2 · AEPD</span><span>★</span>
            <span>Solo técnicas · sin tracking</span><span>★</span>
            <span>ID · {docId}</span><span>★</span>
          </>
        ))}
      </div>
    </div>

    <section class="legal-mast">
      <div class="container-brutal">
        <header class="legal-mast__head">
          <span class="legal-mast__edition">N.º 029 — Documentos Oficiales · Vol. 2026</span>
          <span class="legal-mast__edition">★ Vigente desde {lastUpdate}</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="legal-mast__doc">
          <div>
            <span class="legal-mast__num">029</span>
            <h1 class="legal-mast__title">
              Política de
              <em>cookies.</em>
            </h1>
          </div>
          <div style="display:flex;gap:1rem;flex-wrap:wrap;">
            <div class="legal-seal">
              <span class="legal-seal__star">⚙</span>
              <span class="legal-seal__line">SOLO</span>
              <span class="legal-seal__line legal-seal__line--big">TÉCNICAS</span>
              <span class="legal-seal__line">Sin consentimiento</span>
            </div>
            <div class="legal-seal legal-seal--ink">
              <span class="legal-seal__star">∅</span>
              <span class="legal-seal__line">CERO</span>
              <span class="legal-seal__line legal-seal__line--big">TRACKING</span>
              <span class="legal-seal__line">No GA · no Meta</span>
            </div>
          </div>
        </div>

        <p class="legal-mast__intro">
          Aquí lo importante en una frase: <strong>solo usamos cookies técnicas estrictamente necesarias</strong>
          para que la web funcione. Nada de Google Analytics, Meta Pixel ni nada parecido.
        </p>

        <dl class="legal-mast__spec">
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Documento</dt>
            <dd class="legal-mast__spec-v">{docId}</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Última actualización</dt>
            <dd class="legal-mast__spec-v">{lastUpdate}</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Cookies activas</dt>
            <dd class="legal-mast__spec-v">2 técnicas</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Tiempo de lectura</dt>
            <dd class="legal-mast__spec-v">~2 minutos</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="container-brutal">
      <div class="legal-grid">
        <aside class="legal-toc" aria-label="Índice del documento">
          <header class="legal-toc__head">
            <span class="text-meta">Índice</span>
            <span class="text-meta">{toc.length} secciones</span>
          </header>
          <ol class="legal-toc__list">
            {toc.map((t) => (
              <li class="legal-toc__item">
                <a href={`#${t.id}`} class="legal-toc__link" data-toc-link>
                  <span class="legal-toc__num">{t.n}</span>
                  <span>{t.label}</span>
                </a>
              </li>
            ))}
          </ol>

          <div class="legal-toc__seals">
            <button type="button" class="legal-toc__action" onclick="window.print()">⎙ Imprimir</button>
            <a href="/privacidad/" class="legal-toc__action">→ Ver privacidad</a>
          </div>
        </aside>

        <article class="legal-article">
          <div class="legal-highlight">
            <div class="legal-highlight__icon">!</div>
            <div class="legal-highlight__body">
              <h2 class="legal-highlight__title">Resumen ultra rápido</h2>
              <p>
                Esta web utiliza <strong>únicamente cookies técnicas necesarias</strong> para funcionar.
                Sin tracking, sin publicidad, sin redes sociales. Tu navegación es privada.
              </p>
            </div>
          </div>

          <p>
            Las cookies son ficheros que se descargan en tu navegador al visitar una web. Sirven para que
            la web recuerde acciones (como aceptar un aviso) o reconozca al usuario en visitas futuras.
            Existen muchas — pero <strong>nosotros solo usamos las que son estrictamente necesarias</strong>
            para que el sitio funcione.
          </p>

          <section id="s1" class="legal-section">
            <span class="legal-section__num">N.º 01</span>
            <h2 class="legal-section__title">¿Qué son <em>las cookies?</em></h2>
            <p>
              Una cookie es un fichero que se descarga en tu ordenador al acceder a determinadas páginas web.
              Permiten almacenar y recuperar información sobre los hábitos de navegación o el equipo del
              usuario y, según la información que contengan y la forma en que se utilice, pueden usarse
              para reconocer al usuario.
            </p>
          </section>

          <section id="s2" class="legal-section">
            <span class="legal-section__num">N.º 02</span>
            <h2 class="legal-section__title">
              Tipos que
              <em>utilizamos.</em>
            </h2>
            <p>
              Esta web utiliza únicamente <strong>cookies técnicas</strong>. Permiten al usuario navegar
              por la página y usar sus diferentes opciones o servicios.
            </p>
            <p>
              Según el artículo <strong>22.2 de la LSSI</strong> y las directrices de la <strong>AEPD</strong>
              (Agencia Española de Protección de Datos), estas cookies <strong>están exentas de la obligación
              de obtener el consentimiento informado</strong> del usuario porque son estrictamente necesarias
              para la prestación del servicio.
            </p>

            <table class="legal-table">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Tipo</th>
                  <th>Duración</th>
                  <th>Finalidad</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>cookies_accepted</td>
                  <td>Técnica</td>
                  <td>1 año</td>
                  <td>Recordar que has visto / aceptado el aviso de cookies</td>
                </tr>
                <tr>
                  <td>session_id</td>
                  <td>Técnica</td>
                  <td>Sesión</td>
                  <td>Identificador técnico de sesión · seguridad y funcionamiento</td>
                </tr>
              </tbody>
            </table>
          </section>

          <blockquote class="legal-pull">
            "No te rastreamos. <em>Ni nosotros, ni Google, ni Meta.</em> Tu visita es privada."
          </blockquote>

          <section id="s3" class="legal-section">
            <span class="legal-section__num">N.º 03</span>
            <h2 class="legal-section__title">
              Qué
              <em>NO utilizamos.</em>
            </h2>
            <p>Para garantizar tu privacidad, te informamos que <strong>NO utilizamos</strong>:</p>

            <ul class="legal-bento">
              <li>
                <span class="legal-bento__num">∅ Analítica</span>
                <h3 class="legal-bento__t">Google Analytics</h3>
                <p class="legal-bento__d">Tampoco Hotjar, Matomo ni similares.</p>
              </li>
              <li>
                <span class="legal-bento__num">∅ Publicidad</span>
                <h3 class="legal-bento__t">Píxeles de Meta · Google Ads</h3>
                <p class="legal-bento__d">Cero remarketing, cero perfil publicitario.</p>
              </li>
              <li>
                <span class="legal-bento__num">∅ Redes sociales</span>
                <h3 class="legal-bento__t">Cookies de RRSS</h3>
                <p class="legal-bento__d">Sin botones que rastreen tu navegación fuera.</p>
              </li>
            </ul>
          </section>

          <section id="s4" class="legal-section">
            <span class="legal-section__num">N.º 04</span>
            <h2 class="legal-section__title">
              Gestión y
              <em>desactivación.</em>
            </h2>
            <p>
              Aunque las cookies técnicas son necesarias para el funcionamiento correcto del sitio,
              puedes permitir, bloquear o eliminar las cookies instaladas en tu equipo mediante la
              configuración de tu navegador:
            </p>
            <ul>
              <li><a href="https://support.google.com/chrome/answer/95647?hl=es" target="_blank" rel="noopener noreferrer">Google Chrome</a></li>
              <li><a href="https://support.mozilla.org/es/kb/habilitar-y-deshabilitar-cookies-sitios-web-rastrear-preferencias" target="_blank" rel="noopener noreferrer">Mozilla Firefox</a></li>
              <li><a href="https://support.apple.com/es-es/guide/safari/sfri11471/mac" target="_blank" rel="noopener noreferrer">Safari</a></li>
              <li><a href="https://support.microsoft.com/es-es/microsoft-edge/eliminar-las-cookies-en-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09" target="_blank" rel="noopener noreferrer">Microsoft Edge</a></li>
            </ul>
            <p>
              Ten en cuenta que si deshabilitas las cookies técnicas, es posible que algunas secciones
              del sitio web no funcionen correctamente.
            </p>
          </section>

          <footer class="legal-colophon">
            <div class="legal-colophon__text">
              Documento oficial <strong>{docId}</strong>.<br/>
              Vigente desde <strong>{lastUpdate}</strong>.<br/>
              Cumple <strong>LSSI Art. 22.2</strong> · directrices AEPD.
            </div>
            <div class="legal-colophon__sig">
              <span class="legal-colophon__sig-name">Jorge L. López</span>
              <span class="legal-colophon__sig-role">Responsable · Platanito Rico</span>
            </div>
          </footer>
        </article>
      </div>
    </div>

    <section class="legal-final">
      <div class="container-brutal">
        <div class="legal-final__inner">
          <span class="text-meta">★ Más información</span>
          <h2 class="legal-final__title">
            Más sobre tu
            <em>privacidad.</em>
          </h2>
          <p class="legal-final__text">
            Si quieres saber qué datos tratamos y cómo, consulta la
            <strong>Política de Privacidad</strong>. Si tienes dudas, escríbenos.
          </p>
          <div class="legal-final__btns">
            <a href="/privacidad/" class="btn-brutal btn-brutal--lg">Ver política de privacidad →</a>
            <a href="/contacto" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Contactar</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const links = document.querySelectorAll('[data-toc-link]');
  const sections = Array.from(links).map(a => document.querySelector(a.getAttribute('href') || ''));
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        links.forEach(l => l.classList.toggle('is-active', l.getAttribute('href') === `#${id}`));
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(s => s && observer.observe(s));
</script>
