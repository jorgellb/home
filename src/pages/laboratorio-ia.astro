---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Relacionados from '../components/cdm/Relacionados.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import Boton from '../components/cdm/Boton.astro';

const title = 'Laboratorio de IA · Demos en vivo | Platanito Rico';
const description =
  'Demos de IA en vivo hechas en Almería: asistentes, agentes de negocio, marca, sonido, 3D y realidad aumentada. Pruébalas gratis desde el navegador.';
const canonical = 'https://platanitorico.com/laboratorio-ia/';

const demos = [
  { ico: '🕶️', tag: 'AR · Cámara', t: 'Probador Virtual AR', d: 'Pruébate gafas, sombreros o gorras desde la cámara del móvil, sin instalar nada. Realidad aumentada para ecommerce.', href: '/probador-virtual-ar/', accent: '#FF2D9A' },
  { ico: '👁️', tag: 'Visión · Ecommerce', t: 'De una foto a una ficha que vende', d: 'Sube la foto de un producto y la IA genera una ficha de e-commerce completa: copy ES/EN/FR/DE, SEO, SKU y SQL.', href: '/soluciones/ecommerce/#commerce-ai', accent: '#18e0ff' },
  { ico: '💬', tag: 'Chat · Atención', t: 'Un asistente de IA que atiende por ti', d: 'Un agente que resuelve dudas sobre servicios, precios y plazos como una persona, 24/7, y capta clientes.', href: '/asistente-ia/', accent: '#18e0ff' },
  { ico: '🎙️', tag: 'Voz', t: 'Habla con la IA', d: 'Habla por el micrófono y la IA te responde con voz, en tiempo real, con una presencia visual viva.', href: '/asistente-voz/', accent: '#c6ff3a' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage',
    name: 'Laboratorio de IA', description, url: canonical, inLanguage: 'es',
    isPartOf: { '@type': 'WebSite', name: 'Platanito Rico', url: 'https://platanitorico.com' },
    hasPart: demos.map((x) => ({ '@type': 'WebApplication', name: x.t, applicationCategory: 'BusinessApplication', url: `https://platanitorico.com${x.href}` })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://platanitorico.com/' },
      { '@type': 'ListItem', position: 2, name: 'Laboratorio de IA', item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-desarrollo-web-calidad.jpg"
  imageAlt="Laboratorio de IA - Platanito Rico"
  type="website"
  lang="es"
  keywords="demos de IA, inteligencia artificial Almería, agente IA, visión por ordenador, asistente de voz, realidad aumentada, IA para empresas"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb tono="consola" items={[{ label: 'Inicio', href: '/' }, { label: 'Laboratorio de IA' }]} />

  <main id="main-content" class="lab">
    {/* HERO */}
    <section class="lab-hero">
      <div class="container-brutal lab-hero__inner">
        <span class="lab-eyebrow">✦ Demos en vivo · Hechas en Almería</span>
        <h1 class="lab-hero__title">Laboratorio de <em>IA</em></h1>
        <p class="lab-hero__lead">
          No solo hablamos de inteligencia artificial: la ponemos a funcionar. Prueba aquí mismo nuestros
          agentes y experiencias —visión, voz, visualización de negocio, estrategia y realidad aumentada—.
          Lo que ves, lo construimos a medida para tu empresa.
        </p>
        <div class="lab-hero__stats">
          <span><b>4</b> demos en vivo</span>
          <span><b>0 €</b> probarlas</span>
          <span><b>Sin registro</b></span>
        </div>
      </div>
    </section>

    {/* GRID DE DEMOS */}
    <section class="lab-grid-wrap">
      <div class="container-brutal">
        <ul class="lab-grid">
          {demos.map((x, i) => (
            <li class="lab-card" style={`--accent:${x.accent}`}>
              <a href={x.href} class="lab-card__link">
                <span class="lab-card__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="lab-card__ico" aria-hidden="true">{x.ico}</span>
                <span class="lab-card__tag">{x.tag}</span>
                <h2 class="lab-card__title">{x.t}</h2>
                <p class="lab-card__desc">{x.d}</p>
                <span class="lab-card__cta">Probar la demo →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* CTA */}
    <section class="lab-cta">
      <div class="container-brutal lab-cta__inner">
        <span class="lab-eyebrow">✦ ¿Lo quieres para tu negocio?</span>
        <h2 class="lab-cta__title">Te montamos la IA que necesitas.</h2>
        <p class="lab-cta__text">
          Agentes, asistentes de voz, visión por ordenador, automatizaciones a medida… Si lo has probado aquí,
          podemos adaptarlo a tu empresa y conectarlo con tus herramientas.
        </p>
        <p class="lab-cta__sube">Esto es la muestra. Lo que construimos para empresas está en <a href="/ia-empresas/">IA para empresas</a>: agentes conectados a tus datos, con aprobación humana.</p>
        <div class="lab-cta__btns">
          <Boton href="/contacto/">Quiero IA en mi negocio</Boton>
          <Boton href="/soluciones/empresa/" variante="linea">Ver soluciones</Boton>
        </div>
      </div>
    </section>
  
    <Relacionados titulo="Sigue por aquí" columnas={3} items={[
      { href: '/soluciones/empresa/', label: 'Soluciones para empresas', sub: 'Llevar la IA a tu operación' },
      { href: '/informatica-empresas/', label: 'Sistemas IT', sub: 'La base sobre la que corre todo' },
      { href: '/desarrollo-web/', label: 'Diseño y desarrollo web', sub: 'La web donde vive el producto' },
    ]} />
</main>

  <Footer />
</BaseLayout>

<style>
  .lab { background: var(--color-cdm-suelo); color: var(--color-cdm-texto); }
  .lab-eyebrow { display: inline-block; font-family: var(--font-mono, monospace); font-size: .66rem; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: #18e0ff; }

  .lab-hero {
    padding: 4.5rem 0 2.5rem;
    background: radial-gradient(90% 60% at 50% -10%, rgba(24,224,255,0.16) 0%, transparent 60%), linear-gradient(180deg, var(--color-cdm-panel), var(--color-cdm-suelo));
    border-bottom: 1px solid var(--color-cdm-regla); position: relative; overflow: hidden; text-align: center;
  }
  .lab-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(#18e0ff14 1px, transparent 1px), linear-gradient(90deg, #18e0ff14 1px, transparent 1px);
    background-size: 30px 30px; mask-image: radial-gradient(70% 60% at 50% 0%, #000 0%, transparent 75%);
  }
  .lab-hero__inner { position: relative; }
  .lab-hero__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.6rem, 8vw, 5.5rem); font-weight: 800; line-height: .95; letter-spacing: -.04em; margin: 1rem 0; color: var(--color-cdm-texto); }
  .lab-hero__title em { font-style: normal; color: #18e0ff; }
  .lab-hero__lead { font-size: clamp(1.05rem, 2.3vw, 1.3rem); line-height: 1.55; color: #b9c5cf; max-width: 62ch; margin: 0 auto 1.6rem; }
  .lab-hero__stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; font-family: var(--font-mono, monospace); font-size: .8rem; color: #b9c5cf; }
  .lab-hero__stats b { color: #c6ff3a; font-size: 1.1rem; }

  .lab-grid-wrap { padding: 3.5rem 0; background: linear-gradient(180deg, var(--color-cdm-suelo), var(--color-cdm-panel)); }
  .lab-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 640px) { .lab-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .lab-grid { grid-template-columns: 1fr 1fr 1fr; } }
  .lab-card { position: relative; }
  .lab-card__link {
    display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit;
    background: rgba(14, 20, 32, 0.7); border: 1px solid rgba(120, 160, 220, 0.2); border-radius: 0;
    padding: 1.5rem 1.4rem; transition: transform .15s, border-color .15s, box-shadow .15s; position: relative; overflow: hidden;
  }
  .lab-card__link::before { content: ''; position: absolute; left: 0; top: 0; height: 3px; width: 100%; background: var(--accent); opacity: .8; }
  .lab-card__link:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 16px 40px -16px var(--accent); }
  .lab-card__num { font-family: var(--font-mono, monospace); font-size: .72rem; color: var(--color-cdm-tenue); }
  .lab-card__ico { font-size: 2.2rem; margin: .2rem 0 .6rem; }
  .lab-card__tag { font-family: var(--font-mono, monospace); font-size: .66rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .lab-card__title { font-family: var(--font-display, sans-serif); font-size: 1.3rem; font-weight: 800; letter-spacing: -.02em; line-height: 1.1; margin: .4rem 0 .5rem; color: var(--color-cdm-texto); }
  .lab-card__desc { font-size: .9rem; line-height: 1.5; color: #b9c5cf; margin: 0 0 1.1rem; flex: 1; }
  .lab-card__cta { font-family: var(--font-mono, monospace); font-size: .82rem; font-weight: 700; color: var(--accent); }

  .lab-cta { padding: 4.5rem 0; background: radial-gradient(80% 100% at 50% 0%, rgba(198,255,58,0.12) 0%, transparent 60%), var(--color-cdm-suelo); border-top: 1px solid var(--color-cdm-regla); }
  .lab-cta__inner { max-width: 720px; }
  .lab-cta__title { font-family: var(--font-display, sans-serif); font-size: clamp(2.2rem, 6vw, 4rem); font-weight: 800; letter-spacing: -.04em; line-height: .95; margin: .6rem 0 1rem; color: var(--color-cdm-texto); }
  .lab-cta__text { font-size: 1.05rem; line-height: 1.55; color: #b9c5cf; margin: 0 0 2rem; }
  .lab-cta__sube { font-size: 1rem; line-height: 1.6; color: #b9c5cf; max-width: 56ch; margin: 0 0 1.5rem; }
  .lab-cta__sube a { color: var(--color-cdm-texto); border-bottom: 1px solid var(--color-cdm-senal); text-decoration: none; }
  .lab-cta__btns { display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
