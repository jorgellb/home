  .mk-section-head { max-width: 720px; margin-bottom: 3rem; }
  .mk-h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .9;
    letter-spacing: -.04em;
