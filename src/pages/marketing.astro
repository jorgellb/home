---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Agencia Marketing Digital en Almería | SEO, Ads y Redes Sociales';
const description = 'Marketing digital en Almería con resultados medibles. SEO, Google Ads, Meta Ads y redes sociales. Deja de invertir a ciegas. Presupuesto gratis.';
const canonical = 'https://platanitorico.com/marketing/';

const services = [
  { n: '01', title: 'SEM · Ads de pago',         kicker: 'Google · Meta · LinkedIn', desc: 'Campañas optimizadas para captar clientes ahora mismo. Controlamos cada euro para que convierta. Sin agencias de Excel, sin "vamos viendo".', features: ['Google Ads (Search · Display · Shopping)','Meta Ads (Facebook · Instagram)','LinkedIn Ads B2B','Píxeles + conversiones','Optimización continua','Remarketing + audiencias'], figure: 'D1', figureLabel: 'Primer lead', accent: 'accent' },
  { n: '02', title: 'SEO · Posicionamiento',    kicker: 'Técnico · Local · Content',  desc: 'Aparece en Google cuando tus clientes buscan lo que vendes. Estrategia orgánica que genera tráfico constante sin pagar por cada clic.', features: ['Auditoría técnica completa','Keyword research estratégico','On-page + contenidos','Link building ético','SEO local + Google Business','Informes mensuales'], figure: 'Top 3', figureLabel: 'Objetivo Google', accent: 'paper' },
  { n: '03', title: 'Redes sociales',            kicker: 'IG · TikTok · LinkedIn',     desc: 'Construimos una comunidad real alrededor de tu marca. Contenido que conecta, engancha y convierte seguidores en clientes.', features: ['Estrategia de contenidos','IG · FB · LinkedIn · TikTok','Creatividades + reels','Calendario editorial mensual','Moderación DMs y comentarios','Métricas y crecimiento'], figure: '+45%', figureLabel: 'Engagement medio', accent: 'lime' },
  { n: '04', title: 'Email · Automatización',    kicker: 'Newsletter · CRM · Funnel',  desc: 'Convierte tu base de datos en una máquina de ventas automática. Secuencias que nutren, fidelizan y recuperan clientes perdidos.', features: ['Newsletters profesionales','Welcome · carrito · reactivación','Segmentación avanzada','Lead magnets + funnels','A/B testing','Integración CRM'], figure: 'ROI 5×', figureLabel: 'Email vs Ads', accent: 'ink' },
];

const process = [
  { num: '01', title: 'Auditoría gratuita',     eta: '1–2 días', body: 'Analizamos tu web, competencia, posicionamiento actual y oportunidades. Te decimos exactamente dónde estás perdiendo clientes.', deliverable: 'Diagnóstico escrito + recomendaciones' },
  { num: '02', title: 'Estrategia personalizada', eta: '3–5 días', body: 'Plan de acción adaptado a tu negocio, presupuesto y objetivos. Sin plantillas genéricas: cada estrategia es única.', deliverable: 'Roadmap mensual + KPIs' },
  { num: '03', title: 'Ejecución y optimización', eta: 'Continuo', body: 'Lanzamos campañas, optimizamos tu SEO y gestionamos tus redes. Cada semana ajustamos para mejorar resultados.', deliverable: 'Dashboard tiempo real + iteración semanal' },
  { num: '04', title: 'Informes y revisión',    eta: 'Mensual',  body: 'Dashboard en tiempo real con las métricas que importan. Reunión periódica para revisar resultados y ajustar la estrategia.', deliverable: 'Informe + sesión estratégica' },
];

const channels = [
  { k: 'Google Ads',     v: 'Search · Display · Shopping · YouTube · Performance Max' },
  { k: 'Meta Ads',       v: 'Facebook · Instagram · Reels · Stories · Audience Network' },
  { k: 'LinkedIn Ads',   v: 'Sponsored Content · Message Ads · Conversation · B2B' },
  { k: 'SEO técnico',    v: 'Core Web Vitals · Schema · Sitemap · Search Console' },
  { k: 'SEO local',      v: 'Google Business · NAP · Reseñas · Citaciones · Maps' },
  { k: 'Email · CRM',    v: 'Mailchimp · Brevo · ActiveCampaign · HubSpot · Klaviyo' },
  { k: 'Analítica',      v: 'GA4 · GTM · Looker Studio · Matomo · Cookie banner' },
  { k: 'Redes',          v: 'Meta · TikTok · LinkedIn · YouTube · X · Pinterest' },
];

const sectors = [
  { title: 'Hostelería y turismo',  desc: 'Restaurantes, hoteles y casas rurales que quieren llenar mesas y habitaciones todo el año.' },
  { title: 'Inmobiliarias',          desc: 'Agencias que necesitan captar propietarios vendedores y compradores cualificados.' },
  { title: 'E-commerce',             desc: 'Tiendas que quieren escalar con publicidad rentable y SEO que convierte.' },
  { title: 'Servicios profesionales', desc: 'Abogados, clínicas, consultorías y profesionales que necesitan un flujo constante de clientes.' },
  { title: 'Construcción y reformas', desc: 'Empresas de obra y reformas que quieren presupuestos de calidad, no curiosos.' },
  { title: 'Agricultura y exportación', desc: 'Cooperativas y productores que quieren abrir mercados nacionales e internacionales.' },
];

const testimonials = [
  { text: 'Llevábamos dos años invirtiendo en Google Ads sin control. Desde que trabajan nuestra cuenta hemos triplicado los leads manteniendo el mismo presupuesto.', author: 'María L.',   role: 'Dirección comercial · Inmobiliaria · Almería' },
  { text: 'Nos gestionan redes sociales e email marketing. En 6 meses pasamos de 200 a 2.400 seguidores reales y las reservas online subieron un 45%.',               author: 'Antonio R.', role: 'Propietario · Restaurante · Mojácar' },
  { text: 'El SEO local fue clave. Ahora aparecemos los primeros en Google Maps y recibimos 3–4 llamadas diarias de clientes nuevos.',                                 author: 'Carmen D.',  role: 'Gerente · Clínica dental · Roquetas' },
  { text: 'Probamos con otra agencia y nada. Con Platanito Rico todo cambió: dashboard transparente, reuniones claras y resultados desde el segundo mes.',           author: 'Javier M.',  role: 'CEO · Empresa de reformas · Almería' },
];

const faq = [
  { q: '¿Cuánto tarda en verse resultados en marketing digital?', a: 'Depende del canal. SEM (anuncios): resultados desde la primera semana. SEO: primeros movimientos en 2–4 meses, resultados sólidos desde el sexto. Redes sociales: crecimiento progresivo acelerado con la estrategia correcta.' },
  { q: '¿Necesito un presupuesto mínimo para publicidad?', a: 'Recomendamos un mínimo de 300€/mes para campañas locales en Almería. E-commerce o mercados amplios: 500–1.000€/mes ideal. Optimizamos cada euro al máximo.' },
  { q: '¿Puedo ver qué hacéis con mi dinero en todo momento?', a: 'Sí. Dashboard en tiempo real con inversión, clics, leads y CPA por canal. Reuniones periódicas para revisar resultados juntos.' },
  { q: '¿Gestionáis las redes sociales de cualquier sector?', a: 'Sí, especialmente hostelería, inmobiliarias, e-commerce, servicios profesionales y construcción en la provincia. Conocemos el mercado local.' },
  { q: '¿Qué diferencia hay entre SEO y SEM?', a: 'SEO: posicionamiento orgánico (sin pagar por clic). Inversión a medio-largo plazo con resultados duraderos. SEM: publicidad de pago (instantánea). Ideal: combinarlos.' },
  { q: '¿Hay permanencia?', a: 'No. Sin permanencia. Nuestros clientes se quedan porque ven resultados, no porque estén atados.' },
  { q: '¿También hacéis la página web?', a: 'Sí. Diseño web optimizado para convertir + hosting gratuito de por vida para webs estáticas. Es la base ideal de cualquier estrategia.' },
  { q: '¿Cómo sé si mi marketing actual está funcionando?', a: 'Te hacemos una auditoría gratuita donde analizamos web, campañas, SEO y redes. Te decimos qué funciona, qué no, y dónde se está perdiendo dinero. Sin compromiso.' },
];

const jsonLdSchemas = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Marketing Digital","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Marketing Digital en Almería","description":"Agencia de marketing digital especializada en SEO, publicidad online, redes sociales y estrategia de contenidos para empresas en Almería.","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","address":{"@type":"PostalAddress","addressLocality":"Almería","addressRegion":"Andalucía","addressCountry":"ES"},"areaServed":{"@type":"State","name":"Almería"},"priceRange":"€€","hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios de Marketing Digital","itemListElement":services.map(s=>({"@type":"Offer","itemOffered":{"@type":"Service","name":s.title,"description":s.desc}}))} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo trabajamos tu marketing digital","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-marketing-web.jpg"
  imageAlt="Agencia de marketing digital en Almería - Platanito Rico"
  type="service"
  keywords="marketing digital almería, agencia seo almería, google ads almería, meta ads almería, gestión redes sociales, email marketing"
  jsonLd={jsonLdSchemas}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Marketing Digital' }]} />

  <main id="main-content">
    {/* HERO */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 012 — Servicio · Marketing</span>
          <span class="text-meta"><span class="live-dot"></span> Auditoría gratis en 48h</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Cap. 01 / Marketing digital</span>
            <h1 class="svc-hero__title">
              Deja de invertir
              <em>a ciegas.</em>
              <span class="text-stroke-ink">Mide. Optimiza.</span>
              Vende.
            </h1>
            <p class="svc-hero__lead">
              SEO, Google Ads, Meta Ads, redes sociales y email marketing
              <strong>con resultados medibles.</strong> Dashboard en tiempo real,
              sin permanencia, sin presentaciones de 80 slides.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">Auditoría gratuita →</a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">3×</span>
              <span class="svc-hero__spec-lbl">Leads vs antes</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">Top 3</span>
              <span class="svc-hero__spec-lbl">Objetivo SERP</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">0%</span>
              <span class="svc-hero__spec-lbl">Permanencia</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">24/7</span>
              <span class="svc-hero__spec-lbl">Dashboard live</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ GOOGLE ADS ★ META ADS ★ SEO TÉCNICO ★ GA4 · LOOKER ★ EMAIL · CRM ★ TIKTOK · IG ★</span>
          ))}
        </div>
      </div>
    </section>

    {/* SERVICIOS */}
    <section class="section-brutal" id="servicios">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Servicios</span>
            <h2 class="brutal-section-head__title">
              Cuatro palancas para
              <em>crecer.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Ads, SEO, redes y email. Trabajamos cada canal como un equipo
            integrado, no como silos sueltos que se ignoran entre sí.
          </p>
        </header>

        <ol class="svc-bento">
          {services.map((s) => (
            <li class={`svc-card svc-card--${s.accent}`}>
              <header class="svc-card__head">
                <span class="svc-card__num">{s.n}</span>
                <span class="svc-card__kicker">{s.kicker}</span>
              </header>
              <h3 class="svc-card__title">{s.title}</h3>
              <p class="svc-card__desc">{s.desc}</p>
              <ul class="svc-card__features">
                {s.features.map((f) => (
                  <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{f}</span></li>
                ))}
              </ul>
              <footer class="svc-card__foot">
                <div class="svc-card__figure">
                  <span class="svc-card__figure-val">{s.figure}</span>
                  <span class="svc-card__figure-lbl">{s.figureLabel}</span>
                </div>
                <a href="/contacto" class="svc-card__cta">Pedir auditoría →</a>
              </footer>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* CANALES · DATA SHEET */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Stack</span>
            <h2 class="brutal-section-head__title">
              Los canales y herramientas
              <em>que usamos.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Sin nombres rimbombantes. Aquí está el stack real con el que
            trabajamos cada día. Si tienes otro CRM o plataforma, nos adaptamos.
          </p>
        </header>

        <dl class="spec-list" style="max-width:760px;margin:2rem auto 0;">
          {channels.map((c) => (
            <div><dt class="spec-k">{c.k}</dt><dd class="spec-v">{c.v}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Método</span>
            <h2 class="brutal-section-head__title">
              Cómo trabajamos
              <em>tu marketing.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases con entregables claros: auditoría, estrategia,
            ejecución y revisión mensual. Tú decides en cada punto.
          </p>
        </header>

        <ol class="svc-process">
          {process.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < process.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* SECTORES */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Sectores</span>
            <h2 class="brutal-section-head__title">
              A quién hacemos
              <em>crecer.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Negocios reales de Almería que entienden que el marketing es una
            inversión, no un gasto. Estos son los sectores que mejor dominamos.
          </p>
        </header>

        <ul class="svc-sectors">
          {sectors.map((s, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{s.title}</h3>
              <p class="svc-sector__desc">{s.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* TESTIMONIOS */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 06 / Clientes</span>
            <h2 class="brutal-section-head__title">
              Resultados
              <em>reales.</em>
            </h2>
          </div>
        </header>

        <figure class="svc-pull">
          <div class="svc-pull__marks" aria-hidden="true">“</div>
          <blockquote class="svc-pull__quote">{testimonials[0].text}</blockquote>
          <figcaption class="svc-pull__cap">
            <span class="svc-pull__avatar">{testimonials[0].author[0]}</span>
            <div>
              <span class="svc-pull__name">{testimonials[0].author}</span>
              <span class="svc-pull__role">{testimonials[0].role}</span>
            </div>
          </figcaption>
        </figure>

        <ul class="svc-quotes">
          {testimonials.slice(1).map((t, i) => (
            <li class={`svc-quote svc-quote--${i}`}>
              <p>"{t.text}"</p>
              <footer>
                <span class="svc-quote__avatar">{t.author[0]}</span>
                <div>
                  <span class="svc-quote__name">{t.author}</span>
                  <span class="svc-quote__role">{t.role}</span>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* FAQ */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 07 / Preguntas frecuentes</span>
            <h2 class="brutal-section-head__title">
              Lo que más
              <em>nos preguntan.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Plazos, presupuestos, dashboards y diferencias entre canales.
            Si no está aquí, escríbenos y respondemos en menos de 24h.
          </p>
        </header>

        <ol class="svc-faq">
          {faq.map((f, i) => (
            <li class="svc-faq__item">
              <details class="svc-faq__details" open={i === 0}>
                <summary class="svc-faq__sum">
                  <span class="svc-faq__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-faq__q">{f.q}</span>
                  <span class="svc-faq__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-faq__answer"><p>{f.a}</p></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="svc-final__title">
            Empezamos con una
            <em>auditoría gratis.</em>
          </h2>
          <p class="svc-final__text">
            Te analizamos web, campañas, SEO y redes en 48h. Sin compromiso.
            Te decimos qué está funcionando, qué no, y dónde se va el dinero.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir auditoría gratis →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
