---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Agencia Marketing Digital en Almería | SEO, Ads y Redes Sociales';
const description = 'Marketing digital en Almería con resultados medibles. SEO, Google Ads, Meta Ads y redes sociales. Deja de invertir a ciegas. Presupuesto gratis.';
const canonical = 'https://platanitorico.com/marketing/';

const services = [
  { n: '01', title: 'SEM · Ads de pago',      kicker: 'Google · Meta · LinkedIn',    desc: 'Campañas optimizadas para captar clientes ahora mismo. Controlamos cada euro para que convierta.', features: ['Google Ads (Search · Display · Shopping)','Meta Ads (Facebook · Instagram)','LinkedIn Ads B2B','Píxeles + conversiones','Optimización continua','Remarketing + audiencias'], figure: 'D1', figureLabel: 'Primer lead', color: 'blue', icon: 'cursor' },
  { n: '02', title: 'SEO · Posicionamiento',  kicker: 'Técnico · Local · Content',   desc: 'Aparece en Google cuando tus clientes buscan lo que vendes. Tráfico orgánico que no se paga por clic.', features: ['Auditoría técnica completa','Keyword research estratégico','On-page + contenidos','Link building ético','SEO local + Google Business','Informes mensuales'], figure: 'Top 3', figureLabel: 'Objetivo Google', color: 'lime', icon: 'search' },
  { n: '03', title: 'Redes sociales',          kicker: 'IG · TikTok · LinkedIn',       desc: 'Comunidad real alrededor de tu marca. Contenido que conecta, engancha y convierte seguidores en clientes.', features: ['Estrategia de contenidos','IG · FB · LinkedIn · TikTok','Creatividades + reels','Calendario editorial mensual','Moderación DMs','Métricas y crecimiento'], figure: '+45%', figureLabel: 'Engagement medio', color: 'magenta', icon: 'heart' },
  { n: '04', title: 'Email · Automatización',  kicker: 'Newsletter · CRM · Funnel',   desc: 'Tu base de datos como máquina de ventas. Secuencias que nutren, fidelizan y recuperan clientes perdidos.', features: ['Newsletters profesionales','Welcome · carrito · reactivación','Segmentación avanzada','Lead magnets + funnels','A/B testing','Integración CRM'], figure: 'ROI 5×', figureLabel: 'Email vs Ads', color: 'orange', icon: 'mail' },
];

const funnel = [
  { stage: 'Tráfico',     value: '10.000', sub: 'visitas/mes',  metric: '100%',  hint: 'Search · Ads · Social' },
  { stage: 'Engagement',  value: '3.200',  sub: 'sesiones >30s', metric: '32%',  hint: 'Contenido + UX' },
  { stage: 'Leads',       value: '480',    sub: 'formularios',   metric: '4.8%', hint: 'CTA + landing' },
  { stage: 'Cualificados', value: '180',   sub: 'MQLs',          metric: '1.8%', hint: 'Lead scoring' },
  { stage: 'Clientes',    value: '54',     sub: 'cierres',       metric: '0.54%', hint: 'Sales follow-up' },
];

const process = [
  { num: '01', title: 'Auditoría gratuita',     eta: '1–2 días', body: 'Analizamos tu web, competencia, posicionamiento y oportunidades. Te decimos dónde estás perdiendo clientes.', deliverable: 'Diagnóstico escrito + recomendaciones', color: 'blue' },
  { num: '02', title: 'Estrategia personalizada', eta: '3–5 días', body: 'Plan de acción adaptado a tu negocio, presupuesto y objetivos. Sin plantillas: cada estrategia es única.', deliverable: 'Roadmap mensual + KPIs', color: 'magenta' },
  { num: '03', title: 'Ejecución y optimización', eta: 'Continuo', body: 'Lanzamos campañas, optimizamos tu SEO y gestionamos tus redes. Cada semana ajustamos para mejorar resultados.', deliverable: 'Dashboard tiempo real + iteración semanal', color: 'lime' },
  { num: '04', title: 'Informes y revisión',     eta: 'Mensual',  body: 'Dashboard en tiempo real con las métricas que importan. Reunión para revisar resultados y ajustar estrategia.', deliverable: 'Informe + sesión estratégica', color: 'orange' },
];

const channels = [
  { k: 'Google Ads',     v: 'Search · Display · Shopping · YouTube · Performance Max' },
  { k: 'Meta Ads',       v: 'Facebook · Instagram · Reels · Stories · Audience Network' },
  { k: 'LinkedIn Ads',   v: 'Sponsored Content · Message Ads · Conversation · B2B' },
  { k: 'SEO técnico',    v: 'Core Web Vitals · Schema · Sitemap · Search Console' },
  { k: 'SEO local',      v: 'Google Business · NAP · Reseñas · Citaciones · Maps' },
  { k: 'Email · CRM',    v: 'Mailchimp · Brevo · ActiveCampaign · HubSpot · Klaviyo' },
  { k: 'Analítica',      v: 'GA4 · GTM · Looker Studio · Matomo · Cookie banner' },
  { k: 'Redes',          v: 'Meta · TikTok · LinkedIn · YouTube · X · Pinterest' },
];

const sectors = [
  { title: 'Hostelería y turismo',  desc: 'Restaurantes, hoteles y casas rurales que quieren llenar mesas y habitaciones todo el año.' },
  { title: 'Inmobiliarias',          desc: 'Agencias que necesitan captar propietarios vendedores y compradores cualificados.' },
  { title: 'E-commerce',             desc: 'Tiendas que quieren escalar con publicidad rentable y SEO que convierte.' },
  { title: 'Servicios profesionales', desc: 'Abogados, clínicas, consultorías y profesionales que necesitan un flujo constante de clientes.' },
  { title: 'Construcción y reformas', desc: 'Empresas de obra y reformas que quieren presupuestos de calidad, no curiosos.' },
  { title: 'Agricultura y exportación', desc: 'Cooperativas y productores que quieren abrir mercados nacionales e internacionales.' },
];

const testimonials = [
  { text: 'Llevábamos dos años invirtiendo en Google Ads sin control. Desde que trabajan nuestra cuenta hemos triplicado los leads manteniendo el mismo presupuesto.', author: 'María L.',   role: 'Dirección comercial · Inmobiliaria · Almería' },
  { text: 'Nos gestionan redes sociales e email marketing. En 6 meses pasamos de 200 a 2.400 seguidores reales y las reservas online subieron un 45%.',               author: 'Antonio R.', role: 'Propietario · Restaurante · Mojácar' },
  { text: 'El SEO local fue clave. Ahora aparecemos los primeros en Google Maps y recibimos 3–4 llamadas diarias de clientes nuevos.',                                 author: 'Carmen D.',  role: 'Gerente · Clínica dental · Roquetas' },
  { text: 'Probamos con otra agencia y nada. Con Platanito Rico todo cambió: dashboard transparente, reuniones claras y resultados desde el segundo mes.',           author: 'Javier M.',  role: 'CEO · Empresa de reformas · Almería' },
];

const faq = [
  { q: '¿Cuánto tarda en verse resultados en marketing digital?', a: 'Depende del canal. SEM (anuncios): resultados desde la primera semana. SEO: primeros movimientos en 2–4 meses, resultados sólidos desde el sexto. Redes sociales: crecimiento progresivo acelerado con la estrategia correcta.' },
  { q: '¿Necesito un presupuesto mínimo para publicidad?', a: 'Recomendamos un mínimo de 300€/mes para campañas locales en Almería. E-commerce o mercados amplios: 500–1.000€/mes ideal. Optimizamos cada euro al máximo.' },
  { q: '¿Puedo ver qué hacéis con mi dinero en todo momento?', a: 'Sí. Dashboard en tiempo real con inversión, clics, leads y CPA por canal. Reuniones periódicas para revisar resultados juntos.' },
  { q: '¿Gestionáis las redes sociales de cualquier sector?', a: 'Sí, especialmente hostelería, inmobiliarias, e-commerce, servicios profesionales y construcción en la provincia. Conocemos el mercado local.' },
  { q: '¿Qué diferencia hay entre SEO y SEM?', a: 'SEO: posicionamiento orgánico (sin pagar por clic). Inversión a medio-largo plazo con resultados duraderos. SEM: publicidad de pago (instantánea). Ideal: combinarlos.' },
  { q: '¿Hay permanencia?', a: 'No. Sin permanencia. Nuestros clientes se quedan porque ven resultados, no porque estén atados.' },
  { q: '¿También hacéis la página web?', a: 'Sí. Diseño web optimizado para convertir + hosting gratuito de por vida para webs estáticas. Es la base ideal de cualquier estrategia.' },
  { q: '¿Cómo sé si mi marketing actual está funcionando?', a: 'Te hacemos una auditoría gratuita donde analizamos web, campañas, SEO y redes. Te decimos qué funciona, qué no, y dónde se está perdiendo dinero. Sin compromiso.' },
];

const jsonLdSchemas = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Marketing Digital","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Marketing Digital en Almería","description":"Agencia de marketing digital especializada en SEO, publicidad online, redes sociales y estrategia de contenidos para empresas en Almería.","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","address":{"@type":"PostalAddress","addressLocality":"Almería","addressRegion":"Andalucía","addressCountry":"ES"},"areaServed":{"@type":"State","name":"Almería"},"priceRange":"€€","hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios de Marketing Digital","itemListElement":services.map(s=>({"@type":"Offer","itemOffered":{"@type":"Service","name":s.title,"description":s.desc}}))} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo trabajamos tu marketing digital","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-marketing-web.jpg"
  imageAlt="Agencia de marketing digital en Almería - Platanito Rico"
  type="service"
  keywords="marketing digital almería, agencia seo almería, google ads almería, meta ads almería, gestión redes sociales, email marketing"
  jsonLd={jsonLdSchemas}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Marketing Digital' }]} />

  <main id="main-content" class="mk">
    {/* ═══════════════ HERO DASHBOARD ═══════════════ */}
    <section class="mk-hero">
      {/* Grid editorial de fondo */}
      <div class="mk-hero__grid-bg" aria-hidden="true"></div>

      {/* Gráfico de línea (growth) */}
      <svg class="mk-hero__chart" viewBox="0 0 800 300" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="mk-area" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1E40FF" stop-opacity="0.18"/>
            <stop offset="100%" stop-color="#1E40FF" stop-opacity="0"/>
          </linearGradient>
        </defs>
        {/* Area fill */}
        <path d="M0,260 L60,240 L120,250 L180,210 L240,220 L300,170 L360,180 L420,130 L480,140 L540,90 L600,100 L660,55 L720,65 L800,20 L800,300 L0,300 Z" fill="url(#mk-area)"/>
        {/* Line */}
        <path d="M0,260 L60,240 L120,250 L180,210 L240,220 L300,170 L360,180 L420,130 L480,140 L540,90 L600,100 L660,55 L720,65 L800,20" fill="none" stroke="#1E40FF" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>
        {/* Dots on points */}
        <g fill="#FFFCF6" stroke="#1E40FF" stroke-width="3">
          <circle cx="120" cy="250" r="6"/>
          <circle cx="300" cy="170" r="6"/>
          <circle cx="540" cy="90" r="6"/>
          <circle cx="720" cy="65" r="6"/>
          <circle cx="800" cy="20" r="7" fill="#D6FF44" stroke="#0E0D0B"/>
        </g>
      </svg>

      <div class="container-brutal mk-hero__inner">
        <header class="mk-hero__head">
          <span class="mk-tag mk-tag--ink">N.º 012 — Marketing Digital</span>
          <span class="mk-tag mk-tag--lime">
            <span class="live-dot" style="background:#0E0D0B"></span>
            Auditoría gratis · 48h
          </span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="mk-hero__grid">
          <div>
            <span class="mk-eyebrow">★ Estrategia + Ads + SEO + CRM</span>
            <h1 class="mk-title">
              Deja de invertir
              <em>a ciegas.</em>
              <span class="mk-title__stroke">Mide.</span>
              <span class="mk-title__accent">Optimiza.</span>
              Vende.
            </h1>
            <p class="mk-hero__lead">
              <strong>SEO, Google Ads, Meta Ads, redes y email</strong> con
              resultados medibles. Dashboard en tiempo real, sin permanencia,
              sin presentaciones de 80 slides.
            </p>
            <div class="mk-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">Auditoría gratuita →</a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>
          </div>

          {/* Mini Dashboard */}
          <aside class="mk-dashboard">
            <header class="mk-dashboard__head">
              <span class="mk-dashboard__title">★ Dashboard preview</span>
              <span class="mk-dashboard__live">
                <span class="mk-dashboard__pulse"></span>
                LIVE · GA4 + Ads
              </span>
            </header>
            <ul class="mk-dashboard__kpis">
              <li class="mk-kpi mk-kpi--blue">
                <span class="mk-kpi__lbl">Tráfico</span>
                <span class="mk-kpi__num">+218%</span>
                <svg class="mk-kpi__spark" viewBox="0 0 80 24" aria-hidden="true">
                  <polyline points="0,20 10,18 20,14 30,16 40,10 50,12 60,6 70,8 80,2" fill="none" stroke="#1E40FF" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
              </li>
              <li class="mk-kpi mk-kpi--magenta">
                <span class="mk-kpi__lbl">Leads</span>
                <span class="mk-kpi__num">3×</span>
                <svg class="mk-kpi__spark" viewBox="0 0 80 24" aria-hidden="true">
                  <rect x="2" y="14" width="6" height="8" fill="#FF2D9A"/>
                  <rect x="12" y="11" width="6" height="11" fill="#FF2D9A"/>
                  <rect x="22" y="13" width="6" height="9" fill="#FF2D9A"/>
                  <rect x="32" y="8" width="6" height="14" fill="#FF2D9A"/>
                  <rect x="42" y="9" width="6" height="13" fill="#FF2D9A"/>
                  <rect x="52" y="5" width="6" height="17" fill="#FF2D9A"/>
                  <rect x="62" y="6" width="6" height="16" fill="#FF2D9A"/>
                  <rect x="72" y="2" width="6" height="20" fill="#FF2D9A"/>
                </svg>
              </li>
              <li class="mk-kpi mk-kpi--lime">
                <span class="mk-kpi__lbl">ROAS</span>
                <span class="mk-kpi__num">4.8</span>
                <svg class="mk-kpi__spark" viewBox="0 0 80 24" aria-hidden="true">
                  <polyline points="0,22 12,18 24,20 36,12 48,14 60,8 72,4 80,2" fill="none" stroke="#0E0D0B" stroke-width="2.5" stroke-linejoin="round"/>
                  <circle cx="80" cy="2" r="3" fill="#0E0D0B"/>
                </svg>
              </li>
              <li class="mk-kpi mk-kpi--orange">
                <span class="mk-kpi__lbl">CAC</span>
                <span class="mk-kpi__num">−42%</span>
                <svg class="mk-kpi__spark" viewBox="0 0 80 24" aria-hidden="true">
                  <polyline points="0,4 10,6 20,4 30,10 40,8 50,14 60,12 70,18 80,16" fill="none" stroke="#FFFCF6" stroke-width="2.5" stroke-linejoin="round"/>
                </svg>
              </li>
            </ul>
            <footer class="mk-dashboard__foot">
              <span>★ Resultados medios · 90 días</span>
              <span>q3 / 2026</span>
            </footer>
          </aside>
        </div>
      </div>

      {/* Marquee inferior con métricas */}
      <div class="mk-hero__marquee" aria-hidden="true">
        <div class="mk-hero__marquee-track">
          {Array.from({length: 4}).map(() => (
            <>
              <span>CTR ↑</span><span>★</span>
              <span>CPC ↓</span><span>★</span>
              <span>ROAS 4.8</span><span>★</span>
              <span>LEADS +218%</span><span>★</span>
              <span>CAC −42%</span><span>★</span>
              <span>SEO TOP 3</span><span>★</span>
              <span>EMAIL OPEN 38%</span><span>★</span>
            </>
          ))}
        </div>
      </div>
    </section>

    {/* ═══════════════ EMBUDO DE CONVERSIÓN ═══════════════ */}
    <section class="mk-funnel-wrap">
      <div class="container-brutal">
        <header class="mk-section-head">
          <span class="mk-eyebrow mk-eyebrow--lime">Cap. 01 / Funnel</span>
          <h2 class="mk-h2">
            Cada visita
            <em>es una decisión</em>
            por tomar.
          </h2>
          <p class="mk-lead">
            Trabajamos el embudo completo — desde el primer clic hasta el
            cierre. Cada etapa tiene su métrica, su canal y su KPI.
          </p>
        </header>

        <div class="mk-funnel">
          {/* Visual del embudo SVG */}
          <div class="mk-funnel__visual" aria-hidden="true">
            <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid meet">
              <defs>
                <pattern id="mk-funnel-dots" width="14" height="14" patternUnits="userSpaceOnUse">
                  <circle cx="7" cy="7" r="1.8" fill="#FFFCF6" opacity=".25"/>
                </pattern>
              </defs>
              {/* Stage 1 - Tráfico */}
              <path d="M0,40 L400,40 L370,130 L30,130 Z" fill="#1E40FF" stroke="#0E0D0B" stroke-width="3"/>
              <rect x="0" y="40" width="400" height="90" fill="url(#mk-funnel-dots)"/>
              <text x="200" y="80" text-anchor="middle" fill="#FFFCF6" font-family="JetBrains Mono" font-weight="700" font-size="13" letter-spacing="2">TRÁFICO</text>
              <text x="200" y="108" text-anchor="middle" fill="#D6FF44" font-family="Bricolage Grotesque" font-weight="800" font-size="24">10.000</text>

              {/* Stage 2 - Engagement */}
              <path d="M30,135 L370,135 L340,225 L60,225 Z" fill="#06B6D4" stroke="#0E0D0B" stroke-width="3"/>
              <text x="200" y="175" text-anchor="middle" fill="#0E0D0B" font-family="JetBrains Mono" font-weight="700" font-size="13" letter-spacing="2">ENGAGEMENT</text>
              <text x="200" y="203" text-anchor="middle" fill="#0E0D0B" font-family="Bricolage Grotesque" font-weight="800" font-size="22">3.200</text>

              {/* Stage 3 - Leads */}
              <path d="M60,230 L340,230 L310,320 L90,320 Z" fill="#FF2D9A" stroke="#0E0D0B" stroke-width="3"/>
              <text x="200" y="270" text-anchor="middle" fill="#FFFCF6" font-family="JetBrains Mono" font-weight="700" font-size="13" letter-spacing="2">LEADS</text>
              <text x="200" y="298" text-anchor="middle" fill="#D6FF44" font-family="Bricolage Grotesque" font-weight="800" font-size="22">480</text>

              {/* Stage 4 - MQLs */}
              <path d="M90,325 L310,325 L280,415 L120,415 Z" fill="#D6FF44" stroke="#0E0D0B" stroke-width="3"/>
              <text x="200" y="365" text-anchor="middle" fill="#0E0D0B" font-family="JetBrains Mono" font-weight="700" font-size="13" letter-spacing="2">CUALIFICADOS</text>
              <text x="200" y="393" text-anchor="middle" fill="#0E0D0B" font-family="Bricolage Grotesque" font-weight="800" font-size="22">180</text>

              {/* Stage 5 - Customers */}
              <path d="M120,420 L280,420 L250,490 L150,490 Z" fill="#FF5A00" stroke="#0E0D0B" stroke-width="3"/>
              <text x="200" y="455" text-anchor="middle" fill="#FFFCF6" font-family="JetBrains Mono" font-weight="700" font-size="13" letter-spacing="2">CLIENTES</text>
              <text x="200" y="478" text-anchor="middle" fill="#FFFCF6" font-family="Bricolage Grotesque" font-weight="800" font-size="20">54</text>

              {/* Drop indicators */}
              <g font-family="JetBrains Mono" font-size="9" font-weight="700" fill="#0E0D0B">
                <text x="378" y="135" text-anchor="end">↓ 68%</text>
                <text x="348" y="227" text-anchor="end">↓ 85%</text>
                <text x="318" y="322" text-anchor="end">↓ 63%</text>
                <text x="288" y="417" text-anchor="end">↓ 70%</text>
              </g>
            </svg>
          </div>

          {/* Tabla de métricas */}
          <ol class="mk-funnel__stages">
            {funnel.map((s, i) => {
              const colors = ['blue', 'cyan', 'magenta', 'lime', 'orange'];
              return (
                <li class={`mk-stage mk-stage--${colors[i]}`}>
                  <span class="mk-stage__num text-mono">N.º {String(i+1).padStart(2,'0')}</span>
                  <h3 class="mk-stage__name">{s.stage}</h3>
                  <div class="mk-stage__metric">
                    <span class="mk-stage__val">{s.value}</span>
                    <span class="mk-stage__sub">{s.sub}</span>
                  </div>
                  <div class="mk-stage__bar">
                    <div class="mk-stage__bar-fill" style={`width:${s.metric}`}></div>
                    <span class="mk-stage__bar-pct">{s.metric}</span>
                  </div>
                  <span class="mk-stage__hint">{s.hint}</span>
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </section>

    {/* ═══════════════ CANALES (bento con sparklines) ═══════════════ */}
    <section class="mk-section">
      <div class="container-brutal">
        <header class="mk-section-head">
          <span class="mk-eyebrow">Cap. 02 / Canales</span>
          <h2 class="mk-h2">
            Cuatro palancas
            <em>para crecer.</em>
          </h2>
          <p class="mk-lead">
            Ads, SEO, redes y email. Trabajamos cada canal como un equipo
            integrado — no como silos sueltos que se ignoran entre sí.
          </p>
        </header>

        <ol class="mk-channels">
          {services.map((s) => (
            <li class={`mk-channel mk-channel--${s.color}`}>
              <header class="mk-channel__head">
                <div>
                  <span class="mk-channel__num">{s.n}</span>
                  <span class="mk-channel__kicker">{s.kicker}</span>
                </div>
                <span class="mk-channel__icon" aria-hidden="true">
                  {s.icon === 'cursor' && (
                    <svg viewBox="0 0 32 32"><path d="M6 4 L24 14 L17 16 L20 26 L16 26 L13 17 L6 22 Z" fill="currentColor" stroke="#0E0D0B" stroke-width="2.5" stroke-linejoin="round"/></svg>
                  )}
                  {s.icon === 'search' && (
                    <svg viewBox="0 0 32 32"><circle cx="13" cy="13" r="8" fill="none" stroke="currentColor" stroke-width="3"/><line x1="19" y1="19" x2="27" y2="27" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M9 13 L12 15 L17 11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                  )}
                  {s.icon === 'heart' && (
                    <svg viewBox="0 0 32 32"><path d="M16 28 C8 22 4 17 4 12 C4 8 7 5 11 5 C13 5 15 6 16 8 C17 6 19 5 21 5 C25 5 28 8 28 12 C28 17 24 22 16 28 Z" fill="currentColor" stroke="#0E0D0B" stroke-width="2.5"/></svg>
                  )}
                  {s.icon === 'mail' && (
