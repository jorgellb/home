---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Agencia Marketing Digital en Almería | SEO, Ads y Redes Sociales';
const description = 'Marketing digital en Almería con resultados medibles. SEO, Google Ads, Meta Ads y redes sociales. Deja de invertir a ciegas. Presupuesto gratis.';
const canonical = 'https://platanitorico.com/marketing/';

// ── Servicios de marketing (SIN PRECIOS) ──
const services = [
  {
    title: 'SEM & Publicidad Online',
    desc: 'Campañas de Google Ads y Meta Ads optimizadas para captar clientes ahora mismo. Controlamos cada euro para que convierta.',
    icon: 'megaphone',
    features: ['Google Ads (Search, Display, Shopping)', 'Meta Ads (Facebook e Instagram)', 'LinkedIn Ads para B2B', 'Configuración de píxeles y conversiones', 'Optimización continua de campañas', 'Remarketing y audiencias personalizadas'],
    result: 'Clientes nuevos desde el primer día con retorno medible'
  },
  {
    title: 'SEO & Posicionamiento Web',
    desc: 'Aparece en Google cuando tus clientes buscan lo que vendes. Estrategia orgánica que genera tráfico constante sin pagar por cada clic.',
    icon: 'search',
    features: ['Auditoría SEO técnica completa', 'Keyword research estratégico', 'Optimización on-page y contenidos', 'Link building ético y sostenible', 'SEO local y Google Business Profile', 'Informes de posicionamiento mensuales'],
    result: 'Tráfico orgánico que crece mes a mes sin depender de anuncios'
  },
  {
    title: 'Redes Sociales',
    desc: 'Construimos una comunidad real alrededor de tu marca. Contenido que conecta, engancha y convierte seguidores en clientes.',
    icon: 'share',
    features: ['Estrategia de contenidos personalizada', 'Gestión de Instagram, Facebook, LinkedIn y TikTok', 'Diseño de creatividades y reels', 'Calendario editorial mensual', 'Moderación de comentarios y DMs', 'Análisis de métricas y crecimiento'],
    result: 'Presencia profesional que genera confianza y ventas'
  },
  {
    title: 'Email Marketing & Automatización',
    desc: 'Convierte tu base de datos en una máquina de ventas automática. Secuencias que nutren, fidelizan y recuperan clientes perdidos.',
    icon: 'mail',
    features: ['Diseño de newsletters profesionales', 'Automatizaciones de email (welcome, carrito, reactivación)', 'Segmentación avanzada de audiencias', 'Lead magnets y funnels de captación', 'A/B testing de asuntos y contenido', 'Integración con CRM'],
    result: 'Ventas recurrentes sin invertir en publicidad adicional'
  }
];

// ── Proceso de trabajo ──
const process = [
  {
    step: '01',
    title: 'Auditoría gratuita',
    desc: 'Analizamos tu web, competencia, posicionamiento actual y oportunidades de mercado. Te decimos exactamente dónde estás perdiendo clientes.',
    duration: '1-2 días'
  },
  {
    step: '02',
    title: 'Estrategia personalizada',
    desc: 'Diseñamos un plan de acción adaptado a tu negocio, presupuesto y objetivos. Sin plantillas genéricas: cada estrategia es única.',
    duration: '3-5 días'
  },
  {
    step: '03',
    title: 'Ejecución y optimización',
    desc: 'Lanzamos campañas, optimizamos tu SEO y gestionamos tus redes. Cada semana ajustamos para mejorar resultados.',
    duration: 'Continuo'
  },
  {
    step: '04',
    title: 'Informes y resultados',
    desc: 'Dashboard en tiempo real con las métricas que importan. Reuniones periódicas para revisar resultados y ajustar la estrategia.',
    duration: 'Mensual'
  }
];

// ── Sectores con los que trabajamos ──
const sectors = [
  { title: 'Hostelería y turismo', desc: 'Restaurantes, hoteles y casas rurales que quieren llenar mesas y habitaciones todo el año.', icon: 'hotel' },
  { title: 'Inmobiliarias', desc: 'Agencias que necesitan captar propietarios vendedores y compradores cualificados.', icon: 'building' },
  { title: 'E-commerce', desc: 'Tiendas online que quieren escalar ventas con publicidad rentable y SEO que convierte.', icon: 'cart' },
  { title: 'Servicios profesionales', desc: 'Abogados, clínicas, consultorías y profesionales que necesitan un flujo constante de clientes.', icon: 'briefcase' },
  { title: 'Construcción y reformas', desc: 'Empresas de obra y reformas que quieren presupuestos de calidad, no curiosos.', icon: 'hammer' },
  { title: 'Agricultura y exportación', desc: 'Cooperativas y productores que quieren abrir mercados nacionales e internacionales.', icon: 'leaf' }
];

// ── Testimonios ──
const testimonials = [
  {
    text: 'Llevábamos dos años invirtiendo en Google Ads sin control. Desde que trabajan nuestra cuenta, hemos triplicado los leads manteniendo el mismo presupuesto.',
    author: 'María L.',
    role: 'Directora comercial, inmobiliaria en Almería',
    rating: 5
  },
  {
    text: 'Nos gestionan redes sociales e email marketing. En 6 meses hemos pasado de 200 a 2.400 seguidores reales y las reservas online han subido un 45%.',
    author: 'Antonio R.',
    role: 'Propietario, restaurante en Mojácar',
    rating: 5
  },
  {
    text: 'El SEO local que nos hicieron fue clave. Ahora aparecemos los primeros en Google Maps y recibimos 3-4 llamadas diarias de clientes nuevos.',
    author: 'Carmen D.',
    role: 'Gerente, clínica dental en Roquetas de Mar',
    rating: 5
  },
  {
    text: 'Probamos con otra agencia y no vimos resultados. Con Platanito Rico todo cambió: dashboard transparente, reuniones claras y resultados desde el segundo mes.',
    author: 'Javier M.',
    role: 'CEO, empresa de reformas en Almería',
    rating: 5
  }
];

// ── FAQ ──
const faq = [
  {
    q: '¿Cuánto tarda en verse resultados en marketing digital?',
    a: 'Depende del canal. En campañas de publicidad (SEM) los resultados son inmediatos, desde la primera semana. En SEO, los primeros resultados llegan entre 2-4 meses, con resultados sólidos a partir del sexto mes. En redes sociales, el crecimiento orgánico es progresivo pero acelerado con la estrategia correcta.'
  },
  {
    q: '¿Necesito un presupuesto mínimo para publicidad?',
    a: 'Recomendamos un mínimo de 300€/mes de inversión publicitaria para campañas locales en Almería. Para e-commerce o mercados más amplios, lo ideal es partir de 500-1.000€/mes. Nosotros optimizamos cada euro para que rinda al máximo.'
  },
  {
    q: '¿Puedo ver qué hacéis con mi dinero en todo momento?',
    a: 'Absolutamente. Tienes acceso a un dashboard en tiempo real donde ves exactamente cuánto se invierte, cuántos clics recibes, cuántos leads generas y cuánto cuesta cada conversión. Además, hacemos reuniones periódicas para revisar resultados juntos.'
  },
  {
    q: '¿Gestionáis las redes sociales de cualquier sector?',
    a: 'Sí, aunque estamos especializados en hostelería, inmobiliarias, e-commerce, servicios profesionales y construcción en la provincia de Almería. Conocemos el mercado local y sabemos qué funciona para cada tipo de negocio.'
  },
  {
    q: '¿Qué diferencia hay entre SEO y SEM?',
    a: 'SEO es posicionamiento orgánico: aparecer en Google sin pagar por clic. Es una inversión a medio-largo plazo con resultados duraderos. SEM es publicidad de pago: apareces al instante pero pagas por cada clic. Lo ideal es combinar ambos para tener resultados inmediatos mientras construyes autoridad orgánica.'
  },
  {
    q: '¿Hay permanencia en vuestros servicios?',
    a: 'No. Trabajamos sin permanencia porque confiamos en nuestros resultados. Si en algún momento quieres cancelar, puedes hacerlo cuando quieras. Nuestros clientes se quedan porque ven resultados, no porque estén atados.'
  },
  {
    q: '¿También hacéis la página web?',
    a: 'Sí. Somos agencia de diseño web y marketing digital. Si necesitas una web optimizada para convertir visitas en clientes, la diseñamos con tecnología estática de última generación, hosting gratuito de por vida y velocidad de carga perfecta. Es la base ideal para cualquier estrategia de marketing.'
  },
  {
    q: '¿Cómo sé si mi marketing actual está funcionando?',
    a: 'Te hacemos una auditoría gratuita donde analizamos tu web, tus campañas, tu SEO y tu presencia en redes. Te decimos exactamente qué está funcionando, qué no, y dónde estás perdiendo dinero. Sin compromiso.'
  }
];

// ── JSON-LD Schemas ──
const jsonLdSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonical,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "Platanito Rico", "url": "https://platanitorico.com" },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
        { "@type": "ListItem", "position": 2, "name": "Marketing Digital", "item": canonical }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Platanito Rico — Marketing Digital en Almería",
    "description": "Agencia de marketing digital especializada en SEO, publicidad online, redes sociales y estrategia de contenidos para empresas en Almería.",
    "url": canonical,
    "telephone": "+34657085019",
    "email": "hola@platanitorico.com",
    "address": { "@type": "PostalAddress", "addressLocality": "Almería", "addressRegion": "Andalucía", "addressCountry": "ES" },
    "geo": { "@type": "GeoCoordinates", "latitude": 36.834, "longitude": -2.4637 },
    "areaServed": { "@type": "State", "name": "Almería" },
    "priceRange": "€€",
    "openingHoursSpecification": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "19:00" },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios de Marketing Digital",
      "itemListElement": services.map(s => ({
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": s.title, "description": s.desc }
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo funciona nuestro servicio de marketing digital",
    "description": "Proceso de trabajo de marketing digital: desde la auditoría inicial hasta los resultados medibles.",
    "step": process.map((p, i) => ({
      "@type": "HowToStep",
      "position": i + 1,
      "name": p.title,
      "text": p.desc
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-marketing-web.jpg"
  imageAlt="Agencia de marketing digital en Almería - Platanito Rico"
  type="service"
  keywords="marketing digital almería, seo almería, google ads almería, meta ads, redes sociales almería, agencia marketing, publicidad online"
  jsonLd={jsonLdSchemas}
>
  <Header />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Marketing Digital' }
  ]} />

  <main class="pt-0">

    <!-- ════════════════════════════════════════════ -->
    <!-- HERO -->
    <!-- ════════════════════════════════════════════ -->
    <section class="section-brutal relative min-h-screen flex items-center justify-center overflow-hidden bg-brutal-bg" id="hero">
      <div class="absolute inset-0 z-0">
        <img
          src="/imagenes/equipo-marketing-web.jpg"
          alt="Equipo de marketing digital Platanito Rico trabajando en estrategia"
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
        />
      </div>
      <div class="absolute inset-0 z-[1] bg-brutal-bg/85"></div>

      <div class="container-brutal relative z-10 py-24">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Badge -->
          <div class="badge-brutal mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full bg-brutal-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 bg-brutal-accent"></span>
            </span>
            <span class="text-sm font-medium text-brutal-text">Marketing orientado a resultados</span>
          </div>

          <h1 class="heading-display text-4xl md:text-5xl lg:text-7xl text-brutal-text mb-8 leading-[1.1]">
            Inviertes en marketing
            <span class="block mt-2 text-brutal-accent">y no ves resultados?</span>
          </h1>

          <p class="text-lg md:text-xl text-brutal-text-secondary max-w-3xl mx-auto mb-6 leading-relaxed">
            Sabemos lo que se siente. Pagas agencias, pruebas campañas, publicas en redes... y el teléfono sigue sin sonar.
            <strong class="text-brutal-text">Nosotros cambiamos eso.</strong>
          </p>
          <p class="text-base md:text-lg text-brutal-text-muted max-w-2xl mx-auto mb-12">
            Estrategias de SEO, publicidad y redes sociales diseñadas para una cosa: <strong class="text-brutal-accent">que vendas más</strong>.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="/#contacto" class="btn-brutal group inline-flex items-center gap-2 px-8 py-4 bg-brutal-accent text-brutal-text font-semibold">
              <span class="relative">Pedir auditoría gratuita</span>
              <svg class="relative w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="tel:+34657085019" class="btn-brutal-outline inline-flex items-center gap-2 px-8 py-4 bg-brutal-bg text-brutal-text font-semibold border border-brutal-text/30 hover:bg-brutal-text/10 transition-all">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              657 085 019
            </a>
          </div>

          <!-- Stats -->
          <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">x3.5</div>
              <div class="text-xs text-brutal-text-muted">ROI medio en Ads</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">+40%</div>
              <div class="text-xs text-brutal-text-muted">Mejora en conversión</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">Top 3</div>
              <div class="text-xs text-brutal-text-muted">Google para clientes</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">0</div>
              <div class="text-xs text-brutal-text-muted">Permanencia</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════ -->
    <!-- EL PROBLEMA — Empatía con el cliente frustrado -->
    <!-- ════════════════════════════════════════════ -->
    <section class="section-brutal py-24 bg-brutal-bg-alt">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
            Te suena esto?
          </div>
          <h2 class="heading-display text-3xl md:text-4xl lg:text-5xl text-brutal-text mb-6 leading-tight">
            Si tu marketing no vende,<br/>
            <span class="text-brutal-accent">el problema no eres tú</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          {[
            { problem: 'Pagas una agencia que solo te manda informes bonitos pero no ves más ventas', icon: 'chart-down' },
            { problem: 'Publicas en redes todos los días y solo dan like tus amigos y familiares', icon: 'thumbs-down' },
            { problem: 'Hiciste campañas en Google y solo conseguiste clics de curiosos que no compran', icon: 'cursor' },
            { problem: 'Tu competencia aparece en Google antes que tú y no sabes por qué', icon: 'trending-down' },
            { problem: 'Tienes una web bonita pero no genera ni un contacto al mes', icon: 'ghost' },
            { problem: 'No sabes si lo que inviertes está funcionando o es dinero tirado', icon: 'question' }
          ].map((item) => (
            <div class="card-brutal bg-brutal-card border-brutal-accent/30 p-6">
              <div class="w-10 h-10 bg-brutal-accent/20 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-brutal-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </div>
              <p class="text-brutal-text-secondary leading-relaxed">{item.problem}</p>
            </div>
          ))}
        </div>

        <!-- Transición empática -->
        <div class="max-w-3xl mx-auto text-center p-10 bg-brutal-card border border-brutal-accent/30">
          <p class="text-xl md:text-2xl text-brutal-text leading-relaxed mb-4">
            El marketing digital <strong class="text-brutal-accent">sí funciona</strong>. Pero necesitas a alguien que sepa lo que hace, que mida cada acción y que tenga un solo objetivo:
          </p>
          <p class="text-2xl md:text-3xl font-bold text-brutal-accent" style="font-family:'Anton',sans-serif">
            Que suene tu teléfono.
          </p>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════ -->
    <!-- SERVICIOS -- Sin precios, orientados a resultado -->
    <!-- ════════════════════════════════════════════ -->
    <section id="servicios" class="section-brutal py-24 bg-brutal-bg">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Qué hacemos por ti
          </div>
          <h2 class="heading-display text-3xl md:text-4xl lg:text-5xl text-brutal-text mb-6 leading-tight">
            Servicios que generan<br/>
            <span class="text-brutal-accent">ventas reales</span>
          </h2>
          <p class="text-lg text-brutal-text-secondary max-w-2xl mx-auto">
            Cada servicio está diseñado para un objetivo claro: que tu inversión se traduzca en clientes y facturación.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {services.map((service) => (
            <div class="card-brutal bg-brutal-card border-brutal-border p-8">
              <!-- Icon -->
              <div class="w-14 h-14 bg-brutal-accent flex items-center justify-center mb-6">
                {service.icon === 'megaphone' && (
                  <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46" />
                  </svg>
                )}
                {service.icon === 'search' && (
                  <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                  </svg>
                )}
                {service.icon === 'share' && (
                  <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
                  </svg>
                )}
                {service.icon === 'mail' && (
                  <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
