const services = [
  { n: '01', title: 'SEM · Ads de pago',      kicker: 'Google · Meta · LinkedIn',    desc: 'Campañas optimizadas para captar clientes ahora mismo. Controlamos cada euro para que convierta.', features: ['Google Ads (Search · Display · Shopping)','Meta Ads (Facebook · Instagram)','LinkedIn Ads B2B','Píxeles + conversiones','Optimización continua','Remarketing + audiencias'], figure: 'D1', figureLabel: 'Primer lead', color: 'blue', icon: 'cursor' },
