  }
  @media (min-width: 1024px) { .mk-funnel { grid-template-columns: 380px 1fr; gap: 4rem; } }

  .mk-funnel__visual {
    background: var(--c-paper);
    border: 3px solid var(--c-ink);
    padding: 1.5rem;
    box-shadow: 10px 10px 0 var(--c-magenta);
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mk-funnel__visual svg { width: 100%; height: 100%; }

  .mk-funnel__stages {
    list-style: none; padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .mk-stage {
    padding: 1.25rem 1.5rem;
    background: var(--c-paper);
    border: 3px solid var(--c-ink);
    box-shadow: 5px 5px 0 var(--c-s, var(--c-blue));
    display: grid;
    grid-template-columns: 1fr;
    gap: .5rem;
    transition: transform .2s, box-shadow .2s;
  }
  .mk-stage:hover { transform: translate(-3px,-3px); box-shadow: 8px 8px 0 var(--c-s, var(--c-blue)); }
  .mk-stage--blue    { --c-s: var(--c-blue); }
  .mk-stage--cyan    { --c-s: var(--c-cyan); }
  .mk-stage--magenta { --c-s: var(--c-magenta); }
  .mk-stage--lime    { --c-s: var(--c-lime); }
  .mk-stage--orange  { --c-s: var(--c-orange); }

  .mk-stage__num { font-size: .65rem; color: var(--brutal-text-muted); letter-spacing: .15em; }
  .mk-stage__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -.025em;
    color: var(--c-ink);
    margin: 0;
  }
  .mk-stage__metric { display: flex; align-items: baseline; gap: .5rem; margin: .25rem 0 .5rem; }
  .mk-stage__val { font-family: var(--font-display); font-weight: 800; font-size: 2.25rem; line-height: 1; color: var(--c-s, var(--c-blue)); letter-spacing: -.03em; }
  .mk-stage__sub { font-family: var(--font-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; color: var(--brutal-text-muted); }
  .mk-stage__bar {
    position: relative;
    height: 14px;
    background: var(--c-bg);
    border: 2px solid var(--c-ink);
    display: flex;
    align-items: center;
  }
  .mk-stage__bar-fill {
    height: 100%;
    background: var(--c-s, var(--c-blue));
    transition: width .8s;
  }
  .mk-stage__bar-pct {
    position: absolute;
    right: .35rem;
    font-family: var(--font-mono);
    font-size: .58rem;
    font-weight: 800;
    color: var(--c-ink);
    text-transform: uppercase;
  }
  .mk-stage__hint { font-family: var(--font-mono); font-size: .65rem; color: var(--brutal-text-muted); text-transform: uppercase; letter-spacing: .12em; }

  /* ═══════════════ CANALES (bento sparklines) ═══════════════ */
  .mk-channels {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 3px solid var(--c-ink);
    background: var(--c-ink);
  }
  @media (min-width: 768px) { .mk-channels { grid-template-columns: 1fr 1fr; gap: 3px; } }

  .mk-channel {
    background: var(--c-paper);
    padding: 2rem;
    display: flex; flex-direction: column;
    position: relative;
    transition: background .25s;
  }
  .mk-channel--blue:hover { background: var(--c-blue-soft); }
  .mk-channel--lime:hover { background: #F4FFD6; }
  .mk-channel--magenta:hover { background: #FFE3F1; }
  .mk-channel--orange:hover { background: #FFE9DA; }

  .mk-channel__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--c-ink);
  }
  .mk-channel__num {
    font-family: var(--font-mono);
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--c-c, var(--c-blue));
    line-height: 1;
    display: block;
  }
  .mk-channel--blue    { --c-c: var(--c-blue); }
  .mk-channel--lime    { --c-c: var(--c-lime); }
  .mk-channel--magenta { --c-c: var(--c-magenta); }
  .mk-channel--orange  { --c-c: var(--c-orange); }
  .mk-channel__kicker { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); display: block; margin-top: .35rem; }
  .mk-channel__icon {
    width: 54px; height: 54px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--c-c, var(--c-blue));
    color: var(--c-paper);
    border: 2.5px solid var(--c-ink);
    box-shadow: 4px 4px 0 var(--c-ink);
  }
  .mk-channel--lime .mk-channel__icon { color: var(--c-ink); }
  .mk-channel__icon svg { width: 30px; height: 30px; }

  .mk-channel__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    line-height: .95;
    letter-spacing: -.03em;
    margin: 1.5rem 0 .65rem;
    color: var(--c-ink);
  }
  .mk-channel__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0 0 1.25rem; max-width: 38ch; }
  .mk-channel__features { list-style: none; padding: 0; margin: 0 0 1.25rem; display: flex; flex-direction: column; gap: .45rem; }
  .mk-channel__features li { font-family: var(--font-mono); font-size: .78rem; display: flex; gap: .55rem; color: var(--c-ink); }
  .mk-channel__features li span { color: var(--c-c, var(--c-blue)); font-weight: 800; }

  .mk-channel__chart {
    margin: 0 0 1.25rem;
    padding: .75rem;
    background: var(--c-bg);
    border: 2px solid var(--c-ink);
    color: var(--c-c, var(--c-blue));
  }
  .mk-channel__chart svg { width: 100%; height: 40px; display: block; }

  .mk-channel__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 1.25rem;
    border-top: 2px solid var(--c-ink);
    margin-top: auto;
  }
  .mk-channel__figure { display: flex; flex-direction: column; line-height: 1; }
  .mk-channel__fig-val { font-family: var(--font-mono); font-size: 1.7rem; font-weight: 800; color: var(--c-ink); }
  .mk-channel__fig-lbl { font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; letter-spacing: .15em; color: var(--brutal-text-muted); margin-top: .35rem; }
  .mk-channel__cta {
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--c-c, var(--c-blue));
    padding-bottom: .15em;
    transition: letter-spacing .2s;
  }
  .mk-channel:hover .mk-channel__cta { letter-spacing: .18em; }

  /* ═══════════════ A/B TESTING ═══════════════ */
  .mk-ab-wrap {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: var(--c-paper);
    border-block: 3px solid var(--c-ink);
  }
  .mk-ab {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    align-items: stretch;
    margin: 2rem 0 1.5rem;
  }
  @media (min-width: 900px) { .mk-ab { grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; } }

  .mk-ab__variant {
    background: var(--c-bg);
    border: 3px solid var(--c-ink);
    padding: 1.5rem;
    box-shadow: 6px 6px 0 var(--c-ink);
    position: relative;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .mk-ab__variant--a { background: #F0F0F0; }
  .mk-ab__variant--b { background: var(--c-blue); color: var(--c-paper); box-shadow: 6px 6px 0 var(--c-lime); }

  .mk-ab__variant header { display: flex; justify-content: space-between; align-items: center; padding-bottom: .75rem; border-bottom: 2px solid currentColor; }
  .mk-ab__label { font-family: var(--font-mono); font-size: .6rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .mk-ab__variant--a .mk-ab__label { color: var(--c-ink); }
  .mk-ab__share {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: .85rem;
    padding: .15rem .5rem;
    background: var(--c-ink);
    color: var(--c-paper);
    letter-spacing: .05em;
  }
  .mk-ab__variant--b .mk-ab__share { background: var(--c-lime); color: var(--c-ink); }

  .mk-ab__mock {
    background: var(--c-paper);
    border: 2px solid var(--c-ink);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    color: var(--c-ink);
  }
  .mk-ab__mock-img {
    height: 80px;
    border: 2px solid var(--c-ink);
    background-image: linear-gradient(45deg, transparent 48%, var(--c-ink) 48%, var(--c-ink) 52%, transparent 52%);
    background-size: 16px 16px;
    background-color: #DDD;
  }
  .mk-ab__mock-img--b {
    background-image:
      radial-gradient(circle at 25% 30%, var(--c-magenta) 0, var(--c-magenta) 10px, transparent 10px),
      radial-gradient(circle at 70% 60%, var(--c-lime) 0, var(--c-lime) 14px, transparent 14px),
      linear-gradient(45deg, transparent 48%, var(--c-ink) 48%, var(--c-ink) 52%, transparent 52%);
    background-size: cover, cover, 16px 16px;
    background-color: var(--c-blue-soft);
  }
  .mk-ab__mock-h { font-family: var(--font-display); font-weight: 700; font-size: 1rem; line-height: 1.1; }
  .mk-ab__mock-cta {
    padding: .55rem .85rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    border: 2px solid var(--c-ink);
    text-align: center;
  }
  .mk-ab__mock-cta--a { background: #BBB; color: var(--c-ink); }
  .mk-ab__mock-cta--b { background: var(--c-orange); color: var(--c-paper); box-shadow: 3px 3px 0 var(--c-ink); }

  .mk-ab__stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    margin: 0;
    border: 2px solid currentColor;
  }
  .mk-ab__stats > div { padding: .65rem .5rem; text-align: center; border-right: 2px solid currentColor; }
  .mk-ab__stats > div:last-child { border-right: 0; }
  .mk-ab__stats dt { font-family: var(--font-mono); font-size: .55rem; text-transform: uppercase; letter-spacing: .14em; opacity: .8; }
  .mk-ab__stats dd { font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; margin: .25rem 0 0; }

  .mk-ab__vs { display: flex; justify-content: center; align-items: center; }
  .mk-ab__crown {
    position: absolute;
    top: -.85rem;
    right: 1rem;
    background: var(--c-lime);
    color: var(--c-ink);
    border: 2px solid var(--c-ink);
    padding: .2rem .6rem;
    font-family: var(--font-mono);
    font-size: .65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .12em;
    transform: rotate(3deg);
    box-shadow: 3px 3px 0 var(--c-ink);
  }
  .mk-ab__note {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--c-yellow);
    border: 2px solid var(--c-ink);
    font-family: var(--font-mono);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--c-ink);
    text-align: center;
  }
  .mk-ab__note strong { font-weight: 800; }

  /* ═══════════════ STACK ═══════════════ */
  .mk-stack {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 3px solid var(--c-paper);
  }
  @media (min-width: 640px) { .mk-stack { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .mk-stack { grid-template-columns: repeat(4, 1fr); } }
  .mk-stack__item {
    padding: 1.5rem;
    border-right: 2px solid var(--c-paper);
    border-bottom: 2px solid var(--c-paper);
    background: var(--c-ink);
    color: var(--c-paper);
    transition: background .25s, color .25s;
  }
  .mk-stack__item:hover { background: var(--c-c, var(--c-blue)); }
  .mk-stack__item--blue    { --c-c: var(--c-blue); }
  .mk-stack__item--magenta { --c-c: var(--c-magenta); }
  .mk-stack__item--cyan    { --c-c: var(--c-cyan); }
  .mk-stack__item--lime    { --c-c: var(--c-lime); }
  .mk-stack__item--orange  { --c-c: var(--c-orange); }
  .mk-stack__item--lime:hover { color: var(--c-ink); }
  .mk-stack__index { font-family: var(--font-mono); font-size: .7rem; font-weight: 800; color: var(--c-c, var(--c-blue)); letter-spacing: .15em; }
  .mk-stack__k { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: -.02em; margin: .35rem 0 .5rem; color: inherit; }
  .mk-stack__v { font-family: var(--font-mono); font-size: .75rem; line-height: 1.5; color: rgba(255,252,246,.7); margin: 0; }
  .mk-stack__item:hover .mk-stack__v { color: rgba(14,13,11,.7); }
  .mk-stack__item--lime:hover .mk-stack__index { color: var(--c-ink); }

  /* ═══════════════ PROCESS ═══════════════ */
  .mk-process { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .mk-step {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    background: var(--c-paper);
    border: 3px solid var(--c-ink);
    padding: 1.75rem 2rem;
    box-shadow: 8px 8px 0 var(--c-step, var(--c-blue));
    transition: transform .25s, box-shadow .25s;
  }
  .mk-step:hover { transform: translate(-3px,-3px); box-shadow: 11px 11px 0 var(--c-step, var(--c-blue)); }
  @media (min-width: 768px) { .mk-step { grid-template-columns: 200px 1fr; gap: 2rem; align-items: start; } }
  .mk-step--blue    { --c-step: var(--c-blue); }
  .mk-step--magenta { --c-step: var(--c-magenta); }
  .mk-step--lime    { --c-step: var(--c-lime); }
  .mk-step--orange  { --c-step: var(--c-orange); }
  .mk-step__big {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5rem, 11vw, 9rem);
    line-height: .85;
    color: var(--c-step, var(--c-blue));
    letter-spacing: -.05em;
    -webkit-text-stroke: 3px var(--c-ink);
  }
  .mk-step__body { display: flex; flex-direction: column; gap: .5rem; }
  .mk-step__eta { font-size: .68rem; text-transform: uppercase; letter-spacing: .15em; color: var(--c-step, var(--c-blue)); font-weight: 800; }
  .mk-step__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -.025em; color: var(--c-ink); margin: 0; line-height: 1; }
  .mk-step__desc { font-size: 1rem; line-height: 1.55; color: var(--brutal-text-secondary); margin: 0; max-width: 54ch; }
  .mk-step__deliv {
    margin-top: .65rem;
    padding: .65rem .85rem;
    background: var(--c-step, var(--c-blue));
    color: var(--c-ink);
    font-family: var(--font-mono);
    font-size: .8rem;
    border: 2px solid var(--c-ink);
    display: inline-block;
    align-self: flex-start;
  }
  .mk-step--blue .mk-step__deliv { color: var(--c-paper); }
  .mk-step--magenta .mk-step__deliv { color: var(--c-paper); }
  .mk-step--orange .mk-step__deliv { color: var(--c-paper); }
  .mk-step__deliv span { font-weight: 800; }

  /* ═══════════════ SECTORS ═══════════════ */
  .mk-sectors {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 3px solid var(--c-ink);
    background: var(--c-ink);
  }
  @media (min-width: 640px) { .mk-sectors { grid-template-columns: 1fr 1fr; gap: 3px; } }
  @media (min-width: 1024px) { .mk-sectors { grid-template-columns: repeat(3, 1fr); } }
  .mk-sector {
    padding: 2rem 1.75rem;
    background: var(--c-paper);
    color: var(--c-ink);
    display: flex; flex-direction: column; gap: .5rem;
    transition: background .25s, color .25s, padding .25s;
  }
  .mk-sector:hover { padding-block: 2.25rem; }
  .mk-sector--blue:hover    { background: var(--c-blue); color: var(--c-paper); }
  .mk-sector--magenta:hover { background: var(--c-magenta); color: var(--c-paper); }
  .mk-sector--cyan:hover    { background: var(--c-cyan); color: var(--c-ink); }
  .mk-sector--lime:hover    { background: var(--c-lime); }
  .mk-sector--orange:hover  { background: var(--c-orange); color: var(--c-paper); }
  .mk-sector__num { font-size: .65rem; text-transform: uppercase; letter-spacing: .15em; color: var(--c-blue); font-weight: 700; }
  .mk-sector:hover .mk-sector__num { color: currentColor; opacity: .7; }
  .mk-sector__title { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: -.02em; margin: .25rem 0; color: inherit; }
  .mk-sector__desc { font-size: .88rem; line-height: 1.5; color: inherit; opacity: .85; margin: 0; }

  /* ═══════════════ PULL & QUOTES ═══════════════ */
  .mk-pull {
    position: relative;
    background: var(--c-ink);
    color: var(--c-paper);
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    border: 3px solid var(--c-ink);
    box-shadow: 12px 12px 0 var(--c-blue);
    margin: 0 0 3rem;
  }
  .mk-pull__mark { position: absolute; top: -1rem; left: 1.5rem; font-family: var(--font-editorial); font-size: clamp(8rem, 14vw, 13rem); line-height: 1; color: var(--c-magenta); font-style: italic; user-select: none; }
  .mk-pull__q { font-family: var(--font-editorial); font-style: italic; font-weight: 400; font-size: clamp(1.5rem, 3.4vw, 2.75rem); line-height: 1.2; color: var(--c-paper); max-width: 36ch; margin: 0; position: relative; z-index: 1; }
  .mk-pull__cap {
    margin-top: 2.5rem; padding-top: 1.5rem;
    border-top: 1px solid var(--c-paper);
    display: flex; align-items: center; gap: 1rem;
    flex-wrap: wrap;
  }
  .mk-pull__avatar {
    width: 54px; height: 54px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--c-lime); color: var(--c-ink);
    font-family: var(--font-display); font-weight: 800; font-size: 1.5rem;
    border: 2px solid var(--c-paper);
  }
  .mk-pull__name { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; color: var(--c-paper); }
  .mk-pull__role { display: block; font-family: var(--font-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .15em; color: rgba(255,252,246,.7); margin-top: .25rem; }
  .mk-pull__metric { margin-left: auto; text-align: right; padding-left: 1rem; border-left: 2px solid var(--c-paper); }
  .mk-pull__metric-v { font-family: var(--font-display); font-weight: 800; font-size: 2.5rem; color: var(--c-lime); display: block; line-height: 1; }
  .mk-pull__metric-l { font-family: var(--font-mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .14em; color: rgba(255,252,246,.7); display: block; margin-top: .25rem; }

  .mk-quotes { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .mk-quotes { grid-template-columns: repeat(3, 1fr); } }
  .mk-quote {
    background: var(--c-paper);
    border: 3px solid var(--c-ink);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: 1rem;
    box-shadow: 5px 5px 0 var(--c-q, var(--c-blue));
    transition: transform .25s, box-shadow .25s;
  }
  .mk-quote:hover { transform: translate(-3px,-3px); box-shadow: 8px 8px 0 var(--c-q, var(--c-blue)); }
  .mk-quote--cyan { --c-q: var(--c-cyan); }
  .mk-quote--lime { --c-q: var(--c-lime); background: #F4FFD6; }
  .mk-quote--magenta { --c-q: var(--c-magenta); background: #FFE3F1; }
  .mk-quote p { font-family: var(--font-editorial); font-style: italic; font-size: 1rem; line-height: 1.4; color: var(--c-ink); margin: 0; flex: 1; }
  .mk-quote footer { display: flex; gap: .75rem; align-items: center; padding-top: 1rem; border-top: 1px solid var(--brutal-border-soft); }
  .mk-quote__avatar { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; background: var(--c-ink); color: var(--c-lime); font-family: var(--font-display); font-weight: 800; font-size: 1rem; border: 2px solid var(--c-ink); flex-shrink: 0; }
  .mk-quote__name { display: block; font-family: var(--font-display); font-weight: 800; font-size: .95rem; color: var(--c-ink); }
  .mk-quote__role { display: block; font-size: .6rem; text-transform: uppercase; letter-spacing: .12em; color: var(--brutal-text-muted); margin-top: .2rem; }

  /* ═══════════════ FAQ ═══════════════ */
