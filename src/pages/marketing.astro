  }
  .mk-hero__lead strong { color: var(--c-tinta); }

  .mk-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; }

  /* ── DASHBOARD WIDGET ── */
  .mk-dashboard {
    background: var(--c-hondo);
    color: var(--c-tinta);
    border: 3px solid var(--c-regla2);
    box-shadow: 10px 10px 0 var(--c-blue);
    padding: 0;
    overflow: hidden;
  }
  .mk-dashboard__head {
    background: var(--c-panel);
    color: var(--c-tinta);
    padding: .85rem 1.1rem;
    border-bottom: 3px solid var(--c-regla2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-weight: 700;
  }
  .mk-dashboard__live {
    display: inline-flex; align-items: center; gap: .35rem;
    color: var(--c-magenta);
  }
  .mk-dashboard__pulse {
    width: 8px; height: 8px;
    background: var(--c-magenta);
    border-radius: 50%;
    animation: mk-pulse 1.4s ease-in-out infinite;
    color: var(--c-suelo);
  }
  @keyframes mk-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.6); opacity: .5; }
  }
  .mk-dashboard__kpis {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: var(--c-hondo);
  }
  .mk-kpi {
    padding: 1rem 1.1rem;
    border-right: 2px solid var(--c-regla2);
    border-bottom: 2px solid var(--c-regla2);
    display: flex; flex-direction: column; gap: .4rem;
    position: relative;
  }
  .mk-kpi:nth-child(2n) { border-right: 0; }
  .mk-kpi:nth-last-child(-n+2) { border-bottom: 0; }
  .mk-kpi--blue    { background: var(--c-blue); color: var(--c-suelo); }
  .mk-kpi--magenta { background: var(--c-panel); color: var(--c-tinta); }
  .mk-kpi--lime    { background: var(--c-lime); color: var(--c-suelo); }
  .mk-kpi--orange  { background: var(--c-orange); color: var(--c-suelo); }
  .mk-kpi__lbl { font-family: var(--font-mono); font-size: .6rem; text-transform: uppercase; letter-spacing: .14em; }
  .mk-kpi__num { font-family: var(--font-display); font-weight: 800; font-size: 1.8rem; letter-spacing: -.03em; line-height: 1; }
  .mk-kpi__spark { width: 100%; height: 20px; margin-top: auto; }
  .mk-dashboard__foot {
    background: var(--c-panel);
    color: var(--c-tinta);
    padding: .55rem 1.1rem;
    border-top: 3px solid var(--c-regla2);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: .6rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--c-tinta);
  }

  /* ── Marquee inferior ── */
  .mk-hero__marquee {
    position: relative;
    z-index: 2;
    background: var(--c-hondo);
    color: var(--c-lime);
    overflow: hidden;
    padding: 1.1rem 0;
    border-top: 3px solid var(--c-regla2);
  }
  .mk-hero__marquee-track {
    display: flex; gap: 2rem; align-items: center;
    width: max-content;
    animation: marquee 38s linear infinite;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .mk-hero__marquee-track span:nth-child(even) { color: var(--c-magenta); font-size: .85rem; }

  /* ─── Cabeceras de sección ─── */
  .mk-section { padding: clamp(4rem, 8vw, 7rem) 0; }
  .mk-section--alt { background: var(--c-panel); border-block: 3px solid var(--c-regla2); }
  .mk-section--dark { background: var(--c-hondo); color: var(--c-tinta); border-block: 3px solid var(--c-regla2); }
  .mk-section-head { max-width: 720px; margin-bottom: 3rem; }
  .mk-h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .9;
    letter-spacing: -.04em;
    color: var(--c-tinta);
    margin: 0 0 1rem;
    max-width: 16ch;
  }
  .mk-h2--light { color: var(--c-tinta); }
  .mk-h2 em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--c-magenta);
  }
  .mk-h2__data {
    background: var(--c-lime);
    padding: 0 .15em;
    color: var(--c-suelo);
    display: inline-block;
    transform: rotate(-1deg);
  }
  .mk-h2--light em { color: var(--c-lime); }
  .mk-lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 52ch; }
  .mk-lead--light { color: rgba(255,252,246,.85); }
  .mk-section-head--light .mk-eyebrow--lime { background: var(--c-lime); color: var(--c-suelo); border-color: var(--c-regla2); }

  /* ═══════════════ FUNNEL ═══════════════ */
  .mk-funnel-wrap {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: linear-gradient(180deg, var(--c-panel-2) 0%, var(--c-suelo) 100%);
    border-bottom: 3px solid var(--c-regla2);
    position: relative;
  }
  .mk-funnel {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 1024px) { .mk-funnel { grid-template-columns: 380px 1fr; gap: 4rem; } }

  .mk-funnel__visual {
    background: var(--c-panel);
    border: 3px solid var(--c-regla2);
    padding: 1.5rem;
    box-shadow: 10px 10px 0 var(--c-magenta);
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mk-funnel__visual svg { width: 100%; height: 100%; }

  .mk-funnel__stages {
    list-style: none; padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .mk-stage {
    padding: 1.25rem 1.5rem;
    background: var(--c-panel);
    border: 3px solid var(--c-regla2);
    box-shadow: 5px 5px 0 var(--c-s, var(--c-blue));
    display: grid;
    grid-template-columns: 1fr;
    gap: .5rem;
    transition: transform .2s, box-shadow .2s;
  }
  .mk-stage:hover { transform: translate(-3px,-3px); box-shadow: 8px 8px 0 var(--c-s, var(--c-blue)); }
  .mk-stage--blue    { --c-s: var(--c-blue); }
  .mk-stage--cyan    { --c-s: var(--c-cyan); }
  .mk-stage--magenta { --c-s: var(--c-magenta); }
  .mk-stage--lime    { --c-s: var(--c-lime); }
  .mk-stage--orange  { --c-s: var(--c-orange); }

  .mk-stage__num { font-size: .65rem; color: var(--brutal-text-muted); letter-spacing: .15em; }
  .mk-stage__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -.025em;
    color: var(--c-tinta);
    margin: 0;
  }
  .mk-stage__metric { display: flex; align-items: baseline; gap: .5rem; margin: .25rem 0 .5rem; }
  .mk-stage__val { font-family: var(--font-display); font-weight: 800; font-size: 2.25rem; line-height: 1; color: var(--c-s, var(--c-blue)); letter-spacing: -.03em; }
  .mk-stage__sub { font-family: var(--font-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; color: var(--brutal-text-muted); }
  .mk-stage__bar {
    position: relative;
    height: 14px;
    background: var(--c-suelo);
    border: 2px solid var(--c-regla2);
    display: flex;
    align-items: center;
  }
  .mk-stage__bar-fill {
    height: 100%;
    background: var(--c-s, var(--c-blue));
    transition: width .8s;
  }
  .mk-stage__bar-pct {
    position: absolute;
    right: .35rem;
    font-family: var(--font-mono);
    font-size: .58rem;
    font-weight: 800;
    color: var(--c-tinta);
    text-transform: uppercase;
  }
  .mk-stage__hint { font-family: var(--font-mono); font-size: .65rem; color: var(--brutal-text-muted); text-transform: uppercase; letter-spacing: .12em; }

  /* ═══════════════ CANALES (bento sparklines) ═══════════════ */
  .mk-channels {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 3px solid var(--c-regla2);
    background: var(--c-hondo);
  }
  @media (min-width: 768px) { .mk-channels { grid-template-columns: 1fr 1fr; gap: 3px; } }

  .mk-channel {
    background: var(--c-panel);
    padding: 2rem;
    display: flex; flex-direction: column;
    position: relative;
    transition: background .25s;
  }
  .mk-channel--blue:hover { background: var(--c-panel-2); }
  .mk-channel--lime:hover { background: var(--c-panel-2); }
  .mk-channel--magenta:hover { background: var(--c-panel-2); }
  .mk-channel--orange:hover { background: var(--c-panel-2); }

  .mk-channel__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--c-regla2);
  }
  .mk-channel__num {
    font-family: var(--font-mono);
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--c-c, var(--c-blue));
    line-height: 1;
    display: block;
  }
  .mk-channel--blue    { --c-c: var(--c-blue); }
  .mk-channel--lime    { --c-c: var(--c-lime); }
  .mk-channel--magenta { --c-c: var(--c-magenta); }
  .mk-channel--orange  { --c-c: var(--c-orange); }
  .mk-channel__kicker { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); display: block; margin-top: .35rem; }
  .mk-channel__icon {
    width: 54px; height: 54px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--c-c, var(--c-blue));
    color: var(--c-tinta);
    border: 2.5px solid var(--c-regla2);
    box-shadow: 4px 4px 0 var(--c-regla2);
  }
  .mk-channel--lime .mk-channel__icon { color: var(--c-tinta); }
  .mk-channel__icon svg { width: 30px; height: 30px; }

  .mk-channel__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    line-height: .95;
    letter-spacing: -.03em;
    margin: 1.5rem 0 .65rem;
    color: var(--c-tinta);
  }
  .mk-channel__desc { font-size: .92rem; line-height: 1.5; color: var(--brutal-text-secondary); margin: 0 0 1.25rem; max-width: 38ch; }
  .mk-channel__features { list-style: none; padding: 0; margin: 0 0 1.25rem; display: flex; flex-direction: column; gap: .45rem; }
  .mk-channel__features li { font-family: var(--font-mono); font-size: .78rem; display: flex; gap: .55rem; color: var(--c-tinta); }
  .mk-channel__features li span { color: var(--c-c, var(--c-blue)); font-weight: 800; }

  .mk-channel__chart {
    margin: 0 0 1.25rem;
    padding: .75rem;
    background: var(--c-suelo);
    border: 2px solid var(--c-regla2);
    color: var(--c-c, var(--c-blue));
  }
  .mk-channel__chart svg { width: 100%; height: 40px; display: block; }

  .mk-channel__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 1.25rem;
    border-top: 2px solid var(--c-regla2);
    margin-top: auto;
  }
  .mk-channel__figure { display: flex; flex-direction: column; line-height: 1; }
  .mk-channel__fig-val { font-family: var(--font-mono); font-size: 1.7rem; font-weight: 800; color: var(--c-tinta); }
  .mk-channel__fig-lbl { font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; letter-spacing: .15em; color: var(--brutal-text-muted); margin-top: .35rem; }
  .mk-channel__cta {
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--c-tinta);
    text-decoration: none;
    border-bottom: 2px solid var(--c-c, var(--c-blue));
    padding-bottom: .15em;
    transition: letter-spacing .2s;
  }
  .mk-channel:hover .mk-channel__cta { letter-spacing: .18em; }

  /* ═══════════════ A/B TESTING ═══════════════ */
  .mk-ab-wrap {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: var(--c-panel);
    border-block: 3px solid var(--c-regla2);
  }
  .mk-ab {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    align-items: stretch;
    margin: 2rem 0 1.5rem;
  }
  @media (min-width: 900px) { .mk-ab { grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; } }

  .mk-ab__variant {
    background: var(--c-suelo);
    border: 3px solid var(--c-regla2);
    padding: 1.5rem;
    box-shadow: 6px 6px 0 var(--c-regla2);
    position: relative;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .mk-ab__variant--a { background: var(--c-panel-2); }
  .mk-ab__variant--b { background: var(--c-blue); color: var(--c-suelo); box-shadow: 6px 6px 0 var(--c-lime); }

  .mk-ab__variant header { display: flex; justify-content: space-between; align-items: center; padding-bottom: .75rem; border-bottom: 2px solid currentColor; }
  .mk-ab__label { font-family: var(--font-mono); font-size: .6rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .mk-ab__variant--a .mk-ab__label { color: var(--c-tinta); }
  .mk-ab__share {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: .85rem;
    padding: .15rem .5rem;
    background: var(--c-hondo);
    color: var(--c-tinta);
    letter-spacing: .05em;
  }
  .mk-ab__variant--b .mk-ab__share { background: var(--c-lime); color: var(--c-suelo); }

  .mk-ab__mock {
    background: var(--c-panel);
    border: 2px solid var(--c-regla2);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    color: var(--c-tinta);
  }
  .mk-ab__mock-img {
    height: 80px;
    border: 2px solid var(--c-regla2);
    background-image: linear-gradient(45deg, transparent 48%, var(--c-hondo) 48%, var(--c-hondo) 52%, transparent 52%);
    background-size: 16px 16px;
    background-color: #DDD;
  }
  .mk-ab__mock-img--b {
    background-image:
      radial-gradient(circle at 25% 30%, var(--c-magenta) 0, var(--c-magenta) 10px, transparent 10px),
      radial-gradient(circle at 70% 60%, var(--c-lime) 0, var(--c-lime) 14px, transparent 14px),
      linear-gradient(45deg, transparent 48%, var(--c-hondo) 48%, var(--c-hondo) 52%, transparent 52%);
    background-size: cover, cover, 16px 16px;
    background-color: var(--c-panel-2);
  }
  .mk-ab__mock-h { font-family: var(--font-display); font-weight: 700; font-size: 1rem; line-height: 1.1; }
  .mk-ab__mock-cta {
    padding: .55rem .85rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    border: 2px solid var(--c-regla2);
    text-align: center;
  }
  .mk-ab__mock-cta--a { background: #BBB; color: var(--c-suelo); }
  .mk-ab__mock-cta--b { background: var(--c-orange); color: var(--c-suelo); box-shadow: 3px 3px 0 var(--c-regla2); }

  .mk-ab__stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    margin: 0;
    border: 2px solid currentColor;
  }
  .mk-ab__stats > div { padding: .65rem .5rem; text-align: center; border-right: 2px solid currentColor; }
  .mk-ab__stats > div:last-child { border-right: 0; }
  .mk-ab__stats dt { font-family: var(--font-mono); font-size: .55rem; text-transform: uppercase; letter-spacing: .14em; }
  .mk-ab__stats dd { font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; margin: .25rem 0 0; }

  .mk-ab__vs { display: flex; justify-content: center; align-items: center; }
  .mk-ab__crown {
    position: absolute;
    top: -.85rem;
    right: 1rem;
    background: var(--c-lime);
    color: var(--c-suelo);
    border: 2px solid var(--c-regla2);
    padding: .2rem .6rem;
    font-family: var(--font-mono);
    font-size: .65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .12em;
    transform: rotate(3deg);
    box-shadow: 3px 3px 0 var(--c-regla2);
  }
  .mk-ab__note {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--c-yellow);
    border: 2px solid var(--c-regla2);
    font-family: var(--font-mono);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--c-suelo);
    text-align: center;
  }
  .mk-ab__note strong { font-weight: 800; }

  /* ═══════════════ STACK ═══════════════ */
  .mk-stack {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 3px solid var(--c-regla2);
  }
  @media (min-width: 640px) { .mk-stack { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .mk-stack { grid-template-columns: repeat(4, 1fr); } }
  .mk-stack__item {
    padding: 1.5rem;
    border-right: 2px solid var(--c-regla2);
    border-bottom: 2px solid var(--c-regla2);
    background: var(--c-hondo);
    color: var(--c-tinta);
    transition: background .25s, color .25s;
  }
  .mk-stack__item:hover { background: var(--c-c, var(--c-blue)); color: var(--c-suelo); }
  .mk-stack__item--blue    { --c-c: var(--c-blue); }
  .mk-stack__item--magenta { --c-c: var(--c-magenta); }
  .mk-stack__item--cyan    { --c-c: var(--c-cyan); }
  .mk-stack__item--lime    { --c-c: var(--c-lime); }
  .mk-stack__item--orange  { --c-c: var(--c-orange); }
  .mk-stack__index { font-family: var(--font-mono); font-size: .7rem; font-weight: 800; color: var(--c-c, var(--c-blue)); letter-spacing: .15em; }
  .mk-stack__k { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: -.02em; margin: .35rem 0 .5rem; color: inherit; }
  .mk-stack__v { font-family: var(--font-mono); font-size: .75rem; line-height: 1.5; color: rgba(255,252,246,.7); margin: 0; }
  .mk-stack__item:hover :is(.mk-stack__index, .mk-stack__v) { color: inherit; }

  /* ═══════════════ PROCESS ═══════════════ */
  .mk-process { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .mk-step {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    background: var(--c-panel);
    border: 3px solid var(--c-regla2);
    padding: 1.75rem 2rem;
    box-shadow: 8px 8px 0 var(--c-step, var(--c-blue));
    transition: transform .25s, box-shadow .25s;
  }
  .mk-step:hover { transform: translate(-3px,-3px); box-shadow: 11px 11px 0 var(--c-step, var(--c-blue)); }
  @media (min-width: 768px) { .mk-step { grid-template-columns: 200px 1fr; gap: 2rem; align-items: start; } }
  .mk-step--blue    { --c-step: var(--c-blue); }
  .mk-step--magenta { --c-step: var(--c-magenta); }
  .mk-step--lime    { --c-step: var(--c-lime); }
  .mk-step--orange  { --c-step: var(--c-orange); }
  .mk-step__big {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5rem, 11vw, 9rem);
    line-height: .85;
    color: var(--c-step, var(--c-blue));
    letter-spacing: -.05em;
    -webkit-text-stroke: 3px var(--c-tinta);
  }
  .mk-step__body { display: flex; flex-direction: column; gap: .5rem; }
  .mk-step__eta { font-size: .68rem; text-transform: uppercase; letter-spacing: .15em; color: var(--c-step, var(--c-blue)); font-weight: 800; }
  .mk-step__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -.025em; color: var(--c-tinta); margin: 0; line-height: 1; }
  .mk-step__desc { font-size: 1rem; line-height: 1.55; color: var(--brutal-text-secondary); margin: 0; max-width: 54ch; }
  .mk-step__deliv {
    margin-top: .65rem;
    padding: .65rem .85rem;
    background: var(--c-step, var(--c-blue));
    color: var(--c-suelo);
    font-family: var(--font-mono);
    font-size: .8rem;
    border: 2px solid var(--c-regla2);
    display: inline-block;
    align-self: flex-start;
  }
  .mk-step__deliv span { font-weight: 800; }

  /* ═══════════════ SECTORS ═══════════════ */
  .mk-sectors {
