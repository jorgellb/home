---
import '../styles/paginas-servicio.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Relacionados from '../components/cdm/Relacionados.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import EjemploWeb from '../components/cdm/EjemploWeb.astro';
import Boton from '../components/cdm/Boton.astro';
import { comarcas, getPueblosByComarca } from '../data/pueblos-almeria';

const title = 'Diseño y Desarrollo Web en Almería';
const description = 'Desarrollo web profesional en Almería. Webs corporativas, tiendas online y e-commerce ultrarrápidos. Hosting gratuito, sin permanencia. Presupuesto gratis.';
const canonical = 'https://platanitorico.com/desarrollo-web/';

const services = [
  { n: '01', title: 'Landing de alta conversión',  kicker: 'Captación · Ads · Lanzamientos', desc: 'Una página, un objetivo: que el visitante contacte, compre o reserve. Estructura de copywriting persuasivo, carga ultrarrápida y formulario optimizado.', features: ['Diseño orientado a conversión', 'Copywriting incluido', 'Formulario optimizado con validación', 'Carga < 1 segundo', 'SEO on-page', 'Versión móvil pixel-perfect'], figure: 'CR ↑', figureLabel: 'Tasa de conversión', color: 'lime', device: 'mobile' },
  { n: '02', title: 'Web corporativa',              kicker: 'Branding · Blog · Confianza',     desc: 'Tu empresa merece una presencia digital que transmita profesionalidad y genere confianza. Múltiples secciones, blog integrado y preparada para escalar.', features: ['5–15 páginas según necesidades', 'Blog integrado con SEO', 'Google Analytics + Search Console', 'Hosting gratuito (estáticas)', 'Panel de admin intuitivo', 'SSL incluido'], figure: '5–15p', figureLabel: 'Páginas', color: 'blue', device: 'desktop' },
  { n: '03', title: 'Tienda online · E-commerce',   kicker: 'Pasarela · Stock · SEO producto', desc: 'Vende 24/7 con una tienda optimizada para convertir. Catálogo, carrito, pasarela de pago y gestión de pedidos integrada.', features: ['Catálogo ilimitado', 'Stripe · PayPal · Redsys · Bizum', 'Gestión de stock e inventario', 'Envíos automatizados', 'SEO producto/categoría', 'Panel fácil de usar'], figure: '24/7', figureLabel: 'Ventas online', color: 'magenta', device: 'tablet' },
  { n: '04', title: 'Web app a medida',             kicker: 'Intranet · CRM · ERP · Custom',   desc: 'Soluciones digitales complejas: intranets, paneles de gestión, portales de noticias o cualquier sistema que necesite tu negocio.', features: ['Arquitectura a medida', 'Base de datos + API propias', 'Panel admin personalizado', 'Integración CRM / ERP', 'Seguridad y roles', 'Escalable y mantenible'], figure: 'Custom', figureLabel: 'Desarrollo', color: 'purple', device: 'terminal' },
];

const stack = [
  { name: 'Astro',      v: '6.x', cat: 'Framework',  color: 'orange',  desc: 'SSG · Islands architecture' },
  { name: 'Next.js',    v: '15',  cat: 'Framework',  color: 'ink',      desc: 'App Router · React Server Components' },
  { name: 'TypeScript', v: '5',   cat: 'Lenguaje',   color: 'blue',     desc: 'Type-safe desde el código' },
  { name: 'Tailwind',   v: '4',   cat: 'Styles',     color: 'cyan',     desc: 'Utility-first · CSS-first config' },
  { name: 'React',      v: '19',  cat: 'UI library', color: 'cyan',     desc: 'Interactividad selectiva' },
  { name: 'Node',       v: '22',  cat: 'Runtime',    color: 'lime',     desc: 'LTS · ESM nativo' },
  { name: 'Cloudflare', v: 'CDN', cat: 'Hosting',    color: 'orange',   desc: 'Edge · 300+ ciudades' },
  { name: 'PostgreSQL', v: '16',  cat: 'Database',   color: 'blue',     desc: 'Cuando hace falta DB' },
];

const cwv = [
  { metric: 'LCP',  label: 'Largest Contentful Paint', target: '< 2.5s', value: '0.8s', pct: 88, color: 'lime' },
  { metric: 'INP',  label: 'Interaction to Next Paint', target: '< 200ms', value: '42ms', pct: 92, color: 'cyan' },
  { metric: 'CLS',  label: 'Cumulative Layout Shift',  target: '< 0.1',  value: '0.02', pct: 95, color: 'magenta' },
];

const process = [
  { num: '01', title: 'Análisis y estrategia',  eta: '2–3 días',  body: 'Estudiamos tu negocio, competencia y objetivos. Definimos arquitectura, funcionalidades y tecnología.', deliverable: 'Briefing escrito + roadmap', commit: 'init: project briefing', color: 'magenta' },
  { num: '02', title: 'Diseño y prototipo',     eta: '3–5 días',  body: 'Diseño visual y experiencia de usuario validada contigo antes de programar una línea de código.', deliverable: 'Prototipo Figma navegable', commit: 'feat(design): figma prototype approved', color: 'cyan' },
  { num: '03', title: 'Desarrollo y testing',   eta: '5–10 días', body: 'Programación con tecnologías actuales. Testing cross-device + cross-browser para garantizar funcionamiento.', deliverable: 'Web en staging + auditoría', commit: 'feat(dev): staging build · lighthouse 99', color: 'orange' },
  { num: '04', title: 'Lanzamiento y formación', eta: '1–2 días', body: 'Publicación, configuración SEO inicial y formación para que gestiones contenido de forma autónoma.', deliverable: 'Sitio en producción + manual', commit: 'release: production deploy 🚀', color: 'lime' },
];

const plans = [
  { name: 'Mantenimiento Básico', price: '39€', period: 'mes', desc: 'Ideal para webs corporativas, blogs y sitios informativos.', features: ['Hosting + correo profesional','Actualizaciones de seguridad','Copias de seguridad diarias','SSL gratuito','5 h de cambios/mes','Soporte email (48h)','Monitorización 24/7'], badge: 'Para empezar', popular: false },
  { name: 'Mantenimiento Pro',    price: '79€', period: 'mes', desc: 'Para empresas que dependen de su web y necesitan gestión continua.',  features: ['Hosting + correo profesional','20 h de cambios/mes','Optimización Core Web Vitals','Auditoría SEO técnica mensual','Soporte telefónico L–V','Recuperación garantizada <48h','Informe mensual'], badge: 'Más contratado', popular: true },
  { name: 'Mantenimiento Tienda', price: '149€', period: 'mes', desc: 'Máxima protección para tiendas online PrestaShop / WooCommerce.', features: ['Todo del plan Pro','Hosting optimizado e-commerce','Minitareas ilimitadas (≤15 min)','Gestión de catálogo incluida','Soporte prioritario 24/7','Recuperación garantizada <24h','Protección RGPD avanzada'], badge: 'Para e-commerce', popular: false },
];

const sectors = [
  { title: 'Hostelería y turismo', desc: 'Webs para restaurantes, hoteles y casas rurales que generan reservas directas sin intermediarios.' },
  { title: 'Inmobiliarias',         desc: 'Portales inmobiliarios con fichas de propiedades, filtros avanzados y captación de compradores.' },
  { title: 'E-commerce',            desc: 'Tiendas online que convierten: catálogo optimizado, checkout fluido y SEO para productos.' },
  { title: 'Servicios profesionales', desc: 'Webs para abogados, clínicas y consultorías que transmiten confianza y captan clientes.' },
  { title: 'Construcción y reformas', desc: 'Portfolios visuales con galería de proyectos que generan presupuestos de calidad.' },
  { title: 'Agricultura y exportación', desc: 'Webs multiidioma para cooperativas y productores que quieren abrir mercados internacionales.' },
];

const hostingCompare = [
  { aspect: 'Coste mensual',     traditional: '5–30€/mes',         static: '0€ · gratis para siempre',     wpScore: 20, asScore: 100 },
  { aspect: 'Velocidad de carga', traditional: '2–5 segundos',      static: '<1 segundo · CDN global',       wpScore: 35, asScore: 100 },
  { aspect: 'Seguridad',          traditional: 'Vulnerable a hackeos', static: 'Inmune a ataques de servidor', wpScore: 40, asScore: 95 },
  { aspect: 'SSL (HTTPS)',        traditional: 'A veces de pago',   static: 'Incluido gratis automáticamente', wpScore: 60, asScore: 100 },
  { aspect: 'Escalabilidad',      traditional: 'Se cae con picos',  static: 'Aguanta millones de visitas',   wpScore: 30, asScore: 98 },
  { aspect: 'Mantenimiento',      traditional: 'Actualizaciones constantes', static: 'Cero mantenimiento de servidor', wpScore: 25, asScore: 95 },
];

const testimonials = [
  { text: 'Nos hicieron la web corporativa en 10 días. Es rapidísima, aparecemos los primeros en Google para nuestro sector y el hosting es gratuito.', author: 'Laura G.',    role: 'Directora · Estudio de arquitectura · Almería' },
  { text: 'La tienda online que nos montaron funciona perfecta. Las ventas online ya suponen el 30% de nuestra facturación.',                                  author: 'Miguel A.',  role: 'Propietario · Tienda gourmet · Roquetas de Mar' },
  { text: 'Veníamos de WordPress que tardaba 6 segundos. La nueva carga en menos de 1 segundo y los contactos se han triplicado.',                             author: 'Patricia R.',role: 'Gerente · Clínica dental · Mojácar' },
  { text: 'Una landing para una campaña de Google Ads. La conversión pasó del 2% al 8%. Inversión recuperada en una semana.',                                  author: 'David S.',   role: 'CEO · Empresa de reformas · Almería' },
];

const faq = [
  { q: '¿Cuánto tarda en estar lista mi web?', a: 'Depende del proyecto. Una landing: 5–7 días. Una web corporativa: 1–2 semanas. Una tienda online: 2–3 semanas. Proyectos a medida según complejidad. Siempre te damos plazo concreto antes de empezar.' },
  { q: '¿Qué es el hosting gratuito para webs estáticas?', a: 'Las webs sin base de datos (corporativas, portfolios, landings) pueden alojarse gratis en Vercel o Cloudflare Pages. Son más rápidas, más seguras y no pagas hosting mensual. Solo pagas el dominio.' },
  { q: '¿La web es mía o me ato a vosotros?', a: 'Es 100% tuya. Te entregamos el código fuente, el dominio está a tu nombre y puedes llevarte tu web cuando quieras. Sin permanencia.' },
  { q: '¿Mi web estará optimizada para Google (SEO)?', a: 'Sí. Todas incluyen SEO técnico: estructura semántica, velocidad optimizada, meta tags, schema markup, sitemap XML, robots.txt y Search Console configurado.' },
  { q: '¿Puedo gestionar el contenido yo mismo?', a: 'Por supuesto. Panel de administración intuitivo y formación. Si quieres ayuda, planes de mantenimiento desde 39€/mes con horas de cambios incluidas.' },
  { q: '¿Hacéis tiendas con pasarela de pago?', a: 'Sí. Stripe, PayPal, Redsys (tarjetas españolas), Bizum y transferencia. Todo con SSL y cumpliendo PSD2.' },
  { q: '¿Qué pasa si necesito cambios después?', a: 'Puedes hacerlos tú desde el panel, contratar un plan de mantenimiento mensual o pedir cambios puntuales bajo presupuesto. Siempre tienes soporte.' },
  { q: '¿Trabajáis solo en Almería?', a: 'Estamos especializados en empresas de Almería pero trabajamos con clientes de toda España. Lo importante es entender tu negocio, no la distancia.' },
];

const jsonLdSchemas = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Diseño Web","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Diseño Web en Almería","description":"Agencia de diseño web y desarrollo profesional en Almería.","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","address":{"@type":"PostalAddress","addressLocality":"Almería","addressRegion":"Andalucía","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":36.834,"longitude":-2.4637},"areaServed":{"@type":"State","name":"Almería"},"priceRange":"€€","openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"19:00"},"hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios de Diseño y Desarrollo Web","itemListElement":services.map(s=>({"@type":"Offer","itemOffered":{"@type":"Service","name":s.title,"description":s.desc}}))} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo creamos tu página web profesional","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-desarrollo-web-calidad.jpg"
  imageAlt="Desarrollo web profesional en Almería - Platanito Rico"
  type="service"
  keywords="diseño web almería, desarrollo web almería, tienda online almería, web corporativa, hosting gratuito"
  jsonLd={jsonLdSchemas}
>
  <Header />
  <Breadcrumb tono="consola" items={[{ label: 'Inicio', href: '/' }, { label: 'Diseño Web' }]} />

  <main id="main-content" class="dw">
    {/* ═══════════════ HERO IDE ═══════════════ */}
    <section class="dw-hero">
      <div class="dw-hero__grid-bg" aria-hidden="true"></div>

      <div class="container-brutal dw-hero__inner">
        <header class="dw-hero__head">
          <span class="dw-tag dw-tag--terminal">
            <span class="dw-tag__dots"><span></span><span></span><span></span></span>
            ~/desarrollo-web $ npm run build
          </span>
          <span class="dw-tag dw-tag--success">
            <span class="dw-tag__pulse"></span>
            BUILD READY · 0 errors
          </span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="dw-hero__grid">
          <div class="dw-hero__left">
            <span class="dw-eyebrow">★ Astro · Next · Tailwind · Performance</span>

            <h1 class="dw-title">
              Tu web tiene que hacer
              <em>una cosa:</em>
              <span class="dw-title__highlight">venderte.</span>
            </h1>

            <p class="dw-hero__lead">
              Webs <strong>ultrarrápidas</strong>, optimizadas para Google y diseñadas
              para convertir. <strong>Hosting gratuito</strong> para webs estáticas,
              sin permanencia. Cada entrega sale con Core Web Vitals en verde y
              objetivo Lighthouse 95+ en móvil.
            </p>

            <div class="dw-hero__cta">
              <Boton href="/contacto/">Empezar proyecto</Boton>
              <Boton href="tel:+34657085019" variante="linea">657 085 019</Boton>
            </div>

            {/* Objetivo de calidad de cada entrega (no es una medida de tu web) */}
            <p class="dw-lh__nota text-mono">★ Objetivo de cada entrega</p>
            <ul class="dw-lh">
              <li class="dw-lh__item">
                <svg class="dw-lh__ring" viewBox="0 0 36 36" aria-hidden="true">
                  <circle class="dw-lh__ring-bg" cx="18" cy="18" r="15.915" stroke-dasharray="100,100" stroke="rgba(0,255,148,.2)"/>
                  <circle class="dw-lh__ring-fg" cx="18" cy="18" r="15.915" stroke-dasharray="99,100" stroke="#00FF94"/>
                  <text x="18" y="21" text-anchor="middle" font-family="JetBrains Mono" font-weight="700" font-size="9" fill="#00FF94">99</text>
                </svg>
                <span class="dw-lh__label">Performance</span>
              </li>
              <li class="dw-lh__item">
                <svg class="dw-lh__ring" viewBox="0 0 36 36" aria-hidden="true">
                  <circle class="dw-lh__ring-bg" cx="18" cy="18" r="15.915" stroke-dasharray="100,100" stroke="rgba(0,255,148,.2)"/>
                  <circle class="dw-lh__ring-fg" cx="18" cy="18" r="15.915" stroke-dasharray="100,100" stroke="#00FF94"/>
                  <text x="18" y="21" text-anchor="middle" font-family="JetBrains Mono" font-weight="700" font-size="9" fill="#00FF94">100</text>
                </svg>
                <span class="dw-lh__label">Accessibility</span>
              </li>
              <li class="dw-lh__item">
                <svg class="dw-lh__ring" viewBox="0 0 36 36" aria-hidden="true">
                  <circle class="dw-lh__ring-bg" cx="18" cy="18" r="15.915" stroke-dasharray="100,100" stroke="rgba(0,255,148,.2)"/>
                  <circle class="dw-lh__ring-fg" cx="18" cy="18" r="15.915" stroke-dasharray="100,100" stroke="#00FF94"/>
                  <text x="18" y="21" text-anchor="middle" font-family="JetBrains Mono" font-weight="700" font-size="9" fill="#00FF94">100</text>
                </svg>
                <span class="dw-lh__label">Best Practices</span>
              </li>
              <li class="dw-lh__item">
                <svg class="dw-lh__ring" viewBox="0 0 36 36" aria-hidden="true">
                  <circle class="dw-lh__ring-bg" cx="18" cy="18" r="15.915" stroke-dasharray="100,100" stroke="rgba(0,255,148,.2)"/>
                  <circle class="dw-lh__ring-fg" cx="18" cy="18" r="15.915" stroke-dasharray="100,100" stroke="#00FF94"/>
                  <text x="18" y="21" text-anchor="middle" font-family="JetBrains Mono" font-weight="700" font-size="9" fill="#00FF94">100</text>
                </svg>
                <span class="dw-lh__label">SEO</span>
              </li>
            </ul>
          </div>

          {/* IDE / Code Editor Mock */}
          <aside class="dw-editor">
            <header class="dw-editor__head">
              <div class="dw-editor__dots">
                <span class="dw-editor__dot dw-editor__dot--r"></span>
                <span class="dw-editor__dot dw-editor__dot--y"></span>
                <span class="dw-editor__dot dw-editor__dot--g"></span>
              </div>
              <span class="dw-editor__file">src/pages/index.astro</span>
              <span class="dw-editor__badge">● Saved</span>
            </header>

            <div class="dw-editor__body">
              <div class="dw-editor__gutter">
                <span>1</span><span>2</span><span>3</span><span>4</span>
                <span>5</span><span>6</span><span>7</span><span>8</span>
                <span>9</span><span>10</span><span>11</span><span>12</span>
              </div>
              <pre class="dw-editor__code"><code><span class="c-key">import</span> <span class="c-id">BaseLayout</span> <span class="c-key">from</span> <span class="c-str">'@/layouts/BaseLayout.astro'</span>;
<span class="c-key">import</span> <span class="c-id">Hero</span> <span class="c-key">from</span> <span class="c-str">'@/components/Hero.astro'</span>;
<span class="c-com">{'// 📦 Build: Astro 6 · Tailwind 4 · TS 6'}</span>

<span class="c-key">const</span> <span class="c-id">site</span> = {'{'}
  <span class="c-prop">name</span>: <span class="c-str">'Platanito Rico'</span>,
  <span class="c-prop">lighthouse</span>: <span class="c-num">99</span>,
  <span class="c-prop">loadTime</span>: <span class="c-str">'0.8s'</span>,
  <span class="c-prop">hosting</span>: <span class="c-str">'free-forever'</span>,
{'}'};
<span class="c-com">{'// ✨ Deploy: cloudflare pages'}</span>
<span class="c-key">export</span> <span class="c-key">async</span> <span class="c-key">function</span> <span class="c-fn">getStaticPaths</span>(){'{'}{'}'}</code></pre>
            </div>

            <footer class="dw-editor__foot">
              <span class="dw-editor__stat"><span class="dw-editor__pulse"></span> Astro v6.3.8</span>
              <span class="dw-editor__stat">UTF-8</span>
              <span class="dw-editor__stat">TS</span>
              <span class="dw-editor__stat">⌘+S</span>
            </footer>
          </aside>
        </div>

        {/* Stats bar */}
        <ul class="dw-hero__stats">
          <li class="dw-stat dw-stat--lime">
            <span class="dw-stat__num">95<sup>+</sup></span>
            <span class="dw-stat__lbl">Lighthouse objetivo</span>
          </li>
          <li class="dw-stat dw-stat--blue">
            <span class="dw-stat__num">&lt;1<sup>s</sup></span>
            <span class="dw-stat__lbl">First Paint</span>
          </li>
          <li class="dw-stat dw-stat--magenta">
            <span class="dw-stat__num">0<sup>€</sup></span>
            <span class="dw-stat__lbl">Hosting / año</span>
          </li>
          <li class="dw-stat dw-stat--ink">
            <span class="dw-stat__num">300<sup>+</sup></span>
            <span class="dw-stat__lbl">CDN ciudades</span>
          </li>
        </ul>
      </div>

      {/* Terminal marquee */}
      <div class="dw-hero__marquee" aria-hidden="true">
        <div class="dw-hero__marquee-track">
          {Array.from({length: 4}).map(() => (
            <>
              <span>$ astro build</span><span>★</span>
              <span>✓ 124 pages</span><span>★</span>
              <span>$ npm run deploy</span><span>★</span>
              <span>🚀 Live on CDN</span><span>★</span>
              <span>$ git push origin main</span><span>★</span>
              <span>✓ objetivo Lighthouse 95+</span><span>★</span>
            </>
          ))}
        </div>
      </div>
    </section>

    {/* ═══════════════ CORE WEB VITALS ═══════════════ */}
    <section class="dw-cwv-wrap">
      <div class="container-brutal">
        <header class="dw-section-head">
          <span class="dw-eyebrow dw-eyebrow--lime">Cap. 01 / Performance</span>
          <h2 class="dw-h2">
            <em>Core Web Vitals</em>
            verdes <span class="dw-h2__data">desde el código.</span>
          </h2>
          <p class="dw-lead">
            Google los mide. Tus usuarios los sienten. Trabajamos las
            tres métricas críticas con presupuesto técnico desde el día uno.
          </p>
        </header>

        <ol class="dw-cwv">
          {cwv.map((m) => (
            <li class={`dw-cwv__item dw-cwv__item--${m.color}`}>
              <div class="dw-cwv__gauge">
                <svg viewBox="0 0 200 124" aria-hidden="true">
                  <defs>
                    <linearGradient id={`grad-${m.metric}`} x1="0" y1="0" x2="1" y2="0">
                      <stop offset="0%" stop-color="#FF6B6B"/>
                      <stop offset="50%" stop-color="#FFEB00"/>
                      <stop offset="100%" stop-color="#00FF94"/>
                    </linearGradient>
                  </defs>
                  {/* Track gauge */}
                  <path d="M20,100 A80,80 0 0 1 180,100" fill="none" stroke="#26394a" stroke-width="20" stroke-linecap="square"/>
                  <path d="M20,100 A80,80 0 0 1 180,100" fill="none" stroke={`url(#grad-${m.metric})`} stroke-width="16" stroke-linecap="square" stroke-dasharray={`${m.pct * 2.5},250`}/>
                  {/* Needle */}
                  <g style={`transform-origin:100px 100px;transform:rotate(${(m.pct * 1.8) - 90}deg)`}>
                    <line x1="100" y1="100" x2="100" y2="35" stroke="#e6edf2" stroke-width="4" stroke-linecap="round"/>
                    <circle cx="100" cy="100" r="9" fill="#e6edf2"/>
                    <circle cx="100" cy="100" r="4" fill="#070b10"/>
                  </g>
                  {/* Min / max labels */}
                  <text x="20" y="122" text-anchor="middle" font-family="JetBrains Mono" font-size="9" fill="#8494a2" font-weight="700">Poor</text>
                  <text x="180" y="122" text-anchor="middle" font-family="JetBrains Mono" font-size="9" fill="#8494a2" font-weight="700">Good</text>
                </svg>
              </div>
              <div class="dw-cwv__data">
                <span class="dw-cwv__metric">{m.metric}</span>
                <span class="dw-cwv__label">{m.label}</span>
                <div class="dw-cwv__values">
                  <div>
                    <span class="dw-cwv__k">Objetivo</span>
                    <span class="dw-cwv__v">{m.target}</span>
                  </div>
                  <div>
                    <span class="dw-cwv__k">Real</span>
