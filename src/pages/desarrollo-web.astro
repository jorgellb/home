---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { comarcas, getPueblosByComarca } from '../data/pueblos-almeria';

const title = 'Diseño Web en Almería | Desarrollo Web Profesional y Tiendas Online';
const description = 'Desarrollo web profesional en Almería. Webs corporativas, tiendas online y e-commerce ultrarrápidos. Hosting gratuito, sin permanencia. Presupuesto gratis.';
const canonical = 'https://platanitorico.com/desarrollo-web/';

const services = [
  { n: '01', title: 'Landing de alta conversión',  kicker: 'Captación · Ads · Lanzamientos', desc: 'Una página, un objetivo: que el visitante contacte, compre o reserve. Estructura de copywriting persuasivo, carga ultrarrápida y formulario optimizado.', features: ['Diseño orientado a conversión', 'Copywriting incluido', 'Formulario optimizado con validación', 'Carga < 1 segundo', 'SEO on-page', 'Versión móvil pixel-perfect'], figure: 'CR ↑', figureLabel: 'Tasa de conversión', accent: 'accent' },
  { n: '02', title: 'Web corporativa',              kicker: 'Branding · Blog · Confianza',     desc: 'Tu empresa merece una presencia digital que transmita profesionalidad y genere confianza. Múltiples secciones, blog integrado y preparada para escalar.', features: ['5–15 páginas según necesidades', 'Blog integrado con SEO', 'Google Analytics + Search Console', 'Hosting gratuito (estáticas)', 'Panel de admin intuitivo', 'SSL incluido'], figure: '5–15p', figureLabel: 'Páginas', accent: 'paper' },
  { n: '03', title: 'Tienda online · E-commerce',   kicker: 'Pasarela · Stock · SEO producto', desc: 'Vende 24/7 con una tienda optimizada para convertir. Catálogo, carrito, pasarela de pago y gestión de pedidos integrada.', features: ['Catálogo ilimitado', 'Stripe · PayPal · Redsys · Bizum', 'Gestión de stock e inventario', 'Envíos automatizados', 'SEO producto/categoría', 'Panel fácil de usar'], figure: '24/7', figureLabel: 'Ventas online', accent: 'lime' },
  { n: '04', title: 'Web app a medida',             kicker: 'Intranet · CRM · ERP · Custom',   desc: 'Soluciones digitales complejas: intranets, paneles de gestión, portales de noticias o cualquier sistema que necesite tu negocio.', features: ['Arquitectura a medida', 'Base de datos + API propias', 'Panel admin personalizado', 'Integración CRM / ERP', 'Seguridad y roles', 'Escalable y mantenible'], figure: 'Custom', figureLabel: 'Desarrollo', accent: 'ink' },
];

const process = [
  { num: '01', title: 'Análisis y estrategia', eta: '2–3 días', body: 'Estudiamos tu negocio, competencia y objetivos. Definimos arquitectura, funcionalidades y tecnología.', deliverable: 'Briefing escrito + roadmap' },
  { num: '02', title: 'Diseño y prototipo',    eta: '3–5 días', body: 'Diseño visual y experiencia de usuario validada contigo antes de programar una línea de código.', deliverable: 'Prototipo Figma navegable' },
  { num: '03', title: 'Desarrollo y testing',  eta: '5–10 días', body: 'Programación con tecnologías actuales. Testing cross-device + cross-browser para garantizar funcionamiento.', deliverable: 'Web en staging + auditoría' },
  { num: '04', title: 'Lanzamiento y formación', eta: '1–2 días', body: 'Publicación, configuración SEO inicial y formación para que gestiones contenido de forma autónoma.', deliverable: 'Sitio en producción + manual' },
];

const plans = [
  { name: 'Mantenimiento Básico', price: '39€', period: 'mes', desc: 'Ideal para webs corporativas, blogs y sitios informativos.', features: ['Hosting + correo profesional','Actualizaciones de seguridad','Copias de seguridad diarias','SSL gratuito','5 h de cambios/mes','Soporte email (48h)','Monitorización 24/7'], badge: 'Para empezar', popular: false },
  { name: 'Mantenimiento Pro',    price: '79€', period: 'mes', desc: 'Para empresas que dependen de su web y necesitan gestión continua.',  features: ['Hosting + correo profesional','20 h de cambios/mes','Optimización Core Web Vitals','Auditoría SEO técnica mensual','Soporte telefónico L–V','Recuperación garantizada <48h','Informe mensual'], badge: 'Más contratado', popular: true },
  { name: 'Mantenimiento Tienda', price: '149€', period: 'mes', desc: 'Máxima protección para tiendas online PrestaShop / WooCommerce.', features: ['Todo del plan Pro','Hosting optimizado e-commerce','Minitareas ilimitadas (≤15 min)','Gestión de catálogo incluida','Soporte prioritario 24/7','Recuperación garantizada <24h','Protección RGPD avanzada'], badge: 'Para e-commerce', popular: false },
];

const sectors = [
  { title: 'Hostelería y turismo', desc: 'Webs para restaurantes, hoteles y casas rurales que generan reservas directas sin intermediarios.' },
  { title: 'Inmobiliarias',         desc: 'Portales inmobiliarios con fichas de propiedades, filtros avanzados y captación de compradores.' },
  { title: 'E-commerce',            desc: 'Tiendas online que convierten: catálogo optimizado, checkout fluido y SEO para productos.' },
  { title: 'Servicios profesionales', desc: 'Webs para abogados, clínicas y consultorías que transmiten confianza y captan clientes.' },
  { title: 'Construcción y reformas', desc: 'Portfolios visuales con galería de proyectos que generan presupuestos de calidad.' },
  { title: 'Agricultura y exportación', desc: 'Webs multiidioma para cooperativas y productores que quieren abrir mercados internacionales.' },
];

const hostingCompare = [
  { aspect: 'Coste mensual',     traditional: '5–30€/mes',         static: '0€ · gratis para siempre' },
  { aspect: 'Velocidad de carga', traditional: '2–5 segundos',      static: '<1 segundo · CDN global' },
  { aspect: 'Seguridad',          traditional: 'Vulnerable a hackeos', static: 'Inmune a ataques de servidor' },
  { aspect: 'SSL (HTTPS)',        traditional: 'A veces de pago',   static: 'Incluido gratis automáticamente' },
  { aspect: 'Escalabilidad',      traditional: 'Se cae con picos',  static: 'Aguanta millones de visitas' },
  { aspect: 'Mantenimiento',      traditional: 'Actualizaciones constantes', static: 'Cero mantenimiento de servidor' },
];

const testimonials = [
  { text: 'Nos hicieron la web corporativa en 10 días. Es rapidísima, aparecemos los primeros en Google para nuestro sector y el hosting es gratuito.', author: 'Laura G.',    role: 'Directora · Estudio de arquitectura · Almería' },
  { text: 'La tienda online que nos montaron funciona perfecta. Las ventas online ya suponen el 30% de nuestra facturación.',                                  author: 'Miguel A.',  role: 'Propietario · Tienda gourmet · Roquetas de Mar' },
  { text: 'Veníamos de WordPress que tardaba 6 segundos. La nueva carga en menos de 1 segundo y los contactos se han triplicado.',                             author: 'Patricia R.',role: 'Gerente · Clínica dental · Mojácar' },
  { text: 'Una landing para una campaña de Google Ads. La conversión pasó del 2% al 8%. Inversión recuperada en una semana.',                                  author: 'David S.',   role: 'CEO · Empresa de reformas · Almería' },
];

const faq = [
  { q: '¿Cuánto tarda en estar lista mi web?', a: 'Depende del proyecto. Una landing: 5–7 días. Una web corporativa: 1–2 semanas. Una tienda online: 2–3 semanas. Proyectos a medida según complejidad. Siempre te damos plazo concreto antes de empezar.' },
  { q: '¿Qué es el hosting gratuito para webs estáticas?', a: 'Las webs sin base de datos (corporativas, portfolios, landings) pueden alojarse gratis en Netlify o Cloudflare Pages. Son más rápidas, más seguras y no pagas hosting mensual. Solo pagas el dominio.' },
  { q: '¿La web es mía o me ato a vosotros?', a: 'Es 100% tuya. Te entregamos el código fuente, el dominio está a tu nombre y puedes llevarte tu web cuando quieras. Sin permanencia.' },
  { q: '¿Mi web estará optimizada para Google (SEO)?', a: 'Sí. Todas incluyen SEO técnico: estructura semántica, velocidad optimizada, meta tags, schema markup, sitemap XML, robots.txt y Search Console configurado.' },
  { q: '¿Puedo gestionar el contenido yo mismo?', a: 'Por supuesto. Panel de administración intuitivo y formación. Si quieres ayuda, planes de mantenimiento desde 39€/mes con horas de cambios incluidas.' },
  { q: '¿Hacéis tiendas con pasarela de pago?', a: 'Sí. Stripe, PayPal, Redsys (tarjetas españolas), Bizum y transferencia. Todo con SSL y cumpliendo PSD2.' },
  { q: '¿Qué pasa si necesito cambios después?', a: 'Puedes hacerlos tú desde el panel, contratar un plan de mantenimiento mensual o pedir cambios puntuales bajo presupuesto. Siempre tienes soporte.' },
  { q: '¿Trabajáis solo en Almería?', a: 'Estamos especializados en empresas de Almería pero trabajamos con clientes de toda España. Lo importante es entender tu negocio, no la distancia.' },
];

const jsonLdSchemas = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Diseño Web","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Diseño Web en Almería","description":"Agencia de diseño web y desarrollo profesional en Almería.","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","address":{"@type":"PostalAddress","addressLocality":"Almería","addressRegion":"Andalucía","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":36.834,"longitude":-2.4637},"areaServed":{"@type":"State","name":"Almería"},"priceRange":"€€","openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"19:00"},"hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios de Diseño y Desarrollo Web","itemListElement":services.map(s=>({"@type":"Offer","itemOffered":{"@type":"Service","name":s.title,"description":s.desc}}))} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo creamos tu página web profesional","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-desarrollo-web-calidad.jpg"
  imageAlt="Desarrollo web profesional en Almería - Platanito Rico"
  type="service"
  keywords="diseño web almería, desarrollo web almería, tienda online almería, web corporativa, hosting gratuito"
  jsonLd={jsonLdSchemas}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Diseño Web' }]} />

  <main id="main-content">
    {/* HERO editorial */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 010 — Servicio · Diseño Web</span>
          <span class="text-meta"><span class="live-dot"></span> 2 semanas a producción</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Cap. 01 / Desarrollo Web</span>
            <h1 class="svc-hero__title heading-display">
              Tu web tiene que hacer
              <em class="heading-editorial">una cosa:</em>
              <span class="text-stroke-ink">venderte.</span>
            </h1>
            <p class="svc-hero__lead">
              Webs ultrarrápidas, optimizadas para Google y diseñadas para convertir
              visitantes en clientes. <strong>Hosting gratuito para webs estáticas</strong>
              y sin permanencia. Desde landings hasta tiendas online y aplicaciones a medida.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">
                Pedir presupuesto gratis →
              </a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">
                657 085 019
              </a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">50<sup>+</sup></span>
              <span class="svc-hero__spec-lbl">Webs entregadas</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">&lt;1s</span>
              <span class="svc-hero__spec-lbl">Tiempo de carga</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">99/100</span>
              <span class="svc-hero__spec-lbl">Lighthouse</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">0€</span>
              <span class="svc-hero__spec-lbl">Hosting web estática</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 8}).map(() => (
            <span>★ ASTRO ★ NEXT.JS ★ SHOPIFY ★ WORDPRESS ★ PRESTASHOP ★ HEADLESS ★</span>
          ))}
        </div>
      </div>
    </section>

    {/* SERVICIOS — bento brutal */}
    <section class="section-brutal" id="servicios">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Qué creamos</span>
            <h2 class="heading-display brutal-section-head__title">
              Webs que no solo son
              <em class="heading-editorial">bonitas.</em> Venden.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro tipos de proyecto. Cada uno diseñado para un objetivo concreto:
            captar leads, transmitir profesionalidad, vender online o resolver
            problemas operativos.
          </p>
        </header>

        <ol class="svc-bento">
          {services.map((s, i) => (
            <li class={`svc-card svc-card--${s.accent} svc-card--idx-${i}`}>
              <header class="svc-card__head">
                <span class="svc-card__num">{s.n}</span>
                <span class="svc-card__kicker">{s.kicker}</span>
              </header>
              <h3 class="svc-card__title heading-display">{s.title}</h3>
              <p class="svc-card__desc">{s.desc}</p>
              <ul class="svc-card__features">
                {s.features.map((f) => (
                  <li class="svc-card__feat">
                    <span class="svc-card__feat-mark">+</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <footer class="svc-card__foot">
                <div class="svc-card__figure">
                  <span class="svc-card__figure-val text-mono">{s.figure}</span>
                  <span class="svc-card__figure-lbl">{s.figureLabel}</span>
                </div>
                <a href="/contacto" class="svc-card__cta">
                  Pedir presupuesto →
                </a>
              </footer>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* HOSTING comparison */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Hosting incluido</span>
            <h2 class="heading-display brutal-section-head__title">
              Hosting
              <em class="heading-editorial">gratuito</em>
              de por vida.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Si tu web no necesita base de datos (corporativa, portfolio, landing),
            la alojamos gratis en Netlify o Cloudflare Pages. Más rápida, más segura
            y sin cuota mensual.
          </p>
        </header>

        <div class="svc-compare">
          <header class="svc-compare__head">
            <span class="svc-compare__h-asp text-meta">Aspecto</span>
            <span class="svc-compare__h-bad text-meta">Hosting tradicional</span>
            <span class="svc-compare__h-good text-meta">★ Web estática gratis</span>
          </header>
          {hostingCompare.map((row) => (
            <div class="svc-compare__row">
              <span class="svc-compare__aspect">{row.aspect}</span>
              <span class="svc-compare__bad text-mono">× {row.traditional}</span>
              <span class="svc-compare__good text-mono">✓ {row.static}</span>
            </div>
          ))}
        </div>

        <p class="svc-compare__note text-mono">
          * El hosting gratuito aplica a webs estáticas sin base de datos. Para tiendas
          online y CMS, los <a href="#mantenimiento" class="link-brutal">planes de mantenimiento</a> arrancan en 39€/mes.
        </p>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Método</span>
            <h2 class="heading-display brutal-section-head__title">
              De la idea a tu web
              <em class="heading-editorial">en 2 semanas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Sin sorpresas, sin retrasos. Cada fase tiene un entregable claro y un
            responsable. Tú decides en cada paso.
          </p>
        </header>

        <ol class="svc-process">
          {process.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < process.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="heading-display svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* SECTORES */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Sectores</span>
            <h2 class="heading-display brutal-section-head__title">
              Webs diseñadas para
              <em class="heading-editorial">tu sector.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            No hacemos la misma web para todos. Cada sector tiene su público,
            sus necesidades y su forma de vender online.
          </p>
        </header>

        <ul class="svc-sectors">
          {sectors.map((s, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
              <h3 class="heading-display svc-sector__title">{s.title}</h3>
              <p class="svc-sector__desc">{s.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* MANTENIMIENTO */}
    <section class="section-brutal" id="mantenimiento">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 06 / Mantenimiento</span>
            <h2 class="heading-display brutal-section-head__title">
              Planes mensuales
              <em class="heading-editorial">sin permanencia.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Tu web siempre actualizada, segura y optimizada. Especialistas en
            WordPress, PrestaShop y WooCommerce.
          </p>
        </header>

        <ol class="svc-plans">
          {plans.map((p, i) => (
            <li class={`svc-plan ${p.popular ? 'svc-plan--popular' : ''}`}>
              <header class="svc-plan__head">
                <span class="text-meta">Plan {String(i + 1).padStart(2, '0')}</span>
                {p.popular && <span class="badge-brutal badge-brutal--lime">★ {p.badge}</span>}
                {!p.popular && <span class="text-meta">{p.badge}</span>}
              </header>
              <h3 class="heading-display svc-plan__name">{p.name}</h3>
              <p class="svc-plan__desc">{p.desc}</p>
              <div class="svc-plan__price">
                <span class="svc-plan__price-num text-mono">{p.price}</span>
                <span class="svc-plan__price-sub">+ IVA · por {p.period}</span>
              </div>
              <ul class="svc-plan__features">
                {p.features.map((f) => (
                  <li class="svc-plan__feat"><span class="svc-plan__mark">✓</span> {f}</li>
                ))}
              </ul>
              <a href="/contacto" class={`btn-brutal ${p.popular ? '' : 'btn-brutal--ghost'} svc-plan__cta`}>
                Contratar →
              </a>
            </li>
          ))}
        </ol>

        <div class="svc-plans-foot">
          <a href="/soporte/" class="link-brutal text-mono" style="text-transform:uppercase;letter-spacing:.15em;font-size:.78rem;">
            Ver todos los detalles de mantenimiento →
          </a>
        </div>
      </div>
    </section>

    {/* TESTIMONIOS pull quote */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 07 / Testimonios</span>
            <h2 class="heading-display brutal-section-head__title">
              Webs reales,
              <em class="heading-editorial">resultados reales.</em>
            </h2>
          </div>
        </header>

        <figure class="svc-pull">
          <div class="svc-pull__marks" aria-hidden="true">“</div>
          <blockquote class="svc-pull__quote heading-editorial">{testimonials[0].text}</blockquote>
          <figcaption class="svc-pull__cap">
            <span class="svc-pull__avatar">{testimonials[0].author[0]}</span>
            <div>
              <span class="svc-pull__name">{testimonials[0].author}</span>
              <span class="svc-pull__role text-mono">{testimonials[0].role}</span>
            </div>
          </figcaption>
        </figure>

        <ul class="svc-quotes">
          {testimonials.slice(1).map((t, i) => (
            <li class={`svc-quote svc-quote--${i}`}>
              <p>"{t.text}"</p>
              <footer>
                <span class="svc-quote__avatar">{t.author[0]}</span>
                <div>
                  <span class="svc-quote__name">{t.author}</span>
                  <span class="svc-quote__role text-mono">{t.role}</span>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* FAQ */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 08 / Preguntas frecuentes</span>
            <h2 class="heading-display brutal-section-head__title">
              Resolvemos
              <em class="heading-editorial">tus dudas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Lo que más nos preguntan antes de empezar. Si no está aquí, escríbenos
            y respondemos en menos de 24h.
          </p>
        </header>

        <ol class="svc-faq">
          {faq.map((f, i) => (
            <li class="svc-faq__item">
              <details class="svc-faq__details" open={i === 0}>
                <summary class="svc-faq__sum">
                  <span class="svc-faq__num text-mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-faq__q heading-display">{f.q}</span>
                  <span class="svc-faq__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-faq__answer"><p>{f.a}</p></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* COBERTURA */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);" id="zonas">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 09 / Cobertura</span>
            <h2 class="heading-display brutal-section-head__title">
              Diseño web en
              <em class="heading-editorial">toda Almería.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Trabajamos por comarcas. Encuentra tu localidad y descubre cómo
            posicionarte en el mercado local.
          </p>
        </header>

        <div class="svc-comarcas">
          {comarcas.map(comarca => {
            const pueblos = getPueblosByComarca(comarca);
            if (pueblos.length === 0) return null;
            return (
              <details class="svc-comarca" name="comarca">
                <summary class="svc-comarca__sum">
                  <span class="svc-comarca__name heading-display">{comarca}</span>
                  <span class="svc-comarca__count text-mono">{pueblos.length} localidades</span>
                  <span class="svc-comarca__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-comarca__items">
                  {pueblos.map(p => (
                    <a href={`/diseno-web/${p.slug}`} class="tag-brutal svc-comarca__chip">{p.nombre}</a>
                  ))}
                </div>
              </details>
            );
          })}
        </div>
      </div>
    </section>

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="heading-display svc-final__title">
            Tu próxima web empieza con una
            <em class="heading-editorial">conversación.</em>
          </h2>
          <p class="svc-final__text">
            Cuéntanos qué necesitas y te proponemos la solución más eficiente.
            Sin compromiso. Sin letra pequeña. Hosting gratuito para webs estáticas.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir presupuesto gratis →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

