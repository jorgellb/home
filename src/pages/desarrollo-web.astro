  .dw-service__figure { display:flex; flex-direction:column; line-height:1; }
  .dw-service__fig-val { font-family:var(--font-mono); font-size:1.6rem; font-weight:800; color:var(--c-tinta); }
  .dw-service__fig-lbl { font-family:var(--font-mono); font-size:.58rem; text-transform:uppercase; letter-spacing:.15em; color:var(--brutal-text-muted); margin-top:.35rem; }
  .dw-service__cta {
    font-family:var(--font-mono);
    font-size:.7rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.14em;
    color:var(--c-tinta);
    text-decoration:none;
    border-bottom:2px solid var(--c-s, var(--c-blue));
    padding-bottom:.15em;
  }

  /* ═══════════════ STACK ═══════════════ */
  .dw-stack {
    list-style:none; padding:0; margin:0;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:1rem;
  }
  @media (min-width: 640px) { .dw-stack { grid-template-columns:repeat(3, 1fr); } }
  @media (min-width: 1024px) { .dw-stack { grid-template-columns:repeat(4, 1fr); } }

  .dw-stack__item {
    background:var(--c-panel);
    color:var(--c-tinta);
    border:3px solid var(--c-regla2);
    padding:1.25rem 1.25rem 1.5rem;
    display:flex;
    flex-direction:column;
    gap:.35rem;
    position:relative;
    box-shadow:4px 4px 0 var(--c-st, var(--c-orange));
    transition:transform .25s, box-shadow .25s;
  }
  .dw-stack__item:hover { transform:translate(-3px,-3px); box-shadow:7px 7px 0 var(--c-st, var(--c-orange)); }
  .dw-stack__item--orange  { --c-st:var(--c-orange); }
  .dw-stack__item--ink     { --c-st:var(--c-tinta); background:var(--c-hondo); color:var(--c-tinta); border-color:var(--c-regla2); box-shadow:4px 4px 0 var(--c-green); }
  .dw-stack__item--ink:hover { box-shadow:7px 7px 0 var(--c-green); }
  .dw-stack__item--blue    { --c-st:var(--c-blue); }
  .dw-stack__item--cyan    { --c-st:var(--c-cyan); }
  .dw-stack__item--lime    { --c-st:var(--c-lime); }

  .dw-stack__sticker {
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding-bottom:.65rem;
    border-bottom:1.5px solid currentColor;
    opacity:.85;
  }
  .dw-stack__cat { font-family:var(--font-mono); font-size:.55rem; text-transform:uppercase; letter-spacing:.14em; font-weight:700; }
  .dw-stack__v {
    font-family:var(--font-mono);
    font-size:.65rem;
    font-weight:800;
    padding:.1rem .35rem;
    background:var(--c-st, var(--c-orange));
    color:var(--c-suelo);
  }
  .dw-stack__item--ink .dw-stack__v { background:var(--c-green); color: var(--c-suelo); }
  .dw-stack__item--lime .dw-stack__v { background:var(--c-hondo); color:var(--c-lime); }
  .dw-stack__name {
    font-family:var(--font-display);
    font-weight:800;
    font-size:1.5rem;
    letter-spacing:-.025em;
    margin:.5rem 0 .15rem;
    color:var(--c-st, var(--c-orange));
  }
  .dw-stack__item--ink .dw-stack__name { color:var(--c-green); }
  .dw-stack__item--lime .dw-stack__name { color:var(--c-tinta); }
  .dw-stack__desc { font-family:var(--font-mono); font-size:.68rem; line-height:1.4; opacity:.8; margin:0; }

  /* ═══════════════ VS ─ HOSTING ═══════════════ */
  .dw-vs-wrap {
    padding:clamp(4rem, 8vw, 7rem) 0;
    background:var(--c-panel);
    border-block:3px solid var(--c-regla2);
  }
  .dw-vs {
    background:var(--c-suelo);
    border:3px solid var(--c-regla2);
    padding:1.5rem;
    box-shadow:10px 10px 0 var(--c-magenta);
  }
  .dw-vs__head {
    display:grid;
    grid-template-columns:1fr auto 1fr;
    gap:1rem;
    align-items:center;
    padding-bottom:1rem;
    border-bottom:3px solid var(--c-regla2);
    margin-bottom:1rem;
  }
  .dw-vs__col { display:flex; justify-content:center; }
  .dw-vs__badge {
    padding:.5rem .85rem;
    border:2px solid var(--c-regla2);
    font-family:var(--font-mono);
    font-size:.7rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.12em;
    box-shadow:3px 3px 0 var(--c-regla2);
  }
  .dw-vs__badge--bad { background:var(--c-hondo); color:var(--c-tinta); }
  .dw-vs__badge--good { background:var(--c-green); color:var(--c-suelo); box-shadow:3px 3px 0 var(--c-regla2); }

  .dw-vs__rows { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; }
  .dw-vs__row {
    display:grid;
    grid-template-columns:1fr;
    gap:.5rem;
    padding:1rem 0;
    border-bottom:1px dashed var(--brutal-border-soft);
  }
  @media (min-width: 768px) {
    .dw-vs__row { grid-template-columns:1fr 1fr 1fr; gap:1.5rem; align-items:center; }
  }
  .dw-vs__row:last-child { border-bottom:0; }
  .dw-vs__aspect {
    font-family:var(--font-display);
    font-weight:800;
    font-size:1rem;
    letter-spacing:-.015em;
    color:var(--c-tinta);
  }
  .dw-vs__cell { display:flex; flex-direction:column; gap:.35rem; }
  .dw-vs__bar {
    position:relative;
    height:22px;
    background:var(--c-panel);
    border:2px solid var(--c-regla2);
    display:flex;
    align-items:center;
    padding-right:.4rem;
    justify-content:flex-end;
  }
  .dw-vs__bar-fill {
    position:absolute;
    inset:0;
    height:100%;
    transition:width .6s;
    z-index:0;
  }
  .dw-vs__bar--bad .dw-vs__bar-fill { background:linear-gradient(90deg, #FF6B6B 0%, #FFA07A 100%); }
  .dw-vs__bar--good .dw-vs__bar-fill { background:linear-gradient(90deg, var(--c-green) 0%, var(--c-lime) 100%); color: var(--c-suelo); }
  .dw-vs__bar-num {
    position:relative;
    z-index:1;
    font-family:var(--font-mono);
    font-size:.72rem;
    font-weight:800;
    color:var(--c-tinta);
    background:var(--c-panel);
    padding:0 .35rem;
    border:1.5px solid var(--c-regla2);
  }
  .dw-vs__hint {
    font-family:var(--font-mono);
    font-size:.68rem;
    color:var(--brutal-text-muted);
    text-transform:uppercase;
    letter-spacing:.08em;
  }
  .dw-vs__cell--good .dw-vs__hint { color:var(--c-tinta); }
  .dw-vs__note {
    margin-top:1.5rem;
    padding:.85rem 1.25rem;
    background:var(--c-yellow);
    border:2px solid var(--c-regla2);
    font-family:var(--font-mono);
    font-size:.72rem;
    text-transform:uppercase;
    letter-spacing:.1em;
    color:var(--c-suelo);
  }
  .dw-vs__note a { color:inherit; border-bottom:2px solid currentColor; }

  /* ═══════════════ GIT LOG / PROCESS ═══════════════ */
  .dw-gitlog {
    list-style:none; padding:0; margin:0;
    border:3px solid var(--c-regla2);
    background:var(--c-hondo);
    overflow:hidden;
  }
  .dw-commit {
    display:grid;
    grid-template-columns:36px 1fr;
    gap:1.25rem;
    padding:1.75rem 1.5rem;
    background:var(--c-panel);
    border-bottom:2px solid var(--c-regla2);
    position:relative;
    transition:background .25s;
  }
  .dw-commit:last-child { border-bottom:0; }
  .dw-commit:hover { background:var(--c-suelo); }
  @media (min-width: 768px) {
    .dw-commit { grid-template-columns:40px 130px 1fr 280px; gap:1.5rem; align-items:start; }
  }
  .dw-commit__rail {
    display:flex; flex-direction:column; align-items:center;
    padding-top:6px;
  }
  .dw-commit__node {
    width:16px; height:16px;
    border-radius:50%;
    background:var(--c-c, var(--c-magenta));
    border:3px solid var(--c-regla2);
    flex-shrink:0;
    z-index:1;
  }
  .dw-commit__line {
    flex:1;
    width:2px;
    background:var(--c-c, var(--c-magenta));
    min-height:80px;
    margin-top:4px;
  }
  .dw-commit--magenta { --c-c:var(--c-magenta); }
  .dw-commit--cyan    { --c-c:var(--c-cyan); }
  .dw-commit--orange  { --c-c:var(--c-orange); }
  .dw-commit--lime    { --c-c:var(--c-lime); }

  .dw-commit__hash { display:flex; flex-direction:column; gap:.25rem; }
  .dw-commit__num { font-family:var(--font-mono); font-size:1.65rem; font-weight:800; color:var(--c-tinta); line-height:1; }
  .dw-commit__eta { font-family:var(--font-mono); font-size:.62rem; text-transform:uppercase; letter-spacing:.15em; color:var(--c-c, var(--c-magenta)); font-weight:800; }

  .dw-commit__body { grid-column:2 / -1; }
  @media (min-width: 768px) { .dw-commit__body { grid-column:auto; } }
  .dw-commit__msg {
    display:inline-block;
    background:var(--c-hondo);
    color:var(--c-green);
    padding:.25rem .6rem;
    font-family:var(--font-mono);
    font-size:.72rem;
    font-weight:700;
    margin-bottom:.65rem;
    border-radius:2px;
  }
  .dw-commit__title { font-family:var(--font-display); font-weight:800; font-size:1.4rem; letter-spacing:-.025em; margin:0 0 .5rem; color:var(--c-tinta); line-height:1; }
  .dw-commit__desc { font-size:.95rem; line-height:1.55; color:var(--brutal-text-secondary); margin:0; max-width:54ch; }

  .dw-commit__deliv {
    background:var(--c-c, var(--c-magenta));
    color:var(--c-suelo);
    padding:.65rem .85rem;
    font-family:var(--font-mono);
    font-size:.78rem;
    border:2px solid var(--c-regla2);
    display:flex;
    align-items:center;
    gap:.5rem;
    align-self:start;
    grid-column:2 / -1;
    margin-top:.75rem;
  }
  @media (min-width: 768px) { .dw-commit__deliv { grid-column:auto; margin-top:0; } }

  /* ═══════════════ SECTORS ═══════════════ */
  .dw-sectors {
    list-style:none; padding:0; margin:0;
    display:grid;
    grid-template-columns:1fr;
    gap:0;
    border:3px solid var(--c-regla2);
    background:var(--c-hondo);
  }
  @media (min-width: 640px) { .dw-sectors { grid-template-columns:1fr 1fr; gap:3px; } }
  @media (min-width: 1024px) { .dw-sectors { grid-template-columns:repeat(3, 1fr); } }
  .dw-sector {
    padding:2rem 1.75rem;
    background:var(--c-panel);
    color:var(--c-tinta);
    display:flex; flex-direction:column; gap:.5rem;
    transition:background .25s, color .25s, padding .25s;
  }
  .dw-sector:hover { padding-block:2.25rem; }
  .dw-sector--blue:hover    { background:var(--c-blue); color:var(--c-suelo); }
  .dw-sector--magenta:hover { background:var(--c-magenta); color:var(--c-suelo); }
  .dw-sector--cyan:hover    { background:var(--c-cyan); color:var(--c-suelo); }
  .dw-sector--lime:hover    { background:var(--c-lime); color: var(--c-suelo); }
  .dw-sector--orange:hover  { background:var(--c-orange); color:var(--c-suelo); }
  .dw-sector--purple:hover  { background:var(--c-purple); color:var(--c-suelo); }
  .dw-sector__num { font-family:var(--font-mono); font-size:.62rem; text-transform:uppercase; letter-spacing:.15em; color:var(--c-purple); font-weight:700; }
  .dw-sector:hover .dw-sector__num { color:inherit; }
  .dw-sector__title { font-family:var(--font-display); font-weight:800; font-size:1.35rem; letter-spacing:-.02em; margin:.25rem 0; color:inherit; }
  .dw-sector__desc { font-size:.88rem; line-height:1.5; color:inherit; margin:0; }

  /* ═══════════════ PLANES ═══════════════ */
  .dw-plans {
    list-style:none; padding:0; margin:0;
    display:grid; gap:1.5rem;
    grid-template-columns:1fr;
  }
  @media (min-width: 768px) { .dw-plans { grid-template-columns:repeat(3, 1fr); } }
  .dw-plan {
    background:var(--c-panel);
    border:3px solid var(--c-regla2);
    padding:1.75rem;
    display:flex; flex-direction:column; gap:1rem;
    box-shadow:6px 6px 0 var(--c-regla2);
    transition:transform .25s, box-shadow .25s;
  }
  .dw-plan:hover { transform:translate(-3px,-3px); box-shadow:9px 9px 0 var(--c-regla2); }
  .dw-plan--popular { background:var(--c-hondo); color:var(--c-tinta); box-shadow:8px 8px 0 var(--c-green); }
  .dw-plan--popular:hover { box-shadow:12px 12px 0 var(--c-green); }

  .dw-plan__head { display:flex; justify-content:space-between; align-items:center; padding-bottom:.65rem; border-bottom:1px solid currentColor; }
  .dw-plan__tag { font-family:var(--font-mono); font-size:.62rem; text-transform:uppercase; letter-spacing:.14em; opacity:.7; }
  .dw-plan__sub { font-family:var(--font-mono); font-size:.62rem; text-transform:uppercase; letter-spacing:.14em; color:var(--brutal-text-muted); }
  .dw-plan__badge {
    background:var(--c-green);
    color:var(--c-suelo);
    padding:.15rem .5rem;
    font-family:var(--font-mono);
    font-size:.62rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.12em;
    border:1.5px solid var(--c-regla2);
  }
  .dw-plan__name {
    font-family:var(--font-display);
    font-weight:800;
    font-size:1.5rem;
    letter-spacing:-.025em;
    color:inherit;
    margin:0;
  }
  .dw-plan__desc { font-size:.88rem; line-height:1.5; color:var(--brutal-text-secondary); margin:0; }
  .dw-plan--popular .dw-plan__desc { color:rgba(255,252,246,.85); }
  .dw-plan__price { padding:1rem 0; border-block:2px solid currentColor; display:flex; flex-direction:column; gap:.25rem; }
  .dw-plan__price-num { font-family:var(--font-mono); font-size:2.75rem; line-height:1; font-weight:800; color:var(--c-tinta); letter-spacing:-.03em; }
  .dw-plan--popular .dw-plan__price-num { color:var(--c-green); }
  .dw-plan__price-sub { font-family:var(--font-mono); font-size:.65rem; text-transform:uppercase; letter-spacing:.14em; color:var(--brutal-text-muted); }
  .dw-plan--popular .dw-plan__price-sub { color:rgba(255,252,246,.7); }
  .dw-plan__features { list-style:none; padding:0; margin:0; flex:1; display:flex; flex-direction:column; gap:.55rem; }
  .dw-plan__features li { font-family:var(--font-mono); font-size:.82rem; line-height:1.4; display:flex; gap:.55rem; align-items:baseline; }
  .dw-plan__features li span { color:var(--c-green); font-weight:800; }
  .dw-plan :global(.dw-plan__cta) { width:100%; }

  /* ═══════════════ PULL & QUOTES ═══════════════ */
  .dw-pull {
    position:relative;
    background:var(--c-hondo);
    color:var(--c-tinta);
    padding:clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    border:3px solid var(--c-regla2);
    box-shadow:12px 12px 0 var(--c-purple);
    margin:0 0 3rem;
  }
  .dw-pull__mark { position:absolute; top:-1rem; left:1.5rem; font-family:var(--font-editorial); font-size:clamp(8rem, 14vw, 13rem); line-height:1; color:var(--c-purple); font-style:italic; user-select:none; }
  .dw-pull__q { font-family:var(--font-editorial); font-style:italic; font-weight:400; font-size:clamp(1.5rem, 3.4vw, 2.75rem); line-height:1.2; color:var(--c-tinta); max-width:36ch; margin:0; position:relative; z-index:1; }
  .dw-pull__cap { margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid var(--c-regla2); display:flex; align-items:center; gap:1rem; flex-wrap:wrap; }
  .dw-pull__avatar { width:54px; height:54px; display:inline-flex; align-items:center; justify-content:center; background:var(--c-green); color:var(--c-suelo); font-family:var(--font-display); font-weight:800; font-size:1.5rem; border:2px solid var(--c-regla2); }
  .dw-pull__name { display:block; font-family:var(--font-display); font-weight:800; font-size:1.1rem; color:var(--c-tinta); }
  .dw-pull__role { display:block; font-family:var(--font-mono); font-size:.7rem; text-transform:uppercase; letter-spacing:.15em; color:rgba(255,252,246,.7); margin-top:.25rem; }
  .dw-pull__metric { margin-left:auto; text-align:right; padding-left:1rem; border-left:2px solid var(--c-regla2); }
  .dw-pull__metric-v { font-family:var(--font-mono); font-weight:800; font-size:2.5rem; color:var(--c-green); display:block; line-height:1; }
  .dw-pull__metric-l { font-family:var(--font-mono); font-size:.62rem; text-transform:uppercase; letter-spacing:.14em; color:rgba(255,252,246,.7); display:block; margin-top:.25rem; }

  .dw-quotes { list-style:none; padding:0; margin:0; display:grid; gap:1rem; grid-template-columns:1fr; }
  @media (min-width: 768px) { .dw-quotes { grid-template-columns:repeat(3, 1fr); } }
  .dw-quote {
    background:var(--c-panel);
    border:3px solid var(--c-regla2);
    padding:1.5rem;
    display:flex; flex-direction:column; gap:1rem;
    box-shadow:5px 5px 0 var(--c-q, var(--c-blue));
    transition:transform .25s, box-shadow .25s;
  }
  .dw-quote:hover { transform:translate(-3px,-3px); box-shadow:8px 8px 0 var(--c-q, var(--c-blue)); }
  .dw-quote--cyan    { --c-q:var(--c-cyan); }
  .dw-quote--lime    { --c-q:var(--c-lime); }
  .dw-quote--magenta { --c-q:var(--c-magenta); }
  .dw-quote p { font-family:var(--font-editorial); font-style:italic; font-size:1rem; line-height:1.4; color:var(--c-tinta); margin:0; flex:1; }
  .dw-quote footer { display:flex; gap:.75rem; align-items:center; padding-top:1rem; border-top:1px solid var(--brutal-border-soft); }
  .dw-quote__avatar { width:38px; height:38px; display:inline-flex; align-items:center; justify-content:center; background:var(--c-hondo); color:var(--c-green); font-family:var(--font-display); font-weight:800; font-size:1rem; border:2px solid var(--c-regla2); flex-shrink:0; }
  .dw-quote__name { display:block; font-family:var(--font-display); font-weight:800; font-size:.95rem; color:var(--c-tinta); }
  .dw-quote__role { display:block; font-family:var(--font-mono); font-size:.58rem; text-transform:uppercase; letter-spacing:.12em; color:var(--brutal-text-muted); margin-top:.2rem; }

  /* ═══════════════ FAQ TERMINAL ═══════════════ */
  .dw-faq { list-style:none; padding:0; margin:2rem 0 0; border-top:2px solid var(--c-regla2); }
  .dw-faq__item { border-bottom:1px solid rgba(255,252,246,.2); }
  .dw-faq__item details { padding:1.25rem 0; }
  .dw-faq__item summary { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:1.25rem; cursor:pointer; list-style:none; }
  .dw-faq__item summary::-webkit-details-marker { display:none; }
  .dw-faq__num { font-family:var(--font-mono); font-size:1rem; font-weight:800; color:var(--c-green); }
  .dw-faq__q { font-family:var(--font-display); font-weight:800; font-size:clamp(1.05rem, 1.6vw, 1.3rem); line-height:1.2; letter-spacing:-.025em; color:var(--c-tinta); margin:0; }
  .dw-faq__toggle {
    width:36px; height:36px;
    display:inline-flex; align-items:center; justify-content:center;
    background:rgba(0,255,148,.1);
    color:var(--c-green);
    border:2px solid var(--c-green);
    font-family:var(--font-mono); font-size:1.2rem; font-weight:700;
    transition:transform .25s, background .15s;
  }
  details[open] .dw-faq__toggle { background:var(--c-green); color:var(--c-suelo); transform:rotate(45deg); }
  .dw-faq__a { padding:1.25rem 0 .5rem 3rem; border-top:1px dashed rgba(255,252,246,.2); margin-top:1rem; }
  .dw-faq__a p { font-size:.95rem; line-height:1.6; color:rgba(255,252,246,.85); margin:0; max-width:60ch; }

  /* ═══════════════ FINAL CTA ═══════════════ */
  .dw-final {
    position:relative;
    background:var(--c-hondo);
    color:var(--c-tinta);
    padding:clamp(4rem, 9vw, 7rem) 0;
    border-top:3px solid var(--c-regla2);
    overflow:hidden;
  }
  .dw-final__grid-bg {
    position:absolute;
    inset:0;
    background-image:linear-gradient(rgba(0,255,148,0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,255,148,0.1) 1px, transparent 1px);
    background-size:40px 40px;
    pointer-events:none;
  }
  .dw-final > .container-brutal { position:relative; z-index:1; }
  .dw-final__inner { max-width:780px; }
  .dw-final__title {
    font-family:var(--font-display);
    font-weight:800;
    font-size:clamp(2.5rem, 7vw, 5rem);
    line-height:.9;
    letter-spacing:-.04em;
    margin:.5rem 0 1rem;
    color:var(--c-tinta);
