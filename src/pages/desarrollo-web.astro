---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { comarcas, getPueblosByComarca } from '../data/pueblos-almeria';

const title = 'Diseño Web en Almería | Desarrollo Web Profesional y Tiendas Online';
const description = 'Desarrollo web profesional en Almería. Webs corporativas, tiendas online y e-commerce ultrarrápidos. Hosting gratuito, sin permanencia. Presupuesto gratis.';
const canonical = 'https://platanitorico.com/desarrollo-web/';

// ── Servicios de desarrollo web (SIN PRECIOS) ──
const services = [
  {
    title: 'Landing Page de Alta Conversión',
    desc: 'Página única diseñada para un objetivo: que el visitante contacte, compre o reserve. Estructura de copywriting persuasivo, carga ultrarrápida y formulario optimizado.',
    icon: 'rocket',
    features: ['Diseño orientado a conversión', 'Copywriting profesional incluido', 'Formulario optimizado con validación', 'Velocidad de carga <1 segundo', 'SEO on-page configurado', 'Versión móvil pixel-perfect'],
    result: 'Ideal para campañas publicitarias, lanzamientos y captación de leads'
  },
  {
    title: 'Web Corporativa Premium',
    desc: 'Tu empresa merece una presencia digital que transmita profesionalidad y genere confianza. Múltiples secciones, blog integrado y preparada para escalar.',
    icon: 'building',
    features: ['De 5 a 15 páginas según necesidades', 'Blog integrado con SEO', 'Google Analytics y Search Console', 'Hosting gratuito para webs estáticas', 'Panel de administración intuitivo', 'Certificado SSL incluido'],
    result: 'Para empresas que quieren transmitir profesionalidad y captar clientes online'
  },
  {
    title: 'Tienda Online / E-commerce',
    desc: 'Vende 24/7 con una tienda online optimizada para convertir. Catálogo, carrito, pasarela de pago y gestión de pedidos todo integrado.',
    icon: 'cart',
    features: ['Catálogo de productos ilimitado', 'Pasarela de pago segura (Stripe, PayPal, Redsys)', 'Gestión de stock e inventario', 'Envíos automatizados', 'SEO para productos y categorías', 'Panel de gestión fácil de usar'],
    result: 'Para negocios que quieren vender online sin límites geográficos'
  },
  {
    title: 'Web App a Medida',
    desc: 'Soluciones digitales complejas: intranets, paneles de gestión, portales de noticias o cualquier sistema que necesite tu negocio.',
    icon: 'code',
    features: ['Arquitectura a medida según requisitos', 'Base de datos y API propias', 'Panel de administración personalizado', 'Integraciones con terceros (CRM, ERP)', 'Seguridad avanzada y roles de usuario', 'Escalable y mantenible a largo plazo'],
    result: 'Para proyectos que necesitan funcionalidades específicas que no existen en soluciones estándar'
  }
];

// ── Proceso de trabajo ──
const process = [
  {
    step: '01',
    title: 'Análisis y estrategia',
    desc: 'Estudiamos tu negocio, competencia y objetivos. Definimos la estructura, funcionalidades y tecnología ideal para tu proyecto.',
    duration: '2-3 días'
  },
  {
    step: '02',
    title: 'Diseño y prototipo',
    desc: 'Creamos el diseño visual y la experiencia de usuario. Lo validamos contigo antes de programar una sola línea de código.',
    duration: '3-5 días'
  },
  {
    step: '03',
    title: 'Desarrollo y testing',
    desc: 'Programamos con las últimas tecnologías. Testamos en todos los dispositivos y navegadores para garantizar un funcionamiento perfecto.',
    duration: '5-10 días'
  },
  {
    step: '04',
    title: 'Lanzamiento y formación',
    desc: 'Publicamos tu web, configuramos el SEO inicial y te formamos para que puedas gestionar el contenido de forma autónoma.',
    duration: '1-2 días'
  }
];

// ── Planes de mantenimiento (sincronizados con /soporte/) ──
const maintenancePlans = [
  {
    name: 'Mantenimiento Básico',
    price: '39€',
    period: 'mes',
    description: 'Ideal para webs corporativas, blogs y sitios informativos que necesitan mantenimiento esencial.',
    features: [
      'Alojamiento web + correo profesional',
      'Actualizaciones de seguridad',
      'Copias de seguridad diarias',
      'Certificado SSL gratuito',
      '5 horas de cambios incluidas/mes',
      'Soporte por email (48h)',
      'Monitorización 24/7'
    ],
    popular: false,
    badge: 'Para empezar'
  },
  {
    name: 'Mantenimiento Profesional',
    price: '79€',
    period: 'mes',
    description: 'Para empresas que dependen de su web y necesitan gestión continua con cambios mensuales.',
    features: [
      'Alojamiento web + correo profesional',
      '20 horas de cambios incluidas/mes',
      'Optimización Core Web Vitals',
      'Auditoría SEO técnica mensual',
      'Soporte telefónico L-V',
      'Recuperación garantizada <48h',
      'Informe mensual de rendimiento'
    ],
    popular: true,
    badge: 'Más contratado'
  },
  {
    name: 'Mantenimiento Tienda Online',
    price: '149€',
    period: 'mes',
    description: 'Máxima protección para tiendas online PrestaShop y WooCommerce con prioridad absoluta.',
    features: [
      'Todo del plan Profesional',
      'Alojamiento optimizado e-commerce',
      'Minitareas ilimitadas (hasta 15 min)',
      'Gestión de catálogo incluida',
      'Soporte prioritario 24/7',
      'Recuperación garantizada <24h',
      'Protección RGPD avanzada'
    ],
    popular: false,
    badge: 'Para e-commerce'
  }
];

// ── Sectores ──
const sectors = [
  { title: 'Hostelería y turismo', desc: 'Webs para restaurantes, hoteles y casas rurales que generan reservas directas sin intermediarios.', icon: 'hotel' },
  { title: 'Inmobiliarias', desc: 'Portales inmobiliarios con fichas de propiedades, filtros avanzados y captación de compradores.', icon: 'building' },
  { title: 'E-commerce', desc: 'Tiendas online que convierten: catálogo optimizado, checkout fluido y SEO para productos.', icon: 'cart' },
  { title: 'Servicios profesionales', desc: 'Webs para abogados, clínicas, consultorías que transmiten confianza y captan clientes.', icon: 'briefcase' },
  { title: 'Construcción y reformas', desc: 'Portfolios visuales con galería de proyectos que generan presupuestos de calidad.', icon: 'hammer' },
  { title: 'Agricultura y exportación', desc: 'Webs multiidioma para cooperativas y productores que quieren abrir mercados internacionales.', icon: 'leaf' }
];

// ── Testimonios ──
const testimonials = [
  {
    text: 'Nos hicieron la web corporativa en 10 días. Es rapidísima, aparecemos los primeros en Google para nuestro sector y el hosting es gratuito. No podíamos pedir más.',
    author: 'Laura G.',
    role: 'Directora, estudio de arquitectura en Almería',
    rating: 5
  },
  {
    text: 'La tienda online que nos montaron funciona perfecta. El panel de gestión es facilísimo y las ventas online ya suponen el 30% de nuestra facturación.',
    author: 'Miguel A.',
    role: 'Propietario, tienda gourmet en Roquetas de Mar',
    rating: 5
  },
  {
    text: 'Veníamos de una web en WordPress que tardaba 6 segundos en cargar. La nueva carga en menos de 1 segundo y los contactos se han triplicado.',
    author: 'Patricia R.',
    role: 'Gerente, clínica dental en Mojácar',
    rating: 5
  },
  {
    text: 'Nos hicieron una landing para una campaña de Google Ads y la tasa de conversión pasó del 2% al 8%. La inversión se recuperó en la primera semana.',
    author: 'David S.',
    role: 'CEO, empresa de reformas en Almería',
    rating: 5
  }
];

// ── FAQ ──
const faq = [
  {
    q: '¿Cuánto tarda en estar lista mi web?',
    a: 'Depende del tipo de proyecto. Una landing page puede estar lista en 5-7 días. Una web corporativa en 1-2 semanas. Una tienda online entre 2-3 semanas. Proyectos a medida requieren más tiempo según la complejidad. Siempre te damos un plazo concreto antes de empezar.'
  },
  {
    q: '¿Qué es eso del hosting gratuito para webs estáticas?',
    a: 'Las webs que no necesitan base de datos (corporativas, portfolios, landings) pueden alojarse gratis en plataformas como Netlify o Cloudflare Pages. Son más rápidas, más seguras y no pagas hosting mensual. Solo pagas el dominio. Es una ventaja real que muchas agencias no ofrecen porque trabajan con WordPress para todo.'
  },
  {
    q: '¿La web es mía o me ato a vosotros?',
    a: 'Es 100% tuya. Te entregamos el código fuente, el dominio está a tu nombre y puedes llevarte tu web cuando quieras. Sin permanencia, sin ataduras. Trabajamos sin contrato de permanencia porque confiamos en que te quedarás por los resultados, no por obligación.'
  },
  {
    q: '¿Mi web estará optimizada para Google (SEO)?',
    a: 'Sí. Todas nuestras webs incluyen optimización SEO técnica de serie: estructura semántica correcta, velocidad de carga optimizada, meta tags configurados, schema markup, sitemap XML, robots.txt y Google Search Console configurado. Es la base para posicionarte.'
  },
  {
    q: '¿Puedo gestionar el contenido yo mismo después?',
    a: 'Por supuesto. Te entregamos la web con un panel de administración intuitivo y te formamos para que puedas actualizar textos, imágenes y contenido sin necesidad de programar. Si en algún momento necesitas ayuda, nuestros planes de mantenimiento desde 39€/mes incluyen horas de cambios.'
  },
  {
    q: '¿Hacéis tiendas online con pasarela de pago?',
    a: 'Sí. Integramos las principales pasarelas de pago: Stripe, PayPal, Redsys (para tarjetas españolas), Bizum y transferencia bancaria. Todo configurado con certificado SSL y cumpliendo la normativa PSD2 de pagos seguros.'
  },
  {
    q: '¿Qué pasa si necesito cambios después de entregar la web?',
    a: 'Tienes varias opciones: puedes hacer los cambios tú mismo desde el panel, contratar un plan de mantenimiento mensual que incluye horas de cambios, o solicitar cambios puntuales bajo presupuesto. Siempre tendrás soporte disponible.'
  },
  {
    q: '¿Trabajáis solo en Almería o también fuera?',
    a: 'Aunque estamos especializados en empresas de Almería y conocemos el mercado local, trabajamos con clientes de toda España. La comunicación es igual de fluida por videollamada, email y WhatsApp. Lo importante es entender tu negocio, no la distancia.'
  }
];

// ── JSON-LD Schemas ──
const jsonLdSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonical,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "Platanito Rico", "url": "https://platanitorico.com" },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
        { "@type": "ListItem", "position": 2, "name": "Diseño Web", "item": canonical }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Platanito Rico — Diseño Web en Almería",
    "description": "Agencia de diseño web y desarrollo profesional en Almería. Webs corporativas, tiendas online, landings y aplicaciones web a medida.",
    "url": canonical,
    "telephone": "+34657085019",
    "email": "hola@platanitorico.com",
    "address": { "@type": "PostalAddress", "addressLocality": "Almería", "addressRegion": "Andalucía", "addressCountry": "ES" },
    "geo": { "@type": "GeoCoordinates", "latitude": 36.834, "longitude": -2.4637 },
    "areaServed": { "@type": "State", "name": "Almería" },
    "priceRange": "€€",
    "openingHoursSpecification": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "19:00" },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios de Diseño y Desarrollo Web",
      "itemListElement": services.map(s => ({
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": s.title, "description": s.desc }
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo creamos tu página web profesional",
    "description": "Proceso de desarrollo web: desde el análisis inicial hasta el lanzamiento y formación.",
    "step": process.map((p, i) => ({
      "@type": "HowToStep",
      "position": i + 1,
      "name": p.title,
      "text": p.desc
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-desarrollo-web-calidad.jpg"
  imageAlt="Desarrollo web profesional y diseño de páginas web en Almería - Platanito Rico"
  type="service"
  keywords="diseño web almería, desarrollo web almería, tienda online almería, página web profesional, web corporativa, hosting gratuito, agencia web almería"
  jsonLd={jsonLdSchemas}
>
  <Header />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Diseño Web' }
  ]} />

  <main class="pt-0">

    <!-- ════════════════════════════════════════════ -->
    <!-- HERO -->
    <!-- ════════════════════════════════════════════ -->
    <section class="section-brutal relative min-h-screen flex items-center justify-center overflow-hidden bg-brutal-bg" id="hero">
      <div class="absolute inset-0 z-0">
        <img
          src="/imagenes/equipo-desarrollo-web-calidad.jpg"
          alt="Equipo de desarrollo web Platanito Rico trabajando en proyectos"
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
        />
      </div>
      <div class="absolute inset-0 z-[1] bg-brutal-bg/85"></div>

      <div class="container-brutal relative z-10 py-24">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Badge -->
          <div class="badge-brutal mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full bg-brutal-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 bg-brutal-accent"></span>
            </span>
            <span class="text-sm font-medium text-brutal-text">Especialistas en diseño web en Almería</span>
          </div>

          <h1 class="heading-display text-4xl md:text-5xl lg:text-7xl text-brutal-text mb-8 leading-[1.1]">
            Tu web tiene que hacer
            <span class="block mt-2 text-brutal-accent">una cosa: venderte</span>
          </h1>

          <p class="text-lg md:text-xl text-brutal-text-secondary max-w-3xl mx-auto mb-6 leading-relaxed">
            Creamos webs ultrarrápidas, optimizadas para Google y diseñadas para convertir visitantes en clientes.
            <strong class="text-brutal-text">Con hosting gratuito para webs estáticas</strong> y sin permanencia.
          </p>
          <p class="text-base md:text-lg text-brutal-text-muted max-w-2xl mx-auto mb-12">
            Desde landing pages hasta tiendas online y aplicaciones a medida. <strong class="text-brutal-accent">Tu web es 100% tuya.</strong>
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="/#contacto" class="btn-brutal group inline-flex items-center gap-2 px-8 py-4 bg-brutal-accent text-brutal-text font-semibold">
              <span class="relative">Pedir presupuesto gratis</span>
              <svg class="relative w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="tel:+34657085019" class="btn-brutal-outline inline-flex items-center gap-2 px-8 py-4 bg-brutal-bg text-brutal-text font-semibold border border-brutal-text/30 hover:bg-brutal-text/10 transition-all">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              657 085 019
            </a>
          </div>

          <!-- Stats -->
          <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">50+</div>
              <div class="text-xs text-brutal-text-muted">Webs entregadas</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">&lt;1s</div>
              <div class="text-xs text-brutal-text-muted">Tiempo de carga</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">90+</div>
              <div class="text-xs text-brutal-text-muted">Score Lighthouse</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">0€</div>
              <div class="text-xs text-brutal-text-muted">Hosting web estática</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════ -->
    <!-- SERVICIOS — Sin precios, orientados a resultado -->
    <!-- ════════════════════════════════════════════ -->
    <section id="servicios" class="section-brutal py-24 bg-brutal-bg-alt">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Qué creamos para ti
          </div>
          <h2 class="heading-display text-3xl md:text-4xl lg:text-5xl text-brutal-text mb-6 leading-tight">
            Webs que no solo son bonitas.<br/>
            <span class="text-brutal-accent">Venden.</span>
          </h2>
          <p class="text-lg text-brutal-text-secondary max-w-2xl mx-auto">
            Cada proyecto está diseñado para un objetivo claro: que tu inversión se traduzca en clientes y facturación.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {services.map((service) => (
            <div class="card-brutal bg-brutal-card border-brutal-border p-8">
              <!-- Icon -->
              <div class="w-14 h-14 bg-brutal-accent flex items-center justify-center mb-6">
                {service.icon === 'rocket' && (
                  <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.58-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                  </svg>
                )}
                {service.icon === 'building' && (
                  <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" />
                  </svg>
                )}
                {service.icon === 'cart' && (
                  <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                  </svg>
                )}
                {service.icon === 'code' && (
                  <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                  </svg>
                )}
              </div>

              <h3 class="text-2xl font-bold text-brutal-text mb-3">{service.title}</h3>
              <p class="text-brutal-text-secondary mb-6 leading-relaxed">{service.desc}</p>

              <!-- Features -->
              <ul class="space-y-2 mb-6">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-brutal-text-secondary">
                    <svg class="w-4 h-4 text-brutal-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>

              <!-- Result -->
              <div class="p-4 bg-brutal-bg border border-brutal-border">
                <p class="text-sm text-brutal-accent font-medium flex items-start gap-2">
