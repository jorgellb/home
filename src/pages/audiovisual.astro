---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = 'Productora Audiovisual en Almería | Video con Dron 4K y Fotografía Aérea';
const description = 'Productora audiovisual en Almería con dron Mavic 3 Pro 4K. Vídeo corporativo, reels, fotografía aérea y tours virtuales 360°. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/audiovisual/';

// ── Especificaciones del dron ──
const droneFeatures = [
  { title: 'Sensor Hasselblad 4/3', desc: 'Calidad cinematográfica profesional con rango dinámico de 12.8 stops', icon: 'camera' },
  { title: 'Detección omnidireccional', desc: 'Sensores en todas las direcciones para vuelo seguro en cualquier entorno', icon: 'shield' },
  { title: '43 minutos de vuelo', desc: 'Máxima autonomía para capturar tomas épicas sin prisas ni limitaciones', icon: 'battery' },
  { title: 'Apple ProRes & 5.1K', desc: 'Grabación en formatos de cine profesional para post-producción de alto nivel', icon: 'film' }
];

// ── Servicios principales (SIN PRECIOS) ──
const services = [
  {
    title: 'Video Corporativo con Dron',
    desc: 'Tomas aéreas cinematográficas combinadas con material terrestre 4K. Tu empresa vista desde una perspectiva que impacta y transmite profesionalidad a otro nivel.',
    features: ['Dron Mavic 3 Pro 4K', 'Cámaras terrestres profesionales', 'Edición y color grading', 'Música licenciada incluida', 'Entrega en múltiples formatos'],
    highlight: true,
    result: 'Ideal para webs corporativas, presentaciones a inversores y redes sociales'
  },
  {
    title: 'Spot Publicitario Aéreo',
    desc: 'Producción completa desde la idea hasta la entrega final. Storyboard, planificación de vuelo, rodaje con dron y cámara, y post-producción cinematográfica.',
    features: ['Pre-producción y storyboard', 'Guion creativo', 'Dron 4K + cámara terrestre', 'Color grading profesional', 'Versiones para TV, web y RRSS'],
    highlight: true,
    result: 'Para campañas publicitarias, lanzamientos de producto y branding'
  },
  {
    title: 'Tour Virtual 360°',
    desc: 'Recorridos inmersivos que combinan perspectiva aérea y terrestre. Experiencia interactiva para que tus clientes visiten tu espacio sin moverse de casa.',
    features: ['Dron + cámara 360°', 'Hotspots interactivos', 'Compatible con VR', 'Hosting incluido', 'Integración en tu web'],
    highlight: false,
    result: 'Perfecto para inmobiliarias, hoteles, restaurantes y espacios de eventos'
  },
  {
    title: 'Tomas Aéreas para Proyectos',
    desc: 'Pack de planos aéreos espectaculares listos para integrar en tus propias producciones. Material en bruto o editado según necesites.',
    features: ['Múltiples ángulos y alturas', 'Formatos 4K / 5.1K / 1080p', 'Color correction incluida', 'Entrega express en 48h', 'RAW disponible bajo petición'],
    highlight: false,
    result: 'Para productoras, agencias y proyectos que necesitan material aéreo de calidad'
  }
];

// ── Servicios complementarios ──
const reelServices = [
  {
    title: 'Pack Reels con Dron',
    desc: 'Reels optimizados para Instagram y TikTok con tomas aéreas que detienen el scroll. Contenido vertical impactante que genera engagement.',
    features: ['Formato 9:16 optimizado', 'Música trending', 'Subtítulos animados', 'Entrega rápida']
  },
  {
    title: 'Video Producto Premium',
    desc: 'Showcase dinámico con planos cenitales, movimientos envolventes y transiciones profesionales que hacen brillar tu producto.',
    features: ['Dron + slider motorizado', 'Iluminación profesional', 'Motion graphics', 'Varias revisiones incluidas']
  }
];

const motionServices = [
  {
    title: 'Logo Animation 3D',
    desc: 'Tu marca cobra vida con animaciones cinematográficas. Intro profesional para tus vídeos, web y presentaciones que genera impacto instantáneo.',
    features: ['Animación 3D realista', 'Partículas y efectos VFX', 'Render en 4K', 'Formatos adaptados a cada plataforma']
  },
  {
    title: 'Video Explicativo Animado',
    desc: 'Combina video real con motion graphics para comunicar mensajes complejos de forma clara y atractiva. Ideal para formación, producto o captación.',
    features: ['Guion creativo incluido', 'Storyboard detallado', 'Animación 2D/3D', 'Locución profesional opcional']
  }
];

const photoServices = [
  {
    title: 'Fotografía Aérea',
    desc: 'Fotos profesionales desde el cielo con sensor Hasselblad 20MP. Perspectivas únicas que no se consiguen de otra forma.',
    features: ['Sensor Hasselblad 20MP', 'Entrega RAW + JPG editado', 'Edición profesional incluida', 'Entrega en 48h']
  },
  {
    title: 'Sesión Corporativa Completa',
    desc: 'Retratos profesionales del equipo + tomas aéreas de las instalaciones. Todo lo que tu empresa necesita para proyectar imagen profesional.',
    features: ['Equipo de iluminación profesional', 'Dron para exteriores', 'Fotos editadas en alta resolución', 'Galería online privada']
  }
];

// ── Sectores donde aportamos valor ──
const sectores = [
  { nombre: 'Inmobiliarias', desc: 'Vende propiedades con perspectivas aéreas que muestran ubicación, entorno y dimensiones reales. Tours 360° que filtran visitas.', icon: 'building' },
  { nombre: 'Hostelería y Turismo', desc: 'Hoteles, restaurantes y casas rurales que se muestran desde el cielo. Genera reservas con contenido visual que enamora.', icon: 'hotel' },
  { nombre: 'Construcción e Industria', desc: 'Seguimiento de obra, inspección de infraestructuras y documentación aérea de proyectos con precisión profesional.', icon: 'construction' },
  { nombre: 'Eventos y Bodas', desc: 'Captura momentos irrepetibles desde perspectivas cinematográficas. Recuerdo premium con tomas que sorprenden.', icon: 'event' },
  { nombre: 'Agricultura', desc: 'Inspección de cultivos, cartografía de parcelas y documentación visual para explotaciones agrícolas de Almería.', icon: 'agriculture' },
  { nombre: 'Deporte y Aventura', desc: 'Actividades al aire libre filmadas desde ángulos espectaculares. Surf, senderismo, escalada, ciclismo... contenido que inspira.', icon: 'sport' }
];

// ── Proceso de trabajo ──
const processSteps = [
  { num: '01', title: 'Briefing creativo', desc: 'Nos cuentas tu visión, analizamos ubicación, tiempos y necesidades técnicas. Definimos el enfoque creativo juntos.' },
  { num: '02', title: 'Planificación de vuelo', desc: 'Estudiamos espacio aéreo, gestionamos permisos AESA si son necesarios y elegimos las condiciones óptimas de luz y clima.' },
  { num: '03', title: 'Producción 4K', desc: 'Día de rodaje con Mavic 3 Pro y equipo terrestre. Múltiples tomas, ángulos y alturas para asegurar el material perfecto.' },
  { num: '04', title: 'Post-producción', desc: 'Color grading cinematográfico, estabilización avanzada, edición narrativa y entrega en todos los formatos que necesites.' }
];

// ── FAQ ──
const faqs = [
  {
    q: '¿Necesitáis permisos para volar el dron?',
    a: 'Sí. Somos operadores certificados por AESA (Agencia Estatal de Seguridad Aérea). Gestionamos todos los permisos necesarios según la ubicación y el tipo de vuelo. Contamos con seguro de responsabilidad civil obligatorio. Tú no tienes que preocuparte de nada.'
  },
  {
    q: '¿En cuánto tiempo tengo el material listo?',
    a: 'Para tomas aéreas sueltas, entrega express en 48 horas. Videos corporativos completos con edición, color grading y música suelen estar listos en 1-2 semanas. Spots publicitarios con pre-producción pueden requerir 2-3 semanas. Siempre acordamos plazos antes de empezar.'
  },
  {
    q: '¿Podéis volar en cualquier ubicación de Almería?',
    a: 'Volamos en toda la provincia de Almería: costa, interior, zonas urbanas y rurales. Hay restricciones en algunas zonas (aeropuertos, zonas militares, parques naturales protegidos), pero en la mayoría de casos podemos operar con la autorización correspondiente. Lo evaluamos caso por caso.'
  },
  {
    q: '¿Qué calidad de video ofrecéis?',
    a: 'Grabamos en 5.1K y 4K con el DJI Mavic 3 Pro equipado con sensor Hasselblad. Para proyectos de cine y publicidad, ofrecemos grabación en Apple ProRes con 12.8 stops de rango dinámico. La calidad es equiparable a producciones profesionales de alto presupuesto.'
  },
  {
    q: '¿Puedo usar el material en redes sociales, web y televisión?',
    a: 'Sí. Entregamos el material en los formatos que necesites: horizontal para web y TV, vertical para Instagram/TikTok, cuadrado para feeds. La música que incluimos está licenciada para uso comercial. Recibes todos los derechos de uso del material.'
  },
  {
    q: '¿Trabajáis fuera de Almería?',
    a: 'Sí. Aunque nuestra base está en Almería, nos desplazamos a cualquier punto de Andalucía y España. Para proyectos fuera de la provincia, consultanos y te hacemos presupuesto incluyendo desplazamiento.'
  },
  {
    q: '¿Qué pasa si el día de rodaje hace mal tiempo?',
    a: 'Si las condiciones meteorológicas no son seguras o afectan a la calidad (viento fuerte, lluvia), reprogramamos el rodaje sin coste adicional. Monitorizamos la previsión con antelación y siempre tenemos fechas alternativas preparadas.'
  },
  {
    q: '¿Ofrecéis servicio de fotografía aérea además de vídeo?',
    a: 'Sí. El sensor Hasselblad de 20MP del Mavic 3 Pro captura fotos aéreas de calidad profesional. Entregamos en RAW y JPG editado. Es un servicio muy demandado por inmobiliarias, constructoras y empresas turísticas de Almería.'
  }
];

// ── Stats ──
const stats = [
  { value: '5.1K', label: 'Resolución máxima' },
  { value: '43min', label: 'Autonomía de vuelo' },
  { value: '12.8', label: 'Stops rango dinámico' },
  { value: '48h', label: 'Entrega express' }
];

// ── JSON-LD Schemas avanzados ──
const jsonLd = [
  // WebPage
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonical,
    "inLanguage": "es",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Platanito Rico",
      "url": "https://platanitorico.com"
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
        { "@type": "ListItem", "position": 2, "name": "Audiovisual", "item": canonical }
      ]
    }
  },
  // ProfessionalService
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Platanito Rico - Producción Audiovisual Almería",
    "url": canonical,
    "telephone": "+34657085019",
    "email": "hola@platanitorico.com",
    "image": "https://platanitorico.com/imagenes/audiovisuales-dron-video.jpg",
    "logo": "https://platanitorico.com/imagenes/logo.png",
    "description": "Producción audiovisual profesional con dron 4K DJI Mavic 3 Pro en Almería. Video corporativo, spots, fotografía aérea y tours 360°.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ctra de Ronda, 82",
      "addressLocality": "Vera",
      "addressRegion": "Almería",
      "postalCode": "04620",
      "addressCountry": "ES"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "37.2450",
      "longitude": "-1.8614"
    },
    "areaServed": [
      { "@type": "State", "name": "Almería" },
      { "@type": "Country", "name": "España" }
    ],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "18:00"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios Audiovisuales con Dron",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Video Corporativo con Dron 4K", "description": "Producción de video corporativo con tomas aéreas cinematográficas" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Spot Publicitario Aéreo", "description": "Producción completa de spots con planificación, storyboard y dron 4K" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tour Virtual 360°", "description": "Recorridos inmersivos con perspectiva aérea y terrestre" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fotografía Aérea Profesional", "description": "Fotos aéreas con sensor Hasselblad 20MP" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Reels y Contenido Social Media", "description": "Videos verticales optimizados para Instagram y TikTok con tomas aéreas" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Motion Graphics y Animación", "description": "Logo animation 3D y videos explicativos animados" } }
      ]
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "23",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Javier Ruiz" },
        "datePublished": "2025-01-20",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Contratamos el servicio de dron para grabar nuestras propiedades en Vera Playa. El resultado fue espectacular, las tomas aéreas venden solas. Hemos duplicado las consultas desde que usamos estos vídeos en los portales."
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Laura García" },
        "datePublished": "2025-02-15",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": "Necesitábamos un vídeo corporativo para nuestro hotel en Mojácar. El equipo fue muy profesional, las tomas con dron le dieron un toque cinematográfico increíble. Nuestros clientes internacionales quedan impresionados."
      }
    ]
  },
  // HowTo
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo se produce un video profesional con dron en Almería",
    "description": "Proceso paso a paso de producción audiovisual con dron 4K: desde el briefing creativo hasta la entrega del material final editado.",
    "step": processSteps.map((p, i) => ({
      "@type": "HowToStep",
      "position": i + 1,
      "name": p.title,
      "text": p.desc
    }))
  },
  // FAQPage
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout
  title={title}
  description={description}
  image="/imagenes/audiovisuales-dron-video.jpg"
  imageAlt="Producción audiovisual con dron 4K en Almería"
  type="website"
  lang="es"
  canonical={canonical}
  keywords="producción audiovisual almería, video dron almería, dron 4k almería, fotografía aérea almería, video corporativo almería, spot publicitario dron, tour virtual 360"
  jsonLd={jsonLd}
>
  <Header />

  <main id="main-content">

    <!-- ═══════════════════════════════════════════
         HERO
    ═══════════════════════════════════════════ -->
    <section class="section-brutal relative min-h-screen flex items-center justify-center overflow-hidden bg-brutal-bg">
      <div class="absolute inset-0 z-0">
        <img
          src="/imagenes/audiovisuales-dron-video.jpg"
          alt="Producción audiovisual profesional con dron 4K en Almería"
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="absolute inset-0 z-[1] bg-brutal-bg/85"></div>

      <div class="container-brutal relative z-10 py-24">
        <!-- Breadcrumb -->
        <nav class="mb-8" aria-label="Migas de pan">
          <ol class="flex items-center gap-2 text-sm text-brutal-text-muted">
            <li><a href="/" class="hover:text-brutal-text transition-colors">Inicio</a></li>
            <li aria-hidden="true"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
            <li><span class="text-brutal-accent font-medium" aria-current="page">Audiovisual</span></li>
          </ol>
        </nav>

        <div class="text-center">
          <div class="badge-brutal mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full bg-brutal-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 bg-brutal-accent"></span>
            </span>
            <span class="text-sm font-medium text-brutal-text">DJI Mavic 3 Pro · Operadores certificados AESA</span>
          </div>

          <h1 class="heading-display text-5xl md:text-6xl lg:text-8xl text-brutal-text mb-8 leading-tight">
            Perspectivas que<br/>
            <span class="text-brutal-accent">elevan tu marca</span>
          </h1>

          <p class="text-xl md:text-2xl text-brutal-text-secondary mb-12 max-w-3xl mx-auto leading-relaxed">
            Producción audiovisual profesional con <strong class="text-brutal-text">Dron Mavic 3 Pro 4K</strong>.
            Tomas aéreas cinematográficas, video corporativo, spots publicitarios y fotografía aérea en Almería y toda España.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
            <a href="/#contacto" class="btn-brutal group relative px-8 py-4 bg-brutal-accent text-brutal-text text-lg">
              <span class="relative z-10">Solicitar presupuesto gratis</span>
            </a>
            <a href="#servicios" class="btn-brutal-outline px-8 py-4 border-2 border-brutal-text/30 text-brutal-text text-lg hover:bg-brutal-text/10 transition-colors">
              Ver servicios
            </a>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
            {stats.map(stat => (
              <div class="card-brutal bg-brutal-card border-brutal-border p-5 text-center">
                <div class="text-3xl md:text-4xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">{stat.value}</div>
                <div class="text-sm text-brutal-text-muted">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         EQUIPO — DJI Mavic 3 Pro
    ═══════════════════════════════════════════ -->
    <section class="section-brutal py-24 bg-brutal-bg-alt">
      <div class="container-brutal">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="badge-brutal mb-6">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Equipo profesional
            </span>
            <h2 class="heading-display text-4xl md:text-5xl text-brutal-text mb-6">
              DJI Mavic 3 Pro<br/>
              <span class="text-brutal-text-muted">La referencia mundial</span>
            </h2>
            <p class="text-lg text-brutal-text-secondary mb-8 leading-relaxed">
              El dron más avanzado de DJI con <strong class="text-brutal-text">triple cámara Hasselblad</strong>.
              Capturamos tomas aéreas con calidad de cine: 5.1K video, sensor 4/3 CMOS
              y estabilización gimbal de 3 ejes. Tus proyectos merecen esta calidad.
            </p>

            <div class="grid sm:grid-cols-2 gap-4">
              {droneFeatures.map(feature => (
                <div class="card-brutal bg-brutal-card border-brutal-border flex gap-4 p-4 transition-all group">
                  <div class="w-12 h-12 bg-brutal-accent flex items-center justify-center flex-shrink-10">
                    <div class="w-full h-full bg-brutal-card flex items-center justify-center">
                      {feature.icon === 'camera' && (
                        <svg class="w-6 h-6 text-brutal-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25z" />
                        </svg>
                      )}
                      {feature.icon === 'shield' && (
                        <svg class="w-6 h-6 text-brutal-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                      )}
                      {feature.icon === 'battery' && (
                        <svg class="w-6 h-6 text-brutal-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M3.75 18h15A2.25 2.25 0 0021 15.75v-6a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 9.75v6A2.25 2.25 0 003.75 18z" />
                        </svg>
                      )}
                      {feature.icon === 'film' && (
                        <svg class="w-6 h-6 text-brutal-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
