---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Productora Audiovisual y Dron en Almería';
const description = 'Productora audiovisual en Almería con dron Mavic 3 Pro 4K. Vídeo corporativo, reels, fotografía aérea y tours virtuales 360°. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/audiovisual/';

const services = [
  { n: '01', title: 'Vídeo corporativo con dron', kicker: 'Cinematográfico · 4K · Hasselblad', desc: 'Tomas aéreas cinematográficas combinadas con material terrestre 4K. Tu empresa vista desde una perspectiva que impacta y transmite profesionalidad.', features: ['Dron Mavic 3 Pro 4K','Cámaras terrestres profesionales','Edición y color grading','Música licenciada incluida','Entrega multi-formato'], figure: '5.1K', figureLabel: 'Resolución máx.', color: 'red', icon: 'slate' },
  { n: '02', title: 'Spot publicitario aéreo',    kicker: 'Storyboard · Rodaje · Post',        desc: 'Producción completa desde la idea hasta la entrega final. Storyboard, planificación de vuelo, rodaje con dron y cámara, y post-producción cinematográfica.', features: ['Pre-producción y storyboard','Guion creativo','Dron 4K + cámara terrestre','Color grading profesional','Versiones TV / web / RRSS'], figure: 'TV·Web·IG', figureLabel: 'Multi formato', color: 'yellow', icon: 'clapper' },
  { n: '03', title: 'Tour virtual 360°',          kicker: 'Inmersivo · Aéreo · Terrestre',     desc: 'Recorridos inmersivos que combinan perspectiva aérea y terrestre. Experiencia interactiva para que tus clientes visiten tu espacio sin moverse de casa.', features: ['Dron + cámara 360°','Hotspots interactivos','Compatible con VR','Hosting incluido','Integración en tu web'], figure: '360°', figureLabel: 'Vista inmersiva', color: 'cyan', icon: 'orbit' },
  { n: '04', title: 'Pack tomas aéreas',          kicker: 'B-roll · RAW · Exprés',             desc: 'Pack de planos aéreos espectaculares listos para integrar en tus producciones. Material en bruto o editado según lo necesites.', features: ['Múltiples ángulos y alturas','Formatos 4K · 5.1K · 1080p','Color correction incluida','Entrega express en 48h','RAW bajo petición'], figure: '48h', figureLabel: 'Express', color: 'lime', icon: 'drone' },
];

const droneSpecs = [
  { k: 'Sensor',          v: 'Hasselblad 4/3 · 20 MP · 12.8 stops dinámicos' },
  { k: 'Vídeo',           v: 'Apple ProRes · 5.1K @ 50fps · 4K @ 120fps' },
  { k: 'Detección',       v: 'Omnidireccional · vuelo seguro entornos complejos' },
  { k: 'Autonomía',       v: '43 min · transmisión 15 km · viento ≤ 12 m/s' },
  { k: 'Operador',        v: 'Certificado AESA · seguro RC obligatorio' },
  { k: 'Espacio aéreo',   v: 'Gestión de permisos AESA / ENAIRE incluida' },
];

const reels = [
  { n: '05', title: 'Pack Reels con dron',     kicker: 'Reels · TikTok · Vertical', desc: 'Reels optimizados para Instagram y TikTok con tomas aéreas que detienen el scroll. Contenido vertical impactante que genera engagement.', features: ['Formato 9:16 optimizado','Música trending','Subtítulos animados','Entrega rápida'], figure: '9:16', figureLabel: 'Vertical', color: 'magenta', icon: 'reel' },
  { n: '06', title: 'Vídeo producto premium',  kicker: 'Studio · Slider · Macro',   desc: 'Showcase dinámico con planos cenitales, movimientos envolventes y transiciones profesionales que hacen brillar tu producto.', features: ['Dron + slider motorizado','Iluminación profesional','Motion graphics','Revisiones incluidas'], figure: 'Studio', figureLabel: 'Setup pro', color: 'cyan', icon: 'product' },
];

const motion = [
  { n: '07', title: 'Logo Animation 3D',           kicker: 'Branding · 3D · VFX',          desc: 'Tu marca cobra vida con animaciones cinematográficas. Intro profesional para tus vídeos, web y presentaciones que genera impacto instantáneo.', features: ['Animación 3D realista','Partículas y VFX','Render 4K','Formatos por plataforma'], figure: '3D', figureLabel: 'Render', color: 'red', icon: 'logo' },
  { n: '08', title: 'Vídeo explicativo animado',    kicker: 'Motion · Locución · 2D/3D',     desc: 'Combina vídeo real con motion graphics para comunicar mensajes complejos. Ideal para formación, producto o captación.', features: ['Guion creativo','Storyboard detallado','Animación 2D/3D','Locución profesional'], figure: '60s', figureLabel: 'Duración', color: 'yellow', icon: 'motion' },
];

const sectores = [
  { title: 'Inmobiliarias',            desc: 'Vende propiedades con perspectivas aéreas que muestran ubicación, entorno y dimensiones reales. Tours 360° que filtran visitas.' },
  { title: 'Hostelería y turismo',     desc: 'Hoteles, restaurantes y casas rurales mostrados desde el cielo. Genera reservas con contenido visual que enamora.' },
  { title: 'Construcción e industria', desc: 'Seguimiento de obra, inspección de infraestructuras y documentación aérea con precisión profesional.' },
  { title: 'Eventos y bodas',          desc: 'Captura momentos irrepetibles desde perspectivas cinematográficas. Recuerdo premium con tomas que sorprenden.' },
  { title: 'Agricultura',              desc: 'Inspección de cultivos, cartografía de parcelas y documentación visual para explotaciones agrícolas de Almería.' },
  { title: 'Deporte y aventura',       desc: 'Surf, senderismo, escalada, ciclismo… actividades al aire libre filmadas desde ángulos espectaculares.' },
];

const process = [
  { num: '01', title: 'Briefing creativo',      eta: '1 día',     body: 'Nos cuentas tu visión. Analizamos ubicación, tiempos y necesidades técnicas. Definimos el enfoque creativo juntos.', deliverable: 'Concepto + estilo visual',           color: 'red' },
  { num: '02', title: 'Planificación de vuelo', eta: '2–4 días',  body: 'Estudiamos espacio aéreo, gestionamos permisos AESA si son necesarios y elegimos las condiciones óptimas de luz y clima.', deliverable: 'Plan de vuelo + permisos AESA', color: 'yellow' },
  { num: '03', title: 'Producción 4K',          eta: '1–2 días',  body: 'Día de rodaje con Mavic 3 Pro y equipo terrestre. Múltiples tomas, ángulos y alturas para asegurar el material perfecto.', deliverable: 'Material en bruto + backup',     color: 'cyan' },
  { num: '04', title: 'Post-producción',        eta: '5–10 días', body: 'Color grading cinematográfico, estabilización avanzada, edición narrativa y entrega en todos los formatos necesarios.', deliverable: 'Master + versiones · todos los formatos', color: 'lime' },
];

const testimonials = [
  { text: 'Contratamos el dron para grabar nuestras propiedades en Vera Playa. El resultado fue espectacular: las tomas aéreas venden solas. Hemos duplicado las consultas desde que usamos estos vídeos en los portales.', author: 'Javier Ruiz',   role: 'Director · Inmobiliaria Vera Playa' },
  { text: 'Necesitábamos un vídeo corporativo para nuestro hotel en Mojácar. El equipo fue muy profesional, las tomas con dron le dieron un toque cinematográfico increíble.', author: 'Laura García',  role: 'Marketing · Hotel · Mojácar' },
  { text: 'El tour virtual 360° de nuestro restaurante ha sido un cambio total. Los clientes reservan después de ver el espacio. Calidad cine.', author: 'Antonio M.',  role: 'Propietario · Restaurante · Roquetas' },
  { text: 'Los reels que produjeron para nuestra marca de moda triplicaron el engagement en Instagram. Tomas aéreas + edición de calidad cine.', author: 'Marta P.',     role: 'Founder · Marca de moda · Almería' },
];

const faqs = [
  { q: '¿Necesitáis permisos para volar el dron?', a: 'Sí. Somos operadores certificados por AESA (Agencia Estatal de Seguridad Aérea). Gestionamos todos los permisos según ubicación y tipo de vuelo. Contamos con seguro de responsabilidad civil obligatorio. Tú no te preocupas de nada.' },
  { q: '¿En cuánto tiempo tengo el material listo?', a: 'Tomas aéreas sueltas: entrega express en 48h. Vídeo corporativo completo: 1–2 semanas. Spot publicitario con pre-producción: 2–3 semanas. Plazos acordados antes de empezar.' },
  { q: '¿Podéis volar en cualquier ubicación de Almería?', a: 'Volamos en toda la provincia: costa, interior, zonas urbanas y rurales. Hay restricciones en aeropuertos, zonas militares y parques naturales protegidos, pero en la mayoría de casos podemos operar con autorización. Lo evaluamos caso por caso.' },
  { q: '¿Qué calidad de vídeo ofrecéis?', a: 'Grabamos en 5.1K y 4K con el DJI Mavic 3 Pro y sensor Hasselblad. Para proyectos de cine y publicidad, Apple ProRes con 12.8 stops de rango dinámico. Calidad equiparable a producciones profesionales.' },
  { q: '¿Puedo usar el material en redes sociales, web y televisión?', a: 'Sí. Entregamos en los formatos que necesites: horizontal para web/TV, vertical para Instagram/TikTok, cuadrado para feeds. La música incluida está licenciada para uso comercial. Recibes todos los derechos.' },
  { q: '¿Trabajáis fuera de Almería?', a: 'Sí. Base en Almería pero nos desplazamos a cualquier punto de Andalucía y España. Para proyectos fuera de provincia, te hacemos presupuesto incluyendo desplazamiento.' },
  { q: '¿Qué pasa si el día de rodaje hace mal tiempo?', a: 'Si las condiciones meteorológicas no son seguras o afectan a la calidad (viento fuerte, lluvia), reprogramamos sin coste adicional. Monitorizamos la previsión con antelación y siempre tenemos fechas alternativas.' },
  { q: '¿Ofrecéis fotografía aérea además de vídeo?', a: 'Sí. El sensor Hasselblad de 20MP del Mavic 3 Pro captura fotos aéreas de calidad profesional. Entregamos en RAW y JPG editado. Muy demandado por inmobiliarias, constructoras y empresas turísticas.' },
];

const jsonLd = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Audiovisual","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico - Producción Audiovisual Almería","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","image":"https://platanitorico.com/imagenes/audiovisuales-dron-video.jpg","description":"Producción audiovisual con dron 4K DJI Mavic 3 Pro en Almería. Vídeo corporativo, spots, fotografía aérea y tours 360°.","address":{"@type":"PostalAddress","streetAddress":"Ctra de Ronda, 82","addressLocality":"Vera","addressRegion":"Almería","postalCode":"04620","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":"37.2450","longitude":"-1.8614"},"areaServed":[{"@type":"State","name":"Almería"},{"@type":"Country","name":"España"}],"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},"hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios Audiovisuales con Dron","itemListElement":services.concat(reels).concat(motion).map(s=>({"@type":"Offer","itemOffered":{"@type":"Service","name":s.title,"description":s.desc}}))},"aggregateRating":{"@type":"AggregateRating","ratingValue":"5.0","reviewCount":"23","bestRating":"5","worstRating":"1"} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo se produce un vídeo profesional con dron en Almería","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  image="/imagenes/audiovisuales-dron-video.jpg"
  imageAlt="Producción audiovisual con dron 4K en Almería"
  type="service"
  lang="es"
  canonical={canonical}
  keywords="producción audiovisual almería, video dron almería, dron 4k almería, fotografía aérea almería, video corporativo almería"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Audiovisual' }]} />

  <main id="main-content" class="av">
    {/* ═══════════════ HERO · EDITOR NLE ═══════════════ */}
    <section class="av-hero">
      <div class="av-hero__film-grid" aria-hidden="true"></div>

      <div class="container-brutal av-hero__inner">
        <header class="av-hero__head">
          <span class="av-tag av-tag--rec">
            <span class="av-tag__dot"></span>
            REC ● 00:00:14:23
          </span>
          <span class="av-tag av-tag--cert">
            ★ AESA certified · STS-01 · A1/A3
          </span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="av-hero__grid">
          <div class="av-hero__left">
            <span class="av-eyebrow">★ DJI Mavic 3 Pro · Hasselblad · ProRes</span>
            <h1 class="av-title">
              Tomas que
              <em>se ven.</em>
              <span class="av-title__hl">Audio que se escucha.</span>
            </h1>
            <p class="av-hero__lead">
              Productora con <strong>DJI Mavic 3 Pro · sensor Hasselblad 4/3</strong> y equipo
              terrestre profesional. Vídeo corporativo, spots, tours 360° y reels
              que detienen el scroll.
            </p>
            <div class="av-hero__cta">
              <a href="/contacto/" class="btn-brutal btn-brutal--lg">
                <span aria-hidden="true">▶</span>
                Pedir presupuesto →
              </a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>

            {/* Mini VU meter */}
            <div class="av-vu" aria-hidden="true">
              <span class="av-vu__lbl text-mono">★ AUDIO LIVE</span>
              <div class="av-vu__bars">
                {Array.from({length: 24}).map((_, i) => (
                  <span class="av-vu__bar" style={`--i:${i};--h:${20 + (i*3 % 80)}%`}></span>
                ))}
              </div>
              <span class="av-vu__db text-mono">-12 dB</span>
            </div>
          </div>

          {/* NLE Editor mock */}
          <aside class="av-nle">
            <header class="av-nle__head">
              <div class="av-nle__dots">
                <span class="av-nle__dot av-nle__dot--r"></span>
                <span class="av-nle__dot av-nle__dot--y"></span>
                <span class="av-nle__dot av-nle__dot--g"></span>
              </div>
              <span class="av-nle__file">vera-playa-promo · 5.1K · 50fps</span>
              <span class="av-nle__rec">REC ●</span>
            </header>

            {/* Viewer */}
            <div class="av-nle__viewer">
              <svg viewBox="0 0 400 220" preserveAspectRatio="none" class="av-nle__preview" aria-hidden="true">
                <defs>
                  <linearGradient id="av-sky" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0EA5E9"/>
                    <stop offset="55%" stop-color="#FF8C42"/>
                    <stop offset="100%" stop-color="#FFD600"/>
                  </linearGradient>
                  <linearGradient id="av-sea" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0078FF"/>
                    <stop offset="100%" stop-color="#001E80"/>
                  </linearGradient>
                </defs>
                {/* Sky */}
                <rect width="400" height="140" fill="url(#av-sky)"/>
                {/* Sun */}
                <circle cx="320" cy="65" r="22" fill="#FFD600" opacity=".95"/>
                <circle cx="320" cy="65" r="32" fill="#FFD600" opacity=".25"/>
                {/* Clouds */}
                <ellipse cx="60" cy="40" rx="36" ry="6" fill="#FFFCF6" opacity=".7"/>
                <ellipse cx="200" cy="55" rx="28" ry="5" fill="#FFFCF6" opacity=".6"/>
                {/* Sea */}
                <rect y="140" width="400" height="55" fill="url(#av-sea)"/>
                {/* Sea reflection */}
                <line x1="290" y1="160" x2="350" y2="160" stroke="#FFD600" stroke-width="2" opacity=".7"/>
                <line x1="295" y1="170" x2="345" y2="170" stroke="#FFD600" stroke-width="1.5" opacity=".5"/>
                {/* Coastline / playa */}
                <rect y="195" width="400" height="25" fill="#F5E1A4"/>
                {/* Drone silhouette */}
                <g transform="translate(180,90)">
                  <ellipse cx="20" cy="6" rx="20" ry="3" fill="#0E0D0B" opacity=".4"/>
                  <rect x="14" y="-2" width="12" height="6" rx="1.5" fill="#0E0D0B"/>
                  <circle cx="6" cy="0" r="5" fill="none" stroke="#0E0D0B" stroke-width="1.5"/>
                  <circle cx="34" cy="0" r="5" fill="none" stroke="#0E0D0B" stroke-width="1.5"/>
                  <line x1="11" y1="0" x2="14" y2="0" stroke="#0E0D0B" stroke-width="1.2"/>
                  <line x1="26" y1="0" x2="29" y2="0" stroke="#0E0D0B" stroke-width="1.2"/>
                  <circle cx="20" cy="9" r="1.5" fill="#FF0040"/>
                </g>
                {/* Timecode overlay */}
                <rect x="14" y="14" width="80" height="18" fill="rgba(0,0,0,.6)"/>
                <text x="18" y="27" font-family="JetBrains Mono" font-size="10" fill="#00FF94" font-weight="700">01:23:45:12</text>
                {/* REC */}
                <circle cx="378" cy="22" r="6" fill="#FF0040">
                  <animate attributeName="opacity" values="1;.3;1" dur="1.4s" repeatCount="indefinite"/>
                </circle>
                <text x="386" y="26" font-family="JetBrains Mono" font-size="9" fill="#FFFCF6" font-weight="700">REC</text>
                {/* Safe area frame */}
                <rect x="20" y="20" width="360" height="180" fill="none" stroke="#FFFCF6" stroke-width="1" stroke-dasharray="4 4" opacity=".4"/>
                {/* Crosshair */}
                <line x1="195" y1="110" x2="205" y2="110" stroke="#FFFCF6" stroke-width="1" opacity=".5"/>
                <line x1="200" y1="105" x2="200" y2="115" stroke="#FFFCF6" stroke-width="1" opacity=".5"/>
              </svg>
            </div>

            {/* Timeline */}
            <div class="av-nle__timeline">
              <div class="av-nle__ruler" aria-hidden="true">
                <span>00:00</span><span>00:15</span><span>00:30</span><span>00:45</span><span>01:00</span>
              </div>
              <div class="av-nle__track">
                <span class="av-nle__track-lbl">V1</span>
                <div class="av-nle__clips">
                  <span class="av-nle__clip av-nle__clip--red" style="width:18%"></span>
                  <span class="av-nle__clip av-nle__clip--yellow" style="width:32%"></span>
                  <span class="av-nle__clip av-nle__clip--cyan" style="width:14%"></span>
                  <span class="av-nle__clip av-nle__clip--lime" style="width:22%"></span>
                </div>
              </div>
              <div class="av-nle__track">
                <span class="av-nle__track-lbl">V2</span>
                <div class="av-nle__clips">
                  <span class="av-nle__clip av-nle__clip--magenta" style="margin-left:25%;width:30%"></span>
                </div>
              </div>
              <div class="av-nle__track av-nle__track--audio">
                <span class="av-nle__track-lbl">A1</span>
                <div class="av-nle__clips">
                  <svg viewBox="0 0 200 16" preserveAspectRatio="none" class="av-nle__wave">
                    <path d="M0,8 Q5,4 10,8 T20,8 T30,5 T40,8 T50,7 T60,3 T70,8 T80,9 T90,5 T100,8 T110,8 T120,4 T130,9 T140,8 T150,6 T160,8 T170,7 T180,5 T190,8 T200,8" stroke="#00FF94" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                  </svg>
                </div>
              </div>
              <span class="av-nle__playhead" aria-hidden="true"></span>
            </div>

            <footer class="av-nle__foot">
              <span class="av-nle__stat">Apple ProRes 422 HQ</span>
              <span class="av-nle__stat av-nle__stat--accent">5120 × 2880 · 50fps</span>
              <span class="av-nle__stat">12.8 stops</span>
            </footer>
          </aside>
        </div>

        {/* Stats specs */}
        <ul class="av-hero__stats">
          <li class="av-stat av-stat--red">
            <span class="av-stat__num">5.1<sup>K</sup></span>
            <span class="av-stat__lbl">Resolución máx.</span>
          </li>
          <li class="av-stat av-stat--yellow">
            <span class="av-stat__num">43<sup>min</sup></span>
            <span class="av-stat__lbl">Autonomía vuelo</span>
          </li>
          <li class="av-stat av-stat--cyan">
            <span class="av-stat__num">12.8</span>
            <span class="av-stat__lbl">Stops dinámicos</span>
          </li>
          <li class="av-stat av-stat--lime">
            <span class="av-stat__num">48<sup>h</sup></span>
            <span class="av-stat__lbl">Entrega exprés</span>
          </li>
        </ul>
      </div>

      {/* Timecode marquee */}
      <div class="av-hero__marquee" aria-hidden="true">
        <div class="av-hero__marquee-track">
          {Array.from({length: 4}).map(() => (
            <>
              <span>REC ●</span><span>01:23:45:12</span>
              <span>★</span>
              <span>ISO 800</span><span>1/50</span><span>f/2.8</span>
              <span>★</span>
              <span>5120 × 2880</span><span>ProRes 422 HQ</span>
              <span>★</span>
              <span>AESA STS-01</span><span>A1/A3</span>
              <span>★</span>
            </>
          ))}
        </div>
      </div>
    </section>

    {/* ═══════════════ DRONE SPECS ═══════════════ */}
    <section class="av-drone-wrap">
      <div class="container-brutal">
        <header class="av-section-head">
          <span class="av-eyebrow av-eyebrow--red">Cap. 01 / Equipo</span>
          <h2 class="av-h2">
            DJI Mavic 3 Pro
            <em>·</em>
            <span class="av-h2__hl">calidad de cine</span>
            desde el aire.
          </h2>
          <p class="av-lead">
            Volamos con el dron prosumer más avanzado del mercado. Sensor Hasselblad,
            Apple ProRes, 43 minutos de autonomía y operadores certificados AESA.
          </p>
        </header>

        <div class="av-drone">
          <div class="av-drone__visual" aria-hidden="true">
            <svg viewBox="0 0 400 280" preserveAspectRatio="xMidYMid meet">
              <defs>
                <pattern id="av-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#00FF94" stroke-width=".5" opacity=".25"/>
                </pattern>
                <radialGradient id="av-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#FF0040" stop-opacity=".25"/>
                  <stop offset="100%" stop-color="#FF0040" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <rect width="400" height="280" fill="url(#av-grid)"/>

              {/* Crosshair central */}
              <line x1="0" y1="140" x2="400" y2="140" stroke="#00FF94" stroke-width=".5" opacity=".3"/>
              <line x1="200" y1="0" x2="200" y2="280" stroke="#00FF94" stroke-width=".5" opacity=".3"/>

              {/* Drone body */}
