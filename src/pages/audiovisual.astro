                {/* Motors */}
                <circle cx="-60" cy="-40" r="6" fill="#0E0D0B"/>
                <circle cx="60" cy="-40" r="6" fill="#0E0D0B"/>
                <circle cx="-60" cy="40" r="6" fill="#0E0D0B"/>
                <circle cx="60" cy="40" r="6" fill="#0E0D0B"/>

                {/* Body */}
                <rect x="-30" y="-18" width="60" height="36" rx="6" fill="#0E0D0B" stroke="#0E0D0B" stroke-width="2"/>
                {/* Camera gimbal */}
                <g transform="translate(0,22)">
