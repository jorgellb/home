  .av-hero__marquee-track span:nth-child(odd) { color: var(--c-red); }

  /* ─── Sección heads ─── */
  .av-section { padding: clamp(4rem, 8vw, 7rem) 0; }
  .av-section--alt { background: var(--c-paper); border-block: 3px solid var(--c-ink); }
  .av-section--dark { background: var(--c-ink); color: var(--c-paper); border-block: 3px solid var(--c-ink); position: relative; overflow: hidden; }
  .av-section--dark::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }
  .av-section--dark > .container-brutal { position: relative; z-index: 1; }

  .av-section-head { max-width: 760px; margin-bottom: 3rem; }
  .av-section-head--light { color: var(--c-paper); }
  .av-h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: .9;
    letter-spacing: -.04em;
    color: var(--c-ink);
    margin: 0 0 1rem;
    max-width: 18ch;
  }
  .av-h2--light { color: var(--c-paper); }
  .av-h2 em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--c-red);
  }
  .av-h2--light em { color: var(--c-yellow); }
  .av-h2__hl {
    display: inline-block;
    background: var(--c-yellow);
    color: var(--c-ink);
    padding: 0 .15em;
    transform: rotate(-1deg);
  }
  .av-lead { font-size: 1.05rem; line-height: 1.55; color: var(--brutal-text-secondary); max-width: 56ch; }
  .av-lead--light { color: rgba(255,252,246,.85); }
  .av-lead strong { color: var(--c-ink); }
  .av-lead--light strong { color: var(--c-paper); }

  /* ═══════════════ DRONE ═══════════════ */
  .av-drone-wrap {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: var(--c-ink);
    color: var(--c-paper);
    border-bottom: 3px solid var(--c-ink);
    position: relative;
    overflow: hidden;
  }
  .av-drone-wrap .av-section-head { color: var(--c-paper); }
  .av-drone-wrap .av-h2 { color: var(--c-paper); }
  .av-drone-wrap .av-h2 em { color: var(--c-green); }
  .av-drone-wrap .av-lead { color: rgba(255,252,246,.8); }
  .av-drone-wrap .av-eyebrow--red { background: var(--c-red); color: var(--c-paper); border-color: var(--c-paper); }
  .av-drone {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 1024px) { .av-drone { grid-template-columns: 1.1fr 1fr; gap: 4rem; } }

  .av-drone__visual {
    background: var(--c-ink);
    border: 2px solid var(--c-green);
    padding: 1rem;
    box-shadow: 10px 10px 0 var(--c-red);
    aspect-ratio: 10 / 7;
  }
  .av-drone__visual svg { width: 100%; height: 100%; display: block; }
  @keyframes av-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .av-prop { transform-origin: -60px -40px; animation: av-spin .15s linear infinite; }
  .av-prop--2 { transform-origin: 60px -40px; }
  .av-prop--3 { transform-origin: -60px 40px; }
  .av-prop--4 { transform-origin: 60px 40px; }
  @media (prefers-reduced-motion: reduce) {
    .av-prop { animation: none !important; }
  }

  .av-drone__specs {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--c-paper);
  }
  .av-drone__spec {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255,252,246,.2);
    background: var(--c-ink-2);
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 1rem;
    align-items: center;
  }
  .av-drone__spec:last-child { border-bottom: 0; }
  .av-drone__spec--0 { border-left: 4px solid var(--c-red); }
  .av-drone__spec--1 { border-left: 4px solid var(--c-yellow); }
  .av-drone__spec--2 { border-left: 4px solid var(--c-cyan); }
  .av-drone__spec--3 { border-left: 4px solid var(--c-lime); }
  .av-drone__spec--0 { border-left: 4px solid var(--c-red); }
  .av-drone__spec-k {
    font-family: var(--font-mono);
    font-size: .65rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--c-green);
    font-weight: 700;
  }
  .av-drone__spec-v {
    font-family: var(--font-mono);
    font-size: .82rem;
    color: var(--c-paper);
    line-height: 1.4;
  }

  /* ═══════════════ SERVICIOS (bento) ═══════════════ */
  .av-services {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) { .av-services { grid-template-columns: 1fr 1fr; } }
  .av-service {
    background: var(--c-paper);
    border: 3px solid var(--c-ink);
    padding: 2rem;
    display: flex; flex-direction: column;
    box-shadow: 6px 6px 0 var(--c-s, var(--c-red));
    transition: transform .25s, box-shadow .25s;
    position: relative;
  }
  .av-service:hover { transform: translate(-4px,-4px); box-shadow: 10px 10px 0 var(--c-s, var(--c-red)); }
  .av-service--red     { --c-s: var(--c-red); }
  .av-service--yellow  { --c-s: var(--c-yellow); }
  .av-service--cyan    { --c-s: var(--c-cyan); }
  .av-service--lime    { --c-s: var(--c-lime); }
  .av-service--magenta { --c-s: var(--c-magenta); }

  .av-service__head {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--c-ink);
  }
  .av-service__num {
    font-family: var(--font-mono);
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--c-s, var(--c-red));
    line-height: 1;
  }
  .av-service__icon { color: var(--c-s, var(--c-red)); }
  .av-service__icon svg { width: 56px; height: 42px; display: block; }
  .av-service__play { color: var(--c-s, var(--c-red)); }
  .av-service__play svg { width: 46px; height: 46px; display: block; }
  .av-service__kicker {
    font-family: var(--font-mono);
    font-size: .62rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--brutal-text-muted);
    margin-top: 1.25rem;
  }
  .av-service__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    line-height: .95;
    letter-spacing: -.03em;
    margin: .35rem 0 .75rem;
    color: var(--c-ink);
  }
  .av-service__desc { font-size: .95rem; line-height: 1.55; color: var(--brutal-text-secondary); margin: 0 0 1.5rem; }
  .av-service__features { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-direction: column; gap: .5rem; }
  .av-service__features li { font-family: var(--font-mono); font-size: .78rem; display: flex; gap: .55rem; align-items: baseline; color: var(--c-ink); }
  .av-service__check { color: var(--c-s, var(--c-red)); font-weight: 800; font-size: .85rem; }
  .av-service__foot { display: flex; justify-content: space-between; align-items: end; padding-top: 1rem; border-top: 2px solid var(--c-ink); margin-top: auto; }
  .av-service__figure { display: flex; flex-direction: column; line-height: 1; }
  .av-service__fig-val { font-family: var(--font-mono); font-size: 1.4rem; font-weight: 800; color: var(--c-ink); }
  .av-service__fig-lbl { font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; letter-spacing: .15em; color: var(--brutal-text-muted); margin-top: .35rem; }
  .av-service__cta {
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--c-s, var(--c-red));
    padding-bottom: .15em;
  }

  /* ═══════════════ COLOR + AUDIO ═══════════════ */
  .av-color-wrap {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: var(--c-paper);
    border-block: 3px solid var(--c-ink);
  }
  .av-color {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 900px) {
    .av-color { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  @media (min-width: 1200px) {
    .av-color { grid-template-columns: 1.2fr 1.2fr 1fr; }
  }

  /* Color wheels */
  .av-wheels {
    background: var(--c-ink);
    border: 3px solid var(--c-ink);
    padding: 1.5rem;
    box-shadow: 6px 6px 0 var(--c-red);
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }
  .av-wheel { display: flex; flex-direction: column; align-items: center; gap: .5rem; }
  .av-wheel__label { font-size: .58rem; color: var(--c-green); letter-spacing: .15em; font-weight: 800; }
  .av-wheel svg { width: 100%; height: auto; max-width: 100px; }
  .av-wheel__val { font-size: .8rem; color: var(--c-paper); background: rgba(255,255,255,.1); padding: .15rem .45rem; font-weight: 800; }

  /* Histogram */
  .av-histo {
    background: var(--c-paper);
    border: 3px solid var(--c-ink);
    padding: 1.25rem;
    box-shadow: 6px 6px 0 var(--c-yellow);
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }
  .av-histo header { display: flex; justify-content: space-between; align-items: center; padding-bottom: .55rem; border-bottom: 2px solid var(--c-ink); font-size: .65rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--c-ink); }
  .av-histo__zone { color: var(--c-red); background: rgba(255,0,64,.1); padding: .1rem .4rem; }
  .av-histo svg { width: 100%; height: 130px; display: block; }

  /* Mixer */
  .av-mixer {
    background: var(--c-ink);
    color: var(--c-paper);
    border: 3px solid var(--c-ink);
    padding: 1.25rem;
    box-shadow: 6px 6px 0 var(--c-cyan);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .av-mixer header { display: flex; justify-content: space-between; padding-bottom: .55rem; border-bottom: 2px solid rgba(255,252,246,.2); font-size: .62rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--c-green); }
  .av-mixer__sr { color: var(--c-yellow); }
  .av-mixer__channels { display: grid; grid-template-columns: repeat(4, 1fr); gap: .55rem; }
  .av-mixer__ch { display: flex; flex-direction: column; align-items: center; gap: .35rem; }
  .av-mixer__ch-lbl { font-size: .55rem; color: var(--c-cyan); font-weight: 800; letter-spacing: .12em; }
  .av-mixer__fader-track {
    position: relative;
    width: 18px;
    height: 110px;
    background: rgba(0,0,0,.5);
    border: 1px solid rgba(255,252,246,.2);
  }
  .av-mixer__meter {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column-reverse;
    padding: 1px;
  }
  .av-mixer__meter-fill {
    background: linear-gradient(0deg, var(--c-green) 0%, var(--c-green) 60%, var(--c-yellow) 75%, var(--c-red) 90%);
    width: 100%;
    transition: height .3s;
  }
  .av-mixer__knob {
    position: absolute;
    left: -4px;
    width: 26px;
    height: 8px;
    background: var(--c-yellow);
    border: 1.5px solid var(--c-ink);
  }
  .av-mixer__db, .av-mixer__pan { font-size: .55rem; color: var(--c-paper); opacity: .7; }
  .av-mixer__pan { color: var(--c-cyan); font-weight: 800; }

  /* ═══════════════ ASPECT RATIOS ═══════════════ */
  .av-ratios {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    background: var(--c-bg);
    border: 2px solid var(--c-ink);
  }
  .av-ratios__lbl { font-size: .65rem; font-weight: 800; letter-spacing: .15em; color: var(--c-red); }
  .av-ratio {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--c-paper);
    border: 2px solid var(--c-ink);
    padding: .35rem;
    transition: transform .25s;
    flex-shrink: 0;
  }
  .av-ratio:hover { transform: scale(1.08); }
  .av-ratio--vertical { width: 36px; height: 64px; }
  .av-ratio--square   { width: 56px; height: 56px; }
  .av-ratio--wide     { width: 80px; height: 45px; }
  .av-ratio--cinema   { width: 96px; height: 40px; background: var(--c-ink); color: var(--c-paper); }
  .av-ratio__num { font-family: var(--font-mono); font-size: .68rem; font-weight: 800; line-height: 1; }
  .av-ratio--cinema .av-ratio__num { color: var(--c-yellow); }
  .av-ratio__use { font-family: var(--font-mono); font-size: .42rem; font-weight: 700; letter-spacing: .1em; margin-top: .15rem; text-transform: uppercase; }

  /* ═══════════════ PROCESO claquetas ═══════════════ */
  .av-process {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .av-step {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.5rem;
    background: var(--c-paper);
    border: 3px solid var(--c-ink);
    padding: 1.75rem;
    box-shadow: 6px 6px 0 var(--c-s, var(--c-red));
    transition: transform .25s, box-shadow .25s;
    align-items: start;
  }
  .av-step:hover { transform: translate(-3px,-3px); box-shadow: 9px 9px 0 var(--c-s, var(--c-red)); }
  .av-step--red    { --c-s: var(--c-red); }
  .av-step--yellow { --c-s: var(--c-yellow); }
  .av-step--cyan   { --c-s: var(--c-cyan); }
  .av-step--lime   { --c-s: var(--c-lime); }

  .av-step__slate { color: var(--c-s, var(--c-red)); }
  .av-step__slate svg { width: 100%; height: auto; display: block; }
  .av-step__body { display: flex; flex-direction: column; gap: .65rem; }
  .av-step__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -.025em; color: var(--c-ink); margin: 0; line-height: 1; }
  .av-step__desc { font-size: 1rem; line-height: 1.55; color: var(--brutal-text-secondary); margin: 0; max-width: 54ch; }
  .av-step__deliv {
    margin-top: .5rem;
    padding: .65rem .85rem;
    background: var(--c-s, var(--c-red));
    color: var(--c-ink);
    border: 2px solid var(--c-ink);
    display: flex;
    flex-direction: column;
    gap: .15rem;
    align-self: flex-start;
  }
  .av-step--red .av-step__deliv { color: var(--c-paper); }
  .av-step__deliv span { font-size: .55rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
  .av-step__deliv strong { font-family: var(--font-display); font-weight: 800; font-size: .95rem; }

  /* ═══════════════ SECTORES ═══════════════ */
  .av-sectors {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 3px solid var(--c-ink);
    background: var(--c-ink);
  }
  @media (min-width: 640px) { .av-sectors { grid-template-columns: 1fr 1fr; gap: 3px; } }
  @media (min-width: 1024px) { .av-sectors { grid-template-columns: repeat(3, 1fr); } }
  .av-sector {
    padding: 2rem 1.75rem;
    background: var(--c-paper);
    color: var(--c-ink);
    display: flex; flex-direction: column; gap: .5rem;
    transition: background .25s, color .25s, padding .25s;
  }
  .av-sector:hover { padding-block: 2.25rem; }
  .av-sector--red:hover     { background: var(--c-red); color: var(--c-paper); }
  .av-sector--yellow:hover  { background: var(--c-yellow); }
  .av-sector--cyan:hover    { background: var(--c-cyan); }
  .av-sector--lime:hover    { background: var(--c-lime); }
  .av-sector--magenta:hover { background: var(--c-magenta); color: var(--c-paper); }
  .av-sector__num { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .15em; color: var(--c-red); font-weight: 700; }
  .av-sector:hover .av-sector__num { color: currentColor; opacity: .8; }
  .av-sector__title { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: -.02em; margin: .25rem 0; color: inherit; }
  .av-sector__desc { font-size: .88rem; line-height: 1.5; color: inherit; opacity: .85; margin: 0; }

  /* ═══════════════ PULL & QUOTES ═══════════════ */
  .av-pull {
    position: relative;
    background: var(--c-ink);
    color: var(--c-paper);
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    border: 3px solid var(--c-ink);
    box-shadow: 12px 12px 0 var(--c-red);
    margin: 0 0 3rem;
  }
  .av-pull__mark { position: absolute; top: -1rem; left: 1.5rem; font-family: var(--font-editorial); font-size: clamp(8rem, 14vw, 13rem); line-height: 1; color: var(--c-red); font-style: italic; user-select: none; }
  .av-pull__q { font-family: var(--font-editorial); font-style: italic; font-weight: 400; font-size: clamp(1.5rem, 3.4vw, 2.75rem); line-height: 1.2; color: var(--c-paper); max-width: 36ch; margin: 0; position: relative; z-index: 1; }
  .av-pull__cap { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--c-paper); display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .av-pull__avatar { width: 54px; height: 54px; display: inline-flex; align-items: center; justify-content: center; background: var(--c-yellow); color: var(--c-ink); font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; border: 2px solid var(--c-paper); }
  .av-pull__name { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; color: var(--c-paper); }
  .av-pull__role { display: block; font-family: var(--font-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .15em; color: rgba(255,252,246,.7); margin-top: .25rem; }
  .av-pull__metric { margin-left: auto; text-align: right; padding-left: 1rem; border-left: 2px solid var(--c-paper); }
  .av-pull__metric-v { font-family: var(--font-display); font-weight: 800; font-size: 2.5rem; color: var(--c-yellow); display: block; line-height: 1; }
  .av-pull__metric-l { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .14em; color: rgba(255,252,246,.7); display: block; margin-top: .25rem; }

  .av-quotes { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .av-quotes { grid-template-columns: repeat(3, 1fr); } }
  .av-quote {
    background: var(--c-paper);
    border: 3px solid var(--c-ink);
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: 1rem;
    box-shadow: 5px 5px 0 var(--c-q, var(--c-red));
    transition: transform .25s, box-shadow .25s;
  }
  .av-quote:hover { transform: translate(-3px,-3px); box-shadow: 8px 8px 0 var(--c-q, var(--c-red)); }
  .av-quote--cyan    { --c-q: var(--c-cyan); }
  .av-quote--lime    { --c-q: var(--c-lime); background: #F4FFD6; }
  .av-quote--magenta { --c-q: var(--c-magenta); background: #FFE3F1; }
  .av-quote p { font-family: var(--font-editorial); font-style: italic; font-size: 1rem; line-height: 1.4; color: var(--c-ink); margin: 0; flex: 1; }
  .av-quote footer { display: flex; gap: .75rem; align-items: center; padding-top: 1rem; border-top: 1px solid var(--brutal-border-soft); }
  .av-quote__avatar { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; background: var(--c-ink); color: var(--c-yellow); font-family: var(--font-display); font-weight: 800; font-size: 1rem; border: 2px solid var(--c-ink); flex-shrink: 0; }
  .av-quote__name { display: block; font-family: var(--font-display); font-weight: 800; font-size: .95rem; color: var(--c-ink); }
  .av-quote__role { display: block; font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; letter-spacing: .12em; color: var(--brutal-text-muted); margin-top: .2rem; }

  /* ═══════════════ FAQ ═══════════════ */
  .av-faq { list-style: none; padding: 0; margin: 2rem 0 0; border-top: 3px solid var(--c-ink); }
  .av-faq__item { border-bottom: 1px solid var(--c-ink); background: var(--c-paper); }
