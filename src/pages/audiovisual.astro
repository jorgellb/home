---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Productora Audiovisual en Almería | Video con Dron 4K y Fotografía Aérea';
const description = 'Productora audiovisual en Almería con dron Mavic 3 Pro 4K. Vídeo corporativo, reels, fotografía aérea y tours virtuales 360°. Presupuesto sin compromiso.';
const canonical = 'https://platanitorico.com/audiovisual/';

const services = [
  { n: '01', title: 'Vídeo corporativo con dron', kicker: 'Cinematográfico · 4K · Hasselblad', desc: 'Tomas aéreas cinematográficas combinadas con material terrestre 4K. Tu empresa vista desde una perspectiva que impacta y transmite profesionalidad a otro nivel.', features: ['Dron Mavic 3 Pro 4K','Cámaras terrestres profesionales','Edición y color grading','Música licenciada incluida','Entrega multi-formato'], figure: '5.1K', figureLabel: 'Resolución máxima', accent: 'accent' },
  { n: '02', title: 'Spot publicitario aéreo', kicker: 'Storyboard · Rodaje · Post', desc: 'Producción completa desde la idea hasta la entrega final. Storyboard, planificación de vuelo, rodaje con dron y cámara, y post-producción cinematográfica.', features: ['Pre-producción y storyboard','Guion creativo','Dron 4K + cámara terrestre','Color grading profesional','Versiones TV / web / RRSS'], figure: 'TV/Web/IG', figureLabel: 'Formatos entrega', accent: 'ink' },
  { n: '03', title: 'Tour virtual 360°', kicker: 'Inmersivo · Aéreo · Terrestre',     desc: 'Recorridos inmersivos que combinan perspectiva aérea y terrestre. Experiencia interactiva para que tus clientes visiten tu espacio sin moverse de casa.', features: ['Dron + cámara 360°','Hotspots interactivos','Compatible con VR','Hosting incluido','Integración en tu web'], figure: '360°', figureLabel: 'Vista inmersiva', accent: 'lime' },
  { n: '04', title: 'Pack tomas aéreas',         kicker: 'B-roll · RAW · Exprés',           desc: 'Pack de planos aéreos espectaculares listos para integrar en tus producciones. Material en bruto o editado según lo necesites.', features: ['Múltiples ángulos y alturas','Formatos 4K · 5.1K · 1080p','Color correction incluida','Entrega express en 48h','RAW bajo petición'], figure: '48h', figureLabel: 'Entrega express', accent: 'paper' },
];

const droneSpecs = [
  { k: 'Sensor',          v: 'Hasselblad 4/3 · 20 MP · 12.8 stops dinámicos' },
  { k: 'Vídeo',           v: 'Apple ProRes · 5.1K @ 50fps · 4K @ 120fps' },
  { k: 'Detección',       v: 'Omnidireccional · vuelo seguro entornos complejos' },
  { k: 'Autonomía',       v: '43 min · transmisión 15 km · viento ≤ 12 m/s' },
  { k: 'Operador',        v: 'Certificado AESA · seguro RC obligatorio' },
  { k: 'Espacio aéreo',   v: 'Gestión de permisos AESA / ENAIRE incluida' },
];

const reels = [
  { n: '05', title: 'Pack Reels con dron',  kicker: 'Reels · TikTok · Vertical',  desc: 'Reels optimizados para Instagram y TikTok con tomas aéreas que detienen el scroll. Contenido vertical impactante que genera engagement.', features: ['Formato 9:16 optimizado','Música trending','Subtítulos animados','Entrega rápida'], figure: '9:16', figureLabel: 'Formato', accent: 'lime' },
  { n: '06', title: 'Vídeo producto premium', kicker: 'Studio · Slider · Macro', desc: 'Showcase dinámico con planos cenitales, movimientos envolventes y transiciones profesionales que hacen brillar tu producto.', features: ['Dron + slider motorizado','Iluminación profesional','Motion graphics','Revisiones incluidas'], figure: 'Studio', figureLabel: 'Setup', accent: 'paper' },
];

const motion = [
  { n: '07', title: 'Logo Animation 3D', kicker: 'Branding · 3D · VFX',         desc: 'Tu marca cobra vida con animaciones cinematográficas. Intro profesional para tus vídeos, web y presentaciones que genera impacto instantáneo.', features: ['Animación 3D realista','Partículas y VFX','Render 4K','Formatos por plataforma'], figure: '3D', figureLabel: 'Render', accent: 'accent' },
  { n: '08', title: 'Vídeo explicativo animado', kicker: 'Motion · Locución · 2D/3D', desc: 'Combina vídeo real con motion graphics para comunicar mensajes complejos. Ideal para formación, producto o captación.', features: ['Guion creativo','Storyboard detallado','Animación 2D/3D','Locución profesional'], figure: '60s', figureLabel: 'Duración media', accent: 'ink' },
];

const sectores = [
  { title: 'Inmobiliarias',        desc: 'Vende propiedades con perspectivas aéreas que muestran ubicación, entorno y dimensiones reales. Tours 360° que filtran visitas.' },
  { title: 'Hostelería y turismo', desc: 'Hoteles, restaurantes y casas rurales mostrados desde el cielo. Genera reservas con contenido visual que enamora.' },
  { title: 'Construcción e industria', desc: 'Seguimiento de obra, inspección de infraestructuras y documentación aérea con precisión profesional.' },
  { title: 'Eventos y bodas',      desc: 'Captura momentos irrepetibles desde perspectivas cinematográficas. Recuerdo premium con tomas que sorprenden.' },
  { title: 'Agricultura',          desc: 'Inspección de cultivos, cartografía de parcelas y documentación visual para explotaciones agrícolas de Almería.' },
  { title: 'Deporte y aventura',   desc: 'Surf, senderismo, escalada, ciclismo... actividades al aire libre filmadas desde ángulos espectaculares.' },
];

const process = [
  { num: '01', title: 'Briefing creativo',     eta: '1 día',  body: 'Nos cuentas tu visión. Analizamos ubicación, tiempos y necesidades técnicas. Definimos el enfoque creativo juntos.', deliverable: 'Concepto + estilo visual' },
  { num: '02', title: 'Planificación de vuelo', eta: '2–4 días', body: 'Estudiamos espacio aéreo, gestionamos permisos AESA si son necesarios y elegimos las condiciones óptimas de luz y clima.', deliverable: 'Plan de vuelo + permisos' },
  { num: '03', title: 'Producción 4K',         eta: '1–2 días', body: 'Día de rodaje con Mavic 3 Pro y equipo terrestre. Múltiples tomas, ángulos y alturas para asegurar el material perfecto.', deliverable: 'Material en bruto + backup' },
  { num: '04', title: 'Post-producción',       eta: '5–10 días', body: 'Color grading cinematográfico, estabilización avanzada, edición narrativa y entrega en todos los formatos necesarios.', deliverable: 'Master + versiones · todos los formatos' },
];

const testimonials = [
  { text: 'Contratamos el dron para grabar nuestras propiedades en Vera Playa. El resultado fue espectacular: las tomas aéreas venden solas. Hemos duplicado las consultas desde que usamos estos vídeos en los portales.', author: 'Javier Ruiz',   role: 'Director · Inmobiliaria Vera Playa' },
  { text: 'Necesitábamos un vídeo corporativo para nuestro hotel en Mojácar. El equipo fue muy profesional, las tomas con dron le dieron un toque cinematográfico increíble.', author: 'Laura García',  role: 'Marketing · Hotel · Mojácar' },
  { text: 'El tour virtual 360° de nuestro restaurante ha sido un cambio total. Los clientes reservan después de ver el espacio. Calidad cine.', author: 'Antonio M.',  role: 'Propietario · Restaurante · Roquetas' },
  { text: 'Los reels que produjeron para nuestra marca de moda triplicaron el engagement en Instagram. Tomas aéreas + edición de calidad cine.', author: 'Marta P.',     role: 'Founder · Marca de moda · Almería' },
];

const faqs = [
  { q: '¿Necesitáis permisos para volar el dron?', a: 'Sí. Somos operadores certificados por AESA (Agencia Estatal de Seguridad Aérea). Gestionamos todos los permisos según ubicación y tipo de vuelo. Contamos con seguro de responsabilidad civil obligatorio. Tú no te preocupas de nada.' },
  { q: '¿En cuánto tiempo tengo el material listo?', a: 'Tomas aéreas sueltas: entrega express en 48h. Vídeo corporativo completo: 1–2 semanas. Spot publicitario con pre-producción: 2–3 semanas. Plazos acordados antes de empezar.' },
  { q: '¿Podéis volar en cualquier ubicación de Almería?', a: 'Volamos en toda la provincia: costa, interior, zonas urbanas y rurales. Hay restricciones en aeropuertos, zonas militares y parques naturales protegidos, pero en la mayoría de casos podemos operar con autorización. Lo evaluamos caso por caso.' },
  { q: '¿Qué calidad de vídeo ofrecéis?', a: 'Grabamos en 5.1K y 4K con el DJI Mavic 3 Pro y sensor Hasselblad. Para proyectos de cine y publicidad, Apple ProRes con 12.8 stops de rango dinámico. Calidad equiparable a producciones profesionales.' },
  { q: '¿Puedo usar el material en redes sociales, web y televisión?', a: 'Sí. Entregamos en los formatos que necesites: horizontal para web/TV, vertical para Instagram/TikTok, cuadrado para feeds. La música incluida está licenciada para uso comercial. Recibes todos los derechos.' },
  { q: '¿Trabajáis fuera de Almería?', a: 'Sí. Base en Almería pero nos desplazamos a cualquier punto de Andalucía y España. Para proyectos fuera de provincia, te hacemos presupuesto incluyendo desplazamiento.' },
  { q: '¿Qué pasa si el día de rodaje hace mal tiempo?', a: 'Si las condiciones meteorológicas no son seguras o afectan a la calidad (viento fuerte, lluvia), reprogramamos sin coste adicional. Monitorizamos la previsión con antelación y siempre tenemos fechas alternativas.' },
  { q: '¿Ofrecéis fotografía aérea además de vídeo?', a: 'Sí. El sensor Hasselblad de 20MP del Mavic 3 Pro captura fotos aéreas de calidad profesional. Entregamos en RAW y JPG editado. Muy demandado por inmobiliarias, constructoras y empresas turísticas.' },
];

const jsonLd = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Audiovisual","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico - Producción Audiovisual Almería","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","image":"https://platanitorico.com/imagenes/audiovisuales-dron-video.jpg","description":"Producción audiovisual con dron 4K DJI Mavic 3 Pro en Almería. Vídeo corporativo, spots, fotografía aérea y tours 360°.","address":{"@type":"PostalAddress","streetAddress":"Ctra de Ronda, 82","addressLocality":"Vera","addressRegion":"Almería","postalCode":"04620","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":"37.2450","longitude":"-1.8614"},"areaServed":[{"@type":"State","name":"Almería"},{"@type":"Country","name":"España"}],"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:00"},"hasOfferCatalog":{"@type":"OfferCatalog","name":"Servicios Audiovisuales con Dron","itemListElement":services.concat(reels).concat(motion).map(s=>({"@type":"Offer","itemOffered":{"@type":"Service","name":s.title,"description":s.desc}}))},"aggregateRating":{"@type":"AggregateRating","ratingValue":"5.0","reviewCount":"23","bestRating":"5","worstRating":"1"} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo se produce un vídeo profesional con dron en Almería","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  image="/imagenes/audiovisuales-dron-video.jpg"
  imageAlt="Producción audiovisual con dron 4K en Almería"
  type="service"
  lang="es"
  canonical={canonical}
  keywords="producción audiovisual almería, video dron almería, dron 4k almería, fotografía aérea almería, video corporativo almería"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Audiovisual' }]} />

  <main id="main-content">
    {/* HERO */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 011 — Servicio · Audiovisual</span>
          <span class="text-meta"><span class="live-dot"></span> Volando con Mavic 3 Pro</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Cap. 01 / Producción audiovisual</span>
            <h1 class="svc-hero__title">
              Vídeo con
              <em>dron 4K,</em>
              <span class="text-stroke-ink">spots,</span>
              fotografía aérea.
            </h1>
            <p class="svc-hero__lead">
              Producimos con un <strong>DJI Mavic 3 Pro · sensor Hasselblad 4/3</strong>
              y equipo terrestre profesional. Vídeo corporativo, spots,
              tours 360° y reels que detienen el scroll.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">
                Pedir presupuesto →
              </a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">
                657 085 019
              </a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">5.1K</span>
              <span class="svc-hero__spec-lbl">Resolución máx.</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">43min</span>
              <span class="svc-hero__spec-lbl">Autonomía vuelo</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">12.8</span>
              <span class="svc-hero__spec-lbl">Stops dinámicos</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">48h</span>
              <span class="svc-hero__spec-lbl">Entrega exprés</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ DJI MAVIC 3 PRO ★ HASSELBLAD 20MP ★ APPLE PRORES ★ 5.1K · 50FPS ★ DAVINCI ★</span>
          ))}
        </div>
      </div>
    </section>

    {/* SERVICIOS principales */}
    <section class="section-brutal" id="servicios">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Servicios</span>
            <h2 class="brutal-section-head__title">
              Producción
              <em>cinematográfica.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro formatos principales. Cada uno diseñado para un objetivo:
            transmitir profesionalidad, vender un producto, mostrar un espacio
            o aportar material a tu propia producción.
          </p>
        </header>

        <ol class="svc-bento">
          {services.map((s) => (
            <li class={`svc-card svc-card--${s.accent}`}>
              <header class="svc-card__head">
                <span class="svc-card__num">{s.n}</span>
                <span class="svc-card__kicker">{s.kicker}</span>
              </header>
              <h3 class="svc-card__title">{s.title}</h3>
              <p class="svc-card__desc">{s.desc}</p>
              <ul class="svc-card__features">
                {s.features.map((f) => (
                  <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{f}</span></li>
                ))}
              </ul>
              <footer class="svc-card__foot">
                <div class="svc-card__figure">
                  <span class="svc-card__figure-val">{s.figure}</span>
                  <span class="svc-card__figure-lbl">{s.figureLabel}</span>
                </div>
                <a href="/contacto" class="svc-card__cta">Pedir presupuesto →</a>
              </footer>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* DRON · DATA SHEET */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Equipo · DJI Mavic 3 Pro</span>
            <h2 class="brutal-section-head__title">
              Calidad
              <em>de cine,</em>
              desde el aire.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Volamos con un DJI Mavic 3 Pro · sensor Hasselblad 4/3 y vídeo Apple ProRes.
            Sin equipo profesional no hay calidad profesional. Aquí están las specs.
          </p>
        </header>

        <dl class="spec-list" style="max-width:760px;margin:2rem auto 0;">
          {droneSpecs.map((s) => (
            <div><dt class="spec-k">{s.k}</dt><dd class="spec-v">{s.v}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    {/* REELS + PRODUCTO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Social &amp; producto</span>
            <h2 class="brutal-section-head__title">
              Reels y vídeo
              <em>producto.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Contenido pensado para Instagram, TikTok y e-commerce. Vídeo vertical
            que detiene el scroll y showcases que hacen brillar lo que vendes.
          </p>
        </header>

        <ol class="svc-bento">
          {reels.map((s) => (
            <li class={`svc-card svc-card--${s.accent}`}>
              <header class="svc-card__head">
                <span class="svc-card__num">{s.n}</span>
                <span class="svc-card__kicker">{s.kicker}</span>
              </header>
              <h3 class="svc-card__title">{s.title}</h3>
              <p class="svc-card__desc">{s.desc}</p>
              <ul class="svc-card__features">
                {s.features.map((f) => (
                  <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{f}</span></li>
                ))}
              </ul>
              <footer class="svc-card__foot">
                <div class="svc-card__figure">
                  <span class="svc-card__figure-val">{s.figure}</span>
                  <span class="svc-card__figure-lbl">{s.figureLabel}</span>
                </div>
                <a href="/contacto" class="svc-card__cta">Solicitar →</a>
              </footer>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* MOTION */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Motion graphics</span>
            <h2 class="brutal-section-head__title">
              Animación &amp;
              <em>logo motion.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Tu marca animada con criterio: logo en 3D, vídeo explicativo,
            transiciones cinematográficas. Para presentaciones, web y RRSS.
          </p>
        </header>

        <ol class="svc-bento">
          {motion.map((s) => (
            <li class={`svc-card svc-card--${s.accent}`}>
              <header class="svc-card__head">
                <span class="svc-card__num">{s.n}</span>
                <span class="svc-card__kicker">{s.kicker}</span>
              </header>
              <h3 class="svc-card__title">{s.title}</h3>
              <p class="svc-card__desc">{s.desc}</p>
              <ul class="svc-card__features">
                {s.features.map((f) => (
                  <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{f}</span></li>
                ))}
              </ul>
              <footer class="svc-card__foot">
                <div class="svc-card__figure">
                  <span class="svc-card__figure-val">{s.figure}</span>
                  <span class="svc-card__figure-lbl">{s.figureLabel}</span>
                </div>
                <a href="/contacto" class="svc-card__cta">Solicitar →</a>
              </footer>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 06 / Método</span>
            <h2 class="brutal-section-head__title">
              Cómo se produce
              <em>un proyecto.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases con entregables claros. Desde el briefing creativo
            hasta el master final, sin sorpresas.
          </p>
        </header>

        <ol class="svc-process">
          {process.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < process.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* SECTORES */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 07 / Sectores</span>
            <h2 class="brutal-section-head__title">
              Quién contrata
              <em>nuestro dron.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Inmobiliarias, hoteles, productoras, eventos, agricultura, deporte.
            Cada sector tiene su uso del aéreo — nos adaptamos.
          </p>
        </header>

        <ul class="svc-sectors">
          {sectores.map((s, i) => (
            <li class={`svc-sector svc-sector--${i % 3}`}>
              <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
              <h3 class="svc-sector__title">{s.title}</h3>
              <p class="svc-sector__desc">{s.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* TESTIMONIOS */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
