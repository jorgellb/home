---
/* Aplicaciones móviles: raíz propia, no cuelga de /programador-web/.
 *
 * Quien busca desarrollo de apps no se describe como buscando un "programador
 * web", y meterla bajo esa rama daría una URL que contradice su propia
 * intención. Tampoco tiene páginas por municipio: el control de calidad no
 * aprobó ninguna porque ningún municipio reúne suficiente materia propia
 * sobre apps, y publicarlas igualmente sería exactamente lo que este clúster
 * evita. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Seccion from '../../components/programador/Seccion.astro';
import Marco from '../../components/programador/Marco.astro';
import Esquema from '../../components/programador/Esquema.astro';
import Diff from '../../components/programador/Diff.astro';
import Servicios from '../../components/programador/Servicios.astro';
import Enlaces from '../../components/programador/Enlaces.astro';
import Faq from '../../components/programador/Faq.astro';
import Cta from '../../components/programador/Cta.astro';
import { TECNOLOGIAS, rutaTecnologia } from '../../data/tecnologias';
import { SITE, PROVEEDOR } from '../../data/negocio';

const t = TECNOLOGIAS.apps;
const canonical = `${SITE}/desarrollo-aplicaciones-moviles/`;
const relacionadas = t.relacionadas.map((r) => TECNOLOGIAS[r]);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': 'Desarrollo de aplicaciones móviles',
    'serviceType': t.intencion,
    'url': canonical,
    'provider': PROVEEDOR,
    'areaServed': { '@type': 'AdministrativeArea', 'name': 'Provincia de Almería' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': t.faq.map((f) => ({
      '@type': 'Question',
      'name': f.q,
      'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
    })),
  },
];
---

<BaseLayout title={t.title} description={t.description} canonical={canonical} jsonLd={jsonLd}>
  <Header />
  <Marco>
  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Aplicaciones móviles' },
  ]} />

  <section class="hero">
    <div class="container-brutal hero__in">
      <div>
        <p class="pw-ref">tec.apps</p>
        <h1 class="hero__h1">{t.h1}</h1>
        <p class="hero__lead">{t.entradilla}</p>
        <p class="hero__para">Para <strong>{t.distintivo}</strong>.</p>
      </div>
      <Esquema tecnologia="apps" />
    </div>
  </section>

  <Seccion ref="01 · encargos" titulo="Cómo suelen llegar" tono="panel"
    lead="Descritos por lo que hace hoy el equipo, no por la tecnología que quieren.">
    <Diff situaciones={t.situaciones} />
  </Seccion>

  <Seccion ref="02 · repertorio" titulo="Qué desarrollamos">
    <Servicios servicios={t.servicios} />
  </Seccion>

  <Seccion ref="03 · antes" titulo="Antes de encargar una app" tono="panel">
    <p class="pw-p">
      Una app publicada es un compromiso que no acaba el día de la entrega: las tiendas
      cambian sus requisitos y una app que lleva dos años sin adaptarse acaba retirada.
      Por eso la primera conversación no es sobre tecnología, es sobre si hace falta.
    </p>
    <p class="pw-p">
      Si no se necesita cámara, avisos ni trabajar sin cobertura, una aplicación web
      instalable resuelve lo mismo sin pasar por ninguna tienda y se actualiza al momento.
      Cuando sí hace falta, se plantea como app y se dice cuánto cuesta mantenerla.
    </p>
  </Seccion>

  <Seccion ref="04 · alrededor" titulo="Con qué se combina">
    <Enlaces columnas={2} enlaces={[
      ...relacionadas.map((r) => ({
        href: rutaTecnologia(r.slug),
        texto: `Desarrollo con ${r.etiqueta}`,
        sub: `Para ${r.distintivo}.`,
      })),
      { href: '/programador-web/', texto: 'Programador web en Almería', sub: 'El resto de tecnologías' },
    ]} />
  </Seccion>

  <Seccion ref="05 · dudas" titulo="Preguntas frecuentes" tono="panel">
    <Faq faq={t.faq} />
  </Seccion>

  <Cta
    titulo="Explícame qué aplicación quieres construir"
    texto="Con saber quién la va a usar y en qué momento del día suele bastar para decir si hace falta una app o basta con una web instalable."
    servicio="Aplicaciones móviles"
  />
  </Marco>
  <Footer />
</BaseLayout>

<style>
  .hero { padding: clamp(2rem, 5vw, 3.25rem) 0 clamp(2.5rem, 5vw, 3.5rem); }
  .hero__in { display: grid; gap: clamp(1.75rem, 4vw, 3rem); align-items: center; }
  .hero__h1 { font-size: clamp(2rem, 5.2vw, 3.2rem); font-weight: 800; letter-spacing: -.04em; line-height: 1.02; margin: .4rem 0 1.1rem; }
  .hero__lead { max-width: 52ch; font-size: 1.07rem; line-height: 1.65; margin: 0 0 .9rem; }
  .hero__para { margin: 0; color: var(--pw-tenue); font-size: .95rem; }
  .hero__para strong { color: var(--pw-luego); font-weight: 600; }
  .pw-p { line-height: 1.7; max-width: 68ch; margin: 0 0 1rem; }
  @media (min-width: 960px) { .hero__in { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); } }
</style>
