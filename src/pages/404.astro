---
import Sitio from '../layouts/Sitio.astro';
import Boton from '../components/sitio/Boton.astro';
import Ilustracion from '../components/sitio/Ilustracion.astro';
import { SERVICIOS } from '../data/navegacion';
---

<Sitio title="Página no encontrada" description="La página que buscas no existe o ha cambiado de dirección." noindex>
  <section class="contenedor no-encontrada">
    <Ilustracion nombre="pueblo" class="no-encontrada__ilustracion" />
    <p class="antetitulo">Error 404</p>
    <h1>Esta página se ha perdido por el camino</h1>
    <p class="entradilla">Puede que la hayamos movido al rediseñar la web. Prueba desde aquí:</p>
    <div class="no-encontrada__acciones">
      <Boton href="/">Ir al inicio</Boton>
      <Boton href="/contacto/" variante="secundario">Escríbenos</Boton>
    </div>
    <ul class="no-encontrada__enlaces">
      {SERVICIOS.map((s) => <li><a href={s.href}>{s.nombre}</a></li>)}
      <li><a href="/diseno-web/">Municipios</a></li>
      <li><a href="/blog/">Blog</a></li>
    </ul>
  </section>
</Sitio>

<style>
  .no-encontrada {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding-block: var(--seccion);
    text-align: center;
  }
  .no-encontrada h1 {
    font-size: var(--t-3xl);
    max-width: 18ch;
  }
  .no-encontrada :global(.no-encontrada__ilustracion) {
    max-width: 320px;
  }
  .no-encontrada__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .no-encontrada__enlaces {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    max-width: 44rem;
  }
  .no-encontrada__enlaces a {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--linea-2);
    background: var(--superficie);
    font-size: var(--t-s);
    font-weight: 600;
    text-decoration: none;
  }
  .no-encontrada__enlaces a:hover {
    border-color: var(--verde);
    color: var(--verde);
  }
</style>
