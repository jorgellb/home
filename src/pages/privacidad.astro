---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Boton from '../components/cdm/Boton.astro';

const title = "Política de Privacidad | Platanito Rico";
const description = "Política de privacidad y protección de datos conforme al RGPD.";
const lastUpdate = "febrero 2026";
const docId = "PR-2026-028";

const toc = [
  { n: '01', id: 's1', label: 'Responsable del tratamiento' },
  { n: '02', id: 's2', label: 'Finalidad del tratamiento' },
  { n: '03', id: 's3', label: 'Legitimación' },
  { n: '04', id: 's4', label: 'Plazo de conservación' },
  { n: '05', id: 's5', label: 'Destinatarios' },
  { n: '06', id: 's6', label: 'Tus derechos (ARSOPOL)' },
  { n: '07', id: 's7', label: 'Medidas de seguridad' },
];
---

<BaseLayout title={title} description={description} noindex={true}>
  <Header />

  <main id="main-content" class="legal">
    {/* Gaceta superior */}
    <div class="legal-gazette" aria-hidden="true">
      <div class="legal-gazette__track">
        {Array.from({length: 4}).map(() => (
          <>
            <span>Documento Oficial</span><span>★</span>
            <span>Política de Privacidad</span><span>★</span>
            <span>RGPD · LOPDGDD · UE 2016/679</span><span>★</span>
            <span>Vigente · {lastUpdate}</span><span>★</span>
            <span>ID · {docId}</span><span>★</span>
          </>
        ))}
      </div>
    </div>

    {/* Masthead */}
    <section class="legal-mast">
      <div class="container-brutal">
        <header class="legal-mast__head">
          <span class="legal-mast__edition">N.º 028 — Documentos Oficiales · Vol. 2026</span>
          <span class="legal-mast__edition">★ Vigente desde {lastUpdate}</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="legal-mast__doc">
          <div>
            <span class="legal-mast__num">028</span>
            <h1 class="legal-mast__title">
              Política de
              <em>privacidad.</em>
            </h1>
          </div>
          <div style="display:flex;gap:1rem;flex-wrap:wrap;">
            <div class="legal-seal">
              <span class="legal-seal__star">★</span>
              <span class="legal-seal__line">CUMPLE</span>
              <span class="legal-seal__line legal-seal__line--big">RGPD</span>
              <span class="legal-seal__line">UE 2016/679</span>
            </div>
            <div class="legal-seal legal-seal--ink">
              <span class="legal-seal__star">∅</span>
              <span class="legal-seal__line">SIN</span>
              <span class="legal-seal__line legal-seal__line--big">TRACKING</span>
              <span class="legal-seal__line">Tu visita es privada</span>
            </div>
          </div>
        </div>

        <p class="legal-mast__intro">
          Nos tomamos en serio la privacidad de tus datos. Este documento describe
          cómo recogemos, usamos y protegemos tu información personal — en cumplimiento
          con el RGPD y la LOPDGDD.
        </p>

        <dl class="legal-mast__spec">
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Documento</dt>
            <dd class="legal-mast__spec-v">{docId}</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Última actualización</dt>
            <dd class="legal-mast__spec-v">{lastUpdate}</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Responsable</dt>
            <dd class="legal-mast__spec-v">Jorge L. López Barrio</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Tiempo de lectura</dt>
            <dd class="legal-mast__spec-v">~4 minutos</dd>
          </div>
        </dl>
      </div>
    </section>

    {/* Layout: TOC + cuerpo */}
    <div class="container-brutal">
      <div class="legal-grid">
        {/* TOC sticky */}
        <aside class="legal-toc" aria-label="Índice del documento">
          <header class="legal-toc__head">
            <span class="text-meta">Índice</span>
            <span class="text-meta">{toc.length} secciones</span>
          </header>
          <ol class="legal-toc__list">
            {toc.map((t) => (
              <li class="legal-toc__item">
                <a href={`#${t.id}`} class="legal-toc__link" data-toc-link>
                  <span class="legal-toc__num">{t.n}</span>
                  <span>{t.label}</span>
                </a>
              </li>
            ))}
          </ol>

          <div class="legal-toc__seals">
            <button type="button" class="legal-toc__action" onclick="window.print()">
              ⎙ Imprimir documento
            </button>
            <a href="/contacto/" class="legal-toc__action">
              ✎ Ejercer mis derechos
            </a>
          </div>
        </aside>

        {/* Artículo */}
        <article class="legal-article">
          <div class="legal-highlight">
            <div class="legal-highlight__icon">★</div>
            <div class="legal-highlight__body">
              <h2 class="legal-highlight__title">Transparencia total · sin seguimiento</h2>
              <p>
                Este sitio web <strong>NO utiliza Google Analytics, píxeles de Meta ni ninguna herramienta de rastreo o marketing</strong>
                que recopile datos de navegación. Tu visita es privada. Solo recopilamos lo que tú nos
                proporcionas voluntariamente para contactar o contratar servicios.
              </p>
            </div>
          </div>

          <p>
            En Platanito Rico nos tomamos muy en serio la privacidad de tus datos. Esta Política de Privacidad
            describe cómo recogemos, usamos y protegemos tu información personal en cumplimiento con el
            <strong> Reglamento General de Protección de Datos (RGPD)</strong> y la
            <strong> Ley Orgánica 3/2018 de Protección de Datos Personales y garantía de los derechos digitales (LOPDGDD)</strong>.
          </p>

          {/* 01 */}
          <section id="s1" class="legal-section">
            <span class="legal-section__num">N.º 01</span>
            <h2 class="legal-section__title">
              Responsable
              <em>del tratamiento.</em>
            </h2>

            <div class="legal-datasheet">
              <header class="legal-datasheet__head">
                <span>Ficha del responsable</span>
                <span>RGPD · Art. 13</span>
              </header>
              <ul class="legal-datasheet__list">
                <li><span class="legal-datasheet__k">Responsable</span><span class="legal-datasheet__v">Jorge Luis López Barrio</span></li>
                <li><span class="legal-datasheet__k">NIF</span><span class="legal-datasheet__v">05298279E</span></li>
                <li><span class="legal-datasheet__k">Dirección</span><span class="legal-datasheet__v">Alborada 3, 04621 Vera Playa, Almería · España</span></li>
                <li><span class="legal-datasheet__k">Email contacto</span><span class="legal-datasheet__v"><a href="mailto:hola@platanitorico.com">hola@platanitorico.com</a></span></li>
              </ul>
            </div>
          </section>

          {/* 02 */}
          <section id="s2" class="legal-section">
            <span class="legal-section__num">N.º 02</span>
            <h2 class="legal-section__title">
              Finalidad
              <em>del tratamiento.</em>
            </h2>

            <p>Tratamos la información que nos facilitan las personas interesadas con las siguientes finalidades:</p>
            <ol>
              <li>
                <strong>Gestión de consultas (formulario de contacto):</strong> Atender solicitudes de información,
                dudas o presupuestos a través del formulario o email. <em>Datos: nombre, email, teléfono, mensaje.</em>
              </li>
              <li>
                <strong>Gestión de clientes:</strong> En caso de contratación, para la gestión administrativa, fiscal
                y contable, así como para prestar el servicio contratado. <em>Datos: nombre completo, NIF/CIF,
                dirección postal, datos bancarios si procede.</em>
              </li>
              <li>
                <strong>Comunicaciones comerciales:</strong> <strong>Exclusivamente</strong> si has dado tu
                consentimiento expreso (marcando una casilla específica de suscripción), para enviarte novedades
                sobre nuestros servicios.
              </li>
            </ol>
          </section>

          <blockquote class="legal-pull">
            "Tus datos son tuyos. Nuestro trabajo es <em>protegerlos</em>, no monetizarlos."
          </blockquote>

          {/* 03 */}
          <section id="s3" class="legal-section">
            <span class="legal-section__num">N.º 03</span>
            <h2 class="legal-section__title">
              Legitimación
              <em>· bases legales.</em>
            </h2>
            <p>La base legal para el tratamiento de tus datos es:</p>
            <ul>
              <li><strong>Consentimiento del interesado:</strong> Para responder a las consultas enviadas a través del formulario.</li>
              <li><strong>Ejecución de un contrato:</strong> Si nos contratas, el tratamiento es necesario para prestar el servicio.</li>
              <li><strong>Obligación legal:</strong> Para la facturación y declaración de impuestos.</li>
            </ul>
          </section>

          {/* 04 */}
          <section id="s4" class="legal-section">
            <span class="legal-section__num">N.º 04</span>
            <h2 class="legal-section__title">
              Plazo de
              <em>conservación.</em>
            </h2>
            <ul>
              <li>
                <strong>Datos de contacto:</strong> Se conservan durante el tiempo necesario para atender la solicitud y,
                después, durante un plazo prudencial por si surgieran nuevas consultas. Si eres cliente, mientras dure
                la relación comercial.
              </li>
              <li>
                <strong>Datos fiscales (facturas):</strong> Se conservan durante <strong>5 años</strong> por obligación
                legal tributaria.
              </li>
            </ul>
          </section>

          {/* 05 */}
          <section id="s5" class="legal-section">
            <span class="legal-section__num">N.º 05</span>
            <h2 class="legal-section__title">
              Destinatarios
              <em>de los datos.</em>
            </h2>
            <p>
              Tus datos <strong>no se ceden a terceros</strong> salvo obligación legal. Para prestar nuestros servicios,
              compartimos datos con proveedores que actúan como <strong>Encargados del Tratamiento</strong> y se
              comprometen al cumplimiento de la normativa:
            </p>
            <ul>
              <li><strong>Hosting:</strong> Proveedor de alojamiento web (servidores ubicados en la UE).</li>
              <li><strong>Gestoría y facturación:</strong> Herramientas de facturación y asesoría fiscal para cumplir obligaciones tributarias.</li>
            </ul>
            <p>
              <strong>Encargado de tratamiento:</strong> En el desarrollo de servicios para nuestros clientes
              (ej. mantenimiento web) podemos tener acceso a datos personales de terceros bajo la responsabilidad
              del cliente. Actuamos como Encargados de Tratamiento, siguiendo sus instrucciones y garantizando
              la confidencialidad.
            </p>
          </section>

          {/* 06 — Derechos como bento brutal */}
          <section id="s6" class="legal-section">
            <span class="legal-section__num">N.º 06</span>
            <h2 class="legal-section__title">
              Tus
              <em>derechos.</em>
              <span style="font-family:var(--font-mono);font-size:.45em;color:var(--brutal-accent-ink);letter-spacing:.2em;display:block;margin-top:.5rem">ARSOPOL</span>
            </h2>
            <p>
              Cualquier persona tiene derecho a obtener confirmación sobre si estamos tratando datos personales
              que les conciernan, y a ejercer los siguientes derechos:
            </p>

            <ul class="legal-bento">
              <li>
                <span class="legal-bento__num">A · Acceso</span>
                <h3 class="legal-bento__t">Acceder a tus datos</h3>
                <p class="legal-bento__d">Saber qué datos tuyos guardamos y para qué.</p>
              </li>
              <li>
                <span class="legal-bento__num">R · Rectificación</span>
                <h3 class="legal-bento__t">Corregir errores</h3>
                <p class="legal-bento__d">Pedir que rectifiquemos cualquier dato inexacto.</p>
              </li>
              <li>
                <span class="legal-bento__num">S · Supresión</span>
                <h3 class="legal-bento__t">Borrar tus datos</h3>
                <p class="legal-bento__d">El "derecho al olvido": que eliminemos tus datos.</p>
              </li>
              <li>
                <span class="legal-bento__num">O · Oposición</span>
                <h3 class="legal-bento__t">Oponerte al tratamiento</h3>
                <p class="legal-bento__d">Decir que dejemos de tratar tus datos.</p>
              </li>
              <li>
                <span class="legal-bento__num">P · Portabilidad</span>
                <h3 class="legal-bento__t">Llevarte tus datos</h3>
                <p class="legal-bento__d">Recibirlos en formato estructurado para otro proveedor.</p>
              </li>
              <li>
                <span class="legal-bento__num">L · Limitación</span>
                <h3 class="legal-bento__t">Limitar el tratamiento</h3>
                <p class="legal-bento__d">Bloquear temporalmente el uso de tus datos.</p>
              </li>
            </ul>

            <p>
              Para ejercer estos derechos, envía un correo a
              <a href="mailto:hola@platanitorico.com">hola@platanitorico.com</a>
              adjuntando una copia de tu DNI o documento equivalente. Respondemos en un plazo máximo de
              <strong>30 días</strong>.
            </p>
          </section>

          {/* 07 */}
          <section id="s7" class="legal-section">
            <span class="legal-section__num">N.º 07</span>
            <h2 class="legal-section__title">
              Medidas de
              <em>seguridad.</em>
            </h2>
            <p>
              Hemos adoptado las medidas técnicas y organizativas necesarias para garantizar la seguridad de
              tus datos personales y evitar su alteración, pérdida, tratamiento o acceso no autorizado — habida
              cuenta del estado de la tecnología, la naturaleza de los datos almacenados y los riesgos a que
              están expuestos. <strong>Todo el tráfico está cifrado mediante protocolo SSL (HTTPS)</strong>.
            </p>
          </section>

          {/* Colophon */}
          <footer class="legal-colophon">
            <div class="legal-colophon__text">
              Documento oficial <strong>{docId}</strong>.<br/>
              Versión vigente desde <strong>{lastUpdate}</strong>.<br/>
              Responsable del tratamiento: <strong>Jorge L. López Barrio · NIF 05298279E</strong>.
            </div>
            <div class="legal-colophon__sig">
              <span class="legal-colophon__sig-name">Jorge L. López</span>
              <span class="legal-colophon__sig-role">Responsable · Platanito Rico</span>
            </div>
          </footer>
        </article>
      </div>
    </div>

    {/* CTA final */}
    <section class="legal-final">
      <div class="container-brutal">
        <div class="legal-final__inner">
          <span class="text-meta">★ ¿Quieres ejercer tus derechos?</span>
          <h2 class="legal-final__title">
            Tus datos,
            <em>tu decisión.</em>
          </h2>
          <p class="legal-final__text">
            Si quieres ejercer cualquiera de tus derechos ARSOPOL, escríbenos y
            respondemos en menos de 24h. Si no nos respondes en 30 días, tienes
            derecho a reclamar ante la <strong>AEPD</strong> en
            <a href="https://aepd.es" target="_blank" rel="noopener noreferrer" style="color:var(--brutal-lime);text-decoration-color:var(--brutal-accent);">aepd.es</a>.
          </p>
          <div class="legal-final__btns">
            <Boton href="mailto:hola@platanitorico.com">
              hola@platanitorico.com →
            </Boton>
            <Boton href="/contacto/" variante="linea">
              Formulario de contacto
            </Boton>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Scroll spy para TOC
  const links = document.querySelectorAll('[data-toc-link]');
  const sections = Array.from(links).map(a => document.querySelector(a.getAttribute('href') || ''));
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        links.forEach(l => l.classList.toggle('is-active', l.getAttribute('href') === `#${id}`));
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(s => s && observer.observe(s));
</script>
