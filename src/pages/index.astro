---
import { getCollection } from 'astro:content';
import Sitio from '../layouts/Sitio.astro';
import Boton from '../components/sitio/Boton.astro';
import Icono from '../components/sitio/Icono.astro';
import type { NombreEscena } from '../lib/escenas';
import Ilustracion from '../components/sitio/Ilustracion.astro';
import IconoServicio from '../components/sitio/IconoServicio.astro';
import IconoIso from '../components/sitio/IconoIso.astro';
import Cifras from '../components/sitio/Cifras.astro';
import Encabezado from '../components/sitio/Encabezado.astro';
import Pasos from '../components/sitio/Pasos.astro';
import Casos from '../components/sitio/Casos.astro';
import Preguntas from '../components/sitio/Preguntas.astro';
import Guia from '../components/sitio/Guia.astro';
import LlamadaFinal from '../components/sitio/LlamadaFinal.astro';
import { SERVICIOS } from '../data/navegacion';
import { CIFRAS, PROVEEDOR, SITE } from '../data/negocio';
import { comarcas, getPueblosByComarca } from '../data/pueblos-almeria';
import { esPuebloIndexable } from '../data/pueblos-indexables';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
const fecha = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const valoracion = String(CIFRAS.valoracion).replace('.', ',');

/* Problemas que resolvemos: se habla del negocio, no de la tecnología. */
const problemas: { t: string; d: string; escena: NombreEscena; solucion: string; href: string }[] = [
  { t: 'No te encuentran en Google', d: 'Tu competencia sale antes en búsquedas y en el mapa, aunque tú lo hagas mejor. Casi siempre es cuestión de estructura, ficha de Google y contenido local.', escena: 'marketing', solucion: 'SEO local y ficha de Google trabajados a fondo', href: '/marketing/' },
  { t: 'Tu web no convierte', d: 'Recibe visitas, pero no llamadas. Suele fallar lo básico: tarda en cargar en el móvil, no dice claro qué haces o esconde el teléfono.', escena: 'web', solucion: 'Una web rápida, clara y pensada para que te contacten', href: '/desarrollo-web/' },
  { t: 'La informática te frena', d: 'Equipos lentos, copias que nadie comprueba y un wifi que se cae. Son horas de trabajo perdidas cada semana, y nadie las está contando.', escena: 'informatica', solucion: 'Mantenimiento con técnico en tu empresa el mismo día', href: '/informatica-empresas/' },
];

/* Piezas grandes del bento de servicios (el resto, con su icono isométrico). */
const GRANDES: Record<string, { forma: 'cuadrada' | 'ancha'; tono: 'verde' | 'calida' | 'tinta' | 'cielo' }> = {
  web: { forma: 'cuadrada', tono: 'verde' },
  tienda: { forma: 'ancha', tono: 'calida' },
  marketing: { forma: 'ancha', tono: 'cielo' },
  informatica: { forma: 'ancha', tono: 'tinta' },
};

/* Guía de valor: lo que debe tener cualquier web antes de pagar por ella. */
const comprobaciones = [
  { t: 'Carga en menos de 2,5 segundos en un móvil', d: 'Es el límite de Google para considerar buena una página (LCP). Compruébalo gratis en PageSpeed Insights.' },
  { t: 'El dominio, el hosting y el código son tuyos', d: 'A tu nombre y con acceso total. Si mañana cambias de proveedor, te llevas todo sin pedir permiso.' },
  { t: 'Se entiende qué haces en 5 segundos', d: 'Servicio, zona y forma de contacto visibles sin bajar. Si hay que buscarlos, el visitante se va.' },
  { t: 'Tiene una página por servicio y por zona', d: 'Una sola página de inicio no puede posicionar «fontanero en Vera» y «fontanero en Mojácar» a la vez.' },
  { t: 'Cumple la ley: RGPD, LSSI y accesibilidad', d: 'Aviso legal, privacidad y cookies correctos. Desde 2025 la accesibilidad también obliga a muchos negocios.' },
  { t: 'Mide lo que pasa', d: 'Cuántas llamadas, formularios y WhatsApp llegan desde la web. Sin ese dato es imposible mejorar.' },
];

const pasos = [
  { t: 'Te escuchamos', d: 'Media hora para entender tu negocio, tus clientes y qué tiene que pasar para que esto merezca la pena.', cuando: 'Día 1' },
  { t: 'Propuesta por escrito', d: 'Qué haremos, en qué plazo y qué entregamos. Sin letra pequeña ni permanencias.', cuando: 'Día 3' },
  { t: 'Diseño que apruebas', d: 'Ves el diseño antes de programar y sigues el avance en un entorno de pruebas.', cuando: 'Semanas 1-3' },
  { t: 'Lanzamiento y seguimiento', d: 'Publicamos, damos de alta tu ficha de Google, te enseñamos a usarla y medimos los resultados.', cuando: 'Semana 4+' },
];

const opiniones = [
  { texto: 'Desde el diseño de nuestra web hasta su mantenimiento, han demostrado un profesionalismo y una dedicación excepcionales.', autor: 'Ana Padilla', cargo: 'Directora, Clínica Dental Koral' },
  { texto: 'Nuestra inmobiliaria en Vera Playa necesitaba captar clientes internacionales. El portal es impecable y recibimos contactos a diario.', autor: 'Javier Ruiz', cargo: 'Inmobiliaria, Vera Playa' },
  { texto: 'La creación de nuestra web corporativa fue un proceso impecable. El equipo captó a la perfección nuestros valores.', autor: 'Juan Poveda', cargo: 'Empresa, Almería' },
];

const preguntas = [
  { q: '¿Cuánto cuesta una web?', a: '<p>Depende de lo que necesites que haga: no es lo mismo una web para que te llamen que una tienda con 500 productos. Por eso no damos una cifra a ciegas: tras la primera llamada recibes una propuesta cerrada por escrito, con el plazo y lo que incluye, y sin sorpresas después.</p>' },
  { q: '¿Cuánto tarda en estar lista?', a: '<p>Una web de servicios suele estar publicada en tres o cuatro semanas. Una tienda online o un proyecto a medida, entre seis y doce. El plazo concreto va en la propuesta y lo cumplimos siempre que las revisiones lleguen a tiempo.</p>' },
  { q: '¿La web será mía?', a: '<p>Sí, entera: dominio, hosting, código y contenidos, a tu nombre. Si un día decides irte, te lo entregamos todo. Nuestros clientes se quedan porque funciona, no porque estén atados.</p>' },
  { q: '¿Trabajáis fuera de Vera?', a: '<p>Trabajamos con negocios de toda la provincia de Almería: el Levante, el Almanzora, la capital y el Poniente. En el Levante y el Almanzora podemos ir en persona el mismo día; en el resto, nos vemos por videollamada o cuando haga falta.</p>' },
  { q: '¿Y después de publicarla?', a: '<p>Puedes llevarla tú (te enseñamos) o dejarla en nuestras manos con el <a href="/soporte/">mantenimiento</a>: copias diarias, actualizaciones de seguridad y cambios cuando los necesites, sin tickets ni esperas.</p>' },
];

const cinta = comarcas.flatMap((c) => getPueblosByComarca(c).filter((p) => esPuebloIndexable(p.slug)));

const zonas = comarcas
  .map((c) => ({ comarca: c, pueblos: getPueblosByComarca(c).filter((p) => esPuebloIndexable(p.slug)) }))
  .filter((z) => z.pueblos.length > 0);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    ...PROVEEDOR,
    name: 'Platanito Rico',
    description: 'Estudio digital en Vera (Almería): diseño web, tiendas online, marketing y SEO local, informática para empresas y producción audiovisual.',
    logo: `${SITE}/favicon.svg`,
    image: `${SITE}/imagenes/og-platanito-rico.png`,
    sameAs: ['https://www.instagram.com/platanitorico/', 'https://www.linkedin.com/company/platanitorico/'],
    geo: { '@type': 'GeoCoordinates', latitude: 37.2471, longitude: -1.8673 },
    foundingDate: String(CIFRAS.anioFundacion),
    areaServed: { '@type': 'AdministrativeArea', name: 'Provincia de Almería' },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: String(CIFRAS.valoracion), reviewCount: String(CIFRAS.numResenas), bestRating: '5', worstRating: '1' },
    review: opiniones.map((o) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: o.autor },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      reviewBody: o.texto,
    })),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios',
      itemListElement: SERVICIOS.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.nombre, description: s.resumen, url: `${SITE}${s.href}` } })),
    },
    openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '18:00' },
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Platanito Rico', url: SITE, inLanguage: 'es-ES' },
];
---

<Sitio
  title="Diseño web, marketing e informática en Almería | Platanito Rico"
  description="Estudio digital en Vera (Almería). Webs a medida que cargan rápido y traen clientes, SEO local, tiendas online e informática para empresas. Hablas con quien hace el trabajo."
  canonical={`${SITE}/`}
  jsonLd={jsonLd}
>
  <!-- PORTADA -->
  <section class="portada">
    <div class="portada__luces" aria-hidden="true"></div>
    <div class="contenedor portada__rejilla">
      <div class="portada__texto">
        <p class="antetitulo">Estudio digital en Almería · desde {CIFRAS.anioFundacion}</p>
        <h1>Webs que traen <span class="subrayado">clientes</span> a tu negocio</h1>
        <p class="entradilla">
          Diseñamos webs rápidas, las posicionamos en Google y cuidamos la informática de tu empresa.
          Un solo equipo en Vera, para negocios de toda la provincia.
        </p>
        <div class="portada__acciones">
          <Boton href="/contacto/">Cuéntanos tu proyecto</Boton>
          <Boton href="#servicios" variante="secundario" icono="flecha-abajo">Ver qué hacemos</Boton>
        </div>
        <p class="portada__sello">
          <span class="estrellas" aria-hidden="true">★★★★★</span>
          <span><b>{valoracion}</b> en {CIFRAS.numResenas} reseñas de Google</span>
        </p>
      </div>
      <div class="portada__escena fondo-iso">
        <Ilustracion nombre="portada" titulo="Diorama isométrico: el estudio de Vera conectado con una web, un móvil y los clientes que llegan" class="portada__ilustracion" prioridad />
        <span class="flotante flotante--1"><IconoIso nombre="pincel" tono="verde" tamano={34} />Diseño a medida</span>
        <span class="flotante flotante--2" style="--retraso:-2.3s"><IconoIso nombre="ubicacion" tono="platano" tamano={34} />SEO local</span>
        <span class="flotante flotante--3" style="--retraso:-4.6s"><IconoIso nombre="llave" tono="tinta" tamano={34} />Todo a tu nombre</span>
      </div>
    </div>
  </section>

  <div class="cinta" aria-label="Municipios donde trabajamos">
    <ul class="cinta__pista">
      {[...cinta, ...cinta].map((p, i) => (
        <li aria-hidden={i >= cinta.length ? 'true' : undefined}>
          <a href={`/diseno-web/${p.slug}/`} tabindex={i >= cinta.length ? -1 : undefined}>{p.nombre}</a>
        </li>
      ))}
    </ul>
  </div>

  <Cifras />

  <!-- PROBLEMAS -->
  <section class="seccion seccion--blanca" aria-labelledby="problemas-titulo">
    <div class="contenedor">
      <Encabezado
        id="problemas-titulo"
        antetitulo="Lo que nos piden"
        titulo="Casi todos llegan con uno de estos tres problemas"
        entradilla="Antes de hablar de tecnología, hablamos de lo que le pasa a tu negocio. Estos son los tres que más vemos en Almería."
      />
      <ol class="problemas">
        {problemas.map((p, i) => (
          <li class="problema" data-aparece>
            <span class="problema__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="problema__texto">
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
            <a href={p.href} class="problema__solucion tarjeta-hover">
              <img src={`/iso/${p.escena}.svg`} alt="" width="220" height="180" loading="lazy" decoding="async" />
              <span>
                <small>Lo que hacemos</small>
                <b>{p.solucion}</b>
              </span>
              <Icono nombre="flecha" tamano={20} />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="seccion" id="servicios" aria-labelledby="servicios-titulo">
    <div class="contenedor">
      <Encabezado
        id="servicios-titulo"
        antetitulo="Servicios"
        titulo="Todo lo digital de tu negocio, en un mismo sitio"
        entradilla="Puedes contratar una sola cosa o dejarnos el conjunto. Lo que no cambia es la forma de trabajar: claro, por escrito y sin permanencias."
      />
      <ul class="bento-servicios">
        {SERVICIOS.map((s, i) => {
          const grande = GRANDES[s.slug];
          return (
            <li class:list={['tesela', grande ? `tesela--${grande.forma} tesela--${grande.tono}` : 'tesela--simple']} data-aparece style={`transition-delay:${(i % 4) * 70}ms`}>
              <a href={s.href} class="tesela__enlace tarjeta-hover">
                {grande ? (
                  <img class="tesela__escena" src={`/iso/${s.escena}.svg`} alt="" width="320" height="260" loading="lazy" decoding="async" />
                ) : (
                  <IconoServicio servicio={s.slug} tamano={72} />
                )}
                <span class="tesela__texto">
                  <b>{s.nombre}</b>
                  <small>{s.resumen}</small>
                </span>
                <span class="tesela__ir" aria-hidden="true"><Icono nombre="flecha" tamano={18} /></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- GUÍA DE VALOR -->
  <Guia
    titulo="Seis cosas que debe cumplir tu web, la haga quien la haga"
    entradilla="Úsala para revisar la que ya tienes o para comparar presupuestos. Si falla en más de dos, está perdiendo clientes."
    bloques={comprobaciones}
    accion={{ href: '/marketing/auditoria/', texto: 'Pide que revisemos la tuya gratis' }}
  />

  <!-- CASOS -->
  <section class="seccion" aria-labelledby="casos-titulo">
    <div class="contenedor">
      <Encabezado
        id="casos-titulo"
        antetitulo="Trabajos publicados"
        titulo="Negocios reales, webs que puedes visitar"
        entradilla="Clínicas, talleres, constructoras y tiendas de la provincia. Entra en cualquiera y mira cómo carga en tu móvil."
      />
      <Casos limite={6} />
    </div>
  </section>

  <!-- PROCESO -->
  <section class="seccion seccion--blanca proceso" aria-labelledby="proceso-titulo">
    <div class="contenedor">
      <div class="proceso__cabeza">
        <Encabezado
          id="proceso-titulo"
          antetitulo="Cómo trabajamos"
          titulo="Sabrás en todo momento qué pasa con tu proyecto"
          entradilla="Sin presentaciones eternas ni intermediarios. Hablas con quien diseña y programa tu web."
        />
        <Ilustracion nombre="proceso" titulo="Recorrido isométrico por los cuatro pasos de un proyecto" class="proceso__ilustracion" />
      </div>
      <Pasos pasos={pasos} />
    </div>
  </section>

  <!-- OPINIONES -->
  <section class="seccion opiniones-seccion" aria-labelledby="opiniones-titulo">
    <div class="contenedor opiniones">
      <div class="opiniones__nota">
        <p class="antetitulo">Opiniones</p>
        <p class="opiniones__media" id="opiniones-titulo">
          <span class="opiniones__numero">{valoracion}</span>
          <span class="estrellas" aria-hidden="true">★★★★★</span>
        </p>
        <p class="opiniones__base">de media en {CIFRAS.numResenas} reseñas de Google</p>
      </div>
      <figure class="cita-grande" data-aparece>
        <blockquote>«{opiniones[0].texto}»</blockquote>
        <figcaption>
          <span class="cita__inicial" aria-hidden="true">{opiniones[0].autor.charAt(0)}</span>
          <span><b>{opiniones[0].autor}</b><br />{opiniones[0].cargo}</span>
        </figcaption>
      </figure>
      <ul class="citas">
        {opiniones.slice(1).map((o, i) => (
          <li class="cita tarjeta-hover" data-aparece style={`transition-delay:${(i + 1) * 90}ms`}>
            <span class="estrellas" aria-label="5 de 5 estrellas">★★★★★</span>
            <blockquote>«{o.texto}»</blockquote>
            <p class="cita__autor">
              <span class="cita__inicial" aria-hidden="true">{o.autor.charAt(0)}</span>
              <span><b>{o.autor}</b><br />{o.cargo}</span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ZONAS -->
  <section class="seccion seccion--blanca zonas-seccion" aria-labelledby="zonas-titulo">
    <div class="contenedor">
      <div class="zonas__cabeza">
        <Encabezado
          id="zonas-titulo"
          antetitulo="Dónde trabajamos"
          titulo="Conocemos cada comarca de Almería"
          entradilla="No es lo mismo un restaurante en Mojácar que una cantera en Macael. Para cada municipio hemos estudiado sus sectores, su competencia y lo que buscan sus clientes."
        />
        <Boton href="/diseno-web/" variante="secundario">Ver todos los municipios</Boton>
      </div>
      <div class="zonas__mapa fondo-iso">
        <Ilustracion nombre="mapa" titulo="Mapa isométrico de la provincia de Almería con los municipios donde trabajamos y su conexión con el estudio de Vera" class="zonas__ilustracion" />
      </div>
      <div class="zonas__lista">
        {zonas.map((z) => (
          <div class="zona">
            <h3>{z.comarca}</h3>
            <ul>
              {z.pueblos.map((p) => <li><a href={`/diseno-web/${p.slug}/`}>{p.nombre}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PREGUNTAS -->
  <section class="seccion" aria-labelledby="preguntas-titulo">
    <div class="contenedor preguntas-home">
      <Encabezado id="preguntas-titulo" antetitulo="Preguntas frecuentes" titulo="Lo que nos preguntan antes de empezar" />
      <Preguntas preguntas={preguntas} />
    </div>
  </section>

  <!-- BLOG -->
  {posts.length > 0 && (
    <section class="seccion seccion--blanca" aria-labelledby="blog-titulo">
      <div class="contenedor">
        <div class="blog__cabeza">
          <Encabezado id="blog-titulo" antetitulo="Blog" titulo="Para decidir con criterio" />
          <Boton href="/blog/" variante="texto">Todos los artículos</Boton>
        </div>
        <ul class="articulos">
          {posts.map((p, i) => (
            <li>
              <a href={`/blog/${p.data.slug}/`} class:list={['articulo', 'tarjeta-hover', `articulo--${i}`]}>
                <span class="articulo__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <p class="articulo__meta">{p.data.categories?.[0] ?? 'Artículo'} · <time datetime={p.data.publishedAt.toISOString()}>{fecha(p.data.publishedAt)}</time></p>
                <h3>{p.data.title}</h3>
                <p>{p.data.excerpt}</p>
                <span class="articulo__leer">Leer <Icono nombre="flecha" tamano={16} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <LlamadaFinal />
</Sitio>

<style>
  /* Portada */
  .portada {
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .portada__luces {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40% 50% at 78% 38%, rgba(255, 207, 63, 0.28), transparent 70%),
      radial-gradient(35% 45% at 92% 75%, rgba(58, 154, 107, 0.18), transparent 70%),
      radial-gradient(30% 40% at 8% 10%, rgba(155, 201, 232, 0.22), transparent 70%);
  }
  .portada__rejilla {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .portada__texto {
    display: grid;
    gap: 1.5rem;
  }
  .portada h1 {
    max-width: 12ch;
  }
  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .portada__sello {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    padding: 0.5rem 1rem 0.5rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--linea);
    font-size: var(--t-s);
    color: var(--tinta-2);
  }
  .portada__escena {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 640px;
    padding: 1.5rem 0;
  }
  .flotante :global(.icono-iso) {
    margin: -4px 0;
  }
  .flotante--1 {
    top: 6%;
    left: -2%;
  }
  .flotante--2 {
    top: 44%;
    right: -4%;
  }
  .flotante--3 {
    bottom: 4%;
    left: 6%;
  }
  @media (max-width: 600px) {
    .flotante {
      display: none;
    }
  }
  @media (min-width: 960px) {
    .portada__rejilla {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 2rem;
    }
  }

  /* Problemas: filas editoriales */
  .problemas {
    list-style: none;
    display: grid;
    padding: 0;
    border-top: 1px solid var(--linea);
  }
  .problema {
    display: grid;
    gap: 1.25rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--linea);
  }
  .problema__num {
    font-weight: 800;
    font-size: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--verde);
  }
  .problema__texto h3 {
    font-size: var(--t-2xl);
    letter-spacing: -0.035em;
  }
  .problema__texto p {
    margin-top: 0.75rem;
    color: var(--tinta-2);
    max-width: 50ch;
  }
  .problema__solucion {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem 1.25rem 0.75rem 0.75rem;
    border-radius: var(--radio-l);
    border: 1px solid var(--linea);
