---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Contact from '../components/sections/Contact.astro';
import PortadaConsola from '../components/cdm/PortadaConsola.astro';
import PreciosConsola from '../components/cdm/PreciosConsola.astro';
import { PerspectiveCarousel } from '@/components/ui/perspective-carousel';
import { TestimonialsCard } from '@/components/ui/testimonials-card';
import { FaqAccordion } from '@/components/ui/faq-accordion';
import type { LineaRegistro, TarifaCdm } from '../components/cdm/tipos';
import { CIFRAS, aniosEnAlmeria } from '../data/negocio';
import { plan360 } from '../data/servicios-it';
import { comarcas, getPueblosByComarca, comarcaSlug } from '../data/pueblos-almeria';
import { proyectos as casos } from '../data/proyectos';
import medidasJson from '../data/medidas.json';
import { fechaCorta, medidasSchema } from '../data/medidas';

type Post = CollectionEntry<'posts'>;

// Posts recientes (3 últimos)
const allPosts = await getCollection('posts', ({ data }: Post) => !data.draft);
const recentPosts = allPosts
  .sort((a: Post, b: Post) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

function formatDateShort(d: Date): string {
  return d.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit' });
}

// ─── DATOS HOME ────────────────────────────────

// Servicios cluster (con preview color por área)
const servicios = [
  { num: '01', href: '/desarrollo-web/',  title: 'Diseño Web',       sub: 'Astro · WordPress · Custom', desc: 'Webs que cargan en <2s y aparecen en Google. CWV verde, accesibles, indexables.', icon: 'web',    color: 'green',    metric: '99+', metricLbl: 'Lighthouse' },
  { num: '02', href: '/audiovisual/',     title: 'Audiovisual',      sub: 'Dron 4K · Vídeo · Foto',     desc: 'Producción con Mavic 3 Pro. Vídeo corporativo, reels, tours 360°, fotografía aérea.', icon: 'cam',    color: 'red',      metric: '4K', metricLbl: 'Resolución' },
  { num: '03', href: '/marketing/',       title: 'Marketing · SEO',  sub: 'SEM · SEO · Email · RRSS',   desc: 'Tráfico cualificado vía Google Ads, SEO local y email automation. Conversión medida.', icon: 'mkt',    color: 'blue',     metric: '+180%', metricLbl: 'Leads medio' },
  { num: '04', href: '/diseno-grafico/',  title: 'Diseño Gráfico',   sub: 'Branding · Print · Editorial', desc: 'Identidad visual, papelería corporativa, packaging, catálogos y editorial.', icon: 'art',    color: 'magenta',  metric: '∞', metricLbl: 'Conceptos' },
  { num: '05', href: '/informatica-empresas/', title: 'Sistemas IT',     sub: 'Redes · Equipos · Copias',  desc: 'Mantenimiento informático, redes wifi, servidores y ciberseguridad. Técnico el mismo día en el Levante.', icon: 'it', color: 'woo', metric: '0 días', metricLbl: 'Espera para visita' },
  { num: '06', href: '/soporte/',         title: 'Mantenimiento',    sub: 'Soporte · Backups · WAF',    desc: 'Vigilancia 24/7, backups diarios, parches de seguridad <24h. Sin permanencia.',      icon: 'shield', color: 'gold',     metric: '99.9%', metricLbl: 'Uptime' },
];

// 4 razones diferenciales
const razones = [
  { num: '01', t: 'Equipo local en Almería',    s: 'Aquí desde 2018. Tomamos café juntos si quieres. Hablas con quien va a trabajar — sin intermediarios, sin comerciales.' },
  { num: '02', t: 'Sin permanencia',            s: 'Nadie firma contratos eternos. Pago contra hitos. Si no encajamos, te exportamos todo y te vas. Nuestros clientes se quedan por resultados.' },
  { num: '03', t: 'Respuesta < 4 horas',        s: 'WhatsApp, email o teléfono. Sin tickets, sin filtros, sin "te derivamos a otro compañero". Personas reales en tiempo real.' },
  { num: '04', t: 'Cero plantillas',            s: 'Cada web a medida. Diseñamos por TÚ negocio, no por catálogo de Wix. Si quieres una plantilla — hay opciones más baratas en otro sitio.' },
];


// Proceso 5 pasos
const proceso = [
  { num: '01', t: 'Briefing',         body: 'Llamada de 30 min · te escuchamos, sin presentaciones interminables.', eta: 'Día 1' },
  { num: '02', t: 'Propuesta',         body: 'Presupuesto cerrado por escrito · plan de trabajo · fecha de entrega.', eta: 'Día 3' },
  { num: '03', t: 'Diseño',            body: 'Mockups + revisiones. Lo apruebas antes de programar nada.',           eta: 'Sem 1–2' },
  { num: '04', t: 'Desarrollo',        body: 'Construcción real. Acceso a entorno staging para que veas el progreso.', eta: 'Sem 2–4' },
  { num: '05', t: 'Lanzamiento',       body: 'Migración, monitorización, formación de tu equipo, soporte activo.',    eta: 'Sem 4–6' },
];

// Soluciones por perfil (audience-based)
const soluciones = [
  { href: '/soluciones/emprendedor/', code: 'MVP',  name: 'Emprendedores',  sub: 'Lanza tu primera web', desc: 'Pack todo-en-uno con dominio, hosting, correo y SEO. En 14 días vendiendo.', price: 'Desde 350€',   color: 'accent', icon: 'rocket' },
  { href: '/soluciones/empresa/',     code: 'PRO',  name: 'Empresas',       sub: 'Web corporativa',      desc: 'Audit gratuita, integraciones CRM/ERP, SLA, RGPD + WCAG AA, multilingüe.', price: 'Desde 500€', color: 'navy',   icon: 'building' },
  { href: '/soluciones/ecommerce/',   code: 'SHOP', name: 'Tienda online',  sub: 'WooCommerce',          desc: '0% comisión por venta. Stripe + Bizum + Redsys. Tienda 100% tuya.',          price: 'Desde 700€', color: 'woo',    icon: 'cart' },
];

// Tech stack con SVGs custom — los renderizamos inline en la sección
const tech = [
  { id: 'astro',     name: 'Astro',          v: 'Sitios estáticos ultrarrápidos · Lighthouse 99+',     bg: 'orange' },
  { id: 'wp',        name: 'WordPress',      v: 'CMS rey · Blog editable · SEO de primer nivel',       bg: 'blue' },
  { id: 'woo',       name: 'WooCommerce',    v: 'Tiendas online · 0% comisión por venta',              bg: 'woo' },
  { id: 'stripe',    name: 'Stripe',         v: 'Pasarela líder · Apple/Google Pay · 1,4 % por venta', bg: 'purple' },
  { id: 'bizum',     name: 'Bizum',          v: 'Pago móvil español · 24 M usuarios · 0,7 %',          bg: 'cyan' },
  { id: 'vercel',    name: 'Vercel',         v: 'Hosting + Edge Network · SSL · 99,99 % uptime',        bg: 'green' },
  { id: 'cloudflare',name: 'Cloudflare',     v: 'CDN + WAF · protección DDoS · DNS rápido',            bg: 'orange-d' },
  { id: 'ga4',       name: 'Analytics + GSC',v: 'GA4 · Search Console · Tag Manager configurados',    bg: 'yellow' },
];

// Lighthouse real de cada proyecto (src/data/medidas.json). Sin medida → null.
const medidas = medidasSchema.parse(medidasJson);
const lighthousePorId = new Map(medidas.webs.map((w) => [w.id, w.lighthouse]));
const casosMedidos = casos.map((c) => ({ ...c, lighthouse: lighthousePorId.get(c.id) ?? null }));
const fechaMedidas = fechaCorta(medidas.medidoEl);
const notaMedidas = fechaMedidas
  ? `Lighthouse móvil medido el ${fechaMedidas} con PageSpeed Insights.`
  : 'Estas webs todavía no tienen medida de Lighthouse.';

// Testimonios destacados (subset de los del JSON-LD)
const testimonios = [
  { text: 'Desde el diseño de nuestra web hasta su mantenimiento, han demostrado un profesionalismo y dedicación excepcionales.',          author: 'Ana Padilla',  role: 'Directora · Almería', metric: '★★★★★ · 2026' },
  { text: 'Nuestra inmobiliaria en Vera Playa necesitaba captar clientes internacionales. El portal es impecable y recibimos leads diarios.', author: 'Javier Ruiz',  role: 'Vera Playa · Inmo',   metric: '+210% LEADS' },
  { text: 'La creación de nuestro sitio web corporativo fue un proceso impecable. El equipo capturó a la perfección nuestros valores.',     author: 'Juan Poveda',  role: 'Corporate · Almería', metric: 'TOP 3 GOOGLE' },
];

// Tarifas de salida: los tres precios de entrada (panel de fichas)
const tarifas: TarifaCdm[] = [
  { servicio: 'Página web', desde: '500 €', nota: 'pago único', incluye: ['Diseño a medida, sin plantillas', 'SEO local y ficha de Google', 'Hosting y correo el primer año', 'Plazo de entrega cerrado por escrito'], href: '/contacto/?servicio=web#contacto', cta: 'Pedir presupuesto' },
  { servicio: 'Tienda online', desde: '700 €', nota: 'pago único', incluye: ['WooCommerce sin comisión por venta', 'Stripe, Bizum y Redsys', 'Catálogo, envíos y stock', 'Formación para gestionarla'], href: '/contacto/?servicio=tienda#contacto', cta: 'Pedir presupuesto' },
  { servicio: 'Plan 360', desde: '400 €/mes', nota: '+ IVA, web e informática', incluye: ['Web y hasta 10 puestos con servidor', 'Helpdesk ilimitado y visita el mismo día', 'Copias verificadas y ciberseguridad', 'Sin permanencia ni alta'], href: '/plan-360/', cta: 'Ver el Plan 360', destacada: true },
];

// Retratos SVG de marca para las opiniones (no hay fotos de clientes)
const monograma = (nombre: string, i: number) => {
  const fondo = ['#FF5A00', '#D6FF44', '#0E0D0B'][i % 3];
  const tinta = ['#0E0D0B', '#0E0D0B', '#D6FF44'][i % 3];
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><rect width="400" height="400" fill="${fondo}"/><path d="M200 40 L236 150 L352 150 L258 218 L294 330 L200 262 L106 330 L142 218 L48 150 L164 150 Z" fill="none" stroke="${tinta}" stroke-width="6" opacity=".3"/><text x="200" y="262" text-anchor="middle" font-family="Arial, sans-serif" font-weight="800" font-size="190" fill="${tinta}">${nombre.charAt(0)}</text></svg>`;
  return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
};

// FAQ home (resumida)
const faqHome = [
  { q: '¿Cuánto cuesta una web profesional en Almería?', a: 'Web corporativa desde 500€. Tienda online WooCommerce desde 700€. Landing page desde 350€. Presupuesto cerrado, sin sorpresas, sin comisiones por venta.' },
  { q: '¿Cuánto tarda en estar lista?',                   a: 'De 1 semana (lanzamiento exprés) a 14 semanas (corporativa premium multilingüe). Cumplimos plazos siempre que las aprobaciones lleguen a tiempo.' },
  { q: '¿Hacéis también mantenimiento informático?', a: 'Sí. Nuestro equipo de sistemas mantiene ordenadores, redes, servidores y copias de empresas del Levante y el Almanzora, con visita el mismo día. El Plan 360 junta web e informática por 400 € + IVA al mes.' },
  { q: '¿Hay permanencia?',                                a: 'No. Sin permanencia. Cancelas cuando quieras. Tu web es 100% tuya, exportable, migrable. Nuestros clientes se quedan por resultados.' },
  { q: '¿Qué pasa después del primer año (hosting)?',     a: 'Hosting + correo desde 90€/año si sigues con nosotros, o exportas y te vas. Sin extorsión, sin sorpresas. Tú decides cada año.' },
];

// Localidades destacadas de la sección de cobertura
const localidadesDestacadas = [
  { nombre: 'Almería', slug: 'almeria', sub: 'Capital, 200.000 habitantes' },
  { nombre: 'Vera', slug: 'vera', sub: 'Levante, sede del estudio' },
  { nombre: 'Mojácar', slug: 'mojacar', sub: 'Levante, turismo' },
  { nombre: 'Huércal-Overa', slug: 'huercal-overa', sub: 'Almanzora, cabecera comarcal' },
  { nombre: 'Albox', slug: 'albox', sub: 'Almanzora, centro comercial' },
  { nombre: 'Garrucha', slug: 'garrucha', sub: 'Costa, puerto pesquero' },
];

// Registro simulado del Plan 360 (portada y precios). Siempre en un panel «demo».
const registroPlan360: LineaRegistro[] = [
  { hora: '09:41', texto: 'Copia del servidor completada, 128 GB', estado: 'ok' },
  { hora: '09:44', texto: 'Parches instalados en 8 de 10 puestos' },
  { hora: '09:46', texto: 'Disco de recepción al 91 %', estado: 'aviso' },
  { hora: '09:47', texto: 'Ticket 0412, impresora de recepción', estado: 'ok' },
  { hora: '09:49', texto: 'Certificado de la web renovado', estado: 'ok' },
  { hora: '09:50', texto: 'Técnico en camino a Garrucha' },
];
---

