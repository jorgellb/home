          '@type': 'Question',
          'name': '¿Incluye hosting gratuito?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Sí. Nuestras webs estáticas con Astro se alojan en servidores premium sin coste anual para ti. Carga en menos de 1 segundo, 100/100 en PageSpeed y nunca cae. Sin renovaciones ni facturas sorpresa.'
          }
        },
        {
          '@type': 'Question',
          'name': '¿Puedo gestionar la web yo mismo?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Sí. Te entregamos todas las credenciales y documentación. También ofrecemos formación y planes de mantenimiento desde 50€/mes con soporte prioritario y actualizaciones incluidas.'
          }
        },
        {
          '@type': 'Question',
          'name': '¿Hacéis SEO local para negocios en Almería?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Sí, es nuestra especialidad. Optimizamos tu Google Business Profile, estructuramos el contenido con keywords locales y construimos una arquitectura SEO que te posicione para búsquedas como «diseño web Almería», «dentista Vera» o «hotel Mojácar».'
          }
        },
        {
          '@type': 'Question',
          'name': '¿Qué formas de pago aceptan?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Aceptamos transferencia bancaria, PayPal y tarjeta. 50% al inicio del proyecto y 50% a la entrega. Incluimos dos rondas de revisiones y garantía de satisfacción.'
          }
        }
      ]
    }
  ]}
>
  <Header />

  <main id="main-content">
    <Hero />
    <Problem />
    <Solution services={services} />
    <Process />
    <Portfolio />
    <Testimonials testimonials={testimonials} />
    <Technology />

    {/* ── Cobertura geográfica — Editorial map / index ── */}
    <section class="section-brutal" id="cobertura">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 09 / Cobertura</span>
            <h2 class="heading-display brutal-section-head__title">
              Diseño web en
              <em class="heading-editorial">toda Almería.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Trabajamos con negocios de la provincia entera. Encuentra tu
            localidad — o pídenos cobertura en la tuya si no aparece.
          </p>
        </header>

        {/* Destacadas — bento brutal */}
        <ul class="cobertura-grid">
          {[
            { nombre: 'Almería',       slug: 'almeria',       sub: 'Capital · 200k hab.' },
            { nombre: 'Vera',          slug: 'vera',          sub: 'Levante · sede' },
            { nombre: 'Mojácar',       slug: 'mojacar',       sub: 'Levante · turismo' },
            { nombre: 'Huércal-Overa', slug: 'huercal-overa', sub: 'Almanzora · hub' },
            { nombre: 'Albox',         slug: 'albox',         sub: 'Almanzora · centro' },
            { nombre: 'Garrucha',      slug: 'garrucha',      sub: 'Costa · puerto' },
          ].map((p, i) => (
            <li>
              <a href={`/diseno-web/${p.slug}/`} class={`cobertura-tile cobertura-tile--${i % 6}`}>
                <span class="text-meta">N.º {String(i + 1).padStart(2, '0')}</span>
                <span class="cobertura-tile__name heading-display">{p.nombre}</span>
                <span class="cobertura-tile__sub text-mono">{p.sub}</span>
                <span class="cobertura-tile__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>

        {/* Comarcas — accordion brutalista */}
        <h3 class="text-meta cobertura-h3">★ Por comarcas</h3>
        <div class="cobertura-comarcas">
          {comarcas.map(comarca => {
            const list = getPueblosByComarca(comarca);
            return (
              <details class="cobertura-comarca" name="comarca">
                <summary class="cobertura-comarca__sum">
                  <span class="cobertura-comarca__name heading-display">{comarca}</span>
                  <span class="cobertura-comarca__count text-mono">{list.length} localidades</span>
                  <span class="cobertura-comarca__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="cobertura-comarca__items">
                  {list.map(p => (
                    <a href={`/diseno-web/${p.slug}/`} class="tag-brutal cobertura-comarca__chip">
                      {p.nombre}
                    </a>
                  ))}
                </div>
              </details>
            );
          })}
        </div>

        <div class="cobertura-cta">
          <a href="/diseno-web/" class="btn-brutal btn-brutal--ghost">
            Ver todas las localidades →
          </a>
        </div>
      </div>
    </section>

    <FAQ />
    <Contact />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Cobertura grid */
  .cobertura-grid {
    list-style: none; padding: 0; margin: 0 0 4rem;
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--brutal-ink);
    background: var(--brutal-ink);
  }
  @media (min-width: 640px) { .cobertura-grid { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  @media (min-width: 1024px) { .cobertura-grid { grid-template-columns: repeat(3, 1fr); } }

  .cobertura-tile {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    gap: .35rem;
    padding: 1.75rem;
    background: var(--brutal-card);
    color: var(--brutal-ink);
    text-decoration: none;
    min-height: 160px;
    transition: background .25s, color .25s;
    grid-template-areas:
      'meta arrow'
      'name name'
      'sub  sub';
  }
  .cobertura-tile .text-meta { grid-area: meta; }
  .cobertura-tile__name { grid-area: name; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: .95; letter-spacing: -.025em; }
  .cobertura-tile__sub { grid-area: sub; font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); }
  .cobertura-tile__arrow { grid-area: arrow; align-self: start; font-family: var(--font-mono); color: var(--brutal-accent); font-size: 1.5rem; transition: transform .25s; }
  .cobertura-tile:hover { background: var(--brutal-accent); color: var(--brutal-ink); }
  .cobertura-tile:hover .cobertura-tile__sub { color: var(--brutal-ink); }
  .cobertura-tile:hover .cobertura-tile__arrow { color: var(--brutal-ink); transform: translateX(4px); }
  .cobertura-tile--0:hover { background: var(--brutal-accent); }
  .cobertura-tile--1:hover { background: var(--brutal-lime); }
  .cobertura-tile--2:hover { background: var(--brutal-ink); color: var(--brutal-bg); }
  .cobertura-tile--2:hover .cobertura-tile__arrow { color: var(--brutal-lime); }
  .cobertura-tile--2:hover .cobertura-tile__sub { color: var(--brutal-bg-alt); }
  .cobertura-tile--3:hover { background: var(--brutal-accent); }
  .cobertura-tile--4:hover { background: var(--brutal-lime); }
  .cobertura-tile--5:hover { background: var(--brutal-ink); color: var(--brutal-bg); }
  .cobertura-tile--5:hover .cobertura-tile__arrow { color: var(--brutal-lime); }

  .cobertura-h3 { display: block; margin-bottom: 1rem; color: var(--brutal-accent); }
  .cobertura-comarcas {
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--brutal-ink);
  }
  @media (min-width: 768px) { .cobertura-comarcas { grid-template-columns: 1fr 1fr; } }
  .cobertura-comarca {
    background: var(--brutal-card);
    border-bottom: 1px solid var(--brutal-ink);
  }
  @media (min-width: 768px) {
    .cobertura-comarca:nth-child(odd) { border-right: 1px solid var(--brutal-ink); }
  }
  .cobertura-comarca[open] { background: var(--brutal-bg-alt); }
  .cobertura-comarca__sum {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  .cobertura-comarca__sum::-webkit-details-marker { display: none; }
  .cobertura-comarca__name { font-size: 1.4rem; line-height: 1; letter-spacing: -.025em; }
  .cobertura-comarca__count { font-size: .65rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); }
  .cobertura-comarca__toggle {
    width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--brutal-card);
    border: 2px solid var(--brutal-ink);
    font-family: var(--font-mono);
    font-weight: 700;
    transition: transform .25s, background .15s, color .15s;
  }
  .cobertura-comarca[open] .cobertura-comarca__toggle { background: var(--brutal-accent); color: var(--brutal-bg); transform: rotate(45deg); }
  .cobertura-comarca__items { padding: 0 1.5rem 1.5rem; display: flex; flex-wrap: wrap; gap: .35rem; }
  .cobertura-comarca__chip:hover { background: var(--brutal-ink); color: var(--brutal-lime); }

  .cobertura-cta { margin-top: 3rem; text-align: center; }
</style>
