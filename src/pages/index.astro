                    {p.data.categories && p.data.categories[0] && (
                      <span class="ho-blog__tag">★ {p.data.categories[0]}</span>
                    )}
                    <span class="ho-blog__cta">Leer →</span>
                  </footer>
                </a>
              </li>
            ))}
          </ol>

          <div class="ho-blog-cta">
            <a href="/blog/" class="ho-btn ho-btn--ghost">Ver todas las crónicas →</a>
          </div>
