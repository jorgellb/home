>
  <Header />
  
  <main id="main-content" class="pt-20">
    <Hero />
    <Problem />
    <Solution services={services} />
    <Process />
    <Portfolio />
    <Testimonials testimonials={testimonials} />
    <Technology />

    <!-- ════════════════════════════════════════════
         COBERTURA GEOGRÁFICA — SEO Interlinking
    ════════════════════════════════════════════ -->
    <section class="relative py-20 overflow-hidden bg-white" id="cobertura">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(249,115,22,0.05)_0%,transparent_50%)]"></div>
      <div class="relative max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-orange-200 text-sm text-orange-600 mb-6 shadow-sm">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            Cobertura en toda Almería
          </span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">
            Diseño web en
            <span class="text-gradient">cada rincón de Almería</span>
          </h2>
          <p class="text-lg text-slate-500 max-w-2xl mx-auto">
            Trabajamos con negocios de toda la provincia. Encuentra tu localidad y descubre cómo podemos ayudarte.
          </p>
        </div>

        {/* Pueblos destacados con enlaces directos */}
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-12">
          {[
            { nombre: 'Almería', slug: 'almeria', destacado: true },
            { nombre: 'Vera', slug: 'vera', destacado: true },
            { nombre: 'Mojácar', slug: 'mojacar', destacado: true },
            { nombre: 'Huércal-Overa', slug: 'huercal-overa', destacado: true },
            { nombre: 'Albox', slug: 'albox', destacado: true },
            { nombre: 'Garrucha', slug: 'garrucha', destacado: false },
          ].map(p => (
            <a
              href={`/diseno-web/${p.slug}/`}
              class={`group text-center px-4 py-4 rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-lg ${p.destacado ? 'bg-gradient-to-br from-orange-50 to-amber-50 border-orange-200 hover:border-orange-400 hover:shadow-orange-500/15' : 'bg-white border-slate-200 hover:border-orange-300'}`}
            >
              <div class={`text-sm font-bold mb-1 transition-colors ${p.destacado ? 'text-orange-700 group-hover:text-orange-600' : 'text-slate-700 group-hover:text-orange-600'}`}>{p.nombre}</div>
              <div class="text-xs text-slate-400">Diseño web</div>
            </a>
          ))}
        </div>

        {/* Comarcas accordion */}
        <div class="grid md:grid-cols-2 gap-4">
          {comarcas.map(comarca => {
            const pueblos = getPueblosByComarca(comarca);
            return (
              <details class="group rounded-2xl bg-slate-50 border border-slate-200 hover:border-orange-300 transition-colors duration-300 overflow-hidden">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-400 to-amber-500 flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                      </svg>
                    </div>
                    <div>
                      <span class="font-semibold text-slate-900 text-sm">{comarca}</span>
                      <span class="text-xs text-slate-400 ml-2">{pueblos.length} localidades</span>
                    </div>
                  </div>
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-5 pb-5 flex flex-wrap gap-2">
                  {pueblos.map(p => (
                    <a href={`/diseno-web/${p.slug}/`} class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-xs text-slate-600 hover:text-orange-600 hover:border-orange-300 transition-all duration-200">
                      {p.nombre}
                    </a>
                  ))}
                </div>
              </details>
            );
          })}
        </div>

        {/* CTA */}
        <div class="mt-12 text-center">
          <a
            href="/diseno-web/"
            class="group inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-100 text-slate-900 font-semibold hover:bg-orange-50 hover:text-orange-700 transition-all duration-300"
          >
            Ver todas las localidades
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <FAQ />
    <Contact />
  </main>
  
  <Footer />
</BaseLayout>
