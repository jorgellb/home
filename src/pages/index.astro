<style>
  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · HOME EDITORIAL                                 */
  /* ═══════════════════════════════════════════════════════ */
  .ho {
    --ho-paper:    #FFFCF6;
    --ho-paper-2:  #F5EFE0;
    --ho-cream:    #ECE3CB;
    --ho-ink:      #0E0D0B;
    --ho-accent:   #FF6B35;
    --ho-lime:     #D6FF44;
    --ho-blue:     #003B7A;
    --ho-cyan:     #00B8D9;
    --ho-magenta:  #FF2D9A;
    --ho-gold:     #C9A24F;
    --ho-green:    #00B85C;
    --ho-red:      #DC1B2C;
    --ho-woo:      #7F54B3;
    --ho-yellow:   #FFD600;
    --ho-mint:     #C8F2D6;
    --ho-shadow:   8px 8px 0 var(--ho-ink);
  }

  .ho-pulse {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--ho-green);
    box-shadow: 0 0 0 0 rgba(0,184,92,0.55);
    animation: ho-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes ho-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(0,184,92,0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(0,184,92,0); }
    100% { box-shadow: 0 0 0 0 rgba(0,184,92,0); }
  }
  .ho-spin     { transform-origin: 50% 50%; animation: ho-spin 30s linear infinite; }
  .ho-spin-rev { transform-origin: 50% 50%; animation: ho-spin 22s linear infinite reverse; }
  @keyframes ho-spin { to { transform: rotate(360deg); } }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .ho-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(255,107,53,0.10), transparent 50%),
      radial-gradient(circle at 10% 90%, rgba(214,255,68,0.15), transparent 50%),
      var(--ho-paper);
    border-bottom: 3px solid var(--ho-ink);
    position: relative;
    overflow: hidden;
  }
  .ho-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(14,13,11,0.05) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .ho-hero > * { position: relative; }

  .ho-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .ho-hero__status { color: var(--ho-green); font-weight: 700; }

  /* MAST · Logotipo gigante */
  .ho-mast {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-block: 3rem 2rem;
    align-items: center;
  }
  @media (min-width: 768px) { .ho-mast { grid-template-columns: 1fr auto; gap: 3rem; } }

  .ho-mast__chapter { color: var(--ho-accent); display: block; margin-bottom: 1rem; }
  .ho-mast__title {
    margin: 0;
    display: flex; flex-direction: column;
    line-height: .85;
    color: var(--ho-ink);
  }
  .ho-mast__pre {
    font-family: var(--font-mono);
    font-size: .75rem;
    letter-spacing: .85em;
    color: var(--ho-accent);
    font-weight: 700;
    margin-bottom: .85rem;
    margin-left: .3em;
  }
  .ho-mast__line1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 13vw, 9rem);
    letter-spacing: -.045em;
    line-height: .82;
    text-transform: uppercase;
  }
  .ho-mast__line2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(3rem, 11vw, 7.5rem);
    letter-spacing: -.025em;
    color: var(--ho-accent);
    line-height: .85;
    margin-top: -.05em;
  }
  .ho-mast__line2 em { font-style: italic; }
  .ho-mast__sub {
    font-family: var(--font-mono);
    font-size: .7rem;
    letter-spacing: .25em;
    color: var(--ho-ink);
    opacity: .75;
    margin-top: 1rem;
    font-weight: 700;
  }

  .ho-mast__seal {
    width: 180px;
    max-width: 28vw;
    aspect-ratio: 1;
    justify-self: center;
    filter: drop-shadow(0 8px 18px rgba(14,13,11,0.18));
    animation: ho-seal-bob 5s ease-in-out infinite;
  }
  @keyframes ho-seal-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  /* Manifiesto */
  .ho-manifest {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.85rem);
    line-height: 1.35;
    color: var(--ho-ink);
    max-width: 56ch;
    margin: 0 0 2rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ho-ink);
    font-weight: 500;
  }
  .ho-manifest em {
    color: var(--ho-accent);
    font-style: italic;
    font-weight: 600;
  }
  .ho-manifest strong { color: var(--ho-ink); font-weight: 800; }

  .ho-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem; }

  .ho-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2.5px solid var(--ho-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    cursor: pointer;
  }
  .ho-btn--primary {
    background: var(--ho-ink);
    color: var(--ho-lime);
    box-shadow: 6px 6px 0 var(--ho-accent);
  }
  .ho-btn--primary:hover {
    background: var(--ho-accent);
    color: var(--ho-ink);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ho-ink);
  }
  .ho-btn--ghost {
    background: transparent;
    color: var(--ho-ink);
    box-shadow: 6px 6px 0 var(--ho-ink);
  }
  .ho-btn--ghost:hover {
    background: var(--ho-ink);
    color: var(--ho-lime);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ho-accent);
  }

  /* Stats band */
  .ho-stats {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border: 2.5px solid var(--ho-ink);
    background: var(--ho-ink);
  }
  @media (min-width: 768px) { .ho-stats { grid-template-columns: repeat(4, 1fr); } }
  .ho-stat {
    background: var(--ho-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--ho-ink);
    border-bottom: 2px solid var(--ho-ink);
  }
  .ho-stat:nth-child(2n) { border-right: none; }
  .ho-stat:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .ho-stat:nth-child(2n)      { border-right: 2px solid var(--ho-ink); }
    .ho-stat:nth-child(4n)      { border-right: none; }
    .ho-stat:nth-last-child(-n+2) { border-bottom: 2px solid var(--ho-ink); }
    .ho-stat:nth-last-child(-n+4) { border-bottom: none; }
  }
  .ho-stat--0 { background: var(--ho-accent); color: var(--ho-paper); }
  .ho-stat--1 { background: var(--ho-paper); }
  .ho-stat--2 { background: var(--ho-lime); }
  .ho-stat--3 { background: var(--ho-ink); color: var(--ho-paper); }
  .ho-stat--3 .ho-stat__k { color: var(--ho-lime); }
  .ho-stat__k { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -.03em; }
  .ho-stat__l { font-family: var(--font-mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

  /* Marquee */
  .ho-marquee {
    background: var(--ho-ink);
    color: var(--ho-lime);
    overflow: hidden;
    padding: .9rem 0;
    border-top: 3px solid var(--ho-ink);
    margin-top: 3rem;
  }
  .ho-marquee__track {
    display: flex; gap: 3rem; width: max-content;
    animation: ho-marquee 35s linear infinite;
    font-family: var(--font-mono);
    font-size: .85rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  @keyframes ho-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* WHY (4 razones)                                         */
  /* ═══════════════════════════════════════════════════════ */
  .ho-why-section {
    background: var(--ho-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-why {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2.5px solid var(--ho-ink);
    background: var(--ho-ink);
  }
  @media (min-width: 768px)  { .ho-why { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  @media (min-width: 1024px) { .ho-why { grid-template-columns: repeat(4, 1fr); } }
  .ho-why__item {
    background: var(--ho-paper);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: .75rem;
    transition: background .25s;
  }
  .ho-why__item:hover { background: var(--ho-paper-2); }
  .ho-why__item--0 { background: var(--ho-lime); }
  .ho-why__item--0:hover { background: var(--ho-accent); color: var(--ho-paper); }
  .ho-why__item--3 { background: var(--ho-ink); color: var(--ho-paper); }
  .ho-why__item--3:hover { background: var(--ho-accent); }
  .ho-why__head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .5rem;
    border-bottom: 2px solid currentColor;
    opacity: .85;
  }
  .ho-why__num { font-size: 1.4rem; font-weight: 800; }
  .ho-why__check { color: var(--ho-accent); }
  .ho-why__item--3 .ho-why__check { color: var(--ho-lime); }
  .ho-why__t {
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    line-height: 1.05;
    letter-spacing: -.025em;
    color: inherit;
    margin: 0;
  }
  .ho-why__s {
    font-size: .92rem;
    line-height: 1.5;
    color: inherit;
    opacity: .85;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* SERVICIOS                                               */
  /* ═══════════════════════════════════════════════════════ */
  .ho-svc-section {
    background: var(--ho-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-svc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .ho-svc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ho-svc { grid-template-columns: repeat(3, 1fr); } }
  .ho-svc__item {
    background: var(--ho-paper);
    border: 2.5px solid var(--ho-ink);
    box-shadow: var(--ho-shadow);
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .ho-svc__item::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .ho-svc__item:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .ho-svc__item--green   { color: var(--ho-green); }
  .ho-svc__item--red     { color: var(--ho-red); }
  .ho-svc__item--blue    { color: var(--ho-blue); }
  .ho-svc__item--magenta { color: var(--ho-magenta); }
  .ho-svc__item--woo     { color: var(--ho-woo); }
  .ho-svc__item--gold    { color: var(--ho-gold); }

  .ho-svc__link {
    display: flex; flex-direction: column; gap: 1rem;
    padding: 1.75rem 1.5rem 1.5rem;
    text-decoration: none;
    color: var(--ho-ink);
    height: 100%;
  }
  .ho-svc__head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
  }
  .ho-svc__num { font-size: 1.5rem; font-weight: 800; color: currentColor; }
  .ho-svc__sub { font-size: .58rem; letter-spacing: .15em; text-transform: uppercase; opacity: .65; text-align: right; }
  .ho-svc__icon { width: 60px; height: 60px; color: currentColor; }
  .ho-svc__title {
    font-size: clamp(1.5rem, 2.5vw, 1.85rem);
    line-height: 1;
    letter-spacing: -.025em;
    color: var(--ho-ink);
    margin: .25rem 0 0;
  }
  .ho-svc__desc {
    font-size: .92rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
    flex: 1;
  }
  .ho-svc__foot {
    display: flex; justify-content: space-between; align-items: flex-end;
    padding-top: .85rem;
    border-top: 2px solid var(--ho-ink);
    margin-top: auto;
  }
  .ho-svc__metric { display: flex; flex-direction: column; gap: 2px; }
  .ho-svc__metric-v { font-size: 1.5rem; font-weight: 800; line-height: 1; color: currentColor; }
  .ho-svc__metric-l { font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; letter-spacing: .15em; opacity: .65; }
  .ho-svc__cta {
    font-family: var(--font-mono);
    font-size: .75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PROCESO                                                 */
  /* ═══════════════════════════════════════════════════════ */
  .ho-proc-section {
    background: var(--ho-ink);
    color: var(--ho-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
    position: relative;
    overflow: hidden;
  }
  .ho-proc-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(214,255,68,0.06) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .ho-proc-section > * { position: relative; }
  .ho-proc {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px)  { .ho-proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .ho-proc { grid-template-columns: repeat(5, 1fr); } }
  .ho-proc__step {
    background: rgba(255,252,246,0.05);
    border: 2px solid var(--ho-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: background .25s, transform .25s;
  }
  .ho-proc__step:hover { background: rgba(214,255,68,0.1); transform: translateY(-3px); }
  .ho-proc__head { display: flex; justify-content: space-between; padding-bottom: .5rem; border-bottom: 1.5px dashed rgba(255,252,246,0.25); }
  .ho-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--ho-lime); line-height: 1; }
  .ho-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--ho-accent); }
  .ho-proc__t {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--ho-paper);
    margin: 0;
  }
  .ho-proc__body {
    font-size: .85rem;
    line-height: 1.45;
    color: rgba(255,252,246,0.75);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PORTFOLIO / CASOS                                       */
  /* ═══════════════════════════════════════════════════════ */
  .ho-port-section {
    background: var(--ho-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-port {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px)  { .ho-port { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ho-port { grid-template-columns: repeat(3, 1fr); } }
  .ho-port__item {
    background: var(--ho-paper);
    border: 2.5px solid var(--ho-ink);
    box-shadow: var(--ho-shadow);
    transition: transform .25s, box-shadow .25s;
  }
  .ho-port__item:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .ho-port__item--green   { color: var(--ho-green); }
  .ho-port__item--red     { color: var(--ho-red); }
  .ho-port__item--blue    { color: var(--ho-blue); }
  .ho-port__item--magenta { color: var(--ho-magenta); }
  .ho-port__item--woo     { color: var(--ho-woo); }
  .ho-port__item--gold    { color: var(--ho-gold); }
  .ho-port__link { display: flex; flex-direction: column; text-decoration: none; color: var(--ho-ink); }
  .ho-port__visual {
    aspect-ratio: 4 / 3;
    background: currentColor;
    position: relative;
    border-bottom: 2px solid var(--ho-ink);
    overflow: hidden;
  }
  .ho-port__sector {
    position: absolute;
    top: 1rem; left: 1rem;
    background: var(--ho-ink);
    color: var(--ho-lime);
    padding: .3rem .65rem;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 1.5px solid var(--ho-ink);
    z-index: 2;
  }
  .ho-port__pattern {
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(45deg, transparent 0 12px, rgba(255,252,246,0.1) 12px 13px);
  }
  .ho-port__body { padding: 1.25rem 1.5rem 1.5rem; display: flex; flex-direction: column; gap: .65rem; }
  .ho-port__client {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1;
    letter-spacing: -.025em;
    margin: 0;
    color: var(--ho-ink);
  }
  .ho-port__result { display: flex; align-items: center; gap: .5rem; }
  .ho-port__result-arrow { color: currentColor; font-family: var(--font-mono); font-size: 1.2rem; font-weight: 800; }
  .ho-port__result-v {
    font-family: var(--font-mono);
    font-size: .82rem;
    font-weight: 800;
    color: currentColor;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .ho-quote-section {
    background: var(--ho-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-quotes {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .ho-quotes { grid-template-columns: repeat(3, 1fr); } }
  .ho-quote {
    position: relative;
    background: var(--ho-paper);
    border: 2.5px solid var(--ho-ink);
    box-shadow: var(--ho-shadow);
    padding: 2rem 1.5rem 1.5rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .ho-quote:hover { transform: translateY(-3px); }
  .ho-quote--0 { background: var(--ho-lime); }
  .ho-quote--1 { background: var(--ho-mint); }
  .ho-quote--2 { background: var(--ho-cream); }
  .ho-quote__metric {
    position: absolute;
    top: -12px; left: 16px;
    background: var(--ho-ink);
    color: var(--ho-lime);
    padding: .3rem .75rem;
    font-family: var(--font-mono);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .12em;
    border: 2px solid var(--ho-ink);
    box-shadow: 3px 3px 0 var(--ho-accent);
  }
  .ho-quote__t {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ho-ink);
    margin: 0;
    flex: 1;
  }
  .ho-quote__f { display: flex; align-items: center; gap: .85rem; padding-top: 1rem; border-top: 2px dashed var(--ho-ink); }
  .ho-quote__avatar {
    width: 40px; height: 40px;
    background: var(--ho-ink); color: var(--ho-lime);
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .ho-quote__f div { display: flex; flex-direction: column; }
  .ho-quote__name { font-family: var(--font-display); font-weight: 700; font-size: .95rem; color: var(--ho-ink); }
  .ho-quote__role { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; opacity: .7; text-transform: uppercase; }

  /* ═══════════════════════════════════════════════════════ */
  /* TECH STACK                                              */
  /* ═══════════════════════════════════════════════════════ */
  .ho-tech-section {
    background: var(--ho-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-tech {
    list-style: none; padding: 0; margin: 2rem 0 0;
    border-top: 2.5px solid var(--ho-ink);
  }
  .ho-tech__item {
    display: grid;
    grid-template-columns: 40px auto 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1.5px dashed var(--ho-ink);
    transition: padding .2s, background .2s;
  }
  .ho-tech__item:hover { padding-inline: 1rem; background: var(--ho-paper-2); }
  .ho-tech__i { font-size: .75rem; font-weight: 800; color: var(--ho-accent); letter-spacing: .15em; }
  .ho-tech__k {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -.02em;
    color: var(--ho-ink);
  }
  .ho-tech__sep { border-bottom: 1px dotted var(--ho-ink); opacity: .35; align-self: end; margin-bottom: 6px; }
  .ho-tech__v { font-family: var(--font-mono); font-size: .85rem; letter-spacing: .05em; color: var(--brutal-text-secondary); text-align: right; }
  @media (max-width: 640px) {
    .ho-tech__item { grid-template-columns: 40px 1fr; gap: .5rem; }
    .ho-tech__sep { display: none; }
    .ho-tech__v { grid-column: 2; text-align: left; font-size: .75rem; }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* COBERTURA                                               */
  /* ═══════════════════════════════════════════════════════ */
  .ho-cover-section {
    background: var(--ho-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-cover-grid {
    list-style: none; padding: 0; margin: 2rem 0 3rem;
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--ho-ink);
    background: var(--ho-ink);
  }
  @media (min-width: 640px) { .ho-cover-grid { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  @media (min-width: 1024px) { .ho-cover-grid { grid-template-columns: repeat(3, 1fr); } }
  .ho-cover-tile {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    gap: .35rem;
    padding: 1.75rem;
    background: var(--ho-paper);
    color: var(--ho-ink);
    text-decoration: none;
    min-height: 160px;
    transition: background .25s, color .25s;
    grid-template-areas: 'meta arrow' 'name name' 'sub sub';
  }
  .ho-cover-tile .text-meta { grid-area: meta; }
  .ho-cover-tile__name { grid-area: name; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: .95; letter-spacing: -.025em; }
  .ho-cover-tile__sub { grid-area: sub; font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); }
  .ho-cover-tile__arrow { grid-area: arrow; align-self: start; font-family: var(--font-mono); color: var(--ho-accent); font-size: 1.5rem; transition: transform .25s; }
  .ho-cover-tile:hover { background: var(--ho-accent); color: var(--ho-paper); }
  .ho-cover-tile:hover .ho-cover-tile__sub { color: var(--ho-paper); opacity: .85; }
  .ho-cover-tile:hover .ho-cover-tile__arrow { color: var(--ho-paper); transform: translateX(4px); }
  .ho-cover-tile--1:hover { background: var(--ho-lime); color: var(--ho-ink); }
  .ho-cover-tile--2:hover { background: var(--ho-ink); color: var(--ho-paper); }
  .ho-cover-tile--2:hover .ho-cover-tile__arrow { color: var(--ho-lime); }
  .ho-cover-tile--4:hover { background: var(--ho-lime); color: var(--ho-ink); }
  .ho-cover-tile--5:hover { background: var(--ho-ink); color: var(--ho-paper); }
  .ho-cover-tile--5:hover .ho-cover-tile__arrow { color: var(--ho-lime); }

  .ho-cover-h3 { display: block; margin-bottom: 1rem; color: var(--ho-accent); }
  .ho-comarcas {
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--ho-ink);
  }
  @media (min-width: 768px) { .ho-comarcas { grid-template-columns: 1fr 1fr; } }
  .ho-comarca { background: var(--ho-paper); border-bottom: 1px solid var(--ho-ink); }
  @media (min-width: 768px) { .ho-comarca:nth-child(odd) { border-right: 1px solid var(--ho-ink); } }
  .ho-comarca[open] { background: var(--ho-paper-2); }
  .ho-comarca__sum {
    display: grid; grid-template-columns: 1fr auto auto;
    align-items: center; gap: 1rem;
    padding: 1.25rem 1.5rem; cursor: pointer; list-style: none;
  }
  .ho-comarca__sum::-webkit-details-marker { display: none; }
  .ho-comarca__name { font-size: 1.4rem; line-height: 1; letter-spacing: -.025em; }
  .ho-comarca__count { font-size: .65rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); }
  .ho-comarca__toggle {
    width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--ho-paper); border: 2px solid var(--ho-ink);
    font-family: var(--font-mono); font-weight: 700;
    transition: transform .25s, background .15s, color .15s;
  }
  .ho-comarca[open] .ho-comarca__toggle { background: var(--ho-accent); color: var(--ho-paper); transform: rotate(45deg); }
  .ho-comarca__items { padding: 0 1.5rem 1.5rem; display: flex; flex-wrap: wrap; gap: .35rem; }
  .ho-comarca__chip:hover { background: var(--ho-ink); color: var(--ho-lime); }
  .ho-cover-cta { margin-top: 3rem; text-align: center; }

  /* ═══════════════════════════════════════════════════════ */
  /* BLOG preview                                            */
  /* ═══════════════════════════════════════════════════════ */
  .ho-blog-section {
    background: var(--ho-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-blog {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .ho-blog { grid-template-columns: repeat(3, 1fr); } }
  .ho-blog__item {
    background: var(--ho-paper);
    border: 2.5px solid var(--ho-ink);
    box-shadow: 5px 5px 0 var(--ho-ink);
    transition: transform .25s, box-shadow .25s;
  }
  .ho-blog__item:hover { transform: translate(-3px, -3px); box-shadow: 8px 8px 0 var(--ho-accent); }
  .ho-blog__link { display: flex; flex-direction: column; gap: .85rem; padding: 1.5rem; text-decoration: none; color: var(--ho-ink); height: 100%; }
  .ho-blog__head {
    display: flex; justify-content: space-between; align-items: baseline;
