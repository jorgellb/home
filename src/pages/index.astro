    --ho-lime:     #D6FF44;
    --ho-blue:     #003B7A;
    --ho-cyan:     #00B8D9;
    --ho-magenta:  #FF2D9A;
    --ho-gold:     #C9A24F;
    --ho-green:    #00B85C;
    --ho-red:      #DC1B2C;
