  .ho-proc__head { display: flex; justify-content: space-between; padding-bottom: .5rem; border-bottom: 1.5px dashed rgba(255,252,246,0.25); }
  .ho-proc__num { font-size: 1.5rem; font-weight: 800; color: var(--ho-lime); line-height: 1; }
  .ho-proc__eta { font-size: .6rem; letter-spacing: .15em; color: var(--ho-accent); }
  .ho-proc__t {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--ho-paper);
    margin: 0;
  }
  .ho-proc__body {
    font-size: .85rem;
    line-height: 1.45;
    color: rgba(255,252,246,0.75);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* SOLUCIONES POR PERFIL (Para quién)                      */
  /* ═══════════════════════════════════════════════════════ */
  .ho-aud-section {
    background: var(--ho-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-aud {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) { .ho-aud { grid-template-columns: repeat(3, 1fr); align-items: stretch; gap: 2rem; } }
  .ho-aud__item {
    background: var(--ho-paper);
    border: 3px solid var(--ho-ink);
    box-shadow: var(--ho-shadow);
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .ho-aud__item::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 8px;
    background: currentColor;
  }
  .ho-aud__item:hover { transform: translate(-4px, -4px); box-shadow: 14px 14px 0 currentColor; }
  .ho-aud__item--accent { color: var(--ho-accent); }
  .ho-aud__item--navy   { color: var(--ho-blue); }
  .ho-aud__item--woo    { color: var(--ho-woo); }

  .ho-aud__link {
    display: flex; flex-direction: column; gap: 1rem;
    padding: 2.25rem 1.75rem 1.75rem;
    text-decoration: none;
    color: var(--ho-ink);
    height: 100%;
  }
  .ho-aud__icon { width: 80px; height: 80px; color: currentColor; }
  .ho-aud__head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
  }
  .ho-aud__code {
    background: var(--ho-ink); color: var(--ho-lime);
    padding: .3rem .65rem;
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .2em;
  }
  .ho-aud__price {
    font-size: .82rem;
    font-weight: 800;
    color: currentColor;
    letter-spacing: .12em;
  }
  .ho-aud__name {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1;
    letter-spacing: -.025em;
    color: var(--ho-ink);
    margin: 0;
  }
  .ho-aud__sub {
    font-size: .65rem;
    letter-spacing: .25em;
    text-transform: uppercase;
    color: currentColor;
    font-weight: 800;
  }
  .ho-aud__desc {
    font-size: .92rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
    flex: 1;
  }
  .ho-aud__foot {
    padding-top: 1rem;
    border-top: 2px solid var(--ho-ink);
    margin-top: auto;
  }
  .ho-aud__cta {
    display: inline-flex; align-items: center; gap: .65rem;
    font-family: var(--font-mono);
    font-size: .8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: currentColor;
  }
  .ho-aud__item:hover .ho-aud__cta svg { transform: translateX(4px); }
  .ho-aud__cta svg { transition: transform .25s; }

  /* ═══════════════════════════════════════════════════════ */
  /* PORTFOLIO REAL (con imágenes)                           */
  /* ═══════════════════════════════════════════════════════ */
  .ho-port-section {
    background: var(--ho-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-port {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2.5px solid var(--ho-ink);
    background: var(--ho-ink);
  }
  @media (min-width: 768px)  { .ho-port { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  @media (min-width: 1280px) { .ho-port { grid-template-columns: repeat(3, 1fr); } }
  .ho-port__item { background: var(--ho-paper); }
  .ho-port__link {
    display: flex; flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--ho-ink);
    background: var(--ho-paper);
    transition: background .25s;
  }
  .ho-port__link:hover { background: var(--ho-paper-2); }

  .ho-port__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--ho-cream);
    border-bottom: 2px solid var(--ho-ink);
  }
  .ho-port__num, .ho-port__year {
    position: absolute;
    top: 1rem;
    z-index: 2;
    background: var(--ho-ink);
    color: var(--ho-lime);
    padding: .25rem .55rem;
    font-size: .62rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    font-weight: 800;
  }
  .ho-port__num  { left: 1rem; }
  .ho-port__year { right: 1rem; background: var(--ho-accent); color: var(--ho-ink); }
  .ho-port__img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .6s cubic-bezier(.16,1,.3,1), filter .4s;
    filter: grayscale(.15) contrast(1.02);
  }
  .ho-port__link:hover .ho-port__img { transform: scale(1.04); filter: none; }
  .ho-port__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(14,13,11,.85));
    display: flex; align-items: flex-end; justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity .35s;
  }
  .ho-port__link:hover .ho-port__overlay { opacity: 1; }
  .ho-port__overlay-cta {
    display: inline-flex; align-items: center; gap: .5rem;
    background: var(--ho-lime); color: var(--ho-ink);
    padding: .75rem 1.25rem;
    border: 2px solid var(--ho-ink);
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    box-shadow: 4px 4px 0 var(--ho-accent);
  }

  .ho-port__body { padding: 1.5rem; display: flex; flex-direction: column; gap: .65rem; flex: 1; }
  .ho-port__meta {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: .5rem;
  }
  .ho-port__cat {
    font-size: .65rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--brutal-text-muted);
  }
  .ho-port__result {
    font-size: .7rem;
    color: var(--ho-accent);
    font-weight: 800;
    letter-spacing: .1em;
  }
  .ho-port__client {
    font-size: clamp(1.3rem, 2.2vw, 1.55rem);
    line-height: 1;
    letter-spacing: -.025em;
    margin: 0;
    color: var(--ho-ink);
    transition: color .2s;
  }
  .ho-port__link:hover .ho-port__client { color: var(--ho-accent); }
  .ho-port__tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .25rem; }
  .ho-port__tag {
    background: var(--ho-paper-2);
    padding: .2rem .5rem;
    border: 1.5px solid var(--ho-ink);
    font-size: .58rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ho-ink);
  }
  .ho-port__url {
    font-size: .68rem;
    color: var(--brutal-text-muted);
    text-transform: uppercase;
    letter-spacing: .12em;
    padding-top: .75rem;
    border-top: 1.5px dashed var(--ho-ink);
    margin-top: auto;
  }

  .ho-port-strip {
    list-style: none; padding: 0;
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 2.5px solid var(--ho-ink);
    background: var(--ho-ink);
  }
  @media (min-width: 768px) { .ho-port-strip { grid-template-columns: repeat(4, 1fr); gap: 2px; } }
  .ho-port-strip li {
    background: var(--ho-paper);
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; align-items: flex-start; gap: .35rem;
  }
  .ho-port-strip__hi  { background: var(--ho-accent) !important; color: var(--ho-paper); }
  .ho-port-strip__hi2 { background: var(--ho-lime) !important; color: var(--ho-ink); }
  .ho-port-strip__v {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.02em;
  }
  .ho-port-strip__v sup, .ho-port-strip__v small {
    font-size: .5em;
    vertical-align: super;
    color: var(--ho-accent);
  }
  .ho-port-strip__hi .ho-port-strip__v sup, .ho-port-strip__hi .ho-port-strip__v small { color: var(--ho-ink); }
  .ho-port-strip__hi2 .ho-port-strip__v sup, .ho-port-strip__hi2 .ho-port-strip__v small { color: var(--ho-accent); }
  .ho-port-strip__l {
    font-family: var(--font-mono);
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    opacity: .85;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* TESTIMONIOS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .ho-quote-section {
    background: var(--ho-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-quotes {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .ho-quotes { grid-template-columns: repeat(3, 1fr); } }
  .ho-quote {
    position: relative;
    background: var(--ho-paper);
    border: 2.5px solid var(--ho-ink);
    box-shadow: var(--ho-shadow);
    padding: 2rem 1.5rem 1.5rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .ho-quote:hover { transform: translateY(-3px); }
  .ho-quote--0 { background: var(--ho-lime); }
  .ho-quote--1 { background: var(--ho-mint); }
  .ho-quote--2 { background: var(--ho-cream); }
  .ho-quote__metric {
    position: absolute;
    top: -12px; left: 16px;
    background: var(--ho-ink);
    color: var(--ho-lime);
    padding: .3rem .75rem;
    font-family: var(--font-mono);
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .12em;
    border: 2px solid var(--ho-ink);
    box-shadow: 3px 3px 0 var(--ho-accent);
  }
  .ho-quote__t {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ho-ink);
    margin: 0;
    flex: 1;
  }
  .ho-quote__f { display: flex; align-items: center; gap: .85rem; padding-top: 1rem; border-top: 2px dashed var(--ho-ink); }
  .ho-quote__avatar {
    width: 40px; height: 40px;
    background: var(--ho-ink); color: var(--ho-lime);
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .ho-quote__f div { display: flex; flex-direction: column; }
  .ho-quote__name { font-family: var(--font-display); font-weight: 700; font-size: .95rem; color: var(--ho-ink); }
  .ho-quote__role { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; opacity: .7; text-transform: uppercase; }

  /* ═══════════════════════════════════════════════════════ */
  /* TECH STACK con SVGs CUSTOM                              */
  /* ═══════════════════════════════════════════════════════ */
  .ho-tech-section {
    background: var(--ho-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
    position: relative;
    overflow: hidden;
  }
  .ho-tech-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(14,13,11,0.045) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .ho-tech-section > * { position: relative; }
  .ho-tech {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px)  { .ho-tech { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ho-tech { grid-template-columns: repeat(4, 1fr); } }
  .ho-tech__item {
    background: var(--ho-paper);
    border: 2.5px solid var(--ho-ink);
    box-shadow: 6px 6px 0 var(--ho-ink);
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    transition: transform .25s, box-shadow .25s;
    position: relative;
  }
  .ho-tech__item:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--ho-ink);
  }
  .ho-tech__item--orange  { background: rgba(255, 107, 53, 0.10); }
  .ho-tech__item--blue    { background: rgba(0, 59, 122, 0.08); }
  .ho-tech__item--woo     { background: rgba(127, 84, 179, 0.10); }
  .ho-tech__item--purple  { background: rgba(99, 91, 255, 0.10); }
  .ho-tech__item--cyan    { background: rgba(0, 195, 203, 0.10); }
  .ho-tech__item--green   { background: rgba(0, 184, 92, 0.10); }
  .ho-tech__item--orange-d { background: rgba(243, 128, 32, 0.10); }
  .ho-tech__item--yellow  { background: rgba(255, 214, 0, 0.15); }
  .ho-tech__item:hover { background: var(--ho-paper); }

  .ho-tech__i {
    font-size: .65rem;
    color: var(--ho-accent);
    font-weight: 800;
    letter-spacing: .2em;
  }
  .ho-tech__logo {
    width: 100%;
    aspect-ratio: 1;
    max-width: 120px;
    margin: 0 auto;
    filter: drop-shadow(0 4px 8px rgba(14,13,11,0.18));
    transition: transform .25s;
  }
  .ho-tech__item:hover .ho-tech__logo { transform: scale(1.04) rotate(-2deg); }
  .ho-tech__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    letter-spacing: -.015em;
    color: var(--ho-ink);
    margin: .25rem 0 0;
    text-align: center;
  }
  .ho-tech__desc {
    font-size: .82rem;
    line-height: 1.45;
    color: var(--brutal-text-secondary);
    margin: 0;
    text-align: center;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* COBERTURA                                               */
  /* ═══════════════════════════════════════════════════════ */
  .ho-cover-section {
    background: var(--ho-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-cover-grid {
    list-style: none; padding: 0; margin: 2rem 0 3rem;
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--ho-ink);
    background: var(--ho-ink);
  }
  @media (min-width: 640px) { .ho-cover-grid { grid-template-columns: repeat(2, 1fr); gap: 2px; } }
  @media (min-width: 1024px) { .ho-cover-grid { grid-template-columns: repeat(3, 1fr); } }
  .ho-cover-tile {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    gap: .35rem;
    padding: 1.75rem;
    background: var(--ho-paper);
    color: var(--ho-ink);
    text-decoration: none;
    min-height: 160px;
    transition: background .25s, color .25s;
    grid-template-areas: 'meta arrow' 'name name' 'sub sub';
  }
  .ho-cover-tile .text-meta { grid-area: meta; }
  .ho-cover-tile__name { grid-area: name; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: .95; letter-spacing: -.025em; }
  .ho-cover-tile__sub { grid-area: sub; font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); }
  .ho-cover-tile__arrow { grid-area: arrow; align-self: start; font-family: var(--font-mono); color: var(--ho-accent); font-size: 1.5rem; transition: transform .25s; }
  .ho-cover-tile:hover { background: var(--ho-accent); color: var(--ho-paper); }
  .ho-cover-tile:hover .ho-cover-tile__sub { color: var(--ho-paper); opacity: .85; }
  .ho-cover-tile:hover .ho-cover-tile__arrow { color: var(--ho-paper); transform: translateX(4px); }
  .ho-cover-tile--1:hover { background: var(--ho-lime); color: var(--ho-ink); }
  .ho-cover-tile--2:hover { background: var(--ho-ink); color: var(--ho-paper); }
  .ho-cover-tile--2:hover .ho-cover-tile__arrow { color: var(--ho-lime); }
  .ho-cover-tile--4:hover { background: var(--ho-lime); color: var(--ho-ink); }
  .ho-cover-tile--5:hover { background: var(--ho-ink); color: var(--ho-paper); }
  .ho-cover-tile--5:hover .ho-cover-tile__arrow { color: var(--ho-lime); }

  .ho-cover-h3 { display: block; margin-bottom: 1rem; color: var(--ho-accent); }
  .ho-comarcas {
    display: grid; gap: 0;
    grid-template-columns: 1fr;
    border: 2px solid var(--ho-ink);
  }
  @media (min-width: 768px) { .ho-comarcas { grid-template-columns: 1fr 1fr; } }
  .ho-comarca { background: var(--ho-paper); border-bottom: 1px solid var(--ho-ink); }
  @media (min-width: 768px) { .ho-comarca:nth-child(odd) { border-right: 1px solid var(--ho-ink); } }
  .ho-comarca[open] { background: var(--ho-paper-2); }
  .ho-comarca__sum {
    display: grid; grid-template-columns: 1fr auto auto;
    align-items: center; gap: 1rem;
    padding: 1.25rem 1.5rem; cursor: pointer; list-style: none;
  }
  .ho-comarca__sum::-webkit-details-marker { display: none; }
  .ho-comarca__name { font-size: 1.4rem; line-height: 1; letter-spacing: -.025em; }
  .ho-comarca__count { font-size: .65rem; text-transform: uppercase; letter-spacing: .14em; color: var(--brutal-text-muted); }
  .ho-comarca__toggle {
    width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--ho-paper); border: 2px solid var(--ho-ink);
    font-family: var(--font-mono); font-weight: 700;
    transition: transform .25s, background .15s, color .15s;
  }
  .ho-comarca[open] .ho-comarca__toggle { background: var(--ho-accent); color: var(--ho-paper); transform: rotate(45deg); }
  .ho-comarca__items { padding: 0 1.5rem 1.5rem; display: flex; flex-wrap: wrap; gap: .35rem; }
  .ho-comarca__chip:hover { background: var(--ho-ink); color: var(--ho-lime); }
  .ho-cover-cta { margin-top: 3rem; text-align: center; }

  /* ═══════════════════════════════════════════════════════ */
  /* BLOG preview                                            */
  /* ═══════════════════════════════════════════════════════ */
  .ho-blog-section {
    background: var(--ho-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--ho-ink);
  }
  .ho-blog {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .ho-blog { grid-template-columns: repeat(3, 1fr); } }
  .ho-blog__item {
    background: var(--ho-paper);
    border: 2.5px solid var(--ho-ink);
    box-shadow: 5px 5px 0 var(--ho-ink);
    transition: transform .25s, box-shadow .25s;
  }
  .ho-blog__item:hover { transform: translate(-3px, -3px); box-shadow: 8px 8px 0 var(--ho-accent); }
  .ho-blog__link { display: flex; flex-direction: column; gap: .85rem; padding: 1.5rem; text-decoration: none; color: var(--ho-ink); height: 100%; }
  .ho-blog__head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: .65rem;
    border-bottom: 2px dashed var(--ho-ink);
  }
  .ho-blog__num { font-size: .7rem; letter-spacing: .15em; color: var(--ho-accent); font-weight: 800; }
  .ho-blog__date { font-size: .65rem; letter-spacing: .15em; color: var(--ho-ink); opacity: .65; }
  .ho-blog__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.1;
    letter-spacing: -.015em;
    color: var(--ho-ink);
    margin: 0;
  }
  .ho-blog__excerpt {
    font-size: .88rem;
    line-height: 1.5;
    color: var(--brutal-text-secondary);
    flex: 1;
  }
  .ho-blog__foot {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: .75rem;
    border-top: 1.5px solid var(--ho-ink);
  }
  .ho-blog__tag {
    background: var(--ho-ink); color: var(--ho-lime);
    padding: .2rem .55rem;
    font-family: var(--font-mono);
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .15em;
  }
  .ho-blog__cta {
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 800;
    color: var(--ho-accent);
    letter-spacing: .15em;
