            <li class={`ho-quote ho-quote--${i}`}>
              <span class="ho-quote__metric">{t.metric}</span>
              <p class="ho-quote__t">"{t.text}"</p>
              <footer class="ho-quote__f">
                <span class="ho-quote__avatar">{t.author[0]}</span>
                <div>
                  <span class="ho-quote__name">{t.author}</span>
                  <span class="ho-quote__role">{t.role}</span>
                </div>
              </footer>
