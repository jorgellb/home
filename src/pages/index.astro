---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Solution from '../components/sections/Solution.astro';
import Process from '../components/sections/Process.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Technology from '../components/sections/Technology.astro';
import FAQ from '../components/sections/FAQ.astro';
import Contact from '../components/sections/Contact.astro';
import { getCollection } from 'astro:content';
import { comarcas, getPueblosByComarca } from '../data/pueblos-almeria';

// Get services from content collection
const servicesCollection = await getCollection('services');
const services = servicesCollection
  .filter(service => !service.data.draft)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

// Get testimonials from content collection
const testimonialsCollection = await getCollection('testimonials');
const testimonials = testimonialsCollection
  .filter(t => !t.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .map(t => ({
    name: t.data.name,
    role: t.data.role,
    company: t.data.company,
    companyUrl: t.data.companyUrl,
    text: t.data.text,
    rating: t.data.rating,
    image: t.data.image,
    imageAlt: t.data.imageAlt,
  }));


---

<BaseLayout
  title="Diseño Web Almería | Agencia de Páginas Web, SEO y Marketing Digital"
  description="Agencia de diseño web en Almería. Webs profesionales, tiendas online, SEO y dron 4K. Hosting gratuito, entrega en 1-2 semanas. Presupuesto gratis."
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Equipo de diseño web y marketing digital Platanito Rico en Almería"
  canonical="https://platanitorico.com/"
  type="website"
  lang="es"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      'name': 'Platanito Rico — Agencia de Diseño Web en Almería',
      'url': 'https://platanitorico.com',
      'logo': 'https://platanitorico.com/favicon.svg',
      'image': 'https://platanitorico.com/imagenes/equipo-diseno-mantenimiento-web.jpg',
      'description': 'Agencia de diseño web, marketing digital y producción audiovisual en Almería. Webs profesionales con hosting gratuito, SEO local y entrega en 1-2 semanas.',
      'telephone': '+34657085019',
      'email': 'hola@platanitorico.com',
      'priceRange': '€€',
      'sameAs': [
        'https://www.instagram.com/platanitorico/',
        'https://www.linkedin.com/company/platanitorico/'
      ],
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Ctra de Ronda, 82',
        'addressLocality': 'Vera',
        'addressRegion': 'Almería',
        'postalCode': '04620',
        'addressCountry': 'ES'
      },
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': 37.2471,
        'longitude': -1.8673
      },
      'areaServed': [
        { '@type': 'City', 'name': 'Almería' },
        { '@type': 'City', 'name': 'Vera' },
        { '@type': 'City', 'name': 'Mojácar' },
        { '@type': 'City', 'name': 'Huércal-Overa' },
        { '@type': 'City', 'name': 'Garrucha' },
        { '@type': 'AdministrativeArea', 'name': 'Provincia de Almería' }
      ],
      'aggregateRating': {
        '@type': 'AggregateRating',
        'ratingValue': '4.9',
        'reviewCount': '87',
        'bestRating': '5',
        'worstRating': '1'
      },
      'review': [
        {
          '@type': 'Review',
          'author': { '@type': 'Person', 'name': 'Ana Padilla' },
          'reviewRating': { '@type': 'Rating', 'ratingValue': '5', 'bestRating': '5' },
          'reviewBody': 'Desde el diseño de nuestra web hasta su mantenimiento, han demostrado un profesionalismo y dedicación excepcionales. Muy recomendables.'
        },
        {
          '@type': 'Review',
          'author': { '@type': 'Person', 'name': 'Juan Poveda' },
          'reviewRating': { '@type': 'Rating', 'ratingValue': '5', 'bestRating': '5' },
          'reviewBody': 'La creación de nuestro sitio web corporativo fue un proceso impecable. El equipo capturó a la perfección nuestros valores y visión.'
        },
        {
          '@type': 'Review',
          'author': { '@type': 'Person', 'name': 'Javier Ruiz' },
          'reviewRating': { '@type': 'Rating', 'ratingValue': '5', 'bestRating': '5' },
          'reviewBody': 'Nuestra inmobiliaria en Vera Playa necesitaba captar clientes internacionales. El portal web es impecable y recibimos leads diarios.'
        }
      ],
      'offerCatalog': {
        '@type': 'OfferCatalog',
        'name': 'Servicios de diseño web y marketing digital',
        'itemListElement': [
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Diseño web profesional', 'description': 'Páginas web corporativas desde 450€ con hosting gratuito' } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Tienda online / E-commerce', 'description': 'Tiendas online desde 900€ con pasarela de pago' } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'SEO y posicionamiento local', 'description': 'Estrategias SEO para posicionar en Google' } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Producción audiovisual con dron 4K', 'description': 'Vídeo corporativo, reels y fotografía aérea' } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Marketing digital', 'description': 'Google Ads, redes sociales y email marketing' } }
        ]
      },
      'openingHoursSpecification': {
        '@type': 'OpeningHoursSpecification',
        'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        'opens': '09:00',
        'closes': '18:00'
      }
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      'name': 'Platanito Rico',
      'url': 'https://platanitorico.com',
      'logo': {
        '@type': 'ImageObject',
        'url': 'https://platanitorico.com/imagenes/logo.png',
        'width': 200,
        'height': 60
      },
      'image': 'https://platanitorico.com/imagenes/equipo-diseno-mantenimiento-web.jpg',
      'description': 'Agencia de diseño web, marketing digital y producción audiovisual con sede en Vera, Almería. Especialistas en SEO local para pymes y autónomos de la provincia de Almería.',
      'telephone': '+34657085019',
      'email': 'hola@platanitorico.com',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Ctra de Ronda, 82',
        'addressLocality': 'Vera',
        'addressRegion': 'Almería',
        'postalCode': '04620',
        'addressCountry': 'ES'
      },
      'sameAs': [
        'https://www.instagram.com/platanitorico/',
        'https://www.linkedin.com/company/platanitorico/'
      ],
      'foundingDate': '2010',
      'areaServed': { '@type': 'AdministrativeArea', 'name': 'Almería' }
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'Platanito Rico',
      'url': 'https://platanitorico.com',
      'potentialAction': {
        '@type': 'SearchAction',
        'target': 'https://platanitorico.com/?s={search_term_string}',
        'query-input': 'required name=search_term_string'
      }
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      'mainEntity': [
        {
          '@type': 'Question',
          'name': '¿Cuánto cuesta una página web profesional en Almería?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Una web corporativa profesional en Almería parte desde 450€. Tiendas online desde 900€. Incluimos hosting gratuito para webs estáticas, lo que supone un ahorro de 150-300€ al año frente a WordPress. Presupuesto personalizado sin compromiso.'
          }
        },
        {
          '@type': 'Question',
          'name': '¿Cuánto tiempo tarda en estar lista una web?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Entre 1 y 2 semanas para webs corporativas. Tiendas online y proyectos más complejos pueden tardar 3-4 semanas. Te mantenemos informado en cada fase del proceso.'
          }
