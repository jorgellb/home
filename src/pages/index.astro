---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Contact from '../components/sections/Contact.astro';
import { comarcas, getPueblosByComarca } from '../data/pueblos-almeria';

type Post = CollectionEntry<'posts'>;

// Posts recientes (3 últimos)
const allPosts = await getCollection('posts', ({ data }: Post) => !data.draft);
const recentPosts = allPosts
  .sort((a: Post, b: Post) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

function formatDateShort(d: Date): string {
  return d.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit' });
}

// ─── DATOS HOME ────────────────────────────────

// Servicios cluster (con preview color por área)
const servicios = [
  { num: '01', href: '/desarrollo-web/',  title: 'Diseño Web',       sub: 'Astro · WordPress · Custom', desc: 'Webs que cargan en <2s y aparecen en Google. CWV verde, accesibles, indexables.', icon: 'web',    color: 'green',    metric: '99+', metricLbl: 'Lighthouse' },
  { num: '02', href: '/audiovisual/',     title: 'Audiovisual',      sub: 'Dron 4K · Vídeo · Foto',     desc: 'Producción con Mavic 3 Pro. Vídeo corporativo, reels, tours 360°, fotografía aérea.', icon: 'cam',    color: 'red',      metric: '4K', metricLbl: 'Resolución' },
  { num: '03', href: '/marketing/',       title: 'Marketing · SEO',  sub: 'SEM · SEO · Email · RRSS',   desc: 'Tráfico cualificado vía Google Ads, SEO local y email automation. Conversión medida.', icon: 'mkt',    color: 'blue',     metric: '+180%', metricLbl: 'Leads medio' },
  { num: '04', href: '/diseno-grafico/',  title: 'Diseño Gráfico',   sub: 'Branding · Print · Editorial', desc: 'Identidad visual, papelería corporativa, packaging, catálogos y editorial.', icon: 'art',    color: 'magenta',  metric: '∞', metricLbl: 'Conceptos' },
  { num: '05', href: '/soluciones/ecommerce/', title: 'E-commerce',  sub: 'WooCommerce · 0% comisión',  desc: 'Tienda WooCommerce con Stripe + Bizum + Redsys. Sin comisiones por venta.',         icon: 'cart',   color: 'woo',      metric: '0%', metricLbl: 'Comisión venta' },
  { num: '06', href: '/soporte/',         title: 'Mantenimiento',    sub: 'Soporte · Backups · WAF',    desc: 'Vigilancia 24/7, backups diarios, parches de seguridad <24h. Sin permanencia.',      icon: 'shield', color: 'gold',     metric: '99.9%', metricLbl: 'Uptime' },
];

// 4 razones diferenciales
const razones = [
  { num: '01', t: 'Equipo local en Almería',    s: 'Aquí desde 2018. Tomamos café juntos si quieres. Hablas con quien va a trabajar — sin intermediarios, sin comerciales.' },
  { num: '02', t: 'Sin permanencia',            s: 'Nadie firma contratos eternos. Pago contra hitos. Si no encajamos, te exportamos todo y te vas. Nuestros clientes se quedan por resultados.' },
  { num: '03', t: 'Respuesta < 4 horas',        s: 'WhatsApp, email o teléfono. Sin tickets, sin filtros, sin "te derivamos a otro compañero". Personas reales en tiempo real.' },
  { num: '04', t: 'Cero plantillas',            s: 'Cada web a medida. Diseñamos por TÚ negocio, no por catálogo de Wix. Si quieres una plantilla — hay opciones más baratas en otro sitio.' },
];

// KPIs / stats
const stats = [
  { k: '200+', l: 'Proyectos lanzados' },
  { k: '8',    l: 'Años en Almería' },
  { k: '99%',  l: 'Clientes satisfechos' },
  { k: '<4h',  l: 'Respuesta media' },
];

// Proceso 5 pasos
const proceso = [
  { num: '01', t: 'Briefing',         body: 'Llamada de 30 min · te escuchamos, sin presentaciones interminables.', eta: 'Día 1' },
  { num: '02', t: 'Propuesta',         body: 'Presupuesto cerrado por escrito · plan de trabajo · fecha de entrega.', eta: 'Día 3' },
  { num: '03', t: 'Diseño',            body: 'Mockups + revisiones. Lo apruebas antes de programar nada.',           eta: 'Sem 1–2' },
  { num: '04', t: 'Desarrollo',        body: 'Construcción real. Acceso a entorno staging para que veas el progreso.', eta: 'Sem 2–4' },
  { num: '05', t: 'Lanzamiento',       body: 'Migración, monitorización, formación de tu equipo, soporte activo.',    eta: 'Sem 4–6' },
];

// Casos / portfolio destacados (mock)
const casos = [
  { sector: 'INMOBILIARIA',  cliente: 'Inmo Vera Playa',      result: '+210% leads · 6 meses', color: 'green',   slug: '#' },
  { sector: 'HOSTELERÍA',    cliente: 'Hotel Mojácar Premium', result: '+45% reservas directas', color: 'red',     slug: '#' },
  { sector: 'E-COMMERCE',    cliente: 'Pastelería online',     result: '12k€ · primer mes',     color: 'woo',     slug: '#' },
  { sector: 'INDUSTRIA',     cliente: 'Distribuidora Almería', result: 'Top 3 Google · 4 keys', color: 'blue',    slug: '#' },
  { sector: 'CLÍNICA',       cliente: 'Estética Roquetas',     result: '+38% nuevas consultas',  color: 'magenta', slug: '#' },
  { sector: 'CONSULTORÍA',   cliente: 'Despacho legal',        result: 'Top 3 abogados Almería', color: 'gold',    slug: '#' },
];

// Tech stack home
const tech = [
  { k: 'Astro',       v: 'Estático ultrarrápido' },
  { k: 'WordPress',   v: 'Blog · contenido editable' },
  { k: 'WooCommerce', v: 'Tiendas sin comisión' },
  { k: 'Netlify',     v: 'Hosting + CDN global' },
  { k: 'Cloudflare',  v: 'WAF + DDoS protection' },
  { k: 'GA4 · GSC',   v: 'Analytics + Search Console' },
];

// Testimonios destacados (subset de los del JSON-LD)
const testimonios = [
  { text: 'Desde el diseño de nuestra web hasta su mantenimiento, han demostrado un profesionalismo y dedicación excepcionales.',          author: 'Ana Padilla',  role: 'Directora · Almería', metric: '★★★★★ · 2026' },
  { text: 'Nuestra inmobiliaria en Vera Playa necesitaba captar clientes internacionales. El portal es impecable y recibimos leads diarios.', author: 'Javier Ruiz',  role: 'Vera Playa · Inmo',   metric: '+210% LEADS' },
  { text: 'La creación de nuestro sitio web corporativo fue un proceso impecable. El equipo capturó a la perfección nuestros valores.',     author: 'Juan Poveda',  role: 'Corporate · Almería', metric: 'TOP 3 GOOGLE' },
];

// FAQ home (resumida)
const faqHome = [
  { q: '¿Cuánto cuesta una web profesional en Almería?', a: 'Web corporativa desde 3.490€. Tienda online WooCommerce desde 1.490€. Lanzamiento emprendedor desde 450€. Presupuesto cerrado, sin sorpresas, sin comisiones por venta.' },
  { q: '¿Cuánto tarda en estar lista?',                   a: 'De 1 semana (lanzamiento exprés) a 14 semanas (corporativa premium multilingüe). Cumplimos plazos siempre que las aprobaciones lleguen a tiempo.' },
  { q: '¿Hay permanencia?',                                a: 'No. Sin permanencia. Cancelas cuando quieras. Tu web es 100% tuya, exportable, migrable. Nuestros clientes se quedan por resultados.' },
  { q: '¿Qué pasa después del primer año (hosting)?',     a: 'Hosting + correo desde 90€/año si sigues con nosotros, o exportas y te vas. Sin extorsión, sin sorpresas. Tú decides cada año.' },
];
---

<BaseLayout
  title="Diseño Web Almería | Agencia de Páginas Web, SEO y Marketing Digital"
  description="Agencia de diseño web en Almería. Webs profesionales, tiendas online, SEO y dron 4K. Hosting gratuito, entrega en 1-2 semanas. Presupuesto gratis."
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Equipo de diseño web y marketing digital Platanito Rico en Almería"
  canonical="https://platanitorico.com/"
  type="website"
  lang="es"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      'name': 'Platanito Rico — Agencia de Diseño Web en Almería',
      'url': 'https://platanitorico.com',
      'logo': 'https://platanitorico.com/favicon.svg',
      'image': 'https://platanitorico.com/imagenes/equipo-diseno-mantenimiento-web.jpg',
      'description': 'Agencia de diseño web, marketing digital y producción audiovisual en Almería. Webs profesionales con hosting gratuito, SEO local y entrega en 1-2 semanas.',
      'telephone': '+34657085019',
      'email': 'hola@platanitorico.com',
      'priceRange': '€€',
      'sameAs': ['https://www.instagram.com/platanitorico/', 'https://www.linkedin.com/company/platanitorico/'],
      'address': { '@type': 'PostalAddress', 'streetAddress': 'Ctra de Ronda, 82', 'addressLocality': 'Vera', 'addressRegion': 'Almería', 'postalCode': '04620', 'addressCountry': 'ES' },
      'geo': { '@type': 'GeoCoordinates', 'latitude': 37.2471, 'longitude': -1.8673 },
      'areaServed': [
        { '@type': 'City', 'name': 'Almería' }, { '@type': 'City', 'name': 'Vera' }, { '@type': 'City', 'name': 'Mojácar' },
        { '@type': 'City', 'name': 'Huércal-Overa' }, { '@type': 'City', 'name': 'Garrucha' },
        { '@type': 'AdministrativeArea', 'name': 'Provincia de Almería' }
      ],
      'aggregateRating': { '@type': 'AggregateRating', 'ratingValue': '4.9', 'reviewCount': '87', 'bestRating': '5', 'worstRating': '1' },
      'review': [
        { '@type': 'Review', 'author': { '@type': 'Person', 'name': 'Ana Padilla' }, 'reviewRating': { '@type': 'Rating', 'ratingValue': '5', 'bestRating': '5' }, 'reviewBody': 'Desde el diseño de nuestra web hasta su mantenimiento, han demostrado un profesionalismo y dedicación excepcionales. Muy recomendables.' },
        { '@type': 'Review', 'author': { '@type': 'Person', 'name': 'Juan Poveda' }, 'reviewRating': { '@type': 'Rating', 'ratingValue': '5', 'bestRating': '5' }, 'reviewBody': 'La creación de nuestro sitio web corporativo fue un proceso impecable. El equipo capturó a la perfección nuestros valores y visión.' },
        { '@type': 'Review', 'author': { '@type': 'Person', 'name': 'Javier Ruiz' }, 'reviewRating': { '@type': 'Rating', 'ratingValue': '5', 'bestRating': '5' }, 'reviewBody': 'Nuestra inmobiliaria en Vera Playa necesitaba captar clientes internacionales. El portal web es impecable y recibimos leads diarios.' }
      ],
      'offerCatalog': {
        '@type': 'OfferCatalog',
        'name': 'Servicios de diseño web y marketing digital',
        'itemListElement': [
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Diseño web profesional', 'description': 'Páginas web corporativas desde 450€ con hosting gratuito' } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Tienda online / E-commerce', 'description': 'Tiendas online desde 900€ con pasarela de pago' } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'SEO y posicionamiento local', 'description': 'Estrategias SEO para posicionar en Google' } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Producción audiovisual con dron 4K', 'description': 'Vídeo corporativo, reels y fotografía aérea' } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Marketing digital', 'description': 'Google Ads, redes sociales y email marketing' } }
        ]
      },
      'openingHoursSpecification': { '@type': 'OpeningHoursSpecification', 'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], 'opens': '09:00', 'closes': '18:00' }
    },
    {
      '@context': 'https://schema.org', '@type': 'Organization', 'name': 'Platanito Rico', 'url': 'https://platanitorico.com',
      'logo': { '@type': 'ImageObject', 'url': 'https://platanitorico.com/imagenes/logo.png', 'width': 200, 'height': 60 },
      'image': 'https://platanitorico.com/imagenes/equipo-diseno-mantenimiento-web.jpg',
      'description': 'Agencia de diseño web, marketing digital y producción audiovisual con sede en Vera, Almería.',
      'telephone': '+34657085019', 'email': 'hola@platanitorico.com',
      'address': { '@type': 'PostalAddress', 'streetAddress': 'Ctra de Ronda, 82', 'addressLocality': 'Vera', 'addressRegion': 'Almería', 'postalCode': '04620', 'addressCountry': 'ES' },
      'sameAs': ['https://www.instagram.com/platanitorico/', 'https://www.linkedin.com/company/platanitorico/'],
      'foundingDate': '2018', 'areaServed': { '@type': 'AdministrativeArea', 'name': 'Almería' }
    },
    { '@context': 'https://schema.org', '@type': 'WebSite', 'name': 'Platanito Rico', 'url': 'https://platanitorico.com' },
    {
      '@context': 'https://schema.org', '@type': 'FAQPage',
      'mainEntity': faqHome.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } }))
    }
  ]}
>
  <Header />

  <main id="main-content" class="ho">

    {/* ════════════════════════════════════════════════ */}
    {/* HERO — MANIFIESTO + LOGOTIPO GIGANTE              */}
    {/* ════════════════════════════════════════════════ */}
    <section class="ho-hero">
      <div class="container-brutal">

        {/* Top bar */}
        <header class="ho-hero__top">
          <span class="text-meta">N.º 001 — Portada · Vol. {new Date().getFullYear() - 2017}</span>
          <span class="text-meta ho-hero__status">
            <span class="ho-pulse"></span>
            ACEPTANDO PROYECTOS · 2026 · ALMERÍA
          </span>
        </header>

        <div class="divider-brutal"></div>

        {/* Logotipo gigante editorial */}
        <div class="ho-mast">
          <div class="ho-mast__l">
            <span class="text-meta ho-mast__chapter">Cap. 01 / Estudio digital</span>
            <h1 class="ho-mast__title">
              <span class="ho-mast__pre">★ ESTUDIO ★</span>
              <span class="ho-mast__line1">PLATANITO</span>
              <span class="ho-mast__line2"><em>rico</em></span>
              <span class="ho-mast__sub">— DISEÑO · WEB · DRON · MARKETING · DESDE 2018 —</span>
            </h1>
          </div>

          {/* Sello giratorio */}
          <aside class="ho-mast__seal" aria-hidden="true">
            <svg viewBox="0 0 180 180" width="100%" height="100%">
              <defs>
                <path id="ho-seal-arc-1" d="M90,90 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/>
                <path id="ho-seal-arc-2" d="M90,90 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"/>
              </defs>
              {/* Anillo exterior */}
              <circle cx="90" cy="90" r="86" fill="none" stroke="#0E0D0B" stroke-width="2.5"/>
              <circle cx="90" cy="90" r="78" fill="none" stroke="#0E0D0B" stroke-width="1.5" stroke-dasharray="3 2"/>
              <g class="ho-spin">
                <text font-family="monospace" font-size="11" font-weight="bold" fill="#0E0D0B" letter-spacing="3.5">
                  <textPath href="#ho-seal-arc-1" startOffset="0%">★ PLATANITO RICO ★ ESTUDIO DIGITAL ★ ALMERÍA · ESPAÑA ★ EST. 2018 ★</textPath>
                </text>
              </g>
              {/* Estrella central */}
              <circle cx="90" cy="90" r="62" fill="#0E0D0B"/>
              <circle cx="90" cy="90" r="56" fill="none" stroke="#D6FF44" stroke-width="1.5" stroke-dasharray="2 1.5"/>
              <g class="ho-spin-rev">
                <text font-family="monospace" font-size="8" font-weight="bold" fill="#D6FF44" letter-spacing="2">
                  <textPath href="#ho-seal-arc-2" startOffset="0%">RESPUESTA · 4H · SIN PERMANENCIA · </textPath>
                </text>
              </g>
              <text x="90" y="78" text-anchor="middle" font-family="serif" font-size="32" font-weight="bold" fill="#D6FF44">P★</text>
              <text x="90" y="100" text-anchor="middle" font-family="monospace" font-size="9" font-weight="bold" fill="#FFFCF6" letter-spacing="2">RICO</text>
              <text x="90" y="112" text-anchor="middle" font-family="monospace" font-size="6" fill="#FFFCF6" letter-spacing="1.5">★ 2026 ★</text>
            </svg>
          </aside>
        </div>

        {/* Manifiesto */}
        <p class="ho-manifest">
          Hacemos webs <em>brutalmente bonitas</em> que <strong>cargan en menos de 2 segundos</strong>,
          <em>aparecen en Google</em> y <strong>convierten visitantes en clientes</strong>.
          Sin plantillas. Sin permanencia. Sin tonterías.
        </p>

        {/* CTAs */}
        <div class="ho-hero__cta">
          <a href="/contacto" class="ho-btn ho-btn--primary">
            <span>Empezar mi proyecto</span>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#servicios" class="ho-btn ho-btn--ghost">
            Ver servicios ↓
          </a>
        </div>

        {/* Stats band */}
        <ul class="ho-stats">
          {stats.map((s, i) => (
            <li class={`ho-stat ho-stat--${i}`}>
              <span class="ho-stat__k text-mono">{s.k}</span>
              <span class="ho-stat__l">{s.l}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Marquee anuncio */}
      <div class="ho-marquee">
        <div class="ho-marquee__track">
          {Array.from({length: 5}).map(() => (
            <span>★ DISEÑO WEB ★ TIENDAS WOOCOMMERCE ★ MARKETING SEO ★ DRON 4K ★ MANTENIMIENTO 24/7 ★ BRANDING ★ </span>
          ))}
        </div>
      </div>
    </section>

    {/* ════════════════════════════════════════════════ */}
    {/* RAZONES — POR QUÉ NOSOTROS                       */}
    {/* ════════════════════════════════════════════════ */}
    <section class="ho-why-section">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Por qué nosotros</span>
            <h2 class="heading-display brutal-section-head__title">
              Cuatro razones,
              <em class="heading-editorial">cero excusas.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            En 8 años en Almería hemos aprendido qué <strong>importa de verdad</strong>
            cuando contratas un equipo digital. Esto es lo que ofrecemos —
            y lo que NO toleramos.
          </p>
        </header>

        <ol class="ho-why">
          {razones.map((r, i) => (
            <li class={`ho-why__item ho-why__item--${i}`}>
              <header class="ho-why__head">
                <span class="text-mono ho-why__num">{r.num}</span>
                <span class="ho-why__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22"><path d="M 5 12 L 10 17 L 19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </header>
              <h3 class="ho-why__t heading-display">{r.t}</h3>
              <p class="ho-why__s">{r.s}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ════════════════════════════════════════════════ */}
    {/* SERVICIOS — BENTO 6-UP                            */}
    {/* ════════════════════════════════════════════════ */}
    <section class="ho-svc-section" id="servicios">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Servicios</span>
            <h2 class="heading-display brutal-section-head__title">
              Seis disciplinas,
              <em class="heading-editorial">un solo equipo.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Diseño web, audiovisual, marketing, identidad, e-commerce y
            mantenimiento. Hechos por el <strong>mismo equipo bajo el mismo techo</strong>.
            Sin descoordinación, sin "te derivamos al freelance X".
          </p>
        </header>

        <ol class="ho-svc">
          {servicios.map((s) => (
            <li class={`ho-svc__item ho-svc__item--${s.color}`}>
              <a href={s.href} class="ho-svc__link">

                <header class="ho-svc__head">
                  <span class="text-mono ho-svc__num">{s.num}</span>
                  <span class="text-mono ho-svc__sub">{s.sub}</span>
                </header>

                <div class="ho-svc__icon" aria-hidden="true">
                  {s.icon === 'web'    && <svg viewBox="0 0 60 60" width="100%" height="100%"><rect x="6" y="10" width="48" height="36" rx="2" fill="currentColor" stroke="#0E0D0B" stroke-width="3"/><line x1="6" y1="18" x2="54" y2="18" stroke="#0E0D0B" stroke-width="2"/><circle cx="11" cy="14" r="1.5" fill="#0E0D0B"/><circle cx="16" cy="14" r="1.5" fill="#0E0D0B"/><circle cx="21" cy="14" r="1.5" fill="#0E0D0B"/><line x1="14" y1="28" x2="46" y2="28" stroke="#0E0D0B" stroke-width="2.5" stroke-linecap="round"/><line x1="14" y1="36" x2="38" y2="36" stroke="#0E0D0B" stroke-width="2.5" stroke-linecap="round"/></svg>}
                  {s.icon === 'cam'    && <svg viewBox="0 0 60 60" width="100%" height="100%"><rect x="6" y="16" width="38" height="28" rx="2" fill="currentColor" stroke="#0E0D0B" stroke-width="3"/><path d="M 44 24 L 54 18 L 54 42 L 44 36 Z" fill="currentColor" stroke="#0E0D0B" stroke-width="3"/><circle cx="22" cy="30" r="7" fill="#FFFCF6" stroke="#0E0D0B" stroke-width="2"/><circle cx="22" cy="30" r="3" fill="#0E0D0B"/><circle cx="38" cy="22" r="2" fill="#DC1B2C" stroke="#0E0D0B" stroke-width="1.5"/></svg>}
                  {s.icon === 'mkt'    && <svg viewBox="0 0 60 60" width="100%" height="100%"><path d="M 6 50 L 18 36 L 30 44 L 42 22 L 54 10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="54" cy="10" r="4" fill="currentColor" stroke="#0E0D0B" stroke-width="2"/><circle cx="42" cy="22" r="3.5" fill="currentColor" stroke="#0E0D0B" stroke-width="2"/><circle cx="30" cy="44" r="3.5" fill="currentColor" stroke="#0E0D0B" stroke-width="2"/><circle cx="18" cy="36" r="3.5" fill="currentColor" stroke="#0E0D0B" stroke-width="2"/><line x1="6" y1="54" x2="54" y2="54" stroke="#0E0D0B" stroke-width="2"/></svg>}
                  {s.icon === 'art'    && <svg viewBox="0 0 60 60" width="100%" height="100%"><path d="M 30 8 C 18 8 8 18 8 30 C 8 42 18 50 30 50 C 33 50 35 47 35 44 C 35 41 32 41 32 38 C 32 35 35 33 38 33 L 44 33 C 49 33 52 30 52 24 C 52 16 42 8 30 8 Z" fill="currentColor" stroke="#0E0D0B" stroke-width="2.5"/><circle cx="15" cy="24" r="3" fill="#DC1B2C" stroke="#0E0D0B" stroke-width="1.5"/><circle cx="22" cy="14" r="3" fill="#FFD600" stroke="#0E0D0B" stroke-width="1.5"/><circle cx="38" cy="14" r="3" fill="#00B85C" stroke="#0E0D0B" stroke-width="1.5"/><circle cx="45" cy="24" r="3" fill="#7F54B3" stroke="#0E0D0B" stroke-width="1.5"/></svg>}
                  {s.icon === 'cart'   && <svg viewBox="0 0 60 60" width="100%" height="100%"><circle cx="22" cy="50" r="4" fill="currentColor" stroke="#0E0D0B" stroke-width="2"/><circle cx="44" cy="50" r="4" fill="currentColor" stroke="#0E0D0B" stroke-width="2"/><path d="M 4 8 L 12 8 L 18 38 L 48 38 L 54 16 L 16 16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M 30 22 L 30 28 M 27 25 L 33 25" stroke="#0E0D0B" stroke-width="2.5" stroke-linecap="round"/></svg>}
                  {s.icon === 'shield' && <svg viewBox="0 0 60 60" width="100%" height="100%"><path d="M 30 6 C 22 6 16 9 8 12 L 8 30 C 8 44 30 54 30 54 C 30 54 52 44 52 30 L 52 12 C 44 9 38 6 30 6 Z" fill="currentColor" stroke="#0E0D0B" stroke-width="2.5"/><path d="M 18 30 L 26 38 L 42 22" fill="none" stroke="#0E0D0B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                </div>

                <h3 class="ho-svc__title heading-display">{s.title}</h3>
                <p class="ho-svc__desc">{s.desc}</p>

                <footer class="ho-svc__foot">
                  <div class="ho-svc__metric">
                    <span class="ho-svc__metric-v text-mono">{s.metric}</span>
                    <span class="ho-svc__metric-l">{s.metricLbl}</span>
                  </div>
                  <span class="ho-svc__cta">Ver más →</span>
                </footer>
              </a>
            </li>
          ))}
        </ol>
      </div>
