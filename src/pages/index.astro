  }
  @media (min-width: 768px) { .ho-stats { grid-template-columns: repeat(4, 1fr); } }
  .ho-stat {
    background: var(--ho-paper);
    padding: 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--ho-ink);
    border-bottom: 2px solid var(--ho-ink);
  }
  .ho-stat:nth-child(2n) { border-right: none; }
  .ho-stat:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .ho-stat:nth-child(2n)      { border-right: 2px solid var(--ho-ink); }
    .ho-stat:nth-child(4n)      { border-right: none; }
    .ho-stat:nth-last-child(-n+2) { border-bottom: 2px solid var(--ho-ink); }
    .ho-stat:nth-last-child(-n+4) { border-bottom: none; }
  }
  .ho-stat--0 { background: var(--ho-accent); color: var(--ho-paper); }
  .ho-stat--1 { background: var(--ho-paper); }
  .ho-stat--2 { background: var(--ho-lime); }
  .ho-stat--3 { background: var(--ho-ink); color: var(--ho-paper); }
  .ho-stat--3 .ho-stat__k { color: var(--ho-lime); }
  .ho-stat__k { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -.03em; }
  .ho-stat__l { font-family: var(--font-mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .15em; opacity: .85; }

