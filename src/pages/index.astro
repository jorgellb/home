  <Footer />
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · HOME EDITORIAL                                 */
  /* ═══════════════════════════════════════════════════════ */
  .ho {
    --ho-paper:    #FFFCF6;
    --ho-paper-2:  #F5EFE0;
