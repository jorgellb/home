                  <span class="ho-faq__q">{f.q}</span>
                  <span class="ho-faq__toggle" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"><path d="M 6 9 L 12 15 L 18 9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
