                  <h3 class="ho-blog__title">{p.data.title}</h3>
                  {p.data.excerpt && <p class="ho-blog__excerpt">{p.data.excerpt}</p>}
                  <footer class="ho-blog__foot">
                    {p.data.categories && p.data.categories[0] && (
