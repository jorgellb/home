            </p>
          </header>

          <ol class="ho-blog">
            {recentPosts.map((p: Post, i: number) => (
              <li class="ho-blog__item">
                <a href={`/blog/${p.data.slug}`} class="ho-blog__link">
                  <header class="ho-blog__head">
                    <span class="text-mono ho-blog__num">N.º {String(i+1).padStart(2,'0')}</span>
                    <span class="text-mono ho-blog__date">{formatDateShort(p.data.publishedAt)}</span>
