  image="/imagenes/hero/cala-cristal-1920.jpg"
  imageAlt="Costa de Cala Cristal en Carboneras grabada con dron por Platanito Rico, agencia de diseño web en Almería"
  canonical="https://platanitorico.com/"
  type="website"
  lang="es"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
