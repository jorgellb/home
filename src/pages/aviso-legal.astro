---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = "Aviso Legal | Platanito Rico";
const description = "Información legal y condiciones de uso del sitio web de Platanito Rico.";
const lastUpdate = "febrero 2026";
const docId = "AL-2026-030";

const toc = [
  { n: '01', id: 's1', label: 'Datos identificativos' },
  { n: '02', id: 's2', label: 'Propiedad intelectual' },
  { n: '03', id: 's3', label: 'Condiciones de uso' },
  { n: '04', id: 's4', label: 'Exención de responsabilidad' },
  { n: '05', id: 's5', label: 'Legislación aplicable' },
];
---

<BaseLayout title={title} description={description} noindex={true}>
  <Header />

  <main class="legal">
    <div class="legal-gazette" aria-hidden="true">
      <div class="legal-gazette__track">
        {Array.from({length: 4}).map(() => (
          <>
            <span>Documento Oficial</span><span>★</span>
            <span>Aviso Legal</span><span>★</span>
            <span>LSSI · Ley 34/2002 · Art. 10</span><span>★</span>
            <span>Jurisdicción Almería · España</span><span>★</span>
            <span>ID · {docId}</span><span>★</span>
          </>
        ))}
      </div>
    </div>

    <section class="legal-mast">
      <div class="container-brutal">
        <header class="legal-mast__head">
          <span class="legal-mast__edition">N.º 030 — Documentos Oficiales · Vol. 2026</span>
          <span class="legal-mast__edition">★ Vigente desde {lastUpdate}</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="legal-mast__doc">
          <div>
            <span class="legal-mast__num">030</span>
            <h1 class="legal-mast__title">
              Aviso
              <em>legal.</em>
            </h1>
          </div>
          <div style="display:flex;gap:1rem;flex-wrap:wrap;">
            <div class="legal-seal">
              <span class="legal-seal__star">§</span>
              <span class="legal-seal__line">CUMPLE</span>
              <span class="legal-seal__line legal-seal__line--big">LSSI</span>
              <span class="legal-seal__line">Ley 34/2002 · Art. 10</span>
            </div>
            <div class="legal-seal legal-seal--accent">
              <span class="legal-seal__star">⚖</span>
              <span class="legal-seal__line">FUERO</span>
              <span class="legal-seal__line legal-seal__line--big">ALMERÍA</span>
              <span class="legal-seal__line">Jurisdicción ES</span>
            </div>
          </div>
        </div>

        <p class="legal-mast__intro">
          En cumplimiento del <strong>artículo 10 de la LSSI</strong> (Ley 34/2002), aquí están los datos
          identificativos del titular y las condiciones de uso del sitio web.
        </p>

        <dl class="legal-mast__spec">
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Documento</dt>
            <dd class="legal-mast__spec-v">{docId}</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Última actualización</dt>
            <dd class="legal-mast__spec-v">{lastUpdate}</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Titular</dt>
            <dd class="legal-mast__spec-v">Jorge L. López Barrio</dd>
          </div>
          <div class="legal-mast__spec-cell">
            <dt class="legal-mast__spec-k">Tiempo de lectura</dt>
            <dd class="legal-mast__spec-v">~3 minutos</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="container-brutal">
      <div class="legal-grid">
        <aside class="legal-toc" aria-label="Índice del documento">
          <header class="legal-toc__head">
            <span class="text-meta">Índice</span>
            <span class="text-meta">{toc.length} secciones</span>
          </header>
          <ol class="legal-toc__list">
            {toc.map((t) => (
              <li class="legal-toc__item">
                <a href={`#${t.id}`} class="legal-toc__link" data-toc-link>
                  <span class="legal-toc__num">{t.n}</span>
                  <span>{t.label}</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="legal-toc__seals">
            <button type="button" class="legal-toc__action" onclick="window.print()">⎙ Imprimir</button>
            <a href="/privacidad/" class="legal-toc__action">→ Privacidad</a>
          </div>
        </aside>

        <article class="legal-article">
          <p>
            En cumplimiento del artículo 10 de la <strong>Ley 34/2002, de 11 de julio, de Servicios de la
            Sociedad de la Información y Comercio Electrónico (LSSI)</strong>, a continuación se exponen los
            datos identificativos del titular del presente sitio web.
          </p>

          <section id="s1" class="legal-section">
            <span class="legal-section__num">N.º 01</span>
            <h2 class="legal-section__title">
              Datos
              <em>identificativos.</em>
            </h2>

            <div class="legal-datasheet">
              <header class="legal-datasheet__head">
                <span>Ficha del titular</span>
                <span>LSSI · Art. 10</span>
              </header>
              <ul class="legal-datasheet__list">
                <li><span class="legal-datasheet__k">Titular</span><span class="legal-datasheet__v">Jorge Luis López Barrio</span></li>
                <li><span class="legal-datasheet__k">Nombre comercial</span><span class="legal-datasheet__v">Platanito Rico</span></li>
                <li><span class="legal-datasheet__k">NIF</span><span class="legal-datasheet__v">05298279E</span></li>
                <li><span class="legal-datasheet__k">Domicilio social</span><span class="legal-datasheet__v">Alborada 3, 04621 Vera Playa, Almería · España</span></li>
                <li><span class="legal-datasheet__k">Actividad</span><span class="legal-datasheet__v">Servicios digitales · web · diseño · marketing · audiovisual</span></li>
                <li><span class="legal-datasheet__k">Correo electrónico</span><span class="legal-datasheet__v"><a href="mailto:hola@platanitorico.com">hola@platanitorico.com</a></span></li>
              </ul>
            </div>

            <p>
              El titular es un <strong>profesional autónomo</strong> y realiza su actividad conforme a la
              legislación vigente en España.
            </p>
          </section>

          <section id="s2" class="legal-section">
            <span class="legal-section__num">N.º 02</span>
            <h2 class="legal-section__title">
              Propiedad
              <em>intelectual e industrial.</em>
            </h2>
            <p>
              Todos los contenidos de este sitio web — textos, gráficos, imágenes, diseño y los derechos de
              propiedad intelectual que pudieran corresponder a dichos contenidos, así como todas las marcas,
              nombres comerciales o cualquier otro signo distintivo — son propiedad del titular o de sus
              legítimos propietarios, quedando <strong>reservados todos los derechos</strong>.
            </p>
            <p>
              Queda prohibida cualquier modalidad de reproducción, distribución, comunicación pública,
              transformación, puesta a disposición y, en general, cualquier otra forma de explotación,
              parcial o total de los contenidos de este sitio web, sin la autorización previa y por escrito
              del titular.
            </p>
          </section>

          <blockquote class="legal-pull">
            "Todos los contenidos son propiedad del titular. <em>Reservados todos los derechos.</em>"
          </blockquote>

          <section id="s3" class="legal-section">
            <span class="legal-section__num">N.º 03</span>
            <h2 class="legal-section__title">
              Condiciones
              <em>de uso.</em>
            </h2>
            <p>
              El acceso y uso de este sitio web atribuye la condición de usuario, aceptando con dicho acceso
              las Condiciones de Uso aquí reflejadas. El usuario se compromete a hacer un uso adecuado de los
              contenidos y servicios y a <strong>no emplearlos para incurrir en actividades ilícitas, ilegales
              o contrarias a la buena fe y al orden público</strong>.
            </p>
          </section>

          <section id="s4" class="legal-section">
            <span class="legal-section__num">N.º 04</span>
            <h2 class="legal-section__title">
              Exención de
              <em>responsabilidad.</em>
            </h2>
            <p>
              El titular no se hace responsable, en ningún caso, de los daños y perjuicios de cualquier
              naturaleza que pudieran ocasionar: errores u omisiones en los contenidos, falta de disponibilidad
              del portal o la transmisión de virus o programas maliciosos o lesivos, a pesar de haber adoptado
              todas las medidas tecnológicas necesarias para evitarlo.
            </p>

            <div class="legal-highlight legal-highlight--accent">
              <div class="legal-highlight__icon">↗</div>
              <div class="legal-highlight__body">
                <h2 class="legal-highlight__title">Enlaces externos</h2>
                <p>
                  En el caso de que el sitio web disponga enlaces o hipervínculos hacia otros sitios de Internet,
                  el titular <strong>no ejercerá ningún tipo de control</strong> sobre dichos sitios y contenidos.
                  En ningún caso asume responsabilidad por los contenidos enlazados, ni garantiza su disponibilidad,
                  calidad, fiabilidad, exactitud, veracidad o constitucionalidad.
                </p>
              </div>
            </div>
          </section>

          <section id="s5" class="legal-section">
            <span class="legal-section__num">N.º 05</span>
            <h2 class="legal-section__title">
              Legislación
              <em>aplicable y jurisdicción.</em>
            </h2>
            <p>
              La relación entre el titular y el usuario se regirá por la <strong>normativa española vigente</strong>
              y cualquier controversia se someterá a los <strong>Juzgados y tribunales de la ciudad de Almería</strong>,
              salvo que la Ley aplicable disponga otra cosa.
            </p>
          </section>

          <footer class="legal-colophon">
            <div class="legal-colophon__text">
              Documento oficial <strong>{docId}</strong>.<br/>
              Vigente desde <strong>{lastUpdate}</strong>.<br/>
              Titular: <strong>Jorge L. López Barrio · NIF 05298279E</strong>.
            </div>
            <div class="legal-colophon__sig">
              <span class="legal-colophon__sig-name">Jorge L. López</span>
              <span class="legal-colophon__sig-role">Titular · Platanito Rico</span>
            </div>
          </footer>
        </article>
      </div>
    </div>

    <section class="legal-final">
      <div class="container-brutal">
        <div class="legal-final__inner">
          <span class="text-meta">★ Más documentos legales</span>
          <h2 class="legal-final__title">
            ¿Quieres saber
            <em>más?</em>
          </h2>
          <p class="legal-final__text">
            Consulta la política de privacidad, cookies o los términos y condiciones
            de contratación. Cualquier duda, escríbenos.
          </p>
          <div class="legal-final__btns">
            <a href="/privacidad/" class="btn-brutal btn-brutal--lg">Privacidad →</a>
            <a href="/terminos-condiciones/" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Términos</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const links = document.querySelectorAll('[data-toc-link]');
  const sections = Array.from(links).map(a => document.querySelector(a.getAttribute('href') || ''));
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        links.forEach(l => l.classList.toggle('is-active', l.getAttribute('href') === `#${id}`));
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(s => s && observer.observe(s));
</script>
