---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Mantenimiento Web en Almería | Soporte Técnico Profesional 24/7';
const description = 'Mantenimiento web en Almería para WordPress, PrestaShop y WooCommerce. Actualizaciones, seguridad y backups. Planes desde 39€/mes sin permanencia.';
const canonical = 'https://platanitorico.com/soporte/';

// ── Qué incluye el servicio ──
const serviceDetails = [
  {
    title: 'Seguridad proactiva',
    desc: 'Protegemos tu web contra ataques, malware y vulnerabilidades antes de que ocurran.',
    icon: 'shield',
    features: ['Escaneo de malware diario automático', 'Firewall de aplicación web (WAF)', 'Protección DDoS y anti-spam', 'Actualizaciones de seguridad en <24h', 'Certificado SSL Enterprise gratuito']
  },
  {
    title: 'Optimización continua',
    desc: 'Tu web no solo se mantiene, se mejora constantemente para máximo rendimiento.',
    icon: 'bolt',
    features: ['Caché avanzada a nivel servidor', 'Optimización de bases de datos', 'Compresión de imágenes sin pérdida', 'Monitorización Core Web Vitals', 'Mejora continua de velocidad']
  },
  {
    title: 'Continuidad garantizada',
    desc: 'Backups frecuentes y recuperación inmediata para que tu negocio nunca pare.',
    icon: 'refresh',
    features: ['Backups diarios automáticos', 'Almacenamiento en nube externa', 'Recuperación completa garantizada', 'Migraciones de servidor incluidas', 'Uptime monitor 24/7/365']
  }
];

// ── Planes de mantenimiento (fuente de verdad) ──
const maintenancePlans = [
  {
    name: 'Mantenimiento Básico',
    price: '39€',
    period: 'mes',
    badge: 'Para empezar',
    description: 'Ideal para webs corporativas, blogs y sitios informativos que necesitan mantenimiento esencial.',
    features: [
      'Alojamiento web + correo profesional',
      'Actualizaciones de seguridad',
      'Copias de seguridad diarias',
      'Certificado SSL gratuito',
      '5 horas de cambios incluidas/mes',
      'Soporte por email (48h)',
      'Monitorización 24/7'
    ],
    popular: false
  },
  {
    name: 'Mantenimiento Profesional',
    price: '79€',
    period: 'mes',
    badge: 'Más contratado',
    description: 'Para empresas que dependen de su web y necesitan gestión continua con cambios mensuales.',
    features: [
      'Alojamiento web + correo profesional',
      '20 horas de cambios incluidas/mes',
      'Optimización Core Web Vitals',
      'Auditoría SEO técnica mensual',
      'Soporte telefónico L-V',
      'Recuperación garantizada <48h',
      'Informe mensual de rendimiento'
    ],
    popular: true
  },
  {
    name: 'Mantenimiento Tienda Online',
    price: '149€',
    period: 'mes',
    badge: 'Para e-commerce',
    description: 'Máxima protección para tiendas online PrestaShop y WooCommerce con prioridad absoluta.',
    features: [
      'Todo del plan Profesional',
      'Alojamiento optimizado e-commerce',
      'Minitareas ilimitadas (hasta 15 min)',
      'Gestión de catálogo incluida',
      'Soporte prioritario 24/7',
      'Recuperación garantizada <24h',
      'Protección RGPD avanzada'
    ],
    popular: false
  }
];

// ── Proceso de trabajo ──
const process = [
  {
    step: '01',
    title: 'Diagnóstico inicial',
    desc: 'Analizamos el estado actual de tu web: seguridad, rendimiento, actualizaciones pendientes y puntos de mejora.',
    duration: '1 día'
  },
  {
    step: '02',
    title: 'Plan de acción',
    desc: 'Te presentamos un informe detallado con las acciones prioritarias y te recomendamos el plan que mejor encaja con tu web.',
    duration: '1-2 días'
  },
  {
    step: '03',
    title: 'Activación y protección',
    desc: 'Configuramos backups, seguridad, monitorización y optimización. Tu web queda protegida desde el primer día.',
    duration: '1-2 días'
  },
  {
    step: '04',
    title: 'Mantenimiento continuo',
    desc: 'Actualizaciones semanales, informes mensuales y soporte permanente. Tú te centras en tu negocio.',
    duration: 'Mensual'
  }
];

// ── Testimonios ──
const testimonials = [
  {
    text: 'Teníamos la web de WordPress hackeada y no sabíamos qué hacer. La limpiaron en 24 horas y desde entonces llevamos más de un año sin ningún problema.',
    author: 'Francisco J.',
    role: 'Gerente, empresa de reformas en Almería',
    rating: 5
  },
  {
    text: 'El mantenimiento profesional incluye 20 horas de cambios al mes. Para nosotros es como tener un departamento web sin el coste de contratar a alguien.',
    author: 'Ana M.',
    role: 'Directora, clínica estética en Roquetas de Mar',
    rating: 5
  },
  {
    text: 'Nuestra tienda PrestaShop se actualizó sola un plugin y dejó de funcionar el checkout. Lo resolvieron en 2 horas un sábado por la tarde. Eso no tiene precio.',
    author: 'Carlos R.',
    role: 'Propietario, tienda de deportes en Mojácar',
    rating: 5
  },
  {
    text: 'Pasamos de una web que cargaba en 4 segundos a menos de 1. Las visitas desde Google se duplicaron en dos meses solo con la optimización de velocidad.',
    author: 'Elena D.',
    role: 'CEO, agencia inmobiliaria en Almería',
    rating: 5
  }
];

// ── FAQ ──
const faq = [
  {
    q: '¿Todas las páginas web necesitan mantenimiento?',
    a: 'Sí. Las páginas web, como cualquier software, requieren mantenimiento continuo. El proyecto online no termina al publicar la web, es cuando realmente comienza. WordPress, plugins, temas y PHP necesitan actualizaciones constantes de seguridad. Las tiendas online en PrestaShop y WooCommerce requieren aún más cuidado para mantenerse competitivas y seguras.'
  },
  {
    q: '¿Cuánto cuesta el mantenimiento de una web?',
    a: 'Ofrecemos planes desde 39€/mes para mantenimiento básico de webs corporativas, 79€/mes para el plan profesional con 20 horas de cambios incluidas, y 149€/mes para tiendas online con soporte prioritario 24/7. También hacemos planes personalizados según las necesidades de tu proyecto. Sin permanencia.'
  },
  {
    q: '¿Qué pasa si mi web se cae o es hackeada?',
    a: 'Con nuestros planes, la recuperación está garantizada: en menos de 48 horas para el plan básico y profesional, y en menos de 24 horas para tiendas online. Tenemos backups diarios en servidores externos, así que podemos restaurar tu web al estado anterior rápidamente.'
  },
  {
    q: '¿Puedo hacer cambios en mi web con el plan de mantenimiento?',
    a: 'Sí. El plan básico incluye 5 horas de cambios al mes y el profesional 20 horas. Los cambios pueden ser: actualizar textos e imágenes, añadir secciones, publicar artículos, modificar el diseño, etc. El plan e-commerce incluye minitareas ilimitadas de hasta 15 minutos cada una.'
  },
  {
    q: '¿Trabajáis con WordPress, PrestaShop y WooCommerce?',
    a: 'Sí, estamos especializados en estas plataformas. También trabajamos con Joomla, Drupal y tiendas online personalizadas. Si tu web está desarrollada con Astro u otra tecnología estática, podemos ofrecerte hosting gratuito en plataformas como Netlify o Cloudflare Pages.'
  },
  {
    q: '¿Hay permanencia en el contrato?',
    a: 'No. Trabajamos sin permanencia porque confiamos en nuestros resultados. Puedes cancelar cuando quieras, sin penalización ni preguntas. Nuestros clientes se quedan porque ven resultados, no porque estén atados a un contrato.'
  },
  {
    q: '¿Incluye hosting y correo electrónico?',
    a: 'Sí. Todos los planes incluyen alojamiento web profesional y cuentas de correo corporativo (tu-nombre@tu-dominio.com). El hosting está optimizado según el tipo de web: estándar para corporativas y de alto rendimiento para tiendas online.'
  },
  {
    q: '¿Qué diferencia hay entre vuestro servicio y un hosting barato?',
    a: 'Un hosting barato solo te da espacio en un servidor. Nosotros incluimos: actualizaciones de seguridad, backups diarios, monitorización 24/7, optimización de velocidad, certificado SSL, soporte técnico real con programadores expertos y horas de cambios mensuales. Es la diferencia entre tener un local y tener un local con mantenimiento, seguridad y limpieza incluidos.'
  }
];

// ── JSON-LD Schemas ──
const jsonLdSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonical,
    "inLanguage": "es",
    "isPartOf": { "@type": "WebSite", "name": "Platanito Rico", "url": "https://platanitorico.com" },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://platanitorico.com/" },
        { "@type": "ListItem", "position": 2, "name": "Mantenimiento Web", "item": canonical }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Platanito Rico — Mantenimiento Web en Almería",
    "description": "Servicio completo de mantenimiento web, soporte técnico, actualizaciones de seguridad y optimización para WordPress, PrestaShop y tiendas online.",
    "url": canonical,
    "telephone": "+34657085019",
    "email": "hola@platanitorico.com",
    "address": { "@type": "PostalAddress", "addressLocality": "Almería", "addressRegion": "Andalucía", "addressCountry": "ES" },
    "geo": { "@type": "GeoCoordinates", "latitude": 36.834, "longitude": -2.4637 },
    "areaServed": { "@type": "State", "name": "Almería" },
    "priceRange": "€",
    "openingHoursSpecification": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "19:00" },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Planes de Mantenimiento Web",
      "itemListElement": maintenancePlans.map(p => ({
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": p.name, "description": p.description },
        "price": p.price.replace('€', ''),
        "priceCurrency": "EUR"
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo funciona nuestro servicio de mantenimiento web",
    "description": "Proceso de mantenimiento web: desde el diagnóstico inicial hasta el mantenimiento continuo mensual.",
    "step": process.map((p, i) => ({
      "@type": "HowToStep",
      "position": i + 1,
      "name": p.title,
      "text": p.desc
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/mantenimiento-web-profesional.jpg"
  imageAlt="Mantenimiento web y soporte técnico profesional en Almería - Platanito Rico"
  type="service"
  keywords="mantenimiento web almería, soporte técnico web, mantenimiento wordpress, mantenimiento prestashop, soporte woocommerce, hosting web almería"
  jsonLd={jsonLdSchemas}
>
  <Header />

  <Breadcrumb items={[
    { label: 'Inicio', href: '/' },
    { label: 'Mantenimiento Web' }
  ]} />

  <main class="pt-0">

    <!-- ════════════════════════════════════════════ -->
    <!-- HERO -->
    <!-- ════════════════════════════════════════════ -->
    <section class="section-brutal relative min-h-screen flex items-center justify-center overflow-hidden bg-brutal-bg" id="hero">
      <div class="absolute inset-0 z-0">
        <img
          src="/imagenes/mantenimiento-web-profesional.jpg"
          alt="Equipo de mantenimiento web profesional Platanito Rico"
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
        />
      </div>
      <div class="absolute inset-0 z-[1] bg-brutal-bg/85"></div>

      <div class="container-brutal relative z-10 py-24">
        <div class="max-w-4xl mx-auto text-center">
          <div class="badge-brutal mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full bg-brutal-accent opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 bg-brutal-accent"></span>
            </span>
            <span class="text-sm font-medium text-brutal-text">Soporte técnico especializado</span>
          </div>

          <h1 class="heading-display text-4xl md:text-5xl lg:text-7xl text-brutal-text mb-8 leading-[1.1]">
            Tu web necesita
            <span class="block mt-2 text-brutal-accent">que alguien la cuide</span>
          </h1>

          <p class="text-lg md:text-xl text-brutal-text-secondary max-w-3xl mx-auto mb-6 leading-relaxed">
            Una web sin mantenimiento es una web vulnerable. Actualizaciones, seguridad, backups y optimización:
            <strong class="text-brutal-text">nosotros nos encargamos de todo.</strong>
          </p>
          <p class="text-base md:text-lg text-brutal-text-muted max-w-2xl mx-auto mb-12">
            Especialistas en <strong class="text-brutal-accent">WordPress, PrestaShop y WooCommerce</strong> en Almería. Sin permanencia.
          </p>

          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a href="#planes" class="btn-brutal group inline-flex items-center gap-2 px-8 py-4 bg-brutal-accent text-brutal-text font-semibold">
              <span class="relative">Ver planes y precios</span>
              <svg class="relative w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="tel:+34657085019" class="btn-brutal-outline inline-flex items-center gap-2 px-8 py-4 bg-brutal-bg text-brutal-text font-semibold border border-brutal-text/30 hover:bg-brutal-text/10 transition-all">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              657 085 019
            </a>
          </div>

          <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">99.9%</div>
              <div class="text-xs text-brutal-text-muted">Uptime garantizado</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">&lt;4h</div>
              <div class="text-xs text-brutal-text-muted">Tiempo respuesta</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">24/7</div>
              <div class="text-xs text-brutal-text-muted">Monitorización</div>
            </div>
            <div class="card-brutal bg-brutal-card border-brutal-border p-5">
              <div class="text-2xl md:text-3xl font-bold text-brutal-text mb-1" style="font-family:'Anton',sans-serif">0</div>
              <div class="text-xs text-brutal-text-muted">Permanencia</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════ -->
    <!-- EL PROBLEMA — Empatía -->
    <!-- ════════════════════════════════════════════ -->
    <section class="section-brutal py-24 bg-brutal-bg-alt">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
            Esto le pasa a muchas webs
          </div>
          <h2 class="heading-display text-3xl md:text-4xl lg:text-5xl text-brutal-text mb-6 leading-tight">
            Una web sin mantenimiento<br/>
            <span class="text-brutal-accent">es una bomba de relojería</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          {[
            { problem: 'Tu WordPress tiene plugins desactualizados que abren la puerta a hackers' },
            { problem: 'Tu web tarda más de 3 segundos en cargar y Google te penaliza' },
            { problem: 'No tienes copias de seguridad y un error podría borrar todo tu contenido' },
            { problem: 'El certificado SSL ha caducado y los navegadores muestran "sitio no seguro"' },
            { problem: 'Tu tienda online funciona lenta y los clientes abandonan el carrito' },
            { problem: 'Necesitas hacer cambios en la web pero no sabes cómo ni a quién pedir ayuda' }
          ].map((item) => (
            <div class="card-brutal bg-brutal-card border-brutal-accent/30 p-6">
              <div class="w-10 h-10 bg-brutal-accent/20 flex items-center justify-center mb-4">
                <svg class="w-5 h-5 text-brutal-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </div>
              <p class="text-brutal-text-secondary leading-relaxed">{item.problem}</p>
            </div>
          ))}
        </div>

        <div class="max-w-3xl mx-auto text-center p-10 bg-brutal-card border border-brutal-accent/30">
          <p class="text-xl md:text-2xl text-brutal-text leading-relaxed mb-4">
            Tu web es tu mejor comercial. Trabaja 24/7, pero solo si alguien se asegura de que <strong class="text-brutal-accent">funcione perfecta</strong>.
          </p>
          <p class="text-2xl md:text-3xl font-bold text-brutal-accent" style="font-family:'Anton',sans-serif">
            Nosotros nos encargamos.
          </p>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════ -->
    <!-- QUÉ INCLUYE — Detalles del servicio -->
    <!-- ════════════════════════════════════════════ -->
    <section id="servicio" class="section-brutal py-24 bg-brutal-bg">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Qué incluye el servicio
          </div>
          <h2 class="heading-display text-3xl md:text-4xl lg:text-5xl text-brutal-text mb-6 leading-tight">
            Mantenimiento completo<br/>
            <span class="text-brutal-accent">para que tú no te preocupes</span>
          </h2>
          <p class="text-lg text-brutal-text-secondary max-w-2xl mx-auto">
            Delega todas las tareas técnicas y de gestión de tu web. Nosotros nos ocupamos de todo.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {serviceDetails.map((detail) => (
            <div class="card-brutal bg-brutal-card border-brutal-border p-8">
              <div class="w-14 h-14 bg-brutal-accent flex items-center justify-center mb-6">
                <svg class="w-7 h-7 text-brutal-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  {detail.icon === 'shield' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />}
                  {detail.icon === 'bolt' && <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />}
                  {detail.icon === 'refresh' && <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />}
                </svg>
              </div>

              <h3 class="text-xl font-bold text-brutal-text mb-3">{detail.title}</h3>
              <p class="text-brutal-text-secondary text-sm mb-6 leading-relaxed">{detail.desc}</p>

              <ul class="space-y-3">
                {detail.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-brutal-text-secondary">
                    <svg class="w-4 h-4 text-brutal-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════ -->
    <!-- PROCESO -->
    <!-- ════════════════════════════════════════════ -->
    <section class="section-brutal py-24 bg-brutal-bg-alt">
      <div class="container-brutal">
        <div class="text-center mb-16">
          <div class="badge-brutal mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
