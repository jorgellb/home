---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Mantenimiento Web en Almería | Soporte Técnico Profesional 24/7';
const description = 'Mantenimiento web en Almería para WordPress, PrestaShop y WooCommerce. Actualizaciones, seguridad y backups. Planes desde 39€/mes sin permanencia.';
const canonical = 'https://platanitorico.com/soporte/';

const services = [
  { n: '01', title: 'Seguridad proactiva',  kicker: 'Malware · WAF · SSL · Updates',     desc: 'Protegemos tu web contra ataques, malware y vulnerabilidades antes de que ocurran. Mantenemos plugins, temas y PHP al día sin que se rompa nada.', features: ['Escaneo de malware diario','Firewall de aplicación (WAF)','Protección DDoS + anti-spam','Updates de seguridad <24h','SSL Enterprise gratuito'], figure: '<24h', figureLabel: 'Parche crítico', accent: 'accent' },
  { n: '02', title: 'Optimización continua', kicker: 'Caché · DB · Imágenes · CWV',       desc: 'Tu web no solo se mantiene — se mejora constantemente. Cada mes más rápida, más eficiente y mejor puntuada en Core Web Vitals.', features: ['Caché a nivel servidor','Optimización de base de datos','Compresión de imágenes','Monitorización CWV','Mejora continua de velocidad'], figure: '90+', figureLabel: 'Lighthouse target', accent: 'lime' },
  { n: '03', title: 'Continuidad garantizada', kicker: 'Backups · Restore · Uptime',      desc: 'Backups diarios, recuperación inmediata y monitorización 24/7. Si pasa algo, lo arreglamos antes de que tú te enteres.', features: ['Backups diarios automáticos','Almacenamiento en nube externa','Recuperación completa garantizada','Migraciones incluidas','Uptime monitor 24/7/365'], figure: '99.9%', figureLabel: 'Uptime objetivo', accent: 'ink' },
  { n: '04', title: 'Soporte humano',         kicker: 'Email · Tel · WhatsApp · Tickets', desc: 'Soporte real con programadores, no con un chatbot. Email, teléfono o WhatsApp — respuesta rápida y problemas resueltos a la primera.', features: ['Soporte por email + tel.','WhatsApp prioritario','Programadores senior','Histórico de cambios','Reuniones mensuales (Pro)'], figure: '<4h', figureLabel: 'Respuesta media', accent: 'paper' },
];

const plans = [
  { name: 'Mantenimiento Básico',  price: '39€',  period: 'mes', desc: 'Ideal para webs corporativas, blogs y sitios informativos.', features: ['Hosting + correo profesional','Actualizaciones de seguridad','Copias de seguridad diarias','SSL gratuito','5 h de cambios/mes','Soporte email (48h)','Monitorización 24/7'], badge: 'Para empezar', popular: false },
  { name: 'Mantenimiento Pro',     price: '79€',  period: 'mes', desc: 'Empresas que dependen de su web y necesitan gestión continua.', features: ['Hosting + correo profesional','20 h de cambios/mes','Optimización Core Web Vitals','Auditoría SEO técnica mensual','Soporte telefónico L–V','Recuperación garantizada <48h','Informe mensual'], badge: 'Más contratado', popular: true },
  { name: 'Mantenimiento Tienda',  price: '149€', period: 'mes', desc: 'Máxima protección para tiendas PrestaShop y WooCommerce.', features: ['Todo del plan Pro','Hosting optimizado e-commerce','Minitareas ilimitadas (≤15 min)','Gestión de catálogo incluida','Soporte prioritario 24/7','Recuperación garantizada <24h','Protección RGPD avanzada'], badge: 'Para e-commerce', popular: false },
];

const platforms = [
  { k: 'WordPress',     v: 'Plugins · temas · core · WooCommerce · multisite · headless' },
  { k: 'PrestaShop',    v: 'Módulos · temas · core · migraciones de versión · multitienda' },
  { k: 'WooCommerce',   v: 'Pasarelas · envíos · stock · cupones · subscripciones · B2B' },
  { k: 'Astro / estático', v: 'Hosting gratuito Netlify/Cloudflare · CI/CD · CMS headless' },
  { k: 'Hosting',       v: 'Cloudflare · Netlify · Vercel · DigitalOcean · cPanel propio' },
  { k: 'Monitorización', v: 'UptimeRobot · Plausible · Sentry · LogRocket · Core Web Vitals' },
];

const process = [
  { num: '01', title: 'Diagnóstico inicial',  eta: '1 día',    body: 'Analizamos seguridad, rendimiento, actualizaciones pendientes y puntos de mejora de tu web actual.', deliverable: 'Informe de estado + checklist' },
  { num: '02', title: 'Plan de acción',       eta: '1–2 días', body: 'Te presentamos las acciones prioritarias y te recomendamos el plan que mejor encaja con tu web y negocio.', deliverable: 'Propuesta de plan + roadmap' },
  { num: '03', title: 'Activación + protección', eta: '1–2 días', body: 'Configuramos backups, seguridad, monitorización y optimización. Tu web queda protegida desde el primer día.', deliverable: 'Setup completo + acceso a dashboard' },
  { num: '04', title: 'Mantenimiento continuo', eta: 'Mensual', body: 'Actualizaciones semanales, informes mensuales y soporte permanente. Tú te centras en tu negocio, no en tu web.', deliverable: 'Informe mensual + sesión opcional' },
];

const testimonials = [
  { text: 'Teníamos la web de WordPress hackeada y no sabíamos qué hacer. La limpiaron en 24 horas y desde entonces llevamos más de un año sin ningún problema.', author: 'Francisco J.', role: 'Gerente · Empresa de reformas · Almería' },
  { text: 'El plan profesional incluye 20 horas de cambios al mes. Para nosotros es como tener un departamento web sin el coste de contratar a nadie.',          author: 'Ana M.',       role: 'Directora · Clínica estética · Roquetas' },
  { text: 'Nuestra tienda PrestaShop se actualizó sola un plugin y se rompió el checkout. Lo resolvieron en 2 horas un sábado por la tarde. Eso no tiene precio.', author: 'Carlos R.',    role: 'Propietario · Tienda de deportes · Mojácar' },
  { text: 'Pasamos de una web que cargaba en 4 segundos a menos de 1. Las visitas desde Google se duplicaron en dos meses solo con la optimización de velocidad.', author: 'Elena D.',     role: 'CEO · Agencia inmobiliaria · Almería' },
];

const faq = [
  { q: '¿Todas las páginas web necesitan mantenimiento?', a: 'Sí. Como cualquier software, requieren mantenimiento continuo. El proyecto online no termina al publicar — es cuando empieza. WordPress, plugins, temas y PHP necesitan actualizaciones constantes. Las tiendas online aún más para mantenerse seguras y competitivas.' },
  { q: '¿Cuánto cuesta el mantenimiento de una web?', a: 'Planes desde 39€/mes (corporativas), 79€/mes (pro con 20h de cambios), 149€/mes (tiendas con soporte 24/7). También hacemos planes personalizados. Sin permanencia.' },
  { q: '¿Qué pasa si mi web se cae o es hackeada?', a: 'Recuperación garantizada: <48h en plan básico/pro y <24h en e-commerce. Backups diarios en servidores externos para restaurar al estado anterior.' },
  { q: '¿Puedo hacer cambios en mi web con el plan?', a: 'Sí. Básico: 5h/mes. Pro: 20h/mes. E-commerce: minitareas ilimitadas (≤15min). Cambios típicos: textos, imágenes, secciones, artículos, ajustes de diseño.' },
  { q: '¿Trabajáis con WordPress, PrestaShop y WooCommerce?', a: 'Sí, especializados en estas plataformas. También Joomla, Drupal y tiendas custom. Si tu web es Astro u otra tecnología estática, hosting gratuito en Netlify/Cloudflare.' },
  { q: '¿Hay permanencia?', a: 'No. Sin permanencia. Puedes cancelar cuando quieras sin penalización. Nuestros clientes se quedan por resultados, no por contrato.' },
  { q: '¿Incluye hosting y correo electrónico?', a: 'Sí. Todos los planes incluyen hosting profesional + cuentas de correo corporativo (tu@tudominio.com). Hosting optimizado según tipo de web: estándar para corporativas, alto rendimiento para tiendas.' },
  { q: '¿Qué diferencia hay entre vuestro servicio y un hosting barato?', a: 'Un hosting barato te da solo espacio en un servidor. Nosotros: actualizaciones de seguridad, backups diarios, monitorización 24/7, optimización de velocidad, SSL, soporte real con programadores y horas de cambios mensuales.' },
];

const jsonLd = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Mantenimiento Web","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Mantenimiento Web en Almería","description":"Servicio de mantenimiento web profesional en Almería para WordPress, PrestaShop y WooCommerce.","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","address":{"@type":"PostalAddress","streetAddress":"Ctra de Ronda, 82","addressLocality":"Vera","addressRegion":"Almería","postalCode":"04620","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":37.245,"longitude":-1.8614},"areaServed":{"@type":"AdministrativeArea","name":"Almería"},"priceRange":"€€","hasOfferCatalog":{"@type":"OfferCatalog","name":"Planes de Mantenimiento Web","itemListElement":plans.map(p=>({"@type":"Offer","name":p.name,"description":p.desc,"price":p.price.replace(/[^0-9]/g,''),"priceCurrency":"EUR","priceSpecification":{"@type":"UnitPriceSpecification","price":p.price.replace(/[^0-9]/g,''),"priceCurrency":"EUR","unitText":p.period}}))} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo activamos el mantenimiento de tu web","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Mantenimiento web profesional en Almería - Platanito Rico"
  type="service"
  keywords="mantenimiento web almería, soporte web wordpress, soporte prestashop, hosting almería, actualizaciones web"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Mantenimiento Web' }]} />

  <main id="main-content">
    {/* HERO */}
    <section class="svc-hero">
      <div class="container-brutal">
        <header class="svc-hero__head">
          <span class="text-meta">N.º 014 — Servicio · Mantenimiento</span>
          <span class="text-meta"><span class="live-dot"></span> Uptime 99.9% objetivo</span>
        </header>
        <div class="divider-brutal-thick"></div>

        <div class="svc-hero__grid">
          <div>
            <span class="text-meta">Cap. 01 / Mantenimiento web</span>
            <h1 class="svc-hero__title">
              Tu web,
              <em>siempre</em>
              <span class="text-stroke-ink">segura.</span>
              Siempre rápida.
            </h1>
            <p class="svc-hero__lead">
              Mantenimiento profesional para <strong>WordPress, PrestaShop y WooCommerce</strong>.
              Actualizaciones, seguridad, backups y soporte humano desde 39€/mes.
              Sin permanencia.
            </p>
            <div class="svc-hero__cta">
              <a href="/contacto" class="btn-brutal btn-brutal--lg">Ver planes →</a>
              <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">657 085 019</a>
            </div>
          </div>

          <aside class="svc-hero__specs">
            <div class="svc-hero__spec svc-hero__spec--accent">
              <span class="svc-hero__spec-num text-mono">99.9%</span>
              <span class="svc-hero__spec-lbl">Uptime objetivo</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--lime">
              <span class="svc-hero__spec-num text-mono">39€</span>
              <span class="svc-hero__spec-lbl">Desde · mes</span>
            </div>
            <div class="svc-hero__spec">
              <span class="svc-hero__spec-num text-mono">&lt;24h</span>
              <span class="svc-hero__spec-lbl">Restore garantizado</span>
            </div>
            <div class="svc-hero__spec svc-hero__spec--ink">
              <span class="svc-hero__spec-num text-mono">0</span>
              <span class="svc-hero__spec-lbl">Permanencia</span>
            </div>
          </aside>
        </div>
      </div>

      <div class="svc-hero__marquee">
        <div class="svc-hero__marquee-track">
          {Array.from({length: 6}).map(() => (
            <span>★ WORDPRESS ★ PRESTASHOP ★ WOOCOMMERCE ★ BACKUPS DIARIOS ★ SSL · WAF · DDOS ★</span>
          ))}
        </div>
      </div>
    </section>

    {/* SERVICIOS */}
    <section class="section-brutal" id="servicios">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 02 / Qué incluye</span>
            <h2 class="brutal-section-head__title">
              Mantenimiento real,
              <em>no hosting con etiqueta.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Seguridad proactiva, optimización continua, backups garantizados y
            soporte humano. Cuatro pilares que mantienen tu web online y
            rentable cada día del año.
          </p>
        </header>

        <ol class="svc-bento">
          {services.map((s) => (
            <li class={`svc-card svc-card--${s.accent}`}>
              <header class="svc-card__head">
                <span class="svc-card__num">{s.n}</span>
                <span class="svc-card__kicker">{s.kicker}</span>
              </header>
              <h3 class="svc-card__title">{s.title}</h3>
              <p class="svc-card__desc">{s.desc}</p>
              <ul class="svc-card__features">
                {s.features.map((f) => (
                  <li class="svc-card__feat"><span class="svc-card__feat-mark">+</span><span>{f}</span></li>
                ))}
              </ul>
              <footer class="svc-card__foot">
                <div class="svc-card__figure">
                  <span class="svc-card__figure-val">{s.figure}</span>
                  <span class="svc-card__figure-lbl">{s.figureLabel}</span>
                </div>
                <a href="/contacto" class="svc-card__cta">Activar →</a>
              </footer>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* PLATAFORMAS DATA SHEET */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 03 / Plataformas</span>
            <h2 class="brutal-section-head__title">
              Lo que
              <em>mantenemos.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Especializados en WordPress, PrestaShop y WooCommerce, también
            mantenemos webs estáticas (Astro) con hosting gratuito. Si tu stack
            no aparece, pregúntanos.
          </p>
        </header>

        <dl class="spec-list" style="max-width:760px;margin:2rem auto 0;">
          {platforms.map((p) => (
            <div><dt class="spec-k">{p.k}</dt><dd class="spec-v">{p.v}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    {/* PLANES */}
    <section class="section-brutal" id="planes">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 04 / Planes</span>
            <h2 class="brutal-section-head__title">
              Tres planes,
              <em>sin permanencia.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Desde el básico (corporativas/blogs) hasta el e-commerce con
            soporte prioritario 24/7. Cancelas cuando quieras.
          </p>
        </header>

        <ol class="svc-plans">
          {plans.map((p, i) => (
            <li class={`svc-plan ${p.popular ? 'svc-plan--popular' : ''}`}>
              <header class="svc-plan__head">
                <span class="text-meta">Plan {String(i + 1).padStart(2, '0')}</span>
                {p.popular && <span class="badge-brutal badge-brutal--lime">★ {p.badge}</span>}
                {!p.popular && <span class="text-meta">{p.badge}</span>}
              </header>
              <h3 class="svc-plan__name">{p.name}</h3>
              <p class="svc-plan__desc">{p.desc}</p>
              <div class="svc-plan__price">
                <span class="svc-plan__price-num text-mono">{p.price}</span>
                <span class="svc-plan__price-sub">+ IVA · por {p.period}</span>
              </div>
              <ul class="svc-plan__features">
                {p.features.map((f) => (
                  <li class="svc-plan__feat"><span class="svc-plan__mark">✓</span>{f}</li>
                ))}
              </ul>
              <a href="/contacto" class={`btn-brutal ${p.popular ? '' : 'btn-brutal--ghost'} svc-plan__cta`}>
                Contratar →
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* PROCESO */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-block:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 05 / Método</span>
            <h2 class="brutal-section-head__title">
              Cómo
              <em>activamos</em>
              tu mantenimiento.
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Cuatro fases para entrar en piloto automático. Desde el diagnóstico
            hasta el primer informe mensual — sin contratos eternos.
          </p>
        </header>

        <ol class="svc-process">
          {process.map((s, i) => (
            <li class={`svc-process__step svc-process__step--${i % 2 === 0 ? 'a' : 'b'}`}>
              <div class="svc-process__rail">
                <span class="svc-process__dot"></span>
                {i < process.length - 1 && <span class="svc-process__line"></span>}
              </div>
              <div class="svc-process__num">
                <span class="text-mono">{s.num}</span>
                <span class="svc-process__eta">{s.eta}</span>
              </div>
              <div class="svc-process__content">
                <h3 class="svc-process__title">{s.title}</h3>
                <p class="svc-process__body">{s.body}</p>
              </div>
              <aside class="svc-process__deliv">
                <span class="text-meta">Entregable</span>
                <p>{s.deliverable}</p>
              </aside>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* TESTIMONIOS */}
    <section class="section-brutal">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 06 / Clientes</span>
            <h2 class="brutal-section-head__title">
              Lo que dicen quienes
              <em>duermen tranquilos.</em>
            </h2>
          </div>
        </header>

        <figure class="svc-pull">
          <div class="svc-pull__marks" aria-hidden="true">“</div>
          <blockquote class="svc-pull__quote">{testimonials[0].text}</blockquote>
          <figcaption class="svc-pull__cap">
            <span class="svc-pull__avatar">{testimonials[0].author[0]}</span>
            <div>
              <span class="svc-pull__name">{testimonials[0].author}</span>
              <span class="svc-pull__role">{testimonials[0].role}</span>
            </div>
          </figcaption>
        </figure>

        <ul class="svc-quotes">
          {testimonials.slice(1).map((t, i) => (
            <li class={`svc-quote svc-quote--${i}`}>
              <p>"{t.text}"</p>
              <footer>
                <span class="svc-quote__avatar">{t.author[0]}</span>
                <div>
                  <span class="svc-quote__name">{t.author}</span>
                  <span class="svc-quote__role">{t.role}</span>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* FAQ */}
    <section class="section-brutal" style="background:var(--brutal-bg-alt);border-top:2px solid var(--brutal-ink);">
      <div class="container-brutal">
        <header class="brutal-section-head">
          <div class="brutal-section-head__col">
            <span class="text-meta">Cap. 07 / Preguntas frecuentes</span>
            <h2 class="brutal-section-head__title">
              Lo que más
              <em>nos preguntan.</em>
            </h2>
          </div>
          <p class="brutal-section-head__lead">
            Permanencia, plazos, plataformas, planes. Si no está aquí,
            escríbenos y respondemos en menos de 24h.
          </p>
        </header>

        <ol class="svc-faq">
          {faq.map((f, i) => (
            <li class="svc-faq__item">
              <details class="svc-faq__details" open={i === 0}>
                <summary class="svc-faq__sum">
                  <span class="svc-faq__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-faq__q">{f.q}</span>
                  <span class="svc-faq__toggle" aria-hidden="true">+</span>
                </summary>
                <div class="svc-faq__answer"><p>{f.a}</p></div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* CTA final */}
    <section class="svc-final">
      <div class="container-brutal">
        <div class="svc-final__inner">
          <span class="text-meta">★ Próximo paso</span>
          <h2 class="svc-final__title">
            Pásale tu web a alguien que
            <em>se ocupe.</em>
          </h2>
          <p class="svc-final__text">
            Te hacemos un diagnóstico gratuito y te decimos qué plan encaja.
            En menos de 48h tu web pasa a estar mantenida, monitorizada y respaldada.
          </p>
          <div class="svc-final__btns">
            <a href="/contacto" class="btn-brutal btn-brutal--lg">Pedir diagnóstico gratis →</a>
            <a href="tel:+34657085019" class="btn-brutal btn-brutal--ghost btn-brutal--lg">Llamar al 657 085 019</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
