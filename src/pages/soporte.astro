---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const title = 'Mantenimiento Web en Almería desde 39 €/mes';
const description = 'Mantenimiento web en Almería para WordPress, PrestaShop y WooCommerce. Actualizaciones, seguridad y backups. Planes desde 39€/mes sin permanencia.';
const canonical = 'https://platanitorico.com/soporte/';

const services = [
  { n: '01', icon: 'shield',  title: 'Seguridad proactiva',     kicker: 'Malware · WAF · SSL · Updates',  desc: 'Protegemos tu web contra ataques, malware y vulnerabilidades antes de que ocurran. Mantenemos plugins, temas y PHP al día sin que se rompa nada.', features: ['Escaneo de malware diario','Firewall de aplicación (WAF)','Protección DDoS + anti-spam','Updates de seguridad <24h','SSL Enterprise gratuito'],   figure: '<24h',  figureLabel: 'Parche crítico',     color: 'green' },
  { n: '02', icon: 'gauge',   title: 'Optimización continua',   kicker: 'Caché · DB · Imágenes · CWV',     desc: 'Tu web no solo se mantiene — se mejora constantemente. Cada mes más rápida, más eficiente y mejor puntuada en Core Web Vitals.',                figure: '90+',   features: ['Caché a nivel servidor','Optimización de base de datos','Compresión de imágenes','Monitorización CWV','Mejora continua de velocidad'],         figureLabel: 'Lighthouse target',  color: 'blue' },
  { n: '03', icon: 'vault',   title: 'Continuidad garantizada', kicker: 'Backups · Restore · Uptime',      desc: 'Backups diarios, recuperación inmediata y monitorización 24/7. Si pasa algo, lo arreglamos antes de que tú te enteres.',                          figure: '99.9%', features: ['Backups diarios automáticos','Almacenamiento en nube externa','Recuperación completa garantizada','Migraciones incluidas','Uptime monitor 24/7/365'], figureLabel: 'Uptime objetivo',    color: 'gold' },
  { n: '04', icon: 'human',   title: 'Soporte humano',          kicker: 'Email · Tel · WhatsApp · Tickets', desc: 'Soporte real con programadores, no con un chatbot. Email, teléfono o WhatsApp — respuesta rápida y problemas resueltos a la primera.',          figure: '<4h',   features: ['Soporte por email + tel.','WhatsApp prioritario','Programadores senior','Histórico de cambios','Reuniones mensuales (Pro)'],                       figureLabel: 'Respuesta media',    color: 'orange' },
];

const plans = [
  { name: 'Mantenimiento Básico',  price: '39€',  period: 'mes', desc: 'Ideal para webs corporativas, blogs y sitios informativos.',     shield: 'BASIC',  features: ['Hosting + correo profesional','Actualizaciones de seguridad','Copias de seguridad diarias','SSL gratuito','5 h de cambios/mes','Soporte email (48h)','Monitorización 24/7'], badge: 'Para empezar', popular: false },
  { name: 'Mantenimiento Pro',     price: '79€',  period: 'mes', desc: 'Empresas que dependen de su web y necesitan gestión continua.',    shield: 'PRO',    features: ['Hosting + correo profesional','20 h de cambios/mes','Optimización Core Web Vitals','Auditoría SEO técnica mensual','Soporte telefónico L–V','Recuperación garantizada <48h','Informe mensual'], badge: 'Más contratado', popular: true },
  { name: 'Mantenimiento Tienda',  price: '149€', period: 'mes', desc: 'Máxima protección para tiendas PrestaShop y WooCommerce.',         shield: 'SHOP',   features: ['Todo del plan Pro','Hosting optimizado e-commerce','Minitareas ilimitadas (≤15 min)','Gestión de catálogo incluida','Soporte prioritario 24/7','Recuperación garantizada <24h','Protección RGPD avanzada'], badge: 'Para e-commerce', popular: false },
];

const platforms = [
  { k: 'WordPress',         logo: 'wp',    v: 'Plugins · temas · core · WooCommerce · multisite · headless' },
  { k: 'PrestaShop',        logo: 'ps',    v: 'Módulos · temas · core · migraciones de versión · multitienda' },
  { k: 'WooCommerce',       logo: 'woo',   v: 'Pasarelas · envíos · stock · cupones · subscripciones · B2B' },
  { k: 'Astro / estático',  logo: 'astro', v: 'Hosting gratuito Vercel/Cloudflare · CI/CD · CMS headless' },
  { k: 'Hosting',           logo: 'host',  v: 'Cloudflare · Vercel · AWS · DigitalOcean · cPanel propio' },
  { k: 'Monitorización',    logo: 'eye',   v: 'UptimeRobot · Plausible · Sentry · LogRocket · Core Web Vitals' },
];

const process = [
  { num: '01', title: 'Diagnóstico inicial',     eta: '1 día',    body: 'Analizamos seguridad, rendimiento, actualizaciones pendientes y puntos de mejora de tu web actual.',                       deliverable: 'Informe de estado + checklist',     color: 'blue'  },
  { num: '02', title: 'Plan de acción',          eta: '1–2 días', body: 'Te presentamos las acciones prioritarias y te recomendamos el plan que mejor encaja con tu web y negocio.',                  deliverable: 'Propuesta de plan + roadmap',       color: 'gold'  },
  { num: '03', title: 'Activación + protección', eta: '1–2 días', body: 'Configuramos backups, seguridad, monitorización y optimización. Tu web queda protegida desde el primer día.',                deliverable: 'Setup completo + acceso a dashboard', color: 'green' },
  { num: '04', title: 'Mantenimiento continuo',  eta: 'Mensual',  body: 'Actualizaciones semanales, informes mensuales y soporte permanente. Tú te centras en tu negocio, no en tu web.',              deliverable: 'Informe mensual + sesión opcional',  color: 'ink'   },
];

const testimonials = [
  { text: 'Teníamos la web de WordPress hackeada y no sabíamos qué hacer. La limpiaron en 24 horas y desde entonces llevamos más de un año sin ningún problema.', author: 'Francisco J.', role: 'Gerente · Empresa de reformas · Almería' },
  { text: 'El plan profesional incluye 20 horas de cambios al mes. Para nosotros es como tener un departamento web sin el coste de contratar a nadie.',          author: 'Ana M.',       role: 'Directora · Clínica estética · Roquetas' },
  { text: 'Nuestra tienda PrestaShop se actualizó sola un plugin y se rompió el checkout. Lo resolvieron en 2 horas un sábado por la tarde. Eso no tiene precio.', author: 'Carlos R.',    role: 'Propietario · Tienda de deportes · Mojácar' },
  { text: 'Pasamos de una web que cargaba en 4 segundos a menos de 1. Las visitas desde Google se duplicaron en dos meses solo con la optimización de velocidad.', author: 'Elena D.',     role: 'CEO · Agencia inmobiliaria · Almería' },
];

const faq = [
  { q: '¿Todas las páginas web necesitan mantenimiento?', a: 'Sí. Como cualquier software, requieren mantenimiento continuo. El proyecto online no termina al publicar — es cuando empieza. WordPress, plugins, temas y PHP necesitan actualizaciones constantes. Las tiendas online aún más para mantenerse seguras y competitivas.' },
  { q: '¿Cuánto cuesta el mantenimiento de una web?', a: 'Planes desde 39€/mes (corporativas), 79€/mes (pro con 20h de cambios), 149€/mes (tiendas con soporte 24/7). También hacemos planes personalizados. Sin permanencia.' },
  { q: '¿Qué pasa si mi web se cae o es hackeada?', a: 'Recuperación garantizada: <48h en plan básico/pro y <24h en e-commerce. Backups diarios en servidores externos para restaurar al estado anterior.' },
  { q: '¿Puedo hacer cambios en mi web con el plan?', a: 'Sí. Básico: 5h/mes. Pro: 20h/mes. E-commerce: minitareas ilimitadas (≤15min). Cambios típicos: textos, imágenes, secciones, artículos, ajustes de diseño.' },
  { q: '¿Trabajáis con WordPress, PrestaShop y WooCommerce?', a: 'Sí, especializados en estas plataformas. También Joomla, Drupal y tiendas custom. Si tu web es Astro u otra tecnología estática, hosting gratuito en Vercel/Cloudflare.' },
  { q: '¿Hay permanencia?', a: 'No. Sin permanencia. Puedes cancelar cuando quieras sin penalización. Nuestros clientes se quedan por resultados, no por contrato.' },
  { q: '¿Incluye hosting y correo electrónico?', a: 'Sí. Todos los planes incluyen hosting profesional + cuentas de correo corporativo (tu@tudominio.com). Hosting optimizado según tipo de web: estándar para corporativas, alto rendimiento para tiendas.' },
  { q: '¿Qué diferencia hay entre vuestro servicio y un hosting barato?', a: 'Un hosting barato te da solo espacio en un servidor. Nosotros: actualizaciones de seguridad, backups diarios, monitorización 24/7, optimización de velocidad, SSL, soporte real con programadores y horas de cambios mensuales.' },
];

const certifications = [
  { code: 'RGPD',  name: 'Cumplimiento RGPD',  meta: 'UE 2016/679',        desc: 'Tratamiento de datos conforme al Reglamento General de Protección de Datos.',    color: 'blue'   },
  { code: 'SSL',   name: 'Cifrado SSL/TLS',    meta: 'HTTPS · TLS 1.3',    desc: 'Certificado SSL con renovación automática, incluido en todos los planes.',       color: 'green'  },
  { code: '24/7',  name: 'Monitor 24/7/365',   meta: 'Uptime 99,9 %',      desc: 'Vigilancia continua del uptime y de las amenazas a tu infraestructura.',         color: 'gold'   },
  { code: 'ISO',   name: 'Buenas prácticas',   meta: 'ISO/IEC 27001',      desc: 'Procedimientos alineados con la norma de seguridad de la información.',           color: 'orange' },
  { code: 'BAK',   name: 'Backup off-site',    meta: 'Retención 30 días',  desc: 'Copias en servidor externo independiente, con restauración garantizada.',         color: 'green'  },
  { code: 'AESA',  name: 'Operador de dron',   meta: 'Habilitación AESA',  desc: 'Equipo habilitado por AESA para operaciones audiovisuales aéreas (cuando aplica).', color: 'blue'   },
];

const noc = [
  { lbl: 'Sistemas',          v: 'OPERATIVOS',     tone: 'on'   },
  { lbl: 'Amenazas bloqueadas',v: '1.247 / hoy',   tone: 'on'   },
  { lbl: 'Backups',           v: 'OK · 07/07',     tone: 'on'   },
  { lbl: 'SSL · TLS 1.3',     v: 'VÁLIDO',         tone: 'on'   },
  { lbl: 'WAF',               v: 'ACTIVO',         tone: 'on'   },
  { lbl: 'Uptime · 30d',      v: '99.97 %',        tone: 'on'   },
];

const jsonLd = [
  { "@context":"https://schema.org","@type":"WebPage","name":title,"description":description,"url":canonical,"inLanguage":"es","isPartOf":{"@type":"WebSite","name":"Platanito Rico","url":"https://platanitorico.com"},"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://platanitorico.com/"},{"@type":"ListItem","position":2,"name":"Mantenimiento Web","item":canonical}]} },
  { "@context":"https://schema.org","@type":"ProfessionalService","name":"Platanito Rico — Mantenimiento Web en Almería","description":"Servicio de mantenimiento web profesional en Almería para WordPress, PrestaShop y WooCommerce.","url":canonical,"telephone":"+34657085019","email":"hola@platanitorico.com","address":{"@type":"PostalAddress","streetAddress":"Ctra de Ronda, 82","addressLocality":"Vera","addressRegion":"Almería","postalCode":"04620","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":37.245,"longitude":-1.8614},"areaServed":{"@type":"AdministrativeArea","name":"Almería"},"priceRange":"€€","hasOfferCatalog":{"@type":"OfferCatalog","name":"Planes de Mantenimiento Web","itemListElement":plans.map(p=>({"@type":"Offer","name":p.name,"description":p.desc,"price":p.price.replace(/[^0-9]/g,''),"priceCurrency":"EUR","priceSpecification":{"@type":"UnitPriceSpecification","price":p.price.replace(/[^0-9]/g,''),"priceCurrency":"EUR","unitText":p.period}}))} },
  { "@context":"https://schema.org","@type":"HowTo","name":"Cómo activamos el mantenimiento de tu web","step":process.map((p,i)=>({"@type":"HowToStep","position":i+1,"name":p.title,"text":p.body})) },
  { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
];

// Días backup mock (últimos 7)
const today = new Date();
const days = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
const backupDays = Array.from({length: 7}).map((_, i) => {
  const d = new Date(today); d.setDate(today.getDate() - (6 - i));
  return {
    d: days[d.getDay()],
    n: String(d.getDate()).padStart(2,'0'),
    m: String(d.getMonth()+1).padStart(2,'0'),
    ok: true,
    today: i === 6,
  };
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image="/imagenes/equipo-diseno-mantenimiento-web.jpg"
  imageAlt="Mantenimiento web profesional en Almería - Platanito Rico"
  type="service"
  keywords="mantenimiento web almería, soporte web wordpress, soporte prestashop, hosting almería, actualizaciones web"
  jsonLd={jsonLd}
>
  <Header />
  <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Mantenimiento Web' }]} />

  <main id="main-content" class="sp">

    {/* ═══════════════════════════════════════════════ */}
    {/* HERO — ESCUDO GUARDIÁN                           */}
    {/* ═══════════════════════════════════════════════ */}
    <section class="sp-hero">
      <div class="container-brutal">

        <header class="sp-hero__top">
          <span class="text-meta">N.º 014 — Servicio · Mantenimiento</span>
          <span class="text-meta sp-hero__status">
            <span class="sp-pulse-dot"></span>
            STATUS · PROTECTED · UPTIME 99.97%
          </span>
        </header>

        <div class="divider-brutal"></div>

        <div class="sp-hero__grid">

          {/* Izquierda: copy */}
          <div class="sp-hero__intro">
            <span class="text-meta sp-hero__chapter">Cap. 01 / Mantenimiento web</span>
            <h1 class="sp-hero__title heading-display">
              Tu web,
              <em class="heading-editorial">siempre</em>
              <span class="sp-hero__title-stamp">segura.</span>
              <small class="sp-hero__title-sub">Siempre rápida. Siempre vigilada.</small>
            </h1>

            <p class="sp-hero__lead">
              Mantenimiento profesional para <strong>WordPress, PrestaShop y WooCommerce</strong>.
              Actualizaciones, seguridad, backups y soporte humano desde <strong>39€/mes</strong>.
              <span class="sp-hero__lead-strong">Sin permanencia.</span>
            </p>

            <div class="sp-hero__cta">
              <a href="#planes" class="sp-btn sp-btn--primary">
                <span>Ver planes</span>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href="tel:+34657085019" class="sp-btn sp-btn--ghost">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>657 085 019</span>
              </a>
            </div>

            {/* KPIs */}
            <div class="sp-hero__kpis">
              <div class="sp-kpi sp-kpi--green">
                <span class="sp-kpi__val text-mono">99.9<small>%</small></span>
                <span class="sp-kpi__lbl">Uptime objetivo</span>
              </div>
              <div class="sp-kpi">
                <span class="sp-kpi__val text-mono">24<small>/7</small></span>
                <span class="sp-kpi__lbl">Monitorización</span>
              </div>
              <div class="sp-kpi sp-kpi--gold">
                <span class="sp-kpi__val text-mono">&lt;4h</span>
                <span class="sp-kpi__lbl">Respuesta</span>
              </div>
              <div class="sp-kpi sp-kpi--ink">
                <span class="sp-kpi__val text-mono">0</span>
                <span class="sp-kpi__lbl">Permanencia</span>
              </div>
            </div>
          </div>

          {/* Derecha: ESCUDO GUARDIÁN — simple y elegante */}
          <aside class="sp-hero__shield" aria-hidden="true">
            <svg viewBox="0 0 360 420" class="sp-shield-svg">
              <defs>
                <path id="sp-shield-arc" d="M180 35 a145 145 0 1 1 0 290 a145 145 0 1 1 0 -290"/>
                <pattern id="sp-shield-pattern" width="14" height="14" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1" fill="rgba(0,184,92,0.18)"/>
                </pattern>
                <radialGradient id="sp-shield-glow" cx="50%" cy="40%" r="60%">
                  <stop offset="0%"  stop-color="#00B85C" stop-opacity="0.32"/>
                  <stop offset="100%" stop-color="#00B85C" stop-opacity="0"/>
                </radialGradient>
              </defs>

              {/* Glow background */}
              <circle cx="180" cy="180" r="170" fill="url(#sp-shield-glow)"/>

              {/* Texto circular EXTERIOR */}
              <g class="sp-shield-text-outer">
                <text font-family="monospace" font-size="11" font-weight="bold" fill="#003B7A" letter-spacing="4">
                  <textPath href="#sp-shield-arc" startOffset="0%">★ PLATANITO RICO · GUARDIAN · 24/7 · ALMERÍA · UPTIME ★</textPath>
                </text>
              </g>

              {/* Anillo dashed rotando */}
              <g class="sp-shield-spin-slow" style="transform-origin: 180px 180px;">
                <circle cx="180" cy="180" r="158" fill="none" stroke="#00B85C" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.55"/>
              </g>

              {/* Tics dial sutiles */}
              <g opacity="0.5">
                {Array.from({length: 36}).map((_, i) => (
                  <line
                    x1="180" y1={i % 3 === 0 ? "26" : "32"}
                    x2="180" y2={i % 3 === 0 ? "38" : "36"}
                    stroke="#0E0D0B" stroke-width={i % 3 === 0 ? "2" : "1"}
                    transform={`rotate(${i*10} 180 180)`}
                  />
                ))}
              </g>

              {/* ════ ESCUDO BODY ════ */}
              <g transform="translate(80, 70)">
                {/* Shadow */}
                <path d="M 100 5 C 60 5 30 15 10 25 L 10 130 C 10 195 100 250 100 250 C 100 250 190 195 190 130 L 190 25 C 170 15 140 5 100 5 Z" fill="#0E0D0B" transform="translate(7, 7)" opacity="0.85"/>
                {/* Cuerpo */}
                <path d="M 100 5 C 60 5 30 15 10 25 L 10 130 C 10 195 100 250 100 250 C 100 250 190 195 190 130 L 190 25 C 170 15 140 5 100 5 Z" fill="#FFFCF6" stroke="#0E0D0B" stroke-width="4"/>
                {/* Pattern dots */}
                <path d="M 100 5 C 60 5 30 15 10 25 L 10 130 C 10 195 100 250 100 250 C 100 250 190 195 190 130 L 190 25 C 170 15 140 5 100 5 Z" fill="url(#sp-shield-pattern)"/>

                {/* Banda verde central */}
                <path d="M 10 95 L 190 95 L 190 130 L 10 130 Z" fill="#00B85C"/>
                <path d="M 10 95  L 190 95"  stroke="#0E0D0B" stroke-width="2"/>
                <path d="M 10 130 L 190 130" stroke="#0E0D0B" stroke-width="2"/>

                {/* CANDADO centrado */}
                <g transform="translate(70, 35)">
                  <path d="M 12 38 L 12 24 C 12 10 22 0 30 0 C 38 0 48 10 48 24 L 48 38" fill="none" stroke="#0E0D0B" stroke-width="5" stroke-linecap="round"/>
                  <rect x="0" y="38" width="60" height="48" rx="4" fill="#0E0D0B"/>
                  <circle cx="30" cy="58" r="7" fill="#D6FF44" class="sp-lock-pulse"/>
                  <rect x="27" y="61" width="6" height="14" fill="#D6FF44"/>
                </g>

                {/* Texto STATUS sobre banda verde */}
                <text x="100" y="118" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#FFFCF6" letter-spacing="4">PROTECTED · 24/7</text>

                {/* Bottom */}
                <text x="100" y="170" text-anchor="middle" font-family="monospace" font-size="18" font-weight="bold" fill="#0E0D0B" letter-spacing="-0.5">99.97%</text>
                <text x="100" y="186" text-anchor="middle" font-family="monospace" font-size="8"  fill="#003B7A" letter-spacing="2">UPTIME · 30 DÍAS</text>

                {/* Live mini */}
                <g transform="translate(100, 215)">
                  <circle cx="-32" cy="0" r="3.5" fill="#00B85C" class="sp-shield-live"/>
                  <text x="-23" y="3" font-family="monospace" font-size="7" font-weight="bold" fill="#003B7A" letter-spacing="2">EN VIVO</text>
                </g>
              </g>

              {/* Firma inferior */}
              <text x="180" y="395" text-anchor="middle" font-family="monospace" font-size="9" font-weight="bold" fill="#003B7A" letter-spacing="3">EST. 2018 · ALMERÍA · ES</text>
            </svg>

            {/* Sello "ASEGURADO" pequeño y elegante */}
            <div class="sp-shield__seal" aria-hidden="true">
              <svg viewBox="0 0 90 90" width="100%" height="100%">
                <defs>
                  <path id="sp-seal-c" d="M45,45 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0"/>
                </defs>
                <circle cx="45" cy="45" r="42" fill="#DC1B2C"/>
                <circle cx="45" cy="45" r="36" fill="none" stroke="#FFFCF6" stroke-width="1.5" stroke-dasharray="2 1.5"/>
                <g class="sp-seal-spin">
                  <text font-family="monospace" font-size="8" font-weight="bold" fill="#FFFCF6" letter-spacing="2.5">
                    <textPath href="#sp-seal-c" startOffset="0%">★ ASEGURADO ★ ASEGURADO ★</textPath>
                  </text>
                </g>
                <text x="45" y="52" text-anchor="middle" font-family="monospace" font-size="22" font-weight="bold" fill="#FFFCF6">✓</text>
              </svg>
            </div>
          </aside>
        </div>
      </div>

      {/* ECG HEARTBEAT — bottom band */}
      <div class="sp-ecg">
        <div class="sp-ecg__lbl">
          <span class="sp-pulse-dot"></span>
          <span class="text-mono">PULSO · TU WEB EN VIVO</span>
        </div>
        <div class="sp-ecg__monitor">
          <svg viewBox="0 0 1200 80" preserveAspectRatio="none" width="100%" height="100%" aria-hidden="true">
            <defs>
              <pattern id="sp-ecg-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(0,184,92,0.18)" stroke-width="1"/>
              </pattern>
            </defs>
            <rect width="1200" height="80" fill="url(#sp-ecg-grid)"/>
            {/* línea ECG */}
            <path
              class="sp-ecg__line"
              d="M 0 40 L 100 40 L 130 40 L 150 20 L 160 60 L 170 40 L 250 40 L 280 40 L 295 30 L 310 40 L 400 40 L 430 40 L 460 40 L 480 14 L 495 70 L 510 40 L 600 40 L 630 40 L 660 40 L 720 40 L 760 40 L 790 28 L 805 52 L 820 40 L 900 40 L 940 40 L 960 18 L 975 62 L 990 40 L 1100 40 L 1130 40 L 1200 40"
              fill="none" stroke="#00B85C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            />
          </svg>
        </div>
        <div class="sp-ecg__bpm">
          <span class="text-mono">BPM</span>
          <span class="text-mono sp-ecg__bpm-val">99.97</span>
        </div>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════ */}
    {/* NOC LIVE STATUS                                  */}
    {/* ═══════════════════════════════════════════════ */}
    <section class="sp-noc-section">
      <div class="container-brutal">
        <header class="sp-noc-head">
          <div>
