  {/* Reloj NOC */}
  <script is:inline>
    (function(){
      var el = document.getElementById('sp-noc-clock');
      if(!el) return;
      function tick(){
        var d = new Date();
        var h = String(d.getHours()).padStart(2,'0');
        var m = String(d.getMinutes()).padStart(2,'0');
        var s = String(d.getSeconds()).padStart(2,'0');
        el.textContent = h+':'+m+':'+s;
      }
      var _id = null;
      function _start(){ if(_id===null){ tick(); _id = setInterval(tick, 1000); } }
      function _stop(){ if(_id!==null){ clearInterval(_id); _id = null; } }
      document.addEventListener('visibilitychange', function(){ document.hidden ? _stop() : _start(); });
      _start();
    })();
  </script>
