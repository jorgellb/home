  @media (max-width: 768px) {
    .sp-ecg { grid-template-columns: 1fr; }
    .sp-ecg__lbl, .sp-ecg__bpm { border: none; padding: .65rem 1rem; }
    .sp-ecg__bpm { flex-direction: row; align-items: center; gap: .5rem; }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* NOC LIVE STATUS                                         */
  /* ═══════════════════════════════════════════════════════ */
  .sp-noc-section {
    background: var(--sp-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sp-ink);
    position: relative;
  }
  .sp-noc-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 1024px) { .sp-noc-head { grid-template-columns: 1.5fr 1fr; align-items: end; } }
  .sp-noc-head__lbl { color: var(--sp-green-d); }
  .sp-noc-head__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    margin: 1rem 0 .75rem;
  }
  .sp-noc-head__lead { color: var(--brutal-text-secondary); max-width: 56ch; }

  .sp-noc-now {
    background: var(--sp-ink);
    color: var(--sp-paper);
    padding: 1rem 1.25rem;
    display: flex; flex-direction: column; gap: 4px;
    border: 2px solid var(--sp-green);
    box-shadow: 5px 5px 0 var(--sp-green);
    align-self: start;
  }
  .sp-noc-now span:first-child, .sp-noc-now span:last-child { font-size: .6rem; letter-spacing: .2em; opacity: .55; }
  .sp-noc-now__val {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--sp-green);
    letter-spacing: -.02em;
    line-height: 1;
    margin: 2px 0;
  }

  .sp-noc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--sp-ink);
    border: 2.5px solid var(--sp-ink);
  }
  @media (min-width: 768px)  { .sp-noc-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1280px) { .sp-noc-grid { grid-template-columns: repeat(6, 1fr); } }

  .sp-noc-card {
    background: var(--sp-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .65rem;
    position: relative;
    transition: background .25s;
  }
  .sp-noc-card:hover { background: var(--sp-mint); }
  .sp-noc-card__head { display: flex; justify-content: space-between; align-items: center; }
  .sp-noc-card__id {
    font-size: .62rem; letter-spacing: .2em; color: var(--sp-blue); opacity: .7;
  }
  .sp-noc-card__dot {
    width: 10px; height: 10px;
    background: var(--sp-green);
    border-radius: 50%;
    position: relative;
  }
  .sp-noc-card__dot span {
    position: absolute; inset: -3px;
    border: 2px solid var(--sp-green);
    border-radius: 50%;
    animation: sp-ring 2s ease-out infinite;
  }
  @keyframes sp-ring {
    0%   { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  .sp-noc-card__lbl {
    font-family: var(--font-display);
    font-size: .92rem;
    font-weight: 700;
    color: var(--sp-ink);
    line-height: 1.2;
  }
  .sp-noc-card__v {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--sp-green-d);
    line-height: 1;
    margin-top: auto;
  }
  .sp-noc-card__bar {
    height: 4px;
    background: rgba(14,13,11,0.1);
    overflow: hidden;
    margin-top: .35rem;
  }
  .sp-noc-card__bar span {
    display: block;
    height: 100%;
    background: var(--sp-green);
    transition: width .5s;
  }
  .sp-noc-card--warn .sp-noc-card__dot,
  .sp-noc-card--warn .sp-noc-card__bar span { background: var(--sp-orange); }
  .sp-noc-card--warn .sp-noc-card__v { color: var(--sp-orange); }

  /* ═══════════════════════════════════════════════════════ */
  /* SERVICIOS BENTO                                         */
  /* ═══════════════════════════════════════════════════════ */
  .sp-svc-section {
    background: var(--sp-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sp-ink);
    position: relative;
  }
  .sp-svc-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(0,184,92,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,184,92,0.05) 1px, transparent 1px);
    background-size: 30px 30px;
    pointer-events: none;
  }
  .sp-svc-section > * { position: relative; }

  .sp-bento {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px)  { .sp-bento { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; } }
  @media (min-width: 1024px) { .sp-bento { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }

  .sp-svc-card {
    background: var(--sp-paper);
    border: 2.5px solid var(--sp-ink);
    box-shadow: var(--sp-shadow);
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex; flex-direction: column; gap: .85rem;
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
  }
  .sp-svc-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 6px;
    background: currentColor;
  }
  .sp-svc-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 14px 14px 0 var(--sp-ink);
  }
  .sp-svc-card--green  { color: var(--sp-green); }
  .sp-svc-card--blue   { color: var(--sp-blue); }
  .sp-svc-card--gold   { color: var(--sp-gold); }
  .sp-svc-card--orange { color: var(--sp-orange); }

  .sp-svc-card__icon {
    width: 80px; height: 80px;
    margin: .35rem 0 .5rem;
  }
  .sp-svc-card__head {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: .5rem;
    padding-bottom: .5rem;
    border-bottom: 2px dashed var(--sp-ink);
  }
  .sp-svc-card__num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--sp-ink);
    line-height: 1;
  }
  .sp-svc-card__kicker {
    font-size: .58rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--sp-ink);
    opacity: .65;
    text-align: right;
  }
  .sp-svc-card__title {
    font-size: clamp(1.3rem, 2vw, 1.55rem);
    line-height: 1;
    letter-spacing: -.025em;
    color: var(--sp-ink);
    margin: .25rem 0 0;
  }
  .sp-svc-card__desc {
    font-size: .9rem;
    color: var(--brutal-text-secondary);
    line-height: 1.5;
  }
  .sp-svc-card__features {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .4rem;
  }
  .sp-svc-card__features li {
    display: flex; align-items: flex-start; gap: .5rem;
    font-size: .85rem;
    color: var(--sp-ink);
    line-height: 1.35;
  }
  .sp-svc-card__features svg { color: currentColor; flex-shrink: 0; margin-top: 3px; }
  .sp-svc-card__foot {
    display: flex; justify-content: space-between; align-items: flex-end;
    padding-top: .85rem;
    border-top: 2px solid var(--sp-ink);
    margin-top: auto;
  }
  .sp-svc-card__figure { display: flex; flex-direction: column; }
  .sp-svc-card__figure-v {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    color: currentColor;
  }
  .sp-svc-card__figure-l {
    font-family: var(--font-mono);
    font-size: .55rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--sp-ink);
    opacity: .65;
    margin-top: 4px;
  }
  .sp-svc-card__cta {
    font-family: var(--font-mono);
    font-size: .75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--sp-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--sp-ink);
    padding-bottom: 2px;
  }
  .sp-svc-card__cta:hover { color: currentColor; border-bottom-color: currentColor; }

  /* ═══════════════════════════════════════════════════════ */
  /* BACKUP TIMELINE                                         */
  /* ═══════════════════════════════════════════════════════ */
  .sp-backup-section {
    background: var(--sp-ink);
    color: var(--sp-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sp-ink);
    position: relative;
    overflow: hidden;
  }
  .sp-backup-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(214,255,68,0.04) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .sp-backup-section > * { position: relative; }

  .sp-backup-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 1024px) { .sp-backup-head { grid-template-columns: 1.6fr 1fr; align-items: end; } }
  .sp-backup-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: .95;
    letter-spacing: -.035em;
    color: var(--sp-paper);
    margin: 1rem 0 .75rem;
  }
  .sp-backup-title em { color: var(--sp-lime); }
  .sp-backup-lead {
    color: rgba(255,252,246,0.7);
    max-width: 56ch;
  }
  .sp-backup-aside {
    background: var(--sp-paper);
    color: var(--sp-ink);
    padding: 1.25rem 1.5rem;
    border: 2.5px solid var(--sp-gold);
    box-shadow: 6px 6px 0 var(--sp-gold);
    display: flex; flex-direction: column; gap: .6rem;
  }
  .sp-backup-aside__row {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: .5rem;
    border-bottom: 1px dashed rgba(14,13,11,0.18);
  }
  .sp-backup-aside__row:last-child { border-bottom: none; padding-bottom: 0; }
  .sp-backup-aside__row span:first-child { font-size: .6rem; letter-spacing: .15em; color: var(--sp-blue); opacity: .8; }
  .sp-backup-aside__v { font-size: .85rem; font-weight: 800; color: var(--sp-green-d); }

  /* Disc timeline */
  .sp-tape {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px)  { .sp-tape { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 1024px) { .sp-tape { grid-template-columns: repeat(7, 1fr); } }

  .sp-tape__disc {
    display: flex; flex-direction: column; align-items: center; gap: .5rem;
    text-align: center;
    transition: transform .25s;
  }
  .sp-tape__disc svg {
    width: 100%; max-width: 100px;
    transition: transform .4s;
  }
  .sp-tape__disc:hover svg { transform: rotate(45deg); }
  .sp-tape__disc--today svg {
    filter: drop-shadow(0 6px 16px rgba(214,255,68,0.5));
  }
  .sp-tape__lbl {
    font-size: .75rem; font-weight: 800;
    letter-spacing: .15em;
    color: var(--sp-paper);
    text-transform: uppercase;
  }
  .sp-tape__date {
    font-size: .9rem;
    color: var(--sp-paper);
    opacity: .8;
  }
  .sp-tape__status {
    font-size: .55rem; letter-spacing: .15em;
    color: var(--sp-green);
    border: 1.5px solid var(--sp-green);
    padding: 2px 6px;
    text-transform: uppercase;
  }
  .sp-tape__disc--today .sp-tape__status {
    background: var(--sp-lime); color: var(--sp-ink); border-color: var(--sp-lime);
  }
  .sp-tape-foot {
    display: flex; flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    padding-top: 2rem;
    margin-top: 2rem;
    border-top: 2px dashed rgba(214,255,68,0.3);
    font-size: .68rem;
    letter-spacing: .15em;
    color: var(--sp-lime);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PLATAFORMAS                                             */
  /* ═══════════════════════════════════════════════════════ */
  .sp-plat-section {
    background: var(--sp-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sp-ink);
  }
  .sp-plat-grid {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px)  { .sp-plat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sp-plat-grid { grid-template-columns: repeat(3, 1fr); } }

  .sp-plat {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 1rem;
    align-items: center;
    background: var(--sp-paper);
    border: 2px solid var(--sp-ink);
    box-shadow: 5px 5px 0 var(--sp-ink);
    padding: 1.25rem;
    transition: transform .2s, box-shadow .2s;
  }
  .sp-plat:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--sp-green);
  }
  .sp-plat__icon { width: 60px; height: 60px; }
  .sp-plat__body { display: flex; flex-direction: column; gap: 2px; }
  .sp-plat__k {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -.015em;
    color: var(--sp-ink);
    margin: 0;
  }
  .sp-plat__v {
    font-size: .78rem;
    line-height: 1.35;
    color: var(--brutal-text-secondary);
    margin: 0;
  }
  .sp-plat__check {
    color: var(--sp-green);
  }

  /* ═══════════════════════════════════════════════════════ */
  /* PLANES                                                  */
  /* ═══════════════════════════════════════════════════════ */
  .sp-plans-section {
    background: var(--sp-paper-2);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sp-ink);
  }
  .sp-plans {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) { .sp-plans { grid-template-columns: repeat(3, 1fr); align-items: stretch; gap: 2rem; } }

  .sp-plan {
    position: relative;
    background: var(--sp-paper);
    border: 3px solid var(--sp-ink);
    box-shadow: var(--sp-shadow);
    padding: 2.5rem 1.75rem 2rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform .25s;
  }
  .sp-plan:hover { transform: translateY(-4px); }
  .sp-plan--popular {
    background: var(--sp-ink);
    color: var(--sp-paper);
    border-color: var(--sp-lime);
    box-shadow: 12px 12px 0 var(--sp-lime);
    transform: scale(1.02);
  }
  @media (min-width: 1024px) { .sp-plan--popular { transform: scale(1.05); } }
  .sp-plan--popular:hover { transform: scale(1.02) translateY(-4px); }
  @media (min-width: 1024px) { .sp-plan--popular:hover { transform: scale(1.05) translateY(-4px); } }

  .sp-plan__ribbon {
    position: absolute;
    top: -16px; left: 50%;
    transform: translateX(-50%);
    background: var(--sp-lime);
    color: var(--sp-ink);
    padding: .35rem 1.25rem;
    font-family: var(--font-mono);
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .2em;
    border: 2px solid var(--sp-ink);
    box-shadow: 3px 3px 0 var(--sp-ink);
    white-space: nowrap;
  }

  .sp-plan__shield {
    width: 80px;
    margin: 0 auto;
    color: var(--sp-green);
  }
  .sp-plan--popular .sp-plan__shield { color: var(--sp-lime); }

  .sp-plan__head {
    display: flex; justify-content: space-between;
    padding-bottom: .5rem;
    border-bottom: 2px dashed currentColor;
    opacity: .85;
  }
  .sp-plan__name {
    font-size: clamp(1.5rem, 2.5vw, 1.85rem);
    line-height: 1;
    letter-spacing: -.03em;
    margin: 0;
  }
  .sp-plan__desc {
    font-size: .9rem;
    line-height: 1.5;
    opacity: .85;
  }
  .sp-plan__price {
    display: flex; align-items: baseline; gap: .65rem;
    border-block: 2px solid currentColor;
    padding: 1rem 0;
    margin: .5rem 0;
  }
  .sp-plan__price-v {
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.03em;
  }
  .sp-plan__price-sub {
    font-family: var(--font-mono);
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    opacity: .65;
  }

  .sp-plan__features {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .55rem;
    flex: 1;
  }
  .sp-plan__features li {
    display: flex; align-items: flex-start; gap: .65rem;
    font-size: .92rem;
    line-height: 1.4;
  }
  .sp-plan__check {
    color: var(--sp-green);
    flex-shrink: 0;
    margin-top: 3px;
  }
  .sp-plan--popular .sp-plan__check { color: var(--sp-lime); }

  .sp-plan__cta {
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent;
    color: currentColor;
    border: 2.5px solid currentColor;
    padding: 1rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    margin-top: .5rem;
    transition: background .2s, color .2s, transform .2s;
  }
  .sp-plan__cta:hover {
    background: currentColor;
    color: var(--sp-paper);
    transform: translateY(-2px);
  }
  .sp-plan__cta--primary {
    background: var(--sp-lime);
    color: var(--sp-ink);
    border-color: var(--sp-lime);
  }
  .sp-plan__cta--primary:hover {
    background: var(--sp-paper);
    color: var(--sp-ink);
    border-color: var(--sp-paper);
  }

  /* Garantía */
  .sp-guarantee {
    margin-top: 3rem;
    background: var(--sp-cream);
    border: 3px solid var(--sp-ink);
    box-shadow: var(--sp-shadow);
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 768px) { .sp-guarantee { grid-template-columns: 120px 1fr; gap: 2rem; } }
  .sp-guarantee__seal {
    width: 120px; aspect-ratio: 1;
    transform: rotate(-8deg);
    filter: drop-shadow(0 4px 8px rgba(201,162,79,0.35));
  }
  .sp-guarantee__title {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    margin: 0 0 .5rem;
  }
  .sp-guarantee__copy p {
    font-size: .95rem;
    color: var(--brutal-text-secondary);
    line-height: 1.5;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* CERTIFICACIONES                                         */
  /* ═══════════════════════════════════════════════════════ */
  .sp-cert-section {
    background: var(--sp-blue);
    color: var(--sp-paper);
    padding: 5rem 1.5rem;
    border-bottom: 3px solid var(--sp-ink);
    position: relative;
    overflow: hidden;
  }
  .sp-cert-section::before {
    content: '';
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(45deg, transparent 0 30px, rgba(255,252,246,0.03) 30px 31px);
    pointer-events: none;
  }
  .sp-cert-section > * { position: relative; }

  .sp-certs {
    list-style: none; padding: 0; margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 560px)  { .sp-certs { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 980px)  { .sp-certs { grid-template-columns: repeat(3, 1fr); } }

  .sp-cert {
    position: relative;
    background: var(--sp-paper);
    color: var(--sp-blue);
    border: 2.5px solid var(--sp-ink);
    box-shadow: 6px 6px 0 var(--sp-ink);
    padding: 1.6rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform .25s, box-shadow .25s;
  }
  .sp-cert::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 6px;
    background: currentColor;
  }
  .sp-cert:hover {
    transform: translate(-3px, -3px);
    box-shadow: 10px 10px 0 var(--sp-lime);
  }
  .sp-cert--blue   { color: var(--sp-blue); }
  .sp-cert--green  { color: var(--sp-green-d); }
  .sp-cert--gold   { color: var(--sp-gold); }
  .sp-cert--orange { color: var(--sp-orange); }

  .sp-cert__top {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: .75rem;
    margin-bottom: 1rem;
  }
  .sp-cert__seal {
    width: 88px; height: 88px;
    flex: none;
    transform: rotate(-7deg);
    transition: transform .4s cubic-bezier(.34, 1.56, .64, 1);
    filter: drop-shadow(2px 2px 0 rgba(14, 13, 11, 0.22));
