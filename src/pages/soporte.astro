    letter-spacing: .2em;
    color: var(--sp-green);
    white-space: nowrap;
  }
  .sp-ecg__lbl .sp-pulse-dot { background: var(--sp-green); margin: 0; }
  .sp-ecg__monitor {
    height: 80px;
    overflow: hidden;
    position: relative;
  }
  .sp-ecg__line {
    filter: drop-shadow(0 0 4px rgba(0,184,92,0.6));
    stroke-dasharray: 2400;
    stroke-dashoffset: 2400;
    animation: sp-ecg-draw 6s linear infinite;
  }
  @keyframes sp-ecg-draw {
