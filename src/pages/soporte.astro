<style>
  /* ═══════════════════════════════════════════════════════ */
  /* PALETA · CONFIANZA Y SEGURIDAD                          */
  /* ═══════════════════════════════════════════════════════ */
  .sp {
    --sp-paper:    #FFFCF6;
    --sp-paper-2:  #F4F7F2;
    --sp-cream:    #F0E9D7;
    --sp-ink:      #0E0D0B;
    --sp-green:    #00B85C;
    --sp-green-d:  #0A8F4A;
    --sp-mint:     #C8F2D6;
    --sp-blue:     #003B7A;
    --sp-blue-l:   #005FB8;
    --sp-sky:      #DCEFFF;
    --sp-gold:     #C9A24F;
    --sp-lime:     #D6FF44;
    --sp-orange:   #FF6B35;
    --sp-red:      #DC1B2C;
    --sp-yellow:   #FFD600;
    --sp-shadow:   8px 8px 0 0 var(--sp-ink);
    --sp-shadow-s: 4px 4px 0 0 var(--sp-ink);
  }

  /* Pulse dot */
  .sp-pulse-dot {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--sp-green);
    box-shadow: 0 0 0 0 rgba(0,184,92,0.55);
    animation: sp-pulse 1.8s ease-out infinite;
    vertical-align: middle;
    margin-right: .35rem;
  }
  @keyframes sp-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(0,184,92,0.55); }
    70%  { box-shadow: 0 0 0 10px rgba(0,184,92,0); }
    100% { box-shadow: 0 0 0 0 rgba(0,184,92,0); }
  }

  /* ═══════════════════════════════════════════════════════ */
  /* HERO                                                    */
  /* ═══════════════════════════════════════════════════════ */
  .sp-hero {
    padding-top: 3rem;
    padding-bottom: 0;
    background:
      radial-gradient(circle at 70% 20%, rgba(0,184,92,0.06), transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(0,59,122,0.04), transparent 50%),
      var(--sp-paper);
    border-bottom: 3px solid var(--sp-ink);
    position: relative;
    overflow: hidden;
  }
  .sp-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(0,184,92,0.06) 1.2px, transparent 1.2px);
    background-size: 20px 20px;
    pointer-events: none;
  }
  .sp-hero > * { position: relative; }

  .sp-hero__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .sp-hero__status {
    color: var(--sp-green-d);
    font-weight: 700;
  }

  .sp-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 1024px) { .sp-hero__grid { grid-template-columns: 1.15fr 1fr; align-items: center; gap: 4rem; } }

  .sp-hero__intro { display: flex; flex-direction: column; gap: 1.25rem; }
  .sp-hero__chapter { color: var(--sp-blue); }
  .sp-hero__title {
    font-size: clamp(2.75rem, 8.5vw, 6.5rem);
    line-height: .9;
    letter-spacing: -.045em;
    margin: .25rem 0;
  }
  .sp-hero__title em { color: var(--sp-green); font-style: italic; display: inline-block; margin: 0 .15em; }
  .sp-hero__title-stamp {
    display: inline-block;
    color: var(--sp-blue);
    border-bottom: 6px solid var(--sp-blue);
    padding: 0 .1em;
    transform: rotate(-1deg);
  }
  .sp-hero__title-sub {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -.01em;
    color: var(--brutal-text-secondary);
    margin-top: 1rem;
  }

  .sp-hero__lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--brutal-text-secondary);
    max-width: 56ch;
  }
  .sp-hero__lead strong { color: var(--sp-ink); font-weight: 700; }
  .sp-hero__lead-strong {
    display: inline-block;
    background: var(--sp-lime);
    color: var(--sp-ink);
    padding: 0 .35em;
    font-weight: 800;
    border: 1.5px solid var(--sp-ink);
    margin-left: .35em;
  }

  .sp-hero__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem; }
  .sp-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    padding: 1.1rem 1.85rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    border: 2.5px solid var(--sp-ink);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s;
    cursor: pointer;
  }
  .sp-btn--primary {
    background: var(--sp-green);
    color: var(--sp-ink);
    box-shadow: 6px 6px 0 var(--sp-ink);
  }
  .sp-btn--primary:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--sp-ink);
  }
  .sp-btn--ghost {
    background: transparent;
    color: var(--sp-ink);
    box-shadow: 6px 6px 0 var(--sp-blue);
  }
  .sp-btn--ghost:hover {
    background: var(--sp-blue);
    color: var(--sp-paper);
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--sp-blue);
  }

  /* KPIs */
  .sp-hero__kpis {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border: 2.5px solid var(--sp-ink);
    background: var(--sp-ink);
  }
  @media (min-width: 768px) { .sp-hero__kpis { grid-template-columns: repeat(4, 1fr); } }
  .sp-kpi {
    background: var(--sp-paper);
    padding: 1.25rem;
    display: flex; flex-direction: column; gap: .35rem;
    border-right: 2px solid var(--sp-ink);
    border-bottom: 2px solid var(--sp-ink);
  }
  .sp-kpi:nth-child(2n) { border-right: none; }
  .sp-kpi:nth-last-child(-n+2) { border-bottom: none; }
  @media (min-width: 768px) {
    .sp-kpi:nth-child(2n)      { border-right: 2px solid var(--sp-ink); }
    .sp-kpi:nth-child(4n)      { border-right: none; }
    .sp-kpi:nth-last-child(-n+2) { border-bottom: 2px solid var(--sp-ink); }
    .sp-kpi:nth-last-child(-n+4) { border-bottom: none; }
  }
  .sp-kpi--green { background: var(--sp-mint); }
  .sp-kpi--gold  { background: var(--sp-gold); color: var(--sp-ink); }
  .sp-kpi--ink   { background: var(--sp-ink); color: var(--sp-paper); }
  .sp-kpi--ink   .sp-kpi__val { color: var(--sp-lime); }
  .sp-kpi__val {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
  }
  .sp-kpi__val small { font-size: .5em; opacity: .75; }
  .sp-kpi__lbl {
    font-family: var(--font-mono);
    font-size: .62rem;
    text-transform: uppercase;
    letter-spacing: .15em;
    opacity: .85;
  }

  /* ════════ ESCUDO GUARDIÁN (compacto, elegante) ════════ */
  .sp-hero__shield {
    position: relative;
    aspect-ratio: 360 / 420;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
    filter: drop-shadow(0 14px 32px rgba(0,184,92,0.18));
  }
  .sp-shield-svg { display: block; width: 100%; height: 100%; }

  .sp-shield-spin-slow  { animation: sp-spin 60s linear infinite; }
  .sp-shield-text-outer { animation: sp-spin 100s linear infinite; transform-origin: 180px 180px; }
  @keyframes sp-spin { to { transform: rotate(360deg); } }

  .sp-lock-pulse {
    animation: sp-lock-glow 2.2s ease-in-out infinite;
    transform-origin: center; transform-box: fill-box;
  }
  @keyframes sp-lock-glow {
    0%, 100% { opacity: 1;   transform: scale(1); }
    50%      { opacity: 0.7; transform: scale(1.12); }
  }
  .sp-shield-live {
    animation: sp-live-blink 1.5s ease-in-out infinite;
    transform-box: fill-box; transform-origin: center;
  }
  @keyframes sp-live-blink {
    0%, 100% { opacity: 1;   transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(0.85); }
  }

  .sp-shield__seal {
    position: absolute;
    top: 4%; right: -2%;
    width: 100px; aspect-ratio: 1;
    transform: rotate(12deg);
    filter: drop-shadow(0 6px 14px rgba(220,27,44,0.35));
    animation: sp-seal-bob 4s ease-in-out infinite;
  }
  @keyframes sp-seal-bob {
    0%, 100% { transform: rotate(12deg) translateY(0); }
    50%      { transform: rotate(12deg) translateY(-5px); }
  }
  .sp-seal-spin { transform-origin: 50% 50%; animation: sp-spin 30s linear infinite; }

  /* ECG HEARTBEAT */
  .sp-ecg {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0;
    background: var(--sp-ink);
    color: var(--sp-paper);
    border-top: 3px solid var(--sp-ink);
  }
  .sp-ecg__lbl {
    display: flex; align-items: center; gap: .5rem;
