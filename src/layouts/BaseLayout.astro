---
import '../styles/global.css';
import CookieConsent from '../components/common/CookieConsent.astro';
import ChatWidget from '../components/asistente/ChatWidget.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'product' | 'service';
  noindex?: boolean;
  canonical?: string;
  lang?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  keywords?: string;
  preload?: Array<{ href: string; as: string; type?: string }>;
}

const {
  title,
  description,
  image,
  imageAlt = 'Platanito Rico — Estudio creativo digital en Almería',
  type = 'website',
  noindex = false,
  canonical,
  lang = 'es',
  alternates,
  jsonLd,
  keywords = 'diseño web almería, agencia digital, marketing online, seo almería, desarrollo web, tiendas online',
  preload = []
} = Astro.props;

const siteName = 'Platanito Rico';
const siteBase = Astro.site ? Astro.site.origin : 'https://platanitorico.com';
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const canonicalUrl = canonical || siteUrl;
const ogImageRaw = image || '/imagenes/hero.jpg';
const ogImage = ogImageRaw.startsWith('http') ? ogImageRaw : `${siteBase}${ogImageRaw}`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Platanito Rico" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/imagenes/icon.png" />
    <link rel="apple-touch-icon" href="/imagenes/icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F5F1EA" />
    <meta name="generator" content={Astro.generator} />

    {preload.map(resource => (
      <link rel="preload" href={resource.href} as={resource.as} type={resource.type} crossorigin />
    ))}

    {alternates && alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    {jsonLd && Array.isArray(jsonLd)
      ? jsonLd.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        ))
      : jsonLd && (
          <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        )
    }
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>

    {/* Marquee superior — banda fija de identidad */}
    <div class="brand-band" aria-hidden="true">
      <div class="brand-band__track">
        <span class="brand-band__item">★ Platanito Rico</span>
        <span class="brand-band__item">Est. 2018 — Almería</span>
        <span class="brand-band__item">★ Diseño · Código · Vídeo</span>
        <span class="brand-band__item">Edición / 2026</span>
        <span class="brand-band__item">★ Open for projects</span>
        <span class="brand-band__item">+34 657 085 019</span>
        <span class="brand-band__item">★ Platanito Rico</span>
        <span class="brand-band__item">Est. 2018 — Almería</span>
        <span class="brand-band__item">★ Diseño · Código · Vídeo</span>
        <span class="brand-band__item">Edición / 2026</span>
        <span class="brand-band__item">★ Open for projects</span>
        <span class="brand-band__item">+34 657 085 019</span>
      </div>
    </div>

    <slot />

    <CookieConsent />
    <ChatWidget />

    <style is:global>
      /* — Marquee superior — */
      .brand-band {
        position: relative;
        width: 100%;
        background: #0E0D0B;
        color: #F5F1EA;
        border-bottom: 2px solid #0E0D0B;
        overflow: hidden;
        height: 32px;
      }
      .brand-band__track {
        display: flex;
        width: max-content;
        align-items: center;
        height: 100%;
        gap: 2.5rem;
        padding-left: 1rem;
        animation: marquee 42s linear infinite;
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .18em;
      }
      .brand-band__item { display: inline-flex; align-items: center; white-space: nowrap; }
      @media (prefers-reduced-motion: reduce) {
        .brand-band__track { animation: none; }
      }
    </style>
  </body>
</html>
