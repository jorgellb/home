# ─── Vercel deployment env vars ─────────────────────────────
# Required for /api/contact form endpoint (Resend transactional email)
# Create at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Note: also verify the domain 'platanitorico.com' in Resend dashboard
# before sending from web@platanitorico.com

# ─── Vera AI Business Agent (/api/vera) ─────────────────────
# Required for the Vera AI demo. Create at https://openrouter.ai/settings/keys
# IMPORTANT: server-only secret — never expose it in client code.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxx
# Optional: override the model. Por defecto un modelo GRATIS
# (meta-llama/llama-3.3-70b-instruct:free). Para usar uno de pago (mejor calidad),
# define aquí p. ej. openai/gpt-4o (requiere saldo en OpenRouter).
# OPENROUTER_MODEL=openai/gpt-4o

# ─── Rate limiting robusto (opcional) ───────────────────────
# Si se configuran, /api/vera y /api/vera-lead usan Upstash Redis para un
# límite global entre instancias. Si no, caen a un limitador en memoria.
# Crea una base gratis en https://console.upstash.com (Redis → REST).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
# (También se aceptan los nombres de Vercel KV: KV_REST_API_URL / KV_REST_API_TOKEN)
# Upstash también guarda la analítica propia (contadores de uso/leads/visitas).

# ─── Panel de estadísticas (/stats/) ────────────────────────
# Clave para acceder a los paneles privados: /stats/?k=TU_CLAVE
# y también /conversaciones/?k=TU_CLAVE (mismo valor).
# STATS_KEY=pon-aqui-una-clave-larga-y-secreta

# ─── Conversaciones del asistente (/conversaciones/) ─────────
# Se guardan en Upstash con caducidad automática (RGPD). Días que se
# conservan antes de borrarse solas (por defecto 90).
# CHATLOG_TTL_DAYS=90

# ─── Resumen diario por email (Vercel Cron) ──────────────────
# Cada mañana se envía un email con la actividad de ayer a hola@platanitorico.com.
# Clave secreta para proteger el endpoint del cron (recomendado). Vercel la
# añade automáticamente como cabecera Authorization en las llamadas del cron.
# Prueba manual: /api/resumen-diario/?k=STATS_KEY&force=1
# CRON_SECRET=pon-aqui-otra-clave-larga-y-secreta
