{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
        { "source": "/soluciones/agencia/", "destination": "/soluciones/ecommerce/", "permanent": true },
        { "source": "/soluciones/agencia", "destination": "/soluciones/ecommerce/", "permanent": true },
        { "source": "/vera-ai", "destination": "/ia-empresas/", "permanent": true },
        { "source": "/estudio-marca", "destination": "/diseno-grafico/", "permanent": true },
        { "source": "/rayos-x", "destination": "/marketing/auditoria/", "permanent": true },
        { "source": "/maquina-tiempo", "destination": "/desarrollo-web/", "permanent": true },
        { "source": "/configurador-3d", "destination": "/soluciones/ecommerce/", "permanent": true },
        { "source": "/sonido-marca", "destination": "/diseno-grafico/", "permanent": true },
        { "source": "/asistente-ia/:path*", "destination": "/ia-empresas/", "permanent": true },
        { "source": "/asistente-ia", "destination": "/ia-empresas/", "permanent": true },
        { "source": "/asistente-voz/:path*", "destination": "/ia-empresas/", "permanent": true },
        { "source": "/asistente-voz", "destination": "/ia-empresas/", "permanent": true },
        { "source": "/laboratorio-ia/:path*", "destination": "/ia-empresas/", "permanent": true },
        { "source": "/laboratorio-ia", "destination": "/ia-empresas/", "permanent": true },
        { "source": "/probador-virtual-ar/:path*", "destination": "/soluciones/ecommerce/", "permanent": true },
        { "source": "/probador-virtual-ar", "destination": "/soluciones/ecommerce/", "permanent": true },
        { "source": "/marketing/recursos/:path*", "destination": "/marketing/auditoria/", "permanent": true },
        { "source": "/marketing/recursos", "destination": "/marketing/auditoria/", "permanent": true },
        { "source": "/radar/:path*", "destination": "/", "permanent": true },
        { "source": "/radar", "destination": "/", "permanent": true },
        { "source": "/stats/:path*", "destination": "/", "permanent": true },
        { "source": "/stats", "destination": "/", "permanent": true },
        { "source": "/conversaciones/:path*", "destination": "/", "permanent": true },
        { "source": "/conversaciones", "destination": "/", "permanent": true },
    {
      "source": "/(.*)",
      "destination": "https://platanitorico.com/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.platanitorico.com" }]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; media-src 'self' https:; connect-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com https://w.soundcloud.com https://puerto.platanitorico.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|avif|gif|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
