{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ],
      "@scripts/*": [
        "./src/scripts/*"
      ],
      "@content/*": [
        "./src/content/*"
      ],
      "@schemas/*": [
        "./src/schemas/*"
      ],
      "@taia/*": [
        "./vendor/taia-core/src/*"
      ]
    },
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "vendor",
    ".vercel",
    "public"
  ]
}