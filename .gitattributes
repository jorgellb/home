# Normaliza finales de línea: LF en el repositorio, siempre.
# Sin esto, un checkout en Windows convierte a CRLF y el siguiente commit
# aparece como "todo el repo modificado".
* text=auto eol=lf

# Binarios: que git no los toque ni intente diferenciarlos.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.glb   binary
*.gltf  binary
*.wasm  binary
*.task  binary
